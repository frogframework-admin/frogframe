# Copy to .env (the .env file is not tracked by git) and replace every "change-me-..." value.
#   cp .env.example .env

# ASP.NET Core environment: Development (default) or Production.
ASPNETCORE_ENVIRONMENT=Development

# URL users open in the browser (used for password reset links in emails).
FROGFRAME_PUBLIC_BASE_URL=http://localhost:5080
# Host names allowed in the Host header, separated by ';'. Do not use "*".
FROGFRAME_ALLOWED_HOSTS=localhost
# Host port for the application.
FROGFRAME_HTTP_PORT=5080
# Set when the app runs behind a reverse proxy (CIDR of the proxy network), e.g. 172.18.0.0/16.
FROGFRAME_TRUSTED_PROXY_CIDR=

# Database
POSTGRES_PASSWORD=change-me-db-password
FROGFRAME_RO_PASSWORD=change-me-readonly-password

# Initial admin (created once if it does not exist). Change the password after first login.
FROGFRAME_ADMIN_USER=admin
FROGFRAME_ADMIN_PASSWORD=change-me-admin-password

# Demo mode (default true for Development). Set both to false in Production.
FROGFRAME_DEMO_SEED_DATA=true
FROGFRAME_DEMO_SHOW_ACCOUNTS=true
# Password for all demo accounts (shown on the login page while demo mode is on).
FROGFRAME_DEMO_PASSWORD=FrogFrame#2026

# AI designer (Azure OpenAI in Microsoft Foundry): drafts DocTypes, workflows and reporting SQL. Off by default.
# Endpoint format: https://<resource>.openai.azure.com/openai/v1/   Deployment: the deployment name in Foundry.
# Auth: ManagedIdentity (Azure-hosted), DefaultCredential (developer sign-in) or ApiKey (set FROGFRAME_AI_API_KEY).
FROGFRAME_AI_ENABLED=false
FROGFRAME_AI_ENDPOINT=
FROGFRAME_AI_DEPLOYMENT=
FROGFRAME_AI_AUTH=ManagedIdentity
FROGFRAME_AI_MANAGED_IDENTITY_CLIENT_ID=
FROGFRAME_AI_API_KEY=

# Copy to .env (the .env file is not tracked by git) and replace every "change-me-..." value.
#   cp .env.example .env && chmod 600 .env
# Outside Development the app refuses to start while a secret is still a change-me placeholder, a repository default or
# (passwords) shorter than 12 characters. Generate values with: openssl rand -base64 24
# Instead of .env, secrets can also be files in /run/secrets (Docker/Kubernetes secrets, Key Vault or Vault CSI).
# Rotation and details: docs/guides/secrets.md

# ASP.NET Core environment. Development (default during development: demo data + demo accounts on the login page).
# Going live: set Production. Demo mode then turns off by itself; the app refuses to start if it is still switched on.
ASPNETCORE_ENVIRONMENT=Development

# Container image of the app and the migrate step. Empty = frogframe-app:latest built locally from ./publish.
# Released images: ghcr.io/<owner>/<repo>:<version> (set by the release pipeline on staging).
FROGFRAME_IMAGE=

# URL users open in the browser (used for password reset links in emails).
FROGFRAME_PUBLIC_BASE_URL=http://localhost:5080
# Host names allowed in the Host header, separated by ';'. Do not use "*".
FROGFRAME_ALLOWED_HOSTS=localhost
# Host port for the application.
FROGFRAME_HTTP_PORT=5080
# Time zone of the app and migrate containers (IANA id). Defaults to Asia/Jakarta.
# FROGFRAME_TZ=Asia/Jakarta
# Set when the app runs behind a reverse proxy (CIDR of the proxy network), e.g. 172.18.0.0/16.
FROGFRAME_TRUSTED_PROXY_CIDR=

# Database
POSTGRES_PASSWORD=change-me-db-password
FROGFRAME_RO_PASSWORD=change-me-readonly-password
# Password of frogframe_app, the data-only role the application uses for requests (created by the migrate step).
# POSTGRES_PASSWORD stays the schema owner, used only for migrations, indexes and reporting views.
FROGFRAME_APP_PASSWORD=change-me-app-db-password

# File & attachment contents. S3 (default in docker compose) = the bundled SeaweedFS object store;
# Database = PostgreSQL bytea (as before). To use another S3-compatible store (MinIO, Ceph RGW, AWS S3) set
# FROGFRAME_S3_SERVICE_URL (empty = AWS S3) and its keys; the bundled SeaweedFS can then be removed.
FROGFRAME_STORAGE_PROVIDER=S3
FROGFRAME_S3_SERVICE_URL=http://seaweedfs:8333
FROGFRAME_S3_BUCKET=frogframe
# Keys of the bundled SeaweedFS (and of the app). Use long random values, e.g. openssl rand -hex 20 / 32.
FROGFRAME_S3_ACCESS_KEY=change-me-s3-access-key
FROGFRAME_S3_SECRET_KEY=change-me-s3-secret-key
# Move contents already stored in PostgreSQL to the bucket (background, resumable). Set false to keep them there.
FROGFRAME_STORAGE_MIGRATE_EXISTING=true
FROGFRAME_SEAWEEDFS_VERSION=4.48

# Snapshot before migrating (docker compose service db-backup): pg_dump into the frogframe-backups volume on every
# "docker compose up". Keeps the newest FROGFRAME_PRE_MIGRATE_BACKUP_KEEP files. See docs/guides/database-migrations.md.
FROGFRAME_PRE_MIGRATE_BACKUP=true
FROGFRAME_PRE_MIGRATE_BACKUP_KEEP=5

# Initial admin (created once if it does not exist). Change the password after first login.
FROGFRAME_ADMIN_USER=admin
FROGFRAME_ADMIN_PASSWORD=change-me-admin-password

# Demo mode is always on in Development, so these switches only matter outside Development; keep them false.
# Demo seeding creates accounts such as 'admin' (System Manager) with one shared password, shown on the login page.
# Outside Development the app refuses to start with demo mode on, unless this is a dedicated demo server: then set
# FROGFRAME_DEMO_ALLOW_OUTSIDE_DEVELOPMENT=true and your own password (12+ characters).
FROGFRAME_DEMO_SEED_DATA=false
FROGFRAME_DEMO_SHOW_ACCOUNTS=false
FROGFRAME_DEMO_ALLOW_OUTSIDE_DEVELOPMENT=false
# Password for all demo accounts. Empty = FrogFrame#2026 (public), which is only accepted in Development.
FROGFRAME_DEMO_PASSWORD=

# Rate limits per minute (docs/guides/rate-limiting.md). Reads/writes/heavy (reports, saved queries, print) are per
# user or API key; sign-in and password reset are per client IP (many users behind one office NAT share the sign-in budget).
# With several app nodes, Cluster:Nodes divides these so the total stays close to the value.
FROGFRAME_API_RATE_LIMIT=300
FROGFRAME_API_WRITE_RATE_LIMIT=120
FROGFRAME_API_HEAVY_RATE_LIMIT=60
FROGFRAME_AUTH_RATE_LIMIT=1200
FROGFRAME_PASSWORD_RESET_RATE_LIMIT=20

# Two-factor authentication (authenticator app). Optional per user from the profile menu; roles listed here must use it,
# e.g. "System Manager,Accounts Manager". Issuer is the name shown in the authenticator app.
FROGFRAME_2FA_ISSUER=FrogFrame
FROGFRAME_2FA_REQUIRED_ROLES=

# Group administrators who manage tenants (subsidiaries) at /platform/tenants: user ids, comma separated.
# Example: FROGFRAME_PLATFORM_ADMINS=admin
FROGFRAME_PLATFORM_ADMINS=
# With more than one tenant only the platform administrators above can change the shared metadata (DocTypes,
# customizations, workflows, DocType permissions). true = every tenant's System Manager may, as with one tenant.
FROGFRAME_TENANT_ADMINS_EDIT_METADATA=false

# Single sign-on (signs in existing accounts by e-mail; never creates accounts). A provider is on when its client ID and
# secret are set. Redirect URIs to register: <public URL>/signin-google and <public URL>/signin-microsoft.
# Microsoft needs your directory (tenant) ID; "common"/"organizations" are refused. See docs/guides/two-factor-and-sso.md.
FROGFRAME_SSO_ALLOWED_DOMAIN=
FROGFRAME_SSO_GOOGLE_CLIENT_ID=
FROGFRAME_SSO_GOOGLE_CLIENT_SECRET=
FROGFRAME_SSO_MICROSOFT_CLIENT_ID=
FROGFRAME_SSO_MICROSOFT_CLIENT_SECRET=
FROGFRAME_SSO_MICROSOFT_TENANT_ID=

# AI designer (Azure OpenAI in Microsoft Foundry): drafts DocTypes, workflows and reporting SQL. Off by default.
# Endpoint format: https://<resource>.openai.azure.com/openai/v1/   Deployment: the deployment name in Foundry.
# Auth: ManagedIdentity (Azure-hosted), DefaultCredential (developer sign-in) or ApiKey (set FROGFRAME_AI_API_KEY).
FROGFRAME_AI_ENABLED=false
FROGFRAME_AI_ENDPOINT=
FROGFRAME_AI_DEPLOYMENT=
FROGFRAME_AI_AUTH=ManagedIdentity
FROGFRAME_AI_MANAGED_IDENTITY_CLIENT_ID=
FROGFRAME_AI_API_KEY=

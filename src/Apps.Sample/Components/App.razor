<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    @* Order following BlazorBlueprint theme guide: theme first, then blazorblueprint.css, then app styles. *@
    <link rel="stylesheet" href="@Assets["_content/Framework.Web/theme.css"]" />
    <link rel="stylesheet" href="@Assets["_content/BlazorBlueprint.Components/blazorblueprint.css"]" />
    <link rel="stylesheet" href="@Assets["_content/Framework.Web/desk.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="PageRenderMode" />
    <script src="_content/BlazorBlueprint.Components/js/theme-init.js"></script>
    <script>
        (function () {
            try {
                var t = localStorage.getItem('frogframe-theme');
                if (t && t !== 'blue') {
                    document.documentElement.setAttribute('data-theme', t);
                }
            } catch (e) {}
        })();
    </script>
</head>
<body>
    <Routes @rendermode="PageRenderMode" />

    <div id="components-reconnect-modal">
        <div class="bb-reconnect-dialog" role="alertdialog" aria-modal="true" aria-live="assertive" aria-labelledby="bb-reconnect-heading">
            <div class="bb-reconnect-spinner" aria-hidden="true"></div>
            <h2 id="bb-reconnect-heading" class="bb-reconnect-heading">
                <span data-when="show retrying">Reconnecting</span>
                <span data-when="paused">Connection paused</span>
                <span data-when="failed">Connection failed</span>
                <span data-when="resume-failed">Session could not be resumed</span>
                <span data-when="rejected">Session expired</span>
            </h2>
            <p class="bb-reconnect-text">
                <span data-when="show">Connection to server was lost. Attempting to reconnect.</span>
                <span data-when="retrying">Next attempt in <span id="components-seconds-to-next-attempt">0</span> seconds.</span>
                <span data-when="paused">Connection paused and will resume automatically.</span>
                <span data-when="failed">Server not responding. Your input is still preserved.</span>
                <span data-when="resume-failed">The paused session could not be resumed.</span>
                <span data-when="rejected">The server could not restore this session. Reload to start a new session.</span>
            </p>
            <div class="bb-reconnect-actions">
                <button type="button" class="bb-reconnect-button" data-when="failed resume-failed" onclick="Blazor.reconnect()">Retry</button>
                <button type="button" class="bb-reconnect-button" data-variant="secondary" data-when="failed resume-failed" onclick="location.reload()">Reload</button>
                <button type="button" class="bb-reconnect-button" data-when="rejected" onclick="location.reload()">Reload</button>
            </div>
        </div>
    </div>

    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["_content/Framework.Web/desk.js"]"></script>
</body>
</html>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    // Halaman login/logout dirender statis (perlu HttpContext untuk menulis cookie); halaman lain interaktif.
    // Prerender dimatikan agar inisialisasi halaman (query database) tidak berjalan dua kali.
    private static readonly IComponentRenderMode InteractiveNoPrerender = new InteractiveServerRenderMode(prerender: false);
    private IComponentRenderMode? PageRenderMode => HttpContext.AcceptsInteractiveRouting() ? InteractiveNoPrerender : null;
}

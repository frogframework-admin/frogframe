{
  "name": "Customer",
  "version": 1,
  "title": "Customer",
  "module": "CORE",
  "description": "Customer, shared by CRM and Receivables (Salesforce Account / NetSuite Customer).",
  "naming": {
    "pattern": "CUST-{######}"
  },
  "document": {
    "trackChanges": true,
    "allowSubmit": false,
    "allowCancel": false,
    "allowAmend": false,
    "allowDelete": true
  },
  "fields": [
    {
      "name": "customer_name",
      "type": "Data",
      "label": "Customer name",
      "requiredWhen": "true",
      "inListView": true,
      "section": "General"
    },
    {
      "name": "customer_type",
      "type": "Select",
      "label": "Type",
      "requiredWhen": "true",
      "options": [
        "Company",
        "Individual",
        "Government Agency",
        "BUMN"
      ],
      "default": "Company",
      "inListView": true,
      "section": "General"
    },
    {
      "name": "customer_group",
      "type": "Link",
      "label": "Customer group",
      "linkTo": "CustomerGroup",
      "requiredWhen": "true",
      "linkFilters": [
        {
          "field": "is_group",
          "op": "=",
          "value": false
        }
      ],
      "inListView": true,
      "section": "General"
    },
    {
      "name": "parent_customer",
      "type": "Link",
      "label": "Parent customer",
      "linkTo": "Customer",
      "description": "Account hierarchy like Salesforce Parent Account",
      "section": "General",
      "column": 2
    },
    {
      "name": "is_active",
      "type": "Check",
      "label": "Active",
      "default": true,
      "inListView": true,
      "section": "General",
      "column": 2
    },
    {
      "name": "industry",
      "type": "Link",
      "label": "Industry",
      "linkTo": "Industry",
      "section": "General",
      "column": 2
    },
    {
      "name": "territory",
      "type": "Link",
      "label": "Territory",
      "linkTo": "Territory",
      "linkFilters": [
        {
          "field": "is_group",
          "op": "=",
          "value": false
        }
      ],
      "section": "General",
      "column": 2
    },
    {
      "name": "lead",
      "type": "Link",
      "label": "Converted from lead",
      "linkTo": "Lead",
      "readOnlyWhen": "true",
      "noCopy": true,
      "section": "General",
      "column": 2
    },
    {
      "name": "account_owner",
      "type": "Link",
      "label": "Account owner (sales)",
      "linkTo": "Employee",
      "lookupDialog": true,
      "inListView": true,
      "section": "General",
      "column": 2,
      "description": "Salesforce Account Owner; decides which salesperson may edit"
    },
    {
      "name": "email",
      "type": "Email",
      "label": "Email",
      "section": "Contact"
    },
    {
      "name": "phone",
      "type": "Phone",
      "label": "Phone",
      "section": "Contact"
    },
    {
      "name": "website",
      "type": "Data",
      "label": "Website",
      "section": "Contact"
    },
    {
      "name": "primary_contact",
      "type": "Link",
      "label": "Primary contact",
      "linkTo": "Contact",
      "section": "Contact",
      "column": 2
    },
    {
      "name": "primary_address",
      "type": "Link",
      "label": "Billing address",
      "linkTo": "Address",
      "section": "Contact",
      "column": 2
    },
    {
      "name": "tax_id_type",
      "type": "Select",
      "label": "Tax ID type",
      "options": [
        "NPWP",
        "NIK",
        "Passport",
        "Other"
      ],
      "default": "NPWP",
      "tab": "Tax",
      "section": "Tax"
    },
    {
      "name": "tax_id",
      "type": "Data",
      "label": "Tax ID number",
      "maxLength": 20,
      "tab": "Tax",
      "section": "Tax",
      "requiredWhen": "is_pkp",
      "description": "16-digit NPWP, NIK, or passport number"
    },
    {
      "name": "nitku",
      "type": "Data",
      "label": "NITKU / TKU ID",
      "maxLength": 22,
      "pattern": "^[0-9]{22}$",
      "patternMessage": "22-digit NITKU",
      "tab": "Tax",
      "section": "Tax"
    },
    {
      "name": "is_pkp",
      "type": "Check",
      "label": "VAT-registered (PKP)",
      "default": false,
      "tab": "Tax",
      "section": "Tax",
      "column": 2
    },
    {
      "name": "tax_name",
      "type": "Data",
      "label": "Name per tax ID",
      "tab": "Tax",
      "section": "Tax",
      "column": 2
    },
    {
      "name": "tax_address",
      "type": "Link",
      "label": "Tax address",
      "linkTo": "Address",
      "tab": "Tax",
      "section": "Tax",
      "column": 2
    },
    {
      "name": "default_currency",
      "type": "Link",
      "label": "Currency",
      "linkTo": "Currency",
      "default": "IDR",
      "tab": "Commercial",
      "section": "Sales"
    },
    {
      "name": "default_price_list",
      "type": "Link",
      "label": "Price list",
      "linkTo": "PriceList",
      "linkFilters": [
        {
          "field": "price_list_type",
          "op": "=",
          "value": "Sales"
        }
      ],
      "tab": "Commercial",
      "section": "Sales"
    },
    {
      "name": "payment_term",
      "type": "Link",
      "label": "Payment terms",
      "linkTo": "PaymentTerm",
      "tab": "Commercial",
      "section": "Sales",
      "column": 2
    },
    {
      "name": "credit_limit",
      "type": "Currency",
      "label": "Credit limit",
      "min": 0,
      "tab": "Commercial",
      "section": "Sales",
      "column": 2,
      "description": "0 or empty = no limit"
    },
    {
      "name": "receivable_account",
      "type": "Link",
      "label": "Receivable account (override)",
      "linkTo": "Account",
      "linkFilters": [
        {
          "field": "is_group",
          "op": "=",
          "value": false
        },
        {
          "field": "is_active",
          "op": "=",
          "value": true
        },
        {
          "field": "account_type",
          "op": "=",
          "value": "Receivable"
        }
      ],
      "tab": "Commercial",
      "section": "Accounting",
      "description": "Empty = from customer group, then company default"
    },
    {
      "name": "is_internal_customer",
      "type": "Check",
      "label": "Intercompany customer",
      "default": false,
      "tab": "Commercial",
      "section": "Accounting",
      "column": 2
    },
    {
      "name": "represents_company",
      "type": "Link",
      "label": "Represents company",
      "linkTo": "Company",
      "requiredWhen": "is_internal_customer",
      "visibleWhen": "is_internal_customer",
      "tab": "Commercial",
      "section": "Accounting",
      "column": 2
    }
  ],
  "rules": [
    {
      "name": "tax_id_16_digits",
      "expr": "tax_id_type != 'NPWP' || empty(tax_id) || len(tax_id) == 16",
      "message": "NPWP must be 16 digits (Coretax format)",
      "field": "tax_id"
    }
  ],
  "permissions": [
    {
      "role": "Finance",
      "actions": [
        "read",
        "create",
        "write",
        "report",
        "export"
      ],
      "scope": "all"
    },
    {
      "role": "Employee",
      "actions": [
        "read"
      ],
      "scope": "all"
    },
    {
      "role": "System Manager",
      "actions": [
        "read",
        "create",
        "write",
        "delete",
        "report",
        "export"
      ],
      "scope": "all"
    },
    {
      "role": "Sales",
      "actions": [
        "read",
        "report"
      ],
      "scope": "all"
    },
    {
      "role": "Sales",
      "actions": [
        "read",
        "create",
        "write"
      ],
      "scope": "match:account_owner=employee"
    },
    {
      "role": "Manager",
      "actions": [
        "read",
        "write",
        "report"
      ],
      "scope": "all"
    }
  ],
  "listView": {
    "titleField": "customer_name",
    "searchFields": [
      "name",
      "customer_name",
      "tax_id"
    ],
    "filters": [
      "customer_group",
      "customer_type",
      "account_owner",
      "is_active"
    ],
    "defaultSort": [
      {
        "field": "modified",
        "direction": "desc"
      }
    ]
  },
  "api": {
    "enabled": true,
    "operations": [
      "list",
      "read",
      "create",
      "update"
    ]
  }
}

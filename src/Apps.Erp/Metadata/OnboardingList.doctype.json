{
  "name": "OnboardingList",
  "version": 1,
  "title": "Onboarding List",
  "module": "HR",
  "description": "Tracks onboarding tasks and readiness for new hires.",
  "naming": {
    "pattern": "ONB-{YYYY}-{#####}"
  },
  "document": {
    "trackChanges": true,
    "allowSubmit": true,
    "allowCancel": true,
    "allowAmend": true,
    "allowDelete": true
  },
  "fields": [
    {
      "name": "employee",
      "type": "Link",
      "label": "Employee",
      "linkTo": "Employee",
      "requiredWhen": "true",
      "lookupDialog": true,
      "inListView": true,
      "section": "Onboarding Details"
    },
    {
      "name": "employee_name",
      "type": "Data",
      "label": "Employee name",
      "fetchFrom": "employee.full_name",
      "inListView": true,
      "section": "Onboarding Details"
    },
    {
      "name": "organization_unit",
      "type": "Link",
      "label": "Organization Unit",
      "linkTo": "OrganizationUnit",
      "fetchFrom": "employee.organization_unit",
      "inListView": true,
      "section": "Onboarding Details"
    },
    {
      "name": "position",
      "type": "Link",
      "label": "Position",
      "linkTo": "Position",
      "fetchFrom": "employee.position",
      "section": "Onboarding Details"
    },
    {
      "name": "start_date",
      "type": "Date",
      "label": "Start date",
      "fetchFrom": "employee.hire_date",
      "requiredWhen": "true",
      "inListView": true,
      "section": "Onboarding Details",
      "column": 2
    },
    {
      "name": "target_completion_date",
      "type": "Date",
      "label": "Target completion date",
      "section": "Onboarding Details",
      "column": 2
    },
    {
      "name": "status",
      "type": "Select",
      "label": "Status",
      "requiredWhen": "true",
      "default": "Pending",
      "inListView": true,
      "section": "Onboarding Details",
      "column": 2,
      "options": [
        "Pending",
        "In Progress",
        "Completed",
        "Cancelled"
      ]
    },
    {
      "name": "mentor",
      "type": "Link",
      "label": "Buddy / Mentor",
      "linkTo": "Employee",
      "lookupDialog": true,
      "section": "Onboarding Details",
      "column": 2
    },
    {
      "name": "notes",
      "type": "Text",
      "label": "Notes",
      "section": "Onboarding Details"
    },
    {
      "name": "checklist",
      "type": "Table",
      "label": "Onboarding Tasks",
      "childDocType": "OnboardingChecklistItem",
      "section": "Checklist"
    }
  ],
  "rules": [
    {
      "name": "target_date_valid",
      "expr": "empty(target_completion_date) || target_completion_date >= start_date",
      "message": "The target completion date must be on or after the start date",
      "field": "target_completion_date"
    }
  ],
  "permissions": [
    {
      "role": "HR-Admin",
      "actions": [
        "read",
        "report",
        "export"
      ],
      "scope": "all"
    },
    {
      "role": "HR-Recruitment",
      "actions": [
        "read",
        "create",
        "write",
        "report",
        "export"
      ],
      "scope": "all"
    },
    {
      "role": "HR-Employee-Management",
      "actions": [
        "read",
        "create",
        "write",
        "submit",
        "cancel",
        "amend",
        "report",
        "export"
      ],
      "scope": "all"
    },
    {
      "role": "HR-Time-Attendance",
      "actions": [
        "read",
        "report",
        "export"
      ],
      "scope": "all"
    },
    {
      "role": "HR-Talent",
      "actions": [
        "read",
        "report",
        "export"
      ],
      "scope": "all"
    },
    {
      "role": "System Manager",
      "actions": [
        "read",
        "create",
        "write",
        "delete",
        "submit",
        "cancel",
        "amend",
        "report",
        "export"
      ],
      "scope": "all"
    },
    {
      "role": "Employee",
      "actions": [
        "read"
      ],
      "scope": "match:employee=employee"
    }
  ],
  "listView": {
    "titleField": "employee_name",
    "searchFields": [
      "name",
      "employee_name"
    ],
    "filters": [
      "status",
      "organization_unit",
      "start_date"
    ],
    "defaultSort": [
      {
        "field": "start_date",
        "direction": "desc"
      }
    ]
  },
  "api": {
    "enabled": true,
    "operations": [
      "list",
      "read",
      "create",
      "update",
      "action"
    ]
  }
}

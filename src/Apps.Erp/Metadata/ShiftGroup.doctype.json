{
  "name": "ShiftGroup",
  "version": 1,
  "title": "Shift Group",
  "module": "HR",
  "description": "Operational work group or team (e.g. Squad A, Squad B, Squad C, Squad D) for rotational shift scheduling.",
  "naming": {
    "pattern": "field:group_code"
  },
  "document": {
    "trackChanges": true,
    "allowSubmit": false,
    "allowCancel": false,
    "allowAmend": false,
    "allowDelete": true
  },
  "fields": [
    {
      "name": "group_code",
      "type": "Data",
      "label": "Group code",
      "requiredWhen": "true",
      "maxLength": 20,
      "inListView": true,
      "section": "Group"
    },
    {
      "name": "group_name",
      "type": "Data",
      "label": "Group name",
      "requiredWhen": "true",
      "inListView": true,
      "section": "Group"
    },
    {
      "name": "company",
      "type": "Link",
      "label": "Company",
      "linkTo": "Company",
      "requiredWhen": "true",
      "inListView": true,
      "section": "Group",
      "column": 2
    },
    {
      "name": "organization_unit",
      "type": "Link",
      "label": "Organization unit",
      "linkTo": "OrganizationUnit",
      "requiredWhen": "true",
      "lookupDialog": true,
      "inListView": true,
      "section": "Group",
      "column": 2
    },
    {
      "name": "supervisor",
      "type": "Link",
      "label": "Group supervisor",
      "linkTo": "Employee",
      "lookupDialog": true,
      "section": "Group",
      "column": 2
    },
    {
      "name": "effective_from",
      "type": "Date",
      "label": "Effective from",
      "requiredWhen": "true",
      "default": "$today",
      "inListView": true,
      "section": "Validity"
    },
    {
      "name": "effective_to",
      "type": "Date",
      "label": "Effective to",
      "section": "Validity",
      "column": 2
    },
    {
      "name": "is_active",
      "type": "Check",
      "label": "Active",
      "default": true,
      "inListView": true,
      "section": "Validity",
      "column": 2
    },
    {
      "name": "members",
      "type": "Table",
      "label": "Members",
      "childDocType": "ShiftGroupMember",
      "section": "Members"
    },
    {
      "name": "member_count",
      "type": "Int",
      "label": "Member count",
      "compute": "len(members)",
      "inListView": true,
      "section": "Members"
    },
    {
      "name": "description",
      "type": "Text",
      "label": "Description",
      "section": "Remarks"
    }
  ],
  "rules": [
    {
      "name": "valid_period",
      "expr": "empty(effective_to) || effective_to >= effective_from",
      "message": "The effective end date must be on or after the effective start date",
      "field": "effective_to"
    }
  ],
  "permissions": [
    {
      "role": "HR-Admin",
      "actions": [
        "read",
        "report",
        "export"
      ],
      "scope": "all"
    },
    {
      "role": "HR-Recruitment",
      "actions": [
        "read",
        "report",
        "export"
      ],
      "scope": "all"
    },
    {
      "role": "HR-Employee-Management",
      "actions": [
        "read",
        "report",
        "export"
      ],
      "scope": "all"
    },
    {
      "role": "HR-Time-Attendance",
      "actions": [
        "read",
        "create",
        "write",
        "delete",
        "report",
        "export"
      ],
      "scope": "all"
    },
    {
      "role": "HR-Talent",
      "actions": [
        "read",
        "report",
        "export"
      ],
      "scope": "all"
    },
    {
      "role": "Manager",
      "actions": [
        "read",
        "report"
      ],
      "scope": "all"
    },
    {
      "role": "Employee",
      "actions": [
        "read"
      ],
      "scope": "all"
    },
    {
      "role": "System Manager",
      "actions": [
        "read",
        "create",
        "write",
        "delete",
        "report",
        "export"
      ],
      "scope": "all"
    }
  ],
  "listView": {
    "titleField": "group_name",
    "searchFields": [
      "group_code",
      "group_name",
      "organization_unit"
    ],
    "filters": [
      "company",
      "organization_unit",
      "is_active"
    ],
    "defaultSort": [
      {
        "field": "group_code",
        "direction": "asc"
      }
    ]
  },
  "api": {
    "enabled": true,
    "operations": [
      "list",
      "read",
      "create",
      "update",
      "delete"
    ]
  }
}

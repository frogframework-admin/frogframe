{
  "name": "PurchaseRequestApproval",
  "docType": "PurchaseRequest",
  "version": 1,
  "initialState": "Draft",
  "states": [
    {
      "name": "Draft",
      "docStatus": 0,
      "tone": "neutral"
    },
    {
      "name": "Pending Approval",
      "docStatus": 1,
      "tone": "pending"
    },
    {
      "name": "Approved",
      "docStatus": 1,
      "tone": "positive"
    },
    {
      "name": "Rejected",
      "docStatus": 2,
      "tone": "negative"
    },
    {
      "name": "Cancelled",
      "docStatus": 2,
      "tone": "negative"
    }
  ],
  "transitions": [
    {
      "from": "Draft",
      "to": "Pending Approval",
      "action": "Submit for approval",
      "allowedRoles": [
        "Employee"
      ],
      "condition": "requested_by == user.employee"
    },
    {
      "from": "Pending Approval",
      "to": "Approved",
      "action": "Approve",
      "allowedRoles": [
        "Employee"
      ],
      "condition": "approver == user.employee && requested_by != user.employee"
    },
    {
      "from": "Pending Approval",
      "to": "Rejected",
      "action": "Reject",
      "allowedRoles": [
        "Employee"
      ],
      "condition": "approver == user.employee && requested_by != user.employee",
      "requireComment": true
    },
    {
      "from": "Pending Approval",
      "to": "Cancelled",
      "action": "Withdraw",
      "allowedRoles": [
        "Employee"
      ],
      "condition": "requested_by == user.employee"
    },
    {
      "from": "Approved",
      "to": "Cancelled",
      "action": "Cancel",
      "allowedRoles": [
        "Purchasing"
      ],
      "requireComment": true
    }
  ]
}

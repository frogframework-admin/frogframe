  ],
  "listView": {
    "titleField": "table_code",
    "searchFields": [
      "table_code",
      "description"
    ],
    "filters": [
      "company",
      "is_active"
    ],
    "defaultSort": [
      {
        "field": "table_code",
        "direction": "asc"
      }
    ]
  },

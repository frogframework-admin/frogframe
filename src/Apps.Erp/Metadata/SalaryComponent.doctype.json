    },
    {
      "role": "System Manager",
      "actions": [
        "read",
        "create",
        "write",
        "delete",
        "report",
        "export"
      ],
      "scope": "all"
    }
  ],
  "listView": {
    "titleField": "component_name",
    "searchFields": [
      "component_name",
      "abbreviation"
    ],
    "filters": [
      "component_type",
      "is_active",
      "calculation_type"
    ],
    "defaultSort": [
      {
        "field": "component_name",
        "direction": "asc"
      }
    ]
  },
  "api": {
    "enabled": true,
    "operations": [
      "list",
      "read",
      "create",
      "update"
    ]
  }
}

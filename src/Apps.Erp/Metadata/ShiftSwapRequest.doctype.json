{
  "name": "ShiftSwapRequest",
  "version": 1,
  "title": "Shift Swap Request",
  "module": "HR",
  "description": "Two-party shift exchange request with peer acceptance, manager approval, and automated validation against Workforce Schedule Rules (minimum rest hours and consecutive work day limits).",
  "naming": {
    "pattern": "SSW-{YYYY}-{#####}"
  },
  "document": {
    "trackChanges": true,
    "allowSubmit": true,
    "allowCancel": true,
    "allowAmend": true,
    "allowDelete": true
  },
  "workflow": "ShiftSwapApproval",
  "fields": [
    {
      "name": "requester",
      "type": "Link",
      "label": "Requester",
      "linkTo": "Employee",
      "requiredWhen": "true",
      "default": "$employee",
      "lookupDialog": true,
      "inListView": true,
      "section": "Parties"
    },
    {
      "name": "requester_name",
      "type": "Data",
      "label": "Requester name",
      "fetchFrom": "requester.full_name",
      "inListView": true,
      "section": "Parties"
    },
    {
      "name": "approver",
      "type": "Link",
      "label": "Approver",
      "linkTo": "Employee",
      "lookupDialog": true,
      "section": "Parties",
      "description": "Defaults to the requester's manager / leave approver"
    },
    {
      "name": "target_employee",
      "type": "Link",
      "label": "Swap with employee",
      "linkTo": "Employee",
      "requiredWhen": "true",
      "lookupDialog": true,
      "inListView": true,
      "section": "Parties",
      "column": 2
    },
    {
      "name": "target_employee_name",
      "type": "Data",
      "label": "Target employee name",
      "fetchFrom": "target_employee.full_name",
      "inListView": true,
      "section": "Parties",
      "column": 2
    },
    {
      "name": "swap_date",
      "type": "Date",
      "label": "Requester shift date",
      "requiredWhen": "true",
      "inListView": true,
      "section": "Swap Details"
    },
    {
      "name": "target_swap_date",
      "type": "Date",
      "label": "Target shift date",
      "inListView": true,
      "section": "Swap Details",
      "column": 2,
      "description": "Defaults to Requester shift date when swapping on the same day"
    },
    {
      "name": "requester_schedule_type",
      "type": "Data",
      "label": "Requester current schedule type",
      "readOnlyWhen": "true",
      "section": "Current Schedules"
    },
    {
      "name": "requester_shift_type",
      "type": "Data",
      "label": "Requester current shift",
      "readOnlyWhen": "true",
      "inListView": true,
      "section": "Current Schedules"
    },
    {
      "name": "target_schedule_type",
      "type": "Data",
      "label": "Target current schedule type",
      "readOnlyWhen": "true",
      "section": "Current Schedules",
      "column": 2
    },
    {
      "name": "target_shift_type",
      "type": "Data",
      "label": "Target current shift",
      "readOnlyWhen": "true",
      "inListView": true,
      "section": "Current Schedules",
      "column": 2
    },
    {
      "name": "constraint_notes",
      "type": "Text",
      "label": "Constraint evaluation",
      "readOnlyWhen": "true",
      "section": "Validation"
    },
    {
      "name": "reason",
      "type": "Text",
      "label": "Reason",
      "requiredWhen": "true",
      "section": "Remarks"
    }
  ],
  "permissions": [
    {
      "role": "Employee",
      "actions": [
        "read",
        "create",
        "write",
        "delete"
      ],
      "scope": "match:requester=employee"
    },
    {
      "role": "Employee",
      "actions": [
        "read"
      ],
      "scope": "match:target_employee=employee"
    },
    {
      "role": "Employee",
      "actions": [
        "read"
      ],
      "scope": "match:approver=employee"
    },
    {
      "role": "Manager",
      "actions": [
        "read",
        "report"
      ],
      "scope": "all"
    },
    {
      "role": "HR-Admin",
      "actions": [
        "read",
        "report",
        "export"
      ],
      "scope": "all"
    },
    {
      "role": "HR-Recruitment",
      "actions": [
        "read",
        "report",
        "export"
      ],
      "scope": "all"
    },
    {
      "role": "HR-Employee-Management",
      "actions": [
        "read",
        "report",
        "export"
      ],
      "scope": "all"
    },
    {
      "role": "HR-Time-Attendance",
      "actions": [
        "read",
        "create",
        "write",
        "cancel",
        "amend",
        "report",
        "export"
      ],
      "scope": "all"
    },
    {
      "role": "HR-Talent",
      "actions": [
        "read",
        "report",
        "export"
      ],
      "scope": "all"
    },
    {
      "role": "System Manager",
      "actions": [
        "read",
        "create",
        "write",
        "delete",
        "submit",
        "cancel",
        "amend",
        "report",
        "export"
      ],
      "scope": "all"
    }
  ],
  "listView": {
    "titleField": "requester_name",
    "searchFields": [
      "name",
      "requester",
      "requester_name",
      "target_employee",
      "target_employee_name",
      "reason"
    ],
    "filters": [
      "requester",
      "target_employee",
      "swap_date",
      "workflow_state"
    ],
    "defaultSort": [
      {
        "field": "swap_date",
        "direction": "desc"
      }
    ]
  },
  "api": {
    "enabled": true,
    "operations": [
      "list",
      "read",
      "create",
      "update",
      "delete",
      "action"
    ]
  }
}

{
  "name": "ExpenseClaimType",
  "version": 1,
  "title": "Expense Claim Type",
  "module": "FINANCE",
  "description": "Employee expense category (Workday Expense Item).",
  "naming": {
    "pattern": "field:type_name"
  },
  "document": {
    "trackChanges": true,
    "allowSubmit": false,
    "allowCancel": false,
    "allowAmend": false,
    "allowDelete": true
  },
  "fields": [
    {
      "name": "type_name",
      "type": "Data",
      "label": "Expense type",
      "requiredWhen": "true",
      "inListView": true,
      "description": "e.g. Transport, Hotel, Meals, Entertainment"
    },
    {
      "name": "default_account",
      "type": "Link",
      "label": "Expense account",
      "linkTo": "Account",
      "requiredWhen": "true",
      "linkFilters": [
        {
          "field": "is_group",
          "op": "=",
          "value": false
        },
        {
          "field": "is_active",
          "op": "=",
          "value": true
        },
        {
          "field": "root_type",
          "op": "=",
          "value": "Expense"
        }
      ],
      "inListView": true
    },
    {
      "name": "requires_receipt",
      "type": "Check",
      "label": "Receipt required",
      "default": true,
      "column": 2
    },
    {
      "name": "max_amount_per_item",
      "type": "Currency",
      "label": "Limit per item",
      "min": 0,
      "column": 2,
      "description": "Empty = no limit (checked by hook)"
    },
    {
      "name": "is_entertainment",
      "type": "Check",
      "label": "Entertainment (requires guest list)",
      "default": false,
      "column": 2
    },
    {
      "name": "is_active",
      "type": "Check",
      "label": "Active",
      "default": true,
      "inListView": true,
      "column": 2
    }
  ],
  "permissions": [
    {
      "role": "Finance",
      "actions": [
        "read",
        "create",
        "write",
        "report",
        "export"
      ],
      "scope": "all"
    },
    {
      "role": "Employee",
      "actions": [
        "read"
      ],
      "scope": "all"
    },
    {
      "role": "System Manager",
      "actions": [
        "read",
        "create",
        "write",
        "delete",
        "report",
        "export"
      ],
      "scope": "all"
    }
  ],
  "listView": {
    "titleField": "type_name",
    "searchFields": [
      "type_name"
    ],
    "filters": [
      "is_active"
    ],
    "defaultSort": [
      {
        "field": "modified",
        "direction": "desc"
      }
    ]
  },
  "api": {
    "enabled": true,
    "operations": [
      "list",
      "read",
      "create",
      "update"
    ]
  }
}

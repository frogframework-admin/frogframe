{
  "name": "OrganizationUnit",
  "version": 1,
  "title": "Organization Unit",
  "module": "HR",
  "description": "Organization unit and management hierarchy (Workday Supervisory Organization / SAP OM Org Unit). Supports arbitrary hierarchy depth, effective-dated reorganizations, and materialized paths.",
  "naming": {
    "pattern": "field:org_unit_code"
  },
  "document": {
    "trackChanges": true,
    "allowSubmit": false,
    "allowCancel": false,
    "allowAmend": false,
    "allowDelete": true
  },
  "fields": [
    {
      "name": "org_unit_code",
      "type": "Data",
      "label": "Unit code",
      "requiredWhen": "true",
      "maxLength": 20,
      "inListView": true,
      "section": "Unit"
    },
    {
      "name": "org_unit_name",
      "type": "Data",
      "label": "Unit name",
      "requiredWhen": "true",
      "inListView": true,
      "section": "Unit"
    },
    {
      "name": "unit_type",
      "type": "Link",
      "label": "Unit type",
      "linkTo": "OrganizationUnitType",
      "requiredWhen": "true",
      "lookupDialog": true,
      "inListView": true,
      "section": "Unit"
    },
    {
      "name": "base_unit_code",
      "type": "Data",
      "label": "Canonical unit code",
      "maxLength": 20,
      "section": "Unit",
      "description": "Stable logical identity across effective-dated structure versions; defaults to Unit code"
    },
    {
      "name": "parent_org_unit",
      "type": "Link",
      "label": "Parent unit",
      "linkTo": "OrganizationUnit",
      "lookupDialog": true,
      "inListView": true,
      "section": "Unit",
      "column": 2
    },
    {
      "name": "company",
      "type": "Link",
      "label": "Company",
      "linkTo": "Company",
      "requiredWhen": "true",
      "inListView": true,
      "section": "Unit",
      "column": 2
    },
    {
      "name": "status",
      "type": "Select",
      "label": "Structure status",
      "options": [
        "Draft",
        "Planned",
        "Active",
        "Closed"
      ],
      "default": "Active",
      "inListView": true,
      "section": "Unit",
      "column": 2
    },
    {
      "name": "is_active",
      "type": "Check",
      "label": "Active",
      "default": true,
      "inListView": true,
      "section": "Unit",
      "column": 2
    },
    {
      "name": "manager_position",
      "type": "Link",
      "label": "Head position",
      "linkTo": "Position",
      "linkFilters": [
        {
          "field": "is_manager_position",
          "op": "=",
          "value": true
        }
      ],
      "section": "Head",
      "description": "Workday: manager supervisory organization"
    },
    {
      "name": "manager",
      "type": "Link",
      "label": "Current head",
      "linkTo": "Employee",
      "fetchFrom": "manager_position.current_employee",
      "section": "Head",
      "column": 2
    },
    {
      "name": "staffing_model",
      "type": "Select",
      "label": "Staffing model",
      "requiredWhen": "true",
      "options": [
        "Position",
        "Job"
      ],
      "default": "Position",
      "section": "Settings",
      "description": "Position: each employee fills a Position. Job: a Job Profile is enough (Workday Job Management)"
    },
    {
      "name": "cost_center",
      "type": "Link",
      "label": "Default cost center",
      "linkTo": "CostCenter",
      "linkFilters": [
        {
          "field": "is_group",
          "op": "=",
          "value": false
        }
      ],
      "section": "Settings"
    },
    {
      "name": "location",
      "type": "Link",
      "label": "Primary location",
      "linkTo": "Location",
      "linkFilters": [
        {
          "field": "is_group",
          "op": "=",
          "value": false
        }
      ],
      "section": "Settings",
      "column": 2
    },
    {
      "name": "effective_from",
      "type": "Date",
      "label": "Effective from",
      "requiredWhen": "true",
      "default": "$today",
      "inListView": true,
      "section": "Settings",
      "column": 2
    },
    {
      "name": "effective_to",
      "type": "Date",
      "label": "Effective to",
      "section": "Settings",
      "column": 2,
      "description": "Leave empty for open-ended validity"
    },
    {
      "name": "previous_version",
      "type": "Link",
      "label": "Replaces unit version",
      "linkTo": "OrganizationUnit",
      "lookupDialog": true,
      "section": "Hierarchy",
      "description": "Optional previous effective-dated row that this planned unit replaces on its effective date"
    },
    {
      "name": "depth",
      "type": "Int",
      "label": "Hierarchy depth",
      "readOnlyWhen": "true",
      "inListView": true,
      "section": "Hierarchy",
      "description": "1 = root unit"
    },
    {
      "name": "materialized_path",
      "type": "Data",
      "label": "Materialized path",
      "readOnlyWhen": "true",
      "section": "Hierarchy",
      "column": 2,
      "description": "Computed ancestor path (e.g. /BOD/DIV-TECH/DEPT-IT/)"
    },
    {
      "name": "breadcrumb",
      "type": "Data",
      "label": "Hierarchy breadcrumb",
      "readOnlyWhen": "true",
      "inListView": true,
      "section": "Hierarchy",
      "column": 2,
      "description": "Full organizational lineage display"
    },
    {
      "name": "description",
      "type": "Text",
      "label": "Unit purpose",
      "section": "Remarks"
    }
  ],
  "rules": [
    {
      "name": "valid_period",
      "expr": "empty(effective_to) || effective_to >= effective_from",
      "message": "The effective end date must be on or after the effective start date",
      "field": "effective_to"
    }
  ],
  "permissions": [
    {
      "role": "HR",
      "actions": [
        "read",
        "create",
        "write",
        "report",
        "export"
      ],
      "scope": "all"
    },
    {
      "role": "Employee",
      "actions": [
        "read"
      ],
      "scope": "all"
    },
    {
      "role": "Manager",
      "actions": [
        "read"
      ],
      "scope": "all"
    },
    {
      "role": "System Manager",
      "actions": [
        "read",
        "create",
        "write",
        "delete",
        "report",
        "export"
      ],
      "scope": "all"
    }
  ],
  "listView": {
    "titleField": "org_unit_name",
    "searchFields": [
      "org_unit_code",
      "org_unit_name",
      "base_unit_code",
      "breadcrumb",
      "materialized_path"
    ],
    "filters": [
      "company",
      "unit_type",
      "parent_org_unit",
      "status",
      "is_active",
      "base_unit_code",
      "materialized_path",
      "effective_from",
      "effective_to"
    ],
    "defaultSort": [
      {
        "field": "org_unit_code",
        "direction": "asc"
      }
    ]
  },
  "api": {
    "enabled": true,
    "operations": [
      "list",
      "read",
      "create",
      "update"
    ]
  }
}

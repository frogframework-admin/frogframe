{
  "name": "OpportunityLine",
  "version": 1,
  "title": "Opportunity Item",
  "module": "CRM",
  "isChild": true,
  "fields": [
    {
      "name": "item",
      "type": "Link",
      "label": "Item",
      "linkTo": "Item",
      "linkFilters": [
        {
          "field": "is_active",
          "op": "=",
          "value": true
        },
        {
          "field": "is_sales_item",
          "op": "=",
          "value": true
        }
      ]
    },
    {
      "name": "item_name",
      "type": "Data",
      "label": "Item name",
      "requiredWhen": "true"
    },
    {
      "name": "description",
      "type": "Data",
      "label": "Description"
    },
    {
      "name": "qty",
      "type": "Float",
      "label": "Quantity",
      "requiredWhen": "true",
      "default": 1,
      "min": 0
    },
    {
      "name": "uom",
      "type": "Link",
      "label": "UOM",
      "linkTo": "UOM"
    },
    {
      "name": "rate",
      "type": "Currency",
      "label": "Rate",
      "requiredWhen": "true",
      "default": 0,
      "min": 0
    },
    {
      "name": "discount_percent",
      "type": "Percent",
      "label": "Discount (%)",
      "default": 0,
      "min": 0,
      "max": 100
    },
    {
      "name": "amount",
      "type": "Currency",
      "label": "Amount",
      "compute": "round(qty * rate * (1 - discount_percent / 100), 2)"
    }
  ]
}

{
  "name": "Territory",
  "version": 1,
  "title": "Territory",
  "module": "CRM",
  "description": "Sales territory tree (Salesforce Territory / NetSuite Sales Territory), e.g. Indonesia → Java → Jabodetabek.",
  "naming": {
    "pattern": "field:territory_name"
  },
  "document": {
    "trackChanges": true,
    "allowSubmit": false,
    "allowCancel": false,
    "allowAmend": false,
    "allowDelete": true
  },
  "fields": [
    {
      "name": "territory_name",
      "type": "Data",
      "label": "Territory name",
      "requiredWhen": "true",
      "maxLength": 100,
      "inListView": true
    },
    {
      "name": "parent_territory",
      "type": "Link",
      "label": "Parent territory",
      "linkTo": "Territory",
      "linkFilters": [
        {
          "field": "is_group",
          "op": "=",
          "value": true
        }
      ],
      "inListView": true
    },
    {
      "name": "is_group",
      "type": "Check",
      "label": "Group",
      "default": false,
      "column": 2
    },
    {
      "name": "territory_manager",
      "type": "Link",
      "label": "Territory manager",
      "linkTo": "Employee",
      "lookupDialog": true,
      "column": 2
    },
    {
      "name": "is_active",
      "type": "Check",
      "label": "Active",
      "default": true,
      "inListView": true,
      "column": 2
    }
  ],
  "permissions": [
    {
      "role": "Manager",
      "actions": [
        "read",
        "create",
        "write",
        "report",
        "export"
      ],
      "scope": "all"
    },
    {
      "role": "Sales",
      "actions": [
        "read"
      ],
      "scope": "all"
    },
    {
      "role": "Employee",
      "actions": [
        "read"
      ],
      "scope": "all"
    },
    {
      "role": "System Manager",
      "actions": [
        "read",
        "create",
        "write",
        "delete",
        "report",
        "export"
      ],
      "scope": "all"
    }
  ],
  "listView": {
    "titleField": "territory_name",
    "searchFields": [
      "territory_name"
    ],
    "filters": [
      "parent_territory",
      "is_group"
    ],
    "defaultSort": [
      {
        "field": "territory_name",
        "direction": "asc"
      }
    ]
  },
  "api": {
    "enabled": true,
    "operations": [
      "list",
      "read",
      "create",
      "update"
    ]
  }
}

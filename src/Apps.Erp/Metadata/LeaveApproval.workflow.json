{
  "name": "LeaveApproval",
  "docType": "LeaveApplication",
  "version": 1,
  "initialState": "Draft",
  "states": [
    {
      "name": "Draft",
      "docStatus": 0,
      "tone": "neutral"
    },
    {
      "name": "Pending Approval",
      "docStatus": 1,
      "tone": "pending"
    },
    {
      "name": "Approved",
      "docStatus": 1,
      "tone": "positive"
    },
    {
      "name": "Rejected",
      "docStatus": 2,
      "tone": "negative"
    },
    {
      "name": "Cancelled",
      "docStatus": 2,
      "tone": "negative"
    }
  ],
  "transitions": [
    {
      "from": "Draft",
      "to": "Pending Approval",
      "action": "Submit for approval",
      "allowedRoles": [
        "Employee",
        "HR"
      ],
      "condition": "employee == user.employee || has_role('HR')"
    },
    {
      "from": "Pending Approval",
      "to": "Approved",
      "action": "Approve",
      "allowedRoles": [
        "Employee"
      ],
      "condition": "leave_approver == user.employee && employee != user.employee"
    },
    {
      "from": "Pending Approval",
      "to": "Rejected",
      "action": "Reject",
      "allowedRoles": [
        "Employee"
      ],
      "condition": "leave_approver == user.employee && employee != user.employee",
      "requireComment": true
    },
    {
      "from": "Pending Approval",
      "to": "Approved",
      "action": "Approve (HR)",
      "allowedRoles": [
        "HR"
      ],
      "condition": "employee != user.employee",
      "requireComment": true
    },
    {
      "from": "Pending Approval",
      "to": "Cancelled",
      "action": "Withdraw",
      "allowedRoles": [
        "Employee"
      ],
      "condition": "employee == user.employee"
    },
    {
      "from": "Approved",
      "to": "Cancelled",
      "action": "Cancel",
      "allowedRoles": [
        "HR"
      ],
      "requireComment": true
    }
  ]
}

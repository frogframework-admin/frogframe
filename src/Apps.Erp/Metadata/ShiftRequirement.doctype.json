{
  "name": "ShiftRequirement",
  "version": 1,
  "title": "Shift Requirement",
  "module": "HR",
  "description": "Operational manpower demand and minimum headcount / competency requirement per organization unit and shift type.",
  "naming": {
    "pattern": "SREQ-{YYYY}-{#####}"
  },
  "document": {
    "trackChanges": true,
    "allowSubmit": false,
    "allowCancel": false,
    "allowAmend": false,
    "allowDelete": true
  },
  "fields": [
    {
      "name": "company",
      "type": "Link",
      "label": "Company",
      "linkTo": "Company",
      "requiredWhen": "true",
      "inListView": true,
      "section": "Scope"
    },
    {
      "name": "organization_unit",
      "type": "Link",
      "label": "Organization unit",
      "linkTo": "OrganizationUnit",
      "requiredWhen": "true",
      "lookupDialog": true,
      "inListView": true,
      "section": "Scope"
    },
    {
      "name": "shift_type",
      "type": "Link",
      "label": "Shift type",
      "linkTo": "ShiftType",
      "requiredWhen": "true",
      "lookupDialog": true,
      "inListView": true,
      "section": "Requirement",
      "column": 2
    },
    {
      "name": "job_profile",
      "type": "Link",
      "label": "Required job profile / role",
      "linkTo": "JobProfile",
      "lookupDialog": true,
      "inListView": true,
      "section": "Requirement",
      "column": 2,
      "description": "Optional: filter requirement by specific role/competency (e.g. Operator, Technician)"
    },
    {
      "name": "day_scope",
      "type": "Select",
      "label": "Day scope",
      "requiredWhen": "true",
      "options": [
        "All days",
        "Weekdays",
        "Weekends",
        "Public holidays"
      ],
      "default": "All days",
      "inListView": true,
      "section": "Requirement"
    },
    {
      "name": "min_headcount",
      "type": "Int",
      "label": "Minimum headcount",
      "requiredWhen": "true",
      "default": 1,
      "min": 1,
      "inListView": true,
      "section": "Headcount"
    },
    {
      "name": "target_headcount",
      "type": "Int",
      "label": "Target headcount",
      "default": 1,
      "min": 1,
      "inListView": true,
      "section": "Headcount",
      "column": 2
    },
    {
      "name": "effective_from",
      "type": "Date",
      "label": "Effective from",
      "requiredWhen": "true",
      "default": "$today",
      "inListView": true,
      "section": "Validity"
    },
    {
      "name": "effective_to",
      "type": "Date",
      "label": "Effective to",
      "section": "Validity",
      "column": 2
    },
    {
      "name": "is_active",
      "type": "Check",
      "label": "Active",
      "default": true,
      "inListView": true,
      "section": "Validity",
      "column": 2
    },
    {
      "name": "remarks",
      "type": "Text",
      "label": "Remarks",
      "section": "Remarks"
    }
  ],
  "rules": [
    {
      "name": "valid_period",
      "expr": "empty(effective_to) || effective_to >= effective_from",
      "message": "The effective end date must be on or after the effective start date",
      "field": "effective_to"
    }
  ],
  "permissions": [
    {
      "role": "HR",
      "actions": [
        "read",
        "create",
        "write",
        "delete",
        "report",
        "export"
      ],
      "scope": "all"
    },
    {
      "role": "Manager",
      "actions": [
        "read",
        "create",
        "write",
        "report"
      ],
      "scope": "all"
    },
    {
      "role": "Employee",
      "actions": [
        "read"
      ],
      "scope": "all"
    },
    {
      "role": "System Manager",
      "actions": [
        "read",
        "create",
        "write",
        "delete",
        "report",
        "export"
      ],
      "scope": "all"
    }
  ],
  "listView": {
    "titleField": "shift_type",
    "searchFields": [
      "name",
      "organization_unit",
      "shift_type",
      "job_profile"
    ],
    "filters": [
      "company",
      "organization_unit",
      "shift_type",
      "job_profile",
      "day_scope",
      "is_active"
    ],
    "defaultSort": [
      {
        "field": "organization_unit",
        "direction": "asc"
      }
    ]
  },
  "api": {
    "enabled": true,
    "operations": [
      "list",
      "read",
      "create",
      "update",
      "delete"
    ]
  }
}

{
  "name": "LostReason",
  "version": 1,
  "title": "Lost Reason",
  "module": "CRM",
  "naming": {
    "pattern": "field:reason_name"
  },
  "document": {
    "trackChanges": true,
    "allowSubmit": false,
    "allowCancel": false,
    "allowAmend": false,
    "allowDelete": true
  },
  "fields": [
    {
      "name": "reason_name",
      "type": "Data",
      "label": "Reason",
      "requiredWhen": "true",
      "inListView": true,
      "description": "e.g. Price, Features, Lost to competitor, Budget postponed"
    },
    {
      "name": "is_active",
      "type": "Check",
      "label": "Active",
      "default": true,
      "inListView": true,
      "column": 2
    }
  ],
  "permissions": [
    {
      "role": "Manager",
      "actions": [
        "read",
        "create",
        "write",
        "report",
        "export"
      ],
      "scope": "all"
    },
    {
      "role": "Sales",
      "actions": [
        "read"
      ],
      "scope": "all"
    },
    {
      "role": "Employee",
      "actions": [
        "read"
      ],
      "scope": "all"
    },
    {
      "role": "System Manager",
      "actions": [
        "read",
        "create",
        "write",
        "delete",
        "report",
        "export"
      ],
      "scope": "all"
    }
  ],
  "listView": {
    "titleField": "reason_name",
    "searchFields": [
      "reason_name"
    ],
    "filters": [],
    "defaultSort": [
      {
        "field": "reason_name",
        "direction": "asc"
      }
    ]
  },
  "api": {
    "enabled": true,
    "operations": [
      "list",
      "read",
      "create",
      "update"
    ]
  }
}

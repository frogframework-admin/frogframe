  ],
  "listView": {
    "titleField": "kpi_name",
    "searchFields": [
      "kpi_code",
      "kpi_name",
      "sub_area"
    ],
    "filters": [
      "kpi_module",
      "implementation",
      "frequency"
    ],
    "defaultSort": [
      {
        "field": "kpi_code",
        "direction": "asc"
      }
    ]
  },
  "api": {
    "enabled": true,
    "operations": [
      "list",
      "read"
    ]
  },
  "import": {
    "enabled": true
  }

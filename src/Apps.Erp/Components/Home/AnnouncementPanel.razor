@using Apps.Erp.Hooks
@using Framework.Documents
@using Framework.Localization
@using Framework.Persistence
@using Framework.Security
@inject IDocumentStore Store
@inject CurrentUser Current
@inject TimeProvider Clock
@inject UiText T

@* Targeting rules: Announcements.VisibleAsync (company, unit and sub-units from the Employee record, publish window). *@
@if (items.Count > 0)
{
    <section class="home-card" aria-label="@T["Announcements"]">
        <div class="section-head-row">
            <h2>@T["Announcements"]</h2>
        </div>
        <ul class="home-list">
            @foreach (var a in items)
            {
                <li>
                    <div>
                        <strong><a href="/app/Announcement/@a.Name">@a.Data.Str("title")</a></strong>
                        @if (Announcements.NeedsAcknowledgment(a, employeeId))
                        {
                            <BbBadge Variant="BadgeVariant.Soft">@T["Please confirm you have read this"]</BbBadge>
                        }
                        <div class="muted small">@Excerpt(a.Data.Str("body"))</div>
                    </div>
                </li>
            }
        </ul>
    </section>
}

@code {
    private IReadOnlyList<Document> items = [];
    private string? employeeId;

    protected override async Task OnInitializedAsync()
    {
        if (Current.User is not { } u) return;
        employeeId = u.Attr("employee");
        var today = Hr.Today(Clock);
        items = await Announcements.VisibleAsync(new Masters(Store, u.TenantId), employeeId, today, CancellationToken.None);
    }

    private static string Excerpt(string? body) =>
        string.IsNullOrEmpty(body) ? "" : body.Length <= 200 ? body : body[..200].TrimEnd() + "…";
}

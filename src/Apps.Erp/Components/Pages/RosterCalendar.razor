@page "/hr/roster-calendar"
@using System.Globalization
@using Apps.Erp.Hooks
@using Framework.Persistence
@using Microsoft.JSInterop
@inject DocumentService Docs
@inject CurrentUser Current
@inject IPermissionService Perms
@inject IMetadataProvider Metadata
@inject ReportDownloads Downloads
@inject IJSRuntime JS

<PageTitle>Workforce Roster Calendar · FrogFrame</PageTitle>

<header class="page-head" style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:1rem">
    <div>
        <h1>Workforce Roster &amp; Shift Calendar</h1>
        <p>Visual monthly schedule per squad and employee, with shift color coding, rest/leave/holiday indicators, and manpower coverage analysis.</p>
    </div>
    <div style="display:flex;gap:.5rem;flex-wrap:wrap">
        <a class="bb-btn bb-btn-outline" href="/app/ShiftSwapRequest/new" style="text-decoration:none;padding:.45rem .85rem;border:1px solid var(--border,#cbd5e1);border-radius:.375rem;font-size:.875rem">
            Request Shift Swap
        </a>
        @if (Current.Required.HasRole(ErpRoles.HrTimeAttendance) || Current.Required.HasRole(ErpRoles.Manager))
        {
            <a class="bb-btn bb-btn-outline" href="/app/ShiftOverride/new" style="text-decoration:none;padding:.45rem .85rem;border:1px solid var(--border,#cbd5e1);border-radius:.375rem;font-size:.875rem">
                New Shift Override
            </a>
            <a class="bb-btn bb-btn-outline" href="/app/ScheduleOptimization/new" style="text-decoration:none;padding:.45rem .85rem;border:1px solid var(--border,#cbd5e1);border-radius:.375rem;font-size:.875rem">
                Optimize Schedule
            </a>
        }
        @if (CanExport)
        {
            <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" Disabled="@(exporting || FilteredEmployeeNames.Count == 0)" OnClick="@(() => ExportAsync("xlsx"))">
                <LucideIcon Name="file-spreadsheet" Size="15" /> Export Excel
            </BbButton>
            <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" Disabled="@(exporting || FilteredEmployeeNames.Count == 0)" OnClick="@(() => ExportAsync("csv"))">
                <LucideIcon Name="download" Size="15" /> Export CSV
            </BbButton>
        }
        @if (CanGenerate)
        {
            <BbButton Size="ButtonSize.Small" OnClick="OpenGenerateDialog">
                <LucideIcon Name="calendar-plus" Size="15" /> Generate Roster
            </BbButton>
        }
    </div>
</header>

@if (notice is not null)
{
    <BbAlert Variant="AlertVariant.Success" Style="margin-bottom:1rem"><BbAlertDescription>@notice</BbAlertDescription></BbAlert>
}

@* ---------------- Generate Roster dialog: saves a ScheduleGeneration batch, whose hook materializes the schedules ---------------- *@
<BbDialog Open="@generateOpen" OpenChanged="v => generateOpen = v">
    <BbDialogContent Class="sm:max-w-lg">
        <BbDialogHeader>
            <BbDialogTitle>Generate Roster</BbDialogTitle>
            <BbDialogDescription>
                Creates daily schedules from shift assignments and rotation patterns. Locked days, overrides, approved swaps and leave are kept.
                The batch is saved as a Schedule Generation record.
            </BbDialogDescription>
        </BbDialogHeader>

        @if (generateError is not null)
        {
            <BbAlert Variant="AlertVariant.Danger"><BbAlertDescription>@generateError</BbAlertDescription></BbAlert>
        }

        <div class="stack" style="gap:.75rem;margin:.5rem 0">
            <div>
                <label class="small muted" for="gen-company" style="display:block;margin-bottom:.25rem">Company *</label>
                <select id="gen-company" value="@genCompany" @onchange="e => genCompany = e.Value as string ?? string.Empty" style="@InputStyle;width:100%">
                    @foreach (var c in companies)
                    {
                        <option value="@c.Name">@(Str(c, "company_name") ?? c.Name)</option>
                    }
                </select>
            </div>
            <div>
                <label class="small muted" for="gen-unit" style="display:block;margin-bottom:.25rem">Organization unit (subtree)</label>
                <select id="gen-unit" value="@genUnit" @onchange="e => genUnit = e.Value as string ?? string.Empty" style="@InputStyle;width:100%">
                    <option value="">All units</option>
                    @foreach (var u in orgUnits)
                    {
                        <option value="@u.Name">@(Str(u, "breadcrumb") ?? Str(u, "org_unit_name") ?? u.Name)</option>
                    }
                </select>
            </div>
            <div>
                <label class="small muted" for="gen-group" style="display:block;margin-bottom:.25rem">Shift group / squad</label>
                <select id="gen-group" value="@genGroup" @onchange="e => genGroup = e.Value as string ?? string.Empty" style="@InputStyle;width:100%">
                    <option value="">All groups</option>
                    @foreach (var g in shiftGroups)
                    {
                        <option value="@g.Name">@(Str(g, "group_name") ?? g.Name)</option>
                    }
                </select>
            </div>
            <div style="display:flex;gap:.75rem;flex-wrap:wrap">
                <div style="flex:1;min-width:9rem">
                    <label class="small muted" for="gen-from" style="display:block;margin-bottom:.25rem">From *</label>
                    <input id="gen-from" type="date" value="@genFrom" @onchange="e => genFrom = e.Value as string ?? string.Empty" style="@InputStyle;width:100%" />
                </div>
                <div style="flex:1;min-width:9rem">
                    <label class="small muted" for="gen-to" style="display:block;margin-bottom:.25rem">To *</label>
                    <input id="gen-to" type="date" value="@genTo" @onchange="e => genTo = e.Value as string ?? string.Empty" style="@InputStyle;width:100%" />
                </div>
            </div>
            <div class="label-row">
                <BbCheckbox Id="gen-overwrite" @bind-Checked="genOverwrite" />
                <BbLabel For="gen-overwrite">Replace existing unlocked schedules in this period</BbLabel>
            </div>
            <p class="muted small" style="margin:0">At most @ScheduleGenerationHook.MaxBatchDays days per batch.</p>
        </div>

        <BbDialogFooter>
            <BbButton Variant="ButtonVariant.Outline" OnClick="() => generateOpen = false">Cancel</BbButton>
            <BbButton Disabled="@(generating || string.IsNullOrEmpty(genCompany) || string.IsNullOrEmpty(genFrom) || string.IsNullOrEmpty(genTo))" OnClick="GenerateAsync">
                <LucideIcon Name="calendar-plus" Size="16" /> @(generating ? "Generating…" : "Generate")
            </BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

@if (error is not null)
{
    <BbAlert Variant="AlertVariant.Danger"><BbAlertDescription>@error</BbAlertDescription></BbAlert>
}
else if (schedules is null)
{
    <div class="stack"><BbSkeleton Height="3rem" /><BbSkeleton Height="16rem" /></div>
}
else
{
    <BbCard Style="margin-bottom:1rem">
        <BbCardContent>
            <div style="display:flex;gap:1rem;flex-wrap:wrap;align-items:flex-end;padding-top:.75rem">
                <div>
                    <label class="small muted" style="display:block;margin-bottom:.25rem">Month (YYYY-MM)</label>
                    <input type="month" value="@selectedMonth" @onchange="OnMonthChanged"
                           style="padding:.4rem .6rem;border:1px solid var(--border,#cbd5e1);border-radius:.375rem;font-size:.875rem" />
                </div>
                <div>
                    <label class="small muted" style="display:block;margin-bottom:.25rem">Organization unit (subtree)</label>
                    <select value="@selectedUnit" @onchange="OnUnitChanged"
                            style="padding:.4rem .6rem;border:1px solid var(--border,#cbd5e1);border-radius:.375rem;font-size:.875rem;min-width:14rem">
                        <option value="">All units</option>
                        @foreach (var u in orgUnits)
                        {
                            <option value="@u.Name">@(Str(u, "breadcrumb") ?? Str(u, "org_unit_name") ?? u.Name)</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="small muted" style="display:block;margin-bottom:.25rem">Shift group / squad</label>
                    <select value="@selectedGroup" @onchange="OnGroupChanged"
                            style="padding:.4rem .6rem;border:1px solid var(--border,#cbd5e1);border-radius:.375rem;font-size:.875rem;min-width:11rem">
                        <option value="">All groups</option>
                        @foreach (var g in shiftGroups)
                        {
                            <option value="@g.Name">@(Str(g, "group_name") ?? g.Name)</option>
                        }
                    </select>
                </div>
                <div style="display:flex;gap:.5rem;align-items:center;margin-left:auto;font-size:.75rem;flex-wrap:wrap">
                    <span style="padding:.2rem .5rem;border-radius:.25rem;background:#dbeafe;color:#1e40af;font-weight:600">WORK (Day/Morning)</span>
                    <span style="padding:.2rem .5rem;border-radius:.25rem;background:#fef3c7;color:#92400e;font-weight:600">WORK (Afternoon)</span>
                    <span style="padding:.2rem .5rem;border-radius:.25rem;background:#e0e7ff;color:#3730a3;font-weight:600">WORK (Night)</span>
                    <span style="padding:.2rem .5rem;border-radius:.25rem;background:#f1f5f9;color:#475569;font-weight:600">OFF / REST</span>
                    <span style="padding:.2rem .5rem;border-radius:.25rem;background:#dcfce7;color:#166534;font-weight:600">LEAVE</span>
                    <span style="padding:.2rem .5rem;border-radius:.25rem;background:#FCE7F3;color:#9d174d;font-weight:600">HOLIDAY</span>
                </div>
            </div>
        </BbCardContent>
    </BbCard>

    <BbTabs Value="@activeTab" ValueChanged="v => activeTab = v ?? activeTab">
        <BbTabsList>
            <BbTabsTrigger Value="calendar"><LucideIcon Name="calendar-days" Size="15" /> Monthly Roster Grid (@FilteredEmployeeNames.Count employees)</BbTabsTrigger>
            <BbTabsTrigger Value="coverage"><LucideIcon Name="users" Size="15" /> Shift Coverage &amp; Manpower (@CoverageRows.Count checks)</BbTabsTrigger>
        </BbTabsList>

        <BbTabsContent Value="calendar">
            <BbCard Style="margin-top:.75rem">
                <BbCardContent>
                    @if (FilteredEmployeeNames.Count == 0)
                    {
                        <div style="padding:2rem;text-align:center" class="muted">
                            No materialized daily schedules found for @selectedMonth. Create a <strong>Schedule Generation</strong> batch to materialize roster schedules.
                        </div>
                    }
                    else
                    {
                        <div style="overflow-x:auto;padding-top:.75rem">
                            <table style="width:100%;border-collapse:collapse;font-size:.78rem">
                                <thead>
                                    <tr style="border-bottom:2px solid var(--border,#e2e8f0);text-align:left">
                                        <th style="padding:.5rem;position:sticky;left:0;background:var(--card,#fff);min-width:11rem;z-index:1">Employee</th>
                                        <th style="padding:.5rem;min-width:7rem">Unit / Squad</th>
                                        @foreach (var day in MonthDays)
                                        {
                                            var isWknd = day.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday;
                                            <th style="padding:.35rem .25rem;text-align:center;min-width:2.6rem;background:@(isWknd ? "rgba(241,245,249,.7)" : "transparent")">
                                                <div>@day.Day</div>
                                                <div class="muted" style="font-size:.65rem;font-weight:400">@day.ToString("ddd", CultureInfo.InvariantCulture)</div>
                                            </th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var empId in FilteredEmployeeNames)
                                    {
                                        var empRow = ScheduleByEmpDate.GetValueOrDefault(empId);
                                        var firstDoc = empRow?.Values.FirstOrDefault();
                                        var empName = firstDoc is not null ? (Str(firstDoc, "employee_name") ?? empId) : empId;
                                        var unitCode = firstDoc is not null ? Str(firstDoc, "organization_unit") : null;
                                        var grpCode = firstDoc is not null ? Str(firstDoc, "shift_group") : null;
                                        <tr style="border-bottom:1px solid var(--border,#f1f5f9)">
                                            <td style="padding:.45rem .5rem;position:sticky;left:0;background:var(--card,#fff);font-weight:500">
                                                <a href="/app/Employee/@empId" style="text-decoration:none;color:inherit">@empName</a>
                                                <div class="muted" style="font-size:.68rem">@empId</div>
                                            </td>
                                            <td style="padding:.45rem .5rem">
                                                <div>@(unitCode ?? "-")</div>
                                                @if (!string.IsNullOrEmpty(grpCode))
                                                {
                                                    <div class="muted" style="font-size:.68rem">@grpCode</div>
                                                }
                                            </td>
                                            @foreach (var day in MonthDays)
                                            {
                                                var slot = empRow is not null && empRow.TryGetValue(day, out var s) ? s : null;
                                                var (badgeText, bg, fg, tooltip) = FormatCell(slot);
                                                <td style="padding:.25rem;text-align:center" title="@tooltip">
                                                    @if (slot is not null)
                                                    {
                                                        <a href="/app/EmployeeDailySchedule/@slot.Name"
                                                           style="display:inline-block;width:100%;padding:.2rem .15rem;border-radius:.25rem;background:@bg;color:@fg;font-weight:600;text-decoration:none;font-size:.7rem">
                                                            @badgeText
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <span class="muted">-</span>
                                                    }
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                                @if (SlotShifts.Count > 0)
                                {
                                    @* One row per required shift: scheduled / minimum for each day; red when any requirement of the slot is short. *@
                                    <tfoot>
                                        @foreach (var shift in SlotShifts)
                                        {
                                            <tr style="border-top:1px solid var(--border,#e2e8f0)">
                                                <td colspan="2" style="padding:.4rem .5rem;position:sticky;left:0;background:var(--card,#fff);font-weight:600;font-size:.72rem">
                                                    <LucideIcon Name="users" Size="12" /> Coverage · @shift
                                                </td>
                                                @foreach (var day in MonthDays)
                                                {
                                                    var cell = SlotByDayShift.GetValueOrDefault((day, shift));
                                                    var (cbg, cfg, ctip) = FormatSlot(cell);
                                                    <td style="padding:.2rem;text-align:center" title="@ctip">
                                                        @if (cell is not null)
                                                        {
                                                            <span class="roster-slot" data-status="@cell.Status"
                                                                  style="display:inline-block;width:100%;padding:.15rem .1rem;border-radius:.25rem;background:@cbg;color:@cfg;font-weight:600;font-size:.68rem">
                                                                @cell.Actual/@cell.Required
                                                            </span>
                                                        }
                                                    </td>
                                                }
                                            </tr>
                                        }
                                    </tfoot>
                                }
                            </table>
                        </div>
                    }
                </BbCardContent>
            </BbCard>
        </BbTabsContent>

        <BbTabsContent Value="coverage">
            <BbCard Style="margin-top:.75rem">
                <BbCardContent>
                    @if (CoverageRows.Count == 0)
                    {
                        <div style="padding:2rem;text-align:center" class="muted">
                            No Shift Requirements configured for this scope. Add manpower targets in <strong>HR → Shift Requirement</strong>.
                        </div>
                    }
                    else
                    {
                        <div style="overflow-x:auto;padding-top:.75rem">
                            <table style="width:100%;border-collapse:collapse;font-size:.85rem">
                                <thead>
                                    <tr style="border-bottom:2px solid var(--border,#e2e8f0);text-align:left">
                                        <th style="padding:.5rem">Work Date</th>
                                        <th style="padding:.5rem">Organization Unit</th>
                                        <th style="padding:.5rem">Shift</th>
                                        <th style="padding:.5rem">Job Profile</th>
                                        <th style="padding:.5rem;text-align:right">Min Required</th>
                                        <th style="padding:.5rem;text-align:right">Target</th>
                                        <th style="padding:.5rem;text-align:right">Actual Scheduled</th>
                                        <th style="padding:.5rem">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in CoverageRows)
                                    {
                                        var badgeBg = row.IsUnderstaffed ? "#fee2e2" : "#dcfce7";
                                        var badgeFg = row.IsUnderstaffed ? "#991b1b" : "#166534";
                                        <tr style="border-bottom:1px solid var(--border,#f1f5f9)">
                                            <td style="padding:.5rem">@row.WorkDate.ToString("yyyy-MM-dd (ddd)", CultureInfo.InvariantCulture)</td>
                                            <td style="padding:.5rem">@(row.OrganizationUnit.Length == 0 ? "All units" : row.OrganizationUnit)</td>
                                            <td style="padding:.5rem">@row.ShiftType</td>
                                            <td style="padding:.5rem">@(row.JobProfile ?? "All roles")</td>
                                            <td style="padding:.5rem;text-align:right">@row.MinHeadcount</td>
                                            <td style="padding:.5rem;text-align:right">@row.TargetHeadcount</td>
                                            <td style="padding:.5rem;text-align:right;font-weight:600">@row.ActualHeadcount</td>
                                            <td style="padding:.5rem">
                                                <span style="padding:.2rem .55rem;border-radius:.25rem;background:@badgeBg;color:@badgeFg;font-weight:600;font-size:.75rem">
                                                    @row.Status
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </BbCardContent>
            </BbCard>
        </BbTabsContent>
    </BbTabs>
}

@code {
    private string selectedMonth = DateTime.UtcNow.ToString("yyyy-MM", CultureInfo.InvariantCulture);
    private string selectedUnit = "";
    private string selectedGroup = "";
    private string activeTab = "calendar";
    private string? error;
    private string? notice;
    private bool exporting;

    private const string InputStyle = "padding:.4rem .6rem;border:1px solid var(--border,#cbd5e1);border-radius:.375rem;font-size:.875rem";

    // Generate Roster dialog
    private bool generateOpen;
    private bool generating;
    private string? generateError;
    private string genCompany = "";
    private string genUnit = "";
    private string genGroup = "";
    private string genFrom = "";
    private string genTo = "";
    private bool genOverwrite = true;
    private IReadOnlyList<Document> companies = [];
    private Dictionary<string, string?> jobProfileByEmployee = new(StringComparer.Ordinal);

    private IReadOnlyList<Document> orgUnits = [];
    private IReadOnlyList<Document> shiftGroups = [];
    private IReadOnlyList<Document> requirements = [];
    private IReadOnlyList<Document>? schedules;

    private List<DateOnly> MonthDays = [];
    private Dictionary<string, Dictionary<DateOnly, Document>> ScheduleByEmpDate = new(StringComparer.Ordinal);
    private List<string> FilteredEmployeeNames = [];
    private List<WsmCoverage.CoverageRow> CoverageRows = [];
    private Dictionary<(DateOnly Date, string Shift), WsmRosterView.SlotCoverage> SlotByDayShift = new();
    private List<string> SlotShifts = [];

    private bool CanGenerate =>
        Current.Required.HasRole(ErpRoles.HrTimeAttendance)
        && Metadata.Current.TryGet("ScheduleGeneration", out var meta) && Perms.Can(Current.Required, meta, DocActions.Create);

    private bool CanExport =>
        Metadata.Current.TryGet("EmployeeDailySchedule", out var meta) && Perms.Can(Current.Required, meta, DocActions.Export);

    private static string? Str(Document d, string f) => d.Data.GetValueOrDefault(f) as string;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            orgUnits = await Docs.QueryForReportAsync(Current.Required, "OrganizationUnit", [], DocActions.Read);
            if (Current.Required.HasRole(ErpRoles.HrTimeAttendance) || Current.Required.HasRole(ErpRoles.Manager))
            {
                shiftGroups = await Docs.QueryForReportAsync(Current.Required, "ShiftGroup", [], DocActions.Read);
                requirements = await Docs.QueryForReportAsync(Current.Required, "ShiftRequirement", [], DocActions.Read);
                // Job profiles, for requirements limited to one job profile.
                if (requirements.Any(r => Str(r, "job_profile") is not null))
                    jobProfileByEmployee = (await Docs.QueryForReportAsync(Current.Required, "Employee", [], DocActions.Read))
                        .ToDictionary(e => e.Name, e => Str(e, "job_profile"), StringComparer.Ordinal);
            }
            if (CanGenerate)
                companies = await Docs.QueryForReportAsync(Current.Required, "Company", [], DocActions.Read);
            await LoadMonthAsync();
        }
        catch (PermissionDeniedException ex) { error = ex.Message; }
    }

    private async Task OnMonthChanged(ChangeEventArgs e)
    {
        if (e.Value is string m && m.Length == 7)
        {
            selectedMonth = m;
            await LoadMonthAsync();
        }
    }

    private void OnUnitChanged(ChangeEventArgs e)
    {
        selectedUnit = e.Value as string ?? "";
        RebuildGrid();
    }

    private void OnGroupChanged(ChangeEventArgs e)
    {
        selectedGroup = e.Value as string ?? "";
        RebuildGrid();
    }

    private async Task LoadMonthAsync()
    {
        if (!DateOnly.TryParseExact(selectedMonth + "-01", "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var start))
            start = new DateOnly(DateTime.UtcNow.Year, DateTime.UtcNow.Month, 1);
        var end = start.AddMonths(1).AddDays(-1);

        MonthDays.Clear();
        for (var d = start; d <= end; d = d.AddDays(1))
            MonthDays.Add(d);

        schedules = await Docs.QueryForReportAsync(Current.Required, "EmployeeDailySchedule",
            [new FilterClause("work_date", ">=", start.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)),
             new FilterClause("work_date", "<=", end.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture))], DocActions.Read);
        RebuildGrid();
    }

    private void RebuildGrid()
    {
        if (schedules is null) return;

        HashSet<string>? allowedUnits = null;
        if (!string.IsNullOrEmpty(selectedUnit))
        {
            var root = orgUnits.FirstOrDefault(u => u.Name == selectedUnit);
            var prefix = root is not null ? (Str(root, "materialized_path") ?? $"/{root.Name}/") : $"/{selectedUnit}/";
            allowedUnits = orgUnits
                .Where(u => u.Name == selectedUnit || (Str(u, "materialized_path") ?? "").StartsWith(prefix, StringComparison.Ordinal))
                .Select(u => u.Name)
                .ToHashSet(StringComparer.Ordinal);
        }

        ScheduleByEmpDate.Clear();
        foreach (var doc in schedules)
        {
            var emp = Str(doc, "employee");
            var wdStr = Str(doc, "work_date");
            if (emp is null || wdStr is null || !DateOnly.TryParseExact(wdStr, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var wd))
                continue;
            if (allowedUnits is not null && (Str(doc, "organization_unit") is not { } u || !allowedUnits.Contains(u)))
                continue;
            if (!string.IsNullOrEmpty(selectedGroup) && Str(doc, "shift_group") != selectedGroup)
                continue;

            if (!ScheduleByEmpDate.TryGetValue(emp, out var byDate))
            {
                byDate = new Dictionary<DateOnly, Document>();
                ScheduleByEmpDate[emp] = byDate;
            }
            byDate[wd] = doc;
        }

        FilteredEmployeeNames = ScheduleByEmpDate.Keys.OrderBy(x => x, StringComparer.Ordinal).ToList();

        // Coverage per requirement scope and per day/shift slot (same rules as the schedule optimizer).
        var units = orgUnits.Select(u => new WsmRosterView.UnitNode(u.Name, Str(u, "materialized_path"))).ToList();
        CoverageRows = WsmRosterView.CoverageRows(MonthDays, requirements.Select(r => r.Data), schedules.Select(x => x.Data),
            jobProfileByEmployee, units, string.IsNullOrEmpty(selectedUnit) ? null : selectedUnit);
        SlotByDayShift = WsmRosterView.SlotSummary(CoverageRows);
        SlotShifts = SlotByDayShift.Keys.Select(k => k.Shift).Distinct().Order(StringComparer.Ordinal).ToList();
    }

    private static (string Bg, string Fg, string Tooltip) FormatSlot(WsmRosterView.SlotCoverage? c)
    {
        if (c is null) return ("transparent", "inherit", "No requirement");
        var tip = $"{c.Date:yyyy-MM-dd} {c.ShiftType}: {c.Actual} scheduled, minimum {c.Required}, target {c.Target}";
        if (c.ShortScopes.Count > 0) tip += " · Short: " + string.Join("; ", c.ShortScopes);
        return c.Status switch
        {
            "Understaffed" => ("#fee2e2", "#991b1b", tip),
            "Overstaffed" => ("#fef3c7", "#92400e", tip),
            _ => ("#dcfce7", "#166534", tip),
        };
    }

    // ---------------- Generate Roster ----------------

    private void OpenGenerateDialog()
    {
        generateError = null;
        if (!DateOnly.TryParseExact(selectedMonth + "-01", "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var start))
            start = new DateOnly(DateTime.UtcNow.Year, DateTime.UtcNow.Month, 1);
        genFrom = start.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        genTo = start.AddMonths(1).AddDays(-1).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        genUnit = selectedUnit;
        genGroup = selectedGroup;
        // The company of the selected unit, else the first company.
        var unitCompany = orgUnits.FirstOrDefault(u => u.Name == selectedUnit) is { } unit ? Str(unit, "company") : null;
        genCompany = unitCompany ?? (companies.Count > 0 ? companies[0].Name : "");
        generateOpen = true;
    }

    private async Task GenerateAsync()
    {
        generating = true;
        generateError = null;
        try
        {
            var data = new Dictionary<string, object?>
            {
                ["company"] = genCompany,
                ["organization_unit"] = string.IsNullOrEmpty(genUnit) ? null : genUnit,
                ["shift_group"] = string.IsNullOrEmpty(genGroup) ? null : genGroup,
                ["from_date"] = genFrom,
                ["to_date"] = genTo,
                ["overwrite_unlocked"] = genOverwrite,
            };
            var batch = await Docs.InsertAsync(Current.Required, "ScheduleGeneration", data);
            generateOpen = false;
            notice = $"Roster generated ({batch.Name}): {Num(batch, "generated_count")} schedule(s) written, " +
                     $"{Num(batch, "skipped_locked_count")} protected day(s) kept, {Num(batch, "violation_count")} rule warning(s).";
            await LoadMonthAsync();
        }
        catch (Exception ex) when (ex is InvalidPayloadException or PermissionDeniedException or DocumentNotFoundException)
        {
            generateError = ex.Message;
        }
        finally
        {
            generating = false;
        }
    }

    private static long Num(Document d, string f) => d.Data.GetValueOrDefault(f) switch
    {
        long l => l,
        decimal m => (long)m,
        int i => i,
        _ => 0,
    };

    // ---------------- Export ----------------

    private async Task ExportAsync(string format)
    {
        exporting = true;
        try
        {
            var employees = FilteredEmployeeNames.Select(id =>
            {
                var row = ScheduleByEmpDate[id];
                var first = row.Values.First();
                return new WsmRosterView.ExportEmployee(id, Str(first, "employee_name") ?? id, Str(first, "organization_unit"), Str(first, "shift_group"),
                    row.ToDictionary(kv => kv.Key, kv => (IReadOnlyDictionary<string, object?>)kv.Value.Data));
            }).ToList();
            var unitLabel = string.IsNullOrEmpty(selectedUnit) ? null : selectedUnit;
            var output = WsmRosterView.Export(format, selectedMonth, unitLabel, MonthDays, employees, CoverageRows);
            var token = Downloads.Put(Current.Required.TenantId, Current.Required.Id, output);
            await JS.InvokeVoidAsync("frogframe.downloadUrl", $"/report-downloads/{token}", output.FileName);
            notice = $"Exported the roster of {output.Rows} employee(s) to {output.FileName}.";
        }
        finally
        {
            exporting = false;
        }
    }

    private static (string Badge, string Bg, string Fg, string Tooltip) FormatCell(Document? slot)
    {
        if (slot is null) return ("-", "transparent", "inherit", "No schedule");
        var st = Str(slot, "schedule_type") ?? "WORK";
        var shift = Str(slot, "shift_type") ?? "";
        var cat = Str(slot, "day_category") ?? st;
        var src = Str(slot, "source_type") ?? "";
        var crosses = slot.Data.GetValueOrDefault("crosses_midnight") is true;
        var isPh = slot.Data.GetValueOrDefault("is_public_holiday") is true;
        var phTag = isPh ? " [PH]" : "";
        var tooltip = $"{Str(slot, "work_date")}: {st} ({cat}) {(string.IsNullOrEmpty(shift) ? "" : "· " + shift)} · Source: {src}{phTag}";

        if (st == "REST") return ("OFF" + phTag, "#f1f5f9", "#475569", tooltip);
        if (st == "LEAVE") return ("LVE", "#dcfce7", "#166534", tooltip);
        if (st == "HOLIDAY") return ("HOL", "#fce7f3", "#9d174d", tooltip);

        if (crosses || shift.Contains("Night", StringComparison.OrdinalIgnoreCase) || shift.Contains("Malam", StringComparison.OrdinalIgnoreCase))
            return ("N" + phTag, "#e0e7ff", "#3730a3", tooltip);
        if (shift.Contains("Afternoon", StringComparison.OrdinalIgnoreCase) || shift.Contains("Siang", StringComparison.OrdinalIgnoreCase) || shift.Contains("Sore", StringComparison.OrdinalIgnoreCase))
            return ("A" + phTag, "#fef3c7", "#92400e", tooltip);
        if (shift.Contains("Morning", StringComparison.OrdinalIgnoreCase) || shift.Contains("Pagi", StringComparison.OrdinalIgnoreCase))
            return ("M" + phTag, "#dbeafe", "#1e40af", tooltip);
        return ("W" + phTag, "#dbeafe", "#1e40af", tooltip);
    }
}

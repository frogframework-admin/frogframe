@page "/hr/struktur-organisasi"
@inject DocumentService Docs
@inject CurrentUser Current

<PageTitle>Organizational Structure · FrogFrame</PageTitle>

<header class="page-head">
    <div>
        <h1>Organizational Structure</h1>
        <p>Built from Organization Unit (parent unit, head) and Employee (reports to) data. Click a node to view details.</p>
    </div>
</header>

@if (error is not null)
{
    <BbAlert Variant="AlertVariant.Danger"><BbAlertDescription>@error</BbAlertDescription></BbAlert>
}
else if (employees is null || orgUnits is null)
{
    <div class="stack"><BbSkeleton Height="3rem" /><BbSkeleton Height="16rem" /></div>
}
else
{
    <div class="org-stats">
        <div><strong>@orgUnits.Count</strong><span class="muted small">organization units</span></div>
        <div><strong>@ActiveEmployees.Count</strong><span class="muted small">active employees</span></div>
        <div><strong>@WithoutManager.Count</strong><span class="muted small">without supervisor</span></div>
    </div>

    <BbTabs Value="@view" ValueChanged="v => view = v ?? view">
        <BbTabsList>
            <BbTabsTrigger Value="dept"><LucideIcon Name="building" Size="15" /> By organization unit</BbTabsTrigger>
            <BbTabsTrigger Value="people"><LucideIcon Name="users-round" Size="15" /> Manager – subordinates</BbTabsTrigger>
        </BbTabsList>
        <BbTabsContent Value="dept">
            <BbCard Style="margin-top:.75rem"><BbCardContent><div style="padding-top:1rem">
                <OrgTree Nodes="DeptNodes" AriaLabel="Organization unit chart" EmptyTitle="No organization units found" EmptyText="Add data in HR → Organization Unit." />
            </div></BbCardContent></BbCard>
        </BbTabsContent>
        <BbTabsContent Value="people">
            <BbCard Style="margin-top:.75rem"><BbCardContent><div style="padding-top:1rem">
                <OrgTree Nodes="PeopleNodes" AriaLabel="Organization chart" EmptyTitle="No employees found" EmptyText="Add data in HR → Employee." />
            </div></BbCardContent></BbCard>
            @if (WithoutManager.Count > 1)
            {
                <p class="muted small" style="margin-top:.5rem">Employees without a manager appear at the root: @string.Join(", ", WithoutManager.Select(e => Str(e, "employee_name")))</p>
            }
        </BbTabsContent>
    </BbTabs>
}

@code {
    private IReadOnlyList<Document>? orgUnits, employees;
    private string view = "dept";
    private string? error;
    private IReadOnlyList<OrgNode> DeptNodes = [], PeopleNodes = [];

    private List<Document> ActiveEmployees => employees!.Where(e => string.Equals(e.Data.GetValueOrDefault("status") as string, "Active", StringComparison.OrdinalIgnoreCase)).ToList();
    private List<Document> WithoutManager => ActiveEmployees.Where(e => e.Data.GetValueOrDefault("reports_to") is not string boss
        || ActiveEmployees.All(x => x.Name != boss)).ToList();

    private static string? Str(Document d, string f) => d.Data.GetValueOrDefault(f) as string;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Lewat DocumentService: tenant, cakupan data, dan field terbatas tetap berlaku.
            orgUnits = await Docs.QueryForReportAsync(Current.Required, "OrganizationUnit", [], DocActions.Read);
            employees = await Docs.QueryForReportAsync(Current.Required, "Employee", [], DocActions.Read);
        }
        catch (PermissionDeniedException ex) { error = ex.Message; return; }

        var byId = employees.ToDictionary(e => e.Name);
        var me = Current.Required.Attr("employee");
        DeptNodes = orgUnits.Select(d =>
        {
            var head = Str(d, "manager") is { } h && byId.TryGetValue(h, out var e) ? e : null;
            var count = ActiveEmployees.Count(x => Str(x, "organization_unit") == d.Name);
            return new OrgNode(d.Name, Str(d, "parent_org_unit"), Str(d, "org_unit_name") ?? d.Name,
                head is null ? "Head not assigned" : $"{Str(head, "employee_name")} · {Str(head, "designation")}",
                $"{d.Name} · {count} employees", head is null ? null : Str(head, "foto"), $"/app/OrganizationUnit/{d.Name}",
                Highlight: me is not null && byId.TryGetValue(me, out var self) && Str(self, "organization_unit") == d.Name);
        }).ToList();

        var unitName = orgUnits.ToDictionary(d => d.Name, d => Str(d, "org_unit_name") ?? d.Name);
        PeopleNodes = ActiveEmployees.Select(e => new OrgNode(e.Name, Str(e, "reports_to"), Str(e, "employee_name") ?? e.Name,
            Str(e, "designation"), Str(e, "organization_unit") is { } dc ? unitName.GetValueOrDefault(dc, dc) : null,
            Str(e, "foto"), $"/app/Employee/{e.Name}", Highlight: e.Name == me)).ToList();
    }
}

<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <RootNamespace>Framework.Web</RootNamespace>
    <BlazorBlueprintVersion>4.1.0</BlazorBlueprintVersion>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\Framework.Core\Framework.Core.csproj" />
    <ProjectReference Include="..\Framework.Scripting\Framework.Scripting.csproj" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <!-- Monaco editor files for the Server Script editor (served from _content/BlazorMonaco, loaded lazily by
         wwwroot/script-editor.js). Only the static files are used, not the BlazorMonaco components. -->
    <PackageReference Include="BlazorMonaco" Version="3.5.0" />
  </ItemGroup>

  <!-- Default: paket NuGet resmi (membawa BlazorBlueprint.Primitives dan Icons.Lucide secara transitif). -->
  <ItemGroup Condition="'$(BlazorBlueprintSource)' == ''">
    <PackageReference Include="BlazorBlueprint.Components" Version="$(BlazorBlueprintVersion)" />
  </ItemGroup>

  <!-- Opsional: build dari source BlazorBlueprint, mis. -p:BlazorBlueprintSource=/path/ke/ui/src -->
  <ItemGroup Condition="'$(BlazorBlueprintSource)' != ''">
    <ProjectReference Include="$(BlazorBlueprintSource)/BlazorBlueprint.Components/BlazorBlueprint.Components.csproj" />
  </ItemGroup>

</Project>

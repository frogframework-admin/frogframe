@* Standalone HTML document for PDF: styles inlined directly without external resources. *@
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@Model.DocName</title>
    <style>@((MarkupString)PrintStyles.Css)</style>
    <style>html, body { margin: 0; background: #fff; }</style>
</head>
<body>
    <PrintDocument Model="Model" />
</body>
</html>

@code {
    [Parameter, EditorRequired] public PrintModel Model { get; set; } = default!;
}

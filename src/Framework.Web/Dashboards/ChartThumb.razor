@* Chart type thumbnail for selection in widget builder. *@
@using Framework.Dashboards
<svg viewBox="0 0 64 44" class="chart-thumb" aria-hidden="true">
    @switch (Type)
    {
        case ChartTypes.Bar:
            <rect x="8" y="22" width="9" height="16" rx="1.5" class="t1" /><rect x="21" y="12" width="9" height="26" rx="1.5" class="t2" />
            <rect x="34" y="18" width="9" height="20" rx="1.5" class="t1" /><rect x="47" y="6" width="9" height="32" rx="1.5" class="t2" />
            <line x1="4" y1="38.5" x2="60" y2="38.5" class="ax" />
            break;
        case ChartTypes.Line:
            <polyline points="6,32 18,22 30,26 42,12 58,16" class="ln" /><line x1="4" y1="38.5" x2="60" y2="38.5" class="ax" />
            <circle cx="18" cy="22" r="2.2" class="t2" /><circle cx="42" cy="12" r="2.2" class="t2" />
            break;
        case ChartTypes.Pie:
            <circle cx="32" cy="22" r="17" class="t1" /><path d="M32 22 L32 5 A17 17 0 0 1 48.2 27 Z" class="t2" /><path d="M32 22 L48.2 27 A17 17 0 0 1 24 37 Z" class="t3" />
            break;
        case ChartTypes.Doughnut:
            <circle cx="32" cy="22" r="17" class="t1" /><path d="M32 22 L32 5 A17 17 0 0 1 48.2 27 Z" class="t2" /><circle cx="32" cy="22" r="9" class="hole" />
            break;
        case ChartTypes.Number:
            <g><text x="32" y="27" text-anchor="middle" class="num">128</text></g><line x1="18" y1="34" x2="46" y2="34" class="ax" />
            break;
        case ChartTypes.Area:
            <polygon points="6,36 18,20 32,28 46,14 58,22 58,38 6,38" class="t1" style="opacity:0.4" />
            <polyline points="6,36 18,20 32,28 46,14 58,22" class="ln" />
            <line x1="4" y1="38.5" x2="60" y2="38.5" class="ax" />
            break;
        case ChartTypes.Composed:
            <rect x="10" y="20" width="8" height="18" rx="1.5" class="t1" /><rect x="26" y="14" width="8" height="24" rx="1.5" class="t1" /><rect x="42" y="8" width="8" height="30" rx="1.5" class="t1" />
            <polyline points="14,24 30,12 46,18" class="ln" style="stroke:var(--chart-2)" />
            <line x1="4" y1="38.5" x2="60" y2="38.5" class="ax" />
            break;
        case ChartTypes.Scatter:
            <circle cx="14" cy="28" r="2.8" class="t1" /><circle cx="22" cy="16" r="3.2" class="t2" /><circle cx="34" cy="24" r="2.5" class="t1" /><circle cx="44" cy="12" r="3.5" class="t2" /><circle cx="52" cy="22" r="2.8" class="t1" />
            <line x1="4" y1="38.5" x2="60" y2="38.5" class="ax" /><line x1="6" y1="4" x2="6" y2="38.5" class="ax" />
            break;
        case ChartTypes.Radar:
            <polygon points="32,8 52,18 44,36 20,36 12,18" class="gl" style="fill:none;stroke-width:1" />
            <polygon points="32,14 46,20 40,32 24,30 18,20" class="t2" style="opacity:0.6" />
            break;
        case ChartTypes.RadialBar:
            <path d="M18 22 A14 14 0 1 1 46 22" fill="none" stroke="var(--chart-1)" stroke-width="4" stroke-linecap="round" />
            <path d="M24 22 A8 8 0 1 1 40 22" fill="none" stroke="var(--chart-2)" stroke-width="4" stroke-linecap="round" />
            break;
        case ChartTypes.Rose:
            <circle cx="32" cy="22" r="6" class="hole" />
            <path d="M32 22 L32 8 A14 14 0 0 1 44 26 Z" class="t1" />
            <path d="M32 22 L44 26 A10 10 0 0 1 28 32 Z" class="t2" />
            <path d="M32 22 L28 32 A16 16 0 0 1 20 18 Z" class="t3" />
            break;
        case ChartTypes.Funnel:
            <polygon points="12,8 52,8 44,17 20,17" class="t1" />
            <polygon points="21,19 43,19 38,27 26,27" class="t2" />
            <polygon points="27,29 37,29 34,36 30,36" class="t3" />
            break;
        case ChartTypes.Gauge:
            <path d="M14 32 A20 20 0 1 1 50 32" fill="none" stroke="var(--muted)" stroke-width="4" stroke-linecap="round" />
            <path d="M14 32 A20 20 0 0 1 36 13" fill="none" stroke="var(--chart-1)" stroke-width="4" stroke-linecap="round" />
            <line x1="32" y1="28" x2="38" y2="16" stroke="var(--foreground)" stroke-width="2" stroke-linecap="round" />
            <circle cx="32" cy="28" r="2" class="t2" />
            break;
        case ChartTypes.Heatmap:
            <rect x="10" y="10" width="12" height="12" class="t1" rx="1" style="opacity:0.3" /><rect x="26" y="10" width="12" height="12" class="t1" rx="1" style="opacity:0.7" /><rect x="42" y="10" width="12" height="12" class="t1" rx="1" style="opacity:1" />
            <rect x="10" y="24" width="12" height="12" class="t1" rx="1" style="opacity:0.9" /><rect x="26" y="24" width="12" height="12" class="t1" rx="1" style="opacity:0.4" /><rect x="42" y="24" width="12" height="12" class="t1" rx="1" style="opacity:0.2" />
            break;
        case ChartTypes.Candlestick:
            <line x1="18" y1="8" x2="18" y2="34" class="gl" /><rect x="15" y="14" width="6" height="14" fill="#22c55e" rx="1" />
            <line x1="34" y1="12" x2="34" y2="36" class="gl" /><rect x="31" y="16" width="6" height="12" fill="#ef4444" rx="1" />
            <line x1="50" y1="6" x2="50" y2="32" class="gl" /><rect x="47" y="10" width="6" height="16" fill="#22c55e" rx="1" />
            <line x1="4" y1="38.5" x2="60" y2="38.5" class="ax" />
            break;
        case ChartTypes.Sankey:
            <rect x="8" y="10" width="6" height="24" class="t1" rx="1" />
            <rect x="50" y="6" width="6" height="14" class="t2" rx="1" />
            <rect x="50" y="24" width="6" height="14" class="t3" rx="1" />
            <path d="M14 14 C32 14, 32 10, 50 10 L50 18 C32 18, 32 22, 14 22 Z" class="t1" style="opacity:0.4" />
            <path d="M14 24 C32 24, 32 28, 50 28 L50 36 C32 36, 32 32, 14 32 Z" class="t1" style="opacity:0.4" />
            break;
        case ChartTypes.Map:
            <circle cx="32" cy="22" r="16" class="gl" style="fill:none;stroke-width:1" />
            <ellipse cx="32" cy="22" rx="8" ry="16" class="gl" style="fill:none;stroke-width:1" />
            <line x1="16" y1="22" x2="48" y2="22" class="gl" style="stroke-width:1" />
            <circle cx="28" cy="18" r="2" class="t1" /><circle cx="36" cy="25" r="2.5" class="t2" />
            break;
        default:
            <rect x="6" y="6" width="52" height="32" rx="2" class="grid-bg" />
            <line x1="6" y1="14" x2="58" y2="14" class="ax" /><line x1="6" y1="22" x2="58" y2="22" class="gl" /><line x1="6" y1="30" x2="58" y2="30" class="gl" />
            <line x1="24" y1="6" x2="24" y2="38" class="gl" /><line x1="42" y1="6" x2="42" y2="38" class="gl" />
            break;
    }
</svg>
@code { [Parameter] public string Type { get; set; } = ChartTypes.Bar; }

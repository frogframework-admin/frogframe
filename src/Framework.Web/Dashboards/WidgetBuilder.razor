@page "/admin/widgets/new"
@page "/admin/widgets/{WidgetId}"
@page "/dashboard/widgets/new"
@page "/dashboard/widgets/{WidgetId}"
@using Framework.Dashboards
@inject DashboardService Dashboards
@inject RoleCatalog RoleCatalogSvc
@inject IMetadataProvider Metadata
@inject CurrentUser Current
@inject ToastService Toasts
@inject NavigationManager Nav

<PageTitle>@(isEdit ? "Edit widget" : "New widget") · DocFrame</PageTitle>

<BbBreadcrumb Class="crumbs">
    <BbBreadcrumbList>
        <BbBreadcrumbItem><BbBreadcrumbLink Href="/admin/widgets">Widgets</BbBreadcrumbLink></BbBreadcrumbItem>
        <BbBreadcrumbSeparator />
        <BbBreadcrumbItem><BbBreadcrumbPage>@(isEdit ? widget.Name : "New")</BbBreadcrumbPage></BbBreadcrumbItem>
    </BbBreadcrumbList>
</BbBreadcrumb>

@if (!DashboardService.CanDesign(Current.Required))
{
    <ErrorState StatusCode="403" Description="Designing widgets is only available to System Managers." BackHref="/admin/widgets" BackLabel="Back to Widgets" />
}
else if (!Dashboards.IsAvailable)
{
    <UnavailableNotice />
}
else if (notFound)
{
    <ErrorState StatusCode="404" Title="Widget Not Found" Description="The requested dashboard widget was not found." BackHref="/admin/widgets" BackLabel="Back to Widgets" />
}
else
{
    <header class="page-head">
        <div>
            <h1>@(isEdit ? $"Edit widget: {widget.Name}" : "New widget")</h1>
            <p>SQL query against reporting views (read-only, tenant-isolated) → parameters → visual → pin to dashboard.</p>
        </div>
    </header>

    <ol class="wizard-steps" aria-label="Steps">
        @foreach (var (n, title) in Steps)
        {
            var num = n;
            <li class="@(step == num ? "current" : num < step ? "done" : "")">
                <button type="button" disabled="@(num > maxStep)" @onclick="() => GoTo(num)" aria-current="@(step == num ? "step" : null)">
                    <span class="step-num">@(num < step ? "✓" : num.ToString())</span><span>@title</span>
                </button>
            </li>
        }
    </ol>

    @if (error is not null)
    {
        <BbAlert Variant="AlertVariant.Danger" Class="props-block"><BbAlertTitle>@errorTitle</BbAlertTitle><BbAlertDescription><span class="pre">@error</span></BbAlertDescription></BbAlert>
    }

    @switch (step)
    {
        case 1:
            <div class="builder-grid builder-grid-equal">
                <BbCard Class="builder-card-left">
                    <BbCardHeader>
                        <BbCardTitle Class="card-title">1. Data source &amp; query</BbCardTitle>
                        <BbCardDescription>Single SELECT statement (or WITH … SELECT). Write parameters as <code>@@ParamName</code>. Optional filter: <code>(@@Dept IS NULL OR department = @@Dept)</code>.</BbCardDescription>
                    </BbCardHeader>
                    <BbCardContent Class="builder-card-content">
                        <div class="stack" style="flex:1;display:flex;flex-direction:column;min-height:0;height:100%">
                            <FormTextArea Id="sql" Value="@widget.Config.Sql" ValueChanged="v => widget.Config.Sql = v ?? string.Empty" Rows="12" AriaLabel="SQL Query" />
                        </div>
                    </BbCardContent>
                    <BbCardFooter Class="builder-card-footer">
                        <BbButton OnClick="Detect"><LucideIcon Name="scan-search" Size="16" /> Next: detect parameters</BbButton>
                        <span class="muted small">@widget.Config.Sql.Length / @SqlGuard.MaxLength characters</span>
                    </BbCardFooter>
                </BbCard>
                <BbCard Class="builder-card-right">
                    <BbCardHeader>
                        <BbCardTitle Class="card-title">Available views</BbCardTitle>
                        <BbCardDescription>Click a view or column name to append it to the query.</BbCardDescription>
                    </BbCardHeader>
                    <BbCardContent Class="builder-card-content">
                        <div class="catalog-search" style="margin-bottom:.65rem;flex-shrink:0">
                            <BbInputGroup>
                                <BbInputGroupAddon Align="InputGroupAlign.InlineStart">
                                    <LucideIcon Name="search" Size="15" />
                                </BbInputGroupAddon>
                                <BbInputGroupInput Value="@viewSearch" ValueChanged="v => viewSearch = v"
                                                   UpdateTiming="UpdateTiming.Debounced" DebounceInterval="150"
                                                   Placeholder="Search views or columns…" AriaLabel="Search views" />
                                @if (!string.IsNullOrWhiteSpace(viewSearch))
                                {
                                    <BbInputGroupAddon Align="InputGroupAlign.InlineEnd">
                                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="search-clear-btn"
                                                  OnClick="() => viewSearch = null" AriaLabel="Clear search">
                                            <LucideIcon Name="x" Size="13" />
                                        </BbButton>
                                    </BbInputGroupAddon>
                                }
                            </BbInputGroup>
                        </div>
                        <div class="catalog">
                            @foreach (var v in FilteredViews)
                            {
                                var view = v;
                                var isOpen = !string.IsNullOrWhiteSpace(viewSearch);
                                <details open="@(isOpen ? true : null)">
                                    <summary><button type="button" class="catalog-insert" @onclick="() => Insert(view.Name)" @onclick:stopPropagation="true"><code>@view.Name</code></button><span class="muted small">@view.Title</span></summary>
                                    <ul>
                                        @foreach (var (col, type) in view.Columns)
                                        {
                                            var c = col;
                                            <li><button type="button" class="catalog-insert" @onclick="() => Insert(c)"><code>@c</code></button><span class="muted small">@type</span></li>
                                        }
                                    </ul>
                                </details>
                            }
                            @if (!FilteredViews.Any())
                            {
                                <p class="muted small" style="padding:1rem 0;text-align:center">No views or columns match "@viewSearch".</p>
                            }
                        </div>
                    </BbCardContent>
                </BbCard>
            </div>
            break;

        case 2:
            <BbCard>
                <BbCardHeader>
                    <BbCardTitle Class="card-title">2. Parameters &amp; data preview</BbCardTitle>
                    <BbCardDescription>@(widget.Config.Parameters.Count == 0 ? "This query does not use parameters." : "Define type and test value for each parameter. \"Bound to\" specifies the value source when displayed on the dashboard.")</BbCardDescription>
                </BbCardHeader>
                <BbCardContent>
                    @if (widget.Config.Parameters.Count > 0)
                    {
                        <div class="table-wrap">
                            <table class="perm-table">
                                <thead><tr><th>Parameter</th><th>Label</th><th>Type</th><th>Test / default value</th><th>Bound to (dashboard)</th></tr></thead>
                                <tbody>
                                    @foreach (var prm in widget.Config.Parameters)
                                    {
                                        var p = prm;
                                        <tr>
                                            <td><code>@@@p.Name</code></td>
                                            <td style="min-width:9rem"><FormTextInput Value="@p.Label" ValueChanged="v => p.Label = v ?? p.Name" AriaLabel="@($"Label {p.Name}")" /></td>
                                            <td style="min-width:8rem"><BbSelect TValue="string" Value="@p.Type" ValueChanged="v => SetType(p, v)" Options="TypeOptions" AriaLabel="@($"Type {p.Name}")" /></td>
                                            <td style="min-width:11rem">
                                                @if (p.Type == ParamTypes.Boolean)
                                                {
                                                    <BbSelect TValue="string" Value="@(p.DefaultValue ?? "")" ValueChanged="v => p.DefaultValue = string.IsNullOrEmpty(v) ? null : v" Options="BoolOptions" AriaLabel="@($"Value {p.Name}")" />
                                                }
                                                else
                                                {
                                                    <FormTextInput Id="@($"pv-{p.Name}")" Type="@(p.Type == ParamTypes.Date ? "date" : p.Type == ParamTypes.Number ? "number" : "text")" Value="@p.DefaultValue"
                                                                   ValueChanged="v => p.DefaultValue = string.IsNullOrWhiteSpace(v) ? null : v" AriaLabel="@($"Value {p.Name}")" />
                                                }
                                            </td>
                                            <td style="min-width:13rem"><BbSelect TValue="string" Value="@p.Binding" ValueChanged="v => p.Binding = v ?? ParamBindings.Default" Options="BindingOptions(p)" AriaLabel="@($"Binding {p.Name}")" /></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <p class="muted small">Empty values are sent as NULL. Parameter values are sent safely as database parameters and never concatenated directly into SQL text.</p>
                    }
                    <div class="row" style="margin:.75rem 0">
                        <BbButton Disabled="busy" OnClick="RunPreview"><LucideIcon Name="play" Size="16" /> @(busy ? "Running…" : "Run preview")</BbButton>
                        <BbButton Variant="ButtonVariant.Ghost" OnClick="() => GoTo(1)">Back to query</BbButton>
                        <span class="spacer"></span>
                        <BbButton Disabled="@(preview is null)" OnClick="() => GoTo(3)">Next: visual <LucideIcon Name="arrow-right" Size="16" /></BbButton>
                    </div>
                    @if (preview is not null) { <ResultGrid Result="preview" ShowFooter="true" /> }
                </BbCardContent>
            </BbCard>
            break;

        case 3:
            <div class="builder-grid builder-grid-equal">
                <BbCard Class="builder-card-left">
                    <BbCardHeader>
                        <BbCardTitle Class="card-title">3. Chart type &amp; column mapping</BbCardTitle>
                        <BbCardDescription>X Axis = category/label (text or date). Y Axis = value, must be a numeric column.</BbCardDescription>
                    </BbCardHeader>
                    <BbCardContent Class="builder-card-content" Style="overflow-y:auto;scrollbar-width:thin">
                        <div class="chart-types" role="radiogroup" aria-label="Chart type">
                            @foreach (var t in ChartTypes.All)
                            {
                                var type = t;
                                <button type="button" role="radio" aria-checked="@(widget.Config.Visual.Type == type)" class="chart-type @(widget.Config.Visual.Type == type ? "selected" : "")" @onclick="() => SetChart(type)">
                                    <ChartThumb Type="@type" /><span>@ChartLabel(type)</span>
                                </button>
                            }
                        </div>
                        @if (Visual.Type is not (ChartTypes.Table or ChartTypes.Number))
                        {
                            <BbField Style="margin-top:1rem">
                                <BbFieldLabel>X Axis (category)</BbFieldLabel>
                                <BbSelect TValue="string" Value="@Visual.XColumn" ValueChanged="v => Visual.XColumn = v" AriaLabel="X Axis"
                                          Options="@(preview!.Columns.Select(c => new SelectOption<string>(c.Name, $"{c.Name} ({KindLabel(c.Kind)})")))" />
                            </BbField>
                        }
                        @if (Visual.Type != ChartTypes.Table)
                        {
                            <div style="margin-top:1rem">
                                <div class="props-sub" style="margin-bottom:.4rem">Y Axis (value)@(Visual.Type is ChartTypes.Bar or ChartTypes.Line ? " — multiple allowed" : " — single column")</div>
                                <div class="wf-roles">
                                    @foreach (var col in preview!.Columns)
                                    {
                                        var c = col;
                                        <div class="label-row" title="@(c.Kind != "number" ? "Not a numeric column" : null)">
                                            <BbCheckbox Id="@($"y-{c.Name}")" Checked="Visual.YColumns.Contains(c.Name)" Disabled="@(c.Kind != "number")" CheckedChanged="v => ToggleY(c.Name, v)" />
                                            <BbLabel For="@($"y-{c.Name}")">@c.Name</BbLabel>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                        @if (VisualErrors.Count > 0)
                        {
                            <BbAlert Variant="AlertVariant.Warning" Style="margin-top:1rem"><BbAlertDescription><ul class="error-list">@foreach (var e in VisualErrors) { <li>@e</li> }</ul></BbAlertDescription></BbAlert>
                        }
                    </BbCardContent>
                    <BbCardFooter Class="builder-card-footer">
                        <BbButton Variant="ButtonVariant.Ghost" OnClick="() => GoTo(2)">Back</BbButton>
                        <span class="spacer"></span>
                        <BbButton Disabled="@(VisualErrors.Count > 0)" OnClick="() => GoTo(4)">Next: save <LucideIcon Name="arrow-right" Size="16" /></BbButton>
                    </BbCardFooter>
                </BbCard>
                <BbCard Class="builder-card-right">
                    <BbCardHeader><BbCardTitle Class="card-title">Preview</BbCardTitle><BbCardDescription>Using data from step 2.</BbCardDescription></BbCardHeader>
                    <BbCardContent Class="builder-card-content" Style="overflow-y:auto;scrollbar-width:thin">
                        @if (VisualErrors.Count == 0)
                        {
                            <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:100%;padding:1rem 0">
                                <ChartView Result="preview" Visual="Visual" Width="440" />
                            </div>
                        }
                        else
                        {
                            <div class="chart-empty" style="flex:1"><span>Complete column mapping to view preview</span></div>
                        }
                    </BbCardContent>
                </BbCard>
            </div>
            break;

        case 4:
            <div class="builder-grid builder-grid-equal">
                <BbCard Class="builder-card-left">
                    <BbCardHeader><BbCardTitle Class="card-title">4. Save &amp; publish</BbCardTitle></BbCardHeader>
                    <BbCardContent Class="builder-card-content" Style="overflow-y:auto;scrollbar-width:thin">
                        <div class="stack" style="padding-bottom:.5rem">
                            <BbField><BbFieldLabel For="w-name">Widget name</BbFieldLabel><FormTextInput Id="w-name" Value="@widget.Name" ValueChanged="v => widget.Name = v ?? string.Empty" /></BbField>
                            <BbField><BbFieldLabel For="w-desc">Description</BbFieldLabel><FormTextArea Id="w-desc" Value="@widget.Description" ValueChanged="v => widget.Description = string.IsNullOrWhiteSpace(v) ? null : v" Rows="2" /></BbField>
                            <div>
                                <div class="props-sub" style="margin-bottom:.4rem">Viewable by (empty = all users)</div>
                                <div class="wf-roles">
                                    @foreach (var role in MetadataRoles.Known(Metadata.Current, widget.Config.Roles, RoleCatalogSvc.Names(Current.Required.TenantId)))
                                    {
                                        var r = role;
                                        <div class="label-row"><BbCheckbox Id="@($"r-{r}")" Checked="widget.Config.Roles.Contains(r)" CheckedChanged="v => ToggleRole(r, v)" /><BbLabel For="@($"r-{r}")">@r</BbLabel></div>
                                    }
                                </div>
                                <p class="muted small" style="margin-top:.4rem">Widgets display tenant-wide data ("own records" restriction does not apply in SQL). Restrict roles for sensitive data.</p>
                            </div>
                            @if (!isEdit)
                            {
                                <div class="label-row"><BbCheckbox Id="w-pin" @bind-Checked="pin" /><BbLabel For="w-pin">Pin to main dashboard</BbLabel></div>
                            }
                            <Framework.Web.QueryApis.PublishAsApiOption Option="apiOption" DefaultName="@widget.Name" />
                        </div>
                    </BbCardContent>
                    <BbCardFooter Class="builder-card-footer">
                        <BbButton Variant="ButtonVariant.Ghost" OnClick="() => GoTo(3)">Back</BbButton>
                        <span class="spacer"></span>
                        <BbButton Disabled="@(busy || string.IsNullOrWhiteSpace(widget.Name))" OnClick="Save"><LucideIcon Name="save" Size="16" /> @(busy ? "Saving…" : "Save widget")</BbButton>
                    </BbCardFooter>
                </BbCard>
                <BbCard Class="builder-card-right">
                    <BbCardHeader><BbCardTitle Class="card-title">@(string.IsNullOrWhiteSpace(widget.Name) ? "Preview" : widget.Name)</BbCardTitle>@if (widget.Description is not null) { <BbCardDescription>@widget.Description</BbCardDescription> }</BbCardHeader>
                    <BbCardContent Class="builder-card-content" Style="overflow-y:auto;scrollbar-width:thin">
                        <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:100%;padding:1rem 0">
                            <ChartView Result="preview" Visual="Visual" Width="440" />
                        </div>
                    </BbCardContent>
                </BbCard>
            </div>
            break;
    }
}

@code {
    [Parameter] public string? WidgetId { get; set; }

    private static readonly (int, string)[] Steps = [(1, "Query"), (2, "Parameters & preview"), (3, "Visual"), (4, "Save")];
    private WidgetDef widget = new();
    private readonly Framework.Web.QueryApis.ApiPublishOption apiOption = new();
    [Inject] private Framework.Api.QueryApiService QueryApis { get; set; } = default!;
    private VisualConfig Visual => widget.Config.Visual;
    private int step = 1, maxStep = 1;
    private bool isEdit, notFound, busy, pin = true;
    private string? error, errorTitle, viewSearch;
    private QueryResultSet? preview;
    private string? loadedKey;

    private IEnumerable<ReportingView> FilteredViews
    {
        get
        {
            var all = ReportingCatalog.Describe(Metadata.Current);
            if (string.IsNullOrWhiteSpace(viewSearch))
                return all;

            var q = viewSearch.Trim();
            return all.Where(v =>
                v.Name.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                v.Title.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                v.Columns.Any(c => c.Column.Contains(q, StringComparison.OrdinalIgnoreCase) || c.Type.Contains(q, StringComparison.OrdinalIgnoreCase)));
        }
    }

    private static readonly IEnumerable<SelectOption<string>> TypeOptions =
        [new(ParamTypes.Text, "Text"), new(ParamTypes.Number, "Number"), new(ParamTypes.Date, "Date"), new(ParamTypes.Boolean, "Boolean")];
    private static readonly IEnumerable<SelectOption<string>> BoolOptions = [new("", "(empty)"), new("true", "Yes (true)"), new("false", "No (false)")];

    private static IEnumerable<SelectOption<string>> BindingOptions(WidgetParameter p)
    {
        yield return new(ParamBindings.Default, "Default value (fixed)");
        if (p.Type == ParamTypes.Date) { yield return new(ParamBindings.GlobalStart, "Dashboard filter: start date"); yield return new(ParamBindings.GlobalEnd, "Dashboard filter: end date"); }
        if (p.Type == ParamTypes.Text)
        {
            yield return new(ParamBindings.GlobalDepartment, "Dashboard filter: department");
            yield return new(ParamBindings.UserDepartment, "Viewer's department");
            yield return new(ParamBindings.UserId, "Viewer's user ID");
        }
    }

    private IReadOnlyList<string> VisualErrors => preview is null ? ["Run preview first"] : DashboardService.ValidateVisual(Visual, preview.Columns);

    protected override async Task OnParametersSetAsync()
    {
        if (WidgetId == loadedKey && loadedKey is not null) return;
        loadedKey = WidgetId ?? "";
        if (WidgetId is null) return;
        var w = await Dashboards.GetAsync(Current.Required, WidgetId);
        if (w is null) { notFound = true; return; }
        widget = w; isEdit = true; maxStep = 2;
        await apiOption.LoadAsync(QueryApis, Current.Required, $"widget:{w.Id}");
    }

    private void GoTo(int n) { if (n <= maxStep) { step = n; error = null; } }

    private void Insert(string text)
    {
        var sql = widget.Config.Sql.TrimEnd();
        widget.Config.Sql = sql + (sql.Length == 0 ? "" : " ") + text;
    }

    private void Detect()
    {
        error = null;
        var (analysis, parameters) = DashboardService.DetectParameters(widget.Config.Sql, widget.Config.Parameters);
        if (!analysis.Ok) { (errorTitle, error) = ("Query cannot be used yet", analysis.Error); return; }
        widget.Config.Parameters = parameters;
        preview = null;
        step = maxStep = 2;
    }

    private void SetType(WidgetParameter p, string? type)
    {
        p.Type = type ?? ParamTypes.Text;
        p.DefaultValue = null;
        if (!BindingOptions(p).Any(o => o.Value == p.Binding)) p.Binding = ParamBindings.Default;
    }

    private async Task RunPreview()
    {
        error = null; busy = true;
        try
        {
            preview = await Dashboards.PreviewAsync(Current.Required, widget.Config.Sql, widget.Config.Parameters);
            maxStep = Math.Max(maxStep, 4);
            AutoMap();
        }
        catch (Exception ex) when (ex is QueryRejectedException or ReportingUnavailableException)
        {
            preview = null; maxStep = 2;
            (errorTitle, error) = ("Query execution failed", ex.Message);
        }
        finally { busy = false; }
    }

    /// <summary>Initial automatic mapping: X = first text/date column, Y = first number column.</summary>
    private void AutoMap()
    {
        var cols = preview!.Columns;
        if (Visual.XColumn is null || cols.All(c => c.Name != Visual.XColumn))
            Visual.XColumn = cols.FirstOrDefault(c => c.Kind is "text" or "date")?.Name ?? cols.FirstOrDefault()?.Name;
        Visual.YColumns.RemoveAll(y => cols.All(c => c.Name != y || c.Kind != "number"));
        if (Visual.YColumns.Count == 0 && cols.FirstOrDefault(c => c.Kind == "number" && c.Name != Visual.XColumn) is { } y) Visual.YColumns.Add(y.Name);
        if (preview.Rows.Count == 1 && cols.Count(c => c.Kind == "number") == 1 && cols.Count == 1 && Visual.Type == ChartTypes.Bar) Visual.Type = ChartTypes.Number;
    }

    private void SetChart(string type)
    {
        Visual.Type = type;
        if (type is ChartTypes.Pie or ChartTypes.Doughnut or ChartTypes.Number && Visual.YColumns.Count > 1) Visual.YColumns = [Visual.YColumns[0]];
    }

    private void ToggleY(string col, bool on)
    {
        if (on)
        {
            if (Visual.Type is ChartTypes.Pie or ChartTypes.Doughnut or ChartTypes.Number) Visual.YColumns.Clear();
            if (!Visual.YColumns.Contains(col)) Visual.YColumns.Add(col);
        }
        else Visual.YColumns.Remove(col);
    }

    private void ToggleRole(string role, bool on)
    {
        if (on && !widget.Config.Roles.Contains(role)) widget.Config.Roles.Add(role);
        if (!on) widget.Config.Roles.Remove(role);
    }

    private async Task Save()
    {
        error = null; busy = true;
        try
        {
            var saved = await Dashboards.SaveAsync(Current.Required, widget, pin && !isEdit);
            // Option: same query published as API (or deleted if unchecked).
            var apiNote = await apiOption.ApplyAsync(QueryApis, Current.Required, $"widget:{saved.Id}", saved.Name, saved.Description,
                saved.Config.Sql, saved.Config.Parameters, saved.Config.Roles);
            Toasts.Success((pin && !isEdit ? "Widget pinned to dashboard." : "Widget saved.") + (apiNote is null ? "" : " " + apiNote), $"{saved.Name} v{saved.Version}");
            Nav.NavigateTo(pin || isEdit ? "/dashboard" : "/admin/widgets");
        }
        catch (Exception ex) when (ex is QueryRejectedException or ReportingUnavailableException or PermissionDeniedException or Framework.Api.ApiMethodException)
        {
            (errorTitle, error) = (ex is Framework.Api.ApiMethodException ? "Widget saved, but API could not be published" : "Widget could not be saved", ex.Message);
            isEdit = isEdit || ex is Framework.Api.ApiMethodException;
        }
        finally { busy = false; }
    }

    private static string KindLabel(string k) => k switch { "number" => "number", "date" => "date", "boolean" => "yes/no", _ => "text" };
    public static string ChartLabel(string t) => t switch
    {
        ChartTypes.Bar => "Bar", ChartTypes.Line => "Line", ChartTypes.Pie => "Pie", ChartTypes.Doughnut => "Doughnut",
        ChartTypes.Number => "Single number", _ => "Data table"
    };
}

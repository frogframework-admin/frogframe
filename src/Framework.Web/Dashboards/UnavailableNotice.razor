@* Notice when reporting SQL database connection is not configured. *@
<BbAlert Variant="AlertVariant.Info">
    <BbAlertTitle>SQL Dashboard is not enabled</BbAlertTitle>
    <BbAlertDescription>
        This feature requires PostgreSQL mode and a dedicated read-only reporting database connection
        (<code>ConnectionStrings:FrogFrameReadOnly</code>). See <code>deploy/sql/reporting-readonly-user.sql</code> and the Dashboard section of the README.
    </BbAlertDescription>
</BbAlert>

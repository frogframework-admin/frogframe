@page "/admin/widgets"
@page "/dashboard/widgets"
@using Framework.Dashboards
@inject DashboardService Dashboards
@inject CurrentUser Current
@inject ToastService Toasts
@inject DialogService Dialogs

<PageTitle>Widgets · DocFrame</PageTitle>

@if (!Current.Required.IsAdmin && !DashboardService.CanDesign(Current.Required))
{
    <ErrorState StatusCode="403" Description="This administration page is restricted to System Managers / Administrators." />
}
else if (!Dashboards.IsAvailable)
{
    <UnavailableNotice />
}
else
{
    <header class="page-head">
        <div><h1>Widgets</h1><p>All widgets in this tenant. Pin to dashboard or unpin without deleting.</p></div>
        @if (designer) { <BbButton Href="/admin/widgets/new"><LucideIcon Name="plus" Size="16" /> New widget</BbButton> }
    </header>

    <div class="table-wrap">
        <table class="data">
            <thead><tr><th>Widget</th><th>Type</th><th>Parameters</th><th>Viewable by</th><th>Modified</th><th></th></tr></thead>
            <tbody>
                @foreach (var w in widgets)
                {
                    var widget = w;
                    var pinned = layout.Items.Any(i => i.WidgetId == widget.Id);
                    <tr>
                        <td><strong>@widget.Name</strong>@if (widget.Description is not null) { <div class="muted small">@widget.Description</div> }</td>
                        <td><div class="row" style="gap:.4rem;flex-wrap:nowrap"><ChartThumb Type="@widget.Config.Visual.Type" />@WidgetBuilder.ChartLabel(widget.Config.Visual.Type)</div></td>
                        <td>@(widget.Config.Parameters.Count == 0 ? "—" : string.Join(", ", widget.Config.Parameters.Select(p => "@" + p.Name)))</td>
                        <td>@(widget.Config.Roles.Count == 0 ? "All" : string.Join(", ", widget.Config.Roles))</td>
                        <td class="muted nowrap">v@(widget.Version) · @Fmt.When(widget.UpdatedAt)</td>
                        <td class="nowrap">
                            @if (designer)
                            {
                                <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" OnClick="() => TogglePin(widget, pinned)"><LucideIcon Name="@(pinned ? "pin-off" : "pin")" Size="15" /> @(pinned ? "Unpin" : "Pin")</BbButton>
                                <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" Href="@($"/admin/widgets/{widget.Id}")"><LucideIcon Name="pencil" Size="15" /> Edit</BbButton>
                                <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" AriaLabel="@($"Delete {widget.Name}")" OnClick="() => Delete(widget)"><LucideIcon Name="trash-2" Size="15" /></BbButton>
                            }
                        </td>
                    </tr>
                }
                @if (widgets.Count == 0) { <tr><td colspan="6" class="grid-empty">No widgets yet.</td></tr> }
            </tbody>
        </table>
    </div>
}

@code {
    private IReadOnlyList<WidgetDef> widgets = [];
    private DashboardLayout layout = new();
    private bool designer;

    protected override async Task OnInitializedAsync()
    {
        designer = DashboardService.CanDesign(Current.Required);
        await Reload();
    }

    private async Task Reload()
    {
        widgets = await Dashboards.ListAsync(Current.Required);
        layout = await Dashboards.GetLayoutAsync(Current.Required);
    }

    private async Task TogglePin(WidgetDef w, bool pinned)
    {
        if (pinned) await Dashboards.UnpinAsync(Current.Required, w.Id); else await Dashboards.PinAsync(Current.Required, w.Id);
        Toasts.Success(pinned ? "Unpinned from dashboard." : "Pinned to dashboard.", w.Name);
        await Reload();
    }

    private async Task Delete(WidgetDef w)
    {
        var ok = await Dialogs.ConfirmAsync($"Delete widget {w.Name}?", "The widget will also be removed from the dashboard. This action cannot be undone.",
            new ConfirmDialogOptions { Destructive = true, ConfirmText = "Delete", CancelText = "Cancel" });
        if (!ok.Confirmed) return;
        await Dashboards.DeleteAsync(Current.Required, w.Id);
        Toasts.Success("Widget deleted.", w.Name);
        await Reload();
    }
}

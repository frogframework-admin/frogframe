@page "/admin/widgets"
@page "/dashboard/widgets"
@using Framework.Dashboards
@inject DashboardService Dashboards
@inject CurrentUser Current
@inject ToastService Toasts
@inject DialogService Dialogs
@inject Framework.Preferences.IUserPreferenceStore UserPrefs
@implements IDisposable

<PageTitle>Widgets · FrogFrame</PageTitle>

@if (!Current.Required.IsAdmin && !DashboardService.CanDesign(Current.Required))
{
    <ErrorState StatusCode="403" Description="This administration page is restricted to System Managers / Administrators." />
}
else if (!Dashboards.IsAvailable)
{
    <UnavailableNotice />
}
else
{
    <header class="page-head">
        <div><h1>Widgets</h1><p>Reusable SQL widgets created by administrators. Users and admins can add these widgets to their dashboards.</p></div>
        @if (designer)
        {
            <div class="row" style="gap:.5rem;flex-wrap:wrap">
                <BbButton Href="/admin/widgets/new"><LucideIcon Name="plus" Size="16" /> New widget</BbButton>
            </div>
        }
    </header>

    <BbDataGrid @key="gridMgr.RenderKey"
                TData="WidgetDef"
                Items="@widgets"
                ShowSearch="true"
                SearchPlaceholder="Search widgets..."
                ShowPagination="true"
                InitialPageSize="15"
                TableContainerClass="table-wrap"
                Resizable="true"
                OnColumnResize="gridMgr.HandleResize"
                StateChanged="gridMgr.HandleStateChanged">
        <Toolbar>
            <div style="display:flex;align-items:center;gap:.5rem;margin-left:auto">
                @if (gridMgr.HasCustomLayout)
                {
                    <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" OnClick="ResetColumnsLayout" Title="Reset column layout to default">
                        <LucideIcon Name="rotate-ccw" Size="14" />
                        <span>Reset Columns</span>
                    </BbButton>
                }
                <BbDataGridColumnVisibility TData="WidgetDef" />
            </div>
        </Toolbar>
        <Columns>
            <BbDataGridPropertyColumn TData="WidgetDef" TProp="string" Property="w => w.Name" Id="widget" Title="Widget"
                                      Width="@gridMgr.GetWidth("widget")" Visible="@gridMgr.IsVisible("widget")" Resizable="true" Sortable="true" Filterable="true">
                <CellTemplate Context="widget">
                    <div>
                        <strong>@widget.Name</strong>
                        @if (widget.Description is not null)
                        {
                            <div class="muted small">@widget.Description</div>
                        }
                    </div>
                </CellTemplate>
            </BbDataGridPropertyColumn>

            <BbDataGridTemplateColumn TData="WidgetDef" Id="type" Title="Type"
                                      Width="@gridMgr.GetWidth("type", "12rem")" Visible="@gridMgr.IsVisible("type")" Resizable="true" Sortable="true" SortBy="w => w.Config.Visual.Type">
                <ChildContent Context="widget">
                    <div class="row" style="gap:.4rem;flex-wrap:nowrap">
                        <ChartThumb Type="@widget.Config.Visual.Type" />
                        <span>@WidgetBuilder.ChartLabel(widget.Config.Visual.Type)</span>
                    </div>
                </ChildContent>
            </BbDataGridTemplateColumn>

            <BbDataGridTemplateColumn TData="WidgetDef" Id="params" Title="Parameters"
                                      Width="@gridMgr.GetWidth("params", "13rem")" Visible="@gridMgr.IsVisible("params")" Resizable="true">
                <ChildContent Context="widget">
                    @(widget.Config.Parameters.Count == 0 ? "—" : string.Join(", ", widget.Config.Parameters.Select(p => "@" + p.Name)))
                </ChildContent>
            </BbDataGridTemplateColumn>

            <BbDataGridTemplateColumn TData="WidgetDef" Id="roles" Title="Viewable by"
                                      Width="@gridMgr.GetWidth("roles", "10rem")" Visible="@gridMgr.IsVisible("roles")" Resizable="true">
                <ChildContent Context="widget">
                    @(widget.Config.Roles.Count == 0 ? "All" : string.Join(", ", widget.Config.Roles))
                </ChildContent>
            </BbDataGridTemplateColumn>

            <BbDataGridTemplateColumn TData="WidgetDef" Id="usage" Title="Used in"
                                      Width="@gridMgr.GetWidth("usage", "9rem")" Visible="@gridMgr.IsVisible("usage")" Resizable="true">
                <ChildContent Context="widget">
                    @{
                        var count = dashboards.Count(d => d.Layout.Items.Any(i => i.WidgetId == widget.Id));
                    }
                    <span class="muted nowrap">@(count == 0 ? "Unused" : $"{count} dashboard{(count == 1 ? "" : "s")}")</span>
                </ChildContent>
            </BbDataGridTemplateColumn>

            <BbDataGridTemplateColumn TData="WidgetDef" Id="modified" Title="Modified"
                                      Width="@gridMgr.GetWidth("modified", "12rem")" Visible="@gridMgr.IsVisible("modified")" Resizable="true" Sortable="true" SortBy="w => w.UpdatedAt">
                <ChildContent Context="widget">
                    <span class="muted nowrap">v@(widget.Version) · @Fmt.When(widget.UpdatedAt)</span>
                </ChildContent>
            </BbDataGridTemplateColumn>

            <BbDataGridTemplateColumn TData="WidgetDef" Id="actions" Title="Actions"
                                      Width="@gridMgr.GetWidth("actions", "8rem")" Hideable="false" Resizable="false">
                <ChildContent Context="widget">
                    @if (designer)
                    {
                        <div style="display:flex;align-items:center;gap:.35rem">
                            <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" Href="@($"/admin/widgets/{widget.Id}")">
                                <LucideIcon Name="pencil" Size="15" /> Edit
                            </BbButton>
                            <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" AriaLabel="@($"Delete {widget.Name}")" OnClick="() => Delete(widget)">
                                <LucideIcon Name="trash-2" Size="15" />
                            </BbButton>
                        </div>
                    }
                </ChildContent>
            </BbDataGridTemplateColumn>
        </Columns>
        <EmptyTemplate>
            <div style="padding:2.5rem 1rem;text-align:center">
                <BbEmpty Title="No widgets found" Description="Create reusable SQL widgets here so users and administrators can add them to dashboards." />
            </div>
        </EmptyTemplate>
    </BbDataGrid>
}

@code {
    private IReadOnlyList<WidgetDef> widgets = [];
    private IReadOnlyList<DashboardDef> dashboards = [];
    private bool designer;
    private Framework.Web.Services.DataGridPreferenceManager<WidgetDef> gridMgr = default!;

    protected override async Task OnInitializedAsync()
    {
        gridMgr = new(UserPrefs, Current, "grid:admin:widgets", StateHasChanged);
        if (Current.User is not null)
        {
            await gridMgr.InitializeAsync();
        }

        designer = DashboardService.CanDesign(Current.Required);
        await Reload();
    }

    private async Task ResetColumnsLayout()
    {
        await gridMgr.ResetAsync();
        Toasts.Success("Column layout has been reset to default.", "Reset Columns");
    }

    public void Dispose()
    {
        gridMgr?.Dispose();
    }

    private async Task Reload()
    {
        widgets = await Dashboards.ListAsync(Current.Required);
        dashboards = await Dashboards.ListDashboardsAsync(Current.Required);
    }

    private async Task Delete(WidgetDef w)
    {
        var ok = await Dialogs.ConfirmAsync($"Delete widget {w.Name}?", "The widget will also be removed from any dashboards that use it. This action cannot be undone.",
            new ConfirmDialogOptions { Destructive = true, ConfirmText = "Delete", CancelText = "Cancel" });
        if (!ok.Confirmed) return;
        await Dashboards.DeleteAsync(Current.Required, w.Id);
        Toasts.Success("Widget deleted.", w.Name);
        await Reload();
    }
}

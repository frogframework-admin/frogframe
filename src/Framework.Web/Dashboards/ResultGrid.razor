@* Data grid of query results (preview and Table widget type). *@
@using System.Globalization
@using Framework.Dashboards

<div class="result-grid" style="max-height:@MaxHeight">
    <table class="data">
        <thead><tr>@foreach (var c in Result.Columns) { <th class="@(c.Kind == "number" ? "num" : "")">@c.Name<span class="col-kind">@KindLabel(c.Kind)</span></th> }</tr></thead>
        <tbody>
            @foreach (var row in Result.Rows)
            {
                <tr>
                    @for (var i = 0; i < Result.Columns.Count; i++)
                    {
                        var v = row[i];
                        <td class="@(Result.Columns[i].Kind == "number" ? "num" : "")">@(v switch { null => "—", decimal d => d.ToString("#,0.##", CultureInfo.InvariantCulture), bool b => b ? "Yes" : "No", _ => v.ToString() })</td>
                    }
                </tr>
            }
            @if (Result.Rows.Count == 0) { <tr><td colspan="@Math.Max(Result.Columns.Count, 1)" class="grid-empty">Query executed successfully, no rows returned.</td></tr> }
        </tbody>
    </table>
</div>
@if (ShowFooter)
{
    <div class="result-footer muted small">
        @Result.Rows.Count rows · @Result.Columns.Count columns · @Result.ElapsedMs ms
        @if (Result.Truncated) { <BbBadge Variant="BadgeVariant.Warning">limited to first @Result.Rows.Count rows</BbBadge> }
    </div>
}

@code {
    [Parameter, EditorRequired] public QueryResultSet Result { get; set; } = default!;
    [Parameter] public string MaxHeight { get; set; } = "24rem";
    [Parameter] public bool ShowFooter { get; set; }
    private static string KindLabel(string k) => k switch { "number" => "number", "date" => "date", "boolean" => "yes/no", _ => "text" };
}

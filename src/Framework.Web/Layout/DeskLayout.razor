@inherits LayoutComponentBase
@implements IDisposable
@using Framework.Navigation
@inject CurrentUser Current
@inject IMetadataProvider Metadata
@inject IPermissionService Perms
@inject INotificationStore Notifications
@inject ReportService Reports
@inject NavigationManager Nav
@inject IEnumerable<DeskMenuItem> MenuItems
@inject INavigationMenuStore MenuStore
@inject ToastService Toasts
@inject IJSRuntime JS

<BbSidebarProvider DefaultOpen="true">
    <BbSidebar Collapsible="true">
        <BbSidebarHeader>
            <BbSidebarMenu>
                <BbSidebarMenuItem>
                    <BbSidebarMenuButton AsChild="SidebarMenuButtonElement.Anchor" Href="" Size="SidebarMenuButtonSize.Large">
                        <span class="brand"><span class="brand-mark" aria-hidden="true">F</span><span>FrogFrame</span></span>
                    </BbSidebarMenuButton>
                </BbSidebarMenuItem>
            </BbSidebarMenu>
        </BbSidebarHeader>

        <BbSidebarContent>
            @if (Current.User is { } u)
            {
                var visibleModules = navModules.Where(m => m.IsVisibleFor(u)).OrderBy(m => m.SortOrder).ThenBy(m => m.Name).ToList();
                var activeMod = ResolveActiveModule(visibleModules);
                var visibleMenus = navMenus.Where(m => m.IsVisibleFor(u)).ToList();

                <BbSidebarGroup>
                    <BbSidebarMenu>
                        <BbSidebarMenuItem>
                            <BbSidebarMenuButton AsChild="SidebarMenuButtonElement.Anchor" Href="" Match="NavLinkMatch.All" Tooltip="Home & Module Picker">
                                <LucideIcon Name="house" Size="18" /><span>Home</span>
                            </BbSidebarMenuButton>
                        </BbSidebarMenuItem>
                        <BbSidebarMenuItem>
                            <BbSidebarMenuButton AsChild="SidebarMenuButtonElement.Anchor" Href="inbox" Match="NavLinkMatch.Prefix" Tooltip="Inbox">
                                <LucideIcon Name="inbox" Size="18" /><span>Inbox</span>
                            </BbSidebarMenuButton>
                            @if (unread > 0)
                            {
                                <BbSidebarMenuBadge>@unread</BbSidebarMenuBadge>
                            }
                        </BbSidebarMenuItem>
                        @if (activeMod is not null)
                        {
                            <BbSidebarMenuItem>
                                <BbSidebarMenuButton OnClick="() => isModulePickerOpen = true" Tooltip="@($"Active module: {activeMod.Name} (Click to switch module)")" Class="module-switch-btn">
                                    <LucideIcon Name="@(string.IsNullOrWhiteSpace(activeMod.Icon) ? "layout-grid" : activeMod.Icon)" Size="18" />
                                    <span>@activeMod.Name</span>
                                </BbSidebarMenuButton>
                            </BbSidebarMenuItem>
                        }
                    </BbSidebarMenu>
                </BbSidebarGroup>

                @if (activeMod is not null)
                {
                    var moduleGroups = navGroups
                        .Where(g => g.IsActive && g.ModuleId == activeMod.Id)
                        .OrderBy(g => g.SortOrder)
                        .ThenBy(g => g.Name)
                        .ToList();

                    var moduleDocs = ReadableDocTypes(u)
                        .Where(d => !d.Def.IsChild && BelongsToModule(d, activeMod, visibleModules))
                        .OrderBy(d => d.Def.Title)
                        .ToList();
                    if (moduleDocs.Count > 0)
                    {
                        <BbSidebarGroup>
                            <BbSidebarGroupLabel>Dokumen</BbSidebarGroupLabel>
                            <BbSidebarGroupContent>
                                <BbSidebarMenu>
                                    @foreach (var d in moduleDocs)
                                    {
                                        <BbSidebarMenuItem>
                                            <BbSidebarMenuButton AsChild="SidebarMenuButtonElement.Anchor" Href="@($"app/{d.Name}")" Tooltip="@d.Title">
                                                <LucideIcon Name="@IconFor(d)" Size="18" /><span>@d.Title</span>
                                            </BbSidebarMenuButton>
                                        </BbSidebarMenuItem>
                                    }
                                </BbSidebarMenu>
                            </BbSidebarGroupContent>
                        </BbSidebarGroup>
                    }

                    @foreach (var grp in moduleGroups)
                    {
                        var grpMenus = visibleMenus
                            .Where(m => !string.IsNullOrEmpty(m.Href)
                                     && !string.Equals(m.Href, "inbox", StringComparison.OrdinalIgnoreCase)
                                     && (m.GroupId == grp.Id || (string.IsNullOrWhiteSpace(m.GroupId) && string.Equals(m.GroupName, grp.Name, StringComparison.OrdinalIgnoreCase))))
                            .OrderBy(m => m.SortOrder)
                            .ToList();

                        var explicitHrefs = grpMenus.Select(m => m.Href.TrimStart('/')).ToHashSet(StringComparer.OrdinalIgnoreCase);

                        // DocType tidak lagi dicocokkan dengan nama grup; tampil per modul di bagian "Dokumen".
                        var grpDocTypes = new List<CompiledDocType>();

                        var grpDeskItems = VisibleMenuItems(u)
                            .Where(i => string.Equals(i.Group, grp.Name, StringComparison.OrdinalIgnoreCase)
                                     && !explicitHrefs.Contains(i.Href.TrimStart('/')))
                            .ToList();

                        @if (grpDocTypes.Count > 0 || grpDeskItems.Count > 0 || grpMenus.Count > 0)
                        {
                            <BbSidebarGroup>
                                <BbSidebarGroupLabel>@grp.Name</BbSidebarGroupLabel>
                                <BbSidebarGroupContent>
                                    <BbSidebarMenu>
                                        @foreach (var d in grpDocTypes)
                                        {
                                            <BbSidebarMenuItem>
                                                <BbSidebarMenuButton AsChild="SidebarMenuButtonElement.Anchor" Href="@($"app/{d.Name}")" Tooltip="@d.Title">
                                                    <LucideIcon Name="@IconFor(d)" Size="18" /><span>@d.Title</span>
                                                </BbSidebarMenuButton>
                                            </BbSidebarMenuItem>
                                        }
                                        @foreach (var item in grpDeskItems)
                                        {
                                            <BbSidebarMenuItem>
                                                <BbSidebarMenuButton AsChild="SidebarMenuButtonElement.Anchor" Href="@item.Href.TrimStart('/')" Tooltip="@item.Title">
                                                    <LucideIcon Name="@item.Icon" Size="18" /><span>@item.Title</span>
                                                </BbSidebarMenuButton>
                                            </BbSidebarMenuItem>
                                        }
                                        @foreach (var item in grpMenus)
                                        {
                                            <BbSidebarMenuItem>
                                                <BbSidebarMenuButton AsChild="SidebarMenuButtonElement.Anchor" Href="@item.Href.TrimStart('/')" Match="@(string.IsNullOrEmpty(item.Href) ? NavLinkMatch.All : NavLinkMatch.Prefix)" Tooltip="@item.Title">
                                                    <LucideIcon Name="@item.Icon" Size="18" /><span>@item.Title</span>
                                                </BbSidebarMenuButton>
                                                @if (item.BadgeKey == NavigationMenuDefaults.BadgeInboxUnread && unread > 0)
                                                {
                                                    <BbSidebarMenuBadge>@unread</BbSidebarMenuBadge>
                                                }
                                            </BbSidebarMenuItem>
                                        }
                                    </BbSidebarMenu>
                                </BbSidebarGroupContent>
                            </BbSidebarGroup>
                        }
                    }
                }
            }
        </BbSidebarContent>

        @if (Current.User is { } me)
        {
            var avatarId = me.Attr("avatar");
            <BbSidebarFooter>
                <button type="button" class="sidebar-user sidebar-user-btn" title="@($"{me.FullName} · Click for user info & profile photo")" @onclick="OpenUserProfile">
                    <div class="sidebar-avatar-box">
                        @if (!string.IsNullOrWhiteSpace(avatarId))
                        {
                            <img src="@($"/files/{avatarId}")" alt="@me.FullName" />
                        }
                        else
                        {
                            <span>@Initials(me.FullName)</span>
                        }
                    </div>
                    <div class="who"><span style="font-weight:600;font-size:.85rem">@me.FullName</span>
                        <span class="muted small">@string.Join(", ", me.Roles.Where(r => r != "Employee").DefaultIfEmpty("Employee"))</span></div>
                    <LucideIcon Name="chevron-right" Size="16" Class="sidebar-user-chevron" />
                </button>
            </BbSidebarFooter>
        }
    </BbSidebar>

    <BbSidebarInset Class="app-inset">
        <header class="app-header">
            <div class="header-left">
                <BbSidebarTrigger />
                <BbSeparator Orientation="SeparatorOrientation.Vertical" Style="height:1.25rem" />
                @if (Current.User is { } cu)
                {
                    var visibleMods = navModules.Where(m => m.IsVisibleFor(cu)).OrderBy(m => m.SortOrder).ThenBy(m => m.Name).ToList();
                    var active = ResolveActiveModule(visibleMods);
                    @if (active is not null)
                    {
                        <button type="button" class="module-pill" title="Click to switch module" @onclick="() => isModulePickerOpen = true">
                            <LucideIcon Name="@(string.IsNullOrWhiteSpace(active.Icon) ? "layout-grid" : active.Icon)" Size="14" />
                            <span>@active.Name</span>
                            <LucideIcon Name="chevrons-up-down" Size="13" />
                        </button>
                    }
                }
            </div>
            
            <div class="header-center">
                <button type="button" class="header-search-btn" @onclick="OpenAwesomebar" title="Search or jump to (Ctrl+K or Alt+Q)">
                    <LucideIcon Name="search" Size="16" Class="header-search-icon" />
                    <span class="header-search-placeholder">Search (Ctrl+K / Alt+Q)</span>
                    <kbd class="header-search-kbd">Ctrl+K</kbd>
                </button>
            </div>

            <div class="header-right">
                @if (Current.User is { } who)
                {
                    <span class="tenant">Tenant @who.TenantId</span>
                    <BbSeparator Orientation="SeparatorOrientation.Vertical" Style="height:1.25rem;opacity:0.4;" />
                    <span class="theme-toggle"><BbDarkModeToggle Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" /></span>
                    <button type="button" class="header-logout-btn" @onclick="Logout">
                        <LucideIcon Name="log-out" Size="16" />
                        <span>Log out</span>
                    </button>
                }
                else
                {
                    <span class="theme-toggle"><BbDarkModeToggle Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" /></span>
                    <a href="/account/login" class="header-logout-btn" style="text-decoration:none">
                        <LucideIcon Name="login" Size="16" />
                        <span>Sign In</span>
                    </a>
                }
            </div>
        </header>
        <div class="page-top-bar">
            <div class="crumbs-trail">
                <a href="" class="crumb-item crumb-home" title="Home"><LucideIcon Name="house" Size="14" /></a>
                @if (Current.User is { } cuCurrent)
                {
                    var visibleMods = navModules.Where(m => m.IsVisibleFor(cuCurrent)).OrderBy(m => m.SortOrder).ThenBy(m => m.Name).ToList();
                    var active = ResolveActiveModule(visibleMods);
                    @if (active is not null)
                    {
                        <LucideIcon Name="chevron-right" Size="13" Class="crumb-sep" />
                        <button type="button" class="crumb-link" @onclick="() => isModulePickerOpen = true">@active.Name</button>
                    }
                }
                @if (CurrentDocTypeTitle() is { } docTitle)
                {
                    <LucideIcon Name="chevron-right" Size="13" Class="crumb-sep" />
                    <span class="crumb-item crumb-active">@docTitle</span>
                }
            </div>
        </div>
        <main class="app-main" id="content">
            @if (Current.User is null && !IsPublicErrorRoute())
            {
                <div class="stack"><BbSkeleton Height="2rem" /><BbSkeleton Height="12rem" /></div>
            }
            else
            {
                @Body
            }
        </main>
        <div class="bottom-full-wave" aria-hidden="true"></div>
    </BbSidebarInset>
</BbSidebarProvider>

<UserProfileDrawer @bind-Open="isProfileOpen" />
<AwesomebarModal @bind-Open="isAwesomebarOpen" OnToggleTheme="ToggleTheme" OnOpenProfile="OpenUserProfile" OnSwitchModule="SwitchModuleFromAwesomebar" />

@if (Current.User is { } modalUser)
{
    var modalModules = navModules.Where(m => m.IsVisibleFor(modalUser)).OrderBy(m => m.SortOrder).ThenBy(m => m.Name).ToList();
    var currentMod = ResolveActiveModule(modalModules);
    <BbDialog Open="@isModulePickerOpen" OpenChanged="v => isModulePickerOpen = v">
        <BbDialogContent Class="sm:max-w-xl">
            <BbDialogHeader>
                <BbDialogTitle>Select Workspace Module</BbDialogTitle>
                <BbDialogDescription>Choose a module to show its menu groups and menus in the sidebar.</BbDialogDescription>
            </BbDialogHeader>
            <div class="module-launcher-grid compact">
                @foreach (var mod in modalModules)
                {
                    var isCurrent = currentMod?.Id == mod.Id;
                    <button type="button" class="module-tile @(isCurrent ? "active" : "")" @onclick="() => SelectModuleFromModal(mod)">
                        <div class="module-tile-icon">
                            <LucideIcon Name="@(string.IsNullOrWhiteSpace(mod.Icon) ? "layout-grid" : mod.Icon)" Size="28" />
                        </div>
                        <div class="module-tile-title">@mod.Name</div>
                        @if (!string.IsNullOrWhiteSpace(mod.Description))
                        {
                            <div class="module-tile-desc">@mod.Description</div>
                        }
                    </button>
                }
            </div>
        </BbDialogContent>
    </BbDialog>
}

<BbToastProvider Position="ToastPosition.BottomRight" />
<BbDialogProvider />
<BbPortalHost />

@code {
    private int unread;
    private PeriodicTimer? timer;
    private IReadOnlyList<NavigationModule> navModules = [];
    private IReadOnlyList<NavigationMenuGroup> navGroups = [];
    private IReadOnlyList<NavigationMenuItem> navMenus = [];
    private bool isModulePickerOpen;
    private bool isProfileOpen;
    private bool isAwesomebarOpen;
    private DotNetObjectReference<DeskLayout>? dotNetRef;

    private void OpenUserProfile() => isProfileOpen = true;

    [JSInvokable]
    public void OpenAwesomebarFromJs()
    {
        isAwesomebarOpen = true;
        _ = InvokeAsync(StateHasChanged);
    }

    private void OpenAwesomebar() => isAwesomebarOpen = true;

    private async Task ToggleTheme()
    {
        await JS.InvokeVoidAsync("frogframe.toggleTheme");
    }

    private void SwitchModuleFromAwesomebar(string modId)
    {
        Current.SetActiveModule(modId);
        var mod = navModules.FirstOrDefault(m => m.Id == modId);
        if (mod is not null)
        {
            Toasts.Success($"Switched to {mod.Name} module.", "Active Module");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            dotNetRef = DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync("frogframe.initGlobalShortcuts", dotNetRef);
            }
            catch
            {
                // In case JS isn't available yet or in non-interactive environment
            }
        }
    }

    protected override void OnInitialized()
    {
        Current.Changed += OnUserChanged;
        Current.ModuleChanged += OnModuleChanged;
        MenuStore.Changed += OnMenusChanged;
        if (Current.User is null) { RedirectToLogin(); return; }
        RefreshUnread();
        _ = LoadMenusAsync();
        timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        _ = Poll();
    }

    private async Task LoadMenusAsync()
    {
        if (Current.User is { } u)
        {
            navModules = await MenuStore.ListModulesAsync(u.TenantId, onlyActive: true);
            navGroups = await MenuStore.ListGroupsAsync(u.TenantId, onlyActive: true);
            navMenus = await MenuStore.ListAsync(u.TenantId, onlyActive: true);
            EnsureInitialActiveModule(u);
            await InvokeAsync(StateHasChanged);
        }
    }

    private void EnsureInitialActiveModule(UserContext u)
    {
        var visible = navModules.Where(m => m.IsVisibleFor(u)).OrderBy(m => m.SortOrder).ThenBy(m => m.Name).ToList();
        if (visible.Count == 0) return;
        if (!string.IsNullOrWhiteSpace(Current.ActiveModuleId) && visible.Any(m => m.Id == Current.ActiveModuleId))
            return;

        // Try matching the current relative URL to a module so deep links select the right module automatically.
        var rel = Nav.ToBaseRelativePath(Nav.Uri).Trim('/');
        if (!string.IsNullOrEmpty(rel))
        {
            var matchedMenu = navMenus.FirstOrDefault(m => !string.IsNullOrEmpty(m.Href) && rel.StartsWith(m.Href.Trim('/'), StringComparison.OrdinalIgnoreCase));
            if (matchedMenu is not null)
            {
                var grp = navGroups.FirstOrDefault(g => g.Id == matchedMenu.GroupId || string.Equals(g.Name, matchedMenu.GroupName, StringComparison.OrdinalIgnoreCase));
                if (grp is not null && visible.Any(m => m.Id == grp.ModuleId))
                {
                    Current.SetActiveModule(grp.ModuleId);
                    return;
                }
            }
        }

        Current.SetActiveModule(visible[0].Id);
    }

    private NavigationModule? ResolveActiveModule(IReadOnlyList<NavigationModule> visibleModules)
    {
        if (visibleModules.Count == 0) return null;
        return visibleModules.FirstOrDefault(m => m.Id == Current.ActiveModuleId) ?? visibleModules[0];
    }

    private void SelectModuleFromModal(NavigationModule mod)
    {
        Current.SetActiveModule(mod.Id);
        isModulePickerOpen = false;
        Toasts.Success($"Sidebar switched to {mod.Name} module.", "Active Module");
    }

    private void OnModuleChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnMenusChanged()
    {
        _ = LoadMenusAsync();
    }

    /// <summary>Redirects to login when session is missing or invalidated during periodic security stamp revalidation.</summary>
    private void OnUserChanged()
    {
        if (Current.User is null) InvokeAsync(RedirectToLogin);
        else _ = LoadMenusAsync();
    }

    private bool IsPublicErrorRoute()
    {
        var rel = Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].Trim('/').ToLowerInvariant();
        return rel == "error"
            || rel.StartsWith("error/", StringComparison.Ordinal)
            || rel is "401" or "403" or "404" or "500" or "not-found" or "unauthorized" or "forbidden" or "access-denied";
    }

    private void RedirectToLogin()
    {
        if (IsPublicErrorRoute()) return;
        var back = "/" + Nav.ToBaseRelativePath(Nav.Uri);
        Nav.NavigateTo($"/account/login?returnUrl={Uri.EscapeDataString(back)}", forceLoad: true);
    }

    private void ChangePassword() => Nav.NavigateTo("/account/password", forceLoad: true);

    private void Logout() => Nav.NavigateTo("/account/logout", forceLoad: true);

    private async Task Poll()
    {
        try
        {
            while (await timer!.WaitForNextTickAsync())
            {
                var before = unread;
                RefreshUnread();
                if (before != unread) await InvokeAsync(StateHasChanged);
            }
        }
        catch (ObjectDisposedException) { }
    }

    private void RefreshUnread() =>
        unread = Current.User is { } u ? Notifications.ForUser(u.TenantId, u.Id).Count(n => !n.Read) : 0;

    /// <summary>
    /// DocType termasuk modul aktif bila modulnya cocok. DocType yang modulnya tidak bisa di-resolve (data lama)
    /// ditampilkan di modul pertama yang terlihat agar tidak hilang dari menu.
    /// </summary>
    private bool BelongsToModule(CompiledDocType d, NavigationModule active, IReadOnlyList<NavigationModule> visible)
    {
        var resolved = NavigationMenuDefaults.ResolveModule(navModules, d.Def.Module);
        return resolved is null ? visible.FirstOrDefault()?.Id == active.Id : resolved.Id == active.Id;
    }

    private IEnumerable<CompiledDocType> ReadableDocTypes(UserContext u) =>
        Metadata.Current.DocTypes.Values.Where(d => !d.Def.IsChild && Perms.Can(u, d, DocActions.Read)).OrderBy(d => d.Def.Module).ThenBy(d => d.Title);

    private static string IconFor(CompiledDocType d) => d.Name switch
    {
        "Employee" => "users", "Department" => "building", "Vendor" => "building-2", "Product" => "package",
        "PurchaseRequest" => "shopping-cart", _ => "file-text"
    };

    /// <summary>Additional application menu items registered via AddDeskMenuItem, shown when the user has read access to RequiresReadOf.</summary>
    private IEnumerable<DeskMenuItem> VisibleMenuItems(UserContext u) => MenuItems
        .Where(i => i.RequiresReadOf is null || (Metadata.Current.TryGet(i.RequiresReadOf, out var m) && Perms.Can(u, m, DocActions.Read)))
        .OrderBy(i => i.Order);

    private string? CurrentDocTypeTitle()
    {
        var rel = Nav.ToBaseRelativePath(Nav.Uri).Trim('/');
        if (rel.StartsWith("app/", StringComparison.OrdinalIgnoreCase))
        {
            var parts = rel.Split('/', StringSplitOptions.RemoveEmptyEntries);
            if (parts.Length >= 2)
            {
                var dtName = parts[1];
                if (Metadata.Current.TryGet(dtName, out var dt))
                {
                    return dt.Title;
                }
                return dtName;
            }
        }
        else if (rel.Equals("inbox", StringComparison.OrdinalIgnoreCase))
        {
            return "Inbox";
        }
        return null;
    }

    private static string Initials(string name) => string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => p[0]));

    public void Dispose()
    {
        Current.Changed -= OnUserChanged;
        Current.ModuleChanged -= OnModuleChanged;
        MenuStore.Changed -= OnMenusChanged;
        timer?.Dispose();
        dotNetRef?.Dispose();
    }
}

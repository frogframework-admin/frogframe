@inherits LayoutComponentBase
@implements IDisposable
@using Framework.Navigation
@inject CurrentUser Current
@inject IMetadataProvider Metadata
@inject IPermissionService Perms
@inject INotificationStore Notifications
@inject ReportService Reports
@inject NavigationManager Nav
@inject IEnumerable<DeskMenuItem> MenuItems
@inject INavigationMenuStore MenuStore
@inject ToastService Toasts
@inject IJSRuntime JS
@inject UiText T

<BbSidebarProvider DefaultOpen="true">
    <BbSidebar Collapsible="true">
        <BbSidebarHeader>
            <BbSidebarMenu>
                <BbSidebarMenuItem>
                    <BbSidebarMenuButton AsChild="SidebarMenuButtonElement.Anchor" Href="" Size="SidebarMenuButtonSize.Large">
                        <span class="brand"><span class="brand-mark" aria-hidden="true">F</span><span>FrogFrame</span></span>
                    </BbSidebarMenuButton>
                </BbSidebarMenuItem>
            </BbSidebarMenu>
        </BbSidebarHeader>

        <BbSidebarContent>
            @if (Current.User is { } u)
            {
                var visibleModules = navModules.Where(m => m.IsVisibleFor(u)).OrderBy(m => m.SortOrder).ThenBy(m => m.Name).ToList();
                var activeMod = ResolveActiveModule(visibleModules);
                var visibleMenus = navMenus.Where(m => m.IsVisibleFor(u)).ToList();

                <BbSidebarGroup>
                    <BbSidebarMenu>
                        <BbSidebarMenuItem>
                            <BbSidebarMenuButton AsChild="SidebarMenuButtonElement.Anchor" Href="" Match="NavLinkMatch.All" Tooltip="@(T["Home & Module Picker"])">
                                <LucideIcon Name="house" Size="18" /><span>@T["Home"]</span>
                            </BbSidebarMenuButton>
                        </BbSidebarMenuItem>
                        <BbSidebarMenuItem>
                            <BbSidebarMenuButton AsChild="SidebarMenuButtonElement.Anchor" Href="/inbox" Match="NavLinkMatch.Prefix" Tooltip="@(T["Inbox"])">
                                <LucideIcon Name="inbox" Size="18" /><span>@T["Inbox"]</span>
                            </BbSidebarMenuButton>
                            @if (unread > 0)
                            {
                                <BbSidebarMenuBadge>@unread</BbSidebarMenuBadge>
                            }
                        </BbSidebarMenuItem>
                        @if (activeMod is not null)
                        {
                            <BbSidebarMenuItem>
                                <BbSidebarMenuButton OnClick="OpenModulePicker" Tooltip="@(T.Format("Active module: {0} (Click to switch module)", T[activeMod.Name]))" Class="module-switch-btn">
                                    <LucideIcon Name="@(string.IsNullOrWhiteSpace(activeMod.Icon) ? "layout-grid" : activeMod.Icon)" Size="18" />
                                    <span>@T[activeMod.Name]</span>
                                </BbSidebarMenuButton>
                            </BbSidebarMenuItem>
                        }
                    </BbSidebarMenu>
                </BbSidebarGroup>

                @if (activeMod is not null)
                {
                    var moduleGroups = navGroups
                        .Where(g => g.IsActive && g.ModuleId == activeMod.Id)
                        .OrderBy(g => g.SortOrder)
                        .ThenBy(g => g.Name)
                        .ToList();

                    var moduleDocs = ReadableDocTypes(u)
                        .Where(d => !d.Def.IsChild && BelongsToModule(d, activeMod, visibleModules))
                        .Where(d => !moduleGroups.Any(grp => visibleMenus.Any(m => (m.GroupId == grp.Id || (string.IsNullOrWhiteSpace(m.GroupId) && string.Equals(m.GroupName, grp.Name, StringComparison.OrdinalIgnoreCase))) && string.Equals(m.Href?.TrimStart('/'), $"app/{d.Name}", StringComparison.OrdinalIgnoreCase))))
                        .OrderBy(d => d.Def.Title)
                        .ToList();
                    if (moduleDocs.Count > 0)
                    {
                        <BbSidebarGroup>
                            <BbSidebarGroupLabel>@T["Documents"]</BbSidebarGroupLabel>
                            <BbSidebarGroupContent>
                                <BbSidebarMenu>
                                    @foreach (var d in moduleDocs)
                                    {
                                        <BbSidebarMenuItem>
                                            <BbSidebarMenuButton AsChild="SidebarMenuButtonElement.Anchor" Href="@($"app/{d.Name}")" Tooltip="@(T.Title(d))">
                                                <LucideIcon Name="@IconFor(d)" Size="18" /><span>@T.Title(d)</span>
                                            </BbSidebarMenuButton>
                                        </BbSidebarMenuItem>
                                    }
                                </BbSidebarMenu>
                            </BbSidebarGroupContent>
                        </BbSidebarGroup>
                    }

                    @foreach (var grp in moduleGroups)
                    {
                        var grpMenus = visibleMenus
                            .Where(m => !string.IsNullOrEmpty(m.Href)
                                     && !string.Equals(m.Href, "inbox", StringComparison.OrdinalIgnoreCase)
                                     && (m.GroupId == grp.Id || (string.IsNullOrWhiteSpace(m.GroupId) && string.Equals(m.GroupName, grp.Name, StringComparison.OrdinalIgnoreCase))))
                            .OrderBy(m => m.SortOrder)
                            .ToList();

                        var explicitHrefs = grpMenus.Select(m => m.Href.TrimStart('/')).ToHashSet(StringComparer.OrdinalIgnoreCase);

                        // DocType tidak lagi dicocokkan dengan nama grup; tampil per modul di bagian "Dokumen".
                        var grpDocTypes = new List<CompiledDocType>();

                        var grpDeskItems = VisibleMenuItems(u)
                            .Where(i => string.Equals(i.Group, grp.Name, StringComparison.OrdinalIgnoreCase)
                                     && !explicitHrefs.Contains(i.Href.TrimStart('/')))
                            .ToList();

                        @if (grpDocTypes.Count > 0 || grpDeskItems.Count > 0 || grpMenus.Count > 0)
                        {
                            <BbSidebarGroup>
                                <BbSidebarGroupLabel>@T[grp.Name]</BbSidebarGroupLabel>
                                <BbSidebarGroupContent>
                                    <BbSidebarMenu>
                                        @foreach (var d in grpDocTypes)
                                        {
                                            <BbSidebarMenuItem>
                                                <BbSidebarMenuButton AsChild="SidebarMenuButtonElement.Anchor" Href="@($"app/{d.Name}")" Tooltip="@(T.Title(d))">
                                                    <LucideIcon Name="@IconFor(d)" Size="18" /><span>@T.Title(d)</span>
                                                </BbSidebarMenuButton>
                                            </BbSidebarMenuItem>
                                        }
                                        @foreach (var item in grpDeskItems)
                                        {
                                            <BbSidebarMenuItem>
                                                <BbSidebarMenuButton AsChild="SidebarMenuButtonElement.Anchor" Href="@item.Href.TrimStart('/')" Tooltip="@(T[item.Title])">
                                                    <LucideIcon Name="@item.Icon" Size="18" /><span>@T[item.Title]</span>
                                                </BbSidebarMenuButton>
                                            </BbSidebarMenuItem>
                                        }
                                        @foreach (var item in grpMenus)
                                        {
                                            <BbSidebarMenuItem>
                                                <BbSidebarMenuButton AsChild="SidebarMenuButtonElement.Anchor" Href="@item.Href.TrimStart('/')" Match="@(string.IsNullOrEmpty(item.Href) ? NavLinkMatch.All : NavLinkMatch.Prefix)" Tooltip="@(T[item.Title])">
                                                    <LucideIcon Name="@item.Icon" Size="18" /><span>@T[item.Title]</span>
                                                </BbSidebarMenuButton>
                                                @if (item.BadgeKey == NavigationMenuDefaults.BadgeInboxUnread && unread > 0)
                                                {
                                                    <BbSidebarMenuBadge>@unread</BbSidebarMenuBadge>
                                                }
                                            </BbSidebarMenuItem>
                                        }
                                    </BbSidebarMenu>
                                </BbSidebarGroupContent>
                            </BbSidebarGroup>
                        }
                    }
                }
            }
        </BbSidebarContent>

        @if (Current.User is { } me)
        {
            var avatarId = me.Attr("avatar");
            <BbSidebarFooter>
                <button type="button" class="sidebar-user sidebar-user-btn" title="@($"{me.FullName} · {T["Click for user info & profile photo"]}")" @onclick="OpenUserProfile">
                    <div class="sidebar-avatar-box">
                        @if (!string.IsNullOrWhiteSpace(avatarId))
                        {
                            <img src="@($"/files/{avatarId}")" alt="@me.FullName" />
                        }
                        else
                        {
                            <span>@Initials(me.FullName)</span>
                        }
                    </div>
                    <div class="who"><span style="font-weight:600;font-size:.85rem">@me.FullName</span>
                        <span class="muted small">@string.Join(", ", me.Roles.Where(r => r != "Employee").DefaultIfEmpty("Employee"))</span></div>
                    <LucideIcon Name="chevron-right" Size="16" Class="sidebar-user-chevron" />
                </button>
            </BbSidebarFooter>
        }
    </BbSidebar>

    <BbSidebarInset Class="app-inset">
        <header class="app-header">
            <div class="header-left">
                <BbSidebarTrigger />
                <BbSeparator Orientation="SeparatorOrientation.Vertical" Style="height:1.25rem" />
                @if (Current.User is { } cu)
                {
                    var visibleMods = navModules.Where(m => m.IsVisibleFor(cu)).OrderBy(m => m.SortOrder).ThenBy(m => m.Name).ToList();
                    var active = ResolveActiveModule(visibleMods);
                    @if (active is not null)
                    {
                        <button type="button" class="module-pill" title="@(T["Click to switch module"])" @onclick="() => isModulePickerOpen = true">
                            <LucideIcon Name="@(string.IsNullOrWhiteSpace(active.Icon) ? "layout-grid" : active.Icon)" Size="14" />
                            <span>@T[active.Name]</span>
                            <LucideIcon Name="chevrons-up-down" Size="13" />
                        </button>
                    }
                }
            </div>
            
            <div class="header-center">
                <button type="button" class="header-search-btn" @onclick="OpenAwesomebar" title="@(T["Search or jump to (Ctrl+K or Alt+Q)"])">
                    <LucideIcon Name="search" Size="16" Class="header-search-icon" />
                    <span class="header-search-placeholder">@T["Search (Ctrl+K / Alt+Q)"]</span>
                    <kbd class="header-search-kbd">Ctrl+K</kbd>
                </button>
            </div>

            <div class="header-right">
                @if (Current.User is { } who)
                {
                    <span class="tenant">@T["Tenant"] @who.TenantId</span>
                    <BbSeparator Orientation="SeparatorOrientation.Vertical" Style="height:1.25rem;opacity:0.4;" />
                    <span class="theme-toggle"><BbDarkModeToggle Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" /></span>
                    <LanguageSwitch />
                    <button type="button" class="header-logout-btn" @onclick="Logout">
                        <LucideIcon Name="log-out" Size="16" />
                        <span>@T["Log out"]</span>
                    </button>
                }
                else
                {
                    <span class="theme-toggle"><BbDarkModeToggle Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" /></span>
                    <LanguageSwitch />
                    <a href="/account/login" class="header-logout-btn" style="text-decoration:none">
                        <LucideIcon Name="login" Size="16" />
                        <span>@T["Sign In"]</span>
                    </a>
                }
            </div>
        </header>
        <div class="page-top-bar">
            <div class="crumbs-trail">
                @{
                    var crumbs = GetBreadcrumbs();
                }
                <a href="" class="@(crumbs.Count == 0 ? "crumb-item crumb-home crumb-active" : "crumb-item crumb-home")" title="@(T["Home"])">
                    <LucideIcon Name="house" Size="14" />
                </a>
                @foreach (var crumb in crumbs)
                {
                    <LucideIcon Name="chevron-right" Size="13" Class="crumb-sep" />
                    @if (crumb.OnClick is not null)
                    {
                        <button type="button" class="crumb-link" @onclick="crumb.OnClick">@T[crumb.Label]</button>
                    }
                    else if (!string.IsNullOrEmpty(crumb.Href))
                    {
                        <a href="@crumb.Href" class="crumb-link">@T[crumb.Label]</a>
                    }
                    else if (crumb.IsActive)
                    {
                        <span class="crumb-item crumb-active">@T[crumb.Label]</span>
                    }
                    else
                    {
                        <span class="crumb-item">@T[crumb.Label]</span>
                    }
                }
            </div>
        </div>
        <main class="app-main" id="content">
            @if (Current.User is null && !IsPublicErrorRoute())
            {
                <div class="stack"><BbSkeleton Height="2rem" /><BbSkeleton Height="12rem" /></div>
            }
            else
            {
                <FrogFrameErrorBoundary @ref="errorBoundary">
                    <div @key="T.Language" style="display:contents">@Body</div>
                </FrogFrameErrorBoundary>
            }
        </main>
        <div class="bottom-full-wave" aria-hidden="true"></div>
    </BbSidebarInset>
</BbSidebarProvider>

<UserProfileDrawer @bind-Open="isProfileOpen" />
<AwesomebarModal @bind-Open="isAwesomebarOpen" OnToggleTheme="ToggleTheme" OnOpenProfile="OpenUserProfile" OnSwitchModule="SwitchModuleFromAwesomebar" />

@if (Current.User is { } modalUser)
{
    var modalModules = navModules.Where(m => m.IsVisibleFor(modalUser)).OrderBy(m => m.SortOrder).ThenBy(m => m.Name).ToList();
    var currentMod = ResolveActiveModule(modalModules);
    var filteredModules = string.IsNullOrWhiteSpace(moduleSearchQuery)
        ? modalModules
        : modalModules.Where(m => m.Name.Contains(moduleSearchQuery, StringComparison.OrdinalIgnoreCase) || T[m.Name].Contains(moduleSearchQuery, StringComparison.OrdinalIgnoreCase)).ToList();

    <BbDialog Open="@isModulePickerOpen" OpenChanged="OnModulePickerOpenChanged">
        <BbDialogContent Class="sm:max-w-lg module-picker-dialog">
            <BbDialogHeader Class="module-picker-header">
                <BbDialogTitle>@T["Select Workspace Module"]</BbDialogTitle>
                <BbDialogDescription>@T["Choose a module to show its menu groups and menus in the sidebar."]</BbDialogDescription>
            </BbDialogHeader>
            <div class="module-picker-search">
                <BbInputGroup>
                    <BbInputGroupAddon Align="InputGroupAlign.InlineStart">
                        <LucideIcon Name="search" Size="16" />
                    </BbInputGroupAddon>
                    <BbInputGroupInput Value="@moduleSearchQuery" ValueChanged="v => moduleSearchQuery = v"
                                       UpdateTiming="UpdateTiming.Debounced" DebounceInterval="100"
                                       Placeholder="@(T["Search modules..."])" AriaLabel="@(T["Search modules"])" />
                    @if (!string.IsNullOrWhiteSpace(moduleSearchQuery))
                    {
                        <BbInputGroupAddon Align="InputGroupAlign.InlineEnd">
                            <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="search-clear-btn"
                                      OnClick="() => moduleSearchQuery = string.Empty" AriaLabel="@(T["Clear search"])">
                                <LucideIcon Name="x" Size="14" />
                            </BbButton>
                        </BbInputGroupAddon>
                    }
                </BbInputGroup>
            </div>
            @if (filteredModules.Count == 0)
            {
                <div style="padding: 2rem 1rem; text-align: center; color: var(--muted-foreground);">
                    <LucideIcon Name="search-x" Size="32" style="margin: 0 auto .5rem; display: block; opacity: .5;" />
                    <div style="font-weight: 600; font-size: .95rem; color: var(--foreground);">@T["No modules found"]</div>
                    <div style="font-size: .85rem; margin-top: .25rem;">@(T.Format("No module matches \"{0}\"", moduleSearchQuery))</div>
                </div>
            }
            else
            {
                <BbItemGroup Class="module-list-stack">
                    @foreach (var mod in filteredModules)
                    {
                        var isCurrent = currentMod?.Id == mod.Id;
                        <BbItem Variant="ItemVariant.Outline"
                                AsChild="button"
                                Class="@($"module-horizontal-item {(isCurrent ? "active" : "")}")"
                                @onclick="() => SelectModuleFromModal(mod)">
                            <BbItemMedia Variant="ItemMediaVariant.Icon" Class="module-media-box">
                                <LucideIcon Name="@(string.IsNullOrWhiteSpace(mod.Icon) ? "layout-grid" : mod.Icon)" Size="18" />
                            </BbItemMedia>
                            <BbItemContent Class="module-horizontal-content">
                                <BbItemTitle Class="module-horizontal-title">@T[mod.Name]</BbItemTitle>
                            </BbItemContent>
                            @if (isCurrent)
                            {
                                <div class="module-active-check" title="@(T["Active module"])">
                                    <LucideIcon Name="check" Size="16" />
                                </div>
                            }
                        </BbItem>
                    }
                </BbItemGroup>
            }
        </BbDialogContent>
    </BbDialog>
}

<BbToastProvider Position="ToastPosition.BottomRight" />
<BbDialogProvider />
<BbPortalHost />

@code {
    private int unread;
    private PeriodicTimer? timer;
    private IReadOnlyList<NavigationModule> navModules = [];
    private IReadOnlyList<NavigationMenuGroup> navGroups = [];
    private IReadOnlyList<NavigationMenuItem> navMenus = [];
    private bool isModulePickerOpen;
    private string? moduleSearchQuery;
    private bool isProfileOpen;
    private bool isAwesomebarOpen;
    private DotNetObjectReference<DeskLayout>? dotNetRef;
    private FrogFrameErrorBoundary? errorBoundary;

    private void OpenUserProfile() => isProfileOpen = true;

    [JSInvokable]
    public void OpenAwesomebarFromJs()
    {
        isAwesomebarOpen = true;
        _ = InvokeAsync(StateHasChanged);
    }

    private void OpenAwesomebar() => isAwesomebarOpen = true;

    private async Task ToggleTheme()
    {
        await JS.InvokeVoidAsync("frogframe.toggleTheme");
    }

    private void SwitchModuleFromAwesomebar(string modId)
    {
        Current.SetActiveModule(modId);
        var mod = navModules.FirstOrDefault(m => m.Id == modId);
        if (mod is not null)
        {
            Toasts.Success(T.Format("Switched to {0} module.", T[mod.Name]), T["Active Module"]);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            dotNetRef = DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync("frogframe.initGlobalShortcuts", dotNetRef);
            }
            catch
            {
                // In case JS isn't available yet or in non-interactive environment
            }
        }
    }

    protected override void OnInitialized()
    {
        Current.Changed += OnUserChanged;
        Current.ModuleChanged += OnModuleChanged;
        MenuStore.Changed += OnMenusChanged;
        T.Changed += OnLanguageChanged;
        Nav.LocationChanged += OnLocationChanged;
        if (Current.User is null) { RedirectToLogin(); return; }
        RefreshUnread();
        _ = LoadMenusAsync();
        timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        _ = Poll();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        errorBoundary?.Recover();
        if (Current.User is { } u)
        {
            SyncModuleWithRoute(u);
        }
        InvokeAsync(StateHasChanged);
    }

    private async Task LoadMenusAsync()
    {
        if (Current.User is { } u)
        {
            navModules = await MenuStore.ListModulesAsync(u.TenantId, onlyActive: true);
            navGroups = await MenuStore.ListGroupsAsync(u.TenantId, onlyActive: true);
            navMenus = await MenuStore.ListAsync(u.TenantId, onlyActive: true);
            EnsureInitialActiveModule(u);
            await InvokeAsync(StateHasChanged);
        }
    }

    private void EnsureInitialActiveModule(UserContext u)
    {
        var visible = navModules.Where(m => m.IsVisibleFor(u)).OrderBy(m => m.SortOrder).ThenBy(m => m.Name).ToList();
        if (visible.Count == 0) return;

        SyncModuleWithRoute(u);

        if (string.IsNullOrWhiteSpace(Current.ActiveModuleId) || !visible.Any(m => m.Id == Current.ActiveModuleId))
        {
            Current.SetActiveModule(visible[0].Id);
        }
    }

    private void SyncModuleWithRoute(UserContext u)
    {
        var visible = navModules.Where(m => m.IsVisibleFor(u)).OrderBy(m => m.SortOrder).ThenBy(m => m.Name).ToList();
        if (visible.Count == 0) return;

        var rel = Nav.ToBaseRelativePath(Nav.Uri).Trim('/');
        if (string.IsNullOrEmpty(rel)) return;

        // Inbox and account profile routes are global utilities, they should not switch the active module.
        if (rel.Equals("inbox", StringComparison.OrdinalIgnoreCase)
            || rel.StartsWith("inbox/", StringComparison.OrdinalIgnoreCase)
            || rel.Equals("account", StringComparison.OrdinalIgnoreCase)
            || rel.StartsWith("account/", StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        // If the current active module already contains this route (via its menu items or DocType definition), preserve it.
        if (!string.IsNullOrWhiteSpace(Current.ActiveModuleId) && visible.FirstOrDefault(m => m.Id == Current.ActiveModuleId) is { } currentActive)
        {
            var currentModGroups = navGroups.Where(g => g.ModuleId == currentActive.Id).Select(g => g.Id).ToHashSet(StringComparer.OrdinalIgnoreCase);
            var hasMatchingMenu = navMenus.Any(m => !string.IsNullOrEmpty(m.Href)
                && currentModGroups.Contains(m.GroupId ?? string.Empty)
                && (rel.Equals(m.Href.Trim('/'), StringComparison.OrdinalIgnoreCase) || rel.StartsWith(m.Href.Trim('/') + "/", StringComparison.OrdinalIgnoreCase)));

            if (hasMatchingMenu)
            {
                return;
            }

            var parts = rel.Split('/', StringSplitOptions.RemoveEmptyEntries);
            if (parts.Length >= 2 && parts[0].Equals("app", StringComparison.OrdinalIgnoreCase))
            {
                var dtName = parts[1];
                if (Metadata.Current.TryGet(dtName, out var dt) && !string.IsNullOrWhiteSpace(dt.Def.Module))
                {
                    if (string.Equals(currentActive.Code, dt.Def.Module.Trim(), StringComparison.OrdinalIgnoreCase)
                        || string.Equals(currentActive.Name, dt.Def.Module.Trim(), StringComparison.OrdinalIgnoreCase))
                    {
                        return;
                    }
                }
            }
        }

        var routeParts = rel.Split('/', StringSplitOptions.RemoveEmptyEntries);
        if (routeParts.Length >= 2 && routeParts[0].Equals("app", StringComparison.OrdinalIgnoreCase))
        {
            var dtName = routeParts[1];
            if (Metadata.Current.TryGet(dtName, out var dt) && !string.IsNullOrWhiteSpace(dt.Def.Module))
            {
                var mod = NavigationMenuDefaults.ResolveModule(visible, dt.Def.Module)
                    ?? visible.FirstOrDefault(m => string.Equals(m.Name, dt.Def.Module, StringComparison.OrdinalIgnoreCase));
                if (mod is not null)
                {
                    if (Current.ActiveModuleId != mod.Id)
                    {
                        Current.SetActiveModule(mod.Id);
                    }
                    return;
                }
            }
        }

        var matchedMenu = navMenus.FirstOrDefault(m => !string.IsNullOrEmpty(m.Href)
            && !string.Equals(m.Href.Trim('/'), "inbox", StringComparison.OrdinalIgnoreCase)
            && (rel.Equals(m.Href.Trim('/'), StringComparison.OrdinalIgnoreCase) || rel.StartsWith(m.Href.Trim('/') + "/", StringComparison.OrdinalIgnoreCase)));
        if (matchedMenu is not null)
        {
            var grp = navGroups.FirstOrDefault(g => g.Id == matchedMenu.GroupId || string.Equals(g.Name, matchedMenu.GroupName, StringComparison.OrdinalIgnoreCase));
            if (grp is not null && visible.FirstOrDefault(m => m.Id == grp.ModuleId) is { } targetMod)
            {
                if (Current.ActiveModuleId != targetMod.Id)
                {
                    Current.SetActiveModule(targetMod.Id);
                }
            }
        }
    }

    private NavigationModule? ResolveActiveModule(IReadOnlyList<NavigationModule> visibleModules)
    {
        if (visibleModules.Count == 0) return null;
        return visibleModules.FirstOrDefault(m => m.Id == Current.ActiveModuleId) ?? visibleModules[0];
    }

    private void OpenModulePicker()
    {
        moduleSearchQuery = string.Empty;
        isModulePickerOpen = true;
    }

    private void OnModulePickerOpenChanged(bool open)
    {
        isModulePickerOpen = open;
        if (!open)
        {
            moduleSearchQuery = string.Empty;
        }
    }

    private void SelectModuleFromModal(NavigationModule mod)
    {
        Current.SetActiveModule(mod.Id);
        isModulePickerOpen = false;
        moduleSearchQuery = string.Empty;
        Toasts.Success(T.Format("Sidebar switched to {0} module.", T[mod.Name]), T["Active Module"]);
    }

    private void OnModuleChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnMenusChanged()
    {
        _ = LoadMenusAsync();
    }

    /// <summary>Redirects to login when session is missing or invalidated during periodic security stamp revalidation.</summary>
    private void OnUserChanged()
    {
        if (Current.User is null) InvokeAsync(RedirectToLogin);
        else _ = LoadMenusAsync();
    }

    private bool IsPublicErrorRoute()
    {
        var rel = Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].Trim('/').ToLowerInvariant();
        return rel == "error"
            || rel.StartsWith("error/", StringComparison.Ordinal)
            || rel is "401" or "403" or "404" or "500" or "not-found" or "unauthorized" or "forbidden" or "access-denied";
    }

    private void RedirectToLogin()
    {
        if (IsPublicErrorRoute()) return;
        var back = "/" + Nav.ToBaseRelativePath(Nav.Uri);
        Nav.NavigateTo($"/account/login?returnUrl={Uri.EscapeDataString(back)}", forceLoad: true);
    }

    private void ChangePassword() => Nav.NavigateTo("/account/password", forceLoad: true);

    private void Logout() => Nav.NavigateTo("/account/logout", forceLoad: true);

    private async Task Poll()
    {
        try
        {
            while (await timer!.WaitForNextTickAsync())
            {
                var before = unread;
                RefreshUnread();
                if (before != unread) await InvokeAsync(StateHasChanged);
            }
        }
        catch (ObjectDisposedException) { }
    }

    private void RefreshUnread() =>
        unread = Current.User is { } u ? Notifications.ForUser(u.TenantId, u.Id).Count(n => !n.Read) : 0;

    /// <summary>
    /// DocType termasuk modul aktif bila modulnya cocok. DocType yang modulnya tidak bisa di-resolve (data lama)
    /// ditampilkan di modul pertama yang terlihat agar tidak hilang dari menu.
    /// </summary>
    private bool BelongsToModule(CompiledDocType d, NavigationModule active, IReadOnlyList<NavigationModule> visible)
    {
        var resolved = NavigationMenuDefaults.ResolveModule(navModules, d.Def.Module);
        return resolved is null ? visible.FirstOrDefault()?.Id == active.Id : resolved.Id == active.Id;
    }

    private IEnumerable<CompiledDocType> ReadableDocTypes(UserContext u) =>
        Metadata.Current.DocTypes.Values.Where(d => !d.Def.IsChild && Perms.Can(u, d, DocActions.Read)).OrderBy(d => d.Def.Module).ThenBy(d => d.Title);

    private static string IconFor(CompiledDocType d) => d.Name switch
    {
        "Employee" => "users", "Department" => "building", "Vendor" => "building-2", "Product" => "package",
        "PurchaseRequest" => "shopping-cart", _ => "file-text"
    };

    /// <summary>Additional application menu items registered via AddDeskMenuItem, shown when the user has read access to RequiresReadOf.</summary>
    private IEnumerable<DeskMenuItem> VisibleMenuItems(UserContext u) => MenuItems
        .Where(i => i.RequiresReadOf is null || (Metadata.Current.TryGet(i.RequiresReadOf, out var m) && Perms.Can(u, m, DocActions.Read)))
        .OrderBy(i => i.Order);

    private sealed record Crumb(string Label, string? Href = null, bool IsActive = false, Action? OnClick = null);

    private IReadOnlyList<Crumb> GetBreadcrumbs()
    {
        var crumbs = new List<Crumb>();
        var rel = Nav.ToBaseRelativePath(Nav.Uri).Trim('/');
        if (string.IsNullOrEmpty(rel)) return crumbs;

        var parts = rel.Split('/', StringSplitOptions.RemoveEmptyEntries);
        var first = parts[0].ToLowerInvariant();

        if (first == "app" && parts.Length >= 2)
        {
            var dtName = parts[1];
            CompiledDocType? dt = null;
            Metadata.Current.TryGet(dtName, out dt);
            var dtTitle = dt?.Title ?? dtName;

            NavigationModule? docModule = null;
            if (!string.IsNullOrWhiteSpace(Current.ActiveModuleId))
            {
                var activeMod = navModules.FirstOrDefault(m => m.Id == Current.ActiveModuleId);
                if (activeMod is not null)
                {
                    var isDirectModule = !string.IsNullOrWhiteSpace(dt?.Def.Module)
                        && (string.Equals(activeMod.Code, dt.Def.Module.Trim(), StringComparison.OrdinalIgnoreCase)
                            || string.Equals(activeMod.Name, dt.Def.Module.Trim(), StringComparison.OrdinalIgnoreCase));

                    var activeModGroups = navGroups.Where(g => g.ModuleId == activeMod.Id).Select(g => g.Id).ToHashSet(StringComparer.OrdinalIgnoreCase);
                    var isInActiveMenu = navMenus.Any(m => !string.IsNullOrEmpty(m.Href)
                        && activeModGroups.Contains(m.GroupId ?? string.Empty)
                        && string.Equals(m.Href.Trim('/'), $"app/{dtName}", StringComparison.OrdinalIgnoreCase));

                    if (isDirectModule || isInActiveMenu)
                    {
                        docModule = activeMod;
                    }
                }
            }

            if (docModule is null && !string.IsNullOrWhiteSpace(dt?.Def.Module))
            {
                docModule = NavigationMenuDefaults.ResolveModule(navModules, dt.Def.Module)
                    ?? navModules.FirstOrDefault(m => string.Equals(m.Name, dt.Def.Module, StringComparison.OrdinalIgnoreCase));
            }

            if (docModule is null && Current.User is { } u)
            {
                var visibleMods = navModules.Where(m => m.IsVisibleFor(u)).OrderBy(m => m.SortOrder).ThenBy(m => m.Name).ToList();
                docModule = ResolveActiveModule(visibleMods);
            }

            if (docModule is not null)
            {
                crumbs.Add(new Crumb(docModule.Name, OnClick: () => isModulePickerOpen = true));
            }

            if (parts.Length == 2)
            {
                crumbs.Add(new Crumb(dtTitle, IsActive: true));
            }
            else
            {
                crumbs.Add(new Crumb(dtTitle, Href: $"/app/{dtName}"));

                var actionOrId = parts[2];
                if (actionOrId.Equals("new", StringComparison.OrdinalIgnoreCase))
                {
                    crumbs.Add(new Crumb("New", IsActive: true));
                }
                else if (actionOrId.Equals("import", StringComparison.OrdinalIgnoreCase))
                {
                    crumbs.Add(new Crumb("Import", IsActive: true));
                }
                else
                {
                    crumbs.Add(new Crumb(Uri.UnescapeDataString(actionOrId), IsActive: true));
                }
            }
            return crumbs;
        }

        if (first == "inbox")
        {
            crumbs.Add(new Crumb("Inbox", IsActive: true));
            return crumbs;
        }

        if (first == "admin")
        {
            if (parts.Length == 1)
            {
                crumbs.Add(new Crumb("Administration", IsActive: true));
                return crumbs;
            }

            var sub = parts[1].ToLowerInvariant();
            switch (sub)
            {
                case "metadata":
                    crumbs.Add(new Crumb("Metadata", Href: "/admin/metadata"));
                    if (parts.Length >= 4 && parts[3].Equals("editor", StringComparison.OrdinalIgnoreCase))
                    {
                        crumbs.Add(new Crumb(Uri.UnescapeDataString(parts[2]), Href: $"/admin/metadata/{parts[2]}"));
                        crumbs.Add(new Crumb("Visual Editor", IsActive: true));
                    }
                    else if (parts.Length >= 3)
                    {
                        var dt = parts[2];
                        if (dt.Equals("new", StringComparison.OrdinalIgnoreCase))
                        {
                            crumbs.Add(new Crumb("New DocType", IsActive: true));
                        }
                        else
                        {
                            crumbs.Add(new Crumb(Uri.UnescapeDataString(dt), IsActive: true));
                        }
                    }
                    else
                    {
                        crumbs[^1] = crumbs[^1] with { Href = null, IsActive = true };
                    }
                    break;

                case "dashboards":
                    crumbs.Add(new Crumb("Dashboards", Href: "/admin/dashboards"));
                    if (parts.Length >= 3)
                    {
                        crumbs.Add(new Crumb(parts[2].Equals("new", StringComparison.OrdinalIgnoreCase) ? "New" : "Editor", IsActive: true));
                    }
                    else
                    {
                        crumbs[^1] = crumbs[^1] with { Href = null, IsActive = true };
                    }
                    break;

                case "widgets":
                    crumbs.Add(new Crumb("Widgets", Href: "/admin/widgets"));
                    if (parts.Length >= 3)
                    {
                        crumbs.Add(new Crumb(parts[2].Equals("new", StringComparison.OrdinalIgnoreCase) ? "New" : "Builder", IsActive: true));
                    }
                    else
                    {
                        crumbs[^1] = crumbs[^1] with { Href = null, IsActive = true };
                    }
                    break;

                case "workflows":
                    crumbs.Add(new Crumb("Workflows", Href: "/admin/workflows"));
                    if (parts.Length >= 4 && parts[3].Equals("editor", StringComparison.OrdinalIgnoreCase))
                    {
                        crumbs.Add(new Crumb(Uri.UnescapeDataString(parts[2]), Href: "/admin/workflows"));
                        crumbs.Add(new Crumb("Editor", IsActive: true));
                    }
                    else if (parts.Length >= 3)
                    {
                        crumbs.Add(new Crumb(parts[2].Equals("new", StringComparison.OrdinalIgnoreCase) ? "New" : Uri.UnescapeDataString(parts[2]), IsActive: true));
                    }
                    else
                    {
                        crumbs[^1] = crumbs[^1] with { Href = null, IsActive = true };
                    }
                    break;

                case "users":
                    crumbs.Add(new Crumb("Users", IsActive: true));
                    break;

                case "roles":
                    crumbs.Add(new Crumb("Roles", IsActive: true));
                    break;

                case "modules":
                    crumbs.Add(new Crumb("Modules", IsActive: true));
                    break;

                case "jobs":
                    crumbs.Add(new Crumb("Background Jobs", IsActive: true));
                    break;

                case "error-logs":
                    crumbs.Add(new Crumb("Error Logs", IsActive: true));
                    break;

                case "report-templates":
                    crumbs.Add(new Crumb("Report Templates", Href: "/admin/report-templates"));
                    if (parts.Length >= 4 && parts[3].Equals("edit", StringComparison.OrdinalIgnoreCase))
                    {
                        crumbs.Add(new Crumb(Uri.UnescapeDataString(parts[2]), Href: $"/admin/report-templates/{parts[2]}"));
                        crumbs.Add(new Crumb("Editor", IsActive: true));
                    }
                    else if (parts.Length >= 3)
                    {
                        crumbs.Add(new Crumb(parts[2].Equals("new", StringComparison.OrdinalIgnoreCase) ? "New" : Uri.UnescapeDataString(parts[2]), IsActive: true));
                    }
                    else
                    {
                        crumbs[^1] = crumbs[^1] with { Href = null, IsActive = true };
                    }
                    break;

                default:
                    crumbs.Add(new Crumb(ToTitleCase(sub), IsActive: true));
                    break;
            }
            return crumbs;
        }

        if (first == "reports")
        {
            if (parts.Length >= 2)
            {
                crumbs.Add(new Crumb("Reports", Href: "/reports"));
                crumbs.Add(new Crumb(Uri.UnescapeDataString(parts[1]), IsActive: true));
            }
            else
            {
                crumbs.Add(new Crumb("Reports", IsActive: true));
            }
            return crumbs;
        }

        if (first == "query-apis")
        {
            if (parts.Length >= 2)
            {
                crumbs.Add(new Crumb("Query APIs", Href: "/query-apis"));
                crumbs.Add(new Crumb(parts[1].Equals("new", StringComparison.OrdinalIgnoreCase) ? "New" : "Builder", IsActive: true));
            }
            else
            {
                crumbs.Add(new Crumb("Query APIs", IsActive: true));
            }
            return crumbs;
        }

        for (var i = 0; i < parts.Length; i++)
        {
            var isLast = i == parts.Length - 1;
            var path = string.Join('/', parts.Take(i + 1));
            crumbs.Add(new Crumb(ToTitleCase(parts[i]), isLast ? null : $"/{path}", IsActive: isLast));
        }

        return crumbs;
    }

    private static string ToTitleCase(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return text;
        var words = text.Replace('-', ' ').Replace('_', ' ').Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Join(' ', words.Select(w => char.ToUpperInvariant(w[0]) + (w.Length > 1 ? w[1..].ToLowerInvariant() : "")));
    }

    private static string Initials(string name) => string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => p[0]));

    public void Dispose()
    {
        Current.Changed -= OnUserChanged;
        Current.ModuleChanged -= OnModuleChanged;
        MenuStore.Changed -= OnMenusChanged;
        T.Changed -= OnLanguageChanged;
        Nav.LocationChanged -= OnLocationChanged;
        timer?.Dispose();
        dotNetRef?.Dispose();
    }

    private void OnLanguageChanged() => _ = InvokeAsync(StateHasChanged);
}

@typeparam TData where TData : class
@inject UiText T

<BbDataGridTemplateColumn TData="TData" Id="_select" Title="" Width="3rem" Hideable="false" Resizable="false">
    <HeaderTemplate>
        <div @onclick:stopPropagation="true">
            <BbCheckbox Checked="@Grid.IsAllSelected(Items)"
                        Indeterminate="@Grid.IsSomeSelected(Items)"
                        CheckedChanged="v => Grid.ToggleSelectAll(Items, v)"
                        AriaLabel="@(T["Select all"])" />
        </div>
    </HeaderTemplate>
    <ChildContent Context="item">
        <div @onclick:stopPropagation="true">
            <BbCheckbox Checked="@Grid.IsSelected(item)"
                        CheckedChanged="v => Grid.ToggleSelect(item, v)"
                        AriaLabel="@(T.Format("Select {0}", Grid.KeyOf(item)))" />
        </div>
    </ChildContent>
</BbDataGridTemplateColumn>

@code {
    [Parameter, EditorRequired] public DataGridPreferenceManager<TData> Grid { get; set; } = default!;
    [Parameter] public IEnumerable<TData>? Items { get; set; }
}

@* Generic lookup dialog: displays a list of documents for any DocType in a table.
   Columns, search columns, and sort order are taken from the target DocType's listView metadata.
   Data is fetched via DocumentService.ListAsync, so tenant, row scope, and field permissions still apply. *@
@inject DocumentService Docs
@inject CurrentUser Current
@inject IMetadataProvider Metadata

<BbDialog Open="Open" OpenChanged="OnOpenChanged">
    <BbDialogContent Class="lookup-dialog">
        <BbDialogHeader>
            <BbDialogTitle>@(Title ?? $"Select {TargetMeta?.Title.ToLower()}")</BbDialogTitle>
            <BbDialogDescription>
                @(Multiple ? "Select one or more rows, then click Select." : "Click a row to select.")
            </BbDialogDescription>
        </BbDialogHeader>

        @if (Open && TargetMeta is not null)
        {
            <div class="lookup-search">
                <BbInput Value="@search" ValueChanged="OnSearch" UpdateTiming="UpdateTiming.Debounced" DebounceInterval="300"
                         Placeholder="@($"Search {string.Join(" / ", TargetMeta.Def.ListView.SearchFields.Select(LabelOf))}…")" AriaLabel="Search" />
            </div>

            @if (error is not null)
            {
                <BbAlert Variant="AlertVariant.Danger"><BbAlertDescription>@error</BbAlertDescription></BbAlert>
            }
            else if (result is null)
            {
                <div class="stack"><BbSkeleton Height="2.25rem" /><BbSkeleton Height="2.25rem" /><BbSkeleton Height="2.25rem" /></div>
            }
            else if (result.Items.Count == 0)
            {
                <BbEmpty Title="No data found" Description="Try a different search keyword." Size="EmptySize.Small" />
            }
            else
            {
                <div class="table-wrap lookup-table">
                    <table class="data">
                        <thead>
                            <tr>
                                @if (Multiple) { <th style="width:2.5rem"><span class="sr-only">Select</span></th> }
                                <th>Name</th>
                                @foreach (var c in result.Columns) { <th class="@(IsNum(c) ? "num" : "")">@LabelOf(c)</th> }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in result.Items)
                            {
                                var name = (string)row["name"]!;
                                var isSelected = selected.ContainsKey(name);
                                var isExcluded = Exclude?.Contains(name) == true;
                                <tr class="clickable @(isSelected ? "selected" : "") @(isExcluded ? "excluded" : "")"
                                    aria-selected="@isSelected" @onclick="() => RowClicked(row)">
                                    @if (Multiple)
                                    {
                                        <td @onclick:stopPropagation="true">
                                            <BbCheckbox Checked="isSelected" Disabled="isExcluded" AriaLabel="@($"Select {name}")"
                                                        CheckedChanged="v => Toggle(row, v)" />
                                        </td>
                                    }
                                    <td class="nowrap"><strong>@name</strong></td>
                                    @foreach (var c in result.Columns)
                                    {
                                        <td class="@(IsNum(c) ? "num" : "")">@Fmt.Value(TargetMeta.ByName.GetValueOrDefault(c), row.GetValueOrDefault(c))</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="list-foot">
                    <span class="muted small">@(result.TotalCapped ? $"{result.Total:N0}+" : result.Total.ToString("N0")) records@(Multiple && selected.Count > 0 ? $" · {selected.Count} selected" : "")</span>
                    @if (TotalPages > 1)
                    {
                        <BbPagination TotalPages="TotalPages" CurrentPage="result.Page" CurrentPageChanged="Load" />
                    }
                </div>
            }
        }

        <BbDialogFooter>
            <BbButton Variant="ButtonVariant.Outline" OnClick="() => OnOpenChanged(false)">Cancel</BbButton>
            @if (Multiple)
            {
                <BbButton Disabled="@(selected.Count == 0)" OnClick="Confirm">Select @(selected.Count > 0 ? $"({selected.Count})" : "")</BbButton>
            }
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

@code {
    /// <summary>DocType displayed, e.g. "Product" or "Employee".</summary>
    [Parameter, EditorRequired] public string Target { get; set; } = "";
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public bool Multiple { get; set; }
    [Parameter] public string? Title { get; set; }
    /// <summary>Fixed filters, e.g. only active employees: [new("active", "=", true)].</summary>
    [Parameter] public IReadOnlyList<FilterClause>? Filters { get; set; }
    /// <summary>Document names that cannot be selected again (e.g. products already in the table).</summary>
    [Parameter] public IReadOnlySet<string>? Exclude { get; set; }
    /// <summary>Selected rows (contains list view columns + "name"). Use name to load full document if needed.</summary>
    [Parameter] public EventCallback<IReadOnlyList<Dictionary<string, object?>>> OnSelected { get; set; }
    [Parameter] public int PageSize { get; set; } = 10;

    private CompiledDocType? TargetMeta;
    private ListResponse? result;
    private string? search, error;
    private bool wasOpen;
    private readonly Dictionary<string, Dictionary<string, object?>> selected = new();

    private int TotalPages => result is null ? 0 : (int)Math.Ceiling(result.Total / (double)result.PageSize);
    private bool IsNum(string c) => TargetMeta!.ByName.GetValueOrDefault(c)?.Type.Editor == "number";
    private string LabelOf(string f) => f == "name" ? "Name" : TargetMeta!.ByName.TryGetValue(f, out var cf) ? cf.Label : f;

    protected override async Task OnParametersSetAsync()
    {
        Metadata.Current.TryGet(Target, out TargetMeta);
        // Setiap kali dialog dibuka: reset pilihan & pencarian, muat halaman pertama.
        if (Open && !wasOpen)
        {
            selected.Clear(); search = null; result = null;
            await Load(1);
        }
        wasOpen = Open;
    }

    private Task OnSearch(string? v) { search = v; return Load(1); }

    private async Task Load(int page)
    {
        try
        {
            error = null;
            result = await Docs.ListAsync(Current.Required, Target, new ListRequest(Filters, search, null, null, page, PageSize), allowAllReadableFields: true);
        }
        catch (Exception ex) when (ex is PermissionDeniedException or InvalidPayloadException or DocumentNotFoundException)
        {
            error = ex.Message;
        }
    }

    private async Task RowClicked(Dictionary<string, object?> row)
    {
        var name = (string)row["name"]!;
        if (Exclude?.Contains(name) == true) return;
        if (Multiple) { Toggle(row, !selected.ContainsKey(name)); return; }
        await OnSelected.InvokeAsync([row]);
        await OnOpenChanged(false);
    }

    private void Toggle(Dictionary<string, object?> row, bool on)
    {
        var name = (string)row["name"]!;
        if (on) selected[name] = row; else selected.Remove(name);
    }

    private async Task Confirm()
    {
        await OnSelected.InvokeAsync(selected.Values.ToList());
        await OnOpenChanged(false);
    }

    private async Task OnOpenChanged(bool open)
    {
        Open = open; wasOpen = open;
        await OpenChanged.InvokeAsync(open);
    }
}

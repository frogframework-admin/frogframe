@if (Entries.Count == 0)
{
    <BbEmpty Title="No history yet" Description="Changes and status transitions will be recorded here." Size="EmptySize.Small" />
}
else
{
    <BbTimeline Align="TimelineAlign.Left">
        @for (var i = 0; i < Entries.Count; i++)
        {
            var e = Entries[i];
            <BbTimelineItem Status="TimelineStatus.Completed" IconColor="@Color(e)" ShowConnector="@(i < Entries.Count - 1)">
                <BbTimelineContent>
                    <BbTimelineHeader>
                        <BbTimelineTitle><strong>@e.Actor</strong> @Describe(e)</BbTimelineTitle>
                        <BbTimelineTime>@Fmt.When(e.At)</BbTimelineTime>
                    </BbTimelineHeader>
                    @if (!string.IsNullOrWhiteSpace(e.Comment))
                    {
                        <p class="comment">@e.Comment</p>
                    }
                    @if (e.Changes.Count > 0)
                    {
                        <ul class="changes">
                            @foreach (var c in e.Changes)
                            {
                                <li><span class="f">@c.Field</span>
                                    @if (c.Old is not null) { <del>@c.Old</del> <span aria-hidden="true"> › </span> }
                                    <ins>@(c.New ?? "empty")</ins></li>
                            }
                        </ul>
                    }
                    <BbTimelineDescription>schema v@(e.SchemaVersion)@(e.WorkflowVersion is { } wv ? $" · workflow v{wv}" : "")</BbTimelineDescription>
                </BbTimelineContent>
            </BbTimelineItem>
        }
    </BbTimeline>
}

@code {
    [Parameter] public IReadOnlyList<AuditEntry> Entries { get; set; } = [];

    private static TimelineColor Color(AuditEntry e) => e.ToState switch
    {
        "Ditolak" or "Dibatalkan" or "Cancelled" or "Rejected" => TimelineColor.Destructive,
        null => TimelineColor.Muted,
        _ => TimelineColor.Primary
    };

    private static string Describe(AuditEntry e) => e.ToState is not null
        ? $"executed “{e.Action}”: {e.FromState} → {e.ToState}"
        : e.Action.ToLowerInvariant() switch
        {
            "dibuat" or "created" => "created document",
            "diubah" or "updated" or "modified" => "updated document",
            "amend" or "amended" => "created amendment",
            "dihapus" or "deleted" => "deleted document",
            "dicetak" or "printed" => "printed document",
            var a => a
        };
}

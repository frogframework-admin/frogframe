@using Framework.Communication
@using Framework.Expressions
@* Renderer field: memetakan kategori editor IFieldType ke komponen BlazorBlueprint.
   Tipe kustom dengan editor yang tidak dikenal jatuh ke input teks. *@

@switch (Field.Type.Editor)
{
    // ---------------- layout-only fields (no value) ----------------
    case "html":
        <div class="field-html" id="@Id">@((MarkupString)(HtmlContentSanitizer.Sanitize(Field.Def.Content) ?? ""))</div>
        break;
    case "heading":
        <div class="field-heading" id="@Id">
            <h3 style="margin:.5rem 0 .15rem 0;font-size:1rem;font-weight:600">@Field.Label</h3>
            @if (!string.IsNullOrWhiteSpace(Field.Def.Content)) { <p class="muted small" style="margin:0">@Field.Def.Content</p> }
        </div>
        break;
    case "button":
        <BbButton Variant="ButtonVariant.Outline" Disabled="@(ReadOnly || !OnButton.HasDelegate)" OnClick="() => OnButton.InvokeAsync(Field)"
                  AdditionalAttributes="IdAttr">
            <LucideIcon Name="play" Size="15" /> @Field.Label
        </BbButton>
        break;

    // ---------------- files ----------------
    case "image":
        <ImageUpload Field="Field" DocType="@(DocType ?? string.Empty)" Value="@(Value as string)" ValueChanged="ValueChanged" ReadOnly="@(ReadOnly || DocType is null)" Compact="Compact" Id="@Id" />
        break;
    case "attach":
        <AttachUpload Field="Field" DocType="@(DocType ?? string.Empty)" Value="@(Value as string)" ValueChanged="ValueChanged" ReadOnly="@(ReadOnly || DocType is null)" Compact="Compact" Id="@Id" />
        break;

    // ---------------- rich display even when read-only ----------------
    case "signature" when ReadOnly:
        @if (Value is string svg && svg.Length > 0)
        {
            <img class="field-signature" src="@SvgDataUri(svg)" alt="@($"{Field.Label} (signature)")" style="max-height:6rem;max-width:100%" />
        }
        else { <div class="field-static" id="@Id" aria-readonly="true">—</div> }
        break;
    case "texteditor" when ReadOnly:
        <div class="field-static field-rich" id="@Id" aria-readonly="true">@((MarkupString)(HtmlContentSanitizer.Sanitize(Value as string) ?? "—"))</div>
        break;
    case "barcode" when ReadOnly && Value is string barcodeText && barcodeText.Length > 0:
        <BbBarcode Value="@barcodeText" Type="Symbology" Height="3rem" AriaLabel="@Field.Label" />
        break;
    case "rating" when ReadOnly:
        <BbRating Value="@RatingValue" Max="RatingMax" AllowHalf="true" ReadOnly="true" AriaLabel="@Field.Label" />
        break;
    case "color" when ReadOnly && Value is string hex && hex.Length > 0:
        <div class="field-static" id="@Id" aria-readonly="true" style="display:flex;align-items:center;gap:.5rem">
            <span style="display:inline-block;width:1.1rem;height:1.1rem;border-radius:.25rem;border:1px solid var(--bb-border);background:@hex"></span>@hex
        </div>
        break;
    case "geolocation" when ReadOnly && GeolocationFieldType.Parse(Value) is { } geo:
        <div class="field-static" id="@Id" aria-readonly="true">
            @Fmt.Value(Field, Value)
            <a href="@($"https://www.openstreetmap.org/?mlat={Inv(geo.Lat)}&mlon={Inv(geo.Lng)}#map=16/{Inv(geo.Lat)}/{Inv(geo.Lng)}")" target="_blank" rel="noopener noreferrer" class="small" style="margin-left:.5rem">Open map</a>
        </div>
        break;

    // ---------------- static rendering for read-only values ----------------
    case var _ when (ReadOnly && Field.Type.Editor is not "check") || Field.Type.Editor == "readonly":
        <div class="field-static @(Field.Type.Editor is "number" or "percent" or "duration" ? "num" : "") @(Field.Type.Editor is "markdown" or "json" ? "pre" : "")"
             id="@Id" aria-readonly="true" style="@(Field.Type.Editor is "markdown" or "json" ? "white-space:pre-wrap" : null)">@Static()</div>
        break;

    // ---------------- original editors ----------------
    case "textarea":
        <FormTextArea Id="@Id" Value="@Fmt.Raw(Value)" ValueChanged="Emit" Invalid="@Invalid" MaxLength="@Field.Def.MaxLength"
                      AriaLabel="@(Compact ? Field.Label : null)" Rows="@(Compact ? 1 : 3)" />
        break;
    case "number":
        <FormTextInput Id="@Id" Value="@Fmt.Raw(Value)" ValueChanged="v => Emit(CleanNumber(v))" Invalid="@Invalid"
                       Placeholder="@(Field.Def.Type == "Currency" ? "0" : null)" AriaLabel="@(Compact ? Field.Label : null)"
                       AdditionalAttributes="NumericAttrs" />
        break;
    case "check":
        <div class="label-row">
            <BbCheckbox Id="@Id" Checked="@(Value is true)" CheckedChanged="v => Emit(v)" Disabled="@ReadOnly" AriaLabel="@Field.Label" />
            @if (!Compact) { <BbLabel For="@Id">@Field.Label</BbLabel> }
        </div>
        break;
    case "date":
        <div class="fill-trigger">
            <BbDatePicker Value="@AsDate(Value)" ValueChanged="SetDate" DateFormat="d MMM yyyy"
                          IsInvalid="@Invalid" AriaLabel="@Field.Label" AdditionalAttributes="IdAttr" />
        </div>
        break;
    case "select":
        <BbSelect TValue="string" Value="@(Value as string)" ValueChanged="v => Emit(v)" AriaLabel="@Field.Label"
                  Options="@(Field.Def.Options!.Select(o => new SelectOption<string>(o, o)))" Placeholder="Select…"
                  AdditionalAttributes="IdAttr" />
        break;
    case "link":
        <div class="fill-trigger">
            <LinkInput Id="@Id" Target="@(Field.Def.LinkTo!)" Value="@(Value as string)" Label="@Field.Label" ShowLookup="@Field.Def.LookupDialog" ValueChanged="v => Emit(v)"
                       LookupFilters="@(Field.Def.LinkFilters.Count > 0 ? Framework.Metadata.LinkFilters.ToClauses(Field.Def.LinkFilters) : null)" />
        </div>
        break;

    // ---------------- Gap #3 editors ----------------
    case "datetime":
        <div class="fill-trigger">
            <BbDateTimePicker Value="@LocalDateTime" ValueChanged="SetDateTime" DateTimeFormat="d MMM yyyy HH:mm" TimeFormat="TimeFormat.Hour24"
                              AriaLabel="@Field.Label" AdditionalAttributes="IdAttr" />
        </div>
        break;
    case "time":
        <BbTimeInput Id="@Id" Value="@TimeFieldType.ToTimeSpan(Value)" ValueChanged="SetTime" Format="TimeFormat.Hour24" />
        break;
    case "duration":
        <FormTextInput Id="@Id" Value="@(Value is long or decimal ? DurationFieldType.Display((long)(Values.ToDecimal(Value) ?? 0)) : Fmt.Raw(Value))"
                       ValueChanged="Emit" Invalid="@Invalid" Placeholder="e.g. 1h 30m or 01:30:00" AriaLabel="@(Compact ? Field.Label : null)" />
        break;
    case "percent":
        <div style="display:flex;align-items:center;gap:.35rem">
            <FormTextInput Id="@Id" Value="@Fmt.Raw(Value)" ValueChanged="v => Emit(CleanNumber(v))" Invalid="@Invalid"
                           AriaLabel="@(Compact ? Field.Label : null)" AdditionalAttributes="NumericAttrs" />
            <span class="muted" aria-hidden="true">%</span>
        </div>
        break;
    case "phone":
        <FormTextInput Id="@Id" Type="tel" Value="@Fmt.Raw(Value)" ValueChanged="Emit" Invalid="@Invalid" Placeholder="+62 812 3456 7890"
                       AriaLabel="@(Compact ? Field.Label : null)" AdditionalAttributes="TelAttrs" />
        break;
    case "password":
        <FormTextInput Id="@Id" Type="password" Value="" ValueChanged="SetPassword" Invalid="@Invalid"
                       Placeholder="@(Value is string { Length: > 0 } ? "Stored · type to replace" : null)"
                       AriaLabel="@(Compact ? Field.Label : null)" AdditionalAttributes="PasswordAttrs" />
        break;
    case "texteditor":
        <BbRichTextEditor Id="@Id" Value="@(Value as string)" ValueChanged="v => Emit(v)" Toolbar="ToolbarPreset.Standard"
                          MinHeight="160px" AriaLabel="@Field.Label" AriaInvalid="@(Invalid ? true : null)" />
        break;
    case "markdown":
        <BbMarkdownEditor Id="@Id" Value="@(Value as string)" ValueChanged="v => Emit(v)" MinHeight="160px"
                          AriaLabel="@Field.Label" AriaInvalid="@(Invalid ? true : null)" />
        break;
    case "json":
        <FormTextArea Id="@Id" Value="@PrettyJson(Value)" ValueChanged="Emit" Invalid="@Invalid" Rows="@(Compact ? 2 : 8)"
                      AriaLabel="@(Compact ? Field.Label : null)" AdditionalAttributes="MonoAttrs" />
        break;
    case "dynamiclink":
        @if (DynamicTarget is { } target)
        {
            <div class="fill-trigger">
                @* key: a new target DocType resets the search component *@
                <LinkInput @key="target" Id="@Id" Target="@target" Value="@(Value as string)" Label="@Field.Label" ValueChanged="v => Emit(v)" />
            </div>
        }
        else
        {
            <div class="field-static muted" id="@Id">Choose @(LinkToFieldLabel) first</div>
        }
        break;
    case "multiselect":
        <MultiLinkInput Id="@Id" Target="@(Field.Def.LinkTo!)" Label="@Field.Label" Values="@TableMultiSelectFieldType.Items(Value)"
                        ValuesChanged="v => Emit(v.ToList())" />
        break;
    case "rating":
        <BbRating Value="@RatingValue" ValueChanged="v => Emit((decimal)v)" Max="RatingMax" AllowHalf="true" AllowClear="true" AriaLabel="@Field.Label" />
        break;
    case "color":
        <BbColorPicker Value="@(Value as string ?? "#000000")" ValueChanged="v => Emit(v)" Format="ColorFormat.Hex" ShowPresets="true" />
        break;
    case "signature":
        <BbSignature Value="@SignatureValueOf(Value)" ValueChanged="v => Emit(v is null || v.IsEmpty ? null : v.Svg)" Label="@Field.Label" />
        break;
    case "barcode":
        <div class="stack" style="gap:.35rem">
            <FormTextInput Id="@Id" Value="@Fmt.Raw(Value)" ValueChanged="Emit" Invalid="@Invalid" AriaLabel="@(Compact ? Field.Label : null)" />
            @if (!Compact && Value is string bc && bc.Length > 0) { <BbBarcode Value="@bc" Type="Symbology" Height="3rem" AriaLabel="@Field.Label" /> }
        </div>
        break;
    case "geolocation":
        <div style="display:flex;gap:.35rem;align-items:center">
            <FormTextInput Id="@Id" Value="@(GeolocationFieldType.Parse(Value) is { } g1 ? Inv(g1.Lat) : null)" ValueChanged="SetLatitude"
                           Placeholder="Latitude" AriaLabel="@($"{Field.Label} latitude")" AdditionalAttributes="NumericAttrs" />
            <FormTextInput Value="@(GeolocationFieldType.Parse(Value) is { } g2 ? Inv(g2.Lng) : null)" ValueChanged="SetLongitude"
                           Placeholder="Longitude" AriaLabel="@($"{Field.Label} longitude")" AdditionalAttributes="NumericAttrs" />
        </div>
        break;

    default:
        <FormTextInput Id="@Id" Type="@(Field.Def.Type == "Email" ? "email" : "text")" Value="@Fmt.Raw(Value)" ValueChanged="Emit"
                       Invalid="@Invalid" AriaLabel="@(Compact ? Field.Label : null)"
                       AdditionalAttributes="@(new Dictionary<string, object> { ["maxlength"] = Field.Def.MaxLength ?? 140 })" />
        break;
}

@code {
    [Parameter, EditorRequired] public CompiledField Field { get; set; } = default!;
    [Parameter] public object? Value { get; set; }
    [Parameter] public EventCallback<object?> ValueChanged { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool Invalid { get; set; }
    [Parameter] public bool Compact { get; set; }
    [Parameter] public string? Id { get; set; }
    /// <summary>DocType pemilik field (dibutuhkan untuk unggah gambar/file).</summary>
    [Parameter] public string? DocType { get; set; }
    /// <summary>Data dokumen/baris saat ini (DynamicLink membaca DocType tujuan dari field lain).</summary>
    [Parameter] public IReadOnlyDictionary<string, object?>? Data { get; set; }
    /// <summary>Dipanggil saat field Button diklik.</summary>
    [Parameter] public EventCallback<CompiledField> OnButton { get; set; }

    private Dictionary<string, object> IdAttr => Id is null ? new() : new() { ["id"] = Id };
    private static readonly Dictionary<string, object> NumericAttrs = new() { ["inputmode"] = "decimal", ["style"] = "text-align:right" };
    private static readonly Dictionary<string, object> TelAttrs = new() { ["inputmode"] = "tel", ["autocomplete"] = "tel", ["maxlength"] = 32 };
    private static readonly Dictionary<string, object> PasswordAttrs = new() { ["autocomplete"] = "new-password", ["maxlength"] = PasswordFieldType.MaxLength };
    private static readonly Dictionary<string, object> MonoAttrs = new() { ["style"] = "font-family:ui-monospace,Consolas,monospace;font-size:.8125rem", ["spellcheck"] = "false" };

    private static DateTime? AsDate(object? v) =>
        v is string s && DateTime.TryParseExact(s, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var d) ? d : null;

    private string? CleanNumber(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return null;
        var s = raw.Replace(" ", "").Replace("Rp", "").Replace("%", "");
        // Currency/Int: titik = pemisah ribuan (format Indonesia). Float/Percent: koma diterima sebagai desimal.
        if (Field.Def.Type is "Currency" or "Int") s = s.Replace(".", "");
        return s.Replace(',', '.');
    }

    private Task Emit(object? raw)
    {
        var n = Field.Type.Normalize(raw);
        return ValueChanged.InvokeAsync(n.Ok ? n.Value : raw);
    }
    // ---- Client Scripts: Select options narrowed by a script (Form.SetOptions), cascaded by the form page.
    [CascadingParameter] public ClientScriptFormState? ScriptFormState { get; set; }
    private CompiledField? scriptSource;
    private IReadOnlyList<string>? scriptOptions;
    private CompiledField? scriptField;

    protected override void OnParametersSet()
    {
        if (ScriptFormState is null || DocType is null || !string.Equals(ScriptFormState.DocType, DocType, StringComparison.Ordinal)) return;
        if (!ScriptFormState.Options.TryGetValue(Field.Name, out var options)) return;
        // Field is the shared compiled metadata: render a copy whose options are narrowed (cached per options list).
        if (!ReferenceEquals(scriptSource, Field) || !ReferenceEquals(scriptOptions, options) || scriptField is null)
        {
            scriptSource = Field;
            scriptOptions = options;
            scriptField = ClientScriptFormState.WithOptions(Field, options);
        }
        Field = scriptField;
    }

    private Task Emit(string? raw) => Emit((object?)raw);
    private Task SetDate(DateTime? d) => Emit(d?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture));

    // ---- Datetime: shown and edited in the default time zone (Asia/Jakarta), stored in UTC.
    private DateTime? LocalDateTime => DatetimeFieldType.ToZone(Value)?.DateTime;
    private Task SetDateTime(DateTime? d) => Emit(d is { } x ? DateTime.SpecifyKind(x, DateTimeKind.Unspecified).ToString("yyyy-MM-ddTHH:mm:ss", CultureInfo.InvariantCulture) : null);

    private Task SetTime(TimeSpan? t) => Emit(t is { } x ? TimeOnly.FromTimeSpan(x).ToString("HH:mm:ss", CultureInfo.InvariantCulture) : null);

    // ---- Password: an empty input keeps the stored value (the server never sends it back).
    private Task SetPassword(string? v) => string.IsNullOrEmpty(v) ? Task.CompletedTask : Emit(v);

    // ---- Rating
    private double RatingValue => (double)(Values.ToDecimal(Value) ?? 0m);
    private int RatingMax => Field.Def.Max is { } m && m >= 1 && m <= 10 ? (int)m : 5;

    // ---- Barcode symbology from Options[0]
    private BlazorBlueprint.Primitives.Barcode.BarcodeType Symbology =>
        Field.Def.Options is { Count: > 0 } o && Enum.TryParse<BlazorBlueprint.Primitives.Barcode.BarcodeType>(o[0], out var t)
            ? t : BlazorBlueprint.Primitives.Barcode.BarcodeType.Code128;

    // ---- Signature: always rendered through <img> so scripts inside SVG never run.
    private static string SvgDataUri(string svg) => "data:image/svg+xml;base64," + Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(svg));
    private static SignatureValue? SignatureValueOf(object? v) =>
        v is string svg && svg.Length > 0 ? new SignatureValue { Kind = SignatureKind.Drawn, Svg = svg } : null;

    // ---- DynamicLink
    private string? DynamicTarget => Field.Def.LinkToField is { } tf && Data?.GetValueOrDefault(tf) is string t && t.Length > 0 ? t : null;
    private string LinkToFieldLabel => Field.Def.LinkToField ?? "the document type";

    // ---- Geolocation: two inputs, stored as "lat,lng"
    private static string Inv(decimal d) => d.ToString("0.######", CultureInfo.InvariantCulture);
    private Task SetLatitude(string? v) => SetGeo(v, GeolocationFieldType.Parse(Value)?.Lng.ToString(CultureInfo.InvariantCulture));
    private Task SetLongitude(string? v) => SetGeo(GeolocationFieldType.Parse(Value)?.Lat.ToString(CultureInfo.InvariantCulture), v);
    private Task SetGeo(string? lat, string? lng)
    {
        if (string.IsNullOrWhiteSpace(lat) && string.IsNullOrWhiteSpace(lng)) return Emit((string?)null);
        return Emit($"{(lat ?? "").Replace(',', '.').Trim()},{(lng ?? "").Replace(',', '.').Trim()}");
    }

    private static string? PrettyJson(object? v)
    {
        if (v is not string s || s.Length == 0) return null;
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(s);
            return System.Text.Json.JsonSerializer.Serialize(doc.RootElement, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch (System.Text.Json.JsonException) { return s; }
    }

    private string Static() => Fmt.Value(Field, Value);
}

@* Link field: BbCombobox with server-side search (tenant- & permission-aware via DocumentService). *@
@inject DocumentService Docs
@inject CurrentUser Current
@inject UiText T
@inject IMetadataProvider LinkMetadata
@implements IDisposable

<div class="link-row">
    <BbCombobox TValue="string" Value="@Value" ValueChanged="Pick" Options="options" SearchQuery="@query" SearchQueryChanged="Search"
                Placeholder="@(T.Format("Select {0}…", Label.ToLowerInvariant()))" SearchPlaceholder="@(T.Format("Search {0}…", TargetTitle))"
                EmptyMessage="@(loading ? T["Searching…"] : T.Format("No matching {0} found", TargetTitle))" SelectedItemText="@SelectedText"
                IsLoading="loading" AriaLabel="@Label" MatchTriggerWidth="true" AdditionalAttributes="IdAttr" />
    @if (ShowLookup)
    {
        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Icon" AriaLabel="@(T.Format("Select {0} from list", Label))" OnClick="() => lookupOpen = true">
            <LucideIcon Name="list" Size="16" />
        </BbButton>
        <LookupDialog Target="@Target" @bind-Open="lookupOpen" Title="@(T.Format("Select {0}", Label.ToLowerInvariant()))" Filters="LookupFilters"
                      OnSelected="PickFirst" />
    }
</div>

@code {
    private string TargetTitle => LinkMetadata.Current.TryGet(Target, out var tm) ? T.Title(tm) : Target;
    [Parameter] public string? Id { get; set; }
    [Parameter, EditorRequired] public string Target { get; set; } = "";
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    /// <summary>Show button that opens LookupDialog (metadata: "lookupDialog": true).</summary>
    [Parameter] public bool ShowLookup { get; set; }
    [Parameter] public IReadOnlyList<FilterClause>? LookupFilters { get; set; }

    private bool lookupOpen;

    private List<SelectOption<string>> options = [];
    private readonly Dictionary<string, string> titles = new();
    private string query = "";
    private bool loading;
    private CancellationTokenSource? cts;

    private Dictionary<string, object> IdAttr => Id is null ? new() : new() { ["id"] = Id };
    private string? SelectedText => Value is null ? null : titles.TryGetValue(Value, out var t) ? $"{Value} · {t}" : Value;

    protected override async Task OnInitializedAsync() => await Load("");

    protected override async Task OnParametersSetAsync()
    {
        // Pastikan judul nilai terpilih tersedia meski tidak ada di hasil pencarian terakhir.
        if (Value is not null && !titles.ContainsKey(Value)) await Load(Value);
    }

    private async Task Search(string q)
    {
        query = q;
        cts?.Cancel();
        cts = new CancellationTokenSource();
        var token = cts.Token;
        try
        {
            await Task.Delay(200, token);
            await Load(q, token);
        }
        catch (OperationCanceledException) { }
    }

    private async Task Load(string q, CancellationToken ct = default)
    {
        loading = true;
        try
        {
            var found = await Docs.SearchLinkAsync(Current.Required, Target, q, ct, filters: LookupFilters);
            foreach (var f in found) titles[f.Name] = f.Title ?? "";
            options = found.Select(f => new SelectOption<string>(f.Name, string.IsNullOrEmpty(f.Title) ? f.Name : $"{f.Name} · {f.Title}")).ToList();
        }
        catch (PermissionDeniedException) { options = []; }
        catch (Exception) { options = []; }
        finally { loading = false; }
    }

    private Task Pick(string? v) => ValueChanged.InvokeAsync(v);

    private Task PickFirst(IReadOnlyList<Dictionary<string, object?>> rows) =>
        rows.Count > 0 ? Pick(rows[0]["name"] as string) : Task.CompletedTask;

    public void Dispose() => cts?.Cancel();
}

@* Reusable icon picker dropdown displaying Lucide icon glyphs + names with live search. *@
@using BlazorBlueprint.Icons.Lucide.Components

<div class="icon-picker-container" style="position:relative;width:100%">
    <button type="button"
            id="@Id"
            class="icon-picker-trigger @(Disabled ? "disabled" : "")"
            disabled="@Disabled"
            aria-expanded="@(isOpen ? "true" : "false")"
            aria-haspopup="listbox"
            @onclick="ToggleDropdown">
        <div style="display:flex;align-items:center;gap:.5rem;overflow:hidden;flex:1">
            <div class="icon-picker-preview">
                <LucideIcon Name="@(string.IsNullOrWhiteSpace(Value) ? "image" : Value)" Size="16" />
            </div>
            <span class="icon-picker-label @(string.IsNullOrWhiteSpace(Value) ? "muted" : "")">
                @(string.IsNullOrWhiteSpace(Value) ? Placeholder : Value)
            </span>
        </div>
        <div style="display:flex;align-items:center;gap:.25rem;flex-shrink:0;color:var(--muted-foreground)">
            @if (!string.IsNullOrWhiteSpace(Value) && !Disabled)
            {
                <span role="button" tabindex="0" class="icon-picker-clear" title="Clear icon" @onclick="ClearIcon" @onclick:stopPropagation="true">
                    <LucideIcon Name="x" Size="13" />
                </span>
            }
            <LucideIcon Name="chevron-down" Size="14" class="@(isOpen ? "rotate-180" : "")" style="transition:transform .15s ease" />
        </div>
    </button>

    @if (isOpen)
    {
        <div class="icon-picker-backdrop" @onclick="CloseDropdown" @onclick:stopPropagation="true"></div>

        <div class="icon-picker-dropdown" @onclick:stopPropagation="true">
            <div class="icon-picker-search">
                <LucideIcon Name="search" Size="14" style="color:var(--muted-foreground);flex-shrink:0" />
                <input type="text"
                       class="icon-picker-search-input"
                       placeholder="Search icon (e.g. cart, user, settings)..."
                       value="@searchTerm"
                       @oninput="OnSearchInput"
                       autofocus />
                @if (!string.IsNullOrEmpty(searchTerm))
                {
                    <span role="button" tabindex="0" style="cursor:pointer;color:var(--muted-foreground)" @onclick="() => searchTerm = string.Empty">
                        <LucideIcon Name="x" Size="13" />
                    </span>
                }
            </div>

            <div class="icon-picker-list">
                @if (!string.IsNullOrWhiteSpace(searchTerm) && !FilteredIcons.Contains(searchTerm.Trim().ToLowerInvariant()))
                {
                    var custom = searchTerm.Trim().ToLowerInvariant();
                    <button type="button"
                            class="icon-picker-option custom-option @(Value == custom ? "is-selected" : "")"
                            @onclick="() => SelectIcon(custom)">
                        <LucideIcon Name="@custom" Size="16" />
                        <span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">Use "<strong>@custom</strong>"</span>
                    </button>
                }

                @foreach (var icon in FilteredIcons)
                {
                    <button type="button"
                            class="icon-picker-option @(icon == Value ? "is-selected" : "")"
                            @onclick="() => SelectIcon(icon)">
                        <LucideIcon Name="@icon" Size="16" />
                        <span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@icon</span>
                        @if (icon == Value)
                        {
                            <LucideIcon Name="check" Size="13" style="margin-left:auto;color:var(--primary);flex-shrink:0" />
                        }
                    </button>
                }

                @if (FilteredIcons.Count == 0 && string.IsNullOrWhiteSpace(searchTerm))
                {
                    <div style="padding:1rem;text-align:center;color:var(--muted-foreground);font-size:.8125rem">
                        No icons available.
                    </div>
                }
            </div>
        </div>
    }
</div>

<style>
    .icon-picker-trigger {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .5rem;
        width: 100%;
        height: 2.5rem;
        padding: 0 .75rem;
        border-radius: var(--radius, 6px);
        border: 1px solid var(--border);
        background: var(--background);
        color: var(--foreground);
        font-size: .875rem;
        text-align: left;
        cursor: pointer;
        transition: border-color .15s ease, box-shadow .15s ease;
    }
    .icon-picker-trigger:hover:not(:disabled) {
        border-color: var(--border-hover, var(--ring, #94a3b8));
    }
    .icon-picker-trigger:focus-visible {
        outline: none;
        border-color: var(--ring);
        box-shadow: 0 0 0 2px var(--ring);
    }
    .icon-picker-trigger.disabled,
    .icon-picker-trigger:disabled {
        opacity: .5;
        cursor: not-allowed;
    }
    .icon-picker-preview {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 1.5rem;
        height: 1.5rem;
        border-radius: calc(var(--radius, 6px) - 2px);
        background: var(--muted);
        color: var(--foreground);
        flex-shrink: 0;
    }
    .icon-picker-label {
        font-size: .875rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .icon-picker-label.muted {
        color: var(--muted-foreground);
    }
    .icon-picker-clear {
        padding: 2px;
        border-radius: 4px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .icon-picker-clear:hover {
        background: var(--muted);
        color: var(--foreground);
    }
    .icon-picker-backdrop {
        position: fixed;
        inset: 0;
        z-index: 998;
        cursor: default;
    }
    .icon-picker-dropdown {
        position: absolute;
        top: calc(100% + 4px);
        left: 0;
        right: 0;
        z-index: 999;
        background: var(--popover, #fff);
        color: var(--popover-foreground, inherit);
        border: 1px solid var(--border);
        border-radius: var(--radius, 6px);
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.15), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
        padding: 6px;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }
    .icon-picker-search {
        display: flex;
        align-items: center;
        gap: .35rem;
        padding: 4px 8px;
        border: 1px solid var(--border);
        border-radius: calc(var(--radius, 6px) - 2px);
        background: var(--background);
    }
    .icon-picker-search-input {
        width: 100%;
        border: none;
        outline: none;
        background: transparent;
        font-size: .8125rem;
        color: var(--foreground);
    }
    .icon-picker-search-input::placeholder {
        color: var(--muted-foreground);
    }
    .icon-picker-list {
        max-height: 220px;
        overflow-y: auto;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 4px;
        padding: 2px;
    }
    .icon-picker-option {
        display: flex;
        align-items: center;
        gap: .5rem;
        padding: .4rem .5rem;
        border-radius: calc(var(--radius, 6px) - 2px);
        font-size: .8125rem;
        color: var(--foreground);
        background: transparent;
        border: 1px solid transparent;
        cursor: pointer;
        text-align: left;
        transition: background .12s ease, border-color .12s ease;
    }
    .icon-picker-option:hover {
        background: var(--accent);
        color: var(--accent-foreground);
    }
    .icon-picker-option.is-selected {
        background: var(--accent);
        color: var(--accent-foreground);
        font-weight: 500;
        border-color: var(--border);
    }
    .icon-picker-option.custom-option {
        grid-column: 1 / -1;
        border-bottom: 1px dashed var(--border);
        padding-bottom: .5rem;
        margin-bottom: .25rem;
    }
    .rotate-180 {
        transform: rotate(180deg);
    }
</style>

@code {
    [Parameter] public string? Id { get; set; }
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Select an icon...";
    [Parameter] public bool Disabled { get; set; }

    private bool isOpen;
    private string searchTerm = "";

    private static readonly string[] DefaultIcons = [
        // Navigation & Dashboard
        "layout-grid", "layout-dashboard", "layout-list", "layout-template", "menu", "house", "home",
        "settings", "settings-2", "sliders", "sliders-horizontal", "sliders-vertical", "wrench",
        "search", "scan-search", "scan", "filter", "bell", "bell-ring", "bell-plus",
        "help-circle", "info", "alert-circle", "alert-triangle", "check", "check-circle", "circle-check",
        "zap", "activity", "sparkles", "wand-sparkles", "star", "bookmark", "flag",
        // Identity & Security
        "users", "user", "user-check", "user-plus", "user-cog", "user-circle",
        "shield", "shield-check", "shield-alert", "shield-plus", "lock", "lock-open",
        "key", "key-round", "fingerprint",
        // Business, Sales & CRM
        "shopping-cart", "shopping-bag", "store", "briefcase", "building", "building-2",
        "contact", "phone", "mail", "send", "inbox", "message-square", "message-circle",
        // Finance & Accounting
        "wallet", "credit-card", "banknote", "receipt", "coins", "dollar-sign",
        "badge-dollar-sign", "calculator", "landmark", "scale", "percent",
        // Analytics & Reports
        "chart-column", "chart-bar", "chart-pie", "chart-line", "chart-no-axes-column",
        "trending-up", "trending-down", "presentation",
        // Inventory, Warehouse & Logistics
        "package", "package-check", "package-search", "package-plus", "box", "boxes",
        "truck", "warehouse", "container", "barcode", "qr-code", "tag", "tags",
        // Documents & Office
        "file-text", "file", "files", "file-spreadsheet", "file-plus", "file-check",
        "file-down", "file-up", "folder", "folder-open", "folder-tree", "folder-kanban",
        "clipboard", "clipboard-list", "clipboard-check", "printer", "archive",
        // Time & Workflow
        "calendar", "calendar-days", "clock", "history", "timer", "stamp",
        "workflow", "git-branch", "git-branch-plus", "git-commit", "layers",
        // System & Data
        "database", "server", "hard-drive", "cpu", "network", "terminal", "code",
        "link", "external-link", "refresh-cw", "rotate-ccw", "upload", "download"
    ];

    private IReadOnlyList<string> FilteredIcons =>
        string.IsNullOrWhiteSpace(searchTerm)
            ? DefaultIcons
            : DefaultIcons.Where(i => i.Contains(searchTerm.Trim(), StringComparison.OrdinalIgnoreCase)).ToList();

    private void ToggleDropdown()
    {
        if (Disabled) return;
        isOpen = !isOpen;
        if (isOpen)
        {
            searchTerm = "";
        }
    }

    private void CloseDropdown()
    {
        isOpen = false;
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";
    }

    private async Task SelectIcon(string icon)
    {
        Value = icon;
        isOpen = false;
        await ValueChanged.InvokeAsync(icon);
    }

    private async Task ClearIcon()
    {
        Value = null;
        await ValueChanged.InvokeAsync(null);
    }
}

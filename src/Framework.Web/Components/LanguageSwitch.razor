@* UI language switcher (Indonesian/English). Updates UiText immediately in the active circuit
   and persists the selection to cookie and user preferences without reloading the page. *@
@inject UiText T
@inject IJSRuntime JS

<span class="lang-switch" role="group" aria-label="@(T["Language"])">
    @foreach (var (langCode, name) in Languages.Supported)
    {
        var active = langCode == T.Language;
        <button type="button" class="lang-switch-item @(active ? "active" : "")" title="@name" lang="@langCode"
                aria-pressed="@(active ? "true" : "false")" @onclick="() => SelectAsync(langCode)">@langCode.ToUpperInvariant()</button>
    }
</span>

@code {
    private async Task SelectAsync(string code)
    {
        if (!T.SetLanguage(code)) return;
        try { await JS.InvokeVoidAsync("frogframe.setLanguage", code); }
        catch { /* ignore in non-interactive or disconnected circuits */ }
    }
}

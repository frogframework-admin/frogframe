@* Pilihan bahasa UI (Indonesia/Inggris). Memuat ulang halaman lewat /ui/language/{code}, yang menyimpan pilihan
   di cookie dan di preferensi pengguna, karena bahasa sebuah sirkuit Blazor ditentukan saat sirkuit dibuat. *@
@inject UiText T
@inject NavigationManager Nav

<span class="lang-switch" role="group" aria-label="@(T["Language"])">
    @foreach (var (langCode, name) in Languages.Supported)
    {
        var active = langCode == T.Language;
        <a href="@Href(langCode)" class="lang-switch-item @(active ? "active" : "")" title="@name" lang="@langCode"
           aria-current="@(active ? "true" : null)" data-enhance-nav="false">@langCode.ToUpperInvariant()</a>
    }
</span>

@code {
    private string Href(string code)
    {
        var relative = "/" + Nav.ToBaseRelativePath(Nav.Uri);
        return $"/ui/language/{code}?returnUrl={Uri.EscapeDataString(relative)}";
    }
}

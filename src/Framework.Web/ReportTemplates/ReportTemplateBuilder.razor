@page "/report-templates/new"
@page "/admin/report-templates/new"
@page "/report-templates/{TemplateId}/edit"
@page "/admin/report-templates/{TemplateId}/edit"
@using Framework.Dashboards
@using Framework.Reports
@using Microsoft.AspNetCore.Components.Forms
@inject ReportTemplateService Reports
@inject RoleCatalog RoleCatalogSvc
@inject IMetadataProvider Metadata
@inject CurrentUser Current
@inject ToastService Toasts
@inject NavigationManager Nav

<PageTitle>@(isEdit ? "Edit report template" : "New report template") · DocFrame</PageTitle>

<BbBreadcrumb Class="crumbs">
    <BbBreadcrumbList>
        <BbBreadcrumbItem><BbBreadcrumbLink Href="/admin/report-templates">Excel/Word Reports</BbBreadcrumbLink></BbBreadcrumbItem>
        <BbBreadcrumbSeparator />
        <BbBreadcrumbItem><BbBreadcrumbPage>@(isEdit ? def.Name : "New")</BbBreadcrumbPage></BbBreadcrumbItem>
    </BbBreadcrumbList>
</BbBreadcrumb>

@if (!ReportTemplateService.CanDesign(Current.Required))
{
    <BbAlert Variant="AlertVariant.Danger"><BbAlertDescription>Designing report templates is restricted to System Managers / Administrators.</BbAlertDescription></BbAlert>
}
else if (!Reports.IsAvailable)
{
    <UnavailableNotice />
}
else
{
    <header class="page-head">
        <div>
            <h1>@(isEdit ? $"Edit: {def.Name}" : "New report template")</h1>
            <p>SQL query (read-only, tenant-isolated) → parameters → tagged Excel/Word template → report files.</p>
        </div>
    </header>

    <ol class="wizard-steps" aria-label="Steps">
        @foreach (var (n, title) in Steps)
        {
            var num = n;
            <li class="@(step == num ? "current" : num < step ? "done" : "")">
                <button type="button" disabled="@(num > maxStep)" @onclick="() => GoTo(num)" aria-current="@(step == num ? "step" : null)">
                    <span class="step-num">@(num < step ? "✓" : num.ToString())</span><span>@title</span>
                </button>
            </li>
        }
    </ol>

    @if (error is not null)
    {
        <BbAlert Variant="AlertVariant.Danger" Class="props-block"><BbAlertTitle>@errorTitle</BbAlertTitle><BbAlertDescription><span class="pre">@error</span></BbAlertDescription></BbAlert>
    }

    @switch (step)
    {
        case 1:
            <div class="builder-grid builder-grid-equal">
                <BbCard Class="builder-card-left">
                    <BbCardHeader>
                        <BbCardTitle Class="card-title">1. Data query</BbCardTitle>
                        <BbCardDescription>Single SELECT statement per query. Write parameters as <code>@@ParamName</code>. Optional filter: <code>(@@Dept IS NULL OR department = @@Dept)</code>.</BbCardDescription>
                    </BbCardHeader>
                    <BbCardContent Class="builder-card-content" Style="overflow-y:auto;scrollbar-width:thin">
                        <div class="stack" style="padding-bottom:.5rem">
                            <BbField>
                                <BbFieldLabel For="sql">Detail query — rows populate <code>[[Column]]</code> tags</BbFieldLabel>
                                <FormTextArea Id="sql" Value="@def.Config.Sql" ValueChanged="v => def.Config.Sql = v ?? string.Empty" Rows="8" />
                            </BbField>
                            <BbField>
                                <BbFieldLabel For="header-sql">Header query (optional, single row) — populates <code>{{Column}}</code> tags</BbFieldLabel>
                                <FormTextArea Id="header-sql" Value="@def.Config.HeaderSql" ValueChanged="v => def.Config.HeaderSql = string.IsNullOrWhiteSpace(v) ? null : v" Rows="3" />
                                <BbFieldDescription>For company name, period, or grand totals appearing once. Without a header query, {{Column}} is taken from the first row of the detail query.</BbFieldDescription>
                            </BbField>
                        </div>
                    </BbCardContent>
                    <BbCardFooter Class="builder-card-footer">
                        <BbButton OnClick="Detect"><LucideIcon Name="scan-search" Size="16" /> Next: detect parameters</BbButton>
                    </BbCardFooter>
                </BbCard>
                <BbCard Class="builder-card-right">
                    <BbCardHeader><BbCardTitle Class="card-title">Available views</BbCardTitle><BbCardDescription>Click to insert into detail query.</BbCardDescription></BbCardHeader>
                    <BbCardContent Class="builder-card-content">
                        <div class="catalog-search" style="margin-bottom:.65rem;flex-shrink:0">
                            <BbInputGroup>
                                <BbInputGroupAddon Align="InputGroupAlign.InlineStart">
                                    <LucideIcon Name="search" Size="15" />
                                </BbInputGroupAddon>
                                <BbInputGroupInput Value="@viewSearch" ValueChanged="v => viewSearch = v"
                                                   UpdateTiming="UpdateTiming.Debounced" DebounceInterval="150"
                                                   Placeholder="Search views or columns…" AriaLabel="Search views" />
                                @if (!string.IsNullOrWhiteSpace(viewSearch))
                                {
                                    <BbInputGroupAddon Align="InputGroupAlign.InlineEnd">
                                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="search-clear-btn"
                                                  OnClick="() => viewSearch = null" AriaLabel="Clear search">
                                            <LucideIcon Name="x" Size="13" />
                                        </BbButton>
                                    </BbInputGroupAddon>
                                }
                            </BbInputGroup>
                        </div>
                        <div class="catalog">
                            @foreach (var v in FilteredViews)
                            {
                                var view = v;
                                var isOpen = !string.IsNullOrWhiteSpace(viewSearch);
                                <details open="@(isOpen ? true : null)">
                                    <summary><button type="button" class="catalog-insert" @onclick="() => Insert(view.Name)" @onclick:stopPropagation="true"><code>@view.Name</code></button><span class="muted small">@view.Title</span></summary>
                                    <ul>@foreach (var (col, type) in view.Columns) { var c = col; <li><button type="button" class="catalog-insert" @onclick="() => Insert(c)"><code>@c</code></button><span class="muted small">@type</span></li> }</ul>
                                </details>
                            }
                            @if (!FilteredViews.Any())
                            {
                                <p class="muted small" style="padding:1rem 0;text-align:center">No views or columns match "@viewSearch".</p>
                            }
                        </div>
                    </BbCardContent>
                </BbCard>
            </div>
            break;

        case 2:
            <BbCard>
                <BbCardHeader>
                    <BbCardTitle Class="card-title">2. Parameters &amp; data preview</BbCardTitle>
                    <BbCardDescription>@(def.Config.Parameters.Count == 0 ? "Query does not use parameters." : "Default values are used for preview and prefilled when users generate reports.")</BbCardDescription>
                </BbCardHeader>
                <BbCardContent>
                    @if (def.Config.Parameters.Count > 0)
                    {
                        <div class="table-wrap">
                            <table class="perm-table">
                                <thead><tr><th>Parameter</th><th>Label</th><th>Type</th><th>Default value</th><th>Value source</th></tr></thead>
                                <tbody>
                                    @foreach (var prm in def.Config.Parameters)
                                    {
                                        var p = prm;
                                        <tr>
                                            <td><code>@@@p.Name</code></td>
                                            <td style="min-width:9rem"><FormTextInput Value="@p.Label" ValueChanged="v => p.Label = v ?? p.Name" AriaLabel="@($"Label {p.Name}")" /></td>
                                            <td style="min-width:8rem"><BbSelect TValue="string" Value="@p.Type" ValueChanged="v => { p.Type = v ?? ParamTypes.Text; p.DefaultValue = null; }" Options="TypeOptions" AriaLabel="@($"Type {p.Name}")" /></td>
                                            <td style="min-width:11rem">
                                                <FormTextInput Id="@($"pv-{p.Name}")" Type="@(p.Type == ParamTypes.Date ? "date" : p.Type == ParamTypes.Number ? "number" : "text")" Value="@p.DefaultValue"
                                                               ValueChanged="v => p.DefaultValue = string.IsNullOrWhiteSpace(v) ? null : v" AriaLabel="@($"Value {p.Name}")" Placeholder="@(p.Type == ParamTypes.Boolean ? "true / false" : null)" />
                                            </td>
                                            <td style="min-width:14rem"><BbSelect TValue="string" Value="@p.Binding" ValueChanged="v => p.Binding = v ?? ParamBindings.Default" Options="BindingOptions(p)" AriaLabel="@($"Source {p.Name}")" /></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    <div class="row" style="margin:.75rem 0">
                        <BbButton Disabled="busy" OnClick="RunPreview"><LucideIcon Name="play" Size="16" /> @(busy ? "Running…" : "Run preview")</BbButton>
                        <BbButton Variant="ButtonVariant.Ghost" OnClick="() => GoTo(1)">Back to query</BbButton>
                        <span class="spacer"></span>
                        <BbButton Disabled="@(preview is null)" OnClick="() => GoTo(3)">Next: template <LucideIcon Name="arrow-right" Size="16" /></BbButton>
                    </div>
                    @if (preview?.Header is { } h)
                    {
                        <div class="props-sub" style="margin-bottom:.35rem">Header query</div>
                        <ResultGrid Result="h" MaxHeight="8rem" />
                        <div class="props-sub" style="margin:.75rem 0 .35rem">Detail query</div>
                    }
                    @if (preview is not null) { <ResultGrid Result="preview.Detail" ShowFooter="true" /> }
                </BbCardContent>
            </BbCard>
            break;

        case 3:
            <div class="builder-grid builder-grid-equal">
                <BbCard Class="builder-card-left">
                    <BbCardHeader>
                        <BbCardTitle Class="card-title">3. Template</BbCardTitle>
                        <BbCardDescription>Tag <code>{{Name}}</code> = single value · <code>[[Column]]</code> = repeated row per record · <code>[[No]]</code> row index · <code>{{Sum:Column}}</code> grand total · optional <code>|format</code>, e.g. <code>{{Date|dd MMMM yyyy}}</code>.</BbCardDescription>
                    </BbCardHeader>
                    <BbCardContent Class="builder-card-content" Style="overflow-y:auto;scrollbar-width:thin">
                        <div class="chart-types" role="radiogroup" aria-label="File format" style="grid-template-columns:repeat(2,minmax(0,1fr))">
                            @foreach (var (fmt, label, icon) in new[] { (ReportFormats.Xlsx, "Excel (.xlsx)", "file-spreadsheet"), (ReportFormats.Docx, "Word (.docx)", "file-text") })
                            {
                                var f = fmt;
                                <button type="button" role="radio" aria-checked="@(def.Config.Format == f)" class="chart-type @(def.Config.Format == f ? "selected" : "")" @onclick="() => SetFormat(f)">
                                    <LucideIcon Name="@icon" Size="28" /><span>@label</span>
                                </button>
                            }
                        </div>
                        <div class="stack" style="margin-top:1rem">
                            <div>
                                <div class="props-sub" style="margin-bottom:.35rem">Don't have a template yet?</div>
                                <a class="bb-like-button" href="@StarterUrl" download="@($"template-{Slug(def.Name)}.{def.Config.Format}")"><LucideIcon Name="wand-sparkles" Size="16" /> Download starter template with all tags</a>
                                <p class="muted small" style="margin:.35rem 0 0">Open in Excel/Word, adjust layout (logo, colors, columns), save, and upload below.</p>
                            </div>
                            <div>
                                <div class="props-sub" style="margin-bottom:.35rem">Upload template (.@def.Config.Format, max. 5 MB)</div>
                                <label class="image-pick">
                                    <InputFile id="template-file" accept="@($".{def.Config.Format}")" OnChange="Upload" />
                                    <LucideIcon Name="upload" Size="15" /> @(templateName is null ? "Choose file" : "Change file")
                                </label>
                                @if (templateName is not null) { <span class="muted small" style="margin-left:.5rem">@templateName</span> }
                            </div>
                        </div>
                    </BbCardContent>
                </BbCard>
                <BbCard Class="builder-card-right">
                    <BbCardHeader><BbCardTitle Class="card-title">Tag validation</BbCardTitle><BbCardDescription>Each tag is matched against parameters, query columns, and system tags.</BbCardDescription></BbCardHeader>
                    <BbCardContent Class="builder-card-content" Style="overflow-y:auto;scrollbar-width:thin">
                        @if (check is null)
                        {
                            <div class="chart-empty"><span>Upload template to validate</span></div>
                        }
                        else
                        {
                            @if (check.Problems.Count > 0)
                            {
                                <BbAlert Variant="AlertVariant.Danger" Class="props-block"><BbAlertTitle>@check.Problems.Count issues</BbAlertTitle><BbAlertDescription><ul class="error-list">@foreach (var p in check.Problems) { <li>@p</li> }</ul></BbAlertDescription></BbAlert>
                            }
                            else
                            {
                                <BbAlert Variant="AlertVariant.Success" Class="props-block"><BbAlertDescription>All @check.Tags.Count tags matched.</BbAlertDescription></BbAlert>
                            }
                            <div class="result-grid" style="flex:1;min-height:8rem;overflow-y:auto">
                                <table class="data">
                                    <thead><tr><th>Tag</th><th>Kind</th><th>Location</th></tr></thead>
                                    <tbody>@foreach (var t in check.Tags.Take(200)) { <tr><td><code>@t.Raw</code></td><td>@KindLabel(t.Kind)</td><td class="muted">@t.Location</td></tr> }</tbody>
                                </table>
                            </div>
                            <div class="row" style="margin-top:.75rem">
                                <BbButton Variant="ButtonVariant.Outline" Disabled="@(busy || check.Problems.Count > 0)" OnClick="TryRender"><LucideIcon Name="file-down" Size="16" /> Test generate file (preview data)</BbButton>
                                @if (tryUrl is not null) { <a href="@tryUrl" download="@tryName" class="small">Download test output: @tryName</a> }
                            </div>
                        }
                    </BbCardContent>
                    <BbCardFooter Class="builder-card-footer">
                        <BbButton Variant="ButtonVariant.Ghost" OnClick="() => GoTo(2)">Back</BbButton>
                        <span class="spacer"></span>
                        <BbButton Disabled="@(check is not { Problems.Count: 0 })" OnClick="() => GoTo(4)">Next: save <LucideIcon Name="arrow-right" Size="16" /></BbButton>
                    </BbCardFooter>
                </BbCard>
            </div>
            break;

        case 4:
            <BbCard>
                <BbCardHeader><BbCardTitle Class="card-title">4. Save</BbCardTitle></BbCardHeader>
                <BbCardContent>
                    <div class="stack" style="max-width:40rem">
                        <BbField><BbFieldLabel For="r-name">Report name</BbFieldLabel><FormTextInput Id="r-name" Value="@def.Name" ValueChanged="v => def.Name = v ?? string.Empty" /></BbField>
                        <BbField><BbFieldLabel For="r-desc">Description</BbFieldLabel><FormTextArea Id="r-desc" Value="@def.Description" ValueChanged="v => def.Description = string.IsNullOrWhiteSpace(v) ? null : v" Rows="2" /></BbField>
                        <BbField>
                            <BbFieldLabel For="r-file">File name pattern</BbFieldLabel>
                            <FormTextInput Id="r-file" Value="@def.Config.FileNamePattern" ValueChanged="v => def.Config.FileNamePattern = v ?? string.Empty" Placeholder="e.g. Payroll Summary {{Period}}" />
                            <BbFieldDescription>Single value tags allowed. .@def.Config.Format extension is added automatically.</BbFieldDescription>
                        </BbField>
                        <div>
                            <div class="props-sub" style="margin-bottom:.4rem">Can be generated by (empty = all users)</div>
                            <div class="wf-roles">
                                @foreach (var role in MetadataRoles.Known(Metadata.Current, def.Config.Roles, RoleCatalogSvc.Names(Current.Required.TenantId)))
                                {
                                    var r = role;
                                    <div class="label-row"><BbCheckbox Id="@($"r-{r}")" Checked="def.Config.Roles.Contains(r)" CheckedChanged="v => ToggleRole(r, v)" /><BbLabel For="@($"r-{r}")">@r</BbLabel></div>
                                }
                            </div>
                            <p class="muted small" style="margin-top:.4rem">Reports include tenant-wide data ("own records" restriction does not apply in SQL). Restrict roles for sensitive data.</p>
                        </div>
                        <Framework.Web.QueryApis.PublishAsApiOption Option="apiOption" DefaultName="@def.Name" />
                        <div class="row">
                            <BbButton Variant="ButtonVariant.Ghost" OnClick="() => GoTo(3)">Back</BbButton>
                            <span class="spacer"></span>
                            <BbButton Disabled="@(busy || string.IsNullOrWhiteSpace(def.Name))" OnClick="Save"><LucideIcon Name="save" Size="16" /> @(busy ? "Saving…" : "Save template")</BbButton>
                        </div>
                    </div>
                </BbCardContent>
            </BbCard>
            break;
    }
}

@code {
    [Parameter] public string? TemplateId { get; set; }

    private static readonly (int, string)[] Steps = [(1, "Query"), (2, "Parameters & preview"), (3, "Template"), (4, "Save")];
    private ReportTemplateDef def = new();
    private readonly Framework.Web.QueryApis.ApiPublishOption apiOption = new();
    [Inject] private Framework.Api.QueryApiService QueryApis { get; set; } = default!;
    private int step = 1, maxStep = 1;
    private bool isEdit, busy;
    private string? error, errorTitle, loadedKey, viewSearch;
    private ReportPreview? preview;
    private byte[]? template;        // active template (new upload or existing template being edited)
    private bool templateIsNew;
    private string? templateName;
    private TemplateCheck? check;
    private string? tryUrl, tryName;

    private IEnumerable<ReportingView> FilteredViews
    {
        get
        {
            var all = ReportingCatalog.Describe(Metadata.Current);
            if (string.IsNullOrWhiteSpace(viewSearch))
                return all;

            var q = viewSearch.Trim();
            return all.Where(v =>
                v.Name.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                v.Title.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                v.Columns.Any(c => c.Column.Contains(q, StringComparison.OrdinalIgnoreCase) || c.Type.Contains(q, StringComparison.OrdinalIgnoreCase)));
        }
    }

    private static readonly IEnumerable<SelectOption<string>> TypeOptions =
        [new(ParamTypes.Text, "Text"), new(ParamTypes.Number, "Number"), new(ParamTypes.Date, "Date"), new(ParamTypes.Boolean, "Boolean")];

    private static IEnumerable<SelectOption<string>> BindingOptions(WidgetParameter p)
    {
        yield return new(ParamBindings.Default, "Filled when generating report");
        if (p.Type == ParamTypes.Text) { yield return new(ParamBindings.UserDepartment, "User's department"); yield return new(ParamBindings.UserId, "User ID"); }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (TemplateId == loadedKey && loadedKey is not null) return;
        loadedKey = TemplateId ?? "";
        if (TemplateId is null || !ReportTemplateService.CanDesign(Current.Required)) return;
        if (await Reports.GetAsync(Current.Required, TemplateId) is not { } d) { (errorTitle, error) = ("Not found", "Report template not found."); return; }
        def = d; isEdit = true; maxStep = 2;
        template = await Reports.GetTemplateFileAsync(Current.Required, d.Id);
        templateName = d.TemplateFileName;
        await apiOption.LoadAsync(QueryApis, Current.Required, $"report:{d.Id}");
    }

    private void GoTo(int n) { if (n <= maxStep) { step = n; error = null; } }

    private void Insert(string text)
    {
        var sql = def.Config.Sql.TrimEnd();
        def.Config.Sql = sql + (sql.Length == 0 ? "" : " ") + text;
    }

    private void Detect()
    {
        error = null;
        var (err, ps) = ReportTemplateService.DetectParameters(def.Config.Sql, def.Config.HeaderSql, def.Config.Parameters);
        if (err is not null) { (errorTitle, error) = ("Query cannot be used yet", err); return; }
        def.Config.Parameters = ps;
        preview = null; check = null;
        step = maxStep = 2;
    }

    private async Task RunPreview()
    {
        error = null; busy = true;
        try
        {
            preview = await Reports.PreviewAsync(Current.Required, def.Config);
            maxStep = Math.Max(maxStep, 3);
            Recheck();
        }
        catch (Exception ex) when (ex is QueryRejectedException or ReportingUnavailableException)
        {
            preview = null; maxStep = 2;
            (errorTitle, error) = ("Query execution failed", ex.Message);
        }
        finally { busy = false; }
    }

    private string StarterUrl => preview is null ? "#"
        : $"data:{ReportFormats.ContentType(def.Config.Format)};base64,{Convert.ToBase64String(ReportTemplateService.Starter(def.Config, string.IsNullOrWhiteSpace(def.Name) ? "Report" : def.Name, preview))}";

    private void SetFormat(string f)
    {
        if (def.Config.Format == f) return;
        def.Config.Format = f;
        if (template is not null) { template = null; templateName = null; templateIsNew = false; check = null; tryUrl = null; }
    }

    private async Task Upload(InputFileChangeEventArgs e)
    {
        error = null; tryUrl = null;
        if (e.File.Size > OoxmlPackage.MaxTemplateBytes) { (errorTitle, error) = ("File too large", "Template maximum size is 5 MB."); return; }
        await using var s = e.File.OpenReadStream(OoxmlPackage.MaxTemplateBytes);
        using var ms = new MemoryStream();
        await s.CopyToAsync(ms);
        template = ms.ToArray(); templateIsNew = true; templateName = e.File.Name;
        Recheck();
    }

    private void Recheck()
    {
        check = template is null || preview is null ? null : ReportTemplateService.CheckTemplate(def.Config, template, preview);
        if (check is { Problems.Count: 0 }) maxStep = Math.Max(maxStep, 4);
    }

    private async Task TryRender()
    {
        error = null; busy = true;
        try
        {
            var output = await Reports.TryRenderAsync(Current.Required, string.IsNullOrWhiteSpace(def.Name) ? "test" : def.Name, def.Config, template!);
            (tryUrl, tryName) = ($"data:{output.ContentType};base64,{Convert.ToBase64String(output.Content)}", output.FileName);
        }
        catch (Exception ex) when (ex is TemplateException or QueryRejectedException or ReportingUnavailableException)
        {
            (errorTitle, error) = ("Test generation failed", ex.Message);
        }
        finally { busy = false; }
    }

    private void ToggleRole(string role, bool on)
    {
        if (on && !def.Config.Roles.Contains(role)) def.Config.Roles.Add(role);
        if (!on) def.Config.Roles.Remove(role);
    }

    private async Task Save()
    {
        error = null; busy = true;
        try
        {
            if (templateIsNew) def.TemplateFileName = templateName ?? "template." + def.Config.Format;
            var saved = await Reports.SaveAsync(Current.Required, def, templateIsNew ? template : null);
            // Option: same detail query published as JSON API.
            var apiNote = await apiOption.ApplyAsync(QueryApis, Current.Required, $"report:{saved.Id}", saved.Name, saved.Description,
                saved.Config.Sql, saved.Config.Parameters, saved.Config.Roles);
            Toasts.Success("Users with access can now generate this report." + (apiNote is null ? "" : " " + apiNote), $"{saved.Name} v{saved.Version} saved");
            Nav.NavigateTo("/admin/report-templates");
        }
        catch (Exception ex) when (ex is TemplateException or QueryRejectedException or ReportingUnavailableException or PermissionDeniedException or Framework.Api.ApiMethodException)
        {
            (errorTitle, error) = (ex is Framework.Api.ApiMethodException ? "Template saved, but API could not be published" : "Template could not be saved", ex.Message);
        }
        finally { busy = false; }
    }

    private static string KindLabel(TagKind k) => k switch { TagKind.Loop => "repeated row", TagKind.Aggregate => "aggregate", _ => "single value" };
    private static string Slug(string s) => string.IsNullOrWhiteSpace(s) ? "report" : System.Text.RegularExpressions.Regex.Replace(s.ToLowerInvariant(), "[^a-z0-9]+", "-").Trim('-');
}

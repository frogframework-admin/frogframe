@page "/admin/menus"
@using Framework.Navigation
@using Framework.Security
@using Framework.Web.Admin
@inject INavigationMenuStore MenuStore
@inject RoleCatalog RoleCatalogSvc
@inject IRoleStore RoleStore
@inject IMetadataProvider Metadata
@inject CurrentUser Current
@inject ToastService Toasts
@inject DialogService Dialogs
@inject Framework.Preferences.IUserPreferenceStore UserPrefs
@implements IDisposable

<PageTitle>Navigation Menus · DocFrame</PageTitle>

@if (!Current.Required.IsAdmin)
{
    <BbAlert Variant="AlertVariant.Danger"><BbAlertDescription>This page is only accessible to Administrators / System Managers.</BbAlertDescription></BbAlert>
}
else
{
    <header class="page-head">
        <div>
            <h1>Navigation Menus</h1>
            <p>Manage application sidebar menus for tenant @Current.Required.TenantId. Each menu belongs to a menu group within a module.</p>
        </div>
        <div class="row" style="gap:.5rem">
            <BbButton Variant="ButtonVariant.Outline" OnClick="ResetDefaults"><LucideIcon Name="rotate-ccw" Size="16" /> Seed Defaults</BbButton>
            <BbButton OnClick="StartCreate"><LucideIcon Name="plus" Size="16" /> Add menu</BbButton>
        </div>
    </header>

    <BbDataGrid @key="gridMgr.RenderKey"
                TData="NavigationMenuItem"
                Items="@menus"
                ShowSearch="true"
                SearchPlaceholder="Search menus..."
                ShowPagination="true"
                InitialPageSize="10"
                TableContainerClass="table-wrap"
                RowClass="@(m => edit?.Id == m.Id ? "selected" : "")"
                Resizable="true"
                OnColumnResize="gridMgr.HandleResize"
                StateChanged="gridMgr.HandleStateChanged">
        <Toolbar>
            <div style="display:flex;align-items:center;gap:.5rem;margin-left:auto">
                @if (gridMgr.HasCustomLayout)
                {
                    <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" OnClick="ResetColumnsLayout" Title="Reset kolom ke bawaan">
                        <LucideIcon Name="rotate-ccw" Size="14" />
                        <span>Reset Kolom</span>
                    </BbButton>
                }
                <BbDataGridColumnVisibility TData="NavigationMenuItem" />
            </div>
        </Toolbar>
        <Columns>
            <BbDataGridPropertyColumn TData="NavigationMenuItem" TProp="int" Property="m => m.SortOrder" Id="order" Title="Order"
                                      Width="@gridMgr.GetWidth("order", "5rem")" Visible="@gridMgr.IsVisible("order")" Resizable="true" Sortable="true">
                <CellTemplate Context="item">
                    <code>@item.SortOrder</code>
                </CellTemplate>
            </BbDataGridPropertyColumn>

            <BbDataGridPropertyColumn TData="NavigationMenuItem" TProp="string" Property="m => m.Title" Id="title" Title="Menu"
                                      Width="@gridMgr.GetWidth("title", "15rem")" Visible="@gridMgr.IsVisible("title")" Resizable="true" Sortable="true" Filterable="true">
                <CellTemplate Context="item">
                    <div class="row" style="gap:.5rem;align-items:center;flex-wrap:nowrap">
                        <LucideIcon Name="@item.Icon" Size="16" />
                        <strong>@item.Title</strong>
                        @if (!string.IsNullOrEmpty(item.BadgeKey))
                        {
                            <span class="muted small" title="Badge: @item.BadgeKey">• badge</span>
                        }
                    </div>
                </CellTemplate>
            </BbDataGridPropertyColumn>

            <BbDataGridPropertyColumn TData="NavigationMenuItem" TProp="string" Property="m => m.Href" Id="href" Title="URL"
                                      Width="@gridMgr.GetWidth("href", "12rem")" Visible="@gridMgr.IsVisible("href")" Resizable="true" Sortable="true" Filterable="true">
                <CellTemplate Context="item">
                    <code>@item.Href</code>
                </CellTemplate>
            </BbDataGridPropertyColumn>

            <BbDataGridTemplateColumn TData="NavigationMenuItem" Id="group" Title="Module &amp; Menu Group"
                                      Width="@gridMgr.GetWidth("group", "14rem")" Visible="@gridMgr.IsVisible("group")" Resizable="true" Sortable="true" SortBy="m => m.GroupName">
                <ChildContent Context="item">
                    @{
                        var grp = ResolveGroup(item);
                        var mod = grp is not null ? modules.FirstOrDefault(x => x.Id == grp.ModuleId) : null;
                    }
                    <div class="row" style="gap:.35rem;flex-wrap:wrap">
                        @if (mod is not null)
                        {
                            <BbBadge Variant="BadgeVariant.Soft">@mod.Name</BbBadge>
                        }
                        <BbBadge Variant="BadgeVariant.Outline">@(grp?.Name ?? item.GroupName)</BbBadge>
                    </div>
                </ChildContent>
            </BbDataGridTemplateColumn>

            <BbDataGridTemplateColumn TData="NavigationMenuItem" Id="roles" Title="Permissions"
                                      Width="@gridMgr.GetWidth("roles")" Visible="@gridMgr.IsVisible("roles")" Resizable="true">
                <ChildContent Context="item">
                    @if (item.AllowedRoles.Count == 0)
                    {
                        <BbBadge Variant="BadgeVariant.SoftSuccess">All Employees</BbBadge>
                    }
                    else
                    {
                        <div class="row" style="gap:.25rem;flex-wrap:wrap">
                            @foreach (var r in item.AllowedRoles)
                            {
                                <BbBadge Variant="BadgeVariant.Soft">@r</BbBadge>
                            }
                        </div>
                    }
                </ChildContent>
            </BbDataGridTemplateColumn>

            <BbDataGridTemplateColumn TData="NavigationMenuItem" Id="status" Title="Status"
                                      Width="@gridMgr.GetWidth("status", "9rem")" Visible="@gridMgr.IsVisible("status")" Resizable="true" Sortable="true" SortBy="m => m.IsActive">
                <ChildContent Context="item">
                    <div class="row" style="gap:.25rem;flex-wrap:nowrap">
                        @if (item.IsSystem)
                        {
                            <BbBadge Variant="BadgeVariant.Soft">System</BbBadge>
                        }
                        @if (item.IsActive)
                        {
                            <BbBadge Variant="BadgeVariant.SoftSuccess">Active</BbBadge>
                        }
                        else
                        {
                            <BbBadge Variant="BadgeVariant.Secondary">Inactive</BbBadge>
                        }
                    </div>
                </ChildContent>
            </BbDataGridTemplateColumn>

            <BbDataGridTemplateColumn TData="NavigationMenuItem" Id="actions" Title="Actions" Width="@gridMgr.GetWidth("actions", "6.5rem")" NoWrap="true" Hideable="false" Resizable="false">
                <ChildContent Context="item">
                    <div style="display:inline-flex;align-items:center;gap:.25rem;flex-wrap:nowrap" @onclick:stopPropagation="true">
                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" AriaLabel="Edit menu" OnClick="() => StartEdit(item)">
                            <LucideIcon Name="pencil" Size="15" />
                        </BbButton>
                        @if (!item.IsSystem)
                        {
                            <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" AriaLabel="Delete menu" OnClick="() => ConfirmDelete(item)">
                                <LucideIcon Name="trash-2" Size="15" />
                            </BbButton>
                        }
                    </div>
                </ChildContent>
            </BbDataGridTemplateColumn>
        </Columns>
        <EmptyTemplate>
            <div style="padding:2rem;text-align:center;color:var(--muted-foreground)">
                No menus found.
            </div>
        </EmptyTemplate>
    </BbDataGrid>

    <AdminDrawer Open="@isDrawerOpen"
                 OpenChanged="@OnDrawerOpenChanged"
                 WidthScale="@DrawerWidthScale"
                 Title="@(edit is null ? "" : isNew ? "Add New Menu" : $"Edit: {edit.Title}")"
                 Description="@(edit is null ? null : edit.IsSystem ? "Built-in system menu (cannot be deleted, but title, icon, menu group, and sort order can be edited)." : "Custom application menu.")">
        <ChildContent>
            @if (edit is not null)
            {
                @if (error is not null)
                {
                    <BbAlert Variant="AlertVariant.Danger"><BbAlertDescription>@error</BbAlertDescription></BbAlert>
                }

                <div class="form-cols cols-2">
                    <BbField>
                        <BbFieldLabel For="m-title">Menu Title</BbFieldLabel>
                        <FormTextInput Id="m-title" Immediate="true" @bind-Value="edit.Title" Placeholder="e.g. Home, Purchasing" />
                    </BbField>

                    <BbField>
                        <BbFieldLabel For="m-order">Order (Sort Order)</BbFieldLabel>
                        <FormTextInput Id="m-order" Type="number" Immediate="true" Value="@edit.SortOrder.ToString()" ValueChanged="v => edit.SortOrder = int.TryParse(v, out var n) ? n : edit.SortOrder" />
                        <BbFieldDescription>Lower numbers appear higher in the list (e.g. 10, 20, 30, etc.).</BbFieldDescription>
                    </BbField>
                </div>

                <div class="form-cols cols-2">
                    <BbField>
                        <BbFieldLabel For="m-href">URL / Path</BbFieldLabel>
                        <FormTextInput Id="m-href" Immediate="true" @bind-Value="edit.Href" Placeholder="e.g. dashboard, admin/users" />
                        <BbFieldDescription>Application relative path, e.g. &quot;dashboard&quot; or &quot;app/Employee&quot;.</BbFieldDescription>
                    </BbField>

                    <BbField>
                        <BbFieldLabel For="m-group">Menu Group (inside Module)</BbFieldLabel>
                        <select id="m-group" class="auth-input" value="@edit.GroupId" @onchange="OnGroupSelected">
                            @foreach (var grp in groups)
                            {
                                var modName = modules.FirstOrDefault(m => m.Id == grp.ModuleId)?.Name ?? "Module";
                                <option value="@grp.Id">@modName — @grp.Name</option>
                            }
                        </select>
                        <BbFieldDescription>Select the menu group where this item will be displayed.</BbFieldDescription>
                    </BbField>
                </div>

                <div class="form-cols cols-2">
                    <BbField>
                        <BbFieldLabel For="m-icon">Lucide Icon</BbFieldLabel>
                        <div class="row" style="gap:.5rem;align-items:center;flex-wrap:nowrap">
                            <FormTextInput Id="m-icon" Immediate="true" @bind-Value="edit.Icon" Placeholder="e.g. house, users, file-text" />
                            <div style="display:flex;align-items:center;justify-content:center;width:2.5rem;height:2.5rem;border:1px solid var(--border);border-radius:var(--radius);background:var(--muted);flex-shrink:0">
                                <LucideIcon Name="@(string.IsNullOrWhiteSpace(edit.Icon) ? "file-text" : edit.Icon)" Size="18" />
                            </div>
                        </div>
                        <BbFieldDescription>Lucide icon name (e.g. house, users, key-round, settings-2).</BbFieldDescription>
                    </BbField>

                    <BbField>
                        <BbFieldLabel For="m-badge">Badge Key (Optional)</BbFieldLabel>
                        <FormTextInput Id="m-badge" Immediate="true" @bind-Value="edit.BadgeKey" Placeholder="e.g. inbox_unread" />
                        <BbFieldDescription>Enter &quot;inbox_unread&quot; to show unread notifications badge.</BbFieldDescription>
                    </BbField>
                </div>

                <div class="props-sub">Access Permissions (Role)</div>
                <p class="muted small">If no roles are selected, the menu will be visible to <strong>All Employees</strong> who have access to the parent module.</p>
                <div class="role-check-grid">
                    @foreach (var r in AvailableRoles)
                    {
                        var role = r;
                        <div class="label-row">
                            <BbCheckbox Id="@($"role-{role}")" Checked="edit.AllowedRoles.Contains(role)" CheckedChanged="v => ToggleRole(role, v)" />
                            <BbLabel For="@($"role-{role}")">@role</BbLabel>
                        </div>
                    }
                </div>

                <div class="label-row" style="margin-top:.5rem">
                    <BbCheckbox Id="m-active" Checked="edit.IsActive" CheckedChanged="v => edit.IsActive = v" />
                    <BbLabel For="m-active">Active (displayed in sidebar)</BbLabel>
                </div>
            }
        </ChildContent>
        <FooterContent>
            @if (edit is not null)
            {
                <div class="row" style="gap:.5rem;width:100%;align-items:center">
                    <BbButton Disabled="busy" Loading="busy" LoadingText="Saving…" OnClick="Save"><LucideIcon Name="check" Size="16" /> Save</BbButton>
                    <BbButton Variant="ButtonVariant.Ghost" OnClick="CloseDrawer">Cancel</BbButton>
                    @if (!isNew && !edit.IsSystem)
                    {
                        <span style="margin-left:auto">
                            <BbButton Variant="ButtonVariant.Destructive" Size="ButtonSize.Small" Disabled="busy" OnClick="() => ConfirmDelete(edit)">
                                <LucideIcon Name="trash-2" Size="15" /> Delete
                            </BbButton>
                        </span>
                    }
                </div>
            }
        </FooterContent>
    </AdminDrawer>
}

@code {
    /// <summary>Configurable drawer width multiplier (default 2.0 = 2x normal width for Menu form).</summary>
    [Parameter] public double DrawerWidthScale { get; set; } = 2.0;

    private IReadOnlyList<NavigationModule> modules = [];
    private IReadOnlyList<NavigationMenuGroup> groups = [];
    private IReadOnlyList<NavigationMenuItem> menus = [];
    private IReadOnlyList<RoleDef> storedRoles = [];
    private NavigationMenuItem? edit;
    private bool isDrawerOpen;
    private bool isNew;
    private bool busy;
    private string? error;
    private Framework.Web.Services.DataGridPreferenceManager<NavigationMenuItem> gridMgr = default!;

    private IEnumerable<string> AvailableRoles => MetadataRoles.Known(Metadata.Current, RoleCatalogSvc.Names(Current.Required.TenantId))
        .Append(UserContext.Administrator)
        .Concat(storedRoles.Select(r => r.Name))
        .Distinct().Order();

    protected override async Task OnInitializedAsync()
    {
        gridMgr = new(UserPrefs, Current, "grid:admin:menus", StateHasChanged);
        if (Current.User is null) return;
        await gridMgr.InitializeAsync();
        storedRoles = await RoleStore.ListAsync(Current.Required.TenantId);
        await Reload();
    }

    private async Task ResetColumnsLayout()
    {
        await gridMgr.ResetAsync();
        Toasts.Success("Tata letak kolom telah dikembalikan ke bawaan.", "Reset Kolom");
    }

    public void Dispose()
    {
        gridMgr?.Dispose();
    }

    private async Task Reload()
    {
        var tenantId = Current.Required.TenantId;
        modules = await MenuStore.ListModulesAsync(tenantId, onlyActive: false);
        groups = await MenuStore.ListGroupsAsync(tenantId, onlyActive: false);
        menus = await MenuStore.ListAsync(tenantId, onlyActive: false);
    }

    private NavigationMenuGroup? ResolveGroup(NavigationMenuItem item) =>
        groups.FirstOrDefault(g => g.Id == item.GroupId)
        ?? groups.FirstOrDefault(g => string.Equals(g.Name, item.GroupName, StringComparison.OrdinalIgnoreCase));

    private void OnGroupSelected(ChangeEventArgs e)
    {
        if (edit is null) return;
        var gid = e.Value as string;
        var grp = groups.FirstOrDefault(g => g.Id == gid);
        if (grp is not null)
        {
            edit.GroupId = grp.Id;
            edit.GroupName = grp.Name;
        }
    }

    private void StartCreate()
    {
        error = null;
        isNew = true;
        var defaultGroup = groups.FirstOrDefault();
        edit = new NavigationMenuItem
        {
            Id = Guid.NewGuid().ToString("N"),
            TenantId = Current.Required.TenantId,
            Title = "",
            Href = "",
            Icon = "file-text",
            GroupId = defaultGroup?.Id,
            GroupName = defaultGroup?.Name ?? "General",
            SortOrder = (menus.Count > 0 ? menus.Max(m => m.SortOrder) + 10 : 100),
            AllowedRoles = [],
            IsActive = true,
            IsSystem = false
        };
        isDrawerOpen = true;
    }

    private void StartEdit(NavigationMenuItem item)
    {
        error = null;
        isNew = false;
        var resolvedGrp = ResolveGroup(item);
        edit = new NavigationMenuItem
        {
            Id = item.Id,
            TenantId = item.TenantId,
            Title = item.Title,
            Href = item.Href,
            Icon = item.Icon,
            GroupId = resolvedGrp?.Id ?? item.GroupId,
            GroupName = resolvedGrp?.Name ?? item.GroupName,
            SortOrder = item.SortOrder,
            AllowedRoles = [.. item.AllowedRoles],
            IsSystem = item.IsSystem,
            IsActive = item.IsActive,
            BadgeKey = item.BadgeKey,
            CreatedAt = item.CreatedAt,
            UpdatedAt = item.UpdatedAt
        };
        isDrawerOpen = true;
    }

    private void CloseDrawer()
    {
        isDrawerOpen = false;
    }

    private void OnDrawerOpenChanged(bool open)
    {
        isDrawerOpen = open;
        if (!open)
        {
            edit = null;
            error = null;
        }
    }

    private void ToggleRole(string role, bool? isChecked)
    {
        if (edit is null) return;
        if (isChecked == true)
        {
            if (!edit.AllowedRoles.Contains(role)) edit.AllowedRoles.Add(role);
        }
        else
        {
            edit.AllowedRoles.Remove(role);
        }
    }

    private async Task Save()
    {
        if (edit is null || busy) return;
        if (string.IsNullOrWhiteSpace(edit.Title))
        {
            error = "Menu title cannot be empty.";
            Toasts.Error(error, "Failed to Save");
            return;
        }

        busy = true;
        error = null;
        StateHasChanged();

        try
        {
            await MenuStore.SaveAsync(edit);
            Toasts.Success($"Menu \"{edit.Title}\" successfully saved.", "Successfully Saved");
            isDrawerOpen = false;
            await Reload();
        }
        catch (Exception ex)
        {
            error = ex.Message;
            Toasts.Error(ex.Message, "Failed to Save");
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ConfirmDelete(NavigationMenuItem item)
    {
        if (item.IsSystem)
        {
            Toasts.Error("Built-in system menus cannot be deleted.", "Not Allowed");
            return;
        }

        var res = await Dialogs.ConfirmAsync(
            $"Delete menu \"{item.Title}\"?",
            "This menu will be removed from sidebar navigation. This action cannot be undone.",
            new ConfirmDialogOptions { Destructive = true, ConfirmText = "Delete Menu", CancelText = "Cancel" });

        if (!res.Confirmed) return;

        busy = true;
        try
        {
            await MenuStore.DeleteAsync(item.Id, item.TenantId);
            if (edit?.Id == item.Id) isDrawerOpen = false;
            Toasts.Success($"Menu \"{item.Title}\" successfully deleted.", "Menu Deleted");
            await Reload();
        }
        catch (Exception ex)
        {
            Toasts.Error(ex.Message, "Failed to Delete Menu");
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ResetDefaults()
    {
        var res = await Dialogs.ConfirmAsync(
            "Seed / Restore Default Menus?",
            "The system will verify and seed missing universal and built-in system menus into the database.",
            new ConfirmDialogOptions { ConfirmText = "Run Seed", CancelText = "Cancel" });

        if (!res.Confirmed) return;

        busy = true;
        try
        {
            await MenuStore.EnsureDefaultMenusAsync(Current.Required.TenantId);
            Toasts.Success("Default menus successfully verified and seeded.", "Seed Successful");
            await Reload();
        }
        catch (Exception ex)
        {
            Toasts.Error(ex.Message, "Failed to Seed Menus");
        }
        finally
        {
            busy = false;
        }
    }
}

@page "/admin/workflows"
@inject MetadataRegistry Registry
@inject CurrentUser Current
@inject ToastService Toasts
@inject Framework.Preferences.IUserPreferenceStore UserPrefs
@implements IDisposable

<PageTitle>Workflows · FrogFrame</PageTitle>

@if (!Current.Required.Roles.Contains(UserContext.SystemManager))
{
    <ErrorState StatusCode="403" Description="This administration page is restricted to System Managers / Administrators." />
}
else
{
    <header class="page-head">
        <div>
            <h1>Workflows</h1>
            <p>Create and publish workflows independently, then link them to a DocType when ready.</p>
        </div>
        <BbButton Href="/admin/workflows/new"><LucideIcon Name="plus" Size="16" /> New workflow</BbButton>
    </header>

    <BbDataGrid @key="gridMgr.RenderKey"
                TData="WorkflowDef"
                Items="@Workflows"
                ShowSearch="true"
                SearchPlaceholder="Search workflows..."
                ShowPagination="true"
                InitialPageSize="15"
                TableContainerClass="table-wrap"
                RowClass="@(w => gridMgr.IsSelected(w) ? "selected" : "")"
                Resizable="true"
                OnColumnResize="gridMgr.HandleResize"
                StateChanged="gridMgr.HandleStateChanged">
        <Toolbar>
            <AdminGridToolbar TData="WorkflowDef" Grid="gridMgr" Items="@Workflows" FileName="workflows" Columns="@ExportColumns" />
        </Toolbar>
        <Columns>
            <AdminGridSelectColumn TData="WorkflowDef" Grid="gridMgr" Items="@Workflows" />

            <BbDataGridPropertyColumn TData="WorkflowDef" TProp="string" Property="w => w.Name" Id="name" Title="Workflow Name"
                                      Width="@gridMgr.GetWidth("name")" Visible="@gridMgr.IsVisible("name")" Resizable="true" Sortable="true" Filterable="true">
                <CellTemplate Context="workflow">
                    <a href="@($"/admin/workflows/{workflow.Name}/editor")" style="font-weight:600;color:inherit;text-decoration:none" class="hover:underline">
                        @workflow.Name
                    </a>
                </CellTemplate>
            </BbDataGridPropertyColumn>

            <BbDataGridPropertyColumn TData="WorkflowDef" TProp="int" Property="w => w.Version" Id="version" Title="Version"
                                      Width="@gridMgr.GetWidth("version", "7rem")" Visible="@gridMgr.IsVisible("version")" Resizable="true" Sortable="true">
                <CellTemplate Context="workflow">
                    <BbBadge Variant="BadgeVariant.Outline">v@workflow.Version</BbBadge>
                </CellTemplate>
            </BbDataGridPropertyColumn>

            <BbDataGridPropertyColumn TData="WorkflowDef" TProp="string?" Property="w => w.DocType" Id="doctype" Title="DocType"
                                      Width="@gridMgr.GetWidth("doctype", "14rem")" Visible="@gridMgr.IsVisible("doctype")" Resizable="true" Sortable="true" Filterable="true">
                <CellTemplate Context="workflow">
                    <span class="@(string.IsNullOrEmpty(workflow.DocType) ? "muted" : "")">
                        @(workflow.DocType ?? "—")
                    </span>
                </CellTemplate>
            </BbDataGridPropertyColumn>

            <BbDataGridTemplateColumn TData="WorkflowDef" Id="relationship" Title="Relationship"
                                      Width="@gridMgr.GetWidth("relationship", "10rem")" Visible="@gridMgr.IsVisible("relationship")" Resizable="true">
                <ChildContent Context="workflow">
                    @if (IsLinked(workflow))
                    {
                        <BbBadge Variant="BadgeVariant.SoftSuccess">Linked</BbBadge>
                    }
                    else if (string.IsNullOrWhiteSpace(workflow.DocType))
                    {
                        <BbBadge Variant="BadgeVariant.Outline">Standalone</BbBadge>
                    }
                    else
                    {
                        <BbBadge Variant="BadgeVariant.Secondary">Not attached</BbBadge>
                    }
                </ChildContent>
            </BbDataGridTemplateColumn>

            <BbDataGridTemplateColumn TData="WorkflowDef" Id="actions" Title="Actions"
                                      Width="@gridMgr.GetWidth("actions", "10rem")" Hideable="false" Resizable="false">
                <ChildContent Context="workflow">
                    <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" Href="@($"/admin/workflows/{workflow.Name}/editor")" Style="white-space:nowrap">
                        <LucideIcon Name="pencil" Size="14" />
                        <span style="white-space:nowrap">Edit / link</span>
                    </BbButton>
                </ChildContent>
            </BbDataGridTemplateColumn>
        </Columns>
        <EmptyTemplate>
            <div style="padding:2.5rem 1rem;text-align:center">
                <BbEmpty Title="No workflows found" Description="Create a workflow independently, then link it to a DocType when you are ready." />
            </div>
        </EmptyTemplate>
    </BbDataGrid>
}

@code {
    private Framework.Web.Services.DataGridPreferenceManager<WorkflowDef> gridMgr = default!;
    private IReadOnlyList<WorkflowDef> Workflows => Registry.Workflows.OrderBy(w => w.Name, StringComparer.OrdinalIgnoreCase).ToList();

    private IReadOnlyList<GridExportColumn<WorkflowDef>> ExportColumns =>
    [
        new("name", "Workflow Name", w => w.Name),
        new("version", "Version", w => w.Version),
        new("doctype", "DocType", w => w.DocType),
        new("relationship", "Relationship", w => IsLinked(w) ? "Linked" : string.IsNullOrWhiteSpace(w.DocType) ? "Standalone" : "Not attached")
    ];

    protected override async Task OnInitializedAsync()
    {
        gridMgr = new(UserPrefs, Current, "grid:admin:workflows", StateHasChanged);
        if (Current.User is not null)
        {
            await gridMgr.InitializeAsync();
        }
    }

    private async Task ResetColumnsLayout()
    {
        await gridMgr.ResetAsync();
        Toasts.Success("Column layout has been reset to default.", "Reset Columns");
    }

    public void Dispose()
    {
        gridMgr?.Dispose();
    }

    private bool IsLinked(WorkflowDef workflow) =>
        !string.IsNullOrWhiteSpace(workflow.DocType)
        && Registry.Current.TryGet(workflow.DocType, out var doc)
        && doc.Def.Workflow == workflow.Name;
}

@page "/admin/roles"
@using Framework.Security
@inject IRoleStore RoleStore
@inject IMetadataProvider Metadata
@inject RoleCatalog RoleCatalogSvc
@inject CurrentUser Current
@inject ToastService Toasts
@inject DialogService Dialogs
@inject Framework.Preferences.IUserPreferenceStore UserPrefs
@implements IDisposable

<PageTitle>Master Roles · DocFrame</PageTitle>

@if (!Current.Required.IsAdmin)
{
    <BbAlert Variant="AlertVariant.Danger"><BbAlertDescription>This page is only accessible to Administrators / System Managers.</BbAlertDescription></BbAlert>
}
else
{
    <header class="page-head">
        <div>
            <h1>Master Roles</h1>
            <p>Manage the role list for tenant @Current.Required.TenantId. Roles determine DocType permissions, workflow approval routing, and sidebar menu visibility.</p>
        </div>
        <div class="row" style="gap:.5rem">
            <BbButton Variant="ButtonVariant.Outline" OnClick="ResetDefaults"><LucideIcon Name="rotate-ccw" Size="16" /> Seed Defaults</BbButton>
            <BbButton OnClick="StartCreate"><LucideIcon Name="shield-plus" Size="16" /> Add role</BbButton>
        </div>
    </header>

    <BbDataGrid @key="gridMgr.RenderKey"
                TData="RoleDef"
                Items="@roles"
                ShowSearch="true"
                SearchPlaceholder="Search roles..."
                ShowPagination="true"
                InitialPageSize="10"
                TableContainerClass="table-wrap"
                RowClass="@(r => edit?.Id == r.Id ? "selected" : "")"
                Resizable="true"
                OnColumnResize="gridMgr.HandleResize"
                StateChanged="gridMgr.HandleStateChanged">
        <Toolbar>
            <div style="display:flex;align-items:center;gap:.5rem;margin-left:auto">
                @if (gridMgr.HasCustomLayout)
                {
                    <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" OnClick="ResetColumnsLayout" Title="Reset column layout to default">
                        <LucideIcon Name="rotate-ccw" Size="14" />
                        <span>Reset Columns</span>
                    </BbButton>
                }
                <BbDataGridColumnVisibility TData="RoleDef" />
            </div>
        </Toolbar>
        <Columns>
            <BbDataGridPropertyColumn TData="RoleDef" TProp="string" Property="r => r.Name" Id="name" Title="Role" Sortable="true" Filterable="true"
                                      Width="@gridMgr.GetWidth("name", "16rem")" Visible="@gridMgr.IsVisible("name")" Resizable="true">
                <CellTemplate Context="item">
                    <div class="row" style="gap:.5rem;align-items:center;flex-wrap:nowrap">
                        <LucideIcon Name="@(item.IsSystem ? "shield" : "shield-alert")" Size="16" />
                        <strong>@item.Name</strong>
                    </div>
                </CellTemplate>
            </BbDataGridPropertyColumn>

            <BbDataGridPropertyColumn TData="RoleDef" TProp="string" Property="r => r.Description" Id="description" Title="Description" Sortable="true" Filterable="true"
                                      Width="@gridMgr.GetWidth("description")" Visible="@gridMgr.IsVisible("description")" Resizable="true">
                <CellTemplate Context="item">
                    @(string.IsNullOrWhiteSpace(item.Description) ? "—" : item.Description)
                </CellTemplate>
            </BbDataGridPropertyColumn>

            <BbDataGridTemplateColumn TData="RoleDef" Id="type" Title="Type" Width="@gridMgr.GetWidth("type", "7rem")" Visible="@gridMgr.IsVisible("type")" Resizable="true" Sortable="true" SortBy="r => r.IsSystem">
                <ChildContent Context="item">
                    @if (item.IsSystem)
                    {
                        <BbBadge Variant="BadgeVariant.Soft">System</BbBadge>
                    }
                    else
                    {
                        <BbBadge Variant="BadgeVariant.Outline">Custom</BbBadge>
                    }
                </ChildContent>
            </BbDataGridTemplateColumn>

            <BbDataGridTemplateColumn TData="RoleDef" Id="actions" Title="Actions" Width="@gridMgr.GetWidth("actions", "7.5rem")" Hideable="false" Resizable="false">
                <ChildContent Context="item">
                    <div style="display:inline-flex;align-items:center;gap:.25rem;flex-wrap:nowrap" @onclick:stopPropagation="true">
                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" AriaLabel="Edit role" OnClick="() => StartEdit(item)">
                            <LucideIcon Name="pencil" Size="15" />
                        </BbButton>
                        @if (!item.IsSystem && !string.Equals(item.Name, "Administrator", StringComparison.OrdinalIgnoreCase))
                        {
                            <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" AriaLabel="Delete role" OnClick="() => ConfirmDelete(item)">
                                <LucideIcon Name="trash-2" Size="15" />
                            </BbButton>
                        }
                    </div>
                </ChildContent>
            </BbDataGridTemplateColumn>
        </Columns>
        <EmptyTemplate>
            <div style="padding:2rem;text-align:center;color:var(--muted-foreground)">
                No roles found.
            </div>
        </EmptyTemplate>
    </BbDataGrid>

    <AdminDrawer Open="@isDrawerOpen"
                 OpenChanged="@OnDrawerOpenChanged"
                 WidthScale="@DrawerWidthScale"
                 Title="@(edit is null ? "" : isNew ? "Add New Role" : $"Edit: {edit.Name}")"
                 Description="@(edit is null ? null : edit.IsSystem ? "Built-in system role (cannot be deleted)." : "Custom tenant role.")">
        <ChildContent>
            @if (edit is not null)
            {
                @if (error is not null)
                {
                    <BbAlert Variant="AlertVariant.Danger"><BbAlertDescription>@error</BbAlertDescription></BbAlert>
                }

                <BbField>
                    <BbFieldLabel For="r-name">Role Name</BbFieldLabel>
                    <FormTextInput Id="r-name" Immediate="true" @bind-Value="edit.Name" Disabled="@(!isNew && edit.IsSystem)" Placeholder="e.g. HR, Purchasing, Auditor" />
                    @if (!isNew && edit.IsSystem)
                    {
                        <BbFieldDescription>System role names cannot be changed to maintain built-in permission integrity.</BbFieldDescription>
                    }
                </BbField>

                <BbField>
                    <BbFieldLabel For="r-desc">Description</BbFieldLabel>
                    <FormTextInput Id="r-desc" Immediate="true" @bind-Value="edit.Description" Placeholder="e.g. Procurement and vendor management" />
                    <BbFieldDescription>Explanation of the role's purpose and authority scope.</BbFieldDescription>
                </BbField>

                @if (edit.IsSystem)
                {
                    <BbAlert Variant="AlertVariant.Info" Class="props-block">
                        <BbAlertDescription>This role is a core system role and is protected from deletion.</BbAlertDescription>
                    </BbAlert>
                }
            }
        </ChildContent>
        <FooterContent>
            @if (edit is not null)
            {
                <div class="row" style="gap:.5rem;width:100%;align-items:center">
                    <BbButton Disabled="busy" Loading="busy" LoadingText="Saving…" OnClick="Save"><LucideIcon Name="check" Size="16" /> Save</BbButton>
                    <BbButton Variant="ButtonVariant.Ghost" OnClick="CloseDrawer">Cancel</BbButton>
                    @if (!isNew && !edit.IsSystem && !string.Equals(edit.Name, "Administrator", StringComparison.OrdinalIgnoreCase))
                    {
                        <span style="margin-left:auto">
                            <BbButton Variant="ButtonVariant.Destructive" Size="ButtonSize.Small" Disabled="busy" OnClick="() => ConfirmDelete(edit)">
                                <LucideIcon Name="trash-2" Size="15" /> Delete
                            </BbButton>
                        </span>
                    }
                </div>
            }
        </FooterContent>
    </AdminDrawer>
}

@code {
    /// <summary>Configurable drawer width multiplier (default 1.0 = normal width).</summary>
    [Parameter] public double DrawerWidthScale { get; set; } = 1.0;

    private IReadOnlyList<RoleDef> roles = [];
    private RoleDef? edit;
    private bool isDrawerOpen;
    private bool isNew;
    private bool busy;
    private string? error;
    private Framework.Web.Services.DataGridPreferenceManager<RoleDef> gridMgr = default!;

    protected override async Task OnInitializedAsync()
    {
        gridMgr = new(UserPrefs, Current, "grid:admin:roles", StateHasChanged);
        if (Current.User is null) return;
        await gridMgr.InitializeAsync();
        await Reload();
    }

    private async Task ResetColumnsLayout()
    {
        await gridMgr.ResetAsync();
        Toasts.Success("Column layout has been reset to default.", "Reset Columns");
    }

    public void Dispose()
    {
        gridMgr?.Dispose();
    }

    private async Task Reload()
    {
        roles = await RoleStore.ListAsync(Current.Required.TenantId);
    }

    private void StartCreate()
    {
        error = null;
        isNew = true;
        edit = new RoleDef
        {
            Id = Guid.NewGuid().ToString("N"),
            TenantId = Current.Required.TenantId,
            Name = "",
            Description = "",
            IsSystem = false
        };
        isDrawerOpen = true;
    }

    private void StartEdit(RoleDef item)
    {
        error = null;
        isNew = false;
        edit = new RoleDef
        {
            Id = item.Id,
            TenantId = item.TenantId,
            Name = item.Name,
            Description = item.Description,
            IsSystem = item.IsSystem,
            CreatedAt = item.CreatedAt,
            UpdatedAt = item.UpdatedAt
        };
        isDrawerOpen = true;
    }

    private void CloseDrawer()
    {
        isDrawerOpen = false;
    }

    private void OnDrawerOpenChanged(bool open)
    {
        isDrawerOpen = open;
        if (!open)
        {
            edit = null;
            error = null;
        }
    }

    private async Task Save()
    {
        if (edit is null || busy) return;
        if (string.IsNullOrWhiteSpace(edit.Name))
        {
            error = "Role name cannot be empty.";
            return;
        }

        edit.Name = edit.Name.Trim();
        busy = true;
        error = null;
        StateHasChanged();

        try
        {
            // Check for duplicate name if new role or renamed
            var existing = await RoleStore.GetByNameAsync(edit.Name, edit.TenantId);
            if (existing is not null && existing.Id != edit.Id)
            {
                error = $"A role with the name \"{edit.Name}\" already exists.";
                return;
            }

            // Role yang masih dipakai metadata/akun tidak boleh di-rename (nama adalah kunci referensi).
            var original = await RoleStore.GetAsync(edit.Id, edit.TenantId);
            if (original is not null && original.Name != edit.Name)
            {
                var blocked = await RoleCatalogSvc.BlockingUseAsync(edit.TenantId, original.Name, Metadata.Current);
                if (blocked is not null) { error = "Tidak bisa diganti nama: " + blocked; return; }
            }

            await RoleStore.SaveAsync(edit);
            Toasts.Success($"Role \"{edit.Name}\" successfully saved.", "Successfully Saved");
            isDrawerOpen = false;
            await Reload();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ConfirmDelete(RoleDef item)
    {
        if (item.IsSystem || string.Equals(item.Name, "Administrator", StringComparison.OrdinalIgnoreCase))
        {
            Toasts.Error("Administrator and built-in system roles cannot be deleted.", "Not Allowed");
            return;
        }

        var res = await Dialogs.ConfirmAsync(
            $"Delete role \"{item.Name}\"?",
            "Users with this role will lose associated permissions. This action cannot be undone.",
            new ConfirmDialogOptions { Destructive = true, ConfirmText = "Delete Role", CancelText = "Cancel" });

        if (!res.Confirmed) return;

        var blocked = await RoleCatalogSvc.BlockingUseAsync(item.TenantId, item.Name, Metadata.Current);
        if (blocked is not null)
        {
            Toasts.Error(blocked, "Tidak bisa dihapus");
            return;
        }

        busy = true;
        try
        {
            await RoleStore.DeleteAsync(item.Id, item.TenantId);
            if (edit?.Id == item.Id) isDrawerOpen = false;
            Toasts.Success($"Role \"{item.Name}\" successfully deleted.", "Role Deleted");
            await Reload();
        }
        catch (Exception ex)
        {
            Toasts.Error(ex.Message, "Failed to Delete Role");
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ResetDefaults()
    {
        var res = await Dialogs.ConfirmAsync(
            "Seed / Restore Default Roles?",
            "The system will verify and seed default built-in roles (Administrator, User, HR, Purchasing, etc.) if missing in the database.",
            new ConfirmDialogOptions { ConfirmText = "Run Seed", CancelText = "Cancel" });

        if (!res.Confirmed) return;

        busy = true;
        try
        {
            await RoleStore.EnsureDefaultRolesAsync(Current.Required.TenantId);
            Toasts.Success("Default roles successfully verified and seeded.", "Seed Successful");
            await Reload();
        }
        catch (Exception ex)
        {
            Toasts.Error(ex.Message, "Failed to Seed Roles");
        }
        finally
        {
            busy = false;
        }
    }
}


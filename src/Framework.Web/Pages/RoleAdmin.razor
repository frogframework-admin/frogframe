@page "/admin/roles"
@using Framework.Security
@inject IRoleStore RoleStore
@inject CurrentUser Current
@inject ToastService Toasts
@inject DialogService Dialogs

<PageTitle>Master Role · DocFrame</PageTitle>

@if (!Current.Required.IsAdmin)
{
    <BbAlert Variant="AlertVariant.Danger"><BbAlertDescription>Halaman ini hanya untuk Administrator / System Manager.</BbAlertDescription></BbAlert>
}
else
{
    <header class="page-head">
        <div>
            <h1>Master Role Pengguna</h1>
            <p>Kelola daftar role untuk tenant @Current.Required.TenantId. Role menentukan izin akses DocType, alur persetujuan workflow, dan menu sidebar.</p>
        </div>
        <div class="row" style="gap:.5rem">
            <BbButton Variant="ButtonVariant.Outline" OnClick="ResetDefaults"><LucideIcon Name="rotate-ccw" Size="16" /> Seed Default</BbButton>
            <BbButton OnClick="StartCreate"><LucideIcon Name="shield-plus" Size="16" /> Tambah role</BbButton>
        </div>
    </header>

    <div class="users-grid">
        <div class="table-wrap">
            <table class="data">
                <thead>
                    <tr>
                        <th>Role</th>
                        <th>Deskripsi</th>
                        <th style="width:6rem">Tipe</th>
                        <th style="width:5rem">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in roles)
                    {
                        var item = r;
                        <tr class="clickable @(edit?.Id == item.Id ? "selected" : "")" @onclick="() => StartEdit(item)">
                            <td>
                                <div class="row" style="gap:.5rem;align-items:center">
                                    <LucideIcon Name="@(item.IsSystem ? "shield" : "shield-alert")" Size="16" />
                                    <strong>@item.Name</strong>
                                </div>
                            </td>
                            <td>@(item.Description ?? "—")</td>
                            <td>
                                @if (item.IsSystem)
                                {
                                    <BbBadge Variant="BadgeVariant.Soft">Sistem</BbBadge>
                                }
                                else
                                {
                                    <BbBadge Variant="BadgeVariant.Outline">Kustom</BbBadge>
                                }
                            </td>
                            <td>
                                <div class="row" style="gap:.25rem">
                                    <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" AriaLabel="Edit role" OnClick="() => StartEdit(item)">
                                        <LucideIcon Name="pencil" Size="15" />
                                    </BbButton>
                                    @if (!item.IsSystem && !string.Equals(item.Name, "Administrator", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" AriaLabel="Hapus role" OnClick="() => ConfirmDelete(item)">
                                            <LucideIcon Name="trash-2" Size="15" />
                                        </BbButton>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (edit is not null)
        {
            <BbCard>
                <BbCardHeader>
                    <BbCardTitle Class="card-title">@(isNew ? "Role baru" : $"Edit: {edit.Name}")</BbCardTitle>
                    <BbCardDescription>
                        @(edit.IsSystem ? "Role sistem bawaan aplikasi (tidak dapat dihapus)." : "Role kustom tenant.")
                    </BbCardDescription>
                </BbCardHeader>
                <BbCardContent>
                    <div class="stack">
                        @if (error is not null)
                        {
                            <BbAlert Variant="AlertVariant.Danger"><BbAlertDescription>@error</BbAlertDescription></BbAlert>
                        }

                        <BbField>
                            <BbFieldLabel For="r-name">Nama Role</BbFieldLabel>
                            <BbInput Id="r-name" @bind-Value="edit.Name" Disabled="@(!isNew && edit.IsSystem)" Placeholder="mis. HR, Purchasing, Auditor" />
                            @if (!isNew && edit.IsSystem)
                            {
                                <BbFieldDescription>Nama role sistem tidak dapat diubah demi menjaga integritas hak akses bawaan.</BbFieldDescription>
                            }
                        </BbField>

                        <BbField>
                            <BbFieldLabel For="r-desc">Deskripsi</BbFieldLabel>
                            <BbInput Id="r-desc" @bind-Value="edit.Description" Placeholder="mis. Pengelolaan pengadaan dan vendor" />
                            <BbFieldDescription>Penjelasan fungsi dan cakupan wewenang role ini.</BbFieldDescription>
                        </BbField>

                        @if (edit.IsSystem)
                        {
                            <BbAlert Variant="AlertVariant.Info" Class="props-block">
                                <BbAlertDescription>Role ini adalah role inti sistem dan diproteksi agar tidak bisa dihapus.</BbAlertDescription>
                            </BbAlert>
                        }

                        <div class="row" style="margin-top:1rem;gap:.5rem">
                            <BbButton Disabled="busy" OnClick="Save"><LucideIcon Name="check" Size="16" /> Simpan</BbButton>
                            <BbButton Variant="ButtonVariant.Ghost" OnClick="() => edit = null">Batal</BbButton>
                            @if (!isNew && !edit.IsSystem && !string.Equals(edit.Name, "Administrator", StringComparison.OrdinalIgnoreCase))
                            {
                                <span style="margin-left:auto">
                                    <BbButton Variant="ButtonVariant.Destructive" Size="ButtonSize.Small" Disabled="busy" OnClick="() => ConfirmDelete(edit)">
                                        <LucideIcon Name="trash-2" Size="15" /> Hapus
                                    </BbButton>
                                </span>
                            }
                        </div>
                    </div>
                </BbCardContent>
            </BbCard>
        }
    </div>
}

@code {
    private IReadOnlyList<RoleDef> roles = [];
    private RoleDef? edit;
    private bool isNew;
    private bool busy;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        if (Current.User is null) return;
        await Reload();
    }

    private async Task Reload()
    {
        roles = await RoleStore.ListAsync(Current.Required.TenantId);
    }

    private void StartCreate()
    {
        error = null;
        isNew = true;
        edit = new RoleDef
        {
            Id = Guid.NewGuid().ToString("N"),
            TenantId = Current.Required.TenantId,
            Name = "",
            Description = "",
            IsSystem = false
        };
    }

    private void StartEdit(RoleDef item)
    {
        error = null;
        isNew = false;
        edit = new RoleDef
        {
            Id = item.Id,
            TenantId = item.TenantId,
            Name = item.Name,
            Description = item.Description,
            IsSystem = item.IsSystem,
            CreatedAt = item.CreatedAt,
            UpdatedAt = item.UpdatedAt
        };
    }

    private async Task Save()
    {
        if (edit is null) return;
        if (string.IsNullOrWhiteSpace(edit.Name))
        {
            error = "Nama role tidak boleh kosong.";
            return;
        }

        edit.Name = edit.Name.Trim();

        // Cek duplikasi nama jika role baru atau ganti nama
        var existing = await RoleStore.GetByNameAsync(edit.Name, edit.TenantId);
        if (existing is not null && existing.Id != edit.Id)
        {
            error = $"Role dengan nama \"{edit.Name}\" sudah ada.";
            return;
        }

        busy = true;
        error = null;
        try
        {
            await RoleStore.SaveAsync(edit);
            Toasts.Success($"Role \"{edit.Name}\" berhasil disimpan.", "Berhasil Disimpan");
            edit = null;
            await Reload();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ConfirmDelete(RoleDef item)
    {
        if (item.IsSystem || string.Equals(item.Name, "Administrator", StringComparison.OrdinalIgnoreCase))
        {
            Toasts.Error("Role Administrator / role sistem bawaan tidak dapat dihapus.", "Tidak Diizinkan");
            return;
        }

        var res = await Dialogs.ConfirmAsync(
            $"Hapus role \"{item.Name}\"?",
            "Pengguna yang memiliki role ini tidak akan lagi memiliki hak akses terkait. Tindakan ini tidak bisa dibatalkan.",
            new ConfirmDialogOptions { Destructive = true, ConfirmText = "Hapus Role", CancelText = "Batal" });

        if (!res.Confirmed) return;

        busy = true;
        try
        {
            await RoleStore.DeleteAsync(item.Id, item.TenantId);
            if (edit?.Id == item.Id) edit = null;
            Toasts.Success($"Role \"{item.Name}\" berhasil dihapus.", "Role Dihapus");
            await Reload();
        }
        catch (Exception ex)
        {
            Toasts.Error(ex.Message, "Gagal Menghapus Role");
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ResetDefaults()
    {
        var res = await Dialogs.ConfirmAsync(
            "Seed / Pulihkan Role Default?",
            "Sistem akan memeriksa dan menambahkan role bawaan (Administrator, User, HR, Purchasing, dll.) jika belum ada di database.",
            new ConfirmDialogOptions { ConfirmText = "Jalankan Seed", CancelText = "Batal" });

        if (!res.Confirmed) return;

        busy = true;
        try
        {
            await RoleStore.EnsureDefaultRolesAsync(Current.Required.TenantId);
            Toasts.Success("Role default berhasil diperiksa dan di-seed.", "Seed Berhasil");
            await Reload();
        }
        catch (Exception ex)
        {
            Toasts.Error(ex.Message, "Gagal Seed Role");
        }
        finally
        {
            busy = false;
        }
    }
}


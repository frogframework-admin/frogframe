    private async Task Reload()
    {
        var tenantId = Current.Required.TenantId;
        roles = await RoleStore.ListAsync(tenantId);
        menuItems = await MenuStore.ListAsync(tenantId, onlyActive: true);
        menuGroups = (await MenuStore.ListGroupsAsync(tenantId, onlyActive: true))
            .ToDictionary(g => g.Id, g => g.Name, StringComparer.OrdinalIgnoreCase);
        gridMgr.RetainSelection(roles);
        SyncRoleFromRoute();
    }

    private int CountDocTypes(string roleName) =>
        Metadata.Current.DocTypes.Values.Count(dt =>
            dt.Def.Permissions.Any(p => string.Equals(p.Role, roleName, StringComparison.OrdinalIgnoreCase)));

    private int CountWorkflows(string roleName) =>
        Metadata.Current.Workflows.Values.SelectMany(w => w.Transitions)
            .Count(t => t.Def.AllowedRoles.Any(r => string.Equals(r, roleName, StringComparison.OrdinalIgnoreCase)));

    private void OpenPermissions(RoleDef role)
    {
        LoadPermissions(role);
        Nav.NavigateTo($"/admin/roles/{Uri.EscapeDataString(role.Name)}");
    }

    private static bool IsSuperAdminRole(string? roleName) =>
        string.Equals(roleName, UserContext.Administrator, StringComparison.OrdinalIgnoreCase) ||
        string.Equals(roleName, UserContext.SystemManager, StringComparison.OrdinalIgnoreCase);

    private void ClosePermissionsPage()
    {
        permRole = null;
        dirtyDocTypes.Clear();
        permError = null;
        Nav.NavigateTo("/admin/roles");
    }

    private void LoadPermissions(RoleDef role)
    {
        permRole = role;
        permSearch = "";
        permError = null;
        addDocType = "";
        addScope = "all";
        dirtyDocTypes.Clear();
        permTab = "doctypes";

        roleDocPerms = Metadata.Current.DocTypes.Values
            .SelectMany(dt => dt.Def.Permissions
                .Where(p => string.Equals(p.Role, role.Name, StringComparison.OrdinalIgnoreCase))
                .Select(p => new RoleDocTypePerm
                {
                    DocType = dt.Name,
                    Title = dt.Title,
                    Module = string.IsNullOrWhiteSpace(dt.Def.Module) ? "CORE" : dt.Def.Module,
                    IsSubmittable = dt.Def.Document.AllowSubmit || dt.Def.Document.AllowCancel || dt.Def.Document.AllowAmend,
                    Actions = new HashSet<string>(p.Actions, StringComparer.OrdinalIgnoreCase),
                    Scope = string.IsNullOrWhiteSpace(p.Scope) ? "all" : p.Scope,
                    PermLevel = p.PermLevel
                }))
            .OrderBy(p => p.Module, StringComparer.OrdinalIgnoreCase)
            .ThenBy(p => p.DocType, StringComparer.OrdinalIgnoreCase)
            .ToList();

        roleWorkflowPerms = Metadata.Current.Workflows.Values
            .SelectMany(wf => wf.Transitions
                .Where(t => t.Def.AllowedRoles.Any(r => string.Equals(r, role.Name, StringComparison.OrdinalIgnoreCase)))
                .Select(t => new RoleWorkflowPerm(wf.Def.Name, wf.Def.DocType, t.Def.Action, t.Def.From, t.Def.To)))
            .OrderBy(w => w.Workflow, StringComparer.OrdinalIgnoreCase)
            .ToList();

        roleMenuPerms = menuItems
            .Where(m => m.AllowedRoles.Count == 0 || m.AllowedRoles.Any(r => string.Equals(r, role.Name, StringComparison.OrdinalIgnoreCase)))
            .Select(m => new RoleMenuPerm(
                m.Title,
                m.GroupId is not null && menuGroups.TryGetValue(m.GroupId, out var gName) ? gName : m.GroupName,
                string.IsNullOrWhiteSpace(m.Href) ? "/" : "/" + m.Href.TrimStart('/'),
                m.AllowedRoles.Count == 0))
            .OrderBy(m => m.IsUniversal)
            .ThenBy(m => m.Group, StringComparer.OrdinalIgnoreCase)
            .ThenBy(m => m.Title, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private IEnumerable<CompiledDocType> AvailableDocTypesToAdd =>
        Metadata.Current.DocTypes.Values
            .Where(dt => !dt.Def.IsChild)
            .OrderBy(dt => dt.Name, StringComparer.OrdinalIgnoreCase);

    private void TogglePermAction(RoleDocTypePerm p, string action, bool isChecked)
    {
        if (isChecked) p.Actions.Add(action);
        else p.Actions.Remove(action);
        dirtyDocTypes.Add(p.DocType);
    }

    private void UpdatePermScope(RoleDocTypePerm p, string? scope)
    {
        p.Scope = string.IsNullOrWhiteSpace(scope) ? "all" : scope.Trim();
        dirtyDocTypes.Add(p.DocType);
    }

    private void AddDocTypePermission()
    {
        if (string.IsNullOrWhiteSpace(addDocType)) return;
        if (!Metadata.Current.TryGet(addDocType, out var dt)) return;

        var scope = string.IsNullOrWhiteSpace(addScope) ? "all" : addScope.Trim();
        if (roleDocPerms.Any(x => string.Equals(x.DocType, dt.Name, StringComparison.OrdinalIgnoreCase)
                               && string.Equals(x.Scope, scope, StringComparison.OrdinalIgnoreCase)))
        {
            permError = $"A permission rule for '{dt.Name}' with scope '{scope}' already exists for this role.";
            return;
        }

        permError = null;
        roleDocPerms.Insert(0, new RoleDocTypePerm
        {
            DocType = dt.Name,
            Title = dt.Title,
            Module = string.IsNullOrWhiteSpace(dt.Def.Module) ? "CORE" : dt.Def.Module,
            IsSubmittable = dt.Def.Document.AllowSubmit || dt.Def.Document.AllowCancel || dt.Def.Document.AllowAmend,
            Actions = new HashSet<string>(["read"], StringComparer.OrdinalIgnoreCase),
            Scope = scope,
            PermLevel = 0
        });
        dirtyDocTypes.Add(dt.Name);
        addDocType = "";
        addScope = "all";
    }

    private void RemoveDocTypePermission(RoleDocTypePerm p)
    {
        roleDocPerms.Remove(p);
        dirtyDocTypes.Add(p.DocType);
    }

    private bool canEditMetadata;

    private async Task SavePermissionsAsync()
    {
        if (!canEditMetadata) { permError = Framework.Web.Tenancy.MetadataEditPolicy.DeniedMessage; return; }
        if (permRole is null || dirtyDocTypes.Count == 0 || busy) return;
        busy = true;
        permError = null;
        StateHasChanged();

        var scope = RoleCatalogSvc.Scope(Current.Required.TenantId);
        var updatedCount = 0;

        try
        {
            foreach (var docTypeName in dirtyDocTypes.ToList())
            {
                if (!Metadata.Current.TryGet(docTypeName, out var compiled)) continue;

                var clone = MetadataJson.ParseDocType(MetadataJson.Serialize(compiled.Def));
                clone.Permissions.RemoveAll(p => string.Equals(p.Role, permRole.Name, StringComparison.OrdinalIgnoreCase));

                foreach (var edited in roleDocPerms.Where(r => string.Equals(r.DocType, docTypeName, StringComparison.OrdinalIgnoreCase)))
                {
                    if (edited.Actions.Count == 0) continue;
                    clone.Permissions.Add(new PermissionDef
                    {
                        Role = permRole.Name,
                        Actions = AllPermActions.Where(a => edited.Actions.Contains(a)).ToList(),
                        Scope = string.IsNullOrWhiteSpace(edited.Scope) ? "all" : edited.Scope.Trim(),
                        PermLevel = edited.PermLevel
                    });
                }

                Registry.Publish(clone, Current.Required.Id, acknowledgeRisk: true, scope: scope);
                updatedCount++;
            }

            Toasts.Success($"Updated permissions on {updatedCount} DocType(s) for role \"{permRole.Name}\".", "Permissions Saved");
            LoadPermissions(permRole);
            await Reload();
        }
        catch (MetadataCompilationException ex)
        {
            permError = string.Join("; ", ex.Errors.Select(e => e.ToString()));
        }
        catch (Exception ex)
        {
            permError = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private IReadOnlyList<RoleDocTypePerm> FilteredDocTypePerms =>
        string.IsNullOrWhiteSpace(permSearch)
            ? roleDocPerms
            : roleDocPerms.Where(p =>
                p.DocType.Contains(permSearch, StringComparison.OrdinalIgnoreCase) ||
                p.Title.Contains(permSearch, StringComparison.OrdinalIgnoreCase) ||
                p.Module.Contains(permSearch, StringComparison.OrdinalIgnoreCase) ||
                p.Scope.Contains(permSearch, StringComparison.OrdinalIgnoreCase) ||
                p.Actions.Any(a => a.Contains(permSearch, StringComparison.OrdinalIgnoreCase))).ToList();

    private IReadOnlyList<RoleWorkflowPerm> FilteredWorkflowPerms =>
        string.IsNullOrWhiteSpace(permSearch)
            ? roleWorkflowPerms
            : roleWorkflowPerms.Where(w =>
                w.Workflow.Contains(permSearch, StringComparison.OrdinalIgnoreCase) ||
                (w.DocType?.Contains(permSearch, StringComparison.OrdinalIgnoreCase) ?? false) ||
                w.Action.Contains(permSearch, StringComparison.OrdinalIgnoreCase)).ToList();

    private IReadOnlyList<RoleMenuPerm> FilteredMenuPerms =>
        string.IsNullOrWhiteSpace(permSearch)
            ? roleMenuPerms
            : roleMenuPerms.Where(m =>
                m.Title.Contains(permSearch, StringComparison.OrdinalIgnoreCase) ||
                m.Group.Contains(permSearch, StringComparison.OrdinalIgnoreCase) ||
                m.Href.Contains(permSearch, StringComparison.OrdinalIgnoreCase)).ToList();

    private static BadgeVariant ActionBadgeVariant(string action) => action.ToLowerInvariant() switch
    {
        "read" => BadgeVariant.Soft,
        "create" or "write" => BadgeVariant.Outline,
        "submit" => BadgeVariant.SoftSuccess,
        "delete" or "cancel" => BadgeVariant.SoftDestructive,
        _ => BadgeVariant.Outline
    };

    private async Task ExecuteBulkEditAsync(string field, string value)
    {
        var selected = gridMgr.GetSelectedItems(roles);
        if (selected.Count == 0 || busy) return;
        busy = true;
        try
        {
            foreach (var r in selected)
            {
                if (field == "description")
                {
                    r.Description = value.Trim();
                    await RoleStore.SaveAsync(r);
                    gridMgr.SelectedIds.Remove(r.Id);
                }
            }
            bulkEditOpen = false;
            await Reload();
            Toasts.Success($"{selected.Count} role(s) updated.", "Bulk Edit Complete");
        }
        finally { busy = false; }
    }

    private async Task BulkDeleteAsync()
    {
        var selected = gridMgr.GetSelectedItems(roles);
        if (selected.Count == 0 || busy) return;
        var res = await Dialogs.ConfirmAsync(
            $"Delete {selected.Count} role(s)?",
            "Custom roles not currently in use will be deleted. Built-in system roles and roles in use will be skipped.",
            new ConfirmDialogOptions { Destructive = true, ConfirmText = $"Delete ({selected.Count})", CancelText = "Cancel" });
        if (!res.Confirmed) return;

        busy = true;
        try
        {
            int deleted = 0, skipped = 0;
            foreach (var item in selected)
            {
                if (item.IsSystem || string.Equals(item.Name, "Administrator", StringComparison.OrdinalIgnoreCase))
                {
                    skipped++;
                    continue;
                }
                var blocked = await RoleCatalogSvc.BlockingUseAsync(item.TenantId, item.Name, Metadata.Current);
                if (blocked is not null)
                {
                    skipped++;
                    continue;
                }
                await RoleStore.DeleteAsync(item.Id, item.TenantId);
                deleted++;
                gridMgr.SelectedIds.Remove(item.Id);
            }
            await Reload();
            if (deleted > 0) Toasts.Success($"{deleted} role(s) deleted.", "Bulk Delete");
            if (skipped > 0) Toasts.Warning($"{skipped} role(s) could not be deleted (system role or currently in use).", "Skipped");
        }
        finally { busy = false; }
    }


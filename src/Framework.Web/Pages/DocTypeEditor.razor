@page "/admin/metadata/{DocTypeName}/editor"
@using System.Text.Json
@inject MetadataRegistry Registry
@inject RoleCatalog RoleCatalogSvc
@inject CurrentUser Current
@inject ToastService Toasts
@inject DialogService Dialogs
@inject NavigationManager Nav

<PageTitle>@DocTypeName Editor · DocFrame</PageTitle>

@if (!Current.Required.Roles.Contains(UserContext.SystemManager))
{
    <BbAlert Variant="AlertVariant.Danger"><BbAlertDescription>DocType Editor is only accessible by System Managers.</BbAlertDescription></BbAlert>
}
else if (design is null)
{
    <BbAlert Variant="AlertVariant.Danger"><BbAlertDescription>DocType '@DocTypeName' was not found.</BbAlertDescription></BbAlert>
}
else
{
    <BbBreadcrumb Class="crumbs">
        <BbBreadcrumbList>
            <BbBreadcrumbItem><BbBreadcrumbLink Href="/admin/metadata">Metadata</BbBreadcrumbLink></BbBreadcrumbItem>
            <BbBreadcrumbSeparator />
            <BbBreadcrumbItem><BbBreadcrumbLink Href="@($"/admin/metadata/{DocTypeName}")">@DocTypeName</BbBreadcrumbLink></BbBreadcrumbItem>
            <BbBreadcrumbSeparator />
            <BbBreadcrumbItem><BbBreadcrumbPage>Visual Editor</BbBreadcrumbPage></BbBreadcrumbItem>
        </BbBreadcrumbList>
    </BbBreadcrumb>

    <header class="page-head">
        <div>
            <h1>@design.Def.Title <span class="muted" style="font-weight:500">· draft v@(version)</span></h1>
            <p>
                Active version v@(version - 1).
                @if (errors.Count > 0) { <BbBadge Variant="BadgeVariant.SoftDestructive">@errors.Count issues</BbBadge> }
                else { <BbBadge Variant="BadgeVariant.SoftSuccess">Draft valid</BbBadge> }
                @if (dirty) { <BbBadge Variant="BadgeVariant.Warning">Unpublished changes</BbBadge> }
            </p>
        </div>
        <div class="row">
            <BbButton Variant="ButtonVariant.Ghost" Disabled="@(!dirty)" OnClick="Discard"><LucideIcon Name="rotate-ccw" Size="16" /> Discard changes</BbButton>
            <BbButton Variant="ButtonVariant.Outline" Disabled="@(errors.Count > 0)" OnClick="Check"><LucideIcon Name="search" Size="16" /> Review changes</BbButton>
            <BbButton Disabled="@(preview is not { Valid: true } || preview.Changes.Count == 0 || (preview.Risk == ChangeRisk.Risky && !ack) || (design.Def.DataMigration is not null && migrationPreview is not { Valid: true }))" OnClick="Publish">
                <LucideIcon Name="upload" Size="16" /> Publish v@(version)
            </BbButton>
        </div>
    </header>

    @if (preview is not null)
    {
        <BbCard Class="props-block">
            <BbCardHeader>
                <BbCardTitle Class="card-title">Changes compared to v@(version - 1)</BbCardTitle>
                <BbCardDescription>
                    @(preview.Changes.Count == 0 ? "No changes." : $"{preview.Changes.Count} changes, highest risk level: {RiskLabel(preview.Risk)}.")
                </BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                @if (preview.Errors.Count > 0)
                {
                    <BbAlert Variant="AlertVariant.Danger"><BbAlertDescription><ul class="error-list">@foreach (var e in preview.Errors) { <li><code>@e.Path</code> @e.Message</li> }</ul></BbAlertDescription></BbAlert>
                }
                <ul class="diff">
                    @foreach (var c in preview.Changes.OrderByDescending(c => c.Risk))
                    {
                        <li><BbBadge Variant="@RiskVariant(c.Risk)">@RiskLabel(c.Risk)</BbBadge> <code>@c.Path</code> <span>@c.Description</span></li>
                    }
                </ul>
                @if (preview is { Risk: ChangeRisk.Risky, Valid: true })
                {
                    <div class="label-row" style="margin-top:.75rem"><BbCheckbox Id="ack" @bind-Checked="ack" /><BbLabel For="ack">I have reviewed the risky changes</BbLabel></div>
                }
                @if (design.Def.DataMigration is not null)
                {
                    <div class="stack" style="margin-top:1rem">
                        <div class="row">
                            <BbButton Variant="ButtonVariant.Outline" Disabled="@(preview is not { Valid: true })" OnClick="RunMigrationPreview">
                                <LucideIcon Name="database" Size="16" /> Run migration dry-run
                            </BbButton>
                            @if (migrationPreview is { Valid: true })
                            {
                                <BbBadge Variant="BadgeVariant.SoftSuccess">@migrationPreview.Documents documents ready</BbBadge>
                            }
                        </div>
                        @if (migrationPreview is { Valid: false, Error: not null } failedMigration)
                        {
                            <BbAlert Variant="AlertVariant.Danger"><BbAlertDescription>Migration dry-run failed: @failedMigration.Error</BbAlertDescription></BbAlert>
                        }
                        @if (migrationPreview is { Valid: true })
                        {
                            <BbAlert Variant="AlertVariant.Warning"><BbAlertDescription>Publishing will transform these documents and the metadata version in one transaction. Writes for this DocType will wait during the migration.</BbAlertDescription></BbAlert>
                        }
                    </div>
                }
            </BbCardContent>
        </BbCard>
    }

    @foreach (var w in design.Warnings)
    {
        <BbAlert Variant="AlertVariant.Warning" Class="props-block"><BbAlertDescription>@w</BbAlertDescription></BbAlert>
    }
    @if (GeneralErrors.Any())
    {
        <BbAlert Variant="AlertVariant.Danger" Class="props-block">
            <BbAlertTitle>Draft is not valid</BbAlertTitle>
            <BbAlertDescription><ul class="error-list">@foreach (var e in GeneralErrors) { <li><code>@e.Path</code> @e.Message</li> }</ul></BbAlertDescription>
        </BbAlert>
    }

    <BbTabs Value="@view" ValueChanged="ChangeView">
        <BbTabsList>
            <BbTabsTrigger Value="design" Style="gap:.5rem"><LucideIcon Name="layout-grid" Size="15" /> Design</BbTabsTrigger>
            <BbTabsTrigger Value="preview" Disabled="@(snapshot is null)" Style="gap:.5rem"><LucideIcon Name="eye" Size="15" /> Preview</BbTabsTrigger>
            @if (!design.Def.IsChild)
            {
                <BbTabsTrigger Value="access" Style="gap:.5rem"><LucideIcon Name="shield-check" Size="15" /> Access &amp; Workflow</BbTabsTrigger>
            }
            <BbTabsTrigger Value="hooks" Style="gap:.5rem"><LucideIcon Name="zap" Size="15" /> Hooks</BbTabsTrigger>
            <BbTabsTrigger Value="settings" Style="gap:.5rem"><LucideIcon Name="sliders-horizontal" Size="15" /> DocType Settings</BbTabsTrigger>
            @if (!design.Def.IsChild)
            {
                <BbTabsTrigger Value="migration" Style="gap:.5rem"><LucideIcon Name="database" Size="15" /> Data Migration</BbTabsTrigger>
            }
            <BbTabsTrigger Value="json" Style="gap:.5rem"><LucideIcon Name="braces" Size="15" /> JSON</BbTabsTrigger>
        </BbTabsList>

        <BbTabsContent Value="design">
            <div class="designer">
                <aside class="palette" aria-label="Field types">
                    <div class="props-group-title">ADD FIELD</div>
                    <p class="muted small" style="margin:0 0 .5rem">Drag to form, or click to add to the selected section.</p>
                    @foreach (var t in DocTypeDesign.FieldTypes)
                    {
                        var type = t;
                        <div class="palette-item" draggable="true" role="button" tabindex="0"
                             @ondragstart="() => StartNew(type)" @ondragend="EndDrag" @onclick="() => AddByClick(type)"
                             @onkeydown="e => PaletteKey(e, type)">
                            <LucideIcon Name="@TypeIcon(type)" Size="16" /><span>@TypeLabel(type)</span>
                        </div>
                    }
                </aside>

                <section class="canvas" aria-label="Form layout">
                    <div class="tab-strip" role="tablist">
                        @foreach (var tab in design.Tabs)
                        {
                            var tb = tab;
                            <button type="button" role="tab" aria-selected="@(tb == currentTab)" class="tab-chip @(tb == currentTab ? "active" : "")" @onclick="() => SelectTab(tb)">
                                @tb.Title <span class="muted small">@CountFields(tb)</span>
                            </button>
                        }
                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" OnClick="AddTab"><LucideIcon Name="plus" Size="15" /> Tab</BbButton>
                    </div>

                    @if (currentTab is { } ct)
                    {
                        <div class="tab-tools">
                            <BbInput Value="@ct.Title" ValueChanged="v => Mutate(() => { ct.Title = string.IsNullOrWhiteSpace(v) ? ct.Title : v.Trim(); ct.Explicit = true; })" AriaLabel="Tab title" />
                            <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" AriaLabel="Move tab left" OnClick="() => Mutate(() => DocTypeDesign.MoveItem(design.Tabs, ct, -1))"><LucideIcon Name="arrow-left" Size="16" /></BbButton>
                            <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" AriaLabel="Move tab right" OnClick="() => Mutate(() => DocTypeDesign.MoveItem(design.Tabs, ct, 1))"><LucideIcon Name="arrow-right" Size="16" /></BbButton>
                            <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" AriaLabel="Delete tab" Disabled="@(!ct.IsEmpty || design.Tabs.Count == 1)"
                                      OnClick="() => Mutate(() => { design.RemoveTab(ct); currentTab = design.Tabs[0]; })"><LucideIcon Name="trash-2" Size="16" /></BbButton>
                        </div>

                        @foreach (var section in ct.Sections)
                        {
                            var sec = section;
                            <div class="d-section @(sec == currentSection ? "current" : "")" @onclick="() => currentSection = sec">
                                <div class="d-section-head">
                                    <BbInput Value="@sec.Title" ValueChanged="v => Mutate(() => sec.Title = string.IsNullOrWhiteSpace(v) ? null : v.Trim())" Placeholder="Section title (optional)" AriaLabel="Section title" />
                                    <div class="col-select">
                                        <BbSelect TValue="string" Value="@sec.Columns.Count.ToString()" ValueChanged="v => Mutate(() => design.SetColumns(sec, int.Parse(v!)))" AriaLabel="Number of columns"
                                                  Options="ColumnOptions" />
                                    </div>
                                    <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" AriaLabel="Move section up" OnClick="() => Mutate(() => DocTypeDesign.MoveItem(ct.Sections, sec, -1))"><LucideIcon Name="arrow-up" Size="16" /></BbButton>
                                    <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" AriaLabel="Move section down" OnClick="() => Mutate(() => DocTypeDesign.MoveItem(ct.Sections, sec, 1))"><LucideIcon Name="arrow-down" Size="16" /></BbButton>
                                    <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" AriaLabel="Delete section" Disabled="@(!sec.IsEmpty)" OnClick="() => Mutate(() => design.RemoveSection(ct, sec))"><LucideIcon Name="trash-2" Size="16" /></BbButton>
                                </div>
                                <div class="d-cols cols-@sec.Columns.Count">
                                    @for (var c = 0; c < sec.Columns.Count; c++)
                                    {
                                        var col = c;
                                        var fields = sec.Columns[col];
                                        <div class="d-col @(dragging ? "dropping" : "") @(IsHint(sec, col, fields.Count) ? "hint-end" : "")"
                                             @ondragover:preventDefault="true" @ondragenter="() => Hint(sec, col, fields.Count)" @ondrop="() => Drop(sec, col, null)">
                                            @for (var i = 0; i < fields.Count; i++)
                                            {
                                                var idx = i; var f = fields[i];
                                                <div class="d-field @(f == selected ? "selected" : "") @(IsHint(sec, col, idx) ? "hint-before" : "") @(HasErrors(f) ? "has-error" : "")"
                                                     draggable="true" tabindex="0" role="button" aria-pressed="@(f == selected)"
                                                     @ondragstart="() => StartMove(f)" @ondragend="EndDrag"
                                                     @ondragover:preventDefault="true" @ondragenter="() => Hint(sec, col, idx)"
                                                     @ondrop="() => Drop(sec, col, idx)" @ondrop:stopPropagation="true"
                                                     @onclick="() => Select(f, sec)" @onclick:stopPropagation="true"
                                                     @onkeydown="@(e => { if (e.Key is "Enter" or " ") Select(f, sec); })">
                                                    <LucideIcon Name="grip-vertical" Size="14" Class="grip" />
                                                    <div class="d-field-main">
                                                        <div class="d-field-label">@(string.IsNullOrWhiteSpace(f.Label) ? f.Name : f.Label)@if (f.RequiredWhen is not null) { <span class="req" title="@(f.RequiredWhen == "true" ? "Required" : $"Required when {f.RequiredWhen}")">*</span> }</div>
                                                        <div class="d-field-meta">
                                                            <span>@f.Type</span>
                                                            @if (f.Compute is not null) { <span title="Formula: @f.Compute">fx</span> }
                                                            @if (f.FetchFrom is not null) { <span title="Fetched from @f.FetchFrom">↙ @f.FetchFrom.Split('.')[0]</span> }
                                                            @if (f.VisibleWhen is not null) { <span title="Visible when @f.VisibleWhen">conditional</span> }
                                                            @if (f.PermLevel > 0) { <span title="Permission level @f.PermLevel">level @f.PermLevel</span> }
                                                            @if (f.InListView) { <span title="Column in list">list</span> }
                                                        </div>
                                                    </div>
                                                    <div class="d-field-actions" @onclick:stopPropagation="true">
                                                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" AriaLabel="@($"Move {f.Name} up")" OnClick="() => Mutate(() => design.MoveBy(f, -1))"><LucideIcon Name="chevron-up" Size="14" /></BbButton>
                                                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" AriaLabel="@($"Move {f.Name} down")" OnClick="() => Mutate(() => design.MoveBy(f, 1))"><LucideIcon Name="chevron-down" Size="14" /></BbButton>
                                                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" AriaLabel="@($"Delete {f.Name}")" OnClick="() => RemoveField(f)"><LucideIcon Name="trash-2" Size="14" /></BbButton>
                                                    </div>
                                                </div>
                                            }
                                            @if (fields.Count == 0) { <div class="d-empty">Drag field here</div> }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="() => Mutate(() => currentSection = design.AddSection(ct))"><LucideIcon Name="plus" Size="15" /> Add section</BbButton>
                    }
                </section>
            </div>
        </BbTabsContent>

        <BbTabsContent Value="preview">
            @if (snapshot is not null && snapshot.TryGet(design.Def.Name, out var compiled))
            {
                <div style="margin-top:.75rem">
                    @if (compiled.Def.IsChild)
                    {
                        <BbAlert Variant="AlertVariant.Info"><BbAlertDescription>This is a child table DocType. Preview displays a single row as a form.</BbAlertDescription></BbAlert>
                    }
                    <DesignerPreview Meta="compiled" Snapshot="snapshot" />
                </div>
            }
            else
            {
                <BbAlert Variant="AlertVariant.Warning" Class="props-block"><BbAlertDescription>Fix issues in the draft to see the preview.</BbAlertDescription></BbAlert>
            }
        </BbTabsContent>

        <BbTabsContent Value="access">
            @if (!design.Def.IsChild)
            {
                <div class="stack" style="margin-top:.75rem">
                    <BbCard>
                        <BbCardHeader>
                            <BbCardTitle Class="card-title">Approval workflow</BbCardTitle>
                            <BbCardDescription>
                                @if (ActiveWorkflow is { } w) { <span>Using workflow <strong>@w.Name</strong> v@(w.Version). Configured in workflow editor and published separately.</span> }
                                else { <span>No workflow assigned: document uses Submit/Cancel buttons according to document rules below.</span> }
                            </BbCardDescription>
                        </BbCardHeader>
                        <BbCardContent>
                            @if (ActiveWorkflow is { } aw)
                            {
                                <WorkflowDiagram Workflow="aw" />
                                <div class="row" style="margin-top:.75rem"><BbButton Variant="ButtonVariant.Outline" Href="@($"/admin/workflows/{aw.Name}/editor")" OnClick="@(() => Nav.NavigateTo($"/admin/workflows/{aw.Name}/editor"))"><LucideIcon Name="git-branch" Size="16" /> Edit workflow</BbButton></div>
                            }
                            else
                            {
                                <div class="stack" style="gap:.65rem">
                                    @if (AvailableWorkflows.Any())
                                    {
                                        <BbField>
                                            <BbFieldLabel>Link an existing workflow</BbFieldLabel>
                                            <BbSelect TValue="string" Value="@(workflowToLink ?? "")" ValueChanged="v => workflowToLink = string.IsNullOrWhiteSpace(v) ? null : v" Options="WorkflowOptions" AriaLabel="Workflow to link" />
                                        </BbField>
                                        <BbButton Variant="ButtonVariant.Outline" Disabled="@(string.IsNullOrWhiteSpace(workflowToLink))" OnClick="LinkWorkflow">
                                            <LucideIcon Name="link" Size="16" /> Link selected workflow
                                        </BbButton>
                                    }
                                    <BbButton Href="@($"/admin/workflows/new?doctype={design.Def.Name}")" OnClick="@(() => Nav.NavigateTo($"/admin/workflows/new?doctype={design.Def.Name}"))"><LucideIcon Name="git-branch-plus" Size="16" /> Create workflow</BbButton>
                                    <BbButton Variant="ButtonVariant.Ghost" Href="/admin/workflows" OnClick="@(() => Nav.NavigateTo("/admin/workflows"))">Manage all workflows</BbButton>
                                </div>
                            }
                        </BbCardContent>
                    </BbCard>
                    <AccessEditor Def="design.Def" Fields="design.AllFields" Snapshot="(lastGoodSnapshot ?? Registry.Current)" Errors="errors" OnChanged="Recompile" />
                </div>
            }
        </BbTabsContent>

        <BbTabsContent Value="hooks">
            <div class="stack" style="margin-top:.75rem">
                <BbCard>
                    <BbCardHeader>
                        <BbCardTitle Class="card-title">Visual document hooks</BbCardTitle>
                        <BbCardDescription>Declarative rules run during the document lifecycle. Only the listed conditions and actions are supported; scripts are not executed.</BbCardDescription>
                    </BbCardHeader>
                    <BbCardContent>
                        @foreach (var (hook, index) in design.Def.Hooks.Select((hook, index) => (hook, index)).ToList())
                        {
                            var currentHook = hook;
                            var hookIndex = index;
                            <div class="props-block">
                                <div class="row">
                                    <BbField><BbFieldLabel>Name</BbFieldLabel><BbInput Value="@currentHook.Name" ValueChanged="v => Mutate(() => currentHook.Name = v?.Trim() ?? string.Empty)" /></BbField>
                                    <BbField><BbFieldLabel>Event</BbFieldLabel><BbSelect TValue="string" Value="@currentHook.Event" ValueChanged="v => Mutate(() => currentHook.Event = v ?? currentHook.Event)" Options="HookEventOptions" AriaLabel="Hook event" /></BbField>
                                    <div class="label-row"><BbCheckbox Checked="@currentHook.Enabled" CheckedChanged="v => Mutate(() => currentHook.Enabled = v)" /><span>Enabled</span></div>
                                    <BbButton Variant="ButtonVariant.Ghost" OnClick="() => RemoveVisualHook(hookIndex)"><LucideIcon Name="trash-2" Size="15" /> Remove</BbButton>
                                </div>
                                <div class="props-group">
                                    <div class="props-group-title">CONDITION (OPTIONAL)</div>
                                    <div class="row">
                                        <BbSelect TValue="string" Value="@(currentHook.When?.Field ?? "")" ValueChanged="v => SetHookConditionField(currentHook, v)" Options="HookFieldOptions" AriaLabel="Condition field" />
                                        <BbSelect TValue="string" Value="@(currentHook.When?.Operator ?? "Equals")" ValueChanged="v => SetHookOperator(currentHook, v)" Options="HookOperatorOptions" AriaLabel="Condition operator" />
                                        <BbInput Value="@HookValueText(currentHook)" ValueChanged="v => SetHookConditionValue(currentHook, v)" Placeholder="Value (JSON supported)" />
                                        <BbButton Variant="ButtonVariant.Ghost" OnClick="() => Mutate(() => currentHook.When = null)">Clear condition</BbButton>
                                    </div>
                                </div>
                                @foreach (var (action, actionIndex) in currentHook.Actions.Select((action, actionIndex) => (action, actionIndex)).ToList())
                                {
                                    var currentAction = action;
                                    var currentActionIndex = actionIndex;
                                    <div class="props-group">
                                        <div class="props-group-title">ACTION @(actionIndex + 1)</div>
                                        <div class="row">
                                            <BbSelect TValue="string" Value="@currentAction.Type" ValueChanged="v => SetHookActionType(currentAction, v)" Options="HookActionOptions" AriaLabel="Hook action" />
                                            @if (currentAction.Type == "Reject")
                                            {
                                                <BbInput Value="@currentAction.Message" ValueChanged="v => Mutate(() => currentAction.Message = v)" Placeholder="Validation message" />
                                                <BbSelect TValue="string" Value="@(currentAction.Field ?? "")" ValueChanged="v => Mutate(() => currentAction.Field = string.IsNullOrWhiteSpace(v) ? null : v)" Options="HookFieldOptions" AriaLabel="Validation field" />
                                            }
                                            else if (currentAction.Type == "EmitEvent")
                                            {
                                                <BbInput Value="@currentAction.EventType" ValueChanged="v => Mutate(() => currentAction.EventType = v?.Trim())" Placeholder="event.type" />
                                            }
                                            <BbButton Variant="ButtonVariant.Ghost" OnClick="() => RemoveVisualAction(currentHook, currentActionIndex)"><LucideIcon Name="trash-2" Size="15" /> Remove</BbButton>
                                        </div>
                                    </div>
                                }
                                <BbButton Variant="ButtonVariant.Outline" OnClick="() => AddVisualAction(currentHook)"><LucideIcon Name="plus" Size="15" /> Add action</BbButton>
                            </div>
                        }
                        <BbButton OnClick="AddVisualHook"><LucideIcon Name="plus" Size="15" /> Add hook</BbButton>
                    </BbCardContent>
                </BbCard>
            </div>
        </BbTabsContent>

        <BbTabsContent Value="settings">
            <div class="stack" style="margin-top:.75rem">
                <BbCard>
                    <BbCardHeader>
                        <BbCardTitle Class="card-title">DocType Settings</BbCardTitle>
                        <BbCardDescription><code>@design.Def.Name</code> · Draft version v@(version)</BbCardDescription>
                    </BbCardHeader>
                    <BbCardContent>
                        <div class="props-group" style="border-top:none;padding-top:0">
                            <BbField><BbFieldLabel For="d-title">Title</BbFieldLabel><BbInput Id="d-title" Value="@design.Def.Title" ValueChanged="v => Mutate(() => design.Def.Title = v ?? string.Empty)" /></BbField>
                            <BbField><BbFieldLabel For="d-desc">Description</BbFieldLabel><BbTextarea Id="d-desc" Value="@design.Def.Description" UpdateTiming="UpdateTiming.OnChange" ValueChanged="v => Mutate(() => design.Def.Description = string.IsNullOrWhiteSpace(v) ? null : v)" /></BbField>
                            @if (!design.Def.IsChild)
                            {
                                <BbField><BbFieldLabel For="d-module">Modul (wajib, dari Master Modules)</BbFieldLabel><BbSelect TValue="string" Value="@(design.Def.Module ?? "")" ValueChanged="v => Mutate(() => design.Def.Module = string.IsNullOrWhiteSpace(v) ? null : v)" Options="ModuleOptions(design.Def.Module)" AriaLabel="Modul" /></BbField>
                                <BbField IsInvalid="@errors.Any(e => e.Path == "naming.pattern")">
                                    <BbFieldLabel For="d-naming">Naming series pattern</BbFieldLabel>
                                    <BbInput Id="d-naming" Class="code-input" Value="@design.Def.Naming.Pattern" ValueChanged="v => Mutate(() => design.Def.Naming.Pattern = v ?? string.Empty)" />
                                    <BbFieldDescription>Tokens: {YYYY}, {MM}, {#####} (series number).</BbFieldDescription>
                                </BbField>
                            }
                        </div>
                        @if (!design.Def.IsChild)
                        {
                            <div class="props-group">
                                <div class="props-group-title">List view</div>
                                <p class="muted small" style="margin:0 0 .5rem">List columns are configured per field ("Show as column in list").</p>
                                <div class="props-sub" style="margin-bottom:.5rem">Searchable fields (up to 10 rows per column)</div>
                                @{
                                    var searchableCols = design.AllFields
                                        .Where(f => f.Type is "Data" or "Text" or "Email" or "Select" or "Link")
                                        .Chunk(10)
                                        .ToList();
                                }
                                @if (searchableCols.Count == 0)
                                {
                                    <p class="muted small">No text, email, select, or link fields available to be designated as search fields.</p>
                                }
                                else
                                {
                                    <div class="searchable-cols-container" style="display:flex;flex-wrap:wrap;gap:1.25rem 2.5rem;align-items:flex-start;padding:.25rem 0">
                                        @foreach (var col in searchableCols)
                                        {
                                            <div class="searchable-col" style="display:flex;flex-direction:column;gap:.45rem;min-width:200px">
                                                @foreach (var fld in col)
                                                {
                                                    var curField = fld;
                                                    <div class="label-row" style="margin:0">
                                                        <BbCheckbox Id="@($"s-{curField.Name}")"
                                                                    Checked="design.Def.ListView.SearchFields.Contains(curField.Name)"
                                                                    CheckedChanged="v => Mutate(() => Toggle(design.Def.ListView.SearchFields, curField.Name, v))" />
                                                        <BbLabel For="@($"s-{curField.Name}")">@curField.Label</BbLabel>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        <p class="muted small">Access and workflow are configured in the <strong>Access &amp; Workflow</strong> tab; cross-field rules and print formats in the <strong>JSON</strong> tab.</p>
                    </BbCardContent>
                </BbCard>
            </div>
        </BbTabsContent>

        @if (!design.Def.IsChild)
        {
            <BbTabsContent Value="migration">
                <div class="stack" style="margin-top:.75rem">
                    <BbCard>
                        <BbCardHeader>
                            <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.5rem">
                                <div>
                                    <BbCardTitle Class="card-title">Data Migration Plan</BbCardTitle>
                                    <BbCardDescription>Data transformation plan for existing documents during schema version transition <code>v@(version - 1) &rarr; v@(version)</code></BbCardDescription>
                                </div>
                                @if (design.Def.DataMigration is not null)
                                {
                                    <BbBadge Variant="BadgeVariant.SoftSuccess">
                                        <LucideIcon Name="circle-check" Size="14" style="margin-right:.3rem" /> Migration Active (v@(design.Def.DataMigration.FromVersion) &rarr; v@(version))
                                    </BbBadge>
                                }
                                else
                                {
                                    <BbBadge Variant="BadgeVariant.Secondary">No Active Migration (Optional)</BbBadge>
                                }
                            </div>
                        </BbCardHeader>
                        <BbCardContent>
                            <div class="props-group" style="border-top:none;padding-top:0">
                                <div class="props-group-title">WHAT IS A DATA MIGRATION PLAN USED FOR?</div>
                                <p class="muted small" style="line-height:1.6;margin-bottom:.75rem">
                                    When modifying a DocType's schema (e.g. renaming fields, altering data types, or adding mandatory fields), existing documents in the database remain in their previous schema format.
                                    A <strong>Data Migration Plan</strong> ensures all existing documents are automatically transformed in a <strong>single atomic database transaction</strong> when you click <strong>Publish v@(version)</strong>.
                                </p>

                                <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(260px, 1fr));gap:1rem;margin-bottom:1rem">
                                    <div style="border:1px solid var(--border);border-radius:var(--radius);padding:.85rem;background:var(--muted)/15%">
                                        <div style="display:flex;align-items:center;gap:.5rem;font-weight:600;font-size:.875rem;margin-bottom:.35rem">
                                            <LucideIcon Name="pencil" Size="15" />
                                            <span>1. RenameField</span>
                                        </div>
                                        <p class="muted small" style="margin:0;line-height:1.45">
                                            Transfers data from an old field name to a new field name. Prevents loss of user-entered data when renaming fields.
                                        </p>
                                    </div>
                                    <div style="border:1px solid var(--border);border-radius:var(--radius);padding:.85rem;background:var(--muted)/15%">
                                        <div style="display:flex;align-items:center;gap:.5rem;font-weight:600;font-size:.875rem;margin-bottom:.35rem">
                                            <LucideIcon Name="circle-plus" Size="15" />
                                            <span>2. SetDefault</span>
                                        </div>
                                        <p class="muted small" style="margin:0;line-height:1.45">
                                            Populates a default value for new fields on all existing documents that do not yet have a value.
                                        </p>
                                    </div>
                                    <div style="border:1px solid var(--border);border-radius:var(--radius);padding:.85rem;background:var(--muted)/15%">
                                        <div style="display:flex;align-items:center;gap:.5rem;font-weight:600;font-size:.875rem;margin-bottom:.35rem">
                                            <LucideIcon Name="refresh-cw" Size="15" />
                                            <span>3. ConvertType</span>
                                        </div>
                                        <p class="muted small" style="margin:0;line-height:1.45">
                                            Normalizes and converts existing data values to match the newly assigned field type (e.g. from text to integer/decimal/date).
                                        </p>
                                    </div>
                                </div>

                                <BbAlert Variant="AlertVariant.Info" Class="props-block">
                                    <BbAlertTitle>Transactional &amp; Safe Execution</BbAlertTitle>
                                    <BbAlertDescription>
                                        The migration is executed in the same database transaction as the schema release when <strong>Publish v@(version)</strong> is clicked. You can safely verify data transformations in advance using the <strong>Run Validation Dry-Run</strong> button without modifying any stored data.
                                    </BbAlertDescription>
                                </BbAlert>
                            </div>

                            <div class="props-group">
                                <div class="props-group-title">JSON FORMAT &amp; STARTER TEMPLATES</div>
                                <p class="muted small" style="margin-bottom:.5rem">
                                    Click a starter template button below to insert ready-to-use JSON into the editor:
                                </p>
                                <div class="row" style="margin-bottom:1rem;flex-wrap:wrap;gap:.5rem">
                                    <BbButton Size="ButtonSize.Small" OnClick='() => InsertMigrationSample("rename")'>
                                        <LucideIcon Name="file-input" Size="14" /> Template: Rename Field
                                    </BbButton>
                                    <BbButton Size="ButtonSize.Small" OnClick='() => InsertMigrationSample("default")'>
                                        <LucideIcon Name="file-input" Size="14" /> Template: Set Default
                                    </BbButton>
                                    <BbButton Size="ButtonSize.Small" OnClick='() => InsertMigrationSample("combined")'>
                                        <LucideIcon Name="file-input" Size="14" /> Template: Combined (All Operations)
                                    </BbButton>
                                </div>
                            </div>

                            <div class="props-group">
                                <div class="props-group-title">DATA MIGRATION PLAN DEFINITION (JSON)</div>
                                <div class="code">
                                    <BbTextarea Value="@migrationJson"
                                                ValueChanged="v => migrationJson = v ?? string.Empty"
                                                UpdateTiming="UpdateTiming.OnChange"
                                                AriaLabel="Data migration plan JSON"
                                                AdditionalAttributes="@(new Dictionary<string, object> { ["rows"] = 10, ["spellcheck"] = "false" })" />
                                </div>
                                @if (migrationJsonError is not null)
                                {
                                    <BbAlert Variant="AlertVariant.Danger" Style="margin-top:.5rem">
                                        <BbAlertDescription>@migrationJsonError</BbAlertDescription>
                                    </BbAlert>
                                }

                                <div class="row" style="margin-top:.75rem;flex-wrap:wrap;gap:.5rem">
                                    <BbButton OnClick="ApplyMigrationPlan">
                                        <LucideIcon Name="check" Size="16" /> Apply Migration Plan to Draft
                                    </BbButton>
                                    @if (design.Def.DataMigration is not null)
                                    {
                                        <BbButton Variant="ButtonVariant.Secondary" OnClick="RunMigrationPreview">
                                            <LucideIcon Name="database" Size="16" /> Run Validation Dry-Run
                                        </BbButton>
                                        <BbButton Variant="ButtonVariant.Destructive" OnClick="ClearMigrationPlan">
                                            <LucideIcon Name="trash-2" Size="15" /> Clear Migration Plan
                                        </BbButton>
                                    }
                                </div>

                                @if (migrationPreview is { Valid: true })
                                {
                                    <BbAlert Variant="AlertVariant.Success" Style="margin-top:.75rem">
                                        <BbAlertTitle>Dry-Run Succeeded</BbAlertTitle>
                                        <BbAlertDescription>
                                            <strong>@migrationPreview.Documents</strong> document(s) are ready to be migrated upon publishing <code>v@(version)</code>.
                                        </BbAlertDescription>
                                    </BbAlert>
                                }
                                else if (migrationPreview is { Valid: false, Error: not null } failedPreview)
                                {
                                    <BbAlert Variant="AlertVariant.Danger" Style="margin-top:.75rem">
                                        <BbAlertTitle>Dry-Run Failed</BbAlertTitle>
                                        <BbAlertDescription>
                                            Data transformation validation failed: @failedPreview.Error
                                        </BbAlertDescription>
                                    </BbAlert>
                                }
                            </div>
                        </BbCardContent>
                    </BbCard>
                </div>
            </BbTabsContent>
        }

        <BbTabsContent Value="json">
            <div class="stack" style="margin-top:.75rem">
                <p class="muted small" style="margin:0">Complete draft definition. For features not yet in the visual editor (cross-field validation rules, print formats). Changes made here are applied to the design using the button below.</p>
                <div class="code"><BbTextarea Value="@json" ValueChanged="v => json = v ?? string.Empty" UpdateTiming="UpdateTiming.OnChange" AriaLabel="JSON draft"
                                              AdditionalAttributes="@(new Dictionary<string, object> { ["rows"] = 26, ["spellcheck"] = "false" })" /></div>
                @if (jsonError is not null) { <BbAlert Variant="AlertVariant.Danger"><BbAlertDescription>@jsonError</BbAlertDescription></BbAlert> }
                <div class="row"><BbButton Variant="ButtonVariant.Outline" OnClick="ApplyJson"><LucideIcon Name="check" Size="16" /> Apply JSON to design</BbButton></div>
            </div>
        </BbTabsContent>
    </BbTabs>

    <AdminDrawer Open="@isDrawerOpen"
                 OpenChanged="@OnDrawerOpenChanged"
                 WidthScale="@DrawerWidthScale"
                 Title="@DrawerTitle"
                 Description="@DrawerDescription">
        <ChildContent>
            @if (selected is not null && (snapshot is not null || lastGoodSnapshot is not null))
            {
                <FieldProperties Field="selected"
                                 Design="design"
                                 Snapshot="(snapshot ?? lastGoodSnapshot)!"
                                 Errors="errors"
                                 ShowHeader="false"
                                 OriginalName="@OriginalName(selected)"
                                 OnChanged="Recompile"
                                 OnRemove="() => RemoveField(selected)"
                                 OnClose="CloseDrawer" />
            }
        </ChildContent>
    </AdminDrawer>
}

@code {
    /// <summary>Pilihan modul dari Master Modules. Nilai lama yang belum ada di master tetap tampil agar bisa diperbaiki.</summary>
    private IEnumerable<SelectOption<string>> ModuleOptions(string? current)
    {
        var codes = RoleCatalogSvc.ModuleCodes(Current.Required.TenantId).OrderBy(c => c, StringComparer.Ordinal).ToList();
        if (!string.IsNullOrWhiteSpace(current) && !codes.Contains(current)) codes.Insert(0, current);
        return new[] { new SelectOption<string>("", "(pilih modul)") }.Concat(codes.Select(c => new SelectOption<string>(c, c)));
    }

    [Parameter] public string DocTypeName { get; set; } = "";
    /// <summary>Configurable drawer width multiplier (default 2.0 = 2x normal width).</summary>
    [Parameter] public double DrawerWidthScale { get; set; } = 2.0;

    private DocTypeDesign? design;
    private DocTypeDef? active;
    private string originalJson = "";
    private int version;
    private DesignerTab? currentTab;
    private DesignerSection? currentSection;
    private FieldDef? selected;
    private bool isDrawerOpen;
    private IReadOnlyList<MetadataError> errors = [];
    private MetadataSnapshot? snapshot, lastGoodSnapshot;
    private PublishPreview? preview;
    private DataMigrationPreviewResult? migrationPreview;
    private bool ack, dirty;
    private string view = "design";
    private string json = "";
    private string? jsonError;
    private string migrationJson = "";
    private string? migrationJsonError;

    private string DrawerTitle =>
        selected is not null
            ? (string.IsNullOrWhiteSpace(selected.Label) ? selected.Name : selected.Label)
            : "";

    private string? DrawerDescription =>
        selected is not null
            ? $"{selected.Name} · {selected.Type}"
            : null;

    private void CloseDrawer()
    {
        isDrawerOpen = false;
        selected = null;
    }

    private void OnDrawerOpenChanged(bool open)
    {
        isDrawerOpen = open;
        if (!open)
        {
            selected = null;
        }
    }

    // Drag & drop
    private string? dragType;
    private FieldDef? dragField;
    private bool dragging => dragType is not null || dragField is not null;
    private (DesignerSection Section, int Column, int Index)? hint;

    private static readonly IEnumerable<SelectOption<string>> ColumnOptions =
        [new("1", "1 column"), new("2", "2 columns"), new("3", "3 columns")];

    private WorkflowDef? ActiveWorkflow => design?.Def.Workflow is { } n ? Registry.Workflows.FirstOrDefault(w => w.Name == n) : null;
    private string? workflowToLink;
    private IEnumerable<WorkflowDef> AvailableWorkflows => Registry.Workflows
        .Where(w => w.Name != design?.Def.Workflow
                    && (string.IsNullOrWhiteSpace(w.DocType) || w.DocType == design?.Def.Name));
    private IEnumerable<SelectOption<string>> WorkflowOptions => new[] { new SelectOption<string>("", "Choose a workflow") }
        .Concat(AvailableWorkflows.OrderBy(w => w.Name).Select(w => new SelectOption<string>(w.Name, w.Name)));

    private static readonly IEnumerable<SelectOption<string>> HookEventOptions = [
        new("BeforeValidate", "Before Validate"), new("BeforeInsert", "Before Insert"),
        new("BeforeUpdate", "Before Update"), new("AfterSave", "After Save"), new("OnLoad", "On Load")];
    private static readonly IEnumerable<SelectOption<string>> HookOperatorOptions = [
        new("Equals", "Equals"), new("NotEquals", "Does not equal"), new("ChangedTo", "Changed to")];
    private static readonly IEnumerable<SelectOption<string>> HookActionOptions = [
        new("Reject", "Reject document"), new("EmitEvent", "Emit event")];
    private IEnumerable<SelectOption<string>> HookFieldOptions => new[] { new SelectOption<string>("", "Choose field") }
        .Concat(design?.AllFields.Select(f => new SelectOption<string>(f.Name, $"{f.Label} ({f.Name})")) ?? []);

    private void AddVisualHook() => Mutate(() => design!.Def.Hooks.Add(new DocHookDef
    {
        Name = $"hook-{design.Def.Hooks.Count + 1}", Actions = [new DocHookActionDef()]
    }));
    private void RemoveVisualHook(int index) => Mutate(() => design!.Def.Hooks.RemoveAt(index));
    private void AddVisualAction(DocHookDef hook) => Mutate(() => hook.Actions.Add(new DocHookActionDef()));
    private void RemoveVisualAction(DocHookDef hook, int index) => Mutate(() => hook.Actions.RemoveAt(index));
    private void SetHookConditionField(DocHookDef hook, string? field) => Mutate(() =>
    {
        if (string.IsNullOrWhiteSpace(field)) hook.When = null;
        else { hook.When ??= new DocHookConditionDef(); hook.When.Field = field; }
    });
    private void SetHookOperator(DocHookDef hook, string? op) => Mutate(() =>
    {
        hook.When ??= new DocHookConditionDef();
        hook.When.Operator = op ?? "Equals";
    });
    private void SetHookActionType(DocHookActionDef action, string? type) => Mutate(() => action.Type = type ?? "Reject");
    private void SetHookConditionValue(DocHookDef hook, string? value) => Mutate(() =>
    {
        if (hook.When is null) return;
        try { hook.When.Value = string.IsNullOrWhiteSpace(value) ? null : JsonDocument.Parse(value).RootElement.Clone(); }
        catch (JsonException) { hook.When.Value = JsonSerializer.SerializeToElement(value ?? ""); }
    });
    private static string HookValueText(DocHookDef hook) => hook.When?.Value is { } value ? value.GetRawText() : "";

    private void LinkWorkflow()
    {
        if (string.IsNullOrWhiteSpace(workflowToLink) || design is null) return;
        Nav.NavigateTo($"/admin/workflows/{Uri.EscapeDataString(workflowToLink)}/editor?doctype={Uri.EscapeDataString(design.Def.Name)}");
    }

    private IEnumerable<MetadataError> GeneralErrors => errors.Where(e => !e.Path.StartsWith("fields.") || design!.AllFields.All(f => !e.Path.StartsWith($"fields.{f.Name}")));

    // Blazor triggers OnParametersSet whenever the parent layout re-renders (e.g. notification count changes).
    // Reload only when the route parameter actually changes, so user inputs/drafts are not lost.
    private string? loadedKey;
    protected override void OnParametersSet()
    {
        if (DocTypeName == loadedKey) return;
        loadedKey = DocTypeName;
        Load();
    }

    private void Load()
    {
        if (!Registry.Current.TryGet(DocTypeName, out var meta)) { design = null; return; }
        workflowToLink = null;
        active = meta.Def;
        version = meta.Version + 1;
        design = DocTypeDesign.From(meta.Def);
        migrationJson = JsonSerializer.Serialize(new DataMigrationPlanDef { FromVersion = meta.Version }, MetadataJson.Options);
        migrationJsonError = null;
        originalJson = MetadataJson.Serialize(design.ToDef(version));
        currentTab = design.Tabs[0];
        currentSection = currentTab.Sections.FirstOrDefault();
        selected = null; preview = null; migrationPreview = null; ack = false;
        isDrawerOpen = false;
        Recompile();
    }

    private void ApplyMigrationPlan()
    {
        try
        {
            var plan = JsonSerializer.Deserialize<DataMigrationPlanDef>(migrationJson, MetadataJson.Options)
                ?? throw new JsonException("Migration plan JSON must be an object.");
            Mutate(() => design!.Def.DataMigration = plan);
            migrationJsonError = null;
            Toasts.Success("Data migration plan successfully applied to draft.", "Data Migration");
        }
        catch (JsonException ex) { migrationJsonError = $"Invalid migration plan JSON: {ex.Message}"; }
    }

    private void ClearMigrationPlan()
    {
        Mutate(() => design!.Def.DataMigration = null);
        migrationJson = JsonSerializer.Serialize(new DataMigrationPlanDef { FromVersion = version - 1 }, MetadataJson.Options);
        migrationJsonError = null;
        migrationPreview = null;
        Toasts.Success("Data migration plan removed from draft.", "Data Migration");
    }

    private void InsertMigrationSample(string sampleType)
    {
        var fromVer = version > 1 ? version - 1 : 1;
        migrationJson = sampleType switch
        {
            "rename" => JsonSerializer.Serialize(new
            {
                fromVersion = fromVer,
                operations = new object[]
                {
                    new { type = "RenameField", fromField = "old_field_name", toField = "new_field_name" }
                }
            }, new JsonSerializerOptions { WriteIndented = true }),

            "default" => JsonSerializer.Serialize(new
            {
                fromVersion = fromVer,
                operations = new object[]
                {
                    new { type = "SetDefault", field = "document_status", value = "Active" }
                }
            }, new JsonSerializerOptions { WriteIndented = true }),

            "combined" => JsonSerializer.Serialize(new
            {
                fromVersion = fromVer,
                operations = new object[]
                {
                    new { type = "RenameField", fromField = "old_code", toField = "code" },
                    new { type = "SetDefault", field = "is_active", value = true },
                    new { type = "ConvertType", field = "total_amount" }
                }
            }, new JsonSerializerOptions { WriteIndented = true }),

            _ => migrationJson
        };
        migrationJsonError = null;
    }

    private string? OriginalName(FieldDef f) =>
        active!.Fields.Any(a => a.Name == f.Name) ? f.Name
        : originalNames.TryGetValue(f, out var n) ? n : null;
    private readonly Dictionary<FieldDef, string> originalNames = new(ReferenceEqualityComparer.Instance);

    /// <summary>Writes design to metadata, compiles together with other active metadata, and updates state.</summary>
    private void Recompile()
    {
        var def = design!.ToDef(version);
        (snapshot, errors) = Registry.CompileDraft(def, RoleCatalogSvc.Scope(Current.Required.TenantId));
        if (snapshot is not null) lastGoodSnapshot = snapshot;
        var now = MetadataJson.Serialize(def);
        dirty = now != originalJson;
        if (view != "json") json = now;
        preview = null; migrationPreview = null; ack = false;
    }

    private void Mutate(Action change) { change(); Recompile(); }

    private void ChangeView(string? v)
    {
        if (v is null) return;
        if (v == "json") { json = MetadataJson.Serialize(design!.ToDef(version)); jsonError = null; }
        view = v;
        if (v != "design") isDrawerOpen = false;
    }

    // ---------- field ----------

    private void Select(FieldDef f, DesignerSection sec)
    {
        selected = f; currentSection = sec;
        isDrawerOpen = true;
        // Remember original name of existing field, so rename warning remains accurate after name is changed.
        if (active!.Fields.Any(a => a.Name == f.Name)) originalNames.TryAdd(f, f.Name);
    }

    private void AddByClick(string type)
    {
        var sec = currentSection ?? currentTab?.Sections.FirstOrDefault();
        if (sec is null || lastGoodSnapshot is null) return;
        var f = design!.AddField(type, sec, 0, null, lastGoodSnapshot);
        selected = f;
        isDrawerOpen = true;
        Recompile();
    }

    private void PaletteKey(KeyboardEventArgs e, string type)
    {
        if (e.Key is "Enter" or " ") AddByClick(type);
    }

    private async Task RemoveField(FieldDef f)
    {
        if (OriginalName(f) is not null)
        {
            var ok = await Dialogs.ConfirmAsync($"Delete field {f.Name}?",
                "This field already exists in the active version. Past data in this field will no longer be accessible after the new version is published (risky change).",
                new ConfirmDialogOptions { Destructive = true, ConfirmText = "Delete field", CancelText = "Cancel" });
            if (!ok.Confirmed) return;
        }
        design!.Remove(f);
        if (selected == f)
        {
            selected = null;
            isDrawerOpen = false;
        }
        Recompile();
    }

    // ---------- drag & drop ----------

    private void StartNew(string type) { dragType = type; dragField = null; }
    private void StartMove(FieldDef f) { dragField = f; dragType = null; }
    private void EndDrag() { dragType = null; dragField = null; hint = null; }
    private void Hint(DesignerSection s, int c, int i) => hint = (s, c, i);
    private bool IsHint(DesignerSection s, int c, int i) => dragging && hint is { } h && h.Section == s && h.Column == c && h.Index == i;

    private void Drop(DesignerSection sec, int col, int? index)
    {
        if (dragField is { } f) { design!.Move(f, sec, col, index); selected = f; }
        else if (dragType is { } type && lastGoodSnapshot is not null) selected = design!.AddField(type, sec, col, index, lastGoodSnapshot);
        currentSection = sec;
        isDrawerOpen = true;
        EndDrag();
        Recompile();
    }

    // ---------- tab ----------

    private void SelectTab(DesignerTab t) { currentTab = t; currentSection = t.Sections.FirstOrDefault(); }
    private void AddTab() => Mutate(() => { currentTab = design!.AddTab(); currentSection = currentTab.Sections[0]; });
    private static int CountFields(DesignerTab t) => t.Sections.Sum(s => s.Columns.Sum(c => c.Count));

    private static void Toggle(List<string> list, string name, bool on)
    {
        if (on && !list.Contains(name)) list.Add(name);
        if (!on) list.Remove(name);
    }

    // ---------- JSON, review, publish ----------

    private void ApplyJson()
    {
        try
        {
            var def = MetadataJson.ParseDocType(json);
            if (def.Name != DocTypeName) { jsonError = $"DocType name cannot be changed here (must be '{DocTypeName}')."; return; }
            design = DocTypeDesign.From(def);
            currentTab = design.Tabs[0]; currentSection = currentTab.Sections.FirstOrDefault(); selected = null;
            isDrawerOpen = false;
            jsonError = null;
            Recompile();
            Toasts.Success("JSON applied to design.", "Applied");
        }
        catch (JsonException ex) { jsonError = $"Invalid JSON: {ex.Message}"; }
    }

    private void Check()
    {
        preview = Registry.Preview(design!.ToDef(version), RoleCatalogSvc.Scope(Current.Required.TenantId));
        migrationPreview = null;
    }

    private void RunMigrationPreview()
    {
        var draft = design!.ToDef(version);
        preview = Registry.Preview(draft, RoleCatalogSvc.Scope(Current.Required.TenantId));
        migrationPreview = preview.Valid && draft.DataMigration is not null
            ? Registry.PreviewDataMigration(draft, scope: RoleCatalogSvc.Scope(Current.Required.TenantId))
            : null;
    }

    private void Publish()
    {
        try
        {
            var draft = design!.ToDef(version);
            var migratedDocuments = draft.DataMigration is null ? 0 : migrationPreview is { Valid: true } result
                ? result.Documents
                : throw new InvalidOperationException("Run a successful migration dry-run before publishing.");
            var v = Registry.Publish(draft, Current.Required.Id, ack, migratedDocuments, RoleCatalogSvc.Scope(Current.Required.TenantId));
            Toasts.Success("Forms, lists, and APIs will immediately use this version.", $"{v.DocType} v{v.Version} published");
            Load();
        }
        catch (Exception ex) when (ex is MetadataCompilationException or InvalidOperationException)
        {
            Toasts.Error(ex.Message, "Failed to publish");
        }
    }

    private async Task Discard()
    {
        var ok = await Dialogs.ConfirmAsync("Discard all changes?", "Draft will be reverted to the active version.",
            new ConfirmDialogOptions { ConfirmText = "Discard changes", CancelText = "Cancel" });
        if (ok.Confirmed) Load();
    }

    private static string RiskLabel(ChangeRisk r) => r switch { ChangeRisk.Safe => "Safe", ChangeRisk.NeedsTransform => "Needs transform", _ => "Risky" };
    private static BadgeVariant RiskVariant(ChangeRisk r) => r switch { ChangeRisk.Safe => BadgeVariant.SoftSuccess, ChangeRisk.NeedsTransform => BadgeVariant.Warning, _ => BadgeVariant.SoftDestructive };

    private bool HasErrors(FieldDef f) => errors.Any(e => e.Path == $"fields.{f.Name}" || e.Path.StartsWith($"fields.{f.Name}."));

    private static string TypeIcon(string t) => t switch
    {
        "Data" => "type", "Text" => "align-left", "Email" => "mail", "Int" => "hash", "Float" => "sigma", "Currency" => "banknote",
        "Check" => "square-check", "Date" => "calendar", "Select" => "list", "Link" => "link", "Table" => "table", "Image" => "image", _ => "square"
    };

    private static string TypeLabel(string t) => t switch
    {
        "Data" => "Short text", "Text" => "Long text", "Email" => "Email", "Int" => "Integer", "Float" => "Decimal",
        "Currency" => "Currency", "Check" => "Checkbox", "Date" => "Date", "Select" => "Select", "Link" => "Link to DocType", "Table" => "Child table", "Image" => "Image", _ => t
    };
}

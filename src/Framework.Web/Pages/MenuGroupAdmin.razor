@page "/admin/menu-groups"
@using Framework.Navigation
@using Framework.Security
@inject INavigationMenuStore MenuStore
@inject CurrentUser Current
@inject ToastService Toasts
@inject DialogService Dialogs

<PageTitle>Master Group Menu · DocFrame</PageTitle>

@if (!Current.Required.IsAdmin)
{
    <BbAlert Variant="AlertVariant.Danger"><BbAlertDescription>Halaman ini hanya untuk Administrator / System Manager.</BbAlertDescription></BbAlert>
}
else
{
    <header class="page-head">
        <div>
            <h1>Master Group Menu</h1>
            <p>Kelola pengelompokan menu di dalam setiap modul. Setiap group menu terhubung ke satu modul dan menampung daftar menu.</p>
        </div>
        <div class="row" style="gap:.5rem">
            <BbButton Variant="ButtonVariant.Outline" Disabled="busy" OnClick="ResetDefaults"><LucideIcon Name="rotate-ccw" Size="16" /> Seed Default</BbButton>
            <BbButton OnClick="StartCreate"><LucideIcon Name="plus" Size="16" /> Tambah group menu</BbButton>
        </div>
    </header>

    <BbDataGrid TData="NavigationMenuGroup"
                Items="@groups"
                ShowSearch="true"
                SearchPlaceholder="Cari group menu..."
                ShowPagination="true"
                InitialPageSize="10"
                TableContainerClass="table-wrap"
                RowClass="@(g => edit?.Id == g.Id ? "selected" : "")">
        <Columns>
            <BbDataGridPropertyColumn TData="NavigationMenuGroup" TProp="int" Property="g => g.SortOrder" Title="Urutan" Width="5rem" Sortable="true">
                <CellTemplate Context="item">
                    <code>@item.SortOrder</code>
                </CellTemplate>
            </BbDataGridPropertyColumn>

            <BbDataGridPropertyColumn TData="NavigationMenuGroup" TProp="string" Property="g => g.Name" Title="Group Menu" Width="15rem" Sortable="true" Filterable="true">
                <CellTemplate Context="item">
                    <div class="row" style="gap:.5rem;align-items:center;flex-wrap:nowrap">
                        <LucideIcon Name="@(string.IsNullOrWhiteSpace(item.Icon) ? "folder" : item.Icon)" Size="16" />
                        <strong>@item.Name</strong>
                    </div>
                </CellTemplate>
            </BbDataGridPropertyColumn>

            <BbDataGridTemplateColumn TData="NavigationMenuGroup" Title="Modul Induk" Sortable="true" SortBy="g => ModuleName(g.ModuleId)">
                <ChildContent Context="item">
                    @{
                        var mod = modules.FirstOrDefault(m => m.Id == item.ModuleId);
                    }
                    @if (mod is not null)
                    {
                        <BbBadge Variant="BadgeVariant.Soft">
                            <span class="row" style="gap:.35rem;flex-wrap:nowrap">
                                <LucideIcon Name="@(string.IsNullOrWhiteSpace(mod.Icon) ? "layout-grid" : mod.Icon)" Size="13" />
                                <span>@mod.Name</span>
                            </span>
                        </BbBadge>
                    }
                    else
                    {
                        <span class="muted small">—</span>
                    }
                </ChildContent>
            </BbDataGridTemplateColumn>

            <BbDataGridTemplateColumn TData="NavigationMenuGroup" Title="Jumlah Menu" Width="9rem">
                <ChildContent Context="item">
                    @{
                        var cnt = menus.Count(m => m.GroupId == item.Id || (string.IsNullOrWhiteSpace(m.GroupId) && string.Equals(m.GroupName, item.Name, StringComparison.OrdinalIgnoreCase)));
                    }
                    <BbBadge Variant="BadgeVariant.Outline">@cnt menu</BbBadge>
                </ChildContent>
            </BbDataGridTemplateColumn>

            <BbDataGridTemplateColumn TData="NavigationMenuGroup" Title="Status" Width="9rem" Sortable="true" SortBy="g => g.IsActive">
                <ChildContent Context="item">
                    <div class="row" style="gap:.25rem;flex-wrap:nowrap">
                        @if (item.IsSystem)
                        {
                            <BbBadge Variant="BadgeVariant.Soft">Sistem</BbBadge>
                        }
                        @if (item.IsActive)
                        {
                            <BbBadge Variant="BadgeVariant.SoftSuccess">Aktif</BbBadge>
                        }
                        else
                        {
                            <BbBadge Variant="BadgeVariant.Secondary">Nonaktif</BbBadge>
                        }
                    </div>
                </ChildContent>
            </BbDataGridTemplateColumn>

            <BbDataGridTemplateColumn TData="NavigationMenuGroup" Title="Aksi" Width="6.5rem" NoWrap="true">
                <ChildContent Context="item">
                    <div style="display:inline-flex;align-items:center;gap:.25rem;flex-wrap:nowrap" @onclick:stopPropagation="true">
                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" AriaLabel="Edit group menu" OnClick="() => StartEdit(item)">
                            <LucideIcon Name="pencil" Size="15" />
                        </BbButton>
                        @if (!item.IsSystem)
                        {
                            <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" AriaLabel="Hapus group menu" OnClick="() => ConfirmDelete(item)">
                                <LucideIcon Name="trash-2" Size="15" />
                            </BbButton>
                        }
                    </div>
                </ChildContent>
            </BbDataGridTemplateColumn>
        </Columns>
        <EmptyTemplate>
            <div style="padding:2rem;text-align:center;color:var(--muted-foreground)">
                Tidak ada group menu yang ditemukan.
            </div>
        </EmptyTemplate>
    </BbDataGrid>

    <AdminDrawer Open="@isDrawerOpen"
                 OpenChanged="@OnDrawerOpenChanged"
                 WidthScale="@DrawerWidthScale"
                 Title="@(edit is null ? "" : isNew ? "Tambah Group Menu" : $"Edit: {edit.Name}")"
                 Description="@(edit is null ? null : edit.IsSystem ? "Group menu bawaan sistem (tidak dapat dihapus, namun dapat diatur modul induk, nama, ikon, dan urutannya)." : "Group menu kustom aplikasi.")">
        <ChildContent>
            @if (edit is not null)
            {
                @if (error is not null)
                {
                    <BbAlert Variant="AlertVariant.Danger"><BbAlertDescription>@error</BbAlertDescription></BbAlert>
                }

                <div class="form-cols cols-2">
                    <BbField>
                        <BbFieldLabel For="grp-module">Modul Induk</BbFieldLabel>
                        <select id="grp-module" class="auth-input" value="@edit.ModuleId" @onchange="e => edit.ModuleId = e.Value as string ?? string.Empty">
                            <option value="">— Pilih Modul —</option>
                            @foreach (var m in modules)
                            {
                                <option value="@m.Id">@m.Name</option>
                            }
                        </select>
                        <BbFieldDescription>Modul tempat group menu ini ditampilkan pada sidebar.</BbFieldDescription>
                    </BbField>

                    <BbField>
                        <BbFieldLabel For="grp-name">Nama Group Menu</BbFieldLabel>
                        <FormTextInput Id="grp-name" Immediate="true" @bind-Value="edit.Name" Placeholder="mis. Transaksi, Master Data, Organisasi, Laporan" />
                        <BbFieldDescription>Nama sub-bagian yang muncul di sidebar di bawah modul aktif.</BbFieldDescription>
                    </BbField>
                </div>

                <div class="form-cols cols-2">
                    <BbField>
                        <BbFieldLabel For="grp-icon">Ikon Lucide</BbFieldLabel>
                        <div class="row" style="gap:.5rem;align-items:center;flex-wrap:nowrap">
                            <FormTextInput Id="grp-icon" Immediate="true" @bind-Value="edit.Icon" Placeholder="mis. folder, users, shopping-cart, database" />
                            <div style="display:flex;align-items:center;justify-content:center;width:2.5rem;height:2.5rem;border:1px solid var(--border);border-radius:var(--radius);background:var(--muted);flex-shrink:0">
                                <LucideIcon Name="@(string.IsNullOrWhiteSpace(edit.Icon) ? "folder" : edit.Icon)" Size="18" />
                            </div>
                        </div>
                    </BbField>

                    <BbField>
                        <BbFieldLabel For="grp-order">Urutan (Sort Order)</BbFieldLabel>
                        <FormTextInput Id="grp-order" Type="number" Immediate="true" Value="@edit.SortOrder.ToString()" ValueChanged="v => edit.SortOrder = int.TryParse(v, out var n) ? n : edit.SortOrder" />
                        <BbFieldDescription>Angka lebih kecil tampil lebih di atas dalam modul yang sama (mis. 10, 20, 30).</BbFieldDescription>
                    </BbField>
                </div>

                <div class="label-row" style="margin-top:.5rem">
                    <BbCheckbox Id="grp-active" Checked="edit.IsActive" CheckedChanged="v => edit.IsActive = v" />
                    <BbLabel For="grp-active">Aktif (ditampilkan di sidebar)</BbLabel>
                </div>
            }
        </ChildContent>
        <FooterContent>
            @if (edit is not null)
            {
                <div class="row" style="gap:.5rem;width:100%;align-items:center">
                    <BbButton Disabled="busy" Loading="busy" LoadingText="Menyimpan…" OnClick="Save"><LucideIcon Name="check" Size="16" /> Simpan</BbButton>
                    <BbButton Variant="ButtonVariant.Ghost" OnClick="CloseDrawer">Batal</BbButton>
                    @if (!isNew && !edit.IsSystem)
                    {
                        <span style="margin-left:auto">
                            <BbButton Variant="ButtonVariant.Destructive" Size="ButtonSize.Small" Disabled="busy" OnClick="() => ConfirmDelete(edit)">
                                <LucideIcon Name="trash-2" Size="15" /> Hapus
                            </BbButton>
                        </span>
                    }
                </div>
            }
        </FooterContent>
    </AdminDrawer>
}

@code {
    /// <summary>Configurable drawer width multiplier (default 2.0 = 2x normal width).</summary>
    [Parameter] public double DrawerWidthScale { get; set; } = 2.0;

    private IReadOnlyList<NavigationModule> modules = [];
    private IReadOnlyList<NavigationMenuGroup> groups = [];
    private IReadOnlyList<NavigationMenuItem> menus = [];
    private NavigationMenuGroup? edit;
    private bool isDrawerOpen;
    private bool isNew;
    private bool busy;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        if (Current.User is null) return;
        await Reload();
    }

    private async Task Reload()
    {
        var tenantId = Current.Required.TenantId;
        modules = await MenuStore.ListModulesAsync(tenantId, onlyActive: false);
        groups = await MenuStore.ListGroupsAsync(tenantId, onlyActive: false);
        menus = await MenuStore.ListAsync(tenantId, onlyActive: false);
    }

    private string ModuleName(string moduleId) =>
        modules.FirstOrDefault(m => m.Id == moduleId)?.Name ?? "";

    private void StartCreate()
    {
        error = null;
        isNew = true;
        edit = new NavigationMenuGroup
        {
            Id = Guid.NewGuid().ToString("N"),
            TenantId = Current.Required.TenantId,
            ModuleId = modules.FirstOrDefault()?.Id ?? "",
            Name = "",
            Icon = "folder",
            SortOrder = groups.Count > 0 ? groups.Max(g => g.SortOrder) + 10 : 10,
            IsActive = true,
            IsSystem = false
        };
        isDrawerOpen = true;
    }

    private void StartEdit(NavigationMenuGroup item)
    {
        error = null;
        isNew = false;
        edit = new NavigationMenuGroup
        {
            Id = item.Id,
            TenantId = item.TenantId,
            ModuleId = item.ModuleId,
            Name = item.Name,
            Icon = item.Icon,
            SortOrder = item.SortOrder,
            IsSystem = item.IsSystem,
            IsActive = item.IsActive,
            CreatedAt = item.CreatedAt,
            UpdatedAt = item.UpdatedAt
        };
        isDrawerOpen = true;
    }

    private void CloseDrawer()
    {
        isDrawerOpen = false;
    }

    private void OnDrawerOpenChanged(bool open)
    {
        isDrawerOpen = open;
        if (!open)
        {
            edit = null;
            error = null;
        }
    }

    private async Task Save()
    {
        if (edit is null || busy) return;
        if (string.IsNullOrWhiteSpace(edit.ModuleId))
        {
            error = "Pilih modul induk terlebih dahulu.";
            Toasts.Error(error, "Gagal Menyimpan");
            return;
        }
        if (string.IsNullOrWhiteSpace(edit.Name))
        {
            error = "Nama group menu tidak boleh kosong.";
            Toasts.Error(error, "Gagal Menyimpan");
            return;
        }

        edit.Name = edit.Name.Trim();
        edit.Icon = string.IsNullOrWhiteSpace(edit.Icon) ? "folder" : edit.Icon.Trim();

        busy = true;
        error = null;
        StateHasChanged();

        try
        {
            await MenuStore.SaveGroupAsync(edit);
            Toasts.Success($"Group menu \"{edit.Name}\" berhasil disimpan.", "Berhasil Disimpan");
            isDrawerOpen = false;
            await Reload();
        }
        catch (Exception ex)
        {
            error = ex.Message;
            Toasts.Error(ex.Message, "Gagal Menyimpan");
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ConfirmDelete(NavigationMenuGroup item)
    {
        if (item.IsSystem)
        {
            Toasts.Error("Group menu sistem bawaan tidak dapat dihapus.", "Tidak Diizinkan");
            return;
        }

        var res = await Dialogs.ConfirmAsync(
            $"Hapus group menu \"{item.Name}\"?",
            "Group menu ini akan dihapus apabila tidak lagi memiliki item menu. Tindakan ini tidak bisa dibatalkan.",
            new ConfirmDialogOptions { Destructive = true, ConfirmText = "Hapus Group", CancelText = "Batal" });

        if (!res.Confirmed) return;

        busy = true;
        try
        {
            await MenuStore.DeleteGroupAsync(item.Id, item.TenantId);
            if (edit?.Id == item.Id) isDrawerOpen = false;
            Toasts.Success($"Group menu \"{item.Name}\" berhasil dihapus.", "Group Dihapus");
            await Reload();
        }
        catch (Exception ex)
        {
            Toasts.Error(ex.Message, "Gagal Menghapus Group");
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ResetDefaults()
    {
        var res = await Dialogs.ConfirmAsync(
            "Seed / Pulihkan Group Menu Wajib?",
            "Sistem akan memeriksa dan menambahkan modul, group menu, serta menu wajib bawaan yang belum ada di database.",
            new ConfirmDialogOptions { ConfirmText = "Jalankan Seed", CancelText = "Batal" });

        if (!res.Confirmed) return;

        busy = true;
        try
        {
            await MenuStore.EnsureDefaultMenusAsync(Current.Required.TenantId);
            Toasts.Success("Group menu default berhasil diperiksa dan di-seed.", "Seed Berhasil");
            await Reload();
        }
        catch (Exception ex)
        {
            Toasts.Error(ex.Message, "Gagal Seed Group Menu");
        }
        finally
        {
            busy = false;
        }
    }
}

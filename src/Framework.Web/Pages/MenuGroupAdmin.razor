@page "/admin/menu-groups"
@using Framework.Navigation
@using Framework.Security
@inject INavigationMenuStore MenuStore
@inject CurrentUser Current
@inject ToastService Toasts
@inject DialogService Dialogs
@inject Framework.Preferences.IUserPreferenceStore UserPrefs
@implements IDisposable

<PageTitle>Master Menu Groups · DocFrame</PageTitle>

@if (!Current.Required.IsAdmin)
{
    <BbAlert Variant="AlertVariant.Danger"><BbAlertDescription>This page is only accessible to Administrators / System Managers.</BbAlertDescription></BbAlert>
}
else
{
    <header class="page-head">
        <div>
            <h1>Master Menu Groups</h1>
            <p>Manage menu grouping within each module. Each menu group belongs to one module and contains navigation menu items.</p>
        </div>
        <div class="row" style="gap:.5rem">
            <BbButton Variant="ButtonVariant.Outline" Disabled="busy" OnClick="ResetDefaults"><LucideIcon Name="rotate-ccw" Size="16" /> Seed Defaults</BbButton>
            <BbButton OnClick="StartCreate"><LucideIcon Name="plus" Size="16" /> Add menu group</BbButton>
        </div>
    </header>

    <BbDataGrid TData="NavigationMenuGroup"
                Items="@groups"
                ShowSearch="true"
                SearchPlaceholder="Search menu groups..."
                ShowPagination="true"
                InitialPageSize="10"
                TableContainerClass="table-wrap"
                RowClass="@(g => edit?.Id == g.Id ? "selected" : "")"
                Resizable="true"
                OnColumnResize="gridMgr.HandleResize"
                StateChanged="gridMgr.HandleStateChanged">
        <Toolbar>
            <div style="display:flex;align-items:center;gap:.5rem;margin-left:auto">
                @if (gridMgr.HasCustomLayout)
                {
                    <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" OnClick="ResetColumnsLayout" Title="Reset kolom ke bawaan">
                        <LucideIcon Name="rotate-ccw" Size="14" />
                        <span>Reset Kolom</span>
                    </BbButton>
                }
                <BbDataGridColumnVisibility TData="NavigationMenuGroup" />
            </div>
        </Toolbar>
        <Columns>
            <BbDataGridPropertyColumn TData="NavigationMenuGroup" TProp="int" Property="g => g.SortOrder" Id="order" Title="Order"
                                      Width="@gridMgr.GetWidth("order", "5rem")" Visible="@gridMgr.IsVisible("order")" Resizable="true" Sortable="true">
                <CellTemplate Context="item">
                    <code>@item.SortOrder</code>
                </CellTemplate>
            </BbDataGridPropertyColumn>

            <BbDataGridPropertyColumn TData="NavigationMenuGroup" TProp="string" Property="g => g.Name" Id="group" Title="Menu Group"
                                      Width="@gridMgr.GetWidth("group", "15rem")" Visible="@gridMgr.IsVisible("group")" Resizable="true" Sortable="true" Filterable="true">
                <CellTemplate Context="item">
                    <div class="row" style="gap:.5rem;align-items:center;flex-wrap:nowrap">
                        <LucideIcon Name="@(string.IsNullOrWhiteSpace(item.Icon) ? "folder" : item.Icon)" Size="16" />
                        <strong>@item.Name</strong>
                    </div>
                </CellTemplate>
            </BbDataGridPropertyColumn>

            <BbDataGridTemplateColumn TData="NavigationMenuGroup" Id="parent_module" Title="Parent Module"
                                      Width="@gridMgr.GetWidth("parent_module")" Visible="@gridMgr.IsVisible("parent_module")" Resizable="true" Sortable="true" SortBy="g => ModuleName(g.ModuleId)">
                <ChildContent Context="item">
                    @{
                        var mod = modules.FirstOrDefault(m => m.Id == item.ModuleId);
                    }
                    @if (mod is not null)
                    {
                        <BbBadge Variant="BadgeVariant.Soft">
                            <span class="row" style="gap:.35rem;flex-wrap:nowrap">
                                <LucideIcon Name="@(string.IsNullOrWhiteSpace(mod.Icon) ? "layout-grid" : mod.Icon)" Size="13" />
                                <span>@mod.Name</span>
                            </span>
                        </BbBadge>
                    }
                    else
                    {
                        <span class="muted small">—</span>
                    }
                </ChildContent>
            </BbDataGridTemplateColumn>

            <BbDataGridTemplateColumn TData="NavigationMenuGroup" Id="menu_count" Title="Menu Count"
                                      Width="@gridMgr.GetWidth("menu_count", "9rem")" Visible="@gridMgr.IsVisible("menu_count")" Resizable="true">
                <ChildContent Context="item">
                    @{
                        var cnt = menus.Count(m => m.GroupId == item.Id || (string.IsNullOrWhiteSpace(m.GroupId) && string.Equals(m.GroupName, item.Name, StringComparison.OrdinalIgnoreCase)));
                    }
                    <BbBadge Variant="BadgeVariant.Outline">@cnt menus</BbBadge>
                </ChildContent>
            </BbDataGridTemplateColumn>

            <BbDataGridTemplateColumn TData="NavigationMenuGroup" Id="status" Title="Status"
                                      Width="@gridMgr.GetWidth("status", "9rem")" Visible="@gridMgr.IsVisible("status")" Resizable="true" Sortable="true" SortBy="g => g.IsActive">
                <ChildContent Context="item">
                    <div class="row" style="gap:.25rem;flex-wrap:nowrap">
                        @if (item.IsSystem)
                        {
                            <BbBadge Variant="BadgeVariant.Soft">System</BbBadge>
                        }
                        @if (item.IsActive)
                        {
                            <BbBadge Variant="BadgeVariant.SoftSuccess">Active</BbBadge>
                        }
                        else
                        {
                            <BbBadge Variant="BadgeVariant.Secondary">Inactive</BbBadge>
                        }
                    </div>
                </ChildContent>
            </BbDataGridTemplateColumn>

            <BbDataGridTemplateColumn TData="NavigationMenuGroup" Id="actions" Title="Actions" Width="@gridMgr.GetWidth("actions", "6.5rem")" NoWrap="true" Hideable="false" Resizable="false">
                <ChildContent Context="item">
                    <div style="display:inline-flex;align-items:center;gap:.25rem;flex-wrap:nowrap" @onclick:stopPropagation="true">
                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" AriaLabel="Edit menu group" OnClick="() => StartEdit(item)">
                            <LucideIcon Name="pencil" Size="15" />
                        </BbButton>
                        @if (!item.IsSystem)
                        {
                            <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" AriaLabel="Delete menu group" OnClick="() => ConfirmDelete(item)">
                                <LucideIcon Name="trash-2" Size="15" />
                            </BbButton>
                        }
                    </div>
                </ChildContent>
            </BbDataGridTemplateColumn>
        </Columns>
        <EmptyTemplate>
            <div style="padding:2rem;text-align:center;color:var(--muted-foreground)">
                No menu groups found.
            </div>
        </EmptyTemplate>
    </BbDataGrid>

    <AdminDrawer Open="@isDrawerOpen"
                 OpenChanged="@OnDrawerOpenChanged"
                 WidthScale="@DrawerWidthScale"
                 Title="@(edit is null ? "" : isNew ? "Add Menu Group" : $"Edit: {edit.Name}")"
                 Description="@(edit is null ? null : edit.IsSystem ? "Built-in system menu group (cannot be deleted, but parent module, name, icon, and sort order can be edited)." : "Custom application menu group.")">
        <ChildContent>
            @if (edit is not null)
            {
                @if (error is not null)
                {
                    <BbAlert Variant="AlertVariant.Danger"><BbAlertDescription>@error</BbAlertDescription></BbAlert>
                }

                <div class="form-cols cols-2">
                    <BbField>
                        <BbFieldLabel For="grp-module">Parent Module</BbFieldLabel>
                        <select id="grp-module" class="auth-input" value="@edit.ModuleId" @onchange="e => edit.ModuleId = e.Value as string ?? string.Empty">
                            <option value="">— Select Module —</option>
                            @foreach (var m in modules)
                            {
                                <option value="@m.Id">@m.Name</option>
                            }
                        </select>
                        <BbFieldDescription>The module where this menu group is displayed on the sidebar.</BbFieldDescription>
                    </BbField>

                    <BbField>
                        <BbFieldLabel For="grp-name">Menu Group Name</BbFieldLabel>
                        <FormTextInput Id="grp-name" Immediate="true" @bind-Value="edit.Name" Placeholder="e.g. Transactions, Master Data, Organization, Reports" />
                        <BbFieldDescription>Sub-section heading displayed on the sidebar under the active module.</BbFieldDescription>
                    </BbField>
                </div>

                <div class="form-cols cols-2">
                    <BbField>
                        <BbFieldLabel For="grp-icon">Lucide Icon</BbFieldLabel>
                        <div class="row" style="gap:.5rem;align-items:center;flex-wrap:nowrap">
                            <FormTextInput Id="grp-icon" Immediate="true" @bind-Value="edit.Icon" Placeholder="e.g. folder, users, shopping-cart, database" />
                            <div style="display:flex;align-items:center;justify-content:center;width:2.5rem;height:2.5rem;border:1px solid var(--border);border-radius:var(--radius);background:var(--muted);flex-shrink:0">
                                <LucideIcon Name="@(string.IsNullOrWhiteSpace(edit.Icon) ? "folder" : edit.Icon)" Size="18" />
                            </div>
                        </div>
                    </BbField>

                    <BbField>
                        <BbFieldLabel For="grp-order">Order (Sort Order)</BbFieldLabel>
                        <FormTextInput Id="grp-order" Type="number" Immediate="true" Value="@edit.SortOrder.ToString()" ValueChanged="v => edit.SortOrder = int.TryParse(v, out var n) ? n : edit.SortOrder" />
                        <BbFieldDescription>Lower numbers appear higher within the same module (e.g. 10, 20, 30).</BbFieldDescription>
                    </BbField>
                </div>

                <div class="label-row" style="margin-top:.5rem">
                    <BbCheckbox Id="grp-active" Checked="edit.IsActive" CheckedChanged="v => edit.IsActive = v" />
                    <BbLabel For="grp-active">Active (displayed in sidebar)</BbLabel>
                </div>
            }
        </ChildContent>
        <FooterContent>
            @if (edit is not null)
            {
                <div class="row" style="gap:.5rem;width:100%;align-items:center">
                    <BbButton Disabled="busy" Loading="busy" LoadingText="Saving…" OnClick="Save"><LucideIcon Name="check" Size="16" /> Save</BbButton>
                    <BbButton Variant="ButtonVariant.Ghost" OnClick="CloseDrawer">Cancel</BbButton>
                    @if (!isNew && !edit.IsSystem)
                    {
                        <span style="margin-left:auto">
                            <BbButton Variant="ButtonVariant.Destructive" Size="ButtonSize.Small" Disabled="busy" OnClick="() => ConfirmDelete(edit)">
                                <LucideIcon Name="trash-2" Size="15" /> Delete
                            </BbButton>
                        </span>
                    }
                </div>
            }
        </FooterContent>
    </AdminDrawer>
}

@code {
    /// <summary>Configurable drawer width multiplier (default 2.0 = 2x normal width).</summary>
    [Parameter] public double DrawerWidthScale { get; set; } = 2.0;

    private IReadOnlyList<NavigationModule> modules = [];
    private IReadOnlyList<NavigationMenuGroup> groups = [];
    private IReadOnlyList<NavigationMenuItem> menus = [];
    private NavigationMenuGroup? edit;
    private bool isDrawerOpen;
    private bool isNew;
    private bool busy;
    private string? error;
    private Framework.Web.Services.DataGridPreferenceManager<NavigationMenuGroup> gridMgr = default!;

    protected override async Task OnInitializedAsync()
    {
        gridMgr = new(UserPrefs, Current, "grid:admin:menu-groups", StateHasChanged);
        if (Current.User is null) return;
        await gridMgr.InitializeAsync();
        await Reload();
    }

    private async Task ResetColumnsLayout()
    {
        await gridMgr.ResetAsync();
        Toasts.Success("Tata letak kolom telah dikembalikan ke bawaan.", "Reset Kolom");
    }

    public void Dispose()
    {
        gridMgr?.Dispose();
    }

    private async Task Reload()
    {
        var tenantId = Current.Required.TenantId;
        modules = await MenuStore.ListModulesAsync(tenantId, onlyActive: false);
        groups = await MenuStore.ListGroupsAsync(tenantId, onlyActive: false);
        menus = await MenuStore.ListAsync(tenantId, onlyActive: false);
    }

    private string ModuleName(string moduleId) =>
        modules.FirstOrDefault(m => m.Id == moduleId)?.Name ?? "";

    private void StartCreate()
    {
        error = null;
        isNew = true;
        edit = new NavigationMenuGroup
        {
            Id = Guid.NewGuid().ToString("N"),
            TenantId = Current.Required.TenantId,
            ModuleId = modules.FirstOrDefault()?.Id ?? "",
            Name = "",
            Icon = "folder",
            SortOrder = groups.Count > 0 ? groups.Max(g => g.SortOrder) + 10 : 10,
            IsActive = true,
            IsSystem = false
        };
        isDrawerOpen = true;
    }

    private void StartEdit(NavigationMenuGroup item)
    {
        error = null;
        isNew = false;
        edit = new NavigationMenuGroup
        {
            Id = item.Id,
            TenantId = item.TenantId,
            ModuleId = item.ModuleId,
            Name = item.Name,
            Icon = item.Icon,
            SortOrder = item.SortOrder,
            IsSystem = item.IsSystem,
            IsActive = item.IsActive,
            CreatedAt = item.CreatedAt,
            UpdatedAt = item.UpdatedAt
        };
        isDrawerOpen = true;
    }

    private void CloseDrawer()
    {
        isDrawerOpen = false;
    }

    private void OnDrawerOpenChanged(bool open)
    {
        isDrawerOpen = open;
        if (!open)
        {
            edit = null;
            error = null;
        }
    }

    private async Task Save()
    {
        if (edit is null || busy) return;
        if (string.IsNullOrWhiteSpace(edit.ModuleId))
        {
            error = "Please select a parent module.";
            Toasts.Error(error, "Failed to Save");
            return;
        }
        if (string.IsNullOrWhiteSpace(edit.Name))
        {
            error = "Menu group name cannot be empty.";
            Toasts.Error(error, "Failed to Save");
            return;
        }

        edit.Name = edit.Name.Trim();
        edit.Icon = string.IsNullOrWhiteSpace(edit.Icon) ? "folder" : edit.Icon.Trim();

        busy = true;
        error = null;
        StateHasChanged();

        try
        {
            await MenuStore.SaveGroupAsync(edit);
            Toasts.Success($"Menu group \"{edit.Name}\" successfully saved.", "Successfully Saved");
            isDrawerOpen = false;
            await Reload();
        }
        catch (Exception ex)
        {
            error = ex.Message;
            Toasts.Error(ex.Message, "Failed to Save");
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ConfirmDelete(NavigationMenuGroup item)
    {
        if (item.IsSystem)
        {
            Toasts.Error("Built-in system menu groups cannot be deleted.", "Not Allowed");
            return;
        }

        var res = await Dialogs.ConfirmAsync(
            $"Delete menu group \"{item.Name}\"?",
            "This menu group will be deleted if it no longer contains menu items. This action cannot be undone.",
            new ConfirmDialogOptions { Destructive = true, ConfirmText = "Delete Group", CancelText = "Cancel" });

        if (!res.Confirmed) return;

        busy = true;
        try
        {
            await MenuStore.DeleteGroupAsync(item.Id, item.TenantId);
            if (edit?.Id == item.Id) isDrawerOpen = false;
            Toasts.Success($"Menu group \"{item.Name}\" successfully deleted.", "Group Deleted");
            await Reload();
        }
        catch (Exception ex)
        {
            Toasts.Error(ex.Message, "Failed to Delete Group");
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ResetDefaults()
    {
        var res = await Dialogs.ConfirmAsync(
            "Seed / Restore Default Menu Groups?",
            "The system will verify and seed missing modules, menu groups, and built-in menus into the database.",
            new ConfirmDialogOptions { ConfirmText = "Run Seed", CancelText = "Cancel" });

        if (!res.Confirmed) return;

        busy = true;
        try
        {
            await MenuStore.EnsureDefaultMenusAsync(Current.Required.TenantId);
            Toasts.Success("Default menu groups successfully verified and seeded.", "Seed Successful");
            await Reload();
        }
        catch (Exception ex)
        {
            Toasts.Error(ex.Message, "Failed to Seed Menu Groups");
        }
        finally
        {
            busy = false;
        }
    }
}

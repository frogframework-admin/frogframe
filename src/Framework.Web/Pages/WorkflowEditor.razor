@page "/admin/workflows/{WorkflowName}/editor"
@page "/admin/workflows/new"
@using System.Text.Json
@inject MetadataRegistry Registry
@inject RoleCatalog RoleCatalogSvc
@inject CurrentUser Current
@inject ToastService Toasts
@inject DialogService Dialogs
@inject NavigationManager Nav
@inject Framework.Web.AI.AiDesignerService Ai

<PageTitle>Workflow @(wf?.Name) · FrogFrame</PageTitle>

@if (!Current.Required.Roles.Contains(UserContext.SystemManager))
{
    <ErrorState StatusCode="403" Description="Workflow Editor is only accessible to System Managers." />
}
else if (wf is null)
{
    <ErrorState StatusCode="404" Title="Workflow Not Found" Description="@(loadError ?? $"Workflow '{WorkflowName}' was not found.")" BackHref="/admin/workflows" BackLabel="Back to Workflows" />
}
else
{
    <header class="page-head">
        <div>
            <h1>@(isNew ? "New workflow" : wf.Name) <span class="muted" style="font-weight:500">· @(isNew ? "v1" : $"draft v{wf.Version}")</span></h1>
            <p>
                @if (!string.IsNullOrWhiteSpace(wf.DocType)) { <span>Workflow for <strong>@DocTitle</strong>.</span> }
                else if (targetDocType is not null) { <span>Standalone workflow; ready to link to <strong>@DocTitle</strong> when published.</span> }
                else { <span>Standalone workflow. You can link it to a DocType when ready.</span> }
                @if (errors.Count > 0) { <BbBadge Variant="BadgeVariant.SoftDestructive">@errors.Count issue(s)</BbBadge> }
                else { <BbBadge Variant="BadgeVariant.SoftSuccess">Valid draft</BbBadge> }
                @if (dirty) { <BbBadge Variant="BadgeVariant.Warning">Unpublished</BbBadge> }
            </p>
        </div>
        <div class="row">
            @if (!isNew) { <BbButton Variant="ButtonVariant.Ghost" Disabled="@(!dirty)" OnClick="Discard"><LucideIcon Name="rotate-ccw" Size="16" /> Discard changes</BbButton> }
            <BbButton Variant="ButtonVariant.Outline" Disabled="@(errors.Count > 0)" OnClick="Check"><LucideIcon Name="search" Size="16" /> Check changes</BbButton>
            <BbButton Disabled="@(preview is not { Valid: true } || preview.Changes.Count == 0 || (preview.Risk == ChangeRisk.Risky && !ack))" OnClick="Publish">
                <LucideIcon Name="upload" Size="16" /> Publish
            </BbButton>
        </div>
    </header>

    <AiAssistPanel Title="@(isNew ? "Design with AI" : "Modify with AI")"
                   Description="Describe the approval flow: who approves, in which order, and under which conditions. The AI rewrites the draft below; you review it and publish."
                   Placeholder="e.g. Line manager approves first. If total is above 50,000,000, the Finance Manager approves next. Rejections need a comment and go back to Draft."
                   ButtonText="Apply to draft"
                   Rows="3"
                   ShowWhenDisabled="false"
                   Generate="DesignWithAi" />

    @if (string.IsNullOrWhiteSpace(wf.DocType))
    {
        <BbCard Class="props-block">
            <BbCardContent>
                <BbField>
                    <BbFieldLabel>Link to DocType (optional)</BbFieldLabel>
                    <BbSelect TValue="string" Value="@(targetDocType ?? "")" ValueChanged="SetTargetDocType" Options="DocTypeOptions" AriaLabel="DocType to link" />
                    <BbFieldDescription>Workflow conditions that reference DocType fields are checked after you select and link a DocType.</BbFieldDescription>
                </BbField>
                @if (CanAttach)
                {
                    <div class="label-row" style="margin-top:.75rem">
                        <BbCheckbox Id="attach" Checked="attach" CheckedChanged="v => { attach = v; Recompile(); }" />
                        <BbLabel For="attach">Link to @DocTitle when publishing@(OwnerWorkflow is { } ow ? $" (replacing workflow {ow})" : "")</BbLabel>
                    </div>
                }
            </BbCardContent>
        </BbCard>
    }
    else if (CanAttach)
    {
        <div class="label-row props-block">
            <BbCheckbox Id="attach" Checked="attach" CheckedChanged="v => { attach = v; Recompile(); }" />
            <BbLabel For="attach">Attach to DocType @wf.DocType upon publishing@(OwnerWorkflow is { } ow ? $" (replacing workflow {ow})" : "")</BbLabel>
        </div>
    }

    @if (isNew)
    {
        <BbCard Class="props-block">
            <BbCardContent>
                <div style="padding-top:1.1rem; max-width:26rem">
                    <BbField IsInvalid="@errors.Any(e => e.Path == "name")">
                        <BbFieldLabel For="wf-name">Workflow name</BbFieldLabel>
                        <BbInput Id="wf-name" Value="@wf.Name" ValueChanged="v => Mutate(() => wf.Name = (v ?? string.Empty).Trim())" />
                        <BbFieldDescription>Letters and numbers without spaces; cannot be changed after publishing.</BbFieldDescription>
                    </BbField>
                </div>
            </BbCardContent>
        </BbCard>
    }

    @if (preview is not null)
    {
        <BbCard Class="props-block">
            <BbCardHeader>
                <BbCardTitle Class="card-title">Changes @(isNew ? "" : $"compared to v{wf.Version - 1}")</BbCardTitle>
                <BbCardDescription>@(preview.Changes.Count == 0 ? "No changes." : $"{preview.Changes.Count} change(s), highest risk: {RiskLabel(preview.Risk)}.")</BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                @if (preview.Errors.Count > 0)
                {
                    <BbAlert Variant="AlertVariant.Danger"><BbAlertDescription><ul class="error-list">@foreach (var e in preview.Errors) { <li><code>@e.Path</code> @e.Message</li> }</ul></BbAlertDescription></BbAlert>
                }
                <ul class="diff">
                    @foreach (var c in preview.Changes.OrderByDescending(c => c.Risk))
                    {
                        <li><BbBadge Variant="@RiskVariant(c.Risk)">@RiskLabel(c.Risk)</BbBadge> <span>@c.Description</span></li>
                    }
                </ul>
                @if (preview is { Risk: ChangeRisk.Risky, Valid: true })
                {
                    <div class="label-row" style="margin-top:.75rem"><BbCheckbox Id="ack" @bind-Checked="ack" /><BbLabel For="ack">I have reviewed the risky changes</BbLabel></div>
                }
            </BbCardContent>
        </BbCard>
    }

    @if (errors.Count > 0)
    {
        <BbAlert Variant="AlertVariant.Danger" Class="props-block">
            <BbAlertTitle>Draft is not valid yet</BbAlertTitle>
            <BbAlertDescription><ul class="error-list">@foreach (var e in errors) { <li>@e.Message</li> }</ul></BbAlertDescription>
        </BbAlert>
    }

    <BbTabs Value="@activeTab" ValueChanged="v => activeTab = v ?? activeTab" Class="props-block">
        <BbTabsList>
            <BbTabsTrigger Value="designer" Style="gap:.5rem"><LucideIcon Name="workflow" Size="15" /> Designer</BbTabsTrigger>
            <BbTabsTrigger Value="json" Style="gap:.5rem"><LucideIcon Name="braces" Size="15" /> JSON</BbTabsTrigger>
        </BbTabsList>

        <BbTabsContent Value="designer">
            <BbCard Class="props-block" Style="margin-top:.75rem">
                <BbCardHeader>
                    <BbCardTitle Class="card-title">Flow diagram</BbCardTitle>
                    <BbCardDescription>Click an arrow to edit its transition. Thick line = initial state.</BbCardDescription>
                </BbCardHeader>
                <BbCardContent><WorkflowDiagram Workflow="wf" SelectedTransition="selected" OnSelectTransition="i => selected = i" /></BbCardContent>
            </BbCard>

            <BbCard Class="props-block">
                <BbCardHeader>
                    <BbCardTitle Class="card-title">States</BbCardTitle>
                    <BbCardDescription>"Editable" = draft; "locked" = submitted/approved; "cancelled" = can be amended.</BbCardDescription>
                </BbCardHeader>
                <BbCardContent>
                    <table class="wf-states">
                        <thead><tr><th>Name</th><th>Document status</th><th>Color</th><th class="narrow">Initial</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var state in wf.States)
                            {
                                var st = state;
                                <tr>
                                    <td><BbInput Value="@st.Name" ValueChanged="v => RenameState(st, v)" AriaLabel="State name" /></td>
                                    <td><BbSelect TValue="string" Value="@st.DocStatus.ToString()" ValueChanged="v => Mutate(() => st.DocStatus = int.Parse(v!))" Options="DocStatusOptions" AriaLabel="Document status" /></td>
                                    <td><BbSelect TValue="string" Value="@st.Tone" ValueChanged="v => SetTone(st, v)" Options="ToneOptions" AriaLabel="Color" /></td>
                                    <td class="narrow"><input type="radio" name="initial" checked="@(wf.InitialState == st.Name)" aria-label="Initial state" @onchange="() => Mutate(() => wf.InitialState = st.Name)" /></td>
                                    <td class="narrow"><BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" AriaLabel="@($"Delete state {st.Name}")" OnClick="() => RemoveState(st)"><LucideIcon Name="trash-2" Size="15" /></BbButton></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <div style="margin-top:.6rem"><BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="AddState"><LucideIcon Name="plus" Size="15" /> Add state</BbButton></div>
                </BbCardContent>
            </BbCard>

            <BbCard Class="props-block">
                <BbCardHeader>
                    <BbCardTitle Class="card-title">Transitions (actions)</BbCardTitle>
                    <BbCardDescription>Actions appear as buttons on documents for permitted roles when conditions are met. Condition variables: @wf.DocType fields, <code>owner</code>, <code>user.id</code>, <code>user.department</code>.</BbCardDescription>
                </BbCardHeader>
                <BbCardContent>
                    <div class="stack">
                        @for (var i = 0; i < wf.Transitions.Count; i++)
                        {
                            var idx = i; var t = wf.Transitions[i];
                            var condErr = errors.FirstOrDefault(e => e.Path.StartsWith($"transitions.{t.From}->{t.To}") && e.Path.EndsWith(".condition"));
                            <div class="wf-transition @(selected == idx ? "selected" : "")" @onclick="() => selected = idx">
                                <div class="wf-transition-head">
                                    <BbSelect TValue="string" Value="@t.From" ValueChanged="v => Mutate(() => t.From = v ?? string.Empty)" Options="StateOptions" AriaLabel="From state" />
                                    <LucideIcon Name="arrow-right" Size="16" />
                                    <BbSelect TValue="string" Value="@t.To" ValueChanged="v => Mutate(() => t.To = v ?? string.Empty)" Options="StateOptions" AriaLabel="To state" />
                                    <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" AriaLabel="Delete transition" OnClick="() => Mutate(() => { wf.Transitions.RemoveAt(idx); selected = null; })"><LucideIcon Name="trash-2" Size="15" /></BbButton>
                                </div>
                                <BbField>
                                    <BbFieldLabel>Action name (button label)</BbFieldLabel>
                                    <BbInput Value="@t.Action" ValueChanged="v => Mutate(() => t.Action = (v ?? string.Empty).Trim())" AriaLabel="Action name" Placeholder="e.g. Approve" />
                                </BbField>
                                <div>
                                    <div class="props-sub" style="margin-bottom:.35rem">Roles permitted to execute</div>
                                    <div class="wf-roles">
                                        @foreach (var role in Roles)
                                        {
                                            var r = role;
                                            <div class="label-row"><BbCheckbox Id="@($"t{idx}-{r}")" Checked="t.AllowedRoles.Contains(r)" CheckedChanged="v => Mutate(() => ToggleRole(t, r, v))" /><BbLabel For="@($"t{idx}-{r}")">@r</BbLabel></div>
                                        }
                                    </div>
                                </div>
                                <BbField IsInvalid="@(condErr is not null)">
                                    <BbFieldLabel>Condition (optional)</BbFieldLabel>
                                    <BbInput Class="code-input" Value="@t.Condition" ValueChanged="v => Mutate(() => t.Condition = string.IsNullOrWhiteSpace(v) ? null : v.Trim())" AriaLabel="Condition" Placeholder="e.g. department == user.department &amp;&amp; owner != user.id" />
                                    @if (condErr is not null) { <BbFieldError Errors="@(new[] { condErr.Message })" /> }
                                </BbField>
                                <div class="label-row"><BbCheckbox Id="@($"t{idx}-comment")" Checked="t.RequireComment" CheckedChanged="v => Mutate(() => t.RequireComment = v)" /><BbLabel For="@($"t{idx}-comment")">Requires comment (e.g. for rejections)</BbLabel></div>
                            </div>
                        }
                        <div><BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="AddTransition"><LucideIcon Name="plus" Size="15" /> Add transition</BbButton></div>
                    </div>
                </BbCardContent>
            </BbCard>
        </BbTabsContent>

        <BbTabsContent Value="json">
            <BbCard Class="props-block" Style="margin-top:.75rem">
                <BbCardHeader>
                    <BbCardTitle Class="card-title">Workflow JSON Definition</BbCardTitle>
                    <BbCardDescription>Complete serialized JSON representation of this workflow draft.</BbCardDescription>
                </BbCardHeader>
                <BbCardContent>
                    <pre class="code" style="white-space:pre-wrap;font-size:.8rem;max-height:65vh;overflow-y:auto;padding:.85rem;border-radius:calc(var(--radius) - 2px);background:var(--muted);border:1px solid var(--border)">@MetadataJson.Serialize(wf)</pre>
                </BbCardContent>
            </BbCard>
        </BbTabsContent>
    </BbTabs>
}

@code {
    [Parameter] public string? WorkflowName { get; set; }
    [SupplyParameterFromQuery(Name = "doctype")] public string? ForDocType { get; set; }

    private WorkflowDef? wf;
    private string activeTab = "designer";
    private string originalJson = "";
    private string? targetDocType;
    private string? originalTargetDocType;
    private bool originalAttach;
    private bool isNew, attach, dirty, ack;
    private int? selected;
    private string? loadError;
    private IReadOnlyList<MetadataError> errors = [];
    private PublishPreview? preview;

    private static readonly IEnumerable<SelectOption<string>> DocStatusOptions =
        [new("0", "Draft"), new("1", "Locked"), new("2", "Cancelled")];
    private static readonly IEnumerable<SelectOption<string>> ToneOptions =
        [new("neutral", "Neutral"), new("pending", "Pending"), new("positive", "Positive"), new("negative", "Negative")];

    private IEnumerable<SelectOption<string>> StateOptions => wf!.States.Where(s => !string.IsNullOrWhiteSpace(s.Name)).Select(s => new SelectOption<string>(s.Name, s.Name));
    private IReadOnlyList<string> Roles => MetadataRoles.Known(Registry.Current, wf!.Transitions.SelectMany(t => t.AllowedRoles), RoleCatalogSvc.Names(Current.Required.TenantId));
    private IEnumerable<SelectOption<string>> DocTypeOptions => new[] { new SelectOption<string>("", "Choose a DocType") }
        .Concat(Registry.Current.DocTypes.Values.Where(d => !d.Def.IsChild).OrderBy(d => d.Title).Select(d => new SelectOption<string>(d.Name, d.Title)));
    private string? EffectiveDocType => string.IsNullOrWhiteSpace(wf?.DocType) ? targetDocType : wf.DocType;
    private string DocTitle => EffectiveDocType is { } n && Registry.Current.TryGet(n, out var d) ? d.Title : EffectiveDocType ?? "not linked";
    private string? OwnerWorkflow => EffectiveDocType is { } n && Registry.Current.TryGet(n, out var d) && d.Def.Workflow is { } w && w != wf!.Name ? w : null;
    private bool CanAttach => EffectiveDocType is { } n && Registry.Current.TryGet(n, out var d) && d.Def.Workflow != wf!.Name;

    // Blazor memanggil OnParametersSet setiap kali layout induk dirender ulang (mis. jumlah notifikasi berubah).
    // Muat ulang hanya bila parameter rute benar-benar berubah, agar isian/draft pengguna tidak hilang.
    private string? loadedKey;
    protected override void OnParametersSet()
    {
        var key = $"{WorkflowName}|{ForDocType}";
        if (key == loadedKey) return;
        loadedKey = key;
        Init();
    }

    private void Init()
    {
        loadError = null; preview = null; ack = false; selected = null;
        targetDocType = null;
        if (WorkflowName is not null)
        {
            var active = Registry.Workflows.FirstOrDefault(w => w.Name == WorkflowName);
            if (active is null) { wf = null; return; }
            wf = Clone(active); wf.Version = active.Version + 1; isNew = false;
            targetDocType = wf.DocType;
            if (string.IsNullOrWhiteSpace(targetDocType) && ForDocType is not null
                && Registry.Current.TryGet(ForDocType, out var doc) && !doc.Def.IsChild)
                targetDocType = doc.Name;
            attach = CanAttach;
        }
        else
        {
            if (ForDocType is not null && Registry.Current.TryGet(ForDocType, out var doc) && !doc.Def.IsChild)
                targetDocType = doc.Name;
            wf = Template(targetDocType); isNew = true; attach = false;
        }
        originalJson = MetadataJson.Serialize(wf);
        originalTargetDocType = targetDocType;
        originalAttach = attach;
        Recompile();
    }

    /// <summary>Template awal: Draft → Diajukan → Disetujui / Ditolak.</summary>
    private WorkflowDef Template(string? docType)
    {
        var baseName = string.IsNullOrWhiteSpace(docType) ? "NewWorkflow" : docType + "Approval";
        var name = baseName;
        for (var i = 2; Registry.Workflows.Any(w => w.Name == name); i++) name = $"{baseName}{i}";
        return new WorkflowDef
        {
            Name = name, Version = 1, InitialState = "Draft",
            States =
            [
                new() { Name = "Draft", DocStatus = 0, Tone = "neutral" },
                new() { Name = "Submitted", DocStatus = 1, Tone = "pending" },
                new() { Name = "Approved", DocStatus = 1, Tone = "positive" },
                new() { Name = "Rejected", DocStatus = 2, Tone = "negative" },
            ],
            Transitions =
            [
                new() { From = "Draft", To = "Submitted", Action = "Submit", AllowedRoles = ["Employee"], Condition = "owner == user.id" },
                new() { From = "Submitted", To = "Approved", Action = "Approve", AllowedRoles = ["Manager"], Condition = "owner != user.id" },
                new() { From = "Submitted", To = "Rejected", Action = "Reject", AllowedRoles = ["Manager"], Condition = "owner != user.id", RequireComment = true },
            ],
        };
    }

    private static WorkflowDef Clone(WorkflowDef w) => MetadataJson.ParseWorkflow(MetadataJson.Serialize(w));

    private void Recompile()
    {
        (_, errors) = Registry.CompileWorkflowDraft(DraftForCompile(), attach, RoleCatalogSvc.Scope(Current.Required.TenantId));
        dirty = isNew || MetadataJson.Serialize(wf) != originalJson || targetDocType != originalTargetDocType || attach != originalAttach;
        preview = null; ack = false;
    }

    private WorkflowDef DraftForCompile()
    {
        var draft = Clone(wf!);
        if (string.IsNullOrWhiteSpace(draft.DocType) && attach)
            draft.DocType = targetDocType;
        return draft;
    }

    private void SetTargetDocType(string? value)
    {
        targetDocType = string.IsNullOrWhiteSpace(value) ? null : value;
        Recompile();
    }

    private void Mutate(Action change) { change(); Recompile(); }

    private void RenameState(WorkflowStateDef st, string? value)
    {
        var newName = (value ?? string.Empty).Trim();
        if (newName == st.Name) return;
        Mutate(() =>
        {
            // Rujukan ikut diganti agar transisi dan state awal tetap tersambung.
            foreach (var t in wf!.Transitions)
            {
                if (t.From == st.Name) t.From = newName;
                if (t.To == st.Name) t.To = newName;
            }
            if (wf.InitialState == st.Name) wf.InitialState = newName;
            st.Name = newName;
        });
    }

    private void SetTone(WorkflowStateDef st, string? v) => Mutate(() => st.Tone = v ?? "neutral");

    private void AddState()
    {
        var name = "New State";
        for (var i = 2; wf!.States.Any(s => s.Name == name); i++) name = $"New State {i}";
        Mutate(() => wf!.States.Add(new WorkflowStateDef { Name = name, DocStatus = 1, Tone = "pending" }));
    }

    private async Task RemoveState(WorkflowStateDef st)
    {
        var used = wf!.Transitions.Count(t => t.From == st.Name || t.To == st.Name);
        if (used > 0)
        {
            var ok = await Dialogs.ConfirmAsync($"Delete state {st.Name}?", $"{used} transition(s) using this state will also be deleted.",
                new ConfirmDialogOptions { Destructive = true, ConfirmText = "Delete", CancelText = "Cancel" });
            if (!ok.Confirmed) return;
        }
        Mutate(() =>
        {
            wf.Transitions.RemoveAll(t => t.From == st.Name || t.To == st.Name);
            wf.States.Remove(st);
            if (wf.InitialState == st.Name) wf.InitialState = wf.States.FirstOrDefault(s => s.DocStatus == 0)?.Name ?? "";
            selected = null;
        });
    }

    private void AddTransition()
    {
        var from = wf!.States.FirstOrDefault()?.Name ?? "";
        var to = wf.States.Skip(1).FirstOrDefault()?.Name ?? from;
        Mutate(() => { wf.Transitions.Add(new WorkflowTransitionDef { From = from, To = to, Action = "New Action", AllowedRoles = ["Manager"] }); selected = wf.Transitions.Count - 1; });
    }

    private static void ToggleRole(WorkflowTransitionDef t, string role, bool on)
    {
        if (on && !t.AllowedRoles.Contains(role)) t.AllowedRoles.Add(role);
        if (!on) t.AllowedRoles.Remove(role);
    }

    /// <summary>AI rewrites the draft; name and version stay as the editor set them. Nothing is published.</summary>
    private async Task<Framework.Web.AI.AiPanelOutcome> DesignWithAi(string request, CancellationToken ct)
    {
        var r = await Ai.DesignWorkflowAsync(Current.Required, request, wf, EffectiveDocType, ct);
        if (r.Workflow is null)
            return new(false, r.Explanation, r.Errors, r.Usage, "The AI did not return a draft");

        var next = r.Workflow;
        next.Name = wf!.Name;
        next.Version = wf.Version;
        if (string.IsNullOrWhiteSpace(wf.DocType))
        {
            // Standalone or new workflow: a DocType chosen by the AI becomes the link target; the admin can still untick linking.
            if (!string.IsNullOrWhiteSpace(next.DocType) && Registry.Current.TryGet(next.DocType, out var d) && !d.Def.IsChild)
                targetDocType = d.Name;
            next.DocType = null;
        }
        else
        {
            next.DocType = wf.DocType;
        }

        wf = next;
        selected = null;
        attach = attach || (isNew && CanAttach);
        Recompile();

        return new(r.Ok, r.Explanation, r.Errors, r.Usage,
            r.Ok ? "Applied to the draft: check the diagram, then Check changes and Publish" : "Applied to the draft with problems: fix them or try again");
    }

    private void Check() => preview = Registry.PreviewWorkflow(DraftForCompile(), attach, RoleCatalogSvc.Scope(Current.Required.TenantId));

    private void Publish()
    {
        try
        {
            var v = Registry.PublishWorkflow(DraftForCompile(), Current.Required.Id, ack, attach, RoleCatalogSvc.Scope(Current.Required.TenantId));
            Toasts.Success(attach ? $"Attached to {v.DocType}; documents will now use this workflow." : "Workflow published independently.", $"Workflow {v.Name} v{v.Version} published");
            if (isNew) Nav.NavigateTo($"/admin/workflows/{v.Name}/editor");
            else Init();
        }
        catch (Exception ex) when (ex is MetadataCompilationException or InvalidOperationException)
        {
            Toasts.Error(ex.Message, "Failed to publish");
        }
    }

    private async Task Discard()
    {
        var ok = await Dialogs.ConfirmAsync("Discard all changes?", "Draft will be restored to the active version.", new ConfirmDialogOptions { ConfirmText = "Discard changes", CancelText = "Cancel" });
        if (ok.Confirmed) Init();
    }

    private static string RiskLabel(ChangeRisk r) => r switch { ChangeRisk.Safe => "Safe", ChangeRisk.NeedsTransform => "Needs transformation", _ => "Risky" };
    private static BadgeVariant RiskVariant(ChangeRisk r) => r switch { ChangeRisk.Safe => BadgeVariant.SoftSuccess, ChangeRisk.NeedsTransform => BadgeVariant.Warning, _ => BadgeVariant.SoftDestructive };
}

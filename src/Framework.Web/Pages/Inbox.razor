@page "/inbox"
@using Framework.Documents
@using Framework.Notifications
@inject INotificationStore Notifications
@inject INotificationLiveFeed LiveNotifications
@inject CurrentUser Current
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Inbox · FrogFrame</PageTitle>

<header class="page-head">
    <div><h1>Inbox</h1><p>Notifications are sent by the outbox worker after document transactions are committed.</p></div>
</header>

<div class="stack">
    @if (items.Count == 0)
    {
        <BbEmpty Title="No notifications yet" Description="Notifications will appear when documents involving you change status.">
            <Icon><LucideIcon Name="inbox" Size="28" /></Icon>
        </BbEmpty>
    }
    else
    {
        <BbCard>
            <BbCardContent Style="padding:0">
                @foreach (var n in items)
                {
                    <div class="inbox-item @(n.Read ? "" : "unread")">
                        <BbAvatar><BbAvatarFallback><LucideIcon Name="stamp" Size="16" /></BbAvatarFallback></BbAvatar>
                        <div class="body">
                            <a href="/app/@n.DocType/@n.DocName" @onclick="() => Notifications.MarkRead(n.TenantId, n.UserId, n.Id)">@n.Subject</a>
                            <p>@n.Body</p>
                        </div>
                        <span class="muted small nowrap">@Fmt.When(n.At)</span>
                    </div>
                }
            </BbCardContent>
        </BbCard>
    }
</div>

@code {
    private IReadOnlyList<Notification> items = [];
    private PeriodicTimer? timer;
    private IDisposable? liveSub;

    protected override void OnInitialized()
    {
        Refresh();
        var u = Current.Required;
        liveSub = LiveNotifications.Subscribe(u.TenantId, u.Id, _ => InvokeAsync(() =>
        {
            Refresh();
            StateHasChanged();
        }));
        timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        _ = Loop();
    }

    private async Task Loop()
    {
        try { while (await timer!.WaitForNextTickAsync()) { Refresh(); await InvokeAsync(StateHasChanged); } }
        catch (ObjectDisposedException) { }
    }

    private void Refresh() => items = Notifications.ForUser(Current.Required.TenantId, Current.Required.Id)
        .Where(n => !DocumentComments.IsMentionNotification(n))
        .ToList();

    public void Dispose()
    {
        liveSub?.Dispose();
        timer?.Dispose();
    }
}

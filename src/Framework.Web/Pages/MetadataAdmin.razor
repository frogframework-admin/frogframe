@page "/admin/metadata"
@page "/admin/metadata/{Selected}"
@implements IDisposable
@using System.Text.Json
@inject MetadataRegistry Registry
@inject RoleCatalog RoleCatalogSvc
@inject CurrentUser Current
@inject ToastService Toasts
@inject NavigationManager Nav
@inject Framework.Preferences.IUserPreferenceStore UserPrefs
@inject Framework.Web.Tenancy.MetadataEditPolicy EditPolicy

<PageTitle>Metadata · FrogFrame</PageTitle>

@if (!Current.Required.Roles.Contains(UserContext.SystemManager))
{
    <ErrorState StatusCode="403" Description="This administration page is restricted to System Managers / Administrators." />
}
else
{
    <header class="page-head">
        <div>
            <h1>DocType Metadata</h1>
            <p>Manage DocType definitions, schema versions, workflows, and application form structures.</p>
        </div>
        @if (canEdit)
        {
            <BbButton Href="/admin/metadata/new" OnClick="@(() => Nav.NavigateTo("/admin/metadata/new"))"><LucideIcon Name="plus" Size="16" /> New DocType</BbButton>
        }
    </header>

    @if (!canEdit)
    {
        <BbAlert Variant="AlertVariant.Warning" Class="props-block">
            <BbAlertTitle>Read-only</BbAlertTitle>
            <BbAlertDescription>@Framework.Web.Tenancy.MetadataEditPolicy.DeniedMessage</BbAlertDescription>
        </BbAlert>
    }

    <BbDataGrid @key="gridMgr.RenderKey"
                TData="DocTypeRow"
                Items="@docTypes"
                ShowSearch="true"
                SearchPlaceholder="Search DocTypes..."
                ShowPagination="true"
                InitialPageSize="15"
                TableContainerClass="table-wrap"
                RowClass="@(d => gridMgr.IsSelected(d) ? "selected" : "")"
                Resizable="true"
                OnColumnResize="gridMgr.HandleResize"
                StateChanged="gridMgr.HandleStateChanged">
        <Toolbar>
            <AdminGridToolbar TData="DocTypeRow" Grid="gridMgr" Items="@docTypes" FileName="doctypes-metadata" Columns="@ExportColumns" />
        </Toolbar>
        <Columns>
            <AdminGridSelectColumn TData="DocTypeRow" Grid="gridMgr" Items="@docTypes" Title="" />

            <BbDataGridPropertyColumn TData="DocTypeRow" TProp="string" Property="d => d.Title" Id="name" Title="DocType Name"
                                      Width="@gridMgr.GetWidth("name")" Visible="@gridMgr.IsVisible("name")" Resizable="true" Sortable="true" Filterable="true">
                <CellTemplate Context="item">
                    <div>
                        <div style="display:flex;align-items:center;gap:.4rem">
                            <a href="@($"/admin/metadata/{item.Name}/editor")" @onclick="() => Edit(item.Name)" style="font-weight:600;color:inherit;text-decoration:none" class="hover:underline">
                                @item.Title
                            </a>
                            @if (item.IsChild)
                            {
                                <BbBadge Variant="BadgeVariant.Outline" Class="small">Child</BbBadge>
                            }
                        </div>
                        <div class="muted small"><code>@item.Name</code></div>
                    </div>
                </CellTemplate>
            </BbDataGridPropertyColumn>

            <BbDataGridPropertyColumn TData="DocTypeRow" TProp="int" Property="d => d.Version" Id="version" Title="Version"
                                      Width="@gridMgr.GetWidth("version", "6rem")" Visible="@gridMgr.IsVisible("version")" Resizable="true" Sortable="true">
                <CellTemplate Context="item">
                    <BbBadge Variant="BadgeVariant.Outline">v@(item.Version)</BbBadge>
                </CellTemplate>
            </BbDataGridPropertyColumn>

            <BbDataGridTemplateColumn TData="DocTypeRow" Id="status" Title="Source / Status"
                                      Width="@gridMgr.GetWidth("status", "11rem")" Visible="@gridMgr.IsVisible("status")" Resizable="true" Sortable="true" SortBy="d => d.StatusLabel">
                <ChildContent Context="item">
                    <div style="display:flex;flex-wrap:wrap;gap:.25rem" title="@item.StatusHint">
                        <BbBadge Variant="BadgeVariant.Outline">@(item.IsApp ? "Application" : "Custom")</BbBadge>
                        @if (item.CustomizationWarnings > 0)
                        {
                            <BbBadge Variant="BadgeVariant.SoftDestructive">Needs attention</BbBadge>
                        }
                        else if (item.CustomizationVersion is { } cv)
                        {
                            <BbBadge Variant="BadgeVariant.Warning">Customized v@(cv)</BbBadge>
                        }
                    </div>
                </ChildContent>
            </BbDataGridTemplateColumn>

            <BbDataGridTemplateColumn TData="DocTypeRow" Id="published" Title="Published"
                                      Width="@gridMgr.GetWidth("published", "12rem")" Visible="@gridMgr.IsVisible("published")" Resizable="true" Sortable="true" SortBy="d => d.PublishedAt">
                <ChildContent Context="item">
                    <span class="nowrap @(item.PublishedAt is null ? "muted" : "")" title="@(item.PublishedAt?.ToString("yyyy-MM-dd HH:mm:ss") ?? "")">
                        @(item.PublishedAt is { } t ? Fmt.When(t) : "—")
                    </span>
                </ChildContent>
            </BbDataGridTemplateColumn>

            <BbDataGridPropertyColumn TData="DocTypeRow" TProp="string" Property="d => d.CreatedBy" Id="created_by" Title="Created By"
                                      Width="@gridMgr.GetWidth("created_by", "10rem")" Visible="@gridMgr.IsVisible("created_by")" Resizable="true" Sortable="true" Filterable="true">
                <CellTemplate Context="item">
                    <span class="@(string.IsNullOrWhiteSpace(item.CreatedBy) ? "muted" : "")">
                        @(string.IsNullOrWhiteSpace(item.CreatedBy) ? "—" : item.CreatedBy)
                    </span>
                </CellTemplate>
            </BbDataGridPropertyColumn>

            <BbDataGridPropertyColumn TData="DocTypeRow" TProp="string" Property="d => d.Workflow" Id="workflow" Title="Workflow"
                                      Width="@gridMgr.GetWidth("workflow", "12rem")" Visible="@gridMgr.IsVisible("workflow")" Resizable="true" Sortable="true" Filterable="true">
                <CellTemplate Context="item">
                    @if (!string.IsNullOrWhiteSpace(item.Workflow))
                    {
                        <BbBadge Variant="BadgeVariant.Soft">@item.Workflow</BbBadge>
                    }
                    else
                    {
                        <span class="muted">—</span>
                    }
                </CellTemplate>
            </BbDataGridPropertyColumn>

            <BbDataGridTemplateColumn TData="DocTypeRow" Id="actions" Title="Actions" Width="@gridMgr.GetWidth("actions", "9.5rem")" Hideable="false" Resizable="false">
                <ChildContent Context="item">
                    <div style="display:inline-flex;align-items:center;gap:.35rem;flex-wrap:nowrap">
                        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" Href="@($"/admin/metadata/{item.Name}/editor")" OnClick="() => Edit(item.Name)" Title="Visual editor">
                            <LucideIcon Name="pencil" Size="14" /> Edit
                        </BbButton>
                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" AriaLabel="Version history &amp; JSON" Title="Version history &amp; JSON" OnClick="() => OpenDetail(item.Name)">
                            <LucideIcon Name="history" Size="15" />
                        </BbButton>
                    </div>
                </ChildContent>
            </BbDataGridTemplateColumn>
        </Columns>
        <EmptyTemplate>
            <div style="padding:2rem;text-align:center;color:var(--muted-foreground)">
                No DocTypes found.
            </div>
        </EmptyTemplate>
    </BbDataGrid>

    <AdminDrawer Open="@isDrawerOpen"
                 OpenChanged="@OnDrawerOpenChanged"
                 WidthScale="2.0"
                 Title="@(selectedMeta is null ? "" : $"{selectedMeta.Title} ({selectedMeta.Name})")"
                 Description="@(selectedMeta is null ? null : DrawerDescription(selectedMeta))">
        <ChildContent>
            @if (selectedMeta is not null)
            {
                <div class="row" style="margin-bottom:.75rem">
                    <BbButton Href="@($"/admin/metadata/{selectedMeta.Name}/editor")" OnClick="() => Edit(selectedMeta.Name)">
                        <LucideIcon Name="pencil-ruler" Size="16" /> Open in Visual Editor
                    </BbButton>
                </div>

                @if (selectedIsApp)
                {
                    foreach (var w in Registry.CustomizationWarnings(selectedMeta.Name))
                    {
                        <BbAlert Variant="AlertVariant.Warning" Class="props-block"><BbAlertDescription>Customization: @w</BbAlertDescription></BbAlert>
                    }
                    <BbCard>
                        <BbCardHeader>
                            <BbCardTitle Class="card-title">Customization History</BbCardTitle>
                            <BbCardDescription>Changes administrators made on top of the application's definition. They stay when the application is updated.</BbCardDescription>
                        </BbCardHeader>
                        <BbCardContent>
                            @{ var customHistory = Registry.CustomizationHistory(selectedMeta.Name); }
                            @if (customHistory.Count == 0)
                            {
                                <p class="muted small">Not customized: the application's definition is used as deployed.</p>
                            }
                            else
                            {
                                <div class="table-wrap">
                                    <table class="data">
                                        <thead><tr><th>Version</th><th>Saved</th><th>Content</th></tr></thead>
                                        <tbody>
                                            @foreach (var c in customHistory.OrderByDescending(c => c.Version))
                                            {
                                                <tr>
                                                    <td>
                                                        v@(c.Version)
                                                        @if (c.Version == customHistory[^1].Version)
                                                        {
                                                            <BbBadge Variant="BadgeVariant.SoftSuccess">Active</BbBadge>
                                                        }
                                                    </td>
                                                    <td class="nowrap">@c.ModifiedBy, @Fmt.When(c.Modified)</td>
                                                    <td>@(c.IsEmpty ? "Reset to application default" : $"{c.CustomFields.Count} custom field(s), {c.PropertySetters.Count} change(s){(c.FieldOrder is null ? "" : ", field order")}")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </BbCardContent>
                    </BbCard>
                }

                <BbCard>
                    <BbCardHeader><BbCardTitle Class="card-title">@(selectedIsApp ? "Application Versions" : "Version History")</BbCardTitle></BbCardHeader>
                    <BbCardContent>
                        <div class="table-wrap">
                            <table class="data">
                                <thead><tr><th>Version</th><th>Status</th><th>Published</th><th>Changes</th></tr></thead>
                                <tbody>
                                    @foreach (var v in Registry.History(selectedMeta.Name).OrderByDescending(v => v.Version))
                                    {
                                        <tr>
                                            <td>v@(v.Version)</td>
                                            <td>@if (v.Status == MetadataStatus.Published) { <BbBadge Variant="BadgeVariant.SoftSuccess">Active</BbBadge> } else { <BbBadge Variant="BadgeVariant.Outline">Deprecated</BbBadge> }</td>
                                            <td class="nowrap">@v.PublishedBy, @Fmt.When(v.PublishedAt)</td>
                                            <td>@string.Join("; ", v.Changes.Select(c => c.Description).Take(3))@(v.Changes.Count > 3 ? $" (+{v.Changes.Count - 3})" : "")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </BbCardContent>
                </BbCard>

                @if (!selectedMeta.Def.IsChild)
                {
                    var wfName = selectedMeta.Def.Workflow;
                    <BbCard>
                        <BbCardHeader>
                            <BbCardTitle Class="card-title">Workflow</BbCardTitle>
                            <BbCardDescription>@(wfName is null ? "No workflow configured." : $"Using {wfName} v{selectedMeta.Workflow?.Def.Version}.")</BbCardDescription>
                        </BbCardHeader>
                        <BbCardContent>
                            @if (selectedMeta.Workflow is { } cw)
                            {
                                <WorkflowDiagram Workflow="cw.Def" />
                                <div class="row" style="margin-top:.75rem"><BbButton Variant="ButtonVariant.Outline" Href="@($"/admin/workflows/{cw.Def.Name}/editor")" OnClick="@(() => Nav.NavigateTo($"/admin/workflows/{cw.Def.Name}/editor"))"><LucideIcon Name="git-branch" Size="16" /> Edit workflow</BbButton></div>
                            }
                            else
                            {
                                <div class="row">
                                    <BbButton Variant="ButtonVariant.Outline" Href="@($"/admin/workflows/new?doctype={selectedMeta.Name}")" OnClick="@(() => Nav.NavigateTo($"/admin/workflows/new?doctype={selectedMeta.Name}"))"><LucideIcon Name="git-branch-plus" Size="16" /> Create workflow</BbButton>
                                    <BbButton Variant="ButtonVariant.Ghost" Href="/admin/workflows" OnClick="@(() => Nav.NavigateTo("/admin/workflows"))">Manage workflows</BbButton>
                                </div>
                            }
                        </BbCardContent>
                    </BbCard>
                }

                @if (selectedIsApp)
                {
                    <BbAlert Variant="AlertVariant.Info" Class="props-block">
                        <BbAlertDescription>
                            This DocType comes from the application: change it in the <strong>Visual Editor</strong>, which saves a customization on top of the application's definition.
                            Editing the full JSON is only available for DocTypes created here.
                        </BbAlertDescription>
                    </BbAlert>
                }
                else if (canEdit)
                {
                <BbCard>
                    <BbCardHeader>
                        <BbCardTitle Class="card-title">Draft v@(selectedMeta.Version + 1) (JSON)</BbCardTitle>
                        <BbCardDescription>Modify labels (safe), add Select options, change <code>requiredWhen</code>, or delete fields (risky), then inspect the diff.</BbCardDescription>
                    </BbCardHeader>
                    <BbCardContent>
                        <div class="stack">
                            <div class="code"><BbTextarea Value="@draft" ValueChanged="SetDraft" UpdateTiming="UpdateTiming.OnChange"
                                        AriaLabel="JSON metadata" AdditionalAttributes="@(new Dictionary<string, object> { ["rows"] = 16, ["spellcheck"] = "false" })" /></div>
                            <div class="row">
                                <BbButton Variant="ButtonVariant.Outline" OnClick="Check"><LucideIcon Name="search" Size="16" /> Inspect draft</BbButton>
                                <BbButton Disabled="@(preview is not { Valid: true } || (preview.Risk == ChangeRisk.Risky && !ack))" OnClick="Publish">
                                    Publish v@(selectedMeta.Version + 1)
                                </BbButton>
                                @if (preview is { Risk: ChangeRisk.Risky, Valid: true })
                                {
                                    <div class="label-row"><BbCheckbox Id="ack" @bind-Checked="ack" /><BbLabel For="ack">I have reviewed risky changes</BbLabel></div>
                                }
                            </div>
                            @if (message is not null) { <BbAlert Variant="AlertVariant.Danger"><BbAlertDescription>@message</BbAlertDescription></BbAlert> }
                            @if (preview is not null)
                            {
                                @if (preview.Errors.Count > 0)
                                {
                                    <BbAlert Variant="AlertVariant.Danger">
                                        <BbAlertTitle>Draft failed validation</BbAlertTitle>
                                        <BbAlertDescription><ul class="error-list">@foreach (var e in preview.Errors) { <li><code>@e.Path</code> @e.Message</li> }</ul></BbAlertDescription>
                                    </BbAlert>
                                }
                                @if (preview.Changes.Count > 0)
                                {
                                    <ul class="diff">
                                        @foreach (var c in preview.Changes.OrderByDescending(c => c.Risk))
                                        {
                                            <li><BbBadge Variant="@RiskVariant(c.Risk)">@RiskLabel(c.Risk)</BbBadge> <code>@c.Path</code> <span>@c.Description</span></li>
                                        }
                                    </ul>
                                }
                                else if (preview.Valid) { <p class="muted small">No changes compared to the active version.</p> }
                            }
                        </div>
                    </BbCardContent>
                </BbCard>
                }
            }
        </ChildContent>
    </AdminDrawer>
}

@code {
    [Parameter] public string? Selected { get; set; }

    private sealed class DocTypeRow
    {
        public string Name { get; set; } = "";
        public string Title { get; set; } = "";
        public int Version { get; set; }
        public bool IsChild { get; set; }
        public bool IsApp { get; set; }
        public int? CustomizationVersion { get; set; }
        public int CustomizationWarnings { get; set; }
        public string StatusLabel => IsApp ? CustomizationWarnings > 0 ? "Application · needs attention" : CustomizationVersion is { } v ? $"Application · customized v{v}" : "Application" : "Custom";
        public string StatusHint => CustomizationWarnings > 0
            ? "Part of the customization could not be applied after an application update. Open the editor to review it."
            : IsApp ? "Shipped with the application; administrators can add a customization on top." : "Created by administrators in this installation.";
        public DateTimeOffset? PublishedAt { get; set; }
        public string? PublishedBy { get; set; }
        public string? CreatedBy { get; set; }
        public string? Workflow { get; set; }
    }

    private List<DocTypeRow> docTypes = [];
    private bool isDrawerOpen;
    private CompiledDocType? selectedMeta;
    private string draft = "";
    private PublishPreview? preview;
    private bool ack;
    private string? message;
    private bool canEdit;
    private string draftOriginal = "";
    private bool selectedIsApp => selectedMeta is not null && Registry.IsAppOwned(selectedMeta.Name);
    private Framework.Web.Services.DataGridPreferenceManager<DocTypeRow> gridMgr = default!;

    private static readonly IReadOnlyList<GridExportColumn<DocTypeRow>> ExportColumns =
    [
        new("name", "DocType Title", d => d.Title),
        new("name", "DocType Name", d => d.Name),
        new("name", "Is Child", d => d.IsChild),
        new("version", "Version", d => d.Version),
        new("status", "Source / Status", d => d.StatusLabel),
        new("published", "Published At", d => d.PublishedAt),
        new("created_by", "Created By", d => d.CreatedBy),
        new("workflow", "Workflow", d => d.Workflow)
    ];

    protected override async Task OnInitializedAsync()
    {
        gridMgr = new(UserPrefs, Current, "grid:admin:metadata", StateHasChanged);
        await gridMgr.InitializeAsync();
        canEdit = await EditPolicy.CanEditAsync(Current.User);
    }

    protected override void OnInitialized()
    {
        Registry.Published += OnRegistryPublished;
        LoadRows();
    }

    private async Task ResetColumnsLayout()
    {
        await gridMgr.ResetAsync();
        Toasts.Success("Column layout has been reset to default.", "Reset Columns");
    }

    private void OnRegistryPublished(MetadataSnapshot _)
    {
        InvokeAsync(() =>
        {
            LoadRows();
            if (selectedMeta is not null && Registry.Current.TryGet(selectedMeta.Name, out var updated) && !ReferenceEquals(updated, selectedMeta))
            {
                var changed = updated.Version != selectedMeta.Version;
                selectedMeta = updated;
                // Keep a JSON draft the administrator is typing; only refresh an untouched one.
                if (draft == draftOriginal) ResetDraft();
                else if (changed) message = $"{updated.Name} v{updated.Version} was just published by someone else. Your draft is based on an older version: copy your changes, then close and reopen this panel.";
            }
            StateHasChanged();
        });
    }

    private string? loadedKey = "\0";
    protected override void OnParametersSet()
    {
        if (Selected == loadedKey) return;
        loadedKey = Selected;
        if (!string.IsNullOrEmpty(Selected) && Registry.Current.TryGet(Selected, out var meta))
        {
            selectedMeta = meta;
            ResetDraft();
            isDrawerOpen = true;
        }
    }

    private void LoadRows()
    {
        var list = new List<DocTypeRow>();
        foreach (var d in Registry.Current.DocTypes.Values.OrderBy(d => d.Name))
        {
            var history = Registry.History(d.Name);
            var active = history.FirstOrDefault(v => v.Version == d.Version && v.Status == MetadataStatus.Published)
                         ?? history.OrderByDescending(v => v.Version).FirstOrDefault();
            var first = history.OrderBy(v => v.Version).FirstOrDefault();

            var publishedAt = active?.PublishedAt;
            var publishedBy = active?.PublishedBy;
            var createdBy = first?.PublishedBy ?? publishedBy;

            list.Add(new DocTypeRow
            {
                Name = d.Name,
                Title = d.Title,
                Version = d.Version,
                IsChild = d.Def.IsChild,
                IsApp = Registry.IsAppOwned(d.Name),
                CustomizationVersion = Registry.Customization(d.Name)?.Version,
                CustomizationWarnings = Registry.CustomizationWarnings(d.Name).Count,
                PublishedAt = publishedAt,
                PublishedBy = publishedBy,
                CreatedBy = createdBy,
                Workflow = d.Def.Workflow
            });
        }
        docTypes = list;
    }

    private void Edit(string docTypeName) => Nav.NavigateTo($"/admin/metadata/{docTypeName}/editor");

    private void OpenDetail(string docTypeName)
    {
        Selected = docTypeName;
        loadedKey = docTypeName;
        if (Registry.Current.TryGet(docTypeName, out var meta))
        {
            selectedMeta = meta;
            ResetDraft();
            isDrawerOpen = true;
        }
    }

    private void OnDrawerOpenChanged(bool open)
    {
        isDrawerOpen = open;
        if (!open)
        {
            selectedMeta = null;
            Selected = null;
            loadedKey = null;
        }
    }

    private void ResetDraft()
    {
        preview = null; message = null; ack = false;
        if (selectedMeta is not null)
        {
            var copy = JsonSerializer.Deserialize<DocTypeDef>(MetadataJson.Serialize(selectedMeta.Def), MetadataJson.Options)!;
            copy.Version = selectedMeta.Version + 1;
            draft = MetadataJson.Serialize(copy);
            draftOriginal = draft;
        }
    }

    private void SetDraft(string? v) { draft = v ?? ""; preview = null; }

    private static string RiskLabel(ChangeRisk r) => r switch { ChangeRisk.Safe => "Safe", ChangeRisk.NeedsTransform => "Needs transform", _ => "Risky" };
    private static BadgeVariant RiskVariant(ChangeRisk r) => r switch { ChangeRisk.Safe => BadgeVariant.SoftSuccess, ChangeRisk.NeedsTransform => BadgeVariant.Warning, _ => BadgeVariant.SoftDestructive };

    private DocTypeDef? Parse()
    {
        try { return MetadataJson.ParseDocType(draft); }
        catch (JsonException ex) { message = $"Invalid JSON: {ex.Message}"; preview = null; return null; }
    }

    private void Check()
    {
        message = null;
        if (Parse() is { } def) preview = Registry.Preview(def, RoleCatalogSvc.Scope(Current.Required.TenantId));
    }

    private string DrawerDescription(CompiledDocType m)
    {
        var kind = m.Def.IsChild ? "Child table" : "Standard DocType";
        if (!Registry.IsAppOwned(m.Name)) return $"Active version v{m.Version} · {kind}";
        return Registry.Customization(m.Name) is { } c
            ? $"Application definition v{m.Version} + customization v{c.Version} · {kind}"
            : $"Application definition v{m.Version} · not customized · {kind}";
    }

    private void Publish()
    {
        if (!canEdit) { message = Framework.Web.Tenancy.MetadataEditPolicy.DeniedMessage; return; }
        if (selectedIsApp) { message = "Application DocTypes are changed in the Visual Editor."; return; }
        if (Parse() is not { } def) return;
        try
        {
            var v = Registry.Publish(def, Current.Required.Id, ack, scope: RoleCatalogSvc.Scope(Current.Required.TenantId));
            Toasts.Success("Forms and lists will now use this version immediately.", $"{v.DocType} v{v.Version} published");
            LoadRows();
            if (Registry.Current.TryGet(def.Name, out var updated))
            {
                selectedMeta = updated;
                ResetDraft();
            }
        }
        catch (Exception ex) when (ex is MetadataCompilationException or InvalidOperationException)
        {
            message = ex.Message;
        }
    }

    public void Dispose()
    {
        Registry.Published -= OnRegistryPublished;
        gridMgr?.Dispose();
    }
}

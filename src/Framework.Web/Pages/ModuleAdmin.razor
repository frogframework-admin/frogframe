@page "/admin/modules"
@using Framework.Navigation
@using Framework.Security
@using Framework.Web.Admin
@inject INavigationMenuStore MenuStore
@inject RoleCatalog RoleCatalogSvc
@inject IRoleStore RoleStore
@inject IMetadataProvider Metadata
@inject CurrentUser Current
@inject ToastService Toasts
@inject DialogService Dialogs

<PageTitle>Master Modules · DocFrame</PageTitle>

@if (!Current.Required.IsAdmin)
{
    <BbAlert Variant="AlertVariant.Danger"><BbAlertDescription>This page is only accessible to Administrators / System Managers.</BbAlertDescription></BbAlert>
}
else
{
    <header class="page-head">
        <div>
            <h1>Master Modules</h1>
            <p>Manage primary application modules and module access permissions based on user roles. Each module consists of one or more menu groups.</p>
        </div>
        <div class="row" style="gap:.5rem">
            <BbButton Variant="ButtonVariant.Outline" Disabled="busy" OnClick="ResetDefaults"><LucideIcon Name="rotate-ccw" Size="16" /> Seed Defaults</BbButton>
            <BbButton OnClick="StartCreate"><LucideIcon Name="plus" Size="16" /> Add module</BbButton>
        </div>
    </header>

    <BbDataGrid TData="NavigationModule"
                Items="@modules"
                ShowSearch="true"
                SearchPlaceholder="Search modules..."
                ShowPagination="true"
                InitialPageSize="10"
                TableContainerClass="table-wrap"
                RowClass="@(m => edit?.Id == m.Id ? "selected" : "")">
        <Columns>
            <BbDataGridPropertyColumn TData="NavigationModule" TProp="int" Property="m => m.SortOrder" Title="Order" Width="5rem" Sortable="true">
                <CellTemplate Context="item">
                    <code>@item.SortOrder</code>
                </CellTemplate>
            </BbDataGridPropertyColumn>

            <BbDataGridPropertyColumn TData="NavigationModule" TProp="string" Property="m => m.Name" Title="Module" Width="18rem" Sortable="true" Filterable="true">
                <CellTemplate Context="item">
                    <div class="row" style="gap:.6rem;align-items:center;flex-wrap:nowrap">
                        <div style="display:grid;place-items:center;width:2rem;height:2rem;border-radius:var(--radius);background:var(--muted);flex-shrink:0">
                            <LucideIcon Name="@(string.IsNullOrWhiteSpace(item.Icon) ? "layout-grid" : item.Icon)" Size="16" />
                        </div>
                        <div style="min-width:0">
                            <strong>@item.Name</strong>
                            @if (!string.IsNullOrWhiteSpace(item.Description))
                            {
                                <div class="muted small" style="white-space:normal">@item.Description</div>
                            }
                        </div>
                    </div>
                </CellTemplate>
            </BbDataGridPropertyColumn>

            <BbDataGridTemplateColumn TData="NavigationModule" Title="Menu Groups" Width="9rem">
                <ChildContent Context="item">
                    @{
                        var grpCount = groups.Count(g => g.ModuleId == item.Id);
                    }
                    <BbBadge Variant="BadgeVariant.Outline">@grpCount groups</BbBadge>
                </ChildContent>
            </BbDataGridTemplateColumn>

            <BbDataGridTemplateColumn TData="NavigationModule" Title="Role Permissions">
                <ChildContent Context="item">
                    @if (item.AllowedRoles.Count == 0)
                    {
                        <BbBadge Variant="BadgeVariant.SoftSuccess">All Users</BbBadge>
                    }
                    else
                    {
                        <div class="row" style="gap:.25rem;flex-wrap:wrap">
                            @foreach (var r in item.AllowedRoles)
                            {
                                <BbBadge Variant="BadgeVariant.Soft">@r</BbBadge>
                            }
                        </div>
                    }
                </ChildContent>
            </BbDataGridTemplateColumn>

            <BbDataGridTemplateColumn TData="NavigationModule" Title="Status" Width="9rem" Sortable="true" SortBy="m => m.IsActive">
                <ChildContent Context="item">
                    <div class="row" style="gap:.25rem;flex-wrap:nowrap">
                        @if (item.IsSystem)
                        {
                            <BbBadge Variant="BadgeVariant.Soft">System</BbBadge>
                        }
                        @if (item.IsActive)
                        {
                            <BbBadge Variant="BadgeVariant.SoftSuccess">Active</BbBadge>
                        }
                        else
                        {
                            <BbBadge Variant="BadgeVariant.Secondary">Inactive</BbBadge>
                        }
                    </div>
                </ChildContent>
            </BbDataGridTemplateColumn>

            <BbDataGridTemplateColumn TData="NavigationModule" Title="Actions" Width="6.5rem" NoWrap="true">
                <ChildContent Context="item">
                    <div style="display:inline-flex;align-items:center;gap:.25rem;flex-wrap:nowrap" @onclick:stopPropagation="true">
                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" AriaLabel="Edit module" OnClick="() => StartEdit(item)">
                            <LucideIcon Name="pencil" Size="15" />
                        </BbButton>
                        @if (!item.IsSystem)
                        {
                            <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" AriaLabel="Delete module" OnClick="() => ConfirmDelete(item)">
                                <LucideIcon Name="trash-2" Size="15" />
                            </BbButton>
                        }
                    </div>
                </ChildContent>
            </BbDataGridTemplateColumn>
        </Columns>
        <EmptyTemplate>
            <div style="padding:2rem;text-align:center;color:var(--muted-foreground)">
                No modules found.
            </div>
        </EmptyTemplate>
    </BbDataGrid>

    <AdminDrawer Open="@isDrawerOpen"
                 OpenChanged="@OnDrawerOpenChanged"
                 WidthScale="@DrawerWidthScale"
                 Title="@(edit is null ? "" : isNew ? "Add New Module" : $"Edit: {edit.Name}")"
                 Description="@(edit is null ? null : edit.IsSystem ? "Built-in system module (cannot be deleted, but name, icon, sort order, and permissions can be edited)." : "Custom application module.")">
        <ChildContent>
            @if (edit is not null)
            {
                @if (error is not null)
                {
                    <BbAlert Variant="AlertVariant.Danger"><BbAlertDescription>@error</BbAlertDescription></BbAlert>
                }

                <div class="form-cols cols-2">
                    <BbField>
                        <BbFieldLabel For="mod-name">Module Name</BbFieldLabel>
                        <FormTextInput Id="mod-name" Immediate="true" @bind-Value="edit.Name" Placeholder="e.g. Human Resources, Finance, Inventory" />
                    </BbField>
                    <BbField>
                        <BbFieldLabel For="mod-code">Kode modul (wajib, unik)</BbFieldLabel>
                        <FormTextInput Id="mod-code" @bind-Value="edit.Code" Disabled="!isNew" Placeholder="e.g. HR, PROCUREMENT, KEUANGAN" />
                        <BbFieldDescription>Dipakai DocType sebagai Modul. Huruf besar, angka, atau garis bawah. Tidak bisa diubah setelah dibuat.</BbFieldDescription>
                    </BbField>

                    <BbField>
                        <BbFieldLabel For="mod-order">Order (Sort Order)</BbFieldLabel>
                        <FormTextInput Id="mod-order" Type="number" Immediate="true" Value="@edit.SortOrder.ToString()" ValueChanged="v => edit.SortOrder = int.TryParse(v, out var n) ? n : edit.SortOrder" />
                        <BbFieldDescription>Lower numbers appear earlier (e.g. 10, 20, 30).</BbFieldDescription>
                    </BbField>
                </div>

                <BbField>
                    <BbFieldLabel For="mod-desc">Description</BbFieldLabel>
                    <FormTextInput Id="mod-desc" Immediate="true" @bind-Value="edit.Description" Placeholder="e.g. Financial and accounting management" />
                    <BbFieldDescription>Brief summary of module purpose shown on the module picker page.</BbFieldDescription>
                </BbField>

                <BbField>
                    <BbFieldLabel For="mod-icon">Lucide Icon</BbFieldLabel>
                    <div class="row" style="gap:.5rem;align-items:center;flex-wrap:nowrap">
                        <FormTextInput Id="mod-icon" Immediate="true" @bind-Value="edit.Icon" Placeholder="e.g. users, shopping-cart, wallet, package, chart-column, settings" />
                        <div style="display:flex;align-items:center;justify-content:center;width:2.5rem;height:2.5rem;border:1px solid var(--border);border-radius:var(--radius);background:var(--muted);flex-shrink:0">
                            <LucideIcon Name="@(string.IsNullOrWhiteSpace(edit.Icon) ? "layout-grid" : edit.Icon)" Size="18" />
                        </div>
                    </div>
                    <BbFieldDescription>Lucide icon name (e.g. users, shopping-cart, wallet, package, chart-column, settings).</BbFieldDescription>
                </BbField>

                <div class="props-sub">Module Permissions (User Roles)</div>
                <p class="muted small">Select roles authorized to access this module (multiple allowed). If none selected, the module is accessible to <strong>All Users</strong>.</p>
                <div class="role-check-grid">
                    @foreach (var r in AvailableRoles)
                    {
                        var role = r;
                        <div class="label-row">
                            <BbCheckbox Id="@($"mod-role-{role}")" Checked="edit.AllowedRoles.Contains(role)" CheckedChanged="v => ToggleRole(role, v)" />
                            <BbLabel For="@($"mod-role-{role}")">@role</BbLabel>
                        </div>
                    }
                </div>

                <div class="label-row" style="margin-top:.5rem">
                    <BbCheckbox Id="mod-active" Checked="edit.IsActive" CheckedChanged="v => edit.IsActive = v" />
                    <BbLabel For="mod-active">Active (displayed in module selector page)</BbLabel>
                </div>
            }
        </ChildContent>
        <FooterContent>
            @if (edit is not null)
            {
                <div class="row" style="gap:.5rem;width:100%;align-items:center">
                    <BbButton Disabled="busy" Loading="busy" LoadingText="Saving…" OnClick="Save"><LucideIcon Name="check" Size="16" /> Save</BbButton>
                    <BbButton Variant="ButtonVariant.Ghost" OnClick="CloseDrawer">Cancel</BbButton>
                    @if (!isNew && !edit.IsSystem)
                    {
                        <span style="margin-left:auto">
                            <BbButton Variant="ButtonVariant.Destructive" Size="ButtonSize.Small" Disabled="busy" OnClick="() => ConfirmDelete(edit)">
                                <LucideIcon Name="trash-2" Size="15" /> Delete
                            </BbButton>
                        </span>
                    }
                </div>
            }
        </FooterContent>
    </AdminDrawer>
}

@code {
    /// <summary>Configurable drawer width multiplier (default 2.0 = 2x normal width for Module form).</summary>
    [Parameter] public double DrawerWidthScale { get; set; } = 2.0;

    private IReadOnlyList<NavigationModule> modules = [];
    private IReadOnlyList<NavigationMenuGroup> groups = [];
    private IReadOnlyList<RoleDef> storedRoles = [];
    private NavigationModule? edit;
    private bool isDrawerOpen;
    private bool isNew;
    private bool busy;
    private string? error;

    private IEnumerable<string> AvailableRoles => MetadataRoles.Known(Metadata.Current, RoleCatalogSvc.Names(Current.Required.TenantId))
        .Append(UserContext.Administrator)
        .Concat(storedRoles.Select(r => r.Name))
        .Distinct()
        .Order();

    protected override async Task OnInitializedAsync()
    {
        if (Current.User is null) return;
        storedRoles = await RoleStore.ListAsync(Current.Required.TenantId);
        await Reload();
    }

    private async Task Reload()
    {
        var tenantId = Current.Required.TenantId;
        modules = await MenuStore.ListModulesAsync(tenantId, onlyActive: false);
        groups = await MenuStore.ListGroupsAsync(tenantId, onlyActive: false);
    }

    private void StartCreate()
    {
        error = null;
        isNew = true;
        edit = new NavigationModule
        {
            Id = Guid.NewGuid().ToString("N"),
            TenantId = Current.Required.TenantId,
            Name = "",
            Code = "",
            Description = "",
            Icon = "layout-grid",
            SortOrder = modules.Count > 0 ? modules.Max(m => m.SortOrder) + 10 : 10,
            AllowedRoles = [],
            IsActive = true,
            IsSystem = false
        };
        isDrawerOpen = true;
    }

    private void StartEdit(NavigationModule item)
    {
        error = null;
        isNew = false;
        edit = new NavigationModule
        {
            Id = item.Id,
            TenantId = item.TenantId,
            Name = item.Name,
            Code = item.Code,
            Description = item.Description,
            Icon = item.Icon,
            SortOrder = item.SortOrder,
            AllowedRoles = [.. item.AllowedRoles],
            IsSystem = item.IsSystem,
            IsActive = item.IsActive,
            CreatedAt = item.CreatedAt,
            UpdatedAt = item.UpdatedAt
        };
        isDrawerOpen = true;
    }

    private void CloseDrawer()
    {
        isDrawerOpen = false;
    }

    private void OnDrawerOpenChanged(bool open)
    {
        isDrawerOpen = open;
        if (!open)
        {
            edit = null;
            error = null;
        }
    }

    private void ToggleRole(string role, bool isChecked)
    {
        if (edit is null) return;
        if (isChecked)
        {
            if (!edit.AllowedRoles.Contains(role)) edit.AllowedRoles.Add(role);
        }
        else
        {
            edit.AllowedRoles.Remove(role);
        }
    }

    private async Task Save()
    {
        if (edit is null || busy) return;
        if (string.IsNullOrWhiteSpace(edit.Name))
        {
            error = "Module name cannot be empty.";
            Toasts.Error(error, "Failed to Save");
            return;
        }

        edit.Name = edit.Name.Trim();
        try { edit.Code = NavigationModule.NormalizeCode(edit.Code); }
        catch (ArgumentException ex) { error = ex.Message; Toasts.Error(ex.Message, "Failed to Save"); return; }
        edit.Description = string.IsNullOrWhiteSpace(edit.Description) ? null : edit.Description.Trim();
        edit.Icon = string.IsNullOrWhiteSpace(edit.Icon) ? "layout-grid" : edit.Icon.Trim();

        busy = true;
        error = null;
        StateHasChanged();

        try
        {
            await MenuStore.SaveModuleAsync(edit);
            Toasts.Success($"Module \"{edit.Name}\" successfully saved.", "Successfully Saved");
            isDrawerOpen = false;
            await Reload();
        }
        catch (Exception ex)
        {
            error = ex.Message;
            Toasts.Error(ex.Message, "Failed to Save");
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ConfirmDelete(NavigationModule item)
    {
        if (item.IsSystem)
        {
            Toasts.Error("Built-in system modules cannot be deleted.", "Not Allowed");
            return;
        }

        var res = await Dialogs.ConfirmAsync(
            $"Delete module \"{item.Name}\"?",
            "This module will be deleted if it no longer contains menu groups. This action cannot be undone.",
            new ConfirmDialogOptions { Destructive = true, ConfirmText = "Delete Module", CancelText = "Cancel" });

        if (!res.Confirmed) return;

        busy = true;
        try
        {
            await MenuStore.DeleteModuleAsync(item.Id, item.TenantId);
            if (edit?.Id == item.Id) isDrawerOpen = false;
            Toasts.Success($"Module \"{item.Name}\" successfully deleted.", "Module Deleted");
            await Reload();
        }
        catch (Exception ex)
        {
            Toasts.Error(ex.Message, "Failed to Delete Module");
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ResetDefaults()
    {
        var res = await Dialogs.ConfirmAsync(
            "Seed / Restore Default Modules?",
            "The system will verify and seed missing modules, menu groups, and built-in menus into the database.",
            new ConfirmDialogOptions { ConfirmText = "Run Seed", CancelText = "Cancel" });

        if (!res.Confirmed) return;

        busy = true;
        try
        {
            await MenuStore.EnsureDefaultMenusAsync(Current.Required.TenantId);
            Toasts.Success("Default modules and menu groups successfully verified and seeded.", "Seed Successful");
            await Reload();
        }
        catch (Exception ex)
        {
            Toasts.Error(ex.Message, "Failed to Seed Modules");
        }
        finally
        {
            busy = false;
        }
    }
}

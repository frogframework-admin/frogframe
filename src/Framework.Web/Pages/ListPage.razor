@page "/app/{DocType}"
@inject DocumentService Docs
@inject CurrentUser Current
@inject IMetadataProvider Metadata
@inject IPermissionService Perms
@inject NavigationManager Nav
@inject Framework.Imports.DataImportService Importer
@inject DialogService Dialogs
@inject ToastService Toasts

<PageTitle>@(meta?.Title ?? DocType) · DocFrame</PageTitle>

@if (fatal is not null)
{
    <BbAlert Variant="AlertVariant.Danger"><BbAlertTitle>Tidak dapat dibuka</BbAlertTitle><BbAlertDescription>@fatal</BbAlertDescription></BbAlert>
}
else if (meta is not null)
{
    <header class="page-head">
        <div>
            <h1>@meta.Title</h1>
            <p>@(result is null ? "Memuat…" : $"{TotalText} dokumen dalam cakupan akses Anda")</p>
        </div>
        @if (Perms.Can(Current.Required, meta, DocActions.Create) || Perms.Can(Current.Required, meta, DocActions.Delete))
        {
            <div class="row">
                @if (Perms.Can(Current.Required, meta, DocActions.Delete))
                {
                    <BbButton Variant="ButtonVariant.Destructive"
                              Disabled="@(selectedItems.Count == 0 || busy)"
                              OnClick="DeleteSelected">
                        <LucideIcon Name="trash-2" Size="16" /> Hapus @(selectedItems.Count > 0 ? $"({selectedItems.Count})" : "")
                    </BbButton>
                }
                @if (Importer.CanImport(Current.Required, meta.Name))
                {
                    <BbButton Variant="ButtonVariant.Outline" Href="@($"/app/{meta.Name}/import")"><LucideIcon Name="file-up" Size="16" /> Impor</BbButton>
                }
                @if (Perms.Can(Current.Required, meta, DocActions.Create))
                {
                    <BbButton Href="@($"/app/{meta.Name}/new")"><LucideIcon Name="plus" Size="16" /> Buat @meta.Title.ToLower()</BbButton>
                }
            </div>
        }
    </header>

    <div class="filters" role="search">
        <div class="filter search">
            <span>Cari</span>
            <BbInput Value="@search" ValueChanged="OnSearch" UpdateTiming="UpdateTiming.Debounced" DebounceInterval="300"
                     Placeholder="@($"{string.Join(" / ", meta.Def.ListView.SearchFields.Select(LabelOf))}…")" AriaLabel="Cari" />
        </div>
        @foreach (var fName in meta.Def.ListView.Filters)
        {
            var f = fName;
            <div class="filter">
                <span>@LabelOf(f)</span>
                @if (FilterOptions(f) is { } opts)
                {
                    <BbSelect TValue="string" Value="@(filters.TryGetValue(f, out var cur) ? cur.Value as string : "")" ValueChanged="v => SetFilter(f, v)"
                              Options="opts" AriaLabel="@LabelOf(f)" />
                }
                else if (meta.ByName.TryGetValue(f, out var cf) && cf.Def.Type == "Date")
                {
                    <BbDatePicker Value="@(filters.TryGetValue(f, out var dc) ? DateTime.Parse((string)dc.Value!) : null)"
                                  ValueChanged="d => SetFilter(f, d?.ToString(DateFmt))" Placeholder="Sejak tanggal" DateFormat="d MMM yyyy" AriaLabel="@LabelOf(f)" />
                }
                else
                {
                    <BbInput ValueChanged="v => SetFilter(f, v)" UpdateTiming="UpdateTiming.OnChange" AriaLabel="@LabelOf(f)" />
                }
            </div>
        }
    </div>

    @if (error is not null)
    {
        <BbAlert Variant="AlertVariant.Danger" Class="crumbs"><BbAlertDescription>@error</BbAlertDescription></BbAlert>
    }

    @if (result is null)
    {
        <div class="stack"><BbSkeleton Height="2.5rem" /><BbSkeleton Height="2.5rem" /><BbSkeleton Height="2.5rem" /></div>
    }
    else if (result.Items.Count == 0)
    {
        <BbEmpty Title="@($"Belum ada {meta.Title.ToLower()} yang cocok")"
                 Description="@(filters.Count > 0 || !string.IsNullOrEmpty(search) ? "Ubah atau kosongkan filter untuk melihat dokumen lain." : "Dokumen yang Anda buat atau yang dibagikan ke peran Anda akan muncul di sini.")">
            <Icon><LucideIcon Name="search" Size="28" /></Icon>
        </BbEmpty>
    }
    else
    {
        <BbDataGrid TData="Dictionary<string, object?>"
                    Items="@result.Items"
                    SelectionMode="DataTableSelectionMode.Multiple"
                    SelectedItemsChanged="OnSelectedItemsChanged"
                    ItemKey="@(r => (string)r["name"]!)"
                    ShowPagination="true"
                    InitialPageSize="10"
                    PageSizes="@([10, 20, 50, 100])"
                    TableContainerClass="table-wrap">
            <Columns>
                <BbDataGridSelectColumn TData="Dictionary<string, object?>" Width="3rem" />

                <BbDataGridTemplateColumn TData="Dictionary<string, object?>" Title="Nomor" Sortable="true" SortBy="@(r => (string)r["name"]!)">
                    <ChildContent Context="row">
                        <a class="doc-link" href="/app/@meta.Name/@((string)row["name"]!)">@((string)row["name"]!)</a>
                    </ChildContent>
                </BbDataGridTemplateColumn>

                @foreach (var c in result.Columns)
                {
                    var colKey = c;
                    var cf = meta.ByName.GetValueOrDefault(colKey);
                    <BbDataGridTemplateColumn TData="Dictionary<string, object?>" Title="@LabelOf(colKey)" Sortable="true" SortBy="@(r => (object?)(r.GetValueOrDefault(colKey) ?? ""))">
                        <ChildContent Context="row">
                            @if (cf?.Type.Editor == "image")
                            {
                                @if (row.GetValueOrDefault(colKey) is string img)
                                {
                                    <img class="thumb" src="@($"/files/{img}")" alt="" loading="lazy" />
                                }
                                else
                                {
                                    <span class="thumb thumb-empty"></span>
                                }
                            }
                            else
                            {
                                <span class="@(cf?.Type.Editor == "number" ? "num" : "")">@Fmt.Value(cf, row.GetValueOrDefault(colKey))</span>
                            }
                        </ChildContent>
                    </BbDataGridTemplateColumn>
                }

                @if (HasStatus)
                {
                    <BbDataGridTemplateColumn TData="Dictionary<string, object?>" Title="Status" Sortable="true" SortBy="@(r => (object?)(r.GetValueOrDefault("workflow_state") ?? ""))">
                        <ChildContent Context="row">
                            @{
                                var st = row.GetValueOrDefault("workflow_state") as string;
                                var ds = row.TryGetValue("docstatus", out var dsv) && dsv is int dsi ? dsi : 0;
                            }
                            <StatusBadge Label="@Fmt.StateLabel(st, ds)" Tone="@Fmt.Tone(meta, st, ds)" />
                        </ChildContent>
                    </BbDataGridTemplateColumn>
                }

                <BbDataGridTemplateColumn TData="Dictionary<string, object?>" Title="Diubah" Sortable="true" SortBy="@(r => (object)r["modified"]!)">
                    <ChildContent Context="row">
                        <span class="muted nowrap">@Fmt.When((DateTimeOffset)row["modified"]!)</span>
                    </ChildContent>
                </BbDataGridTemplateColumn>
            </Columns>
        </BbDataGrid>

        @if (TotalPages > 1)
        {
            <div class="list-foot">
                <span class="muted small">Halaman @result.Page dari @TotalPages (@TotalText dokumen)</span>
                <BbPagination TotalPages="TotalPages" CurrentPage="result.Page" CurrentPageChanged="Reload" />
            </div>
        }
    }
}

@code {
    [Parameter] public string DocType { get; set; } = "";
    private const string DateFmt = "yyyy-MM-dd";

    private CompiledDocType? meta;
    private ListResponse? result;
    private string? search, sortField, error, fatal;
    private readonly Dictionary<string, FilterClause> filters = new();
    private readonly HashSet<Dictionary<string, object?>> selectedItems = [];
    private bool busy;

    private bool HasStatus => meta!.Workflow is not null || meta.Def.Document.AllowSubmit;
    private string TotalText => result is null ? "" : result.TotalCapped ? $"{result.Total:N0}+" : $"{result.Total:N0}";
    private int TotalPages => result is null ? 0 : (int)Math.Ceiling(result.Total / (double)result.PageSize);

    // Blazor memanggil OnParametersSet setiap kali layout induk dirender ulang (mis. jumlah notifikasi berubah).
    // Muat ulang hanya bila parameter rute benar-benar berubah, agar isian/draft pengguna tidak hilang.
    private string? loadedKey;
    protected override async Task OnParametersSetAsync()
    {
        if (DocType == loadedKey) return;
        loadedKey = DocType;
        fatal = null; error = null; filters.Clear(); search = null; sortField = null; result = null;
        selectedItems.Clear();
        if (!Metadata.Current.TryGet(DocType, out var m) || m.Def.IsChild) { fatal = $"DocType '{DocType}' tidak ditemukan."; return; }
        meta = m;
        if (!Perms.Can(Current.Required, meta, DocActions.Read)) { fatal = $"Anda tidak memiliki akses untuk melihat {meta.Title}."; return; }
        await Reload(1);
    }

    private void Go(string name) => Nav.NavigateTo($"/app/{DocType}/{name}");

    private string LabelOf(string field) => field switch
    {
        "name" => "Nomor",
        StandardFields.WorkflowState => "Status",
        StandardFields.Modified => "Diubah",
        _ => meta!.ByName.TryGetValue(field, out var f) ? f.Label : field
    };

    private IEnumerable<SelectOption<string>>? FilterOptions(string field)
    {
        IEnumerable<SelectOption<string>>? opts = null;
        if (field == StandardFields.WorkflowState && meta!.Workflow is not null)
            opts = meta.Workflow.Def.States.Select(s => new SelectOption<string>(s.Name, s.Name));
        else if (meta!.ByName.TryGetValue(field, out var f) && f.Type.Editor == "select")
            opts = (f.Def.Options ?? []).Select(o => new SelectOption<string>(o, o));
        else if (f is not null && f.Type.Editor == "check")
            opts = [new("true", "Ya"), new("false", "Tidak")];
        return opts?.Prepend(new SelectOption<string>("", "Semua")).ToList();
    }

    private Task OnSearch(string? v) { search = v; return Reload(1); }

    private Task SetFilter(string field, string? value)
    {
        if (string.IsNullOrEmpty(value)) filters.Remove(field);
        else
        {
            var op = meta!.ByName.TryGetValue(field, out var f) && f.Def.Type == "Date" ? ">=" : "=";
            filters[field] = new FilterClause(field, op, value);
        }
        return Reload(1);
    }

    private void OnSelectedItemsChanged(IReadOnlyCollection<Dictionary<string, object?>> items)
    {
        selectedItems.Clear();
        foreach (var item in items)
        {
            selectedItems.Add(item);
        }
    }

    private async Task DeleteSelected()
    {
        if (selectedItems.Count == 0 || busy) return;

        var count = selectedItems.Count;
        var confirm = await Dialogs.ConfirmAsync(
            $"Hapus {count} dokumen {meta!.Title.ToLower()}?",
            "Dokumen draft yang dipilih akan dihapus permanen. Tindakan ini tidak dapat dibatalkan.",
            new ConfirmDialogOptions { Destructive = true, ConfirmText = $"Hapus ({count})", CancelText = "Batal" });

        if (!confirm.Confirmed) return;

        busy = true;
        int success = 0;
        var failed = new List<string>();

        try
        {
            foreach (var item in selectedItems.ToList())
            {
                var name = (string)item["name"]!;
                try
                {
                    int version = item.TryGetValue("version", out var v) && v is int iv
                        ? iv
                        : (await Docs.GetAsync(Current.Required, DocType, name)).Version;

                    await Docs.DeleteAsync(Current.Required, DocType, name, version);
                    success++;
                }
                catch (Exception ex)
                {
                    failed.Add($"{name}: {ex.Message}");
                }
            }

            if (success > 0)
            {
                Toasts.Success($"{success} {meta!.Title.ToLower()} berhasil dihapus.", "Dihapus");
            }

            if (failed.Count > 0)
            {
                Toasts.Error(string.Join("; ", failed), "Gagal Menghapus Sebagian Dokumen");
            }
        }
        finally
        {
            busy = false;
            selectedItems.Clear();
            await Reload(result?.Page ?? 1);
        }
    }

    private async Task Reload(int page)
    {
        try
        {
            error = null;
            selectedItems.Clear();
            result = await Docs.ListAsync(Current.Required, DocType, new ListRequest(filters.Values.ToList(), search, sortField, null, page));
        }
        catch (Exception ex) when (ex is InvalidPayloadException or PermissionDeniedException)
        {
            error = ex.Message;
        }
    }
}

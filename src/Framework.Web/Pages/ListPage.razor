@page "/app/{DocType}"
@inject DocumentService Docs
@inject CurrentUser Current
@inject IMetadataProvider Metadata
@inject IPermissionService Perms
@inject NavigationManager Nav
@inject Framework.Imports.DataImportService Importer
@inject ReportDownloads Downloads
@inject Microsoft.JSInterop.IJSRuntime JS
@inject DialogService Dialogs
@inject ToastService Toasts
@inject Framework.Preferences.IUserPreferenceStore UserPrefs
@inject UiText T
@implements IDisposable

<PageTitle>@(meta is null ? DocType : T.Title(meta)) · FrogFrame</PageTitle>

@if (fatal is not null)
{
    <ErrorState StatusCode="@fatalStatus" Title="@(T[fatalStatus == 403 ? "Access Denied" : "DocType Not Found"])" Description="@fatal" />
}
else if (meta is not null)
{
    <header class="page-head list-header-custom">
        <div class="list-title-box">
            <div>
                <h1 class="list-page-title">@T.Title(meta)</h1>
                <p class="list-page-sub">@(result is null ? T["Loading…"] : T.Format("{0} documents within your access scope", TotalText))</p>
            </div>
        </div>
        @if (HasAnyHeaderAction)
        {
            <div class="row list-action-buttons" style="flex-wrap:wrap">
                @if (CanBulkEdit)
                {
                    <BbButton Variant="ButtonVariant.Outline"
                              Class="btn-action-bulk-edit"
                              Disabled="@(selectedItems.Count == 0 || busy)"
                              OnClick="OpenBulkEdit">
                        <LucideIcon Name="pencil" Size="16" /> @T["Bulk Edit"] @(selectedItems.Count > 0 ? $"({selectedItems.Count})" : "")
                    </BbButton>
                }
                @if (CanBulkSubmit)
                {
                    <BbButton Variant="ButtonVariant.Outline"
                              Class="btn-action-bulk-submit"
                              Disabled="@(selectedItems.Count == 0 || busy)"
                              OnClick="SubmitSelected">
                        <LucideIcon Name="check-circle" Size="16" /> @T["Submit"] @(selectedItems.Count > 0 ? $"({selectedItems.Count})" : "")
                    </BbButton>
                }
                @if (CanBulkCancel)
                {
                    <BbButton Variant="ButtonVariant.Outline"
                              Class="btn-action-bulk-cancel"
                              Disabled="@(selectedItems.Count == 0 || busy)"
                              OnClick="CancelSelected">
                        <LucideIcon Name="x-circle" Size="16" /> @T["Cancel"] @(selectedItems.Count > 0 ? $"({selectedItems.Count})" : "")
                    </BbButton>
                }
                @if (CanBulkDelete)
                {
                    <BbButton Variant="ButtonVariant.Destructive"
                              Class="btn-action-delete"
                              Disabled="@(selectedItems.Count == 0 || busy)"
                              OnClick="DeleteSelected">
                        <LucideIcon Name="trash-2" Size="16" /> @T["Delete"] @(selectedItems.Count > 0 ? $"({selectedItems.Count})" : "")
                    </BbButton>
                }
                @if (Importer.CanImport(Current.Required, meta.Name))
                {
                    <BbButton Variant="ButtonVariant.Outline" Class="btn-action-import" Href="@($"/app/{meta.Name}/import")">
                        <LucideIcon Name="file-up" Size="16" /> @T["Import"]
                    </BbButton>
                }
                @if (Perms.Can(Current.Required, meta, DocActions.Create))
                {
                    <BbButton Class="btn-action-new" Href="@($"/app/{meta.Name}/new")">
                        <LucideIcon Name="plus" Size="16" /> @T.Format("New {0}", T.Title(meta).ToLower())
                    </BbButton>
                }
            </div>
        }
    </header>

    @if (error is not null)
    {
        <BbAlert Variant="AlertVariant.Danger" Class="crumbs"><BbAlertDescription>@error</BbAlertDescription></BbAlert>
    }

    @if (result is null)
    {
        <div class="stack"><BbSkeleton Height="2.5rem" /><BbSkeleton Height="2.5rem" /><BbSkeleton Height="2.5rem" /></div>
    }
    else
    {
        var groupedFields = meta.Fields.Where(f => f.Def.Type != "Table" && f.Def.RowGrouping).ToList();
        var groupCollapsed = groupedFields.Any(f => f.Def.GroupCollapsedByDefault);
        var visibleColSet = result.Columns.ToHashSet(StringComparer.OrdinalIgnoreCase);
        <BbDataGrid @key="gridRenderKey"
                    TData="Dictionary<string, object?>"
                    Items="@result.Items"
                    ItemKey="@(r => (string)r["name"]!)"
                    OnRowClick="@(row => Go((string)row["name"]!))"
                    RowClass="@(row => selectedItems.Contains((string)row["name"]!) ? "clickable selected" : "clickable")"
                    State="@gridState"
                    Resizable="true"
                    OnColumnResize="HandleColumnResize"
                    StateChanged="OnGridStateChanged"
                    GroupsCollapsedByDefault="@groupCollapsed"
                    ShowPagination="true"
                    InitialPageSize="10"
                    PageSizes="@([10, 20, 50, 100])"
                    TableContainerClass="table-wrap">
            <Toolbar>
                <div class="filters" role="search" style="margin-bottom:.75rem;width:100%">
                    <div class="filter search">
                        <span>@T["Search"]</span>
                        <BbInput Value="@search" ValueChanged="OnSearch" UpdateTiming="UpdateTiming.Debounced" DebounceInterval="300"
                                 Placeholder="@($"{string.Join(" / ", meta.Def.ListView.SearchFields.Select(LabelOf))}…")" AriaLabel="@(T["Search"])" />
                    </div>
                    <div style="margin-left:auto;align-self:flex-end;display:flex;align-items:center;gap:.5rem;flex-wrap:wrap">
                        @if (CanExport)
                        {
                            <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" Disabled="@busy"
                                      OnClick="@(() => ExportList("xlsx"))"
                                      Title="@(T["Export list to Excel (.xlsx)"])">
                                <LucideIcon Name="file-spreadsheet" Size="14" />
                                <span>@T["Export Excel"]@(selectedItems.Count > 0 ? $" ({selectedItems.Count})" : "")</span>
                            </BbButton>
                            <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" Disabled="@busy"
                                      OnClick="@(() => ExportList("csv"))"
                                      Title="@(T["Export list to CSV (.csv)"])">
                                <LucideIcon Name="file-down" Size="14" />
                                <span>@T["Export CSV"]@(selectedItems.Count > 0 ? $" ({selectedItems.Count})" : "")</span>
                            </BbButton>
                        }
                        @if (hasCustomLayout)
                        {
                            <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" OnClick="ResetColumnsLayout" Title="@(T["Reset column layout to default"])">
                                <LucideIcon Name="rotate-ccw" Size="14" />
                                <span>@T["Reset Columns"]</span>
                            </BbButton>
                        }
                        <BbDataGridColumnVisibility TData="Dictionary<string, object?>" />
                    </div>
                </div>
            </Toolbar>
            <EmptyTemplate>
                <div style="padding:2.5rem 1rem">
                    <BbEmpty Title="@(T.Format("No matching {0} found", T.Title(meta).ToLower()))"
                             Description="@(T[!string.IsNullOrEmpty(search) ? "Modify or clear search to view other documents." : "Documents you create or that are shared with your role will appear here."])">
                        <Icon><LucideIcon Name="search" Size="28" /></Icon>
                    </BbEmpty>
                </div>
            </EmptyTemplate>
            <Columns>
                @foreach (var gf in groupedFields.Where(f => !visibleColSet.Contains(f.Name)))
                {
                    var gKey = gf.Name;
                    <BbDataGridPropertyColumn @key="@($"_grp_{gKey}")"
                                              TData="Dictionary<string, object?>" TProp="object?"
                                              Id="@gKey"
                                              Title="@(T.Label(gf))"
                                              Property="@GetColAccessor(gKey)"
                                              SortAndFilterBy="@GetColAccessor(gKey)"
                                              Groupable="true"
                                              Visible="false"
                                              Hideable="false"
                                              Resizable="false" />
                }

                <BbDataGridTemplateColumn TData="Dictionary<string, object?>" Id="_select" Title="" Width="@GetColWidth("_select", "3rem")" Hideable="false" Resizable="false">
                    <HeaderTemplate>
                        <div @onclick:stopPropagation="true">
                            <BbCheckbox Checked="@IsAllSelected"
                                        Indeterminate="@IsSomeSelected"
                                        CheckedChanged="ToggleSelectAll"
                                        AriaLabel="@(T["Select all"])" />
                        </div>
                    </HeaderTemplate>
                    <ChildContent Context="row">
                        @{
                            var rowName = (string)row["name"]!;
                            var isSelected = selectedItems.Contains(rowName);
                        }
                        <div @onclick:stopPropagation="true">
                            <BbCheckbox Checked="@isSelected"
                                        CheckedChanged="v => ToggleSelect(rowName, v)"
                                        AriaLabel="@(T.Format("Select {0}", rowName))" />
                        </div>
                    </ChildContent>
                </BbDataGridTemplateColumn>

                <BbDataGridPropertyColumn TData="Dictionary<string, object?>" TProp="object?"
                                          Id="name" Title="@(T["Number"])" Hideable="false" Resizable="true" Sortable="true"
                                          Property="@nameAccessor" SortAndFilterBy="@nameAccessor" Filterable="true" FilterType="BlazorBlueprint.Primitives.Filtering.FilterFieldType.Text"
                                          Width="@GetColWidth("name")">
                    <CellTemplate Context="row">
                        <a class="doc-link" href="/app/@meta.Name/@((string)row["name"]!)">@((string)row["name"]!)</a>
                    </CellTemplate>
                </BbDataGridPropertyColumn>

                @foreach (var c in result.Columns)
                {
                    var colKey = c;
                    var cf = meta.ByName.GetValueOrDefault(colKey);
                    var colFilterable = cf?.Def.Filterable ?? true;
                    var colPinned = MapPinning(cf?.Def.Pinned);
                    var colAccessor = GetColAccessor(colKey);
                    <BbDataGridPropertyColumn @key="colKey"
                                              TData="Dictionary<string, object?>" TProp="object?"
                                              Id="@colKey" Title="@LabelOf(colKey)" Resizable="true" Sortable="true"
                                              Property="@colAccessor" SortAndFilterBy="@colAccessor"
                                              Filterable="@colFilterable" FilterType="@MapFilterType(cf)"
                                              Pinned="@colPinned" Groupable="true"
                                              Width="@GetColWidth(colKey)"
                                              Visible="@IsColVisible(colKey)">
                        <CellTemplate Context="row">
                            @if (cf?.Type.Editor == "image")
                            {
                                @if (row.GetValueOrDefault(colKey) is string img)
                                {
                                    <img class="thumb" src="@($"/files/{img}")" alt="" loading="lazy" />
                                }
                                else
                                {
                                    <span class="thumb thumb-empty"></span>
                                }
                            }
                            else
                            {
                                <span class="@(cf?.Type.Editor == "number" ? "num" : "")">@T.Value(cf, row.GetValueOrDefault(colKey))</span>
                            }
                        </CellTemplate>
                    </BbDataGridPropertyColumn>
                }

                @if (HasStatus)
                {
                    <BbDataGridPropertyColumn TData="Dictionary<string, object?>" TProp="object?"
                                              Id="status" Title="@(T["Status"])" Resizable="true" Sortable="true"
                                              Property="@statusAccessor" SortAndFilterBy="@statusAccessor" Filterable="true"
                                              Width="@GetColWidth("status")"
                                              Visible="@IsColVisible("status")">
                        <CellTemplate Context="row">
                            @{
                                var st = row.GetValueOrDefault("workflow_state") as string;
                                var ds = row.TryGetValue("docstatus", out var dsv) && dsv is int dsi ? dsi : 0;
                            }
                            <StatusBadge Label="@(T.State(st, ds))" Tone="@Fmt.Tone(meta, st, ds)" />
                        </CellTemplate>
                    </BbDataGridPropertyColumn>
                }

                <BbDataGridPropertyColumn TData="Dictionary<string, object?>" TProp="object?"
                                          Id="modified" Title="@(T["Modified"])" Resizable="true" Sortable="true"
                                          Property="@modifiedAccessor" SortAndFilterBy="@modifiedAccessor" Filterable="true" FilterType="BlazorBlueprint.Primitives.Filtering.FilterFieldType.DateTime"
                                          Width="@GetColWidth("modified")"
                                          Visible="@IsColVisible("modified")">
                    <CellTemplate Context="row">
                        <span class="muted nowrap">@Fmt.When((DateTimeOffset)row["modified"]!)</span>
                    </CellTemplate>
                </BbDataGridPropertyColumn>
            </Columns>
        </BbDataGrid>

        @if (TotalPages > 1)
        {
            <div class="list-foot">
                <span class="muted small">@T.Format("Page {0} of {1} ({2} documents)", result.Page, TotalPages, TotalText)</span>
                <BbPagination TotalPages="TotalPages" CurrentPage="result.Page" CurrentPageChanged="Reload" />
            </div>
        }

        <AdminDrawer Open="@bulkEditOpen"
                     OpenChanged="v => bulkEditOpen = v"
                     Title="@(T.Format("Bulk Edit {0}", T.Title(meta)))"
                     Description="@(T.Format("Update a field across {0} selected document(s).", selectedItems.Count))">
            <ChildContent>
                <BbField>
                    <BbFieldLabel For="bulk-edit-field">@T["Field to update"]</BbFieldLabel>
                    <BbSelect TValue="string"
                              Value="@(selectedBulkField?.Name ?? "")"
                              ValueChanged="OnBulkFieldChanged"
                              Placeholder="@(T["Select field…"])"
                              AriaLabel="@(T["Field to update"])"
                              Options="@(bulkEditableFields.Select(f => new SelectOption<string>(f.Name, T.Label(f))))" />
                </BbField>

                @if (selectedBulkField is not null)
                {
                    <BbField>
                        <BbFieldLabel For="bulk-edit-val">@T.Label(selectedBulkField)</BbFieldLabel>
                        <FieldInput @key="selectedBulkField.Name"
                                    Id="bulk-edit-val"
                                    Field="@T.Field(selectedBulkField)"
                                    DocType="@meta.Name"
                                    Value="@bulkEditValue"
                                    ValueChanged="v => bulkEditValue = v" />
                    </BbField>
                }

                <p class="muted small" style="margin:0">
                    @T["Only draft documents within your write scope will be modified. All validation rules and hooks will run for each document."]
                </p>
            </ChildContent>
            <FooterContent>
                <BbButton Variant="ButtonVariant.Outline" Disabled="@busy" OnClick="() => bulkEditOpen = false">@T["Cancel"]</BbButton>
                <BbButton Disabled="@(busy || selectedBulkField is null || selectedItems.Count == 0)"
                          Loading="@busy"
                          LoadingText="@(T["Updating…"])"
                          OnClick="ExecuteBulkEdit">
                    <LucideIcon Name="check" Size="16" /> @T.Format("Apply to {0} document(s)", selectedItems.Count)
                </BbButton>
            </FooterContent>
        </AdminDrawer>
    }
}

@code {
    [Parameter] public string DocType { get; set; } = "";

    private CompiledDocType? meta;
    private ListResponse? result;
    private string? search, sortField, error, fatal; private int fatalStatus = 404;
    private readonly HashSet<string> selectedItems = [];
    private bool busy;

    private IReadOnlyList<CompiledField> bulkEditableFields = [];
    private bool bulkEditOpen;
    private CompiledField? selectedBulkField;
    private object? bulkEditValue;

    private bool CanExport => meta is not null && Perms.Can(Current.Required, meta, DocActions.Export);
    private bool CanBulkEdit => bulkEditableFields.Count > 0;
    private bool CanBulkSubmit => meta is not null && Docs.CanBulkSubmit(Current.Required, meta);
    private bool CanBulkCancel => meta is not null && Docs.CanBulkCancel(Current.Required, meta);
    private bool CanBulkDelete => meta is not null && meta.Def.Document.AllowDelete && Perms.Can(Current.Required, meta, DocActions.Delete);
    private bool HasAnyHeaderAction => meta is not null && (
        CanBulkEdit || CanBulkSubmit || CanBulkCancel || CanBulkDelete ||
        Importer.CanImport(Current.Required, meta.Name) ||
        Perms.Can(Current.Required, meta, DocActions.Create));

    private Framework.Preferences.DataGridPreference gridPref = new();
    private BlazorBlueprint.Primitives.DataGrid.DataGridState<Dictionary<string, object?>> gridState = new();
    private readonly Dictionary<string, System.Linq.Expressions.Expression<Func<Dictionary<string, object?>, object?>>> colAccessors = new(StringComparer.OrdinalIgnoreCase);
    private static readonly System.Linq.Expressions.Expression<Func<Dictionary<string, object?>, object?>> nameAccessor = r => r.GetValueOrDefault("name");
    private static readonly System.Linq.Expressions.Expression<Func<Dictionary<string, object?>, object?>> statusAccessor = r => r.GetValueOrDefault("workflow_state") ?? "";
    private static readonly System.Linq.Expressions.Expression<Func<Dictionary<string, object?>, object?>> modifiedAccessor = r => r.GetValueOrDefault("modified");
    private bool hasCustomLayout;
    private int gridRenderKey;
    private System.Threading.Timer? saveDebounceTimer;

    private System.Linq.Expressions.Expression<Func<Dictionary<string, object?>, object?>> GetColAccessor(string colKey)
    {
        if (!colAccessors.TryGetValue(colKey, out var expr))
        {
            var key = colKey;
            var cf = meta?.ByName.GetValueOrDefault(key);
            expr = r => GetColRawOrGroupValue(cf, r.GetValueOrDefault(key));
            colAccessors[key] = expr;
        }
        return expr;
    }

    private object? GetColRawOrGroupValue(CompiledField? cf, object? val)
    {
        if (val is null || (val is string s && string.IsNullOrWhiteSpace(s)))
            return cf?.Def.RowGrouping == true ? "—" : null;
        if (cf is not null && cf.Def.RowGrouping)
            return T.Value(cf, val);
        return val;
    }

    private static BlazorBlueprint.Primitives.Filtering.FilterFieldType MapFilterType(CompiledField? cf) => cf?.Type.Editor switch
    {
        "number" or "currency" or "percent" or "int" => BlazorBlueprint.Primitives.Filtering.FilterFieldType.Number,
        "date" => BlazorBlueprint.Primitives.Filtering.FilterFieldType.Date,
        "datetime" => BlazorBlueprint.Primitives.Filtering.FilterFieldType.DateTime,
        "check" => BlazorBlueprint.Primitives.Filtering.FilterFieldType.Boolean,
        _ => BlazorBlueprint.Primitives.Filtering.FilterFieldType.Text
    };

    private void ApplyDefaultGrouping()
    {
        gridState = new();
        if (meta is null) return;
        bool first = true;
        foreach (var gf in meta.Fields.Where(f => f.Def.Type != "Table" && f.Def.RowGrouping))
        {
            var def = new BlazorBlueprint.Primitives.DataGrid.GroupDefinition
            {
                ColumnId = gf.Name,
                GroupSortDirection = BlazorBlueprint.Primitives.SortDirection.Ascending
            };
            if (first)
            {
                gridState.Grouping.SetGroup(def);
                first = false;
            }
            else
            {
                gridState.Grouping.AddGroup(def);
            }
        }
    }

    private bool IsAllSelected => result?.Items.Count > 0 && result.Items.All(r => selectedItems.Contains((string)r["name"]!));
    private bool IsSomeSelected => !IsAllSelected && result?.Items.Any(r => selectedItems.Contains((string)r["name"]!)) == true;

    private void ToggleSelectAll(bool check)
    {
        if (result is null) return;
        if (check)
        {
            foreach (var r in result.Items)
                selectedItems.Add((string)r["name"]!);
        }
        else
        {
            foreach (var r in result.Items)
                selectedItems.Remove((string)r["name"]!);
        }
    }

    private void ToggleSelect(string name, bool check)
    {
        if (check) selectedItems.Add(name);
        else selectedItems.Remove(name);
    }

    private bool HasStatus => meta!.Workflow is not null || meta.Def.Document.AllowSubmit;
    private string TotalText => result is null ? "" : result.TotalCapped ? $"{result.Total:N0}+" : $"{result.Total:N0}";
    private int TotalPages => result is null ? 0 : (int)Math.Ceiling(result.Total / (double)result.PageSize);

    // Blazor memanggil OnParametersSet setiap kali layout induk dirender ulang (mis. jumlah notifikasi berubah).
    // Muat ulang hanya bila parameter rute benar-benar berubah, agar isian/draft pengguna tidak hilang.
    private string? loadedKey;
    protected override async Task OnParametersSetAsync()
    {
        if (DocType == loadedKey) return;
        loadedKey = DocType;
        fatal = null; error = null; search = null; sortField = null; result = null;
        selectedItems.Clear();
        if (!Metadata.Current.TryGet(DocType, out var m) || m.Def.IsChild) { fatalStatus = 404; fatal = T.Format("DocType '{0}' was not found.", DocType); return; }
        meta = m;
        colAccessors.Clear();
        ApplyDefaultGrouping();
        if (!Perms.Can(Current.Required, meta, DocActions.Read)) { fatalStatus = 403; fatal = T.Format("You do not have permission to view {0}.", T.Title(meta)); return; }
        // Single DocType: tidak ada daftar; langsung buka dokumen tunggalnya.
        if (meta.Def.IsSingle)
        {
            Nav.NavigateTo($"/app/{DocType}/{DocType}", replace: true);
            return;
        }

        bulkEditableFields = Docs.BulkEditableFields(Current.Required, meta);
        bulkEditOpen = false;
        selectedBulkField = bulkEditableFields.FirstOrDefault();
        bulkEditValue = selectedBulkField?.StaticDefault;

        if (Current.User is { } u)
        {
            var saved = await UserPrefs.GetAsync<Framework.Preferences.DataGridPreference>(u.TenantId, u.Id, $"grid:{DocType}");
            if (saved is not null && saved.Columns.Count > 0)
            {
                gridPref = saved;
                hasCustomLayout = true;
            }
            else
            {
                gridPref = new();
                hasCustomLayout = false;
            }
        }

        await Reload(1);
    }

    private void Go(string name) => Nav.NavigateTo($"/app/{DocType}/{name}");

    private string LabelOf(string field) => field switch
    {
        "name" => T["Number"],
        StandardFields.WorkflowState => T["Status"],
        StandardFields.Modified => T["Modified"],
        _ => meta!.ByName.TryGetValue(field, out var f) ? T.Label(f) : field
    };

    private Task OnSearch(string? v) { search = v; return Reload(1); }

    private async Task ExportList(string format)
    {
        if (meta is null || busy) return;
        busy = true;
        try
        {
            var visibleCols = result?.Columns.Where(IsColVisible).ToList();
            var selected = selectedItems.Count > 0 ? selectedItems.ToList() : null;
            var output = await Docs.ExportListAsync(
                Current.Required,
                DocType,
                format,
                new ListRequest(null, search, sortField, null),
                selected,
                visibleCols);
            var token = Downloads.Put(Current.Required.TenantId, Current.Required.Id, output);
            await JS.InvokeVoidAsync("frogframe.downloadUrl", $"/report-downloads/{token}", output.FileName);
            Toasts.Success(
                T.Format("Exported {0} {1} document(s) to {2}.", output.Rows, T.Title(meta).ToLower(), output.FileName),
                T["Export Complete"]);
        }
        catch (Exception ex) when (ex is InvalidPayloadException or PermissionDeniedException or DocumentNotFoundException)
        {
            Toasts.Error(T.Message(ex.Message), T["Export Failed"]);
        }
        finally
        {
            busy = false;
        }
    }

    private void OpenBulkEdit()
    {
        if (selectedItems.Count == 0 || busy || bulkEditableFields.Count == 0) return;
        selectedBulkField ??= bulkEditableFields[0];
        bulkEditValue = selectedBulkField.StaticDefault;
        bulkEditOpen = true;
    }

    private void OnBulkFieldChanged(string? fieldName)
    {
        selectedBulkField = bulkEditableFields.FirstOrDefault(f => f.Name == fieldName);
        bulkEditValue = selectedBulkField?.StaticDefault;
    }

    private async Task ExecuteBulkEdit()
    {
        if (selectedItems.Count == 0 || selectedBulkField is null || busy || meta is null) return;
        busy = true;
        try
        {
            var res = await Docs.BulkEditAsync(Current.Required, DocType, selectedItems.ToList(), selectedBulkField.Name, bulkEditValue);
            bulkEditOpen = false;
            await HandleBulkOutcome(
                res,
                T.Format("{0} {1} document(s) updated successfully.", res.Succeeded.Count, T.Title(meta).ToLower()),
                T["Bulk Edit Complete"],
                T["Failed to Update Some Documents"]);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task SubmitSelected()
    {
        if (selectedItems.Count == 0 || busy || meta is null) return;
        var count = selectedItems.Count;
        var confirm = await Dialogs.ConfirmAsync(
            T.Format("Submit {0} {1} document(s)?", count, T.Title(meta).ToLower()),
            T["Selected draft documents will be validated and submitted."],
            new ConfirmDialogOptions { ConfirmText = $"{T["Submit"]} ({count})", CancelText = T["Cancel"] });
        if (!confirm.Confirmed) return;

        busy = true;
        try
        {
            var res = await Docs.BulkSubmitAsync(Current.Required, DocType, selectedItems.ToList());
            await HandleBulkOutcome(
                res,
                T.Format("{0} {1} document(s) submitted successfully.", res.Succeeded.Count, T.Title(meta).ToLower()),
                T["Submitted"],
                T["Failed to Submit Some Documents"]);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task CancelSelected()
    {
        if (selectedItems.Count == 0 || busy || meta is null) return;
        var count = selectedItems.Count;
        var requireComment = meta.Workflow?.Transitions.Any(t =>
            t.Def.RequireComment &&
            (string.Equals(t.Def.Action, "Cancel", StringComparison.OrdinalIgnoreCase) ||
             string.Equals(t.Def.Action, "Withdraw", StringComparison.OrdinalIgnoreCase) ||
             string.Equals(t.Def.To, "Cancelled", StringComparison.OrdinalIgnoreCase))) == true;

        var prompt = await Dialogs.PromptAsync(
            T.Format("Cancel {0} {1} document(s)?", count, T.Title(meta).ToLower()),
            T["Provide a reason for cancellation. This note will be recorded in the audit history for each document."],
            new PromptDialogOptions { Placeholder = T["Reason…"], ConfirmText = $"{T["Cancel"]} ({count})", CancelText = T["Back"], MaxLength = 1000 });
        if (prompt.Cancelled) return;
        if (requireComment && string.IsNullOrWhiteSpace(prompt.Value))
        {
            Toasts.Error(T["Cancellation requires a reason. Nothing was changed."], T["Empty comment"]);
            return;
        }

        busy = true;
        try
        {
            var comment = string.IsNullOrWhiteSpace(prompt.Value) ? null : prompt.Value.Trim();
            var res = await Docs.BulkCancelAsync(Current.Required, DocType, selectedItems.ToList(), comment);
            await HandleBulkOutcome(
                res,
                T.Format("{0} {1} document(s) cancelled successfully.", res.Succeeded.Count, T.Title(meta).ToLower()),
                T["Cancelled"],
                T["Failed to Cancel Some Documents"]);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task DeleteSelected()
    {
        if (selectedItems.Count == 0 || busy || meta is null) return;

        var count = selectedItems.Count;
        var confirm = await Dialogs.ConfirmAsync(
            T.Format("Delete {0} {1} document(s)?", count, T.Title(meta).ToLower()),
            T["Selected draft documents will be permanently deleted. This action cannot be undone."],
            new ConfirmDialogOptions { Destructive = true, ConfirmText = $"{T["Delete"]} ({count})", CancelText = T["Cancel"] });

        if (!confirm.Confirmed) return;

        busy = true;
        try
        {
            var res = await Docs.BulkDeleteAsync(Current.Required, DocType, selectedItems.ToList());
            await HandleBulkOutcome(
                res,
                T.Format("{0} {1} document(s) deleted successfully.", res.Succeeded.Count, T.Title(meta).ToLower()),
                T["Deleted"],
                T["Failed to Delete Some Documents"]);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task HandleBulkOutcome(BulkActionResult res, string successMsg, string successTitle, string errorTitle)
    {
        if (res.Succeeded.Count > 0)
            Toasts.Success(successMsg, successTitle);

        if (res.Failed.Count > 0)
        {
            var details = string.Join("; ", res.Failed.Select(f => $"{f.Name}: {T.Message(f.Error)}"));
            Toasts.Error(details, errorTitle);
        }

        var keepSelected = res.Failed.Select(f => f.Name).ToHashSet(StringComparer.Ordinal);
        await Reload(result?.Page ?? 1);
        foreach (var failedName in keepSelected)
            selectedItems.Add(failedName);
    }

    private async Task Reload(int page)
    {
        try
        {
            error = null;
            selectedItems.Clear();
            result = await Docs.ListAsync(Current.Required, DocType, new ListRequest(null, search, sortField, null, page));
        }
        catch (Exception ex) when (ex is InvalidPayloadException or PermissionDeniedException)
        {
            error = T.Message(ex.Message);
        }
    }

    private static BlazorBlueprint.Primitives.DataGrid.ColumnPinning MapPinning(string? pinned) => pinned switch
    {
        "Left" => BlazorBlueprint.Primitives.DataGrid.ColumnPinning.Left,
        "Right" => BlazorBlueprint.Primitives.DataGrid.ColumnPinning.Right,
        _ => BlazorBlueprint.Primitives.DataGrid.ColumnPinning.None
    };

    private bool GetDefaultColVisible(string colId) =>
        meta?.ByName.TryGetValue(colId, out var cf) == true ? cf.Def.Visible : true;

    private string? GetColWidth(string colId, string? defaultWidth = null) =>
        gridPref.Columns.TryGetValue(colId, out var pref) && !string.IsNullOrWhiteSpace(pref.Width)
            ? pref.Width
            : defaultWidth;

    private bool IsColVisible(string colId) =>
        gridPref.Columns.TryGetValue(colId, out var pref) ? pref.Visible : GetDefaultColVisible(colId);

    private void HandleColumnResize((string ColumnId, string Width) args)
    {
        if (string.IsNullOrWhiteSpace(args.ColumnId)) return;
        if (!gridPref.Columns.TryGetValue(args.ColumnId, out var pref))
        {
            pref = new Framework.Preferences.GridColumnPreference { Visible = GetDefaultColVisible(args.ColumnId) };
        }
        gridPref.Columns[args.ColumnId] = pref with { Width = args.Width };
        hasCustomLayout = true;
        ScheduleSavePreference();
    }

    private void OnGridStateChanged(BlazorBlueprint.Primitives.DataGrid.DataGridState<Dictionary<string, object?>> state)
    {
        if (state?.Columns?.Entries is null) return;
        bool changed = false;
        foreach (var entry in state.Columns.Entries)
        {
            if (string.IsNullOrEmpty(entry.ColumnId)) continue;
            var defaultVisible = GetDefaultColVisible(entry.ColumnId);
            if (!gridPref.Columns.TryGetValue(entry.ColumnId, out var pref))
            {
                if (entry.Visible != defaultVisible || !string.IsNullOrWhiteSpace(entry.Width))
                {
                    gridPref.Columns[entry.ColumnId] = new Framework.Preferences.GridColumnPreference
                    {
                        Visible = entry.Visible,
                        Width = entry.Width
                    };
                    changed = true;
                }
            }
            else
            {
                var widthToSave = !string.IsNullOrWhiteSpace(entry.Width) ? entry.Width : pref.Width;
                if (pref.Visible != entry.Visible || pref.Width != widthToSave)
                {
                    gridPref.Columns[entry.ColumnId] = pref with { Visible = entry.Visible, Width = widthToSave };
                    changed = true;
                }
            }
        }

        if (changed)
        {
            hasCustomLayout = true;
            ScheduleSavePreference();
        }
    }

    private void ScheduleSavePreference()
    {
        saveDebounceTimer?.Dispose();
        saveDebounceTimer = new System.Threading.Timer(async _ =>
        {
            await SavePreferenceAsync();
        }, null, 500, System.Threading.Timeout.Infinite);
    }

    private async Task SavePreferenceAsync()
    {
        try
        {
            if (Current.User is { } u && !string.IsNullOrEmpty(DocType))
            {
                await UserPrefs.SetAsync(u.TenantId, u.Id, $"grid:{DocType}", gridPref);
            }
        }
        catch
        {
            // Background save error shouldn't crash the UI
        }
    }

    private async Task ResetColumnsLayout()
    {
        if (Current.User is { } u && !string.IsNullOrEmpty(DocType))
        {
            await UserPrefs.DeleteAsync(u.TenantId, u.Id, $"grid:{DocType}");
        }
        gridPref = new();
        hasCustomLayout = false;
        ApplyDefaultGrouping();
        gridRenderKey++;
        Toasts.Success(T["Column layout has been reset to default."], T["Reset Columns"]);
        await Reload(result?.Page ?? 1);
    }

    public void Dispose()
    {
        saveDebounceTimer?.Dispose();
    }
}

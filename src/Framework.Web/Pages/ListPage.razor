@page "/app/{DocType}"
@using System.Globalization
@using Framework.Preferences
@using Framework.Persistence
@using Framework.Expressions
@inject DocumentService Docs
@inject CurrentUser Current
@inject IMetadataProvider Metadata
@inject IPermissionService Perms
@inject NavigationManager Nav
@inject Framework.Imports.DataImportService Importer
@inject ReportDownloads Downloads
@inject Microsoft.JSInterop.IJSRuntime JS
@inject DialogService Dialogs
@inject ToastService Toasts
@inject Framework.Preferences.IUserPreferenceStore UserPrefs
@inject UiText T
@implements IDisposable

<PageTitle>@(meta is null ? DocType : T.Title(meta)) · FrogFrame</PageTitle>

@if (fatal is not null)
{
    <ErrorState StatusCode="@fatalStatus" Title="@(T[fatalStatus == 403 ? "Access Denied" : "DocType Not Found"])" Description="@fatal" />
}
else if (meta is not null)
{
    <header class="page-head list-header-custom">
        <div class="list-title-box">
            <div>
                <h1 class="list-page-title">@T.Title(meta)</h1>
                <p class="list-page-sub">@(result is null ? T["Loading…"] : T.Format("{0} documents within your access scope", TotalText))</p>
            </div>
        </div>
        @if (HasAnyHeaderAction)
        {
            <div class="row list-action-buttons" style="flex-wrap:wrap">
                @if (CanBulkEdit)
                {
                    <BbButton Variant="ButtonVariant.Outline"
                              Class="btn-action-bulk-edit"
                              Disabled="@(selectedItems.Count == 0 || busy)"
                              OnClick="OpenBulkEdit">
                        <LucideIcon Name="pencil" Size="16" /> @T["Bulk Edit"] @(selectedItems.Count > 0 ? $"({selectedItems.Count})" : "")
                    </BbButton>
                }
                @if (CanBulkSubmit)
                {
                    <BbButton Variant="ButtonVariant.Outline"
                              Class="btn-action-bulk-submit"
                              Disabled="@(selectedItems.Count == 0 || busy)"
                              OnClick="SubmitSelected">
                        <LucideIcon Name="circle-check" Size="16" /> @T["Submit"] @(selectedItems.Count > 0 ? $"({selectedItems.Count})" : "")
                    </BbButton>
                }
                @if (CanBulkCancel)
                {
                    <BbButton Variant="ButtonVariant.Outline"
                              Class="btn-action-bulk-cancel"
                              Disabled="@(selectedItems.Count == 0 || busy)"
                              OnClick="CancelSelected">
                        <LucideIcon Name="circle-x" Size="16" /> @T["Cancel"] @(selectedItems.Count > 0 ? $"({selectedItems.Count})" : "")
                    </BbButton>
                }
                @if (CanBulkDelete)
                {
                    <BbButton Variant="ButtonVariant.Destructive"
                              Class="btn-action-delete"
                              Disabled="@(selectedItems.Count == 0 || busy)"
                              OnClick="DeleteSelected">
                        <LucideIcon Name="trash-2" Size="16" /> @T["Delete"] @(selectedItems.Count > 0 ? $"({selectedItems.Count})" : "")
                    </BbButton>
                }
                @if (Importer.CanImport(Current.Required, meta.Name))
                {
                    <BbButton Variant="ButtonVariant.Outline" Class="btn-action-import" Href="@($"/app/{meta.Name}/import")">
                        <LucideIcon Name="file-up" Size="16" /> @T["Import"]
                    </BbButton>
                }
                @if (Perms.Can(Current.Required, meta, DocActions.Create))
                {
                    <BbButton Class="btn-action-new" Href="@($"/app/{meta.Name}/new")">
                        <LucideIcon Name="plus" Size="16" /> @T.Format("New {0}", T.Title(meta).ToLower())
                    </BbButton>
                }
            </div>
        }
    </header>

    @if (error is not null)
    {
        <BbAlert Variant="AlertVariant.Danger" Class="crumbs"><BbAlertDescription>@error</BbAlertDescription></BbAlert>
    }

    @if (result is null)
    {
        <div class="stack"><BbSkeleton Height="2.5rem" /><BbSkeleton Height="2.5rem" /><BbSkeleton Height="2.5rem" /></div>
    }
    else
    {
        var groupedFields = meta.Fields.Where(f => f.Def.Type != "Table" && f.Def.RowGrouping).ToList();
        var groupCollapsed = groupedFields.Any(f => f.Def.GroupCollapsedByDefault);
        var visibleColSet = result.Columns.ToHashSet(StringComparer.OrdinalIgnoreCase);
        // Search, filters and saved views, shared by the grid and the board. inGrid = rendered inside the grid
        // (column visibility and layout reset only exist there).
        RenderFragment<bool> listToolbar = inGrid => @<div class="list-toolbar">
                <div class="filters" role="search" style="margin-bottom:.75rem;width:100%">
                    <div class="filter view-select" style="min-width:11rem;max-width:16rem">
                        <span>@T["View / Filter"]</span>
                        <BbSelect TValue="string"
                                  Value="@selectedViewId"
                                  ValueChanged="OnSelectViewChanged"
                                  Options="ViewSelectOptions"
                                  AriaLabel="@(T["View / Filter"])" />
                    </div>
                    <div class="filter search">
                        <span>@T["Search"]</span>
                        <BbInput Value="@search" ValueChanged="OnSearch" UpdateTiming="UpdateTiming.Debounced" DebounceInterval="300"
                                 Placeholder="@($"{string.Join(" / ", meta.Def.ListView.SearchFields.Select(LabelOf))}…")" AriaLabel="@(T["Search"])" />
                    </div>
                    <div class="filter-action-btn" style="align-self:flex-end">
                        <BbButton Variant="@(activeFilters.Count > 0 ? ButtonVariant.Default : ButtonVariant.Outline)"
                                  Size="ButtonSize.Small"
                                  Class="btn-filter-trigger"
                                  OnClick="OpenFilterDrawer"
                                  Title="@(T["Filter documents by field values"])">
                            <LucideIcon Name="filter" Size="14" />
                            <span>@T["Filter"]</span>
                            @if (activeFilters.Count > 0)
                            {
                                <span class="filter-badge">@activeFilters.Count</span>
                            }
                        </BbButton>
                    </div>
                    @if (activeFilters.Count > 0 || !string.IsNullOrWhiteSpace(search))
                    {
                        <div class="filter-action-btn" style="align-self:flex-end">
                            <BbButton Variant="ButtonVariant.Outline"
                                      Size="ButtonSize.Small"
                                      OnClick="OpenSaveViewDrawer"
                                      Title="@(T["Save current filter combination as a custom view"])">
                                <LucideIcon Name="bookmark-plus" Size="14" />
                                <span>@T["Save View"]</span>
                            </BbButton>
                        </div>
                    }
                    <div style="margin-left:auto;align-self:flex-end;display:flex;align-items:center;gap:.5rem;flex-wrap:wrap">
                        @if (CanExport)
                        {
                            <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" Disabled="@busy"
                                      OnClick="@(() => ExportList("xlsx"))"
                                      Title="@(T["Export list to Excel (.xlsx)"])">
                                <LucideIcon Name="file-spreadsheet" Size="14" />
                                <span>@T["Export Excel"]@(selectedItems.Count > 0 ? $" ({selectedItems.Count})" : "")</span>
                            </BbButton>
                            <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" Disabled="@busy"
                                      OnClick="@(() => ExportList("csv"))"
                                      Title="@(T["Export list to CSV (.csv)"])">
                                <LucideIcon Name="file-down" Size="14" />
                                <span>@T["Export CSV"]@(selectedItems.Count > 0 ? $" ({selectedItems.Count})" : "")</span>
                            </BbButton>
                        }
                        @if (inGrid && hasCustomLayout)
                        {
                            <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" OnClick="ResetColumnsLayout" Title="@(T["Reset column layout to default"])">
                                <LucideIcon Name="rotate-ccw" Size="14" />
                                <span>@T["Reset Columns"]</span>
                            </BbButton>
                        }
                        @if (inGrid)
                        {
                            <BbDataGridColumnVisibility TData="Dictionary<string, object?>" />
                        }
                        @if (CanBoard || CanCalendar || CanTree)
                        {
                            <div class="view-toggle" role="group" aria-label="@(T["Layout"])">
                                <BbButton Variant="@(CurrentLayout == "list" ? ButtonVariant.Secondary : ButtonVariant.Ghost)" Size="ButtonSize.Small"
                                          OnClick="@(() => SetLayout("list"))" Title="@(T["List view"])" aria-pressed="@(CurrentLayout == "list")">
                                    <LucideIcon Name="list" Size="14" /><span>@T["List"]</span>
                                </BbButton>
                                @if (CanBoard)
                                {
                                    <BbButton Variant="@(CurrentLayout == "board" ? ButtonVariant.Secondary : ButtonVariant.Ghost)" Size="ButtonSize.Small"
                                              OnClick="@(() => SetLayout("board"))" Title="@(T["Board view by status"])" aria-pressed="@(CurrentLayout == "board")">
                                        <LucideIcon Name="kanban" Size="14" /><span>@T["Board"]</span>
                                    </BbButton>
                                }
                                @if (CanTree)
                                {
                                    <BbButton Variant="@(CurrentLayout == "tree" ? ButtonVariant.Secondary : ButtonVariant.Ghost)" Size="ButtonSize.Small"
                                              OnClick="@(() => SetLayout("tree"))" Title="@(T["Tree view by parent"])" aria-pressed="@(CurrentLayout == "tree")">
                                        <LucideIcon Name="list-tree" Size="14" /><span>@T["Tree"]</span>
                                    </BbButton>
                                }
                                @if (CanCalendar)
                                {
                                    <BbButton Variant="@(CurrentLayout == "calendar" ? ButtonVariant.Secondary : ButtonVariant.Ghost)" Size="ButtonSize.Small"
                                              OnClick="@(() => SetLayout("calendar"))" Title="@(T["Calendar view by date"])" aria-pressed="@(CurrentLayout == "calendar")">
                                        <LucideIcon Name="calendar-days" Size="14" /><span>@T["Calendar"]</span>
                                    </BbButton>
                                }
                            </div>
                        }
                    </div>
                </div>

                @if (activeFilters.Count > 0 || !string.IsNullOrWhiteSpace(search) || SelectedView is not null)
                {
                    <div class="active-filter-strip">
                        @if (SelectedView is not null)
                        {
                            <span class="active-view-chip" title="@(T["Active custom view"])">
                                <LucideIcon Name="bookmark" Size="13" />
                                <span>@SelectedView.Name</span>
                            </span>
                        }
                        @if (!string.IsNullOrWhiteSpace(search))
                        {
                            <span class="filter-chip">
                                <span class="chip-label">@T["Search"]:</span>
                                <span class="chip-val">"@search"</span>
                                <button type="button" class="chip-close" @onclick="ClearSearch" title="@(T["Clear search"])">✕</button>
                            </span>
                        }
                        @foreach (var f in activeFilters)
                        {
                            var fieldLabel = LabelOf(f.Field);
                            var opDisplay = FormatOperator(f.Op);
                            var valDisplay = FormatFilterValue(f);
                            <span class="filter-chip">
                                <span class="chip-label">@fieldLabel</span>
                                <span class="chip-op">@opDisplay</span>
                                <span class="chip-val">@valDisplay</span>
                                <button type="button" class="chip-close" @onclick="() => RemoveFilter(f)" title="@(T["Remove filter condition"])">✕</button>
                            </span>
                        }
                        <button type="button" class="btn-clear-all-chips" @onclick="ClearAllFilters">
                            <LucideIcon Name="x" Size="12" />
                            <span>@T["Clear All"]</span>
                        </button>
                    </div>
                }
        </div>;
        if (CurrentLayout == "board")
        {
            @listToolbar(false)
            <KanbanBoard Meta="meta" Items="result.Items" OnChanged="Reload" />
        }
        else if (CurrentLayout == "tree")
        {
            @listToolbar(false)
            <TreeBoard Meta="meta" Items="result.Items" Capped="@(result.TotalCapped || result.Total > result.Items.Count)" />
        }
        else if (CurrentLayout == "calendar")
        {
            @listToolbar(false)
            <CalendarBoard Meta="meta" Items="result.Items" Capped="@(result.TotalCapped || result.Total > result.Items.Count)" />
        }
        else
        {
        <BbDataGrid @key="gridRenderKey"
                    TData="Dictionary<string, object?>"
                    Items="@result.Items"
                    ItemKey="@(r => (string)r["name"]!)"
                    OnRowClick="@(row => Go((string)row["name"]!))"
                    RowClass="@(row => selectedItems.Contains((string)row["name"]!) ? "clickable selected" : "clickable")"
                    State="@gridState"
                    Resizable="true"
                    Reorderable="true"
                    OnColumnResize="HandleColumnResize"
                    StateChanged="OnGridStateChanged"
                    GroupsCollapsedByDefault="@groupCollapsed"
                    ShowPagination="true"
                    InitialPageSize="10"
                    PageSizes="@([10, 20, 50, 100])"
                    TableContainerClass="table-wrap">
            <Toolbar>@listToolbar(true)</Toolbar>
            <EmptyTemplate>
                <div style="padding:2.5rem 1rem">
                    <BbEmpty Title="@(T.Format("No matching {0} found", T.Title(meta).ToLower()))"
                             Description="@(T[!string.IsNullOrEmpty(search) ? "Modify or clear search to view other documents." : "Documents you create or that are shared with your role will appear here."])">
                        <Icon><LucideIcon Name="search" Size="28" /></Icon>
                    </BbEmpty>
                </div>
            </EmptyTemplate>
            <Columns>
                @foreach (var gf in groupedFields.Where(f => !visibleColSet.Contains(f.Name)))
                {
                    var gKey = gf.Name;
                    <BbDataGridPropertyColumn @key="@($"_grp_{gKey}")"
                                              TData="Dictionary<string, object?>" TProp="object?"
                                              Id="@gKey"
                                              Title="@(T.Label(gf))"
                                              Property="@GetColAccessor(gKey)"
                                              SortAndFilterBy="@GetColAccessor(gKey)"
                                              Groupable="true"
                                              Visible="false"
                                              Hideable="false"
                                              Resizable="false" />
                }

                <BbDataGridTemplateColumn TData="Dictionary<string, object?>" Id="_select" Order="0" Title="" Width="@GetColWidth("_select", "3rem")" Hideable="false" Resizable="false" Reorderable="false" Sortable="false">
                    <HeaderTemplate>
                        <div @onclick:stopPropagation="true">
                            <BbCheckbox Checked="@IsAllSelected"
                                        Indeterminate="@IsSomeSelected"
                                        CheckedChanged="ToggleSelectAll"
                                        AriaLabel="@(T["Select all"])" />
                        </div>
                    </HeaderTemplate>
                    <ChildContent Context="row">
                        @{
                            var rowName = (string)row["name"]!;
                            var isSelected = selectedItems.Contains(rowName);
                        }
                        <div @onclick:stopPropagation="true">
                            <BbCheckbox Checked="@isSelected"
                                        CheckedChanged="v => ToggleSelect(rowName, v)"
                                        AriaLabel="@(T.Format("Select {0}", rowName))" />
                        </div>
                    </ChildContent>
                </BbDataGridTemplateColumn>

                <BbDataGridPropertyColumn TData="Dictionary<string, object?>" TProp="object?"
                                          Id="name" Title="@(T["Number"])" Hideable="false" Resizable="true" Sortable="true"
                                          Property="@nameAccessor" SortAndFilterBy="@nameAccessor" Filterable="true" FilterType="BlazorBlueprint.Primitives.Filtering.FilterFieldType.Text"
                                          Width="@GetColWidth("name")"
                                          Order="@GetColOrder("name")">
                    <CellTemplate Context="row">
                        <a class="doc-link" href="/app/@meta.Name/@((string)row["name"]!)">@((string)row["name"]!)</a>
                        @if (row.GetValueOrDefault(Framework.Social.DocTags.ListKey) is IReadOnlyList<string> { Count: > 0 } rowTags)
                        {
                            <span class="list-tags">
                                @foreach (var rt in rowTags) { <span class="list-tag tag-color" style="--tag-hue:@Framework.Social.DocTags.Hue(rt)">@rt</span> }
                            </span>
                        }
                    </CellTemplate>
                </BbDataGridPropertyColumn>

                @foreach (var c in result.Columns)
                {
                    if (string.Equals(c, "name", StringComparison.OrdinalIgnoreCase) ||
                        (HasStatus && string.Equals(c, "status", StringComparison.OrdinalIgnoreCase)) ||
                        string.Equals(c, "modified", StringComparison.OrdinalIgnoreCase))
                    {
                        continue;
                    }
                    var colKey = c;
                    var cf = meta.ByName.GetValueOrDefault(colKey);
                    var colFilterable = cf?.Def.Filterable ?? true;
                    var colPinned = MapPinning(cf?.Def.Pinned);
                    var colAccessor = GetColAccessor(colKey);
                    <BbDataGridPropertyColumn @key="colKey"
                                              TData="Dictionary<string, object?>" TProp="object?"
                                              Id="@colKey" Title="@LabelOf(colKey)" Resizable="true" Sortable="true"
                                              Property="@colAccessor" SortAndFilterBy="@colAccessor"
                                              Filterable="@colFilterable" FilterType="@MapFilterType(cf)"
                                              Pinned="@colPinned" Groupable="true"
                                              Width="@GetColWidth(colKey)"
                                              Visible="@IsColVisible(colKey)"
                                              Order="@GetColOrder(colKey)">
                        <CellTemplate Context="row">
                            @if (cf?.Type.Editor == "image")
                            {
                                @if (row.GetValueOrDefault(colKey) is string img)
                                {
                                    <img class="thumb" src="@($"/files/{img}")" alt="" loading="lazy" />
                                }
                                else
                                {
                                    <span class="thumb thumb-empty"></span>
                                }
                            }
                            else
                            {
                                <span class="@(cf?.Type.Editor == "number" ? "num" : "")">@T.Value(cf, row.GetValueOrDefault(colKey))</span>
                            }
                        </CellTemplate>
                    </BbDataGridPropertyColumn>
                }

                @if (HasStatus)
                {
                    <BbDataGridPropertyColumn TData="Dictionary<string, object?>" TProp="object?"
                                              Id="status" Title="@(T["Status"])" Resizable="true" Sortable="true"
                                              Property="@statusAccessor" SortAndFilterBy="@statusAccessor" Filterable="true"
                                              Width="@GetColWidth("status")"
                                              Visible="@IsColVisible("status")"
                                              Order="@GetColOrder("status")">
                        <CellTemplate Context="row">
                            @{
                                var st = row.GetValueOrDefault("workflow_state") as string;
                                var ds = row.TryGetValue("docstatus", out var dsv) && dsv is int dsi ? dsi : 0;
                            }
                            <StatusBadge Label="@(T.State(st, ds))" Tone="@Fmt.Tone(meta, st, ds)" />
                        </CellTemplate>
                    </BbDataGridPropertyColumn>
                }

                <BbDataGridPropertyColumn TData="Dictionary<string, object?>" TProp="object?"
                                          Id="modified" Title="@(T["Modified"])" Resizable="true" Sortable="true"
                                          Property="@modifiedAccessor" SortAndFilterBy="@modifiedAccessor" Filterable="true" FilterType="BlazorBlueprint.Primitives.Filtering.FilterFieldType.DateTime"
                                          Width="@GetColWidth("modified")"
                                          Visible="@IsColVisible("modified")"
                                          Order="@GetColOrder("modified")">
                    <CellTemplate Context="row">
                        <span class="muted nowrap">@Fmt.When((DateTimeOffset)row["modified"]!)</span>
                    </CellTemplate>
                </BbDataGridPropertyColumn>
            </Columns>
        </BbDataGrid>
        }

        <AdminDrawer Open="@bulkEditOpen"
                     OpenChanged="v => bulkEditOpen = v"
                     Title="@(T.Format("Bulk Edit {0}", T.Title(meta)))"
                     Description="@(T.Format("Update a field across {0} selected document(s).", selectedItems.Count))">
            <ChildContent>
                <BbField>
                    <BbFieldLabel For="bulk-edit-field">@T["Field to update"]</BbFieldLabel>
                    <BbSelect TValue="string"
                              Value="@(selectedBulkField?.Name ?? "")"
                              ValueChanged="OnBulkFieldChanged"
                              Placeholder="@(T["Select field…"])"
                              AriaLabel="@(T["Field to update"])"
                              Options="@(bulkEditableFields.Select(f => new SelectOption<string>(f.Name, T.Label(f))))" />
                </BbField>

                @if (selectedBulkField is not null)
                {
                    <BbField>
                        <BbFieldLabel For="bulk-edit-val">@T.Label(selectedBulkField)</BbFieldLabel>
                        <FieldInput @key="selectedBulkField.Name"
                                    Id="bulk-edit-val"
                                    Field="@T.Field(selectedBulkField)"
                                    DocType="@meta.Name"
                                    Value="@bulkEditValue"
                                    ValueChanged="v => bulkEditValue = v" />
                    </BbField>
                }

                <p class="muted small" style="margin:0">
                    @T["Only draft documents within your write scope will be modified. All validation rules and hooks will run for each document."]
                </p>
            </ChildContent>
            <FooterContent>
                <BbButton Variant="ButtonVariant.Outline" Disabled="@busy" OnClick="() => bulkEditOpen = false">@T["Cancel"]</BbButton>
                <BbButton Disabled="@(busy || selectedBulkField is null || selectedItems.Count == 0)"
                          Loading="@busy"
                          LoadingText="@(T["Updating…"])"
                          OnClick="ExecuteBulkEdit">
                    <LucideIcon Name="check" Size="16" /> @T.Format("Apply to {0} document(s)", selectedItems.Count)
                </BbButton>
            </FooterContent>
        </AdminDrawer>

        <AdminDrawer Open="@filterDrawerOpen"
                     OpenChanged="v => filterDrawerOpen = v"
                     Title="@(T.Format("Filters & Views · {0}", T.Title(meta)))"
                     Description="@T["Filter documents by one or more field conditions or save presets."]"
                     WidthScale="1.4">
            <ChildContent>
                <div class="filter-builder-list">
                    @for (int i = 0; i < draftFilters.Count; i++)
                    {
                        var idx = i;
                        var row = draftFilters[idx];
                        var cf = meta.ByName.GetValueOrDefault(row.Field);
                        <div class="filter-row-item">
                            <div>
                                <BbSelect TValue="string"
                                          Value="@row.Field"
                                          ValueChanged="v => OnFilterFieldChanged(idx, v)"
                                          Options="FilterableFieldOptions"
                                          AriaLabel="@(T["Field"])" />
                            </div>
                            <div>
                                <BbSelect TValue="string"
                                          Value="@row.Op"
                                          ValueChanged="@(v => row.Op = v ?? "=")"
                                          Options="@GetOperatorOptions(row.Field)"
                                          AriaLabel="@(T["Operator"])" />
                            </div>
                            <div class="filter-row-input-group">
                                @if (cf?.Type.Editor == "check")
                                {
                                    <BbSelect TValue="string"
                                              Value="@row.RawValue"
                                              ValueChanged='@(v => row.RawValue = v ?? "false")'
                                              Options="@([new SelectOption<string>("true", T["Yes"]), new SelectOption<string>("false", T["No"])])"
                                              AriaLabel="@T.Label(cf)" />
                                }
                                else if (row.Field == StandardFields.DocStatus)
                                {
                                    <BbSelect TValue="string"
                                              Value="@row.RawValue"
                                              ValueChanged='@(v => row.RawValue = v ?? "0")'
                                              Options="@([new SelectOption<string>("0", T["Draft"]), new SelectOption<string>("1", T["Submitted"]), new SelectOption<string>("2", T["Cancelled"])])"
                                              AriaLabel="@T["Document Status"]" />
                                }
                                else if (row.Field == StandardFields.WorkflowState && meta.Workflow is not null)
                                {
                                    <BbSelect TValue="string"
                                              Value="@row.RawValue"
                                              ValueChanged='@(v => row.RawValue = v ?? "")'
                                              Placeholder="@T["Select state…"]"
                                              Options="@(meta.Workflow.States.Keys.Select(s => new SelectOption<string>(s, T[s])))"
                                              AriaLabel="@T["Status"]" />
                                }
                                else if (cf?.Type.Editor == "select" && cf.Def.Options is { Count: > 0 } opts)
                                {
                                    <BbSelect TValue="string"
                                              Value="@row.RawValue"
                                              ValueChanged='@(v => row.RawValue = v ?? "")'
                                              Placeholder="@T["Select option…"]"
                                              Options="@(opts.Select(o => new SelectOption<string>(o, T[o])))"
                                              AriaLabel="@T.Label(cf)" />
                                }
                                else
                                {
                                    <BbInput Value="@row.RawValue" ValueChanged='@(v => row.RawValue = v ?? "")' Placeholder="@T["Value…"]" AriaLabel="@(cf is not null ? T.Label(cf) : LabelOf(row.Field))" />
                                }
                            </div>
                            <div>
                                <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" OnClick="() => RemoveDraftFilter(idx)" Title="@(T["Remove filter condition"])">
                                    <LucideIcon Name="trash-2" Size="14" />
                                </BbButton>
                            </div>
                        </div>
                    }
                </div>

                <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="AddDraftFilter">
                    <LucideIcon Name="plus" Size="14" />
                    <span>@T["Add Condition"]</span>
                </BbButton>

                <div class="save-view-section">
                    <h4 class="save-view-title">@T["Save as Named Custom View"]</h4>
                    <BbInput Value="@draftViewName" ValueChanged='@(v => draftViewName = v ?? "")' Placeholder="@(T["e.g. Pending POs This Month, Unpaid Invoices…"])" AriaLabel="@(T["View name…"])" />
                    <div style="display:flex;align-items:center;gap:.5rem">
                        <BbCheckbox Checked="@draftViewIsDefault" CheckedChanged="v => draftViewIsDefault = v" AriaLabel="@(T["Set as default view for this DocType"])" />
                        <span class="small" style="cursor:pointer" @onclick="() => draftViewIsDefault = !draftViewIsDefault">@T["Set as default view for this DocType"]</span>
                    </div>
                </div>
            </ChildContent>
            <FooterContent>
                <BbButton Variant="ButtonVariant.Outline" OnClick="ResetDraftFilters">@T["Clear All"]</BbButton>
                @if (!string.IsNullOrWhiteSpace(draftViewName))
                {
                    <BbButton Variant="ButtonVariant.Outline" OnClick="SaveDraftAsView">
                        <LucideIcon Name="bookmark-plus" Size="15" />
                        <span>@T["Save View"]</span>
                    </BbButton>
                }
                <BbButton OnClick="ApplyDraftFilters">
                    <LucideIcon Name="check" Size="15" />
                    <span>@T["Apply Filters"]</span>
                </BbButton>
            </FooterContent>
        </AdminDrawer>

        <AdminDrawer Open="@manageViewsOpen"
                     OpenChanged="v => manageViewsOpen = v"
                     Title="@(T.Format("Manage Saved Views · {0}", T.Title(meta)))"
                     Description="@T["View, rename, set default, or delete saved filter combinations for this DocType."]"
                     WidthScale="1.4">
            <ChildContent>
                @if (savedViewsPref.Views.Count == 0)
                {
                    <div style="padding:2rem 0">
                        <BbEmpty Title="@T["No Saved Views"]"
                                 Description="@T["You have not saved any custom views for this DocType yet."]">
                            <Icon><LucideIcon Name="bookmark" Size="28" /></Icon>
                        </BbEmpty>
                    </div>
                }
                else
                {
                    <div class="manage-views-list">
                        @foreach (var v in savedViewsPref.Views)
                        {
                            var isCurrent = v.Id == selectedViewId;
                            <div class="manage-view-card @(isCurrent ? "selected" : "")">
                                <div class="manage-view-info">
                                    <div class="manage-view-title-row">
                                        <span class="manage-view-name">@v.Name</span>
                                        @if (v.IsDefault)
                                        {
                                            <span class="badge-default-view">★ @T["Default"]</span>
                                        }
                                    </div>
                                    <div class="manage-view-summary">
                                        @if (v.Filters.Count > 0)
                                        {
                                            <span>@string.Join(", ", v.Filters.Select(f => $"{LabelOf(f.Field)} {FormatOperator(f.Op)} {FormatFilterValue(f.ToFilterClause())}"))</span>
                                        }
                                        else if (!string.IsNullOrWhiteSpace(v.Search))
                                        {
                                            <span>@T["Search"]: "@v.Search"</span>
                                        }
                                        else
                                        {
                                            <span class="muted">@T["No filter criteria"]</span>
                                        }
                                    </div>
                                </div>
                                <div class="manage-view-actions">
                                    <BbButton Variant="ButtonVariant.Ghost"
                                              Size="ButtonSize.Small"
                                              OnClick="@(() => ToggleDefaultView(v.Id))"
                                              Title="@(v.IsDefault ? T["Remove Default"] : T["Set as Default"])">
                                        <LucideIcon Name="@(v.IsDefault ? "star-off" : "star")" Size="14" />
                                    </BbButton>
                                    <BbButton Variant="ButtonVariant.Ghost"
                                              Size="ButtonSize.Small"
                                              OnClick="@(() => RenameSavedView(v.Id))"
                                              Title="@(T["Rename view"])">
                                        <LucideIcon Name="pencil" Size="14" />
                                    </BbButton>
                                    <BbButton Variant="ButtonVariant.Ghost"
                                              Size="ButtonSize.Small"
                                              OnClick="@(() => DeleteSavedView(v.Id))"
                                              Title="@(T["Delete view"])">
                                        <LucideIcon Name="trash-2" Size="14" />
                                    </BbButton>
                                </div>
                            </div>
                        }
                    </div>
                }
            </ChildContent>
            <FooterContent>
                <BbButton Variant="ButtonVariant.Outline" OnClick="() => manageViewsOpen = false">@T["Cancel"]</BbButton>
            </FooterContent>
        </AdminDrawer>
    }
}

@code {
    [Parameter] public string DocType { get; set; } = "";
    /// <summary>
    /// "board" shows the Kanban board (DocTypes with a workflow or submit), "calendar" the calendar (DocTypes with a
    /// Date/Datetime field), "tree" the tree (DocTypes with a parent Link to themselves); anything else the grid.
    /// </summary>
    [SupplyParameterFromQuery(Name = "view")] public string? View { get; set; }
    /// <summary>"?tag=urgent" (links from a document's tags) filters the list to documents with that tag.</summary>
    [SupplyParameterFromQuery(Name = "tag")] public string? Tag { get; set; }

    private bool CanBoard => meta is not null && WorkflowBoard.Supports(meta);
    private bool CanCalendar => meta is not null && CalendarView.Supports(meta);
    private bool CanTree => meta is not null && TreeView.Supports(meta);
    private string CurrentLayout => View?.ToLowerInvariant() switch
    {
        "board" when CanBoard => "board",
        "calendar" when CanCalendar => "calendar",
        "tree" when CanTree => "tree",
        _ => "list",
    };

    private void SetLayout(string layout)
    {
        if (layout == CurrentLayout) return;
        selectedItems.Clear();
        Nav.NavigateTo(Nav.GetUriWithQueryParameter("view", layout == "list" ? null : layout), replace: true);
    }

    private CompiledDocType? meta;
    private ListResponse? result;
    private string? search, sortField, error, fatal; private int fatalStatus = 404;
    private readonly HashSet<string> selectedItems = [];
    private bool busy;

    // Saved Views & Custom Filters
    private DocTypeCustomViewsPreference savedViewsPref = new();
    private string selectedViewId = "";
    private readonly List<FilterClause> activeFilters = [];
    private bool filterDrawerOpen;
    private bool manageViewsOpen;
    private readonly List<DraftFilterRow> draftFilters = [];
    private string draftViewName = "";
    private bool draftViewIsDefault;

    private SavedCustomView? SelectedView =>
        string.IsNullOrEmpty(selectedViewId) ? null : savedViewsPref.Views.FirstOrDefault(v => v.Id == selectedViewId);

    private sealed class DraftFilterRow
    {
        public string Field { get; set; } = StandardFields.Name;
        public string Op { get; set; } = "=";
        public string RawValue { get; set; } = "";
    }

    private IReadOnlyList<CompiledField> bulkEditableFields = [];
    private bool bulkEditOpen;
    private CompiledField? selectedBulkField;
    private object? bulkEditValue;

    private bool CanExport => meta is not null && Perms.Can(Current.Required, meta, DocActions.Export);
    private bool CanBulkEdit => bulkEditableFields.Count > 0;
    private bool CanBulkSubmit => meta is not null && Docs.CanBulkSubmit(Current.Required, meta);
    private bool CanBulkCancel => meta is not null && Docs.CanBulkCancel(Current.Required, meta);
    private bool CanBulkDelete => meta is not null && meta.Def.Document.AllowDelete && Perms.Can(Current.Required, meta, DocActions.Delete);
    private bool HasAnyHeaderAction => meta is not null && (
        CanBulkEdit || CanBulkSubmit || CanBulkCancel || CanBulkDelete ||
        Importer.CanImport(Current.Required, meta.Name) ||
        Perms.Can(Current.Required, meta, DocActions.Create));

    private Framework.Preferences.DataGridPreference gridPref = new();
    private BlazorBlueprint.Primitives.DataGrid.DataGridState<Dictionary<string, object?>> gridState = new();
    private readonly Dictionary<string, System.Linq.Expressions.Expression<Func<Dictionary<string, object?>, object?>>> colAccessors = new(StringComparer.OrdinalIgnoreCase);
    private static readonly System.Linq.Expressions.Expression<Func<Dictionary<string, object?>, object?>> nameAccessor = r => r.GetValueOrDefault("name");
    private static readonly System.Linq.Expressions.Expression<Func<Dictionary<string, object?>, object?>> statusAccessor = r => r.GetValueOrDefault("workflow_state") ?? "";
    private static readonly System.Linq.Expressions.Expression<Func<Dictionary<string, object?>, object?>> modifiedAccessor = r => r.GetValueOrDefault("modified");
    private bool hasCustomLayout;
    private int gridRenderKey;
    private System.Threading.Timer? saveDebounceTimer;

    private IReadOnlyList<SelectOption<string>> ViewSelectOptions
    {
        get
        {
            var list = new List<SelectOption<string>>
            {
                new("", T["All Documents"])
            };
            foreach (var v in savedViewsPref.Views)
            {
                var label = v.IsDefault ? $"★ {v.Name} ({T["Default"]})" : v.Name;
                list.Add(new(v.Id, label));
            }
            list.Add(new("__manage__", $"⚙ {T["Manage Saved Views…"]}"));
            return list;
        }
    }

    private IReadOnlyList<SelectOption<string>> FilterableFieldOptions
    {
        get
        {
            if (meta is null) return [];
            var list = new List<SelectOption<string>>
            {
                new(StandardFields.Name, T["Number"])
            };
            if (HasStatus)
            {
                list.Add(new(StandardFields.WorkflowState, T["Status"]));
                list.Add(new(StandardFields.DocStatus, T["Document Status"]));
            }
            list.Add(new(StandardFields.Owner, T["Owner / Created By"]));
            list.Add(new(StandardFields.Modified, T["Last Modified"]));

            foreach (var f in meta.Fields.Where(f => f.Def.Type != "Table" && meta.IsQueryable(f.Name) && !f.IsLayout && f.Def.Type != "Password" && Perms.CanReadField(Current.Required, meta, f)))
            {
                if (list.Any(x => x.Value.Equals(f.Name, StringComparison.OrdinalIgnoreCase))) continue;
                list.Add(new(f.Name, T.Label(f)));
            }
            return list;
        }
    }

    private IReadOnlyList<SelectOption<string>> GetOperatorOptions(string field)
    {
        var cf = meta?.ByName.GetValueOrDefault(field);
        if (cf?.Type.Editor == "check")
        {
            return [new("=", "=")];
        }
        if (cf?.Type.Editor is "number" or "currency" or "percent" or "int" || field is StandardFields.Modified or "created")
        {
            return
            [
                new("=", "="),
                new("!=", "≠"),
                new(">", ">"),
                new(">=", "≥"),
                new("<", "<"),
                new("<=", "≤")
            ];
        }
        if (cf?.Type.Editor is "date" or "datetime")
        {
            return
            [
                new("=", "="),
                new("!=", "≠"),
                new(">", ">"),
                new(">=", "≥"),
                new("<", "<"),
                new("<=", "≤")
            ];
        }
        if (cf?.Type.Editor is "select" || field is StandardFields.WorkflowState or StandardFields.DocStatus)
        {
            return
            [
                new("=", "="),
                new("!=", "≠")
            ];
        }
        return
        [
            new("like", T["contains"]),
            new("startswith", T["starts with"]),
            new("=", "="),
            new("!=", "≠")
        ];
    }

    private string FormatOperator(string op) => op switch
    {
        "=" => "=",
        "!=" => "≠",
        ">" => ">",
        ">=" => "≥",
        "<" => "<",
        "<=" => "≤",
        "like" => T["contains"],
        "startswith" => T["starts with"],
        "in" => T["in"],
        _ => op
    };

    private string FormatFilterValue(FilterClause f)
    {
        if (f.Value is null) return "—";
        if (f.Field == StandardFields.DocStatus)
        {
            return Values.ToDecimal(f.Value) switch
            {
                0 => T["Draft"],
                1 => T["Submitted"],
                2 => T["Cancelled"],
                _ => f.Value.ToString() ?? ""
            };
        }
        if (meta?.ByName.TryGetValue(f.Field, out var cf) == true)
        {
            if (cf.Type.Editor == "check")
                return (f.Value is true || (f.Value is string s && (s == "1" || string.Equals(s, "true", StringComparison.OrdinalIgnoreCase)))) ? T["Yes"] : T["No"];
            return T.Value(cf, f.Value) ?? f.Value.ToString() ?? "";
        }
        return f.Value.ToString() ?? "";
    }

    private System.Linq.Expressions.Expression<Func<Dictionary<string, object?>, object?>> GetColAccessor(string colKey)
    {
        if (!colAccessors.TryGetValue(colKey, out var expr))
        {
            var key = colKey;
            var cf = meta?.ByName.GetValueOrDefault(key);
            expr = r => GetColRawOrGroupValue(cf, r.GetValueOrDefault(key));
            colAccessors[key] = expr;
        }
        return expr;
    }

    private object? GetColRawOrGroupValue(CompiledField? cf, object? val)
    {
        if (val is null || (val is string s && string.IsNullOrWhiteSpace(s)))
            return cf?.Def.RowGrouping == true ? "—" : null;
        if (cf is not null && cf.Def.RowGrouping)
            return T.Value(cf, val);
        return val;
    }

    private static BlazorBlueprint.Primitives.Filtering.FilterFieldType MapFilterType(CompiledField? cf) => cf?.Type.Editor switch
    {
        "number" or "currency" or "percent" or "int" => BlazorBlueprint.Primitives.Filtering.FilterFieldType.Number,
        "date" => BlazorBlueprint.Primitives.Filtering.FilterFieldType.Date,
        "datetime" => BlazorBlueprint.Primitives.Filtering.FilterFieldType.DateTime,
        "check" => BlazorBlueprint.Primitives.Filtering.FilterFieldType.Boolean,
        _ => BlazorBlueprint.Primitives.Filtering.FilterFieldType.Text
    };

    private void ApplyDefaultGrouping()
    {
        gridState = new();
        if (meta is null) return;
        bool first = true;
        foreach (var gf in meta.Fields.Where(f => f.Def.Type != "Table" && f.Def.RowGrouping))
        {
            var def = new BlazorBlueprint.Primitives.DataGrid.GroupDefinition
            {
                ColumnId = gf.Name,
                GroupSortDirection = BlazorBlueprint.Primitives.SortDirection.Ascending
            };
            if (first)
            {
                gridState.Grouping.SetGroup(def);
                first = false;
            }
            else
            {
                gridState.Grouping.AddGroup(def);
            }
        }
    }

    private bool IsAllSelected => result?.Items.Count > 0 && result.Items.All(r => selectedItems.Contains((string)r["name"]!));
    private bool IsSomeSelected => !IsAllSelected && result?.Items.Any(r => selectedItems.Contains((string)r["name"]!)) == true;

    private void ToggleSelectAll(bool check)
    {
        if (result is null) return;
        if (check)
        {
            foreach (var r in result.Items)
                selectedItems.Add((string)r["name"]!);
        }
        else
        {
            foreach (var r in result.Items)
                selectedItems.Remove((string)r["name"]!);
        }
    }

    private void ToggleSelect(string name, bool check)
    {
        if (check) selectedItems.Add(name);
        else selectedItems.Remove(name);
    }

    private bool HasStatus => meta!.Workflow is not null || meta.Def.Document.AllowSubmit;
    private string TotalText => result is null ? "" : result.TotalCapped ? $"{result.Total:N0}+" : $"{result.Total:N0}";

    // Blazor memanggil OnParametersSet setiap kali layout induk dirender ulang (mis. jumlah notifikasi berubah).
    // Muat ulang hanya bila parameter rute benar-benar berubah, agar isian/draft pengguna tidak hilang.
    private string? loadedKey;
    protected override async Task OnParametersSetAsync()
    {
        if ($"{DocType}|{Tag}" == loadedKey) return;
        loadedKey = $"{DocType}|{Tag}";
        fatal = null; error = null; search = null; sortField = null; result = null;
        selectedItems.Clear();
        if (!Metadata.Current.TryGet(DocType, out var m) || m.Def.IsChild) { fatalStatus = 404; fatal = T.Format("DocType '{0}' was not found.", DocType); return; }
        meta = m;
        colAccessors.Clear();
        ApplyDefaultGrouping();
        if (!Perms.Can(Current.Required, meta, DocActions.Read)) { fatalStatus = 403; fatal = T.Format("You do not have permission to view {0}.", T.Title(meta)); return; }
        // Single DocType: tidak ada daftar; langsung buka dokumen tunggalnya.
        if (meta.Def.IsSingle)
        {
            Nav.NavigateTo($"/app/{DocType}/{DocType}", replace: true);
            return;
        }

        bulkEditableFields = Docs.BulkEditableFields(Current.Required, meta);
        bulkEditOpen = false;
        selectedBulkField = bulkEditableFields.FirstOrDefault();
        bulkEditValue = selectedBulkField?.StaticDefault;

        savedViewsPref = new();
        selectedViewId = "";
        activeFilters.Clear();

        if (Current.User is { } u)
        {
            var saved = await UserPrefs.GetAsync<Framework.Preferences.DataGridPreference>(u.TenantId, u.Id, $"grid:{DocType}");
            if (saved is not null && saved.Columns.Count > 0)
            {
                gridPref = saved;
                hasCustomLayout = true;
            }
            else
            {
                gridPref = new();
                hasCustomLayout = false;
            }

            savedViewsPref = await UserPrefs.GetCustomViewsAsync(u.TenantId, u.Id, DocType);
            if (!string.IsNullOrEmpty(savedViewsPref.DefaultViewId) &&
                savedViewsPref.Views.FirstOrDefault(v => v.Id == savedViewsPref.DefaultViewId) is { } defView)
            {
                selectedViewId = defView.Id;
                search = defView.Search;
                sortField = defView.SortField;
                activeFilters.AddRange(defView.Filters.Select(f => f.ToFilterClause()));
            }
        }
        if (!string.IsNullOrWhiteSpace(Tag))
        {
            activeFilters.RemoveAll(f => f.Field == Framework.Social.DocTags.FilterField);
            activeFilters.Add(new FilterClause(Framework.Social.DocTags.FilterField, "=", Tag.Trim()));
        }

        await Reload();
    }

    private void Go(string name) => Nav.NavigateTo($"/app/{DocType}/{name}");

    private string LabelOf(string field) => field switch
    {
        "name" => T["Number"],
        StandardFields.WorkflowState => T["Status"],
        StandardFields.DocStatus => T["Document Status"],
        StandardFields.Owner => T["Owner / Created By"],
        StandardFields.Modified => T["Last Modified"],
        Framework.Social.DocTags.FilterField => T["Tag"],
        _ => meta!.ByName.TryGetValue(field, out var f) ? T.Label(f) : field
    };

    private Task OnSearch(string? v)
    {
        search = v;
        gridState.Pagination.Reset();
        return Reload();
    }

    private async Task ExportList(string format)
    {
        if (meta is null || busy) return;
        busy = true;
        try
        {
            var visibleCols = result?.Columns.Where(IsColVisible).ToList();
            var selected = selectedItems.Count > 0 ? selectedItems.ToList() : null;
            var clauses = activeFilters.Count > 0 ? activeFilters : null;
            var output = await Docs.ExportListAsync(
                Current.Required,
                DocType,
                format,
                new ListRequest(clauses, search, sortField, null),
                selected,
                visibleCols);
            var token = Downloads.Put(Current.Required.TenantId, Current.Required.Id, output);
            await JS.InvokeVoidAsync("frogframe.downloadUrl", $"/report-downloads/{token}", output.FileName);
            Toasts.Success(
                T.Format("Exported {0} {1} document(s) to {2}.", output.Rows, T.Title(meta).ToLower(), output.FileName),
                T["Export Complete"]);
        }
        catch (Exception ex) when (ex is InvalidPayloadException or PermissionDeniedException or DocumentNotFoundException)
        {
            Toasts.Error(T.Message(ex.Message), T["Export Failed"]);
        }
        finally
        {
            busy = false;
        }
    }

    private void OpenFilterDrawer()
    {
        draftFilters.Clear();
        foreach (var f in activeFilters)
        {
            var raw = f.Value switch
            {
                null => "",
                bool b => b ? "true" : "false",
                _ => Convert.ToString(f.Value, CultureInfo.InvariantCulture) ?? ""
            };
            draftFilters.Add(new DraftFilterRow { Field = f.Field, Op = f.Op, RawValue = raw });
        }
        if (draftFilters.Count == 0)
        {
            draftFilters.Add(new DraftFilterRow
            {
                Field = HasStatus ? StandardFields.WorkflowState : StandardFields.Name,
                Op = HasStatus ? "=" : "like",
                RawValue = ""
            });
        }
        draftViewName = SelectedView?.Name ?? "";
        draftViewIsDefault = SelectedView?.IsDefault ?? false;
        filterDrawerOpen = true;
    }

    private void OpenSaveViewDrawer()
    {
        OpenFilterDrawer();
    }

    private void OnFilterFieldChanged(int index, string? newField)
    {
        if (index < 0 || index >= draftFilters.Count || string.IsNullOrEmpty(newField)) return;
        var row = draftFilters[index];
        row.Field = newField;
        var validOps = GetOperatorOptions(newField);
        if (!validOps.Any(o => o.Value == row.Op))
        {
            row.Op = validOps.FirstOrDefault()?.Value ?? "=";
        }
        row.RawValue = "";
    }

    private void AddDraftFilter()
    {
        draftFilters.Add(new DraftFilterRow
        {
            Field = HasStatus ? StandardFields.WorkflowState : StandardFields.Name,
            Op = HasStatus ? "=" : "like",
            RawValue = ""
        });
    }

    private void RemoveDraftFilter(int index)
    {
        if (index >= 0 && index < draftFilters.Count)
        {
            draftFilters.RemoveAt(index);
        }
    }

    private void ResetDraftFilters()
    {
        draftFilters.Clear();
        draftViewName = "";
        draftViewIsDefault = false;
    }

    private FilterClause? ConvertToFilterClause(DraftFilterRow row)
    {
        if (string.IsNullOrWhiteSpace(row.Field) || string.IsNullOrWhiteSpace(row.RawValue)) return null;

        object? val;
        if (row.Field == StandardFields.DocStatus)
        {
            val = decimal.TryParse(row.RawValue, out var ds) ? ds : 0m;
        }
        else if (meta?.ByName.TryGetValue(row.Field, out var cf) == true)
        {
            if (cf.Type.Editor == "check")
            {
                val = string.Equals(row.RawValue, "true", StringComparison.OrdinalIgnoreCase) || row.RawValue == "1";
            }
            else if (cf.Type.Editor is "number" or "currency" or "percent" or "int")
            {
                if (decimal.TryParse(row.RawValue, NumberStyles.Any, CultureInfo.InvariantCulture, out var nv))
                    val = nv;
                else if (decimal.TryParse(row.RawValue, out var nv2))
                    val = nv2;
                else
                    val = row.RawValue;
            }
            else
            {
                val = string.IsNullOrWhiteSpace(row.RawValue) ? null : row.RawValue.Trim();
            }
        }
        else
        {
            val = string.IsNullOrWhiteSpace(row.RawValue) ? null : row.RawValue.Trim();
        }

        if (val is null && row.Op is not ("=" or "!=")) return null;
        return new FilterClause(row.Field, row.Op, val);
    }

    private async Task ApplyDraftFilters()
    {
        var clauses = draftFilters
            .Select(ConvertToFilterClause)
            .Where(f => f is not null)
            .Select(f => f!)
            .ToList();

        activeFilters.Clear();
        activeFilters.AddRange(clauses);
        if (SelectedView is not null && !IsMatchingView(SelectedView, activeFilters, search))
        {
            selectedViewId = "";
        }
        filterDrawerOpen = false;
        gridState.Pagination.Reset();
        await Reload();
    }

    private async Task SaveDraftAsView()
    {
        if (string.IsNullOrWhiteSpace(draftViewName) || Current.User is not { } u) return;

        var clauses = draftFilters
            .Select(ConvertToFilterClause)
            .Where(f => f is not null)
            .Select(f => f!)
            .ToList();

        var view = new SavedCustomView
        {
            Id = SelectedView is not null && string.Equals(SelectedView.Name, draftViewName.Trim(), StringComparison.OrdinalIgnoreCase)
                ? SelectedView.Id
                : Guid.NewGuid().ToString("N"),
            Name = draftViewName.Trim(),
            Search = search,
            Filters = clauses.Select(f => new SavedFilterClause { Field = f.Field, Op = f.Op, Value = f.Value }).ToList(),
            SortField = sortField,
            IsDefault = draftViewIsDefault
        };

        await UserPrefs.SaveCustomViewAsync(u.TenantId, u.Id, DocType, view);
        savedViewsPref = await UserPrefs.GetCustomViewsAsync(u.TenantId, u.Id, DocType);
        selectedViewId = view.Id;
        activeFilters.Clear();
        activeFilters.AddRange(clauses);
        filterDrawerOpen = false;

        Toasts.Success(T.Format("Saved view '{0}'.", view.Name), T["View Saved"]);
        gridState.Pagination.Reset();
        await Reload();
    }

    private static bool IsMatchingView(SavedCustomView v, List<FilterClause> filters, string? searchStr)
    {
        if (!string.Equals(v.Search ?? "", searchStr ?? "", StringComparison.Ordinal)) return false;
        if (v.Filters.Count != filters.Count) return false;
        for (int i = 0; i < v.Filters.Count; i++)
        {
            var vf = v.Filters[i];
            var f = filters[i];
            if (!string.Equals(vf.Field, f.Field, StringComparison.OrdinalIgnoreCase) ||
                !string.Equals(vf.Op, f.Op, StringComparison.OrdinalIgnoreCase) ||
                !Equals(CustomViewExtensions.UnwrapValue(vf.Value), CustomViewExtensions.UnwrapValue(f.Value)))
                return false;
        }
        return true;
    }

    private async Task OnSelectViewChanged(string? viewId)
    {
        if (viewId == "__manage__")
        {
            manageViewsOpen = true;
            return;
        }

        if (string.IsNullOrEmpty(viewId))
        {
            selectedViewId = "";
            activeFilters.Clear();
            search = null;
            gridState.Pagination.Reset();
            await Reload();
            return;
        }

        var found = savedViewsPref.Views.FirstOrDefault(v => v.Id == viewId);
        if (found is not null)
        {
            selectedViewId = found.Id;
            search = found.Search;
            sortField = found.SortField;
            activeFilters.Clear();
            activeFilters.AddRange(found.Filters.Select(f => f.ToFilterClause()));
            gridState.Pagination.Reset();
            await Reload();
        }
    }

    private async Task ClearAllFilters()
    {
        activeFilters.Clear();
        search = null;
        selectedViewId = "";
        gridState.Pagination.Reset();
        await Reload();
    }

    private async Task RemoveFilter(FilterClause f)
    {
        activeFilters.Remove(f);
        selectedViewId = "";
        gridState.Pagination.Reset();
        await Reload();
    }

    private async Task ClearSearch()
    {
        search = null;
        gridState.Pagination.Reset();
        await Reload();
    }

    private async Task ToggleDefaultView(string viewId)
    {
        if (Current.User is not { } u) return;
        var target = savedViewsPref.Views.FirstOrDefault(v => v.Id == viewId);
        if (target is null) return;

        var newDefault = target.IsDefault ? null : viewId;
        await UserPrefs.SetDefaultCustomViewAsync(u.TenantId, u.Id, DocType, newDefault);
        savedViewsPref = await UserPrefs.GetCustomViewsAsync(u.TenantId, u.Id, DocType);
        Toasts.Success(
            newDefault is not null ? T.Format("View '{0}' set as default.", target.Name) : T["Default view cleared."],
            T["Default Updated"]);
    }

    private async Task RenameSavedView(string viewId)
    {
        if (Current.User is not { } u) return;
        var target = savedViewsPref.Views.FirstOrDefault(v => v.Id == viewId);
        if (target is null) return;

        var prompt = await Dialogs.PromptAsync(
            T.Format("Rename view '{0}'", target.Name),
            T["Enter a new name for this saved custom view."],
            new PromptDialogOptions { Placeholder = target.Name, ConfirmText = T["Rename"], CancelText = T["Cancel"] });

        if (prompt.Cancelled || string.IsNullOrWhiteSpace(prompt.Value)) return;

        var updated = target with { Name = prompt.Value.Trim() };
        await UserPrefs.SaveCustomViewAsync(u.TenantId, u.Id, DocType, updated);
        savedViewsPref = await UserPrefs.GetCustomViewsAsync(u.TenantId, u.Id, DocType);
        Toasts.Success(T.Format("View renamed to '{0}'.", updated.Name), T["Renamed"]);
    }

    private async Task DeleteSavedView(string viewId)
    {
        if (Current.User is not { } u) return;
        var target = savedViewsPref.Views.FirstOrDefault(v => v.Id == viewId);
        if (target is null) return;

        var confirm = await Dialogs.ConfirmAsync(
            T.Format("Delete view '{0}'?", target.Name),
            T["This saved view will be permanently removed for your account."],
            new ConfirmDialogOptions { Destructive = true, ConfirmText = T["Delete"], CancelText = T["Cancel"] });

        if (!confirm.Confirmed) return;

        await UserPrefs.DeleteCustomViewAsync(u.TenantId, u.Id, DocType, viewId);
        savedViewsPref = await UserPrefs.GetCustomViewsAsync(u.TenantId, u.Id, DocType);
        if (selectedViewId == viewId)
        {
            selectedViewId = "";
            activeFilters.Clear();
            search = null;
            await Reload();
        }
        Toasts.Success(T.Format("View '{0}' deleted.", target.Name), T["Deleted"]);
    }

    private void OpenBulkEdit()
    {
        if (selectedItems.Count == 0 || busy || bulkEditableFields.Count == 0) return;
        selectedBulkField ??= bulkEditableFields[0];
        bulkEditValue = selectedBulkField.StaticDefault;
        bulkEditOpen = true;
    }

    private void OnBulkFieldChanged(string? fieldName)
    {
        selectedBulkField = bulkEditableFields.FirstOrDefault(f => f.Name == fieldName);
        bulkEditValue = selectedBulkField?.StaticDefault;
    }

    private async Task ExecuteBulkEdit()
    {
        if (selectedItems.Count == 0 || selectedBulkField is null || busy || meta is null) return;
        busy = true;
        try
        {
            var res = await Docs.BulkEditAsync(Current.Required, DocType, selectedItems.ToList(), selectedBulkField.Name, bulkEditValue);
            bulkEditOpen = false;
            await HandleBulkOutcome(
                res,
                T.Format("{0} {1} document(s) updated successfully.", res.Succeeded.Count, T.Title(meta).ToLower()),
                T["Bulk Edit Complete"],
                T["Failed to Update Some Documents"]);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task SubmitSelected()
    {
        if (selectedItems.Count == 0 || busy || meta is null) return;
        var count = selectedItems.Count;
        var confirm = await Dialogs.ConfirmAsync(
            T.Format("Submit {0} {1} document(s)?", count, T.Title(meta).ToLower()),
            T["Selected draft documents will be validated and submitted."],
            new ConfirmDialogOptions { ConfirmText = $"{T["Submit"]} ({count})", CancelText = T["Cancel"] });
        if (!confirm.Confirmed) return;

        busy = true;
        try
        {
            var res = await Docs.BulkSubmitAsync(Current.Required, DocType, selectedItems.ToList());
            await HandleBulkOutcome(
                res,
                T.Format("{0} {1} document(s) submitted successfully.", res.Succeeded.Count, T.Title(meta).ToLower()),
                T["Submitted"],
                T["Failed to Submit Some Documents"]);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task CancelSelected()
    {
        if (selectedItems.Count == 0 || busy || meta is null) return;
        var count = selectedItems.Count;
        var requireComment = meta.Workflow?.Transitions.Any(t =>
            t.Def.RequireComment &&
            (string.Equals(t.Def.Action, "Cancel", StringComparison.OrdinalIgnoreCase) ||
             string.Equals(t.Def.Action, "Withdraw", StringComparison.OrdinalIgnoreCase) ||
             string.Equals(t.Def.To, "Cancelled", StringComparison.OrdinalIgnoreCase))) == true;

        var prompt = await Dialogs.PromptAsync(
            T.Format("Cancel {0} {1} document(s)?", count, T.Title(meta).ToLower()),
            T["Provide a reason for cancellation. This note will be recorded in the audit history for each document."],
            new PromptDialogOptions { Placeholder = T["Reason…"], ConfirmText = $"{T["Cancel"]} ({count})", CancelText = T["Back"], MaxLength = 1000 });
        if (prompt.Cancelled) return;
        if (requireComment && string.IsNullOrWhiteSpace(prompt.Value))
        {
            Toasts.Error(T["Cancellation requires a reason. Nothing was changed."], T["Empty comment"]);
            return;
        }

        busy = true;
        try
        {
            var comment = string.IsNullOrWhiteSpace(prompt.Value) ? null : prompt.Value.Trim();
            var res = await Docs.BulkCancelAsync(Current.Required, DocType, selectedItems.ToList(), comment);
            await HandleBulkOutcome(
                res,
                T.Format("{0} {1} document(s) cancelled successfully.", res.Succeeded.Count, T.Title(meta).ToLower()),
                T["Cancelled"],
                T["Failed to Cancel Some Documents"]);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task DeleteSelected()
    {
        if (selectedItems.Count == 0 || busy || meta is null) return;

        var count = selectedItems.Count;
        var confirm = await Dialogs.ConfirmAsync(
            T.Format("Delete {0} {1} document(s)?", count, T.Title(meta).ToLower()),
            T["Selected draft documents will be permanently deleted. This action cannot be undone."],
            new ConfirmDialogOptions { Destructive = true, ConfirmText = $"{T["Delete"]} ({count})", CancelText = T["Cancel"] });

        if (!confirm.Confirmed) return;

        busy = true;
        try
        {
            var res = await Docs.BulkDeleteAsync(Current.Required, DocType, selectedItems.ToList());
            await HandleBulkOutcome(
                res,
                T.Format("{0} {1} document(s) deleted successfully.", res.Succeeded.Count, T.Title(meta).ToLower()),
                T["Deleted"],
                T["Failed to Delete Some Documents"]);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task HandleBulkOutcome(BulkActionResult res, string successMsg, string successTitle, string errorTitle)
    {
        if (res.Succeeded.Count > 0)
            Toasts.Success(successMsg, successTitle);

        if (res.Failed.Count > 0)
        {
            var details = string.Join("; ", res.Failed.Select(f => $"{f.Name}: {T.Message(f.Error)}"));
            Toasts.Error(details, errorTitle);
        }

        var keepSelected = res.Failed.Select(f => f.Name).ToHashSet(StringComparer.Ordinal);
        await Reload();
        foreach (var failedName in keepSelected)
            selectedItems.Add(failedName);
    }

    private async Task Reload()
    {
        try
        {
            error = null;
            selectedItems.Clear();
            var clauses = activeFilters.Count > 0 ? activeFilters : null;
            result = await Docs.ListAsync(Current.Required, DocType, new ListRequest(clauses, search, sortField, null, 1, Framework.Persistence.QueryLimits.CountCap), allowAllReadableFields: true);
        }
        catch (Exception ex) when (ex is InvalidPayloadException or PermissionDeniedException)
        {
            error = T.Message(ex.Message);
        }
    }

    private static BlazorBlueprint.Primitives.DataGrid.ColumnPinning MapPinning(string? pinned) => pinned switch
    {
        "Left" => BlazorBlueprint.Primitives.DataGrid.ColumnPinning.Left,
        "Right" => BlazorBlueprint.Primitives.DataGrid.ColumnPinning.Right,
        _ => BlazorBlueprint.Primitives.DataGrid.ColumnPinning.None
    };

    private bool GetDefaultColVisible(string colId)
    {
        if (string.Equals(colId, "modified", StringComparison.OrdinalIgnoreCase)) return false;
        if (string.Equals(colId, "status", StringComparison.OrdinalIgnoreCase) && HasStatus) return true;
        if (meta is not null && meta.ByName.TryGetValue(colId, out var cf))
        {
            return meta.ListColumns.Contains(colId, StringComparer.OrdinalIgnoreCase) && cf.Def.Visible;
        }
        return true;
    }

    private string? GetColWidth(string colId, string? defaultWidth = null) =>
        gridPref.Columns.TryGetValue(colId, out var pref) && GridColumnPreference.NormalizeWidth(pref.Width) is { } validWidth
            ? validWidth
            : defaultWidth;

    private bool IsColVisible(string colId) =>
        gridPref.Columns.TryGetValue(colId, out var pref) ? pref.Visible : GetDefaultColVisible(colId);

    private int? GetColOrder(string colId) =>
        gridPref.Columns.TryGetValue(colId, out var pref) ? pref.Order : null;

    private List<string> DefaultDataColumnSequence()
    {
        var seq = new List<string> { "name" };
        if (result is not null)
        {
            foreach (var c in result.Columns)
            {
                if (string.Equals(c, "name", StringComparison.OrdinalIgnoreCase) ||
                    (HasStatus && string.Equals(c, "status", StringComparison.OrdinalIgnoreCase)) ||
                    string.Equals(c, "modified", StringComparison.OrdinalIgnoreCase))
                {
                    continue;
                }
                seq.Add(c);
            }
        }
        if (HasStatus) seq.Add("status");
        seq.Add("modified");
        return seq;
    }

    private void HandleColumnResize((string ColumnId, string Width) args)
    {
        if (string.IsNullOrWhiteSpace(args.ColumnId)) return;
        var normalized = GridColumnPreference.NormalizeWidth(args.Width);
        if (normalized is null) return;
        if (!gridPref.Columns.TryGetValue(args.ColumnId, out var pref))
        {
            pref = new Framework.Preferences.GridColumnPreference { Visible = GetDefaultColVisible(args.ColumnId) };
        }
        gridPref.Columns[args.ColumnId] = pref with { Width = normalized };
        hasCustomLayout = true;
        ScheduleSavePreference();
    }

    private void OnGridStateChanged(BlazorBlueprint.Primitives.DataGrid.DataGridState<Dictionary<string, object?>> state)
    {
        if (state?.Columns?.Entries is null) return;

        bool hasSavedOrder = gridPref.Columns.Values.Any(v => v.Order.HasValue);
        bool orderChanged;
        if (hasSavedOrder)
        {
            orderChanged = state.Columns.Entries.Any(e =>
                !string.IsNullOrEmpty(e.ColumnId) &&
                e.ColumnId != "_select" &&
                gridPref.Columns.TryGetValue(e.ColumnId, out var p) &&
                p.Order != e.Order);
        }
        else
        {
            var defaultSeq = DefaultDataColumnSequence();
            var defaultSet = defaultSeq.ToHashSet(StringComparer.OrdinalIgnoreCase);
            var currentSeq = state.Columns.Entries
                .Where(e => !string.IsNullOrEmpty(e.ColumnId) && defaultSet.Contains(e.ColumnId))
                .OrderBy(e => e.Order)
                .Select(e => e.ColumnId)
                .ToList();
            orderChanged = !currentSeq.SequenceEqual(defaultSeq, StringComparer.OrdinalIgnoreCase);
        }

        bool changed = false;
        foreach (var entry in state.Columns.Entries)
        {
            if (string.IsNullOrEmpty(entry.ColumnId) || entry.ColumnId == "_select") continue;
            var defaultVisible = GetDefaultColVisible(entry.ColumnId);
            var entryWidth = GridColumnPreference.NormalizeWidth(entry.Width);
            if (!gridPref.Columns.TryGetValue(entry.ColumnId, out var pref))
            {
                if (entry.Visible != defaultVisible || entryWidth is not null || orderChanged)
                {
                    gridPref.Columns[entry.ColumnId] = new Framework.Preferences.GridColumnPreference
                    {
                        Visible = entry.Visible,
                        Width = entryWidth,
                        Order = orderChanged ? entry.Order : null
                    };
                    changed = true;
                }
            }
            else
            {
                var prefWidth = GridColumnPreference.NormalizeWidth(pref.Width);
                var widthToSave = entryWidth ?? prefWidth;
                var orderToSave = orderChanged || hasSavedOrder ? entry.Order : pref.Order;
                if (pref.Visible != entry.Visible || pref.Width != widthToSave || pref.Order != orderToSave)
                {
                    gridPref.Columns[entry.ColumnId] = pref with
                    {
                        Visible = entry.Visible,
                        Width = widthToSave,
                        Order = orderToSave
                    };
                    changed = true;
                }
            }
        }

        if (changed)
        {
            hasCustomLayout = true;
            ScheduleSavePreference();
        }
    }

    private void ScheduleSavePreference()
    {
        saveDebounceTimer?.Dispose();
        saveDebounceTimer = new System.Threading.Timer(async _ =>
        {
            await SavePreferenceAsync();
        }, null, 500, System.Threading.Timeout.Infinite);
    }

    private async Task SavePreferenceAsync()
    {
        try
        {
            if (Current.User is { } u && !string.IsNullOrEmpty(DocType))
            {
                await UserPrefs.SetAsync(u.TenantId, u.Id, $"grid:{DocType}", gridPref);
            }
        }
        catch
        {
            // Background save error shouldn't crash the UI
        }
    }

    private async Task ResetColumnsLayout()
    {
        if (Current.User is { } u && !string.IsNullOrEmpty(DocType))
        {
            await UserPrefs.DeleteAsync(u.TenantId, u.Id, $"grid:{DocType}");
        }
        gridPref = new();
        hasCustomLayout = false;
        ApplyDefaultGrouping();
        gridRenderKey++;
        Toasts.Success(T["Column layout has been reset to default."], T["Reset Columns"]);
        await Reload();
    }

    public void Dispose()
    {
        saveDebounceTimer?.Dispose();
    }
}

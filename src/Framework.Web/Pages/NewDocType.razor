@page "/admin/metadata/new"
@using System.Text.RegularExpressions
@using System.Text.Json
@inject MetadataRegistry Registry
@inject RoleCatalog RoleCatalogSvc
@inject CurrentUser Current
@inject ToastService Toasts
@inject NavigationManager Nav
@inject Framework.Web.AI.AiDraftValidator AiValidator
@inject Framework.Web.AI.AiDesignerService Ai

<PageTitle>New DocType · FrogFrame</PageTitle>

@if (!Current.Required.Roles.Contains(UserContext.SystemManager))
{
    <ErrorState StatusCode="403" Description="This administration page is restricted to System Managers / Administrators." />
}
else
{
    <header class="page-head">
        <div><h1>Create DocType</h1><p>Once created, the DocType immediately appears in navigation and can be configured further in the visual editor.</p></div>
    </header>

    <AiAssistPanel Title="Create with AI"
                   Description="Describe the document, its fields and its approval flow. The AI drafts the DocType (plus child tables and workflow), the platform compiler checks it, and you review it before creating."
                   Placeholder="e.g. Leave request: employee, leave type (annual, sick, unpaid), start and end date, number of days calculated automatically, reason. Approved by the line manager, then HR."
                   Examples="AiExamples"
                   Generate="GenerateWithAi" />

    <div class="new-doctype">
        <BbCard>
            <BbCardContent>
                <div class="stack" style="padding-top:1.25rem">
                    <BbField>
                        <BbFieldLabel For="nd-title">Title</BbFieldLabel>
                        <BbInput Id="nd-title" Value="@title" ValueChanged="SetTitle" Placeholder="e.g. Leave Request" />
                        <BbFieldDescription>The user-facing name shown in navigation menus and page headers.</BbFieldDescription>
                    </BbField>
                    <BbField IsInvalid="@(NameError is not null)">
                        <BbFieldLabel For="nd-name">Technical name</BbFieldLabel>
                        <BbInput Id="nd-name" Class="code-input" Value="@name" ValueChanged="v => { name = (v ?? string.Empty).Trim(); nameTouched = true; }" />
                        @if (NameError is not null) { <BbFieldError Errors="@(new[] { NameError })" /> }
                        else { <BbFieldDescription>PascalCase without spaces; used in URLs, APIs, and relations. Cannot be changed later.</BbFieldDescription> }
                    </BbField>
                    <BbField>
                        <BbFieldLabel>Type</BbFieldLabel>
                        <BbSelect TValue="string" Value="@kind" ValueChanged="v => kind = v ?? kind" AriaLabel="DocType type"
                                  Options="@(new[] { new SelectOption<string>("document", "Document (has list, form, and auto-naming)"), new SelectOption<string>("single", "Single DocType (singleton settings per tenant)"), new SelectOption<string>("child", "Child table row (used inside another document)") })" />
                    </BbField>
                    @if (kind == "document" || kind == "single")
                    {
                        <BbField>
                            <BbFieldLabel For="nd-module">Modul (wajib, dari Master Modules)</BbFieldLabel>
                            <BbSelect TValue="string" Value="@(module ?? "")" ValueChanged="v => module = string.IsNullOrWhiteSpace(v) ? null : v" Options="ModuleOptions(module)" AriaLabel="Modul" />
                        </BbField>
                    }
                    @if (kind == "document")
                    {
                        <BbField>
                            <BbFieldLabel For="nd-naming">Document naming pattern</BbFieldLabel>
                            <BbInput Id="nd-naming" Class="code-input" Value="@Naming" ValueChanged="v => { naming = v; namingTouched = true; }" />
                            <BbFieldDescription>Next document number example: <code>@SampleName</code></BbFieldDescription>
                        </BbField>
                        @if (aiDraft is null)
                        {
                        <BbField>
                            <BbFieldLabel>Initial template</BbFieldLabel>
                            <BbSelect TValue="string" Value="@template" ValueChanged="v => template = v ?? template" AriaLabel="Template"
                                      Options="@(new[] { new SelectOption<string>("approval", "Approval document (standard fields + permissions + workflow)"), new SelectOption<string>("basic", "Simple document (standard fields + permissions, no workflow)"), new SelectOption<string>("empty", "Empty (single title field)") })" />
                        </BbField>
                        }
                    }
                    @if (error is not null) { <BbAlert Variant="AlertVariant.Danger"><BbAlertDescription>@error</BbAlertDescription></BbAlert> }
                    <div class="row">
                        @if (aiDraft is null)
                        {
                            <BbButton Disabled="@(busy || NameError is not null || string.IsNullOrWhiteSpace(title))" OnClick="Create"><LucideIcon Name="plus" Size="16" /> Create DocType</BbButton>
                        }
                        else
                        {
                            <BbButton Disabled="@(busy || NameError is not null || string.IsNullOrWhiteSpace(title))" OnClick="CreateFromAi"><LucideIcon Name="sparkles" Size="16" /> Create from AI draft</BbButton>
                            <BbButton Variant="ButtonVariant.Outline" Disabled="busy" OnClick="DiscardAi">Discard AI draft</BbButton>
                        }
                        <BbButton Variant="ButtonVariant.Ghost" Href="/admin/metadata" OnClick="@(() => Nav.NavigateTo("/admin/metadata"))">Cancel</BbButton>
                    </div>
                </div>
            </BbCardContent>
        </BbCard>

        @if (aiDraft?.DocType is { } d)
        {
            <BbCard>
                <BbCardHeader>
                    <BbCardTitle Class="card-title">AI draft: what will be created</BbCardTitle>
                    <BbCardDescription>
                        @if (aiDraft.Ok) { <BbBadge Variant="BadgeVariant.SoftSuccess">Checked by the compiler</BbBadge> }
                        else { <BbBadge Variant="BadgeVariant.SoftDestructive">@aiDraft.Errors.Count issue(s)</BbBadge> }
                    </BbCardDescription>
                </BbCardHeader>
                <BbCardContent>
                    <div class="stack small">
                        <div><strong>@d.Title</strong> <code>@d.Name</code> @(d.IsSingle ? "· single" : "") @(string.IsNullOrWhiteSpace(d.Module) ? "" : $"· module {d.Module}")</div>
                        <table style="width:100%;border-collapse:collapse">
                            <thead><tr style="text-align:left"><th>Field</th><th>Type</th><th>Rule</th></tr></thead>
                            <tbody>
                                @foreach (var f in d.Fields)
                                {
                                    <tr style="border-top:1px solid var(--bb-border)">
                                        <td>@f.Label <code class="muted">@f.Name</code></td>
                                        <td>@FieldTypeText(f)</td>
                                        <td class="muted">@FieldRule(f)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        @foreach (var child in aiDraft.ChildDocTypes)
                        {
                            <div><LucideIcon Name="table" Size="14" /> Child table <code>@child.Name</code>: @(string.Join(", ", child.Fields.Select(cf => $"{cf.Label} ({cf.Type})")))</div>
                        }
                        @if (d.Permissions.Count > 0)
                        {
                            <div><LucideIcon Name="shield" Size="14" /> Permissions: @(string.Join("; ", d.Permissions.Select(p => $"{p.Role}: {string.Join("/", p.Actions)} ({p.Scope})")))</div>
                        }
                        @if (aiDraft.Workflow is { } wf)
                        {
                            <div><LucideIcon Name="git-branch" Size="14" /> Workflow <code>@wf.Name</code>: @(string.Join(" → ", wf.States.Select(st => st.Name)))</div>
                            <ul style="margin:.2rem 0 0 1rem;padding:0">
                                @foreach (var t in wf.Transitions)
                                {
                                    <li>@t.From → @t.To: <strong>@t.Action</strong> @TransitionText(t)</li>
                                }
                            </ul>
                        }
                        @if (!aiDraft.Ok)
                        {
                            <BbAlert Variant="AlertVariant.Warning"><BbAlertDescription><ul class="error-list">@foreach (var e in aiDraft.Errors.Take(10)) { <li>@e</li> }</ul></BbAlertDescription></BbAlert>
                        }
                        <p class="muted small">Publishing happens only when you press "Create from AI draft". Fields, layout and permissions can be changed afterwards in the visual editor.</p>
                    </div>
                </BbCardContent>
            </BbCard>
        }
        else
        {
        <BbCard>
            <BbCardHeader><BbCardTitle Class="card-title">What will be created</BbCardTitle></BbCardHeader>
            <BbCardContent>
                <ul class="checklist">
                    @foreach (var line in Summary) { <li><LucideIcon Name="check" Size="15" /> @line</li> }
                </ul>
                <p class="muted small">Everything can be modified later in the visual editor (fields, layout, permissions) and workflow editor.</p>
            </BbCardContent>
        </BbCard>
        }
    </div>
}

@code {
    /// <summary>Pilihan modul dari Master Modules. Nilai lama yang belum ada di master tetap tampil agar bisa diperbaiki.</summary>
    private IEnumerable<SelectOption<string>> ModuleOptions(string? current)
    {
        var codes = RoleCatalogSvc.ModuleCodes(Current.Required.TenantId).OrderBy(c => c, StringComparer.Ordinal).ToList();
        if (!string.IsNullOrWhiteSpace(current) && !codes.Contains(current)) codes.Insert(0, current);
        return new[] { new SelectOption<string>("", "(pilih modul)") }.Concat(codes.Select(c => new SelectOption<string>(c, c)));
    }

    private string title = "", name = "", kind = "document", template = "approval";
    private string? module, naming, error;
    private bool nameTouched, namingTouched, busy;

    private string Naming => namingTouched && naming is not null ? naming : $"{Prefix(name)}-{{YYYY}}-{{#####}}";
    private string SampleName => Naming.Replace("{YYYY}", DateTime.Now.Year.ToString()).Replace("{MM}", DateTime.Now.ToString("MM"))
        .Replace("{#####}", "00001").Replace("{####}", "0001").Replace("{###}", "001");

    private string? NameError =>
        name.Length == 0 ? (title.Length == 0 ? null : "Technical name is required")
        : !Regex.IsMatch(name, "^[A-Z][A-Za-z0-9]{1,63}$") ? "Must start with an uppercase letter, letters and numbers only (PascalCase)"
        : Registry.Current.TryGet(name, out _) ? $"DocType '{name}' already exists"
        : null;

    private IEnumerable<string> Summary
    {
        get
        {
            if (kind == "child") { yield return "Row DocType (isChild) with description field"; yield return "Used via Child table field in other DocTypes"; yield break; }
            if (kind == "single")
            {
                yield return "Single DocType (singleton settings per tenant)";
                yield return "No list page needed; opens directly into settings form";
                yield return "Fixed document identifier matching DocType name";
                yield return $"Menu: {(string.IsNullOrWhiteSpace(module) ? "General" : module)} → {(string.IsNullOrWhiteSpace(title) ? "…" : title)}";
                yield break;
            }
            yield return template == "empty" ? "Fields: Title" : "Fields: Title, Date, Description";
            yield return $"Document number: {SampleName}";
            if (template != "empty") yield return "Permissions: Employees create & manage their own documents; System Manager manages all";
            else yield return "Permissions: System Manager only (configure in Permissions & workflow tab)";
            if (template == "approval") { yield return $"Workflow {name}Approval: Draft → Submitted → Approved / Rejected"; yield return "Managers approve or reject with comments"; }
            yield return $"Menu: {(string.IsNullOrWhiteSpace(module) ? "General" : module)} → {(string.IsNullOrWhiteSpace(title) ? "…" : title)}";
        }
    }

    private void SetTitle(string? v)
    {
        title = v ?? string.Empty;
        if (!nameTouched) name = ToPascal(title);
    }

    private static string ToPascal(string s) =>
        string.Concat(Regex.Split(s, "[^A-Za-z0-9]+").Where(w => w.Length > 0).Select(w => char.ToUpperInvariant(w[0]) + w[1..]));

    /// <summary>Prefix nomor dari huruf besar nama teknis, mis. PengajuanCuti → PC; satu kata → 3 huruf pertama.</summary>
    private static string Prefix(string n)
    {
        var caps = new string(n.Where(char.IsUpper).ToArray());
        return caps.Length >= 2 ? caps : n.Length >= 3 ? n[..3].ToUpperInvariant() : "DOC";
    }

    private DocTypeDef BuildDef()
    {
        var def = new DocTypeDef { Name = name, Version = 1, Title = title.Trim(), IsChild = kind == "child", IsSingle = kind == "single" };
        if (def.IsChild)
        {
            def.Fields = [new FieldDef { Name = "description", Type = "Data", Label = "Description", RequiredWhen = "true" }];
            return def;
        }
        def.Module = string.IsNullOrWhiteSpace(module) ? null : module.Trim();
        if (def.IsSingle)
        {
            def.Naming = new NamingDef { Pattern = "field:name" };
            def.Document = new DocumentDef { AllowAmend = false, AllowDelete = false };
            def.Fields = [new FieldDef { Name = "settings_name", Type = "Data", Label = "Configuration Name", Default = JsonSerializer.SerializeToElement(title) }];
            def.Permissions =
            [
                new PermissionDef { Role = "System Manager", Actions = ["read", "create", "write"], Scope = "all" },
            ];
            return def;
        }
        def.Naming = new NamingDef { Pattern = Naming };
        def.Document = new DocumentDef { AllowAmend = template == "approval", AllowDelete = true };
        def.Fields = [new FieldDef { Name = "title", Type = "Data", Label = "Title", RequiredWhen = "true", InListView = true }];
        if (template != "empty")
        {
            def.Fields.Add(new FieldDef { Name = "date", Type = "Date", Label = "Date", RequiredWhen = "true", InListView = true, Column = 2, Default = JsonSerializer.SerializeToElement("$today") });
            def.Fields.Add(new FieldDef { Name = "description", Type = "Text", Label = "Description" });
            def.Permissions =
            [
                new PermissionDef { Role = "Employee", Actions = ["read", "create", "write", "delete"], Scope = "owner" },
            ];
        }
        def.ListView = new ListViewDef { TitleField = "title", SearchFields = ["name", "title"] };
        return def;
    }

    private void Create()
    {
        error = null; busy = true;
        try
        {
            var def = BuildDef();
            var preview = Registry.Preview(def, RoleCatalogSvc.Scope(Current.Required.TenantId));
            if (!preview.Valid) { error = string.Join(" ", preview.Errors.Select(e => e.Message)); return; }
            Registry.Publish(def, Current.Required.Id, acknowledgeRisk: false, scope: RoleCatalogSvc.Scope(Current.Required.TenantId));
            if (kind == "document" && template == "approval")
            {
                // Approval: permission Manager membaca semua (untuk menyetujui) + workflow dipasang sekaligus.
                var withManager = MetadataJson.ParseDocType(MetadataJson.Serialize(Registry.Current.Get(name).Def));
                withManager.Version = 2;
                withManager.Permissions.Add(new PermissionDef { Role = "Manager", Actions = ["read", "report"], Scope = "all" });
                Registry.Publish(withManager, Current.Required.Id, acknowledgeRisk: true, scope: RoleCatalogSvc.Scope(Current.Required.TenantId));
                Registry.PublishWorkflow(ApprovalWorkflow(), Current.Required.Id, acknowledgeRisk: true, attach: true, scope: RoleCatalogSvc.Scope(Current.Required.TenantId));
            }
            Toasts.Success("Configure fields and permissions in the visual editor.", $"DocType {name} created");
            Nav.NavigateTo($"/admin/metadata/{name}/editor");
        }
        catch (Exception ex) when (ex is MetadataCompilationException or InvalidOperationException)
        {
            error = ex.Message;
        }
        finally { busy = false; }
    }

    // ------------------------------------------------------------------ AI draft

    private Framework.Web.AI.AiDocTypeResult? aiDraft;

    private static readonly IReadOnlyList<string> AiExamples =
    [
        "Leave request: employee, leave type (annual, sick, unpaid), start and end date, number of days calculated automatically, reason. Approved by the line manager, then HR.",
        "Vehicle booking: vehicle, driver, destination, departure and return time, passengers. Approved by General Affairs.",
        "Pengajuan reimburse: karyawan, tanggal, tabel rincian biaya (kategori, keterangan, jumlah), total otomatis. Disetujui atasan lalu Finance.",
    ];

    private async Task<Framework.Web.AI.AiPanelOutcome> GenerateWithAi(string request, CancellationToken ct)
    {
        var r = await Ai.DesignDocTypeAsync(Current.Required, request, existingDocType: null, module: module, ct: ct);
        if (r.DocType is null)
            return new(false, r.Explanation, r.Errors, r.Usage, "The AI did not return a draft");

        aiDraft = r;
        error = null;
        title = r.DocType.Title;
        name = r.DocType.Name;
        nameTouched = true;
        kind = r.DocType.IsSingle ? "single" : "document";
        if (!string.IsNullOrWhiteSpace(r.DocType.Module)) module = r.DocType.Module;
        if (kind == "document" && !string.IsNullOrWhiteSpace(r.DocType.Naming?.Pattern)) { naming = r.DocType.Naming.Pattern; namingTouched = true; }

        return new(r.Ok, r.Explanation, r.Errors, r.Usage,
            r.Ok ? "Draft ready: review it and press \"Create from AI draft\"" : "The draft still has problems: refine the description and try again");
    }

    private void DiscardAi()
    {
        aiDraft = null;
        error = null;
    }

    private static string FieldTypeText(FieldDef f) =>
        f.Type + (f.LinkTo is { } l ? $" → {l}" : f.ChildDocType is { } c ? $" → {c}" : f.Options is { Count: > 0 } o ? $" ({string.Join(", ", o)})" : "");

    private static string TransitionText(WorkflowTransitionDef t) =>
        $"({string.Join(", ", t.AllowedRoles)})" + (string.IsNullOrWhiteSpace(t.Condition) ? "" : $" if {t.Condition}");

    private static string FieldRule(FieldDef f) =>
        f.Compute is { Length: > 0 } c ? $"= {c}"
        : f.FetchFrom is { Length: > 0 } ff ? $"from {ff}"
        : f.RequiredWhen == "true" ? "required"
        : f.RequiredWhen is { Length: > 0 } rw ? $"required if {rw}"
        : "";

    /// <summary>Publishes the AI draft: child DocTypes, then the main DocType, then the workflow (attached).</summary>
    private void CreateFromAi()
    {
        if (aiDraft?.DocType is null) return;
        error = null; busy = true;
        var user = Current.Required;
        var scope = RoleCatalogSvc.Scope(user.TenantId);

        // The administrator may have changed title, technical name, module or naming on the form.
        var main = Framework.Web.AI.AiDraftValidator.Clone(aiDraft.DocType);
        main.Name = name;
        main.Title = title.Trim();
        main.Version = 1;
        main.Workflow = null;
        if (!main.IsChild && !string.IsNullOrWhiteSpace(module)) main.Module = module.Trim();
        if (kind == "document") main.Naming = new NamingDef { Pattern = Naming };
        var children = aiDraft.ChildDocTypes.Select(Framework.Web.AI.AiDraftValidator.Clone).ToList();
        var wf = aiDraft.Workflow is null ? null : Framework.Web.AI.AiDraftValidator.CloneWorkflow(aiDraft.Workflow);
        if (wf is not null) { wf.DocType = main.Name; wf.Version = 1; }

        var problems = AiValidator.ValidateDocTypes(user, main, children, wf, existingName: null);
        if (problems.Count > 0) { error = string.Join(" ", problems.Take(8)); busy = false; return; }

        var done = new List<string>();
        try
        {
            foreach (var c in children)
            {
                Registry.Publish(c, user.Id, acknowledgeRisk: false, scope: scope);
                done.Add(c.Name);
            }
            Registry.Publish(main, user.Id, acknowledgeRisk: false, scope: scope);
            done.Add(main.Name);
            if (wf is not null)
            {
                Registry.PublishWorkflow(wf, user.Id, acknowledgeRisk: true, attach: true, scope: scope);
                done.Add(wf.Name);
            }
            Toasts.Success("Review fields, layout and permissions in the visual editor.", $"DocType {main.Name} created from the AI draft");
            Nav.NavigateTo($"/admin/metadata/{main.Name}/editor");
        }
        catch (Exception ex) when (ex is MetadataCompilationException or InvalidOperationException)
        {
            error = done.Count == 0 ? ex.Message : $"Published {string.Join(", ", done)}, then stopped: {ex.Message}";
        }
        finally { busy = false; }
    }

    private WorkflowDef ApprovalWorkflow() => new()
    {
        Name = $"{name}Approval", DocType = name, Version = 1, InitialState = "Draft",
        States =
        [
            new() { Name = "Draft", DocStatus = 0, Tone = "neutral" },
            new() { Name = "Submitted", DocStatus = 1, Tone = "pending" },
            new() { Name = "Approved", DocStatus = 1, Tone = "positive" },
            new() { Name = "Rejected", DocStatus = 2, Tone = "negative" },
        ],
        Transitions =
        [
            new() { From = "Draft", To = "Submitted", Action = "Submit", AllowedRoles = ["Employee"], Condition = "owner == user.id" },
            new() { From = "Submitted", To = "Approved", Action = "Approve", AllowedRoles = ["Manager"], Condition = "owner != user.id" },
            new() { From = "Submitted", To = "Rejected", Action = "Reject", AllowedRoles = ["Manager"], Condition = "owner != user.id", RequireComment = true },
        ],
    };
}

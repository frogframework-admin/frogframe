@page "/forgot-password"
@attribute [ExcludeFromInteractiveRouting]
@layout AuthCardLayout
@using System.ComponentModel.DataAnnotations
@using System.Net
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Http
@using Framework.Email
@using Framework.Security
@inject IUserAccountRepository Accounts
@inject UserManager<UserAccount> Users
@inject IEmailQueue EmailQueue
@inject NavigationManager Nav

<PageTitle>Forgot Password · FrogFrame</PageTitle>

<h1 class="auth-title">Forgot password</h1>
<p class="auth-sub">Enter your email or username to receive a password reset link.</p>

@if (submitted)
{
    <div class="auth-alert" style="background-color: #ecfdf5; color: #065f46; border-color: #a7f3d0;" role="alert">
        If an account with that information exists, we've sent password reset instructions to the registered email address.
    </div>
    <div style="margin-top: 1.5rem; text-align: center;">
        <a href="/account/login" class="auth-link" data-enhance-nav="false">&larr; Back to login</a>
    </div>
}
else
{
    @if (error is not null)
    {
        <div class="auth-alert" role="alert">@error</div>
    }

    <EditForm Model="Input" method="post" OnValidSubmit="RequestResetAsync" FormName="forgot-password" class="auth-form">
        <DataAnnotationsValidator />
        <div class="auth-field">
            <label for="identifier">Email or Username</label>
            <InputText id="identifier" class="auth-input" @bind-Value="Input.Identifier" autocomplete="email" autofocus />
            <ValidationMessage For="() => Input.Identifier" class="auth-error" />
        </div>
        <button type="submit" class="auth-button" disabled="@busy">Send Reset Link</button>
        <div style="margin-top: 1rem; text-align: center;">
            <a href="/account/login" class="auth-link" data-enhance-nav="false">&larr; Back to login</a>
        </div>
    </EditForm>
}

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm] private ForgotModel Input { get; set; } = default!;
    private string? error;
    private bool submitted;
    private bool busy;

    protected override void OnInitialized()
    {
        Input ??= new();
    }

    private async Task RequestResetAsync()
    {
        busy = true;
        error = null;
        try
        {
            var id = (Input.Identifier ?? "").Trim();
            if (string.IsNullOrWhiteSpace(id))
            {
                error = "Please enter your email or username.";
                return;
            }

            var user = await Accounts.FindByNormalizedEmailAsync(id.ToUpperInvariant())
                       ?? await Accounts.FindByNormalizedUserNameAsync(id.ToUpperInvariant());

            if (user is not null && user.IsActive && !string.IsNullOrWhiteSpace(user.Email))
            {
                var token = await Users.GeneratePasswordResetTokenAsync(user);
                var baseUrl = $"{HttpContext.Request.Scheme}://{HttpContext.Request.Host}";
                var resetLink = $"{baseUrl}/reset-password?userId={Uri.EscapeDataString(user.Id)}&token={Uri.EscapeDataString(token)}";

                var template = "Hello {{FullName}},\n\nA password reset was requested for your account ({{UserName}}).\nClick the link below to set a new password:\n\n{{ResetLink}}\n\nThis single-use link is valid for 24 hours. If you did not request this, please ignore this email.";
                var bodyText = EmailTemplateEngine.Render(template, new Dictionary<string, string?>
                {
                    ["FullName"] = user.FullName,
                    ["UserName"] = user.UserName,
                    ["ResetLink"] = resetLink
                });

                var emailMsg = new EmailMessage
                {
                    To = [user.Email],
                    Subject = "Reset Your FrogFrame Password",
                    BodyHtml = $"<p>Hello <b>{WebUtility.HtmlEncode(user.FullName)}</b>,</p><p>A password reset was requested for your account (<code>{WebUtility.HtmlEncode(user.UserName)}</code>).</p><p><a href=\"{WebUtility.HtmlEncode(resetLink)}\" style=\"display:inline-block;padding:10px 16px;background:#2563eb;color:#ffffff;text-decoration:none;border-radius:6px;\">Reset Password</a></p><p>Or copy this URL into your browser:<br/><a href=\"{WebUtility.HtmlEncode(resetLink)}\">{WebUtility.HtmlEncode(resetLink)}</a></p><p><small>This single-use link is valid for 24 hours. If you did not request this, please ignore this email.</small></p>",
                    BodyText = bodyText
                };

                await EmailQueue.QueueAsync(user.TenantId, emailMsg, idempotencyKey: $"pwd-reset-{user.Id}-{token.GetHashCode()}");
            }

            submitted = true;
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private sealed class ForgotModel
    {
        [Required(ErrorMessage = "Email or username is required")]
        public string Identifier { get; set; } = "";
    }
}


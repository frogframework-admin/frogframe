@page "/account/password"
@attribute [ExcludeFromInteractiveRouting]
@layout AuthCardLayout
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Http
@inject UserManager<UserAccount> Users
@inject SignInManager<UserAccount> SignIn
@inject NavigationManager Nav

<PageTitle>Change password · FrogFrame</PageTitle>

<h1 class="auth-title">Change password</h1>
<p class="auth-sub">Minimum 10 characters, with uppercase, lowercase, and numbers.</p>

@if (message is not null) { <div class="auth-alert auth-success" role="status">@message</div> }
@if (error is not null) { <div class="auth-alert" role="alert">@error</div> }

<EditForm Model="Input" method="post" OnValidSubmit="ChangeAsync" FormName="change-password" class="auth-form">
    <DataAnnotationsValidator />
    <div class="auth-field">
        <label for="current">Current password</label>
        <InputText id="current" type="password" class="auth-input" @bind-Value="Input.Current" autocomplete="current-password" />
        <ValidationMessage For="() => Input.Current" class="auth-error" />
    </div>
    <div class="auth-field">
        <label for="new">New password</label>
        <InputText id="new" type="password" class="auth-input" @bind-Value="Input.New" autocomplete="new-password" />
        <ValidationMessage For="() => Input.New" class="auth-error" />
    </div>
    <div class="auth-field">
        <label for="confirm">Confirm new password</label>
        <InputText id="confirm" type="password" class="auth-input" @bind-Value="Input.Confirm" autocomplete="new-password" />
        <ValidationMessage For="() => Input.Confirm" class="auth-error" />
    </div>
    <button type="submit" class="auth-button">Save password</button>
    <a class="auth-link" href="/">Back to FrogFrame</a>
</EditForm>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm] private PasswordModel Input { get; set; } = default!;
    private string? message, error;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        if (await Users.GetUserAsync(HttpContext.User) is null)
            Nav.NavigateTo("/account/login?returnUrl=%2Faccount%2Fpassword", forceLoad: true);
    }

    private async Task ChangeAsync()
    {
        var user = await Users.GetUserAsync(HttpContext.User);
        if (user is null) { Nav.NavigateTo("/account/login", forceLoad: true); return; }
        var result = await Users.ChangePasswordAsync(user, Input.Current, Input.New);
        if (!result.Succeeded)
        {
            error = result.Errors.Any(e => e.Code == "PasswordMismatch") ? "Current password is incorrect."
                  : string.Join(" ", result.Errors.Select(Translate));
            return;
        }
        // Security stamp berubah → sesi lain berakhir; sesi ini diperbarui agar tetap masuk.
        await SignIn.RefreshSignInAsync(user);
        Input = new();
        message = "Password changed successfully. Sessions on other devices will be terminated.";
    }

    private static string Translate(IdentityError e) => e.Code switch
    {
        "PasswordTooShort" => "Password is too short (minimum 10 characters).",
        "PasswordRequiresDigit" => "Password must contain a number.",
        "PasswordRequiresLower" => "Password must contain a lowercase letter.",
        "PasswordRequiresUpper" => "Password must contain an uppercase letter.",
        _ => e.Description
    };

    private sealed class PasswordModel
    {
        [Required(ErrorMessage = "Current password is required")] public string Current { get; set; } = "";
        [Required(ErrorMessage = "New password is required"), MinLength(10, ErrorMessage = "Minimum 10 characters")] public string New { get; set; } = "";
        [Compare(nameof(New), ErrorMessage = "Does not match the new password")] public string Confirm { get; set; } = "";
    }
}

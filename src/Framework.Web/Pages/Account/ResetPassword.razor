@page "/reset-password"
@attribute [ExcludeFromInteractiveRouting]
@layout AuthLayout
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using Framework.Security
@inject UserManager<UserAccount> Users
@inject NavigationManager Nav

<PageTitle>Reset Password · DocFrame</PageTitle>

<h1 class="auth-title">Reset password</h1>
<p class="auth-sub">Enter a new secure password for your account.</p>

@if (string.IsNullOrWhiteSpace(UserId) || string.IsNullOrWhiteSpace(Token))
{
    <div class="auth-alert" role="alert">
        Invalid or missing password reset link. Please request a new one.
    </div>
    <div style="margin-top: 1.5rem; text-align: center;">
        <a href="/forgot-password" class="auth-link" style="color:var(--bb-primary, #2563eb);text-decoration:none;">Request password reset</a>
    </div>
}
else
{
    @if (error is not null)
    {
        <div class="auth-alert" role="alert">@error</div>
    }

    <EditForm Model="Input" method="post" OnValidSubmit="ResetAsync" FormName="reset-password" class="auth-form">
        <DataAnnotationsValidator />
        <input type="hidden" name="Input.UserId" value="@UserId" />
        <input type="hidden" name="Input.Token" value="@Token" />
        <div class="auth-field">
            <label for="new-password">New Password</label>
            <InputText id="new-password" type="password" class="auth-input" @bind-Value="Input.NewPassword" autocomplete="new-password" autofocus />
            <ValidationMessage For="() => Input.NewPassword" class="auth-error" />
        </div>
        <div class="auth-field">
            <label for="confirm-password">Confirm Password</label>
            <InputText id="confirm-password" type="password" class="auth-input" @bind-Value="Input.ConfirmPassword" autocomplete="new-password" />
            <ValidationMessage For="() => Input.ConfirmPassword" class="auth-error" />
        </div>
        <button type="submit" class="auth-button" disabled="@busy">Reset Password</button>
        <div style="margin-top: 1rem; text-align: center;">
            <a href="/account/login" class="auth-link" style="font-size:0.875rem;color:var(--bb-primary, #2563eb);text-decoration:none;">&larr; Back to login</a>
        </div>
    </EditForm>
}

@code {
    [SupplyParameterFromQuery(Name = "userId")] private string? UserId { get; set; }
    [SupplyParameterFromQuery(Name = "token")] private string? Token { get; set; }
    [SupplyParameterFromForm] private ResetModel Input { get; set; } = default!;
    private string? error;
    private bool busy;

    protected override void OnInitialized()
    {
        Input ??= new() { UserId = UserId ?? "", Token = Token ?? "" };
    }

    private async Task ResetAsync()
    {
        busy = true;
        error = null;
        try
        {
            var targetUserId = !string.IsNullOrWhiteSpace(Input.UserId) ? Input.UserId : UserId;
            var targetToken = !string.IsNullOrWhiteSpace(Input.Token) ? Input.Token : Token;

            if (string.IsNullOrWhiteSpace(targetUserId) || string.IsNullOrWhiteSpace(targetToken))
            {
                error = "Invalid or expired reset token.";
                return;
            }

            var user = await Users.FindByIdAsync(targetUserId);
            if (user is null || !user.IsActive)
            {
                error = "User not found or account is inactive.";
                return;
            }

            var result = await Users.ResetPasswordAsync(user, targetToken, Input.NewPassword);
            if (result.Succeeded)
            {
                Nav.NavigateTo("/account/login?reset=1", forceLoad: true);
                return;
            }

            error = string.Join(" ", result.Errors.Select(e => e.Description));
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private sealed class ResetModel
    {
        public string UserId { get; set; } = "";
        public string Token { get; set; } = "";

        [Required(ErrorMessage = "New password is required")]
        [MinLength(10, ErrorMessage = "Password must be at least 10 characters long")]
        public string NewPassword { get; set; } = "";

        [Required(ErrorMessage = "Password confirmation is required")]
        [Compare(nameof(NewPassword), ErrorMessage = "Passwords do not match")]
        public string ConfirmPassword { get; set; } = "";
    }
}

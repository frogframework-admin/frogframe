@page "/account/logout"
@attribute [ExcludeFromInteractiveRouting]
@layout AuthLayout
@using Microsoft.AspNetCore.Identity
@inject SignInManager<UserAccount> SignIn
@inject NavigationManager Nav

<PageTitle>Log out · DocFrame</PageTitle>

<h1 class="auth-title">Log out from DocFrame?</h1>
<p class="auth-sub">Your session on this device will be terminated.</p>

@* Logout lewat POST + antiforgery (bukan tautan GET) agar tidak bisa dipicu dari situs lain. *@
<EditForm Model="model" method="post" OnSubmit="LogoutAsync" FormName="logout" class="auth-form">
    <button type="submit" class="auth-button">Log out</button>
    <a class="auth-link" href="/">Cancel</a>
</EditForm>

@code {
    [SupplyParameterFromForm] private LogoutModel model { get; set; } = default!;

    protected override void OnInitialized() => model ??= new();

    private async Task LogoutAsync()
    {
        await SignIn.SignOutAsync();
        Nav.NavigateTo("/account/login", forceLoad: true);
    }

    private sealed class LogoutModel { public string? Confirm { get; set; } }
}

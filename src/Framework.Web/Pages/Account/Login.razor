@page "/account/login"
@attribute [ExcludeFromInteractiveRouting]
@layout AuthLayout
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Http
@using Microsoft.Extensions.Configuration
@using Microsoft.Extensions.Hosting
@inject SignInManager<UserAccount> SignIn
@inject UserManager<UserAccount> Users
@inject NavigationManager Nav
@inject IConfiguration Config
@inject IHostEnvironment Env
@inject TimeProvider Clock

<PageTitle>Log in · FrogFrame</PageTitle>

<div class="grid lg:grid-cols-2 min-h-screen login-split-layout">
    <!-- Left column - form -->
    <div class="relative flex flex-col items-center justify-center p-8 login-split-form">
        <button type="button" class="login-theme-btn" onclick="window.frogframe && window.frogframe.toggleTheme()" title="Toggle light / dark mode" aria-label="Toggle theme">
            <svg class="sun-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
            <svg class="moon-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
        </button>
        <div class="login-form-container">
            <div class="auth-brand">
                <span class="brand-mark" aria-hidden="true">F</span>
                <span>FrogFrame</span>
            </div>

            <h1 class="auth-title">Log in</h1>
            <p class="auth-sub">Use the account provided by your administrator.</p>

            @if (ResetSuccess)
            {
                <div class="auth-alert auth-success" role="alert">
                    Password has been successfully reset. Please log in with your new password.
                </div>
            }

            @if (error is not null)
            {
                <div class="auth-alert" role="alert">@error</div>
            }

            <EditForm Model="Input" method="post" OnValidSubmit="LoginAsync" FormName="login" class="auth-form">
                <DataAnnotationsValidator />
                <div class="auth-field">
                    <label for="username">Username</label>
                    <InputText id="username" class="auth-input" @bind-Value="Input.UserName" autocomplete="username" autofocus />
                    <ValidationMessage For="() => Input.UserName" class="auth-error" />
                </div>
                <div class="auth-field">
                    <label for="password">Password</label>
                    <InputText id="password" type="password" class="auth-input" @bind-Value="Input.Password" autocomplete="current-password" />
                    <ValidationMessage For="() => Input.Password" class="auth-error" />
                </div>
                <div style="display:flex;justify-content:flex-end;margin-top:-0.5rem;margin-bottom:0.75rem;">
                    <a href="/forgot-password" class="auth-link" data-enhance-nav="false">Forgot password?</a>
                </div>
                <label class="auth-check"><InputCheckbox @bind-Value="Input.RememberMe" /> Remember me on this device</label>
                <button type="submit" class="auth-button">Log in</button>
            </EditForm>

            @if (Env.IsDevelopment() || Config.GetValue<bool>("Demo:ShowAccounts"))
            {
                <details class="auth-demo" open>
                    <summary>Demo accounts (development / demo environment only)</summary>
                    <p>Password for all accounts: <code>@(Config["Demo:Password"] ?? "FrogFrame#2026")</code></p>
                    <p><code>andi</code> · <code>sari</code> requester · <code>budi</code> · <code>maya</code> manager · <code>dewi</code> finance · <code>rina</code> procurement · <code>admin</code> System Manager · <code>tono</code> globex tenant</p>
                </details>
            }

            <div class="auth-footer">
                Designed with <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="#e11d48" stroke="none" style="display:inline-block;vertical-align:-1px;margin:0 1px;" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg> using <a href="https://blazorblueprintui.com/" target="_blank" rel="noopener noreferrer">Blazor Blueprint - shadcn/ui for Blazor</a>
            </div>
        </div>
    </div>

    <!-- Right column - cover image -->
    <div class="relative hidden lg:block overflow-hidden login-split-cover"
         role="img" aria-label="FrogFramework Cover">
    </div>
</div>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm] private LoginModel Input { get; set; } = default!;
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery(Name = "reset")] private string? Reset { get; set; }
    private bool ResetSuccess => Reset == "1";
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        var isDev = Env.IsDevelopment() || Config.GetValue<bool>("Demo:ShowAccounts");
        Input ??= new()
        {
            UserName = isDev ? "admin" : "",
            Password = isDev ? (Config["Demo:Password"] ?? "FrogFrame#2026") : ""
        };

        if (HttpMethods.IsGet(HttpContext.Request.Method))
        {
            await HttpContext.SignOutAsync(IdentityConstants.ExternalScheme);
            if (isDev)
            {
                if (string.IsNullOrEmpty(Input.UserName)) Input.UserName = "admin";
                if (string.IsNullOrEmpty(Input.Password)) Input.Password = Config["Demo:Password"] ?? "FrogFrame#2026";
            }
        }
    }

    private async Task LoginAsync()
    {
        var isDev = Env.IsDevelopment() || Config.GetValue<bool>("Demo:ShowAccounts");
        var userName = Input.UserName.Trim();
        if (isDev && string.Equals(userName, "login", StringComparison.OrdinalIgnoreCase))
        {
            userName = "admin";
        }

        var result = await SignIn.PasswordSignInAsync(userName, Input.Password, Input.RememberMe, lockoutOnFailure: true);
        if (result.Succeeded)
        {
            if (await Users.FindByNameAsync(userName) is { } user)
            {
                user.LastLoginAt = Clock.GetUtcNow();
                await Users.UpdateAsync(user);
            }
            Nav.NavigateTo(SafeReturnUrl, forceLoad: true);
            return;
        }
        // Pesan sengaja tidak membedakan "username tidak ada" dan "password salah".
        error = result.IsLockedOut ? "Account is temporarily locked due to too many failed attempts. Try again in 15 minutes."
              : result.IsNotAllowed ? "This account is inactive. Please contact the administrator."
              : "Invalid username or password.";
    }

    /// <summary>Hanya URL lokal (mencegah open redirect).</summary>
    private string SafeReturnUrl =>
        ReturnUrl is { Length: > 0 } u && u.StartsWith('/') && !u.StartsWith("//") && !u.StartsWith("/\\") && !u.StartsWith("/account/") ? u : "/";

    private sealed class LoginModel
    {
        [Required(ErrorMessage = "Username is required")] public string UserName { get; set; } = "";
        [Required(ErrorMessage = "Password is required")] public string Password { get; set; } = "";
        public bool RememberMe { get; set; }
    }
}

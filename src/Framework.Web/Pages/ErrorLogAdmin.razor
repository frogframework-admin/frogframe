@page "/admin/error-logs"
@using Framework.Observability
@using Framework.Security
@inject IErrorLogStore ErrorStore
@inject CurrentUser Current
@inject ToastService Toasts
@inject DialogService Dialogs
@inject Framework.Preferences.IUserPreferenceStore UserPrefs
@implements IDisposable

<PageTitle>Error Log · FrogFrame</PageTitle>

@if (!Current.Required.IsAdmin)
{
    <ErrorState StatusCode="403" Description="This administration page is restricted to System Managers / Administrators." />
}
else
{
    <header class="page-head">
        <div>
            <h1>Error Log</h1>
            <p>Unhandled server exceptions across HTTP endpoints, APIs, and background processes.</p>
        </div>
        <div class="row" style="gap:.5rem;flex-wrap:wrap">
            <BbButton Variant="ButtonVariant.Outline" OnClick="BulkMarkSeenAsync" Disabled="@(gridMgr.SelectedCount == 0 || busy)">
                <LucideIcon Name="check" Size="16" /> Mark as Seen @(gridMgr.SelectedCount > 0 ? $"({gridMgr.SelectedCount})" : "")
            </BbButton>
            <BbButton Variant="@(showAllTenants ? ButtonVariant.Secondary : ButtonVariant.Outline)" OnClick="ToggleScopeAsync" Disabled="@busy">
                <LucideIcon Name="@(showAllTenants ? "globe" : "building")" Size="16" />
                @(showAllTenants ? "Scope: All & System" : $"Scope: {Current.Required.TenantId}")
            </BbButton>
            <BbButton Variant="ButtonVariant.Outline" OnClick="ReloadAsync" Disabled="@busy">
                <LucideIcon Name="refresh-cw" Size="16" /> Refresh
            </BbButton>
            <BbButton Variant="ButtonVariant.Destructive" OnClick="ClearAllAsync" Disabled="@(busy || errors.Count == 0)">
                <LucideIcon Name="trash-2" Size="16" /> Clear All
            </BbButton>
        </div>
    </header>

    @if (selectedEntry is not null)
    {
        <BbCard Class="props-block" style="margin-bottom:1.5rem">
            <BbCardHeader>
                <div class="row" style="justify-content:space-between;align-items:center;width:100%">
                    <BbCardTitle Class="card-title">
                        <LucideIcon Name="alert-circle" Size="18" /> Error Details
                    </BbCardTitle>
                    <BbButton Size="ButtonSize.Small" Variant="ButtonVariant.Ghost" OnClick="() => selectedEntry = null">
                        <LucideIcon Name="x" Size="16" /> Close
                    </BbButton>
                </div>
            </BbCardHeader>
            <BbCardContent>
                <div class="stack" style="gap:1rem">
                    <div class="row" style="gap:2rem">
                        <div>
                            <span style="font-size:0.75rem;color:var(--text-muted);text-transform:uppercase">Time</span>
                            <div><strong>@selectedEntry.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</strong></div>
                        </div>
                        <div>
                            <span style="font-size:0.75rem;color:var(--text-muted);text-transform:uppercase">Request</span>
                            <div><code>@selectedEntry.Method @selectedEntry.Path</code></div>
                        </div>
                        <div>
                            <span style="font-size:0.75rem;color:var(--text-muted);text-transform:uppercase">User</span>
                            <div>@(string.IsNullOrWhiteSpace(selectedEntry.UserId) ? "Anonymous" : selectedEntry.UserId)</div>
                        </div>
                        <div>
                            <span style="font-size:0.75rem;color:var(--text-muted);text-transform:uppercase">Type</span>
                            <div><code>@selectedEntry.ErrorType</code></div>
                        </div>
                    </div>

                    <div>
                        <span style="font-size:0.75rem;color:var(--text-muted);text-transform:uppercase">Message</span>
                        <div style="background:var(--bg-muted);padding:.75rem 1rem;border-radius:6px;font-family:monospace;font-size:0.875rem;color:var(--color-destructive);margin-top:.25rem">
                            @selectedEntry.Message
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(selectedEntry.StackTrace))
                    {
                        <div>
                            <span style="font-size:0.75rem;color:var(--text-muted);text-transform:uppercase">Stack Trace</span>
                            <pre style="background:var(--bg-muted);padding:1rem;border-radius:6px;font-size:0.75rem;overflow-x:auto;max-height:24rem;line-height:1.4;margin-top:.25rem">@selectedEntry.StackTrace</pre>
                        </div>
                    }

                    <div class="row" style="justify-content:flex-end;gap:.5rem;margin-top:.5rem">
                        @if (!selectedEntry.Seen)
                        {
                            <BbButton Size="ButtonSize.Small" Variant="ButtonVariant.Outline" OnClick="() => MarkSeenAsync(selectedEntry)">
                                <LucideIcon Name="check" Size="14" /> Mark as Seen
                            </BbButton>
                        }
                    </div>
                </div>
            </BbCardContent>
        </BbCard>
    }

    <BbDataGrid @key="gridMgr.RenderKey"
                TData="ErrorLogEntry"
                Items="@errors"
                ShowSearch="true"
                SearchPlaceholder="Search error logs..."
                ShowPagination="true"
                InitialPageSize="15"
                TableContainerClass="table-wrap"
                RowClass="@(r => selectedEntry?.Id == r.Id || gridMgr.IsSelected(r) ? "selected" : "")"
                Resizable="true"
                OnColumnResize="gridMgr.HandleResize"
                StateChanged="gridMgr.HandleStateChanged">
        <Toolbar>
            <AdminGridToolbar TData="ErrorLogEntry" Grid="gridMgr" Items="@errors" FileName="error-logs" Columns="@ExportColumns" />
        </Toolbar>
        <Columns>
            <AdminGridSelectColumn TData="ErrorLogEntry" Grid="gridMgr" Items="@errors" />

            <BbDataGridPropertyColumn TData="ErrorLogEntry" TProp="DateTimeOffset" Property="r => r.Timestamp" Id="timestamp" Title="Timestamp"
                                      Width="@gridMgr.GetWidth("timestamp", "13rem")" Visible="@gridMgr.IsVisible("timestamp")" Resizable="true" Sortable="true">
                <CellTemplate Context="item">
                    @item.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
                </CellTemplate>
            </BbDataGridPropertyColumn>

            <BbDataGridPropertyColumn TData="ErrorLogEntry" TProp="string" Property="r => r.TenantId" Id="tenant" Title="Tenant"
                                      Width="@gridMgr.GetWidth("tenant", "7rem")" Visible="@gridMgr.IsVisible("tenant")" Resizable="true" Sortable="true" Filterable="true">
                <CellTemplate Context="item">
                    <BbBadge Variant="BadgeVariant.Secondary">@item.TenantId</BbBadge>
                </CellTemplate>
            </BbDataGridPropertyColumn>

            <BbDataGridPropertyColumn TData="ErrorLogEntry" TProp="string" Property="r => r.Method" Id="method" Title="Method"
                                      Width="@gridMgr.GetWidth("method", "6rem")" Visible="@gridMgr.IsVisible("method")" Resizable="true" Sortable="true">
                <CellTemplate Context="item">
                    <BbBadge Variant="BadgeVariant.Outline">@item.Method</BbBadge>
                </CellTemplate>
            </BbDataGridPropertyColumn>

            <BbDataGridPropertyColumn TData="ErrorLogEntry" TProp="string" Property="r => r.Path" Id="path" Title="Path"
                                      Width="@gridMgr.GetWidth("path", "14rem")" Visible="@gridMgr.IsVisible("path")" Resizable="true" Sortable="true" Filterable="true">
                <CellTemplate Context="item">
                    <code>@item.Path</code>
                </CellTemplate>
            </BbDataGridPropertyColumn>

            <BbDataGridPropertyColumn TData="ErrorLogEntry" TProp="string" Property="r => r.ErrorType" Id="error_type" Title="Error Type"
                                      Width="@gridMgr.GetWidth("error_type", "16rem")" Visible="@gridMgr.IsVisible("error_type")" Resizable="true" Sortable="true" Filterable="true">
                <CellTemplate Context="item">
                    <span style="font-weight:600;font-size:0.825rem">@item.ErrorType.Split('.').Last()</span>
                </CellTemplate>
            </BbDataGridPropertyColumn>

            <BbDataGridPropertyColumn TData="ErrorLogEntry" TProp="string" Property="r => r.Message" Id="message" Title="Message"
                                      Width="@gridMgr.GetWidth("message")" Visible="@gridMgr.IsVisible("message")" Resizable="true">
                <CellTemplate Context="item">
                    <span style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;text-overflow:ellipsis">
                        @item.Message
                    </span>
                </CellTemplate>
            </BbDataGridPropertyColumn>

            <BbDataGridTemplateColumn TData="ErrorLogEntry" Id="status" Title="Status"
                                      Width="@gridMgr.GetWidth("status", "7rem")" Visible="@gridMgr.IsVisible("status")" Resizable="true" Sortable="true" SortBy="r => r.Seen">
                <ChildContent Context="item">
                    @if (item.Seen)
                    {
                        <BbBadge Variant="BadgeVariant.Soft">Seen</BbBadge>
                    }
                    else
                    {
                        <BbBadge Variant="BadgeVariant.Destructive">New</BbBadge>
                    }
                </ChildContent>
            </BbDataGridTemplateColumn>

            <BbDataGridTemplateColumn TData="ErrorLogEntry" Id="action" Title="Action" Width="@gridMgr.GetWidth("action", "8rem")" Hideable="false" Resizable="false">
                <ChildContent Context="item">
                    <BbButton Size="ButtonSize.Small" Variant="ButtonVariant.Ghost" OnClick="() => SelectEntry(item)">
                        <LucideIcon Name="eye" Size="14" /> View
                    </BbButton>
                </ChildContent>
            </BbDataGridTemplateColumn>
        </Columns>
    </BbDataGrid>
}

@code {
    private List<ErrorLogEntry> errors = [];
    private ErrorLogEntry? selectedEntry;
    private bool busy;
    private Framework.Web.Services.DataGridPreferenceManager<ErrorLogEntry> gridMgr = default!;

    private static readonly IReadOnlyList<GridExportColumn<ErrorLogEntry>> ExportColumns =
    [
        new("timestamp", "Timestamp", r => r.Timestamp),
        new("tenant", "Tenant", r => r.TenantId),
        new("method", "Method", r => r.Method),
        new("path", "Path", r => r.Path),
        new("error_type", "Error Type", r => r.ErrorType),
        new("message", "Message", r => r.Message),
        new("status", "Status", r => r.Seen ? "Seen" : "New")
    ];

    private bool showAllTenants = true;

    protected override async Task OnInitializedAsync()
    {
        gridMgr = new(UserPrefs, Current, "grid:admin:errors", StateHasChanged);
        await gridMgr.InitializeAsync();
        await ReloadAsync();
    }

    private async Task ToggleScopeAsync()
    {
        showAllTenants = !showAllTenants;
        await ReloadAsync();
    }

    private async Task ResetColumnsLayout()
    {
        await gridMgr.ResetAsync();
        Toasts.Success("Column layout has been reset to default.", "Reset Columns");
    }

    public void Dispose()
    {
        gridMgr?.Dispose();
    }

    private async Task ReloadAsync()
    {
        busy = true;
        try
        {
            var list = await ErrorStore.GetRecentAsync(showAllTenants ? null : Current.Required.TenantId, 100);
            errors = list.ToList();
            gridMgr.RetainSelection(errors);
        }
        catch (Exception ex)
        {
            Toasts.Error(ex.Message, "Failed to load error logs");
        }
        finally
        {
            busy = false;
        }
    }

    private async Task BulkMarkSeenAsync()
    {
        var selected = gridMgr.GetSelectedItems(errors);
        if (selected.Count == 0 || busy) return;
        busy = true;
        try
        {
            int count = 0;
            foreach (var entry in selected)
            {
                if (!entry.Seen)
                {
                    await ErrorStore.MarkSeenAsync(entry.Id, null);
                    count++;
                }
                gridMgr.SelectedIds.Remove(entry.Id.ToString());
            }
            await ReloadAsync();
            Toasts.Success($"Marked {count} error(s) as seen.", "Error Log");
        }
        catch (Exception ex)
        {
            Toasts.Error(ex.Message, "Failed to update errors");
        }
        finally { busy = false; }
    }

    private void SelectEntry(ErrorLogEntry entry)
    {
        selectedEntry = entry;
    }

    private async Task MarkSeenAsync(ErrorLogEntry entry)
    {
        try
        {
            await ErrorStore.MarkSeenAsync(entry.Id, null);
            var idx = errors.FindIndex(e => e.Id == entry.Id);
            if (idx >= 0)
            {
                errors[idx] = errors[idx] with { Seen = true };
            }
            if (selectedEntry?.Id == entry.Id)
            {
                selectedEntry = selectedEntry with { Seen = true };
            }
            Toasts.Success("Marked error as seen.", "Updated");
        }
        catch (Exception ex)
        {
            Toasts.Error(ex.Message, "Failed to update error");
        }
    }

    private async Task ClearAllAsync()
    {
        var scopeDesc = showAllTenants ? "all tenants and system processes" : $"tenant '{Current.Required.TenantId}'";
        var res = await Dialogs.ConfirmAsync(
            "Clear error logs?",
            $"All recorded error logs for {scopeDesc} will be permanently deleted. This action cannot be undone.",
            new ConfirmDialogOptions { Destructive = true, ConfirmText = "Clear Logs", CancelText = "Cancel" });

        if (!res.Confirmed) return;

        busy = true;
        try
        {
            await ErrorStore.ClearAsync(showAllTenants ? null : Current.Required.TenantId);
            selectedEntry = null;
            await ReloadAsync();
            Toasts.Success("Error logs cleared successfully.", "Cleared");
        }
        catch (Exception ex)
        {
            Toasts.Error(ex.Message, "Failed to clear logs");
        }
        finally
        {
            busy = false;
        }
    }
}


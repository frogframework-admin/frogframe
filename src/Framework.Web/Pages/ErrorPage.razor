@page "/error"
@page "/error/{StatusCode:int}"
@page "/404"
@page "/401"
@page "/403"
@page "/500"
@page "/not-found"
@page "/unauthorized"
@page "/forbidden"
@page "/access-denied"
@inject NavigationManager Nav

<PageTitle>@PageHeading · DocFrame</PageTitle>

<ErrorState StatusCode="@EffectiveStatusCode"
            Title="@Title"
            Description="@Message"
            RequestedPath="@Path" />

@code {
    [Parameter] public int? StatusCode { get; set; }

    [SupplyParameterFromQuery(Name = "code")]
    public int? QueryCode { get; set; }

    [SupplyParameterFromQuery(Name = "title")]
    public string? Title { get; set; }

    [SupplyParameterFromQuery(Name = "message")]
    public string? Message { get; set; }

    [SupplyParameterFromQuery(Name = "path")]
    public string? Path { get; set; }

    private int EffectiveStatusCode
    {
        get
        {
            if (StatusCode is > 0) return StatusCode.Value;
            if (QueryCode is > 0) return QueryCode.Value;

            var rel = Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].Trim('/').ToLowerInvariant();
            return rel switch
            {
                "401" or "unauthorized" => 401,
                "403" or "forbidden" or "access-denied" => 403,
                "500" => 500,
                _ => 404
            };
        }
    }

    private string PageHeading => EffectiveStatusCode switch
    {
        400 => "400 Bad Request",
        401 => "401 Authentication Required",
        403 => "403 Access Denied",
        404 => "404 Page Not Found",
        429 => "429 Too Many Requests",
        500 => "500 Internal Server Error",
        503 => "503 Service Unavailable",
        var code => $"Error {code}"
    };
}


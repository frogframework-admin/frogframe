@page "/admin/webhooks"
@using Framework.Integrations
@using Framework.Metadata
@using Framework.Security
@using Framework.Jobs
@using Framework.Web.Services
@inject WebhookService WebhookService
@inject IWebhookStore WebhookStore
@inject IMetadataProvider Metadata
@inject CurrentUser Current
@inject ToastService Toasts
@inject DialogService Dialogs
@inject TimeProvider Clock
@inject Framework.Preferences.IUserPreferenceStore UserPrefs
@implements IDisposable

<PageTitle>Webhooks · FrogFrame</PageTitle>

@if (!Current.Required.IsAdmin)
{
    <ErrorState StatusCode="403" Description="This administration page is restricted to System Managers / Administrators." />
}
else
{
    <header class="page-head">
        <div>
            <h1>Outbound Webhooks</h1>
            <p>Dispatch real-time HMAC-signed HTTP notifications to external endpoints on document lifecycle events and workflow transitions.</p>
        </div>
        <div class="row" style="gap:.5rem">
            <BbButton OnClick="StartCreate"><LucideIcon Name="plus" Size="16" /> New Webhook</BbButton>
        </div>
    </header>

    @if (error is not null)
    {
        <BbAlert Variant="AlertVariant.Danger"><BbAlertDescription>@error</BbAlertDescription></BbAlert>
    }

    @if (!string.IsNullOrEmpty(newlyGeneratedSecret))
    {
        <div style="margin-bottom:1.5rem">
            <BbAlert Variant="AlertVariant.Success">
                <BbAlertTitle>Webhook Signing Secret Generated</BbAlertTitle>
                <BbAlertDescription>
                    <p style="margin-bottom:.5rem">Copy this secret now. For security purposes, it will not be displayed again:</p>
                    <div style="display:flex;align-items:center;gap:.5rem;background:var(--bb-bg-muted);padding:.5rem;border-radius:.375rem;font-family:monospace;font-size:.875rem;">
                        <span style="flex:1;word-break:break-all;">@newlyGeneratedSecret</span>
                        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="@(() => CopyToClipboard(newlyGeneratedSecret))">
                            <LucideIcon Name="copy" Size="14" /> Copy
                        </BbButton>
                    </div>
                </BbAlertDescription>
            </BbAlert>
        </div>
    }

    <!-- Filter Bar -->
    <div class="props-row" style="margin-bottom:1rem;gap:1rem;align-items:center;">
        <div style="min-width:14rem">
            <BbSelect TValue="string" Value="@filterDocType" ValueChanged="OnFilterDocTypeChanged" AriaLabel="Filter DocType" Options="DocTypeFilterOptions" />
        </div>
    </div>

    <!-- Data Grid of Webhooks -->
    <BbDataGrid @key="gridMgr.RenderKey"
                TData="WebhookDef"
                Items="@filteredWebhooks"
                ShowSearch="true"
                SearchPlaceholder="Search webhook name, doctype, or url..."
                ShowPagination="true"
                InitialPageSize="10"
                TableContainerClass="table-wrap"
                Resizable="true"
                OnColumnResize="gridMgr.HandleResize"
                StateChanged="gridMgr.HandleStateChanged">
        <Toolbar>
            <div style="display:flex;align-items:center;gap:.5rem;margin-left:auto">
                @if (gridMgr.HasCustomLayout)
                {
                    <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" OnClick="ResetColumnsLayout" Title="Reset column layout to default">
                        <LucideIcon Name="rotate-ccw" Size="14" />
                        <span>Reset Columns</span>
                    </BbButton>
                }
                <BbDataGridColumnVisibility TData="WebhookDef" />
            </div>
        </Toolbar>
        <Columns>
            <BbDataGridPropertyColumn TData="WebhookDef" TProp="string" Property="w => w.Name" Id="name" Title="Name"
                                      Width="@gridMgr.GetWidth("name", "16rem")" Visible="@gridMgr.IsVisible("name")" Resizable="true" Sortable="true" Filterable="true">
                <CellTemplate Context="w">
                    <span style="font-weight:600">@w.Name</span>
                </CellTemplate>
            </BbDataGridPropertyColumn>

            <BbDataGridPropertyColumn TData="WebhookDef" TProp="string" Property="w => w.DocType" Id="doctype" Title="DocType"
                                      Width="@gridMgr.GetWidth("doctype", "12rem")" Visible="@gridMgr.IsVisible("doctype")" Resizable="true" Sortable="true" Filterable="true">
                <CellTemplate Context="w">
                    <BbBadge Variant="BadgeVariant.Secondary">@w.DocType</BbBadge>
                </CellTemplate>
            </BbDataGridPropertyColumn>

            <BbDataGridPropertyColumn TData="WebhookDef" TProp="string" Property='w => string.Join(", ", w.Events)' Id="events" Title="Events"
                                      Width="@gridMgr.GetWidth("events", "14rem")" Visible="@gridMgr.IsVisible("events")" Resizable="true" Sortable="true">
                <CellTemplate Context="w">
                    <span style="font-size:.8125rem;color:var(--bb-text-muted)">@string.Join(", ", w.Events)</span>
                </CellTemplate>
            </BbDataGridPropertyColumn>

            <BbDataGridPropertyColumn TData="WebhookDef" TProp="string" Property="w => w.Url" Id="url" Title="Destination URL"
                                      Width="@gridMgr.GetWidth("url", "22rem")" Visible="@gridMgr.IsVisible("url")" Resizable="true" Sortable="true">
                <CellTemplate Context="w">
                    <span style="font-family:monospace;font-size:.8125rem;overflow:hidden;text-overflow:ellipsis;display:inline-block;max-width:20rem" title="@w.Url">@w.Url</span>
                </CellTemplate>
            </BbDataGridPropertyColumn>

            <BbDataGridPropertyColumn TData="WebhookDef" TProp="bool" Property="w => w.IsActive" Id="status" Title="Status"
                                      Width="@gridMgr.GetWidth("status", "8rem")" Visible="@gridMgr.IsVisible("status")" Resizable="true" Sortable="true">
                <CellTemplate Context="w">
                    @if (w.IsActive)
                    {
                        <BbBadge Variant="BadgeVariant.SoftSuccess">Active</BbBadge>
                    }
                    else
                    {
                        <BbBadge Variant="BadgeVariant.Secondary">Inactive</BbBadge>
                    }
                </CellTemplate>
            </BbDataGridPropertyColumn>

            <BbDataGridTemplateColumn TData="WebhookDef" Id="actions" Title="Actions" Width="14rem">
                <ChildContent Context="w">
                    <div class="row" style="gap:.35rem">
                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" OnClick="@(() => OpenDeliveriesDrawer(w))" Title="Delivery Logs">
                            <LucideIcon Name="history" Size="14" /> Logs
                        </BbButton>
                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" OnClick="@(() => SendTestPing(w))" Title="Send Test Ping">
                            <LucideIcon Name="send" Size="14" /> Ping
                        </BbButton>
                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" OnClick="@(() => StartEdit(w))" Title="Edit Webhook">
                            <LucideIcon Name="pencil" Size="14" />
                        </BbButton>
                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" OnClick="@(() => ConfirmDelete(w))" Title="Delete Webhook">
                            <LucideIcon Name="trash" Size="14" />
                        </BbButton>
                    </div>
                </ChildContent>
            </BbDataGridTemplateColumn>
        </Columns>
    </BbDataGrid>
}

<!-- Create / Edit Webhook Drawer -->
<AdminDrawer Open="@isDrawerOpen"
             OpenChanged="OnDrawerOpenChanged"
             Title="@(isEditing ? "Edit Webhook" : "New Webhook")"
             WidthScale="1.8">
    <ChildContent>
        @if (dialogError is not null)
        {
            <div style="margin-bottom:1rem">
                <BbAlert Variant="AlertVariant.Danger"><BbAlertDescription>@dialogError</BbAlertDescription></BbAlert>
            </div>
        }

        <div style="display:flex;flex-direction:column;gap:1.25rem">
            <div>
                <label class="form-label" style="display:block;margin-bottom:.35rem;font-weight:600">Webhook Name</label>
                <BbInput @bind-Value="editName" Placeholder="e.g. ERP Purchase Request Sync" />
            </div>

            <div>
                <label class="form-label" style="display:block;margin-bottom:.35rem;font-weight:600">DocType</label>
                <BbSelect TValue="string" @bind-Value="editDocType" Options="DocTypeOptions" />
            </div>

            <div>
                <label class="form-label" style="display:block;margin-bottom:.35rem;font-weight:600">Events (comma-separated or select)</label>
                <div style="display:flex;flex-wrap:wrap;gap:.5rem;margin-bottom:.5rem">
                    @foreach (var ev in CommonEvents)
                    {
                        var isChecked = editEvents.Contains(ev);
                        <BbButton Variant="@(isChecked ? ButtonVariant.Default : ButtonVariant.Outline)"
                                  Size="ButtonSize.Small"
                                  OnClick="@(() => ToggleEvent(ev))">
                            @ev
                        </BbButton>
                    }
                </div>
                <BbInput @bind-Value="editEventsRaw" Placeholder="e.g. document.inserted, document.submit" />
                <span class="hint" style="font-size:.75rem;color:var(--bb-text-muted)">Selected events will trigger this webhook.</span>
            </div>

            <div>
                <label class="form-label" style="display:block;margin-bottom:.35rem;font-weight:600">Destination URL</label>
                <BbInput @bind-Value="editUrl" Placeholder="https://api.example.com/webhooks/frogframe" />
                <span class="hint" style="font-size:.75rem;color:var(--bb-text-muted)">Must be an absolute HTTPS URL. Private IP ranges and loopback are blocked.</span>
            </div>

            <div>
                <label class="form-label" style="display:block;margin-bottom:.35rem;font-weight:600">Condition Expression (Optional)</label>
                <BbInput @bind-Value="editCondition" Placeholder="e.g. doc.total_amount > 10000000" />
                <span class="hint" style="font-size:.75rem;color:var(--bb-text-muted)">Leave empty to trigger on all matching events. Evaluated with expression engine.</span>
            </div>

            <div>
                <label class="form-label" style="display:block;margin-bottom:.35rem;font-weight:600">Custom Headers (JSON, Optional)</label>
                <BbTextarea @bind-Value="editHeadersJson" Rows="3" Placeholder='{ "Authorization": "Bearer token123", "X-Custom": "val" }' />
            </div>

            <div>
                <label class="form-label" style="display:block;margin-bottom:.35rem;font-weight:600">Fields to Include (Optional)</label>
                <BbInput @bind-Value="editFieldsRaw" Placeholder="e.g. name, total_amount, vendor, request_date" />
                <span class="hint" style="font-size:.75rem;color:var(--bb-text-muted)">Leave empty to send all standard PermLevel 0 fields.</span>
            </div>

            @if (isEditing)
            {
                <div style="background:var(--bb-bg-muted);padding:.75rem;border-radius:.375rem;">
                    <div style="display:flex;align-items:center;justify-content:space-between">
                        <div>
                            <span style="font-weight:600;display:block">Signing Secret</span>
                            <span style="font-size:.8125rem;color:var(--bb-text-muted)">Protected by ASP.NET Data Protection.</span>
                        </div>
                        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="RegenerateSecret">
                            <LucideIcon Name="refresh-cw" Size="14" /> Regenerate
                        </BbButton>
                    </div>
                </div>
            }

            <div style="display:flex;align-items:center;gap:.75rem">
                <BbSwitch @bind-Value="editIsActive" Id="webhook-is-active" />
                <label for="webhook-is-active" style="cursor:pointer;font-weight:500">Active</label>
            </div>
        </div>
    </ChildContent>
    <FooterContent>
        <div style="display:flex;justify-content:flex-end;gap:.5rem;width:100%">
            <BbButton Variant="ButtonVariant.Ghost" OnClick="CloseDrawer">Cancel</BbButton>
            <BbButton OnClick="SaveWebhook">Save Webhook</BbButton>
        </div>
    </FooterContent>
</AdminDrawer>

<!-- Delivery Logs Drawer -->
<AdminDrawer Open="@isLogsDrawerOpen"
             OpenChanged="OnLogsDrawerOpenChanged"
             Title="@($"Deliveries · {activeWebhookLogs?.Name}")"
             WidthScale="2.0">
    <ChildContent>
        @if (deliveries.Count == 0)
        {
            <div style="text-align:center;padding:2rem;color:var(--bb-text-muted)">
                <LucideIcon Name="inbox" Size="32" style="margin-bottom:.5rem;opacity:.5" />
                <p>No deliveries recorded for this webhook yet.</p>
            </div>
        }
        else
        {
            <div style="display:flex;flex-direction:column;gap:.75rem">
                @foreach (var del in deliveries)
                {
                    <div style="border:1px solid var(--bb-border);border-radius:.375rem;padding:.75rem;background:var(--bb-bg-card)">
                        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:.35rem">
                            <div style="display:flex;align-items:center;gap:.5rem">
                                @if (del.Status == WebhookDeliveryStatus.Sent)
                                {
                                    <BbBadge Variant="BadgeVariant.SoftSuccess">HTTP @del.LastStatusCode</BbBadge>
                                }
                                else if (del.Status == WebhookDeliveryStatus.Failed)
                                {
                                    <BbBadge Variant="BadgeVariant.Warning">Failed (Attempt @del.Attempts)</BbBadge>
                                }
                                else if (del.Status == WebhookDeliveryStatus.Dead)
                                {
                                    <BbBadge Variant="BadgeVariant.Destructive">Dead (HTTP @(del.LastStatusCode?.ToString() ?? "Error"))</BbBadge>
                                }
                                else
                                {
                                    <BbBadge Variant="BadgeVariant.Secondary">@del.Status</BbBadge>
                                }
                                <span style="font-weight:600;font-size:.875rem">@del.EventType</span>
                                <span style="font-size:.8125rem;color:var(--bb-text-muted)">(@del.DocName)</span>
                            </div>
                            <div style="display:flex;align-items:center;gap:.5rem">
                                <span style="font-size:.75rem;color:var(--bb-text-muted)">@(del.DurationMs.HasValue ? $"{del.DurationMs}ms · " : "")@del.CreatedAt.ToLocalTime().ToString("g")</span>
                                <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" OnClick="@(() => ResendDelivery(del.Id))" Title="Resend delivery">
                                    <LucideIcon Name="repeat" Size="14" /> Resend
                                </BbButton>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(del.LastError))
                        {
                            <div style="font-size:.8125rem;color:var(--bb-destructive);margin-bottom:.35rem;font-family:monospace">
                                @del.LastError
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(del.ResponseSnippet))
                        {
                            <div style="font-size:.75rem;color:var(--bb-text-muted);background:var(--bb-bg-muted);padding:.35rem .5rem;border-radius:.25rem;font-family:monospace;white-space:pre-wrap;max-height:4rem;overflow:hidden">
                                @del.ResponseSnippet
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </ChildContent>
    <FooterContent>
        <div style="display:flex;justify-content:flex-end;width:100%">
            <BbButton Variant="ButtonVariant.Ghost" OnClick="CloseLogsDrawer">Close</BbButton>
        </div>
    </FooterContent>
</AdminDrawer>

@code {
    private List<WebhookDef> webhooks = [];
    private List<WebhookDelivery> deliveries = [];
    private string filterDocType = "";
    private string? error;
    private string? dialogError;
    private string? newlyGeneratedSecret;

    private bool isDrawerOpen;
    private bool isLogsDrawerOpen;
    private bool isEditing;
    private string? editingId;
    private WebhookDef? activeWebhookLogs;

    // Form fields
    private string editName = "";
    private string editDocType = "";
    private HashSet<string> editEvents = [];
    private string editEventsRaw = "";
    private string editUrl = "";
    private string? editCondition;
    private string editHeadersJson = "";
    private string editFieldsRaw = "";
    private bool editIsActive = true;
    private bool regenerateSecretRequested = false;

    private static readonly string[] CommonEvents =
    [
        EventTypes.DocumentInserted,
        EventTypes.DocumentUpdated,
        EventTypes.DocumentDeleted,
        EventTypes.DocumentSubmit,
        EventTypes.DocumentCancel,
        EventTypes.WorkflowTransitioned
    ];

    private IEnumerable<WebhookDef> filteredWebhooks =>
        webhooks.Where(w => string.IsNullOrEmpty(filterDocType) || string.Equals(w.DocType, filterDocType, StringComparison.OrdinalIgnoreCase));

    private IReadOnlyList<SelectOption<string>> DocTypeFilterOptions =>
        new[] { new SelectOption<string>("", "All DocTypes") }
            .Concat(Metadata.Current.DocTypes.Values
                .Where(d => !d.Def.IsChild)
                .OrderBy(d => d.Title)
                .Select(d => new SelectOption<string>(d.Name, d.Title)))
            .ToList();

    private IReadOnlyList<SelectOption<string>> DocTypeOptions =>
        Metadata.Current.DocTypes.Values
            .Where(d => !d.Def.IsChild)
            .OrderBy(d => d.Title)
            .Select(d => new SelectOption<string>(d.Name, d.Title))
            .ToList();

    private DataGridPreferenceManager<WebhookDef> gridMgr = default!;

    protected override async Task OnInitializedAsync()
    {
        gridMgr = new DataGridPreferenceManager<WebhookDef>(
            UserPrefs,
            Current,
            "grid:admin:webhooks",
            StateHasChanged
        );
        await gridMgr.InitializeAsync();
        await LoadWebhooksAsync();
    }

    private async Task LoadWebhooksAsync()
    {
        try
        {
            var res = await WebhookService.ListAsync(Current.Required);
            webhooks = res.ToList();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private void OnFilterDocTypeChanged(string docType)
    {
        filterDocType = docType;
    }

    private void OnDrawerOpenChanged(bool open) => isDrawerOpen = open;
    private void CloseDrawer() => isDrawerOpen = false;

    private void OnLogsDrawerOpenChanged(bool open) => isLogsDrawerOpen = open;
    private void CloseLogsDrawer() => isLogsDrawerOpen = false;

    private void StartCreate()
    {
        isEditing = false;
        editingId = null;
        dialogError = null;
        newlyGeneratedSecret = null;
        regenerateSecretRequested = false;

        editName = "";
        editDocType = DocTypeOptions.FirstOrDefault()?.Value ?? "";
        editEvents = [EventTypes.DocumentInserted];
        editEventsRaw = EventTypes.DocumentInserted;
        editUrl = "";
        editCondition = "";
        editHeadersJson = "";
        editFieldsRaw = "";
        editIsActive = true;

        isDrawerOpen = true;
    }

    private void StartEdit(WebhookDef w)
    {
        isEditing = true;
        editingId = w.Id;
        dialogError = null;
        newlyGeneratedSecret = null;
        regenerateSecretRequested = false;

        editName = w.Name;
        editDocType = w.DocType;
        editEvents = new HashSet<string>(w.Events, StringComparer.OrdinalIgnoreCase);
        editEventsRaw = string.Join(", ", w.Events);
        editUrl = w.Url;
        editCondition = w.Condition ?? "";
        editHeadersJson = w.Headers.Count > 0 ? System.Text.Json.JsonSerializer.Serialize(w.Headers) : "";
        editFieldsRaw = string.Join(", ", w.Fields);
        editIsActive = w.IsActive;

        isDrawerOpen = true;
    }

    private void ToggleEvent(string ev)
    {
        if (editEvents.Contains(ev))
            editEvents.Remove(ev);
        else
            editEvents.Add(ev);

        editEventsRaw = string.Join(", ", editEvents);
    }

    private void RegenerateSecret()
    {
        regenerateSecretRequested = true;
        Toasts.Info("New secret will be generated upon saving.", "Webhooks");
    }

    private async Task SaveWebhook()
    {
        dialogError = null;
        try
        {
            var events = editEventsRaw.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Concat(editEvents)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();

            var fields = editFieldsRaw.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();

            Dictionary<string, string>? headers = null;
            if (!string.IsNullOrWhiteSpace(editHeadersJson))
            {
                try
                {
                    headers = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, string>>(editHeadersJson);
                }
                catch (Exception ex)
                {
                    dialogError = $"Invalid headers JSON: {ex.Message}";
                    return;
                }
            }

            string? plainSecret = regenerateSecretRequested || !isEditing ? WebhookService.GenerateSecret() : null;

            var req = new SaveWebhookRequest(
                Id: editingId,
                Name: editName,
                DocType: editDocType,
                Events: events,
                Condition: editCondition,
                Url: editUrl,
                Headers: headers,
                Secret: plainSecret,
                Fields: fields,
                IsActive: editIsActive
            );

            var res = await WebhookService.SaveAsync(Current.Required, req);
            newlyGeneratedSecret = res.PlaintextSecret;

            isDrawerOpen = false;
            Toasts.Success("Webhook saved successfully.", "Webhooks");
            await LoadWebhooksAsync();
        }
        catch (Exception ex)
        {
            dialogError = ex.Message;
        }
    }

    private async Task ConfirmDelete(WebhookDef w)
    {
        var confirmed = await Dialogs.ConfirmAsync("Delete Webhook", $"Are you sure you want to delete webhook '{w.Name}'?");
        if (confirmed.Confirmed)
        {
            try
            {
                await WebhookService.DeleteAsync(Current.Required, w.Id);
                Toasts.Success($"Webhook '{w.Name}' deleted.", "Webhooks");
                await LoadWebhooksAsync();
            }
            catch (Exception ex)
            {
                Toasts.Error($"Failed to delete webhook: {ex.Message}", "Webhooks");
            }
        }
    }

    private async Task OpenDeliveriesDrawer(WebhookDef w)
    {
        activeWebhookLogs = w;
        try
        {
            var list = await WebhookService.ListDeliveriesAsync(Current.Required, w.Id, limit: 50);
            deliveries = list.ToList();
            isLogsDrawerOpen = true;
        }
        catch (Exception ex)
        {
            Toasts.Error($"Failed to load deliveries: {ex.Message}", "Webhooks");
        }
    }

    private async Task ResendDelivery(Guid deliveryId)
    {
        try
        {
            await WebhookService.ResendDeliveryAsync(Current.Required, deliveryId);
            Toasts.Success("Delivery re-enqueued for dispatch.", "Webhooks");
            if (activeWebhookLogs is not null)
            {
                var list = await WebhookService.ListDeliveriesAsync(Current.Required, activeWebhookLogs.Id, limit: 50);
                deliveries = list.ToList();
            }
        }
        catch (Exception ex)
        {
            Toasts.Error($"Failed to resend delivery: {ex.Message}", "Webhooks");
        }
    }

    private async Task SendTestPing(WebhookDef w)
    {
        try
        {
            await WebhookService.SendTestPingAsync(Current.Required, w.Id);
            Toasts.Success($"Test ping enqueued for '{w.Name}'. Check delivery logs.", "Webhooks");
        }
        catch (Exception ex)
        {
            Toasts.Error($"Failed to send test ping: {ex.Message}", "Webhooks");
        }
    }

    private void CopyToClipboard(string text)
    {
        Toasts.Info("Secret copied to clipboard.", "Webhooks");
    }

    private async Task ResetColumnsLayout()
    {
        await gridMgr.ResetAsync();
    }

    public void Dispose()
    {
        gridMgr?.Dispose();
    }
}


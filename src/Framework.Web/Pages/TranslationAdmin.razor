@page "/admin/translations"
@using Framework.Navigation
@inject TranslationCatalog Catalog
@inject IMetadataProvider Metadata
@inject INavigationMenuStore MenuStore
@inject CurrentUser Current
@inject ToastService Toasts
@inject DialogService Dialogs
@inject UiText T

<PageTitle>@T["Translations"] · FrogFrame</PageTitle>

@if (!Current.Required.IsAdmin)
{
    <ErrorState StatusCode="403" Description="@(T["This administration page is restricted to System Managers / Administrators."])" />
}
else
{
    <header class="page-head">
        <div>
            <h1>@T["Translations"]</h1>
            <p>@T["Translate labels, menus and texts for each language. Your translations apply to this tenant and take priority over the dictionaries shipped with the application."]</p>
        </div>
        <div class="row" style="gap:.5rem;align-items:center">
            <span class="muted small">@T["Translate into"]</span>
            <div style="min-width:12rem">
                <BbSelect TValue="string" Value="@language" ValueChanged="OnLanguageChanged" AriaLabel="@(T["Translate into"])"
                          Options="@(Languages.Supported.Select(l => new SelectOption<string>(l.Code, l.Name)))" />
            </div>
        </div>
    </header>

    <BbTabs Value="@tab" ValueChanged="v => tab = v ?? tab">
        <BbTabsList>
            <BbTabsTrigger Value="metadata">@T["Metadata & menus"] (@MissingCount @T["missing"])</BbTabsTrigger>
            <BbTabsTrigger Value="custom">@T["Custom translations"] (@CustomForLanguage.Count)</BbTabsTrigger>
            <BbTabsTrigger Value="io">@T["Import / export"]</BbTabsTrigger>
        </BbTabsList>

        <BbTabsContent Value="metadata">
            <div class="filters" role="search" style="margin:.75rem 0;display:flex;gap:1rem;align-items:flex-end;flex-wrap:wrap">
                <div class="filter search" style="flex:1;min-width:16rem">
                    <span>@T["Search"]</span>
                    <FormTextInput Value="@search" ValueChanged="v => search = v" Immediate="true" Placeholder="@(T["Text or translation…"])" AriaLabel="@(T["Search"])" />
                </div>
                <div style="display:flex;align-items:center;gap:.5rem">
                    <BbSwitch @bind-Value="onlyMissing" Id="tr-only-missing" />
                    <label for="tr-only-missing" style="cursor:pointer">@T["Only untranslated"]</label>
                </div>
            </div>
            @{
                var rows = FilteredRows().ToList();
            }
            <div class="table-wrap">
                <table class="grid">
                    <thead>
                        <tr>
                            <th scope="col" style="width:28%">@T["Text"]</th>
                            <th scope="col" style="width:22%">@T["Used in"]</th>
                            <th scope="col">@T["Translation"] (@language.ToUpperInvariant())</th>
                            <th scope="col" style="width:8rem">@T["Source"]</th>
                            <th scope="col" style="width:6rem"><span class="sr-only">@T["Actions"]</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in rows.Take(MaxRows))
                        {
                            var item = row;
                            var origin = OriginOf(item.Text);
                            <tr>
                                <td>@item.Text</td>
                                <td class="muted small">@item.Where</td>
                                <td>
                                    <FormTextInput Value="@DraftOf(item.Text)" ValueChanged="v => drafts[item.Text] = v ?? string.Empty" AriaLabel="@(T.Format("Translation of {0}", item.Text))" />
                                </td>
                                <td>
                                    @if (origin == Origin.Custom)
                                    {
                                        <BbBadge Variant="BadgeVariant.SoftSuccess">@T["Custom"]</BbBadge>
                                    }
                                    else if (origin == Origin.Shipped)
                                    {
                                        <BbBadge Variant="BadgeVariant.Soft">@T["Application"]</BbBadge>
                                    }
                                    else
                                    {
                                        <BbBadge Variant="BadgeVariant.Warning">@T["Missing"]</BbBadge>
                                    }
                                </td>
                                <td style="text-align:right;white-space:nowrap">
                                    <BbButton Size="ButtonSize.Small" Disabled="@(busy || !IsChanged(item.Text))" OnClick="() => SaveRow(item.Text)">@T["Save"]</BbButton>
                                    @if (origin == Origin.Custom)
                                    {
                                        <BbButton Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" Disabled="busy" OnClick="() => DeleteCustom(item.Text)"
                                                  AriaLabel="@(T["Remove custom translation"])">
                                            <LucideIcon Name="rotate-ccw" Size="14" />
                                        </BbButton>
                                    }
                                </td>
                            </tr>
                        }
                        @if (rows.Count == 0)
                        {
                            <tr><td colspan="5" class="grid-empty">@T["Nothing to translate with these filters."]</td></tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (rows.Count > MaxRows)
            {
                <p class="muted small" style="margin-top:.5rem">@T.Format("Showing {0} of {1}. Use the search to narrow the list.", MaxRows, rows.Count)</p>
            }
        </BbTabsContent>

        <BbTabsContent Value="custom">
            <BbCard Style="margin-top:.75rem">
                <BbCardHeader>
                    <BbCardTitle Class="card-title">@T["Add a translation"]</BbCardTitle>
                    <BbCardDescription>@T["For any text on screen (buttons, messages, menus). Copy the text exactly as it is written in the application; keep placeholders such as {0}."]</BbCardDescription>
                </BbCardHeader>
                <BbCardContent>
                    <div class="row" style="gap:1rem;align-items:flex-end;flex-wrap:wrap">
                        <div style="flex:1;min-width:14rem">
                            <label class="form-label" for="tr-new-source" style="display:block;margin-bottom:.35rem;font-weight:600">@T["Text"]</label>
                            <FormTextInput Id="tr-new-source" Value="@newSource" ValueChanged="v => newSource = v" Placeholder="@(T["e.g. Save draft"])" />
                        </div>
                        <div style="flex:1;min-width:14rem">
                            <label class="form-label" for="tr-new-target" style="display:block;margin-bottom:.35rem;font-weight:600">@T["Translation"] (@language.ToUpperInvariant())</label>
                            <FormTextInput Id="tr-new-target" Value="@newTarget" ValueChanged="v => newTarget = v" />
                        </div>
                        <BbButton Disabled="@(busy || string.IsNullOrWhiteSpace(newSource) || string.IsNullOrWhiteSpace(newTarget))" OnClick="AddCustom">
                            <LucideIcon Name="plus" Size="16" /> @T["Add"]
                        </BbButton>
                    </div>
                </BbCardContent>
            </BbCard>

            <div class="table-wrap" style="margin-top:1rem">
                <table class="grid">
                    <thead>
                        <tr>
                            <th scope="col">@T["Text"]</th>
                            <th scope="col">@T["Translation"]</th>
                            <th scope="col" style="width:12rem">@T["Modified"]</th>
                            <th scope="col" style="width:4rem"><span class="sr-only">@T["Actions"]</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var o in CustomForLanguage)
                        {
                            var source = o.Source;
                            <tr>
                                <td>@o.Source</td>
                                <td>@o.Target</td>
                                <td class="muted small">@o.ModifiedBy · @Fmt.When(o.Modified)</td>
                                <td style="text-align:right">
                                    <BbButton Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" Disabled="busy" OnClick="() => DeleteCustom(source)" AriaLabel="@(T["Delete"])">
                                        <LucideIcon Name="trash-2" Size="14" />
                                    </BbButton>
                                </td>
                            </tr>
                        }
                        @if (CustomForLanguage.Count == 0)
                        {
                            <tr><td colspan="4" class="grid-empty">@T["No custom translations for this language yet."]</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </BbTabsContent>

        <BbTabsContent Value="io">
            <BbCard Style="margin-top:.75rem">
                <BbCardHeader>
                    <BbCardTitle Class="card-title">@T["Export"]</BbCardTitle>
                    <BbCardDescription>@T["The custom translations of this tenant for the selected language, in the format of *.translations.json. Developers can add the file to the application's Metadata folder to ship it to every tenant."]</BbCardDescription>
                </BbCardHeader>
                <BbCardContent>
                    <FormTextArea Value="@ExportJson" Rows="10" AriaLabel="@(T["Export"])" />
                </BbCardContent>
            </BbCard>
            <BbCard Style="margin-top:1rem">
                <BbCardHeader>
                    <BbCardTitle Class="card-title">@T["Import"]</BbCardTitle>
                    <BbCardDescription>@T["Paste a *.translations.json file. Its translations are saved as custom translations of this tenant (existing ones with the same text are replaced)."]</BbCardDescription>
                </BbCardHeader>
                <BbCardContent>
                    <FormTextArea Value="@importJson" ValueChanged="v => importJson = v" Rows="10" MaxLength="2000000" AriaLabel="@(T["Import"])"
                                  Placeholder="@ImportPlaceholder" />
                    <div style="margin-top:.75rem">
                        <BbButton Disabled="@(busy || string.IsNullOrWhiteSpace(importJson))" OnClick="Import">
                            <LucideIcon Name="file-up" Size="16" /> @T["Import"]
                        </BbButton>
                    </div>
                </BbCardContent>
            </BbCard>
        </BbTabsContent>
    </BbTabs>
}

@code {
    private const int MaxRows = 300;
    private const int MaxImport = 5000;
    private const string ImportPlaceholder = "{ \"language\": \"en\", \"translations\": { \"Pemohon\": \"Requester\" } }";

    private enum Origin { Missing, Shipped, Custom }

    private string language = Languages.English;
    private string tab = "metadata";
    private string? search;
    private bool onlyMissing;
    private bool busy;
    private string? newSource, newTarget, importJson;
    private IReadOnlyList<MetadataTexts.Item> texts = [];
    private IReadOnlyList<TranslationOverride> overrides = [];
    private readonly Dictionary<string, string> drafts = new(StringComparer.Ordinal);

    private string Tenant => Current.Required.TenantId;

    private List<TranslationOverride> CustomForLanguage =>
        overrides.Where(o => o.Language == language).OrderBy(o => o.Source, StringComparer.Ordinal).ToList();

    private int MissingCount => texts.Count(t => OriginOf(t.Text) == Origin.Missing);

    protected override async Task OnInitializedAsync()
    {
        if (!Current.Required.IsAdmin) return;
        // Default: the language the users are not seeing the texts in (texts are usually written in Indonesian).
        language = T.Language == Languages.English ? Languages.Indonesian : Languages.English;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var items = MetadataTexts.Collect(Metadata.Current).ToList();
        var modules = await MenuStore.ListModulesAsync(Tenant);
        var groups = await MenuStore.ListGroupsAsync(Tenant);
        var menus = await MenuStore.ListAsync(Tenant);
        var known = items.Select(i => i.Text).ToHashSet(StringComparer.Ordinal);
        void Add(string? text, string where)
        {
            if (string.IsNullOrWhiteSpace(text) || !known.Add(text.Trim())) return;
            items.Add(new MetadataTexts.Item(text.Trim(), where));
        }
        foreach (var m in modules) { Add(m.Name, T["Module"]); Add(m.Description, T["Module"]); }
        foreach (var g in groups) Add(g.Name, T["Menu group"]);
        foreach (var i in menus) Add(i.Title, T["Menu"]);
        texts = items.OrderBy(i => i.Text, StringComparer.Ordinal).ToList();
        overrides = await Catalog.ListOverridesAsync(Tenant);
        drafts.Clear();
    }

    private async Task OnLanguageChanged(string? value)
    {
        language = Languages.Normalize(value) ?? language;
        drafts.Clear();
        await Task.CompletedTask;
    }

    private IEnumerable<MetadataTexts.Item> FilteredRows()
    {
        var q = search?.Trim();
        foreach (var t in texts)
        {
            if (onlyMissing && OriginOf(t.Text) != Origin.Missing) continue;
            if (!string.IsNullOrEmpty(q)
                && !t.Text.Contains(q, StringComparison.OrdinalIgnoreCase)
                && !t.Where.Contains(q, StringComparison.OrdinalIgnoreCase)
                && !EffectiveTranslation(t.Text).Contains(q, StringComparison.OrdinalIgnoreCase)) continue;
            yield return t;
        }
    }

    private Origin OriginOf(string text) =>
        overrides.Any(o => o.Language == language && o.Source == text) ? Origin.Custom
        : Catalog.Shipped(language).ContainsKey(text) ? Origin.Shipped
        : Origin.Missing;

    /// <summary>Translation in effect for this tenant (empty when missing).</summary>
    private string EffectiveTranslation(string text) =>
        Catalog.TryExact(Tenant, language, text, out var target) ? target : "";

    private string DraftOf(string text) => drafts.TryGetValue(text, out var d) ? d : EffectiveTranslation(text);
    private bool IsChanged(string text) => drafts.TryGetValue(text, out var d) && d.Trim() != EffectiveTranslation(text);

    private async Task SaveRow(string text)
    {
        var value = drafts.GetValueOrDefault(text)?.Trim() ?? "";
        busy = true;
        try
        {
            if (value.Length == 0)
            {
                await Catalog.DeleteAsync(Tenant, language, text);
            }
            else
            {
                await Catalog.SaveAsync(Tenant, language, text, value, Current.Required.Id);
            }
            overrides = await Catalog.ListOverridesAsync(Tenant);
            drafts.Remove(text);
            Toasts.Success(T["Translation saved."], T["Translations"]);
        }
        catch (ArgumentException ex) { Toasts.Error(T.Message(ex.Message), T["Translations"]); }
        finally { busy = false; }
    }

    private async Task DeleteCustom(string source)
    {
        busy = true;
        try
        {
            await Catalog.DeleteAsync(Tenant, language, source);
            overrides = await Catalog.ListOverridesAsync(Tenant);
            drafts.Remove(source);
            Toasts.Success(T["Custom translation removed."], T["Translations"]);
        }
        finally { busy = false; }
    }

    private async Task AddCustom()
    {
        busy = true;
        try
        {
            await Catalog.SaveAsync(Tenant, language, newSource!.Trim(), newTarget!.Trim(), Current.Required.Id);
            overrides = await Catalog.ListOverridesAsync(Tenant);
            newSource = newTarget = null;
            Toasts.Success(T["Translation saved."], T["Translations"]);
        }
        catch (ArgumentException ex) { Toasts.Error(T.Message(ex.Message), T["Translations"]); }
        finally { busy = false; }
    }

    private string ExportJson => new TranslationFile
    {
        Language = language,
        Translations = CustomForLanguage.ToDictionary(o => o.Source, o => o.Target, StringComparer.Ordinal),
    }.ToJson();

    private async Task Import()
    {
        TranslationFile file;
        try { file = TranslationFile.Parse(importJson!); }
        catch (Exception ex) when (ex is System.Text.Json.JsonException or ArgumentException or NotSupportedException)
        {
            Toasts.Error(T.Format("The file could not be read: {0}", ex.Message), T["Import"]);
            return;
        }
        if (file.Translations.Count > MaxImport)
        {
            Toasts.Error(T.Format("At most {0} translations can be imported at once.", MaxImport), T["Import"]);
            return;
        }
        var confirm = await Dialogs.ConfirmAsync(T["Import"],
            T.Format("Save {0} translation(s) for {1}?", file.Translations.Count, file.Language.ToUpperInvariant()),
            new ConfirmDialogOptions { ConfirmText = T["Import"], CancelText = T["Cancel"] });
        if (!confirm.Confirmed) return;

        busy = true;
        var saved = 0;
        var skipped = new List<string>();
        try
        {
            foreach (var (source, target) in file.Translations)
            {
                try { await Catalog.SaveAsync(Tenant, file.Language, source, target, Current.Required.Id); saved++; }
                catch (ArgumentException ex) { if (skipped.Count < 5) skipped.Add($"{source}: {T.Message(ex.Message)}"); }
            }
            overrides = await Catalog.ListOverridesAsync(Tenant);
            importJson = null;
            Toasts.Success(T.Format("{0} translation(s) imported.", saved), T["Import"]);
            if (skipped.Count > 0) Toasts.Warning(string.Join("; ", skipped), T["Skipped"]);
        }
        finally { busy = false; }
    }
}

@page "/admin/jobs"
@using Framework.Jobs
@using Framework.Security
@inject ScheduledJobRunner Runner
@inject IScheduledJobLogStore LogStore
@inject CurrentUser Current
@inject ToastService Toasts
@inject Framework.Preferences.IUserPreferenceStore UserPrefs
@implements IDisposable

<PageTitle>Scheduled Jobs · FrogFrame</PageTitle>

@if (!Current.Required.IsAdmin)
{
    <ErrorState StatusCode="403" Description="This administration page is restricted to System Managers / Administrators." />
}
else
{
    <header class="page-head">
        <div>
            <h1>Scheduled Jobs</h1>
            <p>Background tasks executed on cron schedules across tenants with distributed locking and audit history.</p>
        </div>
        <div class="row" style="gap:.5rem">
            <BbButton Variant="ButtonVariant.Outline" OnClick="ReloadRunsAsync" Disabled="@busy">
                <LucideIcon Name="refresh-cw" Size="16" /> Refresh
            </BbButton>
        </div>
    </header>

    <div class="stack" style="gap:2rem">
        <BbCard>
            <BbCardHeader>
                <BbCardTitle Class="card-title">Registered Jobs (@Runner.RegisteredJobs.Count)</BbCardTitle>
            </BbCardHeader>
            <BbCardContent>
                <div class="table-wrap">
                    <table class="table" style="width:100%">
                        <thead>
                            <tr>
                                <th style="text-align:left">Job Name</th>
                                <th style="text-align:left">Schedule</th>
                                <th style="text-align:left">Normalized Cron</th>
                                <th style="text-align:right">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Runner.RegisteredJobs.Count == 0)
                            {
                                <tr>
                                    <td colspan="4" style="text-align:center;color:var(--text-muted);padding:1.5rem">No background jobs registered.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var job in Runner.RegisteredJobs)
                                {
                                    <tr>
                                        <td>
                                            <div class="row" style="gap:.5rem;align-items:center">
                                                <LucideIcon Name="clock" Size="16" />
                                                <strong>@job.Name</strong>
                                            </div>
                                        </td>
                                        <td><code>@job.Schedule</code></td>
                                        <td><span style="color:var(--text-muted)">@CronSchedule.Normalize(job.Schedule)</span></td>
                                        <td style="text-align:right">
                                            <BbButton Size="ButtonSize.Small" Variant="ButtonVariant.Outline"
                                                      OnClick="() => RunJobAsync(job.Name)"
                                                      Disabled="@busy">
                                                <LucideIcon Name="play" Size="14" /> Run Now
                                            </BbButton>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </BbCardContent>
        </BbCard>

        <BbCard>
            <BbCardHeader>
                <BbCardTitle Class="card-title">Recent Execution Runs</BbCardTitle>
            </BbCardHeader>
            <BbCardContent>
                <BbDataGrid @key="gridMgr.RenderKey"
                            TData="ScheduledJobRunEntry"
                            Items="@recentRuns"
                            ShowSearch="true"
                            SearchPlaceholder="Filter job history..."
                            ShowPagination="true"
                            InitialPageSize="15"
                            TableContainerClass="table-wrap"
                            Resizable="true"
                            OnColumnResize="gridMgr.HandleResize"
                            StateChanged="gridMgr.HandleStateChanged">
                    <Toolbar>
                        <div style="display:flex;align-items:center;gap:.5rem;margin-left:auto">
                            @if (gridMgr.HasCustomLayout)
                            {
                                <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" OnClick="ResetColumnsLayout" Title="Reset column layout to default">
                                    <LucideIcon Name="rotate-ccw" Size="14" />
                                    <span>Reset Columns</span>
                                </BbButton>
                            }
                            <BbDataGridColumnVisibility TData="ScheduledJobRunEntry" />
                        </div>
                    </Toolbar>
                    <Columns>
                        <BbDataGridPropertyColumn TData="ScheduledJobRunEntry" TProp="string" Property="r => r.JobName" Id="job_name" Title="Job Name"
                                                  Width="@gridMgr.GetWidth("job_name", "14rem")" Visible="@gridMgr.IsVisible("job_name")" Resizable="true" Sortable="true" Filterable="true">
                            <CellTemplate Context="item">
                                <strong>@item.JobName</strong>
                            </CellTemplate>
                        </BbDataGridPropertyColumn>

                        <BbDataGridPropertyColumn TData="ScheduledJobRunEntry" TProp="string" Property="r => r.TenantId" Id="tenant" Title="Tenant"
                                                  Width="@gridMgr.GetWidth("tenant", "8rem")" Visible="@gridMgr.IsVisible("tenant")" Resizable="true" Sortable="true" Filterable="true" />

                        <BbDataGridPropertyColumn TData="ScheduledJobRunEntry" TProp="DateTimeOffset" Property="r => r.StartedAt" Id="started_at" Title="Started At"
                                                  Width="@gridMgr.GetWidth("started_at", "14rem")" Visible="@gridMgr.IsVisible("started_at")" Resizable="true" Sortable="true">
                            <CellTemplate Context="item">
                                @item.StartedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
                            </CellTemplate>
                        </BbDataGridPropertyColumn>

                        <BbDataGridPropertyColumn TData="ScheduledJobRunEntry" TProp="int?" Property="r => r.DurationMs" Id="duration" Title="Duration"
                                                  Width="@gridMgr.GetWidth("duration", "8rem")" Visible="@gridMgr.IsVisible("duration")" Resizable="true" Sortable="true">
                            <CellTemplate Context="item">
                                @(item.DurationMs.HasValue ? $"{item.DurationMs.Value} ms" : "—")
                            </CellTemplate>
                        </BbDataGridPropertyColumn>

                        <BbDataGridTemplateColumn TData="ScheduledJobRunEntry" Id="status" Title="Status"
                                                  Width="@gridMgr.GetWidth("status", "9rem")" Visible="@gridMgr.IsVisible("status")" Resizable="true" Sortable="true" SortBy="r => r.Status">
                            <ChildContent Context="item">
                                @if (item.Status == "Success")
                                {
                                    <BbBadge Variant="BadgeVariant.Soft">Success</BbBadge>
                                }
                                else if (item.Status == "Failed")
                                {
                                    <BbBadge Variant="BadgeVariant.Destructive">Failed</BbBadge>
                                }
                                else
                                {
                                    <BbBadge Variant="BadgeVariant.Outline">@item.Status</BbBadge>
                                }
                            </ChildContent>
                        </BbDataGridTemplateColumn>

                        <BbDataGridPropertyColumn TData="ScheduledJobRunEntry" TProp="string" Property="r => r.Error" Id="error" Title="Error Message"
                                                  Width="@gridMgr.GetWidth("error")" Visible="@gridMgr.IsVisible("error")" Resizable="true">
                            <CellTemplate Context="item">
                                @if (!string.IsNullOrEmpty(item.Error))
                                {
                                    <span style="color:var(--color-destructive);font-family:monospace;font-size:0.825rem">@item.Error</span>
                                }
                                else
                                {
                                    <span style="color:var(--text-muted)">—</span>
                                }
                            </CellTemplate>
                        </BbDataGridPropertyColumn>
                    </Columns>
                </BbDataGrid>
            </BbCardContent>
        </BbCard>
    </div>
}

@code {
    private List<ScheduledJobRunEntry> recentRuns = [];
    private bool busy;
    private Framework.Web.Services.DataGridPreferenceManager<ScheduledJobRunEntry> gridMgr = default!;

    protected override async Task OnInitializedAsync()
    {
        gridMgr = new(UserPrefs, Current, "grid:admin:jobs", StateHasChanged);
        await gridMgr.InitializeAsync();
        await ReloadRunsAsync();
    }

    private async Task ResetColumnsLayout()
    {
        await gridMgr.ResetAsync();
        Toasts.Success("Column layout has been reset to default.", "Reset Columns");
    }

    public void Dispose()
    {
        gridMgr?.Dispose();
    }

    private async Task ReloadRunsAsync()
    {
        busy = true;
        try
        {
            var runs = await LogStore.GetRecentRunsAsync(Current.Required.TenantId, 100);
            recentRuns = runs.ToList();
        }
        catch (Exception ex)
        {
            Toasts.Error(ex.Message, "Failed to load runs");
        }
        finally
        {
            busy = false;
        }
    }

    private async Task RunJobAsync(string jobName)
    {
        busy = true;
        try
        {
            var result = await Runner.RunJobNowAsync(jobName, Current.Required.TenantId);
            if (result.Status == "Success")
            {
                Toasts.Success($"Job '{jobName}' completed in {result.DurationMs} ms.", "Job Executed");
            }
            else
            {
                Toasts.Error(result.Error ?? "Unknown error", $"Job '{jobName}' Failed");
            }
            await ReloadRunsAsync();
        }
        catch (Exception ex)
        {
            Toasts.Error(ex.Message, $"Execution Failed");
        }
        finally
        {
            busy = false;
        }
    }
}


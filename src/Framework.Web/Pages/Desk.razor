@page "/"
@implements IDisposable
@using Framework.Navigation
@inject DocumentService Docs
@inject CurrentUser Current
@inject IMetadataProvider Metadata
@inject IPermissionService Perms
@inject INavigationMenuStore MenuStore
@inject INotificationStore Notifications
@inject NavigationManager Nav
@inject ToastService Toasts
@inject TimeProvider Clock
@inject UiText T

<PageTitle>@T["Home"] · FrogFrame</PageTitle>

<div class="launcher-page">
    <header class="desk-hero">
        <img class="desk-hero-bg desk-hero-bg-light" src="/_content/Framework.Web/img/desk-hero-light.png" alt="" aria-hidden="true" />
        <img class="desk-hero-bg desk-hero-bg-dark" src="/_content/Framework.Web/img/desk-hero-dark.png" alt="" aria-hidden="true" />
        <div class="desk-hero-content">
            <h1>@T[GreetingText()], @FirstName(Current.Required.FullName)!</h1>
            <p>@T["What would you like to work on today?"]</p>
            <div class="desk-hero-accent" aria-hidden="true"></div>
        </div>
    </header>

    <section class="workspace-summary" aria-label="@(T["My workspace"])">
        <div class="section-head-row">
            <h2>@T["My workspace"]</h2>
        </div>

        <div class="workspace-cards-grid">
            <a class="workspace-stat-card" href="#recent-docs">
                <span>@T["Awaiting your approval / action"]</span>
                <strong class="stat-num primary">@(pending?.Count ?? 0)</strong>
            </a>
            <a class="workspace-stat-card" href="/inbox">
                <span>@T["Tasks & unread notifications"]</span>
                <strong class="stat-num">@unreadCount</strong>
            </a>
        </div>
    </section>

    <section id="recent-docs" class="recent-docs-section" aria-label="@(T["Recent documents"])">
        <div class="section-head-row">
            <h2>@T["Recent documents"]</h2>
            <a class="section-link" href="@SeeAllHref">@T["View all"]</a>
        </div>

        @if (recentDocs is null)
        {
            <div class="stack"><BbSkeleton Height="3rem" /><BbSkeleton Height="3rem" /><BbSkeleton Height="3rem" /></div>
        }
        else if (recentDocs.Count == 0)
        {
            <div class="desk-table-card desk-empty-box">
                @T["No transaction documents recorded yet."]
            </div>
        }
        else
        {
            <div class="desk-table-card">
                <table class="desk-doc-table">
                    <thead>
                        <tr>
                            <th>@T["Document"]</th>
                            <th>@T["Requester / title"]</th>
                            <th class="num">@T["Total"]</th>
                            <th>@T["Status"]</th>
                            <th class="act-col">@T["Available actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var (meta, doc, actions) in recentDocs)
                        {
                            var docHref = $"/app/{meta.Name}/{doc.Name}";
                            var (btnText, isPrimary, btnTooltip) = DescribeAction(actions);
                            <tr class="clickable" @onclick="@(() => Nav.NavigateTo(docHref))">
                                <td>
                                    <a class="doc-code" href="@docHref" @onclick:stopPropagation="true">@doc.Name</a>
                                    <div class="doc-sub">@T.Title(meta)</div>
                                </td>
                                <td class="doc-requester">@ResolveTitle(meta, doc)</td>
                                <td class="num doc-total">@(meta.ByName.TryGetValue("total", out var tf2) ? T.Value(tf2, doc.Get("total")) : "—")</td>
                                <td>
                                    <span class="desk-status-pill @StatusPillClass(meta, doc)">
                                        <span class="dot" aria-hidden="true"></span>
                                        <span>@T.State(doc.WorkflowState, doc.DocStatus)</span>
                                    </span>
                                </td>
                                <td class="act-col" @onclick:stopPropagation="true">
                                    <a class="desk-act-btn @(isPrimary ? "primary" : "outline")" href="@docHref" title="@(T[btnTooltip])">
                                        @T[btnText]
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

@code {
    private IReadOnlyList<(CompiledDocType Meta, Document Doc, IReadOnlyList<string> Actions)>? pending;
    private IReadOnlyList<(CompiledDocType Meta, Document Doc, IReadOnlyList<string> Actions)>? recentDocs;
    private IReadOnlyList<NavigationModule> visibleModules = [];
    private string? activeModuleId;
    private int unreadCount;

    private string SeeAllHref =>
        recentDocs is { Count: > 0 } ? $"/app/{recentDocs[0].Meta.Name}"
        : Metadata.Current.TryGet("PurchaseRequest", out var pr) && Perms.Can(Current.Required, pr, DocActions.Read) ? "/app/PurchaseRequest"
        : "/inbox";

    protected override async Task OnInitializedAsync()
    {
        Current.ModuleChanged += OnModuleChanged;
        MenuStore.Changed += OnMenusChanged;
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        if (Current.User is not { } u) return;
        var allModules = await MenuStore.ListModulesAsync(u.TenantId, onlyActive: true);
        visibleModules = allModules.Where(m => m.IsVisibleFor(u)).OrderBy(m => m.SortOrder).ThenBy(m => m.Name).ToList();

        if (string.IsNullOrWhiteSpace(Current.ActiveModuleId) || !visibleModules.Any(m => m.Id == Current.ActiveModuleId))
        {
            if (visibleModules.Count > 0)
            {
                Current.SetActiveModule(visibleModules[0].Id);
            }
        }
        activeModuleId = Current.ActiveModuleId;

        unreadCount = Notifications.ForUser(u.TenantId, u.Id).Count(n => !n.Read);
        pending = await Docs.PendingActionsAsync(u);
        var recent = await Docs.RecentDocumentsAsync(u, limit: 6);

        // Merge pending actions and recent documents without duplicates, ordered by newest document name/modification.
        var combined = pending
            .Concat(recent)
            .GroupBy(x => (x.Meta.Name, x.Doc.Name))
            .Select(g => g.First())
            .OrderByDescending(x => x.Doc.Modified)
            .ThenByDescending(x => x.Doc.Name)
            .Take(6)
            .ToList();
        recentDocs = combined;
    }

    private void OnModuleChanged()
    {
        activeModuleId = Current.ActiveModuleId;
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnMenusChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await LoadDataAsync();
            StateHasChanged();
        });
    }

    private string GreetingText()
    {
        var hour = Clock.GetLocalNow().Hour;
        return hour switch
        {
            >= 4 and < 11 => "Good morning",
            >= 11 and < 15 => "Good afternoon",
            >= 15 and < 19 => "Good evening",
            _ => "Good evening"
        };
    }

    private string FirstName(string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return T["User"];
        return fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries)[0];
    }

    private static string ResolveTitle(CompiledDocType meta, Document doc)
    {
        if (meta.Def.ListView.TitleField is { } tf)
        {
            var val = Fmt.Value(null, doc.Get(tf));
            if (!string.IsNullOrWhiteSpace(val) && val != "—") return val;
        }
        return doc.Owner;
    }

    private static string StatusPillClass(CompiledDocType meta, Document doc)
    {
        var tone = Fmt.Tone(meta, doc);
        return tone switch
        {
            "positive" => "tone-positive",
            "pending" => "tone-pending",
            "negative" => "tone-negative",
            _ => doc.DocStatus == 0 ? "tone-warning" : "tone-neutral"
        };
    }

    private (string Label, bool IsPrimary, string Tooltip) DescribeAction(IReadOnlyList<string> actions)
    {
        if (actions.Count == 0)
            return ("View", false, "Open document details");
        if (actions.Count == 1 && (string.Equals(actions[0], "Batalkan", StringComparison.OrdinalIgnoreCase) || string.Equals(actions[0], "Cancel", StringComparison.OrdinalIgnoreCase)))
            return ("Cancel", false, "Cancel document");
        if (actions.Count == 1 && (string.Equals(actions[0], "Ajukan", StringComparison.OrdinalIgnoreCase) || string.Equals(actions[0], "Submit", StringComparison.OrdinalIgnoreCase)))
            return ("Submit", true, "Submit document for approval");
        return ("Review", true, string.Join(" · ", actions.Select(a => T[a])));
    }

    public void Dispose()
    {
        Current.ModuleChanged -= OnModuleChanged;
        MenuStore.Changed -= OnMenusChanged;
    }
}

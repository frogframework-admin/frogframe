@page "/admin/api-keys"
@using Framework.Api
@using Microsoft.AspNetCore.Identity
@inject ApiKeyService Keys
@inject RoleCatalog RoleCatalogSvc
@inject ApiMethodRegistry Methods
@inject QueryApiService QueryApis
@inject IUserAccountRepository Accounts
@inject UserManager<UserAccount> Users
@inject IMetadataProvider Metadata
@inject CurrentUser Current
@inject ToastService Toasts
@inject DialogService Dialogs
@inject NavigationManager Nav
@inject TimeProvider Clock
@inject Framework.Preferences.IUserPreferenceStore UserPrefs
@implements IDisposable

<PageTitle>API Keys · FrogFrame</PageTitle>

@if (!Current.Required.Roles.Contains(UserContext.SystemManager))
{
    <ErrorState StatusCode="403" Description="This administration page is restricted to System Managers / Administrators." />
}
else
{
    <header class="page-head">
        <div>
            <h1>API Keys</h1>
            <p>For external system integrations. Keys act as user accounts: their roles, departments, and data scopes apply following the same rules as the UI.</p>
        </div>
        @if (!creating) { <BbButton OnClick="StartCreate"><LucideIcon Name="key-round" Size="16" /> Create key</BbButton> }
    </header>

    @if (token is not null)
    {
        <BbAlert Variant="AlertVariant.Warning" Class="props-block">
            <BbAlertTitle>Save this key now — it will not be displayed again</BbAlertTitle>
            <BbAlertDescription>
                <code class="temp-password" id="new-token">@token</code>
                <pre class="api-example">curl -H "Authorization: ApiKey @token" @(BaseUrl)api/data/PurchaseRequest</pre>
            </BbAlertDescription>
        </BbAlert>
    }

    @if (creating)
    {
        <BbCard Class="props-block">
            <BbCardHeader><BbCardTitle Class="card-title">New Key</BbCardTitle></BbCardHeader>
            <BbCardContent>
                <div class="stack" style="max-width:56rem">
                    @if (error is not null) { <BbAlert Variant="AlertVariant.Danger"><BbAlertDescription>@error</BbAlertDescription></BbAlert> }
                    <BbField><BbFieldLabel For="k-name">Key name</BbFieldLabel><FormTextInput Id="k-name" Value="@name" ValueChanged="v => name = v ?? string.Empty" Placeholder="e.g. ERP financial integration" /></BbField>

                    <BbField>
                        <BbFieldLabel>Key owner account</BbFieldLabel>
                        <BbSelect TValue="string" Value="@accountId" ValueChanged="v => accountId = v ?? NewAccount" AriaLabel="Key owner account" Options="AccountOptions" />
                        <BbFieldDescription>A dedicated integration account (passwordless) is recommended over human accounts.</BbFieldDescription>
                    </BbField>
                    @if (accountId == NewAccount)
                    {
                        <div class="props-row">
                            <BbField><BbFieldLabel For="a-name">Integration account name</BbFieldLabel><FormTextInput Id="a-name" Value="@newName" ValueChanged="v => newName = v ?? string.Empty" Placeholder="e.g. ERP System" /></BbField>
                            <BbField><BbFieldLabel For="a-user">Username</BbFieldLabel><FormTextInput Id="a-user" Value="@newUser" ValueChanged="v => newUser = (v ?? string.Empty).Trim().ToLowerInvariant()" Placeholder="e.g. svc.erp" /></BbField>
                        </div>
                        <BbField><BbFieldLabel For="a-dept">Department (optional)</BbFieldLabel><FormTextInput Id="a-dept" Value="@newDept" ValueChanged="v => newDept = v" /></BbField>
                        <div>
                            <div class="props-sub" style="margin-bottom:.35rem">Integration account roles</div>
                            <div class="wf-roles">
                                @foreach (var role in MetadataRoles.Known(Metadata.Current, RoleCatalogSvc.Names(Current.Required.TenantId)).Where(r => r != UserContext.SystemManager))
                                {
                                    var r = role;
                                    <div class="label-row"><BbCheckbox Id="@($"ar-{r}")" Checked="newRoles.Contains(r)" CheckedChanged="v => { if (v) newRoles.Add(r); else newRoles.Remove(r); }" /><BbLabel For="@($"ar-{r}")">@r</BbLabel></div>
                                }
                            </div>
                        </div>
                    }

                    <div>
                        <div class="props-sub" style="margin-bottom:.35rem">Scope</div>
                        <div class="label-row"><input type="radio" id="sc-all" name="scope" checked="@(!limited)" @onchange="() => limited = false" /><label for="sc-all">All actions permitted by account roles</label></div>
                        <div class="label-row"><input type="radio" id="sc-lim" name="scope" checked="@limited" @onchange="() => limited = true" /><label for="sc-lim">Restricted to the following selection</label></div>
                    </div>
                    @if (limited)
                    {
                        <div class="table-wrap">
                            <table class="perm-table">
                                <thead><tr><th>DocType (API enabled)</th>@foreach (var op in ApiScopes.DocOperations) { <th class="c">@OpLabel(op)</th> }</tr></thead>
                                <tbody>
                                    @foreach (var dt in Metadata.Current.DocTypes.Values.Where(d => d.Def.Api.Enabled && !d.Def.IsChild).OrderBy(d => d.Title))
                                    {
                                        var doc = dt;
                                        <tr>
                                            <td>@doc.Title <span class="muted small">@doc.Name</span></td>
                                            @foreach (var op in ApiScopes.DocOperations)
                                            {
                                                var scope = $"doc:{doc.Name}:{op}";
                                                <td class="c"><BbCheckbox Checked="scopes.Contains(scope)" CheckedChanged="v => Toggle(scope, v)" AriaLabel="@scope" /></td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        @if (Methods.Visible(Current.Required).Any())
                        {
                            <div class="props-sub">Method</div>
                            <div class="wf-roles">
                                @foreach (var m in Methods.Visible(Current.Required))
                                {
                                    var scope = $"method:{m.Name}";
                                    <div class="label-row" title="@m.Description"><BbCheckbox Id="@($"m-{m.Name}")" Checked="scopes.Contains(scope)" CheckedChanged="v => Toggle(scope, v)" /><BbLabel For="@($"m-{m.Name}")"><code>@m.Name</code></BbLabel></div>
                                }
                            </div>
                        }
                    }
                    @if (limited && queryApis.Count > 0)
                    {
                        <div class="props-sub">API Query</div>
                        <div class="wf-roles">
                            @foreach (var q in queryApis)
                            {
                                var scope = $"query:{q.Slug}";
                                <div class="label-row" title="@q.Name"><BbCheckbox Id="@($"q-{q.Slug}")" Checked="scopes.Contains(scope)" CheckedChanged="v => Toggle(scope, v)" /><BbLabel For="@($"q-{q.Slug}")"><code>@q.Slug</code></BbLabel></div>
                            }
                        </div>
                    }
                    <div class="props-row">
                        <BbField><BbFieldLabel For="k-exp">Expires at (optional)</BbFieldLabel><FormTextInput Id="k-exp" Type="date" Value="@expires" ValueChanged="v => expires = v" /></BbField>
                        <BbField><BbFieldLabel For="k-ip">Allowed IPs (optional)</BbFieldLabel><FormTextInput Id="k-ip" Value="@ips" ValueChanged="v => ips = v" Placeholder="e.g. 10.0.5.0/24, 203.0.113.7" /></BbField>
                    </div>
                    <div class="row">
                        <BbButton Disabled="busy" OnClick="Create"><LucideIcon Name="key-round" Size="16" /> Create key</BbButton>
                        <BbButton Variant="ButtonVariant.Ghost" OnClick="() => creating = false">Cancel</BbButton>
                    </div>
                </div>
            </BbCardContent>
        </BbCard>
    }

    <BbDataGrid @key="gridMgr.RenderKey"
                TData="ApiKey"
                Items="@keys"
                ShowSearch="true"
                SearchPlaceholder="Search API keys..."
                ShowPagination="true"
                InitialPageSize="15"
                TableContainerClass="table-wrap"
                Resizable="true"
                OnColumnResize="gridMgr.HandleResize"
                StateChanged="gridMgr.HandleStateChanged">
        <Toolbar>
            <div style="display:flex;align-items:center;gap:.5rem;margin-left:auto">
                @if (gridMgr.HasCustomLayout)
                {
                    <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" OnClick="ResetColumnsLayout" Title="Reset column layout to default">
                        <LucideIcon Name="rotate-ccw" Size="14" />
                        <span>Reset Columns</span>
                    </BbButton>
                }
                <BbDataGridColumnVisibility TData="ApiKey" />
            </div>
        </Toolbar>
        <Columns>
            <BbDataGridPropertyColumn TData="ApiKey" TProp="string" Property="k => k.Name" Id="name" Title="Key Name"
                                      Width="@gridMgr.GetWidth("name")" Visible="@gridMgr.IsVisible("name")" Resizable="true" Sortable="true" Filterable="true">
                <CellTemplate Context="key">
                    <div>
                        <strong>@key.Name</strong>
                        <div class="muted small"><code>dfk_@(key.Id).…</code></div>
                    </div>
                </CellTemplate>
            </BbDataGridPropertyColumn>

            <BbDataGridTemplateColumn TData="ApiKey" Id="account" Title="Account"
                                      Width="@gridMgr.GetWidth("account", "12rem")" Visible="@gridMgr.IsVisible("account")" Resizable="true" Sortable="true" SortBy="k => names.GetValueOrDefault(k.UserId) ?? k.UserId">
                <ChildContent Context="key">
                    @(names.GetValueOrDefault(key.UserId) ?? key.UserId)
                </ChildContent>
            </BbDataGridTemplateColumn>

            <BbDataGridTemplateColumn TData="ApiKey" Id="scope" Title="Scope"
                                      Width="@gridMgr.GetWidth("scope", "16rem")" Visible="@gridMgr.IsVisible("scope")" Resizable="true">
                <ChildContent Context="key">
                    <div class="small scope-cell">
                        @(key.Scopes.Count == 0 ? "All per role" : string.Join(", ", key.Scopes.Take(4)) + (key.Scopes.Count > 4 ? $" +{key.Scopes.Count - 4}" : ""))
                        @if (key.AllowedIps.Count > 0)
                        {
                            <div class="muted">IP: @string.Join(", ", key.AllowedIps)</div>
                        }
                    </div>
                </ChildContent>
            </BbDataGridTemplateColumn>

            <BbDataGridTemplateColumn TData="ApiKey" Id="expires" Title="Expires At"
                                      Width="@gridMgr.GetWidth("expires", "11rem")" Visible="@gridMgr.IsVisible("expires")" Resizable="true" Sortable="true" SortBy="k => k.ExpiresAt">
                <ChildContent Context="key">
                    <span class="nowrap">@(key.ExpiresAt is { } e ? Fmt.When(e) : "—")</span>
                </ChildContent>
            </BbDataGridTemplateColumn>

            <BbDataGridTemplateColumn TData="ApiKey" Id="last_used" Title="Last Used"
                                      Width="@gridMgr.GetWidth("last_used", "12rem")" Visible="@gridMgr.IsVisible("last_used")" Resizable="true" Sortable="true" SortBy="k => k.LastUsedAt">
                <ChildContent Context="key">
                    <span class="nowrap muted">@(key.LastUsedAt is { } u ? $"{Fmt.When(u)} · {key.LastUsedIp}" : "never")</span>
                </ChildContent>
            </BbDataGridTemplateColumn>

            <BbDataGridTemplateColumn TData="ApiKey" Id="status" Title="Status"
                                      Width="@gridMgr.GetWidth("status", "7.5rem")" Visible="@gridMgr.IsVisible("status")" Resizable="true" Sortable="true" SortBy="k => DisplayStatus(k)">
                <ChildContent Context="key">
                    @{
                        var status = DisplayStatus(key);
                        var isKeyActive = key.RevokedAt is null && (key.ExpiresAt is null || key.ExpiresAt > Clock.GetUtcNow());
                    }
                    <BbBadge Variant="@(isKeyActive ? BadgeVariant.SoftSuccess : BadgeVariant.Soft)">@status</BbBadge>
                </ChildContent>
            </BbDataGridTemplateColumn>

            <BbDataGridTemplateColumn TData="ApiKey" Id="actions" Title="Actions"
                                      Width="@gridMgr.GetWidth("actions", "7.5rem")" Hideable="false" Resizable="false">
                <ChildContent Context="key">
                    @{
                        var isKeyActive = key.RevokedAt is null && (key.ExpiresAt is null || key.ExpiresAt > Clock.GetUtcNow());
                    }
                    @if (isKeyActive)
                    {
                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" OnClick="() => Revoke(key)">
                            <LucideIcon Name="ban" Size="15" /> Revoke
                        </BbButton>
                    }
                </ChildContent>
            </BbDataGridTemplateColumn>
        </Columns>
        <EmptyTemplate>
            <div style="padding:2.5rem 1rem;text-align:center">
                <BbEmpty Title="No API keys found" Description="For external system integrations, create an API key to allow external access." />
            </div>
        </EmptyTemplate>
    </BbDataGrid>
}

@code {
    private const string NewAccount = "__new__";
    private IReadOnlyList<ApiKey> keys = [];
    private Dictionary<string, string> names = new();
    private List<UserAccount> accounts = [];
    private IReadOnlyList<QueryApiDef> queryApis = [];
    private Framework.Web.Services.DataGridPreferenceManager<ApiKey> gridMgr = default!;
    private bool creating, limited, busy;
    private string name = "", accountId = NewAccount, newName = "", newUser = "";
    private string? newDept, expires, ips, error, token;
    private readonly HashSet<string> newRoles = ["Employee"];
    private readonly HashSet<string> scopes = new();

    private string BaseUrl => Nav.BaseUri;
    private IEnumerable<SelectOption<string>> AccountOptions =>
        new[] { new SelectOption<string>(NewAccount, "＋ New integration account") }
        .Concat(accounts.Where(a => a.IsActive).Select(a => new SelectOption<string>(a.Id, $"{a.FullName} ({a.UserName}){(a.PasswordHash is null ? " · integration" : "")}")));

    protected override async Task OnInitializedAsync()
    {
        gridMgr = new(UserPrefs, Current, "grid:admin:api-keys", StateHasChanged);
        if (Current.User is not null)
        {
            await gridMgr.InitializeAsync();
        }
        await Reload();
    }

    private async Task ResetColumnsLayout()
    {
        await gridMgr.ResetAsync();
        Toasts.Success("Column layout has been reset to default.", "Reset Columns");
    }

    public void Dispose()
    {
        gridMgr?.Dispose();
    }

    private async Task Reload()
    {
        if (!Current.Required.Roles.Contains(UserContext.SystemManager)) return;
        keys = await Keys.ListAsync(Current.Required);
        accounts = (await Accounts.ListAsync(Current.Required.TenantId)).ToList();
        names = accounts.ToDictionary(a => a.Id, a => a.FullName);
        if (QueryApis.IsAvailable) queryApis = (await QueryApis.ListAsync(Current.Required)).Where(q => q.Config.Enabled).ToList();
    }

    private void StartCreate()
    {
        creating = true; token = null; error = null; limited = false; scopes.Clear();
        name = ""; accountId = NewAccount; newName = ""; newUser = ""; newDept = null; expires = null; ips = null;
    }

    private void Toggle(string scope, bool on) { if (on) scopes.Add(scope); else scopes.Remove(scope); }

    private static string DisplayStatus(ApiKey key) =>
        key.RevokedAt is not null ? "Revoked"
        : key.ExpiresAt is { } e && e <= DateTimeOffset.UtcNow ? "Expired"
        : "Active";

    private async Task Create()
    {
        error = null; busy = true;
        try
        {
            var owner = accountId;
            if (accountId == NewAccount)
            {
                if (string.IsNullOrWhiteSpace(newName) || !System.Text.RegularExpressions.Regex.IsMatch(newUser, "^[a-z0-9._]{3,40}$"))
                { error = "Fill in account name and username (3–40 characters: lowercase letters, numbers, dots, underscores)."; return; }
                if (newRoles.Count == 0) { error = "Select at least one role for the integration account."; return; }
                // Integration accounts are created WITHOUT a password: login via UI is disabled, API key only.
                var acc = new UserAccount { UserName = newUser, FullName = newName.Trim(), TenantId = Current.Required.TenantId,
                    Department = string.IsNullOrWhiteSpace(newDept) ? null : newDept.Trim(), Roles = newRoles.ToList() };
                var result = await Users.CreateAsync(acc);
                if (!result.Succeeded) { error = string.Join(" ", result.Errors.Select(e => e.Description)); return; }
                owner = acc.Id;
            }
            if (limited && scopes.Count == 0) { error = "Select at least one scope, or select \"All actions permitted by account roles\"."; return; }
            DateTimeOffset? exp = DateOnly.TryParse(expires, out var d) ? new DateTimeOffset(d.ToDateTime(new TimeOnly(23, 59, 59)), TimeZoneInfo.Local.GetUtcOffset(DateTime.Now)) : null;
            var (key, t) = await Keys.CreateAsync(Current.Required, new CreateApiKeyRequest(name, owner,
                limited ? scopes.ToList() : [], (ips ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries), exp));
            token = t; creating = false;
            Toasts.Success("Copy the key now; once this page is closed it cannot be displayed again.", $"Key \"{key.Name}\" created");
            await Reload();
        }
        catch (Exception ex) when (ex is ApiKeyException or PermissionDeniedException) { error = ex.Message; }
        finally { busy = false; }
    }

    private async Task Revoke(ApiKey k)
    {
        var ok = await Dialogs.ConfirmAsync($"Revoke key \"{k.Name}\"?", "Systems using this key will immediately be rejected (HTTP 401). This action cannot be undone.",
            new ConfirmDialogOptions { Destructive = true, ConfirmText = "Revoke key", CancelText = "Cancel" });
        if (!ok.Confirmed) return;
        await Keys.RevokeAsync(Current.Required, k.Id);
        Toasts.Success("Requests with this key are now rejected.", "Key revoked");
        await Reload();
    }

    private static string OpLabel(string op) => op switch { "list" => "List", "read" => "Read", "create" => "Create", "update" => "Update", "delete" => "Delete", _ => "Action" };
}

    private void OpenAutoRepeatDrawer()
    {
        autoRepeatName = $"Repeat: {meta?.Title} ({Name})";
        autoRepeatFreqStr = nameof(AutoRepeatFrequency.Monthly);
        autoRepeatStartDateStr = DateOnly.FromDateTime(DateTime.UtcNow).ToString("yyyy-MM-dd");
        autoRepeatSubmitOnCreation = false;
        autoRepeatError = null;
        isAutoRepeatDrawerOpen = true;
    }

    private async Task SaveQuickAutoRepeat()
    {
        autoRepeatError = null;
        if (!DateOnly.TryParse(autoRepeatStartDateStr, out var startDate))
        {
            autoRepeatError = T["Invalid start date format (YYYY-MM-DD)."];
            return;
        }

        if (!Enum.TryParse<AutoRepeatFrequency>(autoRepeatFreqStr, out var freq))
        {
            autoRepeatError = T["Invalid frequency selected."];
            return;
        }

        try
        {
            var req = new SaveAutoRepeatRequest(
                Id: null,
                Name: autoRepeatName,
                ReferenceDocType: DocType,
                ReferenceDocName: Name,
                Frequency: freq,
                StartDate: startDate,
                EndDate: null,
                RunAsUserId: User.Id,
                SubmitOnCreation: autoRepeatSubmitOnCreation
            );

            await AutoRepeatService.SaveAsync(User, req);
            isAutoRepeatDrawerOpen = false;
            Toasts.Success(T.Format("Auto Repeat schedule created for {0}.", Name), T["Auto Repeat"]);
        }
        catch (Exception ex)
        {
            autoRepeatError = ex.Message;
        }
    }

    private void OpenSendEmailDrawer()
    {
        sendEmailError = null;
        emailTo = "";
        emailCc = "";
        emailBcc = "";
        emailSubject = $"[#{Name}] {meta?.Title ?? DocType}";
        emailBody = "";
        emailInReplyTo = null;
        InitDefaultEmailAttachments();
        isSendEmailDrawerOpen = true;
    }

    private void ReplyToEmail(CommunicationEntry comm)
    {
        sendEmailError = null;
        emailTo = comm.Sender;
        emailCc = "";
        emailBcc = "";
        emailSubject = comm.Subject.StartsWith("Re:", StringComparison.OrdinalIgnoreCase) ? comm.Subject : $"Re: {comm.Subject}";
        if (!emailSubject.Contains($"[#{Name}]"))
            emailSubject = $"[#{Name}] " + emailSubject;
        var quoted = System.Net.WebUtility.HtmlEncode(comm.ContentText ?? "").Replace("\n", "<br/>");
        emailBody = $"<p><br/></p><blockquote><p>On {comm.OccurredAt:yyyy-MM-dd HH:mm}, {System.Net.WebUtility.HtmlEncode(comm.Sender)} wrote:</p><p>{quoted}</p></blockquote>";
        emailInReplyTo = comm.MessageId;
        InitDefaultEmailAttachments();
        isSendEmailDrawerOpen = true;
    }

    private void InitDefaultEmailAttachments()
    {
        emailAttachments =
        [
            new PendingEmailAttachment
            {
                Key = "doc-pdf",
                FileName = $"{Name}.pdf",
                ContentType = "application/pdf",
                IsDocumentPdf = true
            }
        ];
    }

    private void AddDocumentPdfAttachment()
    {
        if (emailAttachments.Any(a => a.IsDocumentPdf)) return;
        emailAttachments.Insert(0, new PendingEmailAttachment
        {
            Key = "doc-pdf",
            FileName = $"{Name}.pdf",
            ContentType = "application/pdf",
            IsDocumentPdf = true
        });
    }

    private void AddExistingEmailAttachment(AttachmentRecord rec)
    {
        if (emailAttachments.Any(a => a.ExistingAttachmentId == rec.Id)) return;
        emailAttachments.Add(new PendingEmailAttachment
        {
            Key = $"att:{rec.Id}",
            FileName = rec.FileName,
            ContentType = rec.ContentType,
            ExistingAttachmentId = rec.Id,
            SizeBytes = rec.Size
        });
    }

    private void RemoveEmailAttachment(string key)
    {
        emailAttachments.RemoveAll(a => a.Key == key);
    }

    private async Task OnEmailAttachmentSelected(InputFileChangeEventArgs e)
    {
        sendEmailError = null;
        const long maxFileBytes = 10 * 1024 * 1024;
        foreach (var file in e.GetMultipleFiles(10))
        {
            if (file.Size > maxFileBytes)
            {
                sendEmailError = T.Format("Attachment '{0}' exceeds 10 MB limit.", file.Name);
                continue;
            }
            using var ms = new MemoryStream();
            await file.OpenReadStream(maxFileBytes).CopyToAsync(ms);
            emailAttachments.Add(new PendingEmailAttachment
            {
                Key = Guid.NewGuid().ToString("N"),
                FileName = file.Name,
                ContentType = string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType,
                Bytes = ms.ToArray(),
                SizeBytes = file.Size
            });
        }
    }

    private static string StripHtml(string? html)
    {
        if (string.IsNullOrWhiteSpace(html)) return "";
        var noTags = System.Text.RegularExpressions.Regex.Replace(html, "<[^>]+>", " ");
        var decoded = System.Net.WebUtility.HtmlDecode(noTags);
        return System.Text.RegularExpressions.Regex.Replace(decoded, @"\s+", " ").Trim();
    }

    private static string SafeAttachmentName(string? name, string fallback)
    {
        var trimmed = (name ?? "").Trim();
        return string.IsNullOrEmpty(trimmed) ? fallback : trimmed;
    }

    private async Task SendEmailAsync()
    {
        sendEmailError = null;
        if (string.IsNullOrWhiteSpace(emailTo))
        {
            sendEmailError = T["Recipient email (To) is required."];
            return;
        }
        if (string.IsNullOrWhiteSpace(emailSubject))
        {
            sendEmailError = T["Subject is required."];
            return;
        }
        var plainText = StripHtml(emailBody);
        if (string.IsNullOrWhiteSpace(plainText))
        {
            sendEmailError = T["Message body cannot be empty."];
            return;
        }

        isSendingEmail = true;
        try
        {
            var resolvedAttachments = new List<EmailAttachment>();
            foreach (var att in emailAttachments)
            {
                if (att.IsDocumentPdf)
                {
                    var printModel = await PrintSvc.BuildAsync(User, DocType, Name);
                    var html = await PrintHtml.RenderAsync(printModel);
                    var pdfBytes = await PdfRenderer.RenderAsync(html);
                    resolvedAttachments.Add(new EmailAttachment
                    {
                        FileName = SafeAttachmentName(att.FileName, $"{Name}.pdf"),
                        ContentType = "application/pdf",
                        Content = pdfBytes
                    });
                }
                else if (att.ExistingAttachmentId is { } attId)
                {
                    var (rec, content) = await Attachments.GetFileAsync(User, attId);
                    resolvedAttachments.Add(new EmailAttachment
                    {
                        FileName = SafeAttachmentName(att.FileName, rec.FileName),
                        ContentType = rec.ContentType,
                        Content = content
                    });
                }
                else if (att.Bytes is { } bytes)
                {
                    resolvedAttachments.Add(new EmailAttachment
                    {
                        FileName = SafeAttachmentName(att.FileName, "attachment"),
                        ContentType = att.ContentType,
                        Content = bytes
                    });
                }
            }

            var msg = new EmailMessage
            {
                To = emailTo.Split([';', ','], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList(),
                Cc = emailCc.Split([';', ','], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList(),
                Bcc = emailBcc.Split([';', ','], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList(),
                Subject = emailSubject.Trim(),
                BodyText = plainText,
                BodyHtml = emailBody,
                Attachments = resolvedAttachments,
                InReplyTo = emailInReplyTo,
                ReferenceDocType = DocType,
                ReferenceName = Name,
                From = User.Attr("email")
            };

            await EmailQueue.QueueAsync(User.TenantId, msg);
            Toasts.Success(T["Email queued for sending."], T["Queued"]);
            isSendEmailDrawerOpen = false;
            communications = await CommService.ListForDocumentAsync(User, DocType, Name);
        }
        catch (Exception ex)
        {
            sendEmailError = T["Failed to queue email:"] + " " + T.Message(ex.Message);
        }
        finally
        {
            isSendingEmail = false;
        }
    }

    private void ToggleMentionPicker()
    {
        showMentionPicker = !showMentionPicker;
        if (showMentionPicker) mentionQuery = "";
    }

    private void OnCommentChanged(string? value)
    {
        newComment = value ?? "";
        var match = TrailingMentionRegex.Match(newComment);
        if (match.Success)
        {
            mentionQuery = match.Groups[2].Value;
            showMentionPicker = true;
        }
        else
        {
            mentionQuery = "";
            showMentionPicker = false;
        }
    }

    private async Task OnCommentKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && showMentionPicker)
        {
            showMentionPicker = false;
            return;
        }
        if (e.CtrlKey && e.Key == "Enter" && !postingComment && !string.IsNullOrWhiteSpace(newComment))
        {
            await PostCommentAsync();
        }
    }

    private async Task InsertMention(string userId)
    {
        var match = TrailingMentionRegex.Match(newComment);
        if (match.Success)
        {
            var prefix = newComment[..match.Groups[1].Index];
            newComment = $"{prefix}@{userId} ";
        }
        else
        {
            var tag = $"@{userId} ";
            newComment = string.IsNullOrEmpty(newComment) || char.IsWhiteSpace(newComment[^1])
                ? newComment + tag
                : $"{newComment} {tag}";
        }
        mentionQuery = "";
        showMentionPicker = false;
        if (commentTextarea is not null)
            await commentTextarea.FocusAsync();
    }

    private async Task PostCommentAsync()
    {
        if (IsNew || postingComment || string.IsNullOrWhiteSpace(newComment)) return;
        postingComment = true;
        try
        {
            await Docs.AddCommentAsync(User, DocType, Name, newComment);
            newComment = "";
            mentionQuery = "";
            showMentionPicker = false;
            audit = await Docs.GetAuditAsync(User, DocType, Name);
            Toasts.Success(T["Comment posted."], T["Comment"]);
        }
        catch (Exception ex) when (ex is ValidationFailedException or PermissionDeniedException or DocumentNotFoundException)
        {
            Toasts.Error(T.Message(ex.Message), T["Comment Failed"]);
        }
        finally
        {
            postingComment = false;
        }
    }


@page "/app/{DocType}/{Name}"
@implements IAsyncDisposable
@using System.Text.Json
@using Framework.Communication
@using Framework.Email
@using Framework.Files
@using Framework.Presence
@using Framework.Integrations
@inject DocumentService Docs
@inject CurrentUser Current
@inject IMetadataProvider Metadata
@inject IPermissionService Perms
@inject DocumentEvaluator Evaluator
@inject NavigationManager Nav
@inject DialogService Dialogs
@inject ToastService Toasts
@inject IEnumerable<Framework.Actions.IFormAction> RegisteredFormActions
@inject IServiceProvider Sp
@inject AttachmentService Attachments
@inject IDocumentPresenceService Presence
@inject AutoRepeatService AutoRepeatService
@inject CommunicationService CommService
@inject IEmailQueue EmailQueue

<PageTitle>@(meta?.Def.IsSingle == true ? meta.Title : IsNew ? $"New {meta?.Title}" : Name) · FrogFrame</PageTitle>

@if (fatal is not null)
{
    <ErrorState StatusCode="@fatalStatus"
                Title="@(fatalStatus == 403 ? "Access Denied" : "Document Not Found")"
                Description="@fatal"
                BackHref="@(meta is not null ? $"/app/{meta.Name}" : "/")"
                BackLabel="@(meta is not null ? $"Back to {meta.Title}" : "Back to Home")" />
}
else if (meta is not null && doc is not null)
{
    <header class="doc-head">
        <div>
            <h1>@(meta.Def.IsSingle ? meta.Title : IsNew ? $"New {meta.Title}" : doc.Name)</h1>
            <p>
                @if (meta.Def.IsSingle && IsNew)
                {
                    <span>Default configuration (not saved yet)</span>
                }
                else if (!IsNew)
                {
                    <span>Created by @doc.Owner · modified @Fmt.When(doc.Modified) · version @doc.Version</span>
                    @if (doc.AmendedFrom is not null) { <span> · amended from <a href="/app/@meta.Name/@doc.AmendedFrom">@doc.AmendedFrom</a></span> }
                }
                else { <span>Not saved yet</span> }
            </p>
        </div>
        <div class="row" style="gap:.75rem;align-items:center;flex-wrap:wrap">
            @if (!IsNew)
            {
                <DocumentPresenceBar Users="@presenceUsers" CurrentSessionId="@sessionId" />
            }
            @if (!IsNew || meta.Workflow is not null)
            {
                <StatusStamp Label="@Fmt.StateLabel(doc.WorkflowState, doc.DocStatus)" Tone="@Fmt.Tone(meta, doc)" />
            }
        </div>
    </header>

    <div class="toolbar" role="toolbar" aria-label="Document actions">
        @if (Editable)
        {
            <BbButton Disabled="@(busy || (!IsNew && !dirty))" Loading="@(busy && savingNow)" LoadingText="Saving…" OnClick="Save">
                <LucideIcon Name="check" Size="16" /> @(IsNew ? "Save draft" : dirty ? "Save changes" : "Saved")
            </BbButton>
        }
        @foreach (var a in actions)
        {
            var act = a;
            <BbButton Variant="@Fmt.ButtonFor(act.Tone)" Disabled="@(busy || dirty)" OnClick="() => RunAction(act)"
                      AdditionalAttributes="@(new Dictionary<string, object> { ["title"] = dirty ? "Save changes first" : $"Move to {act.ToState}" })">
                <LucideIcon Name="@IconFor(act)" Size="16" /> @ActionLabel(act.Action)
            </BbButton>
        }
        @foreach (var ca in CustomActions)
        {
            var customAct = ca;
            <BbButton Variant="@Fmt.ButtonFor(customAct.Tone)" Disabled="@(busy || dirty)" OnClick="() => RunCustomAction(customAct)">
                <LucideIcon Name="@customAct.Icon" Size="16" /> @customAct.Label
            </BbButton>
        }
        @if (!IsNew)
        {
            <BbButton Variant="ButtonVariant.Outline" Href="@($"/print/{DocType}/{Name}")" Disabled="@dirty"
                      AdditionalAttributes="@(new Dictionary<string, object> { ["target"] = "_blank", ["title"] = "A4 print preview" })">
                <LucideIcon Name="printer" Size="16" /> Print
            </BbButton>
            <BbButton Variant="ButtonVariant.Ghost" Href="@($"/api/print/{DocType}/{Name}/pdf")" Disabled="@dirty"
                      AdditionalAttributes="@(new Dictionary<string, object> { ["title"] = "Download PDF" })">
                <LucideIcon Name="file-down" Size="16" /> PDF
            </BbButton>
            @if (meta.AllowAutoRepeat)
            {
                <BbButton Variant="ButtonVariant.Ghost" Disabled="@dirty" OnClick="OpenAutoRepeatDrawer"
                          AdditionalAttributes="@(new Dictionary<string, object> { ["title"] = "Configure recurring schedule" })">
                    <LucideIcon Name="repeat" Size="16" /> Repeat
                </BbButton>
            }
            <BbButton Variant="ButtonVariant.Ghost" Disabled="@dirty" OnClick="OpenSendEmailDrawer"
                      AdditionalAttributes="@(new Dictionary<string, object> { ["title"] = "Send email regarding this document" })">
                <LucideIcon Name="mail" Size="16" /> Email
            </BbButton>
        }
        @if (!IsNew && !meta.Def.IsSingle && doc.DocStatus == DocStatus.Draft && meta.Def.Document.AllowDelete && Perms.Can(User, meta, DocActions.Delete))
        {
            <BbButton Variant="ButtonVariant.Ghost" Disabled="@busy" OnClick="Delete">
                <LucideIcon Name="trash-2" Size="16" /> Delete draft
            </BbButton>
        }
        @if (!Editable && !IsNew && doc.DocStatus != DocStatus.Draft)
        {
            <span class="muted small">Document is locked with status @Fmt.StateLabel(doc.WorkflowState, doc.DocStatus).</span>
        }
    </div>

    @if (!IsNew && OtherEditingUsers.Count > 0)
    {
        var editors = string.Join(", ", OtherEditingUsers.Select(u => u.FullName));
        <div class="presence-warning-banner" role="alert">
            <LucideIcon Name="alert-triangle" Size="18" Class="presence-warning-icon" />
            <div class="presence-warning-content">
                <strong>Dokumen Sedang Diedit Pengguna Lain</strong>
                <span><strong>@editors</strong> saat ini sedang mengedit dokumen ini. Perubahan simultan berisiko menyebabkan konflik versi saat disimpan.</span>
            </div>
        </div>
    }

    @if (conflict is not null)
    {
        <BbAlert Variant="AlertVariant.Warning" Class="crumbs">
            <ChildContent>
                <BbAlertTitle>Version conflict</BbAlertTitle>
                <BbAlertDescription>@conflict</BbAlertDescription>
            </ChildContent>
            <Actions><BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="Load">Reload latest version</BbButton></Actions>
        </BbAlert>
    }
    @if (banner is not null)
    {
        <BbAlert Variant="AlertVariant.Danger" Class="crumbs"><BbAlertDescription>@banner</BbAlertDescription></BbAlert>
    }
    @if (errors.Count > 0)
    {
        <BbAlert Variant="AlertVariant.Danger" Class="crumbs">
            <BbAlertTitle>Please check the following @errors.Count field(s) before saving</BbAlertTitle>
            <BbAlertDescription>
                <ul class="error-list">@foreach (var e in errors) { <li><a href="#@Anchor(e.Key)">@e.Value</a></li> }</ul>
            </BbAlertDescription>
        </BbAlert>
    }

    <BbTabs Value="@activeTab" ValueChanged="v => activeTab = v ?? activeTab">
        <BbTabsList>
            @foreach (var t in meta.Layout.Where(TabVisible))
            {
                <BbTabsTrigger Value="@t.Title">@t.Title@if (TabErrorCount(t) is > 0 and var n) { <span class="tab-count">@n</span> }</BbTabsTrigger>
            }
            @if (!IsNew)
            {
                <BbTabsTrigger Value="@AttachmentsTab">Attachments (@attachments.Count)</BbTabsTrigger>
                <BbTabsTrigger Value="@HistoryTab">History & Emails (@(audit.Count + communications.Count))</BbTabsTrigger>
            }
        </BbTabsList>

        @foreach (var tab in meta.Layout.Where(TabVisible))
        {
            <BbTabsContent Value="@tab.Title">
                <div class="stack" style="margin-top:.75rem">
                    @foreach (var sec in tab.Sections.Where(SectionVisible))
                    {
                        <BbCard>
                            @if (sec.Title is not null) { <BbCardHeader><BbCardTitle Class="card-title">@sec.Title</BbCardTitle></BbCardHeader> }
                            <BbCardContent Style="@(sec.Title is null ? "padding-top:1.5rem" : null)">
                                <div class="form-cols cols-@sec.Columns.Count">
                                    @foreach (var col in sec.Columns)
                                    {
                                        <div class="form-col">
                                            @foreach (var f in col.Fields.Where(Readable))
                                            {
                                                var st = State(f);
                                                if (!st.Visible) continue;
                                                var err = errors.GetValueOrDefault(f.Name);
                                                var ro = FieldReadOnly(f, st);
                                                <div id="@Anchor(f.Name)" class="@(f.Def.PermLevel > 0 ? "restricted" : "")">
                                                    <BbField IsInvalid="@(err is not null)">
                                                        @if (f.Type.Editor != "check" && !(f.Def.Type == "Table" && f.Label == sec.Title))
                                                        {
                                                            <BbFieldLabel For="@f.Name">
                                                                <span class="label-row">
                                                                    @f.Label@if (st.Required && !ro) { <span class="req" aria-label="required">*</span> }
                                                                    @if (f.IsDerived) { <BbBadge Variant="BadgeVariant.Soft">@(f.Compute is not null ? "computed" : $"from {f.FetchFrom!.Value.LinkField}")</BbBadge> }
                                                                    @if (f.Def.PermLevel > 0) { <BbBadge Variant="BadgeVariant.Outline">restricted</BbBadge> }
                                                                </span>
                                                            </BbFieldLabel>
                                                        }
                                                        @if (f.Def.Type == "Table")
                                                        {
                                                            <ChildTable Table="f" ChildMeta="Metadata.Current.Get(f.Def.ChildDocType!)" Rows="Rows(f)" Parent="Scope"
                                                                        ReadOnly="ro" Errors="errors" OnChanged="Changed" />
                                                        }
                                                        else
                                                        {
                                                            <FieldInput Field="f" Id="@f.Name" DocType="@meta.Name" Value="model.GetValueOrDefault(f.Name)" ReadOnly="ro" Invalid="@(err is not null)"
                                                                        ValueChanged="v => SetValue(f, v)" />
                                                        }
                                                        @if (err is not null) { <BbFieldError Errors="@(new[] { err })" /> }
                                                        else if (f.Def.Description is not null && !ro) { <BbFieldDescription>@f.Def.Description</BbFieldDescription> }
                                                    </BbField>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </BbCardContent>
                        </BbCard>
                    }
                </div>
            </BbTabsContent>
        }
        @if (!IsNew)
        {
            <BbTabsContent Value="@AttachmentsTab">
                <BbCard Class="crumbs" Style="margin-top:.75rem">
                    <BbCardHeader>
                        <BbCardTitle Class="card-title">Document Attachments</BbCardTitle>
                        <BbCardDescription>Supported formats: PDF, Office (.docx, .xlsx), CSV, plain text, PNG, JPEG, WebP, GIF (Max 10 MB per file).</BbCardDescription>
                    </BbCardHeader>
                    <BbCardContent>
                        @if (!string.IsNullOrEmpty(uploadError))
                        {
                            <BbAlert Variant="AlertVariant.Danger" Style="margin-bottom:1rem">
                                <BbAlertDescription>@uploadError</BbAlertDescription>
                            </BbAlert>
                        }

                        <div style="display:flex;gap:1rem;align-items:center;margin-bottom:1.25rem;">
                            <InputFile OnChange="OnAttachmentSelected" disabled="@uploadingAttachment" class="form-control" />
                            @if (uploadingAttachment)
                            {
                                <span>Uploading...</span>
                            }
                        </div>

                        @if (attachments.Count == 0)
                        {
                            <div style="color:var(--bb-muted-foreground);padding:1rem 0;">No attachments uploaded for this document yet.</div>
                        }
                        else
                        {
                            <table class="table" style="width:100%;border-collapse:collapse;">
                                <thead>
                                    <tr style="text-align:left;border-bottom:1px solid var(--bb-border);">
                                        <th style="padding:0.5rem;">File Name</th>
                                        <th style="padding:0.5rem;">Type</th>
                                        <th style="padding:0.5rem;">Size</th>
                                        <th style="padding:0.5rem;">Uploaded By</th>
                                        <th style="padding:0.5rem;">Date</th>
                                        <th style="padding:0.5rem;text-align:right;">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var att in attachments)
                                    {
                                        <tr style="border-bottom:1px solid var(--bb-border);">
                                            <td style="padding:0.5rem;font-weight:500;">
                                                <a href="/api/files/attachment/@att.Id" target="_blank" rel="noopener noreferrer">@att.FileName</a>
                                            </td>
                                            <td style="padding:0.5rem;font-size:0.875rem;color:var(--bb-muted-foreground);">@att.ContentType</td>
                                            <td style="padding:0.5rem;font-size:0.875rem;">@FormatBytes(att.Size)</td>
                                            <td style="padding:0.5rem;font-size:0.875rem;">@att.UploadedBy</td>
                                            <td style="padding:0.5rem;font-size:0.875rem;">@att.CreatedAt.ToLocalTime().ToString("g")</td>
                                            <td style="padding:0.5rem;text-align:right;">
                                                <a href="/api/files/attachment/@att.Id" target="_blank" class="btn btn-sm btn-outline-secondary" download="@att.FileName">Download</a>
                                                <button type="button" class="btn btn-sm btn-outline-danger" style="margin-left:0.5rem;" @onclick="() => DeleteAttachment(att.Id)">Delete</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </BbCardContent>
                </BbCard>
            </BbTabsContent>
            <BbTabsContent Value="@HistoryTab">
                <BbCard Class="crumbs" Style="margin-top:.75rem">
                    <BbCardContent>
                        <div style="display:flex;justify-content:space-between;align-items:center;padding:1rem 0;border-bottom:1px solid var(--bb-border);margin-bottom:1rem">
                            <div style="display:flex;gap:.5rem">
                                <BbButton Size="ButtonSize.Small" Variant="@(historyFilter == "all" ? ButtonVariant.Default : ButtonVariant.Outline)" OnClick='() => historyFilter = "all"'>All Activity (@(audit.Count + communications.Count))</BbButton>
                                <BbButton Size="ButtonSize.Small" Variant="@(historyFilter == "audit" ? ButtonVariant.Default : ButtonVariant.Outline)" OnClick='() => historyFilter = "audit"'>Audit Log (@audit.Count)</BbButton>
                                <BbButton Size="ButtonSize.Small" Variant="@(historyFilter == "emails" ? ButtonVariant.Default : ButtonVariant.Outline)" OnClick='() => historyFilter = "emails"'>Emails (@communications.Count)</BbButton>
                            </div>
                            <BbButton Size="ButtonSize.Small" Variant="ButtonVariant.Outline" OnClick="OpenSendEmailDrawer">
                                <LucideIcon Name="send" Size="14" /> Send Email
                            </BbButton>
                        </div>

                        @if (historyFilter != "audit" && communications.Count > 0)
                        {
                            <div style="margin-bottom:1.5rem">
                                <h4 style="margin-bottom:.75rem;font-size:.95rem;font-weight:600">Email Communications</h4>
                                <div style="display:flex;flex-direction:column;gap:.75rem">
                                    @foreach (var comm in communications)
                                    {
                                        <div style="border:1px solid var(--bb-border);border-radius:.375rem;padding:.85rem;background:var(--bb-bg-card)">
                                            <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:.5rem">
                                                <div style="display:flex;align-items:center;gap:.5rem">
                                                    @if (comm.Direction == CommunicationDirection.In)
                                                    {
                                                        <BbBadge Variant="BadgeVariant.Outline">Incoming</BbBadge>
                                                    }
                                                    else
                                                    {
                                                        <BbBadge Variant="BadgeVariant.SoftSuccess">Outgoing</BbBadge>
                                                    }
                                                    <span style="font-weight:600">@comm.Subject</span>
                                                </div>
                                                <div style="display:flex;align-items:center;gap:.75rem">
                                                    <span style="font-size:.75rem;color:var(--bb-muted-foreground)">@Fmt.When(comm.OccurredAt)</span>
                                                    <BbButton Size="ButtonSize.Small" Variant="ButtonVariant.Ghost" OnClick="() => ReplyToEmail(comm)" Title="Reply">
                                                        <LucideIcon Name="reply" Size="14" /> Reply
                                                    </BbButton>
                                                </div>
                                            </div>
                                            <div style="font-size:.8rem;color:var(--bb-muted-foreground);margin-bottom:.5rem">
                                                <span>From: <strong>@comm.Sender</strong></span>
                                                @if (comm.Recipients.Count > 0)
                                                {
                                                    <span style="margin-left:1rem">To: @string.Join(", ", comm.Recipients)</span>
                                                }
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(comm.ContentHtml))
                                            {
                                                <div style="font-size:.875rem;padding:.5rem;background:var(--bb-bg-muted);border-radius:.25rem;overflow-x:auto">
                                                    @* Sanitized again at render time: rows stored before outbound sanitization existed may contain raw HTML. *@
                                                    @((MarkupString)(HtmlContentSanitizer.Sanitize(comm.ContentHtml) ?? ""))
                                                </div>
                                            }
                                            else if (!string.IsNullOrWhiteSpace(comm.ContentText))
                                            {
                                                <div style="font-size:.875rem;white-space:pre-wrap;padding:.5rem;background:var(--bb-bg-muted);border-radius:.25rem">
                                                    @comm.ContentText
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        @if (historyFilter != "emails")
                        {
                            <div style="padding-top:.5rem">
                                <AuditTimeline Entries="audit" />
                            </div>
                        }
                    </BbCardContent>
                </BbCard>
            </BbTabsContent>
        }
    </BbTabs>

    @if (!IsNew && meta?.AllowAutoRepeat == true)
    {
        <AdminDrawer Open="@isAutoRepeatDrawerOpen"
                     OpenChanged="v => isAutoRepeatDrawerOpen = v"
                     Title="@($"Auto Repeat · {Name}")"
                     WidthScale="1.4">
            <ChildContent>
                @if (autoRepeatError is not null)
                {
                    <BbAlert Variant="AlertVariant.Danger" Style="margin-bottom:1rem">
                        <BbAlertDescription>@autoRepeatError</BbAlertDescription>
                    </BbAlert>
                }
                <div style="display:flex;flex-direction:column;gap:1rem">
                    <div>
                        <label class="form-label" style="display:block;margin-bottom:.35rem;font-weight:600">Schedule Name</label>
                        <BbInput @bind-Value="autoRepeatName" Placeholder="e.g. Monthly Recurring" />
                    </div>
                    <div class="row" style="gap:1rem">
                        <div style="flex:1">
                            <label class="form-label" style="display:block;margin-bottom:.35rem;font-weight:600">Frequency</label>
                            <BbSelect TValue="string" @bind-Value="autoRepeatFreqStr" Options="AutoRepeatFreqOptions" />
                        </div>
                        <div style="flex:1">
                            <label class="form-label" style="display:block;margin-bottom:.35rem;font-weight:600">Start Date</label>
                            <BbInput @bind-Value="autoRepeatStartDateStr" Placeholder="YYYY-MM-DD" />
                        </div>
                    </div>
                    <div style="display:flex;align-items:center;gap:.75rem">
                        <BbSwitch @bind-Value="autoRepeatSubmitOnCreation" Id="form-auto-repeat-submit" />
                        <label for="form-auto-repeat-submit" style="cursor:pointer;font-weight:500">Submit on creation</label>
                    </div>
                </div>
            </ChildContent>
            <FooterContent>
                <div style="display:flex;justify-content:flex-end;gap:.5rem;width:100%">
                    <BbButton Variant="ButtonVariant.Ghost" OnClick="() => isAutoRepeatDrawerOpen = false">Cancel</BbButton>
                    <BbButton OnClick="SaveQuickAutoRepeat">Save Schedule</BbButton>
                </div>
            </FooterContent>
        </AdminDrawer>
    }

    @if (!IsNew)
    {
        <AdminDrawer Open="@isSendEmailDrawerOpen"
                     OpenChanged="v => isSendEmailDrawerOpen = v"
                     Title="@($"Send Email · {Name}")"
                     WidthScale="1.4">
            <ChildContent>
                @if (sendEmailError is not null)
                {
                    <BbAlert Variant="AlertVariant.Danger" Style="margin-bottom:1rem">
                        <BbAlertDescription>@sendEmailError</BbAlertDescription>
                    </BbAlert>
                }
                <div style="display:flex;flex-direction:column;gap:1rem">
                    <div>
                        <label class="form-label" style="display:block;margin-bottom:.35rem;font-weight:600">To * (comma/semicolon separated)</label>
                        <BbInput @bind-Value="emailTo" Placeholder="recipient@example.com" />
                    </div>
                    <div class="row" style="gap:1rem">
                        <div style="flex:1">
                            <label class="form-label" style="display:block;margin-bottom:.35rem;font-weight:600">Cc</label>
                            <BbInput @bind-Value="emailCc" Placeholder="cc@example.com" />
                        </div>
                        <div style="flex:1">
                            <label class="form-label" style="display:block;margin-bottom:.35rem;font-weight:600">Bcc</label>
                            <BbInput @bind-Value="emailBcc" Placeholder="bcc@example.com" />
                        </div>
                    </div>
                    <div>
                        <label class="form-label" style="display:block;margin-bottom:.35rem;font-weight:600">Subject *</label>
                        <BbInput @bind-Value="emailSubject" Placeholder="Subject" />
                    </div>
                    <div>
                        <label class="form-label" style="display:block;margin-bottom:.35rem;font-weight:600">Message *</label>
                        <BbTextarea @bind-Value="emailBody" Rows="6" Placeholder="Write your message here..." />
                    </div>
                </div>
            </ChildContent>
            <FooterContent>
                <div style="display:flex;justify-content:flex-end;gap:.5rem;width:100%">
                    <BbButton Variant="ButtonVariant.Ghost" OnClick="() => isSendEmailDrawerOpen = false">Cancel</BbButton>
                    <BbButton OnClick="SendEmailAsync" Loading="@isSendingEmail" LoadingText="Sending…">
                        <LucideIcon Name="send" Size="14" /> Send Email
                    </BbButton>
                </div>
            </FooterContent>
        </AdminDrawer>
    }
}

@code {
    [Parameter] public string DocType { get; set; } = "";
    [Parameter] public string Name { get; set; } = "";

    private const string HistoryTab = "__history";
    private const string AttachmentsTab = "__attachments";
    private CompiledDocType? meta;
    private Document? doc;
    private Dictionary<string, object?> model = new();
    private string original = "";
    private Dictionary<string, string> errors = new();
    private Dictionary<string, string> errorSnapshot = new();
    private IReadOnlyList<ActionView> actions = [];
    private IReadOnlyList<AuditEntry> audit = [];
    private IReadOnlyList<AttachmentRecord> attachments = [];
    private IReadOnlyList<CommunicationEntry> communications = [];
    private string historyFilter = "all";
    private bool isSendEmailDrawerOpen;
    private bool isSendingEmail;
    private string? sendEmailError;
    private string emailTo = "";
    private string emailCc = "";
    private string emailBcc = "";
    private string emailSubject = "";
    private string emailBody = "";
    private string? emailInReplyTo;
    private string? uploadError;
    private bool uploadingAttachment;
    private string activeTab = "";
    private string? fatal, banner, conflict;
    private int fatalStatus = 404;
    private bool busy, savingNow, dirty;

    private readonly string sessionId = Guid.NewGuid().ToString("N");
    private IDisposable? presenceSub;
    private PeriodicTimer? heartbeatTimer;
    private CancellationTokenSource? presenceCts;
    private IReadOnlyList<DocumentPresenceUser> presenceUsers = [];

    private IReadOnlyList<DocumentPresenceUser> OtherEditingUsers =>
        presenceUsers.Where(u => u.SessionId != sessionId && u.Status == PresenceStatus.Editing).ToList();

    private bool IsNew => Name == "new" || (meta?.Def.IsSingle == true && (doc == null || doc.Version == 0));
    private UserContext User => Current.Required;

    private bool Editable => doc is not null && doc.DocStatus == DocStatus.Draft &&
        (IsNew ? Perms.Can(User, meta!, DocActions.Create)
               : Perms.Can(User, meta!, DocActions.Write) && Perms.InScope(User, meta!, DocActions.Write, doc.Owner, doc.Data));

    private Dictionary<string, object?> Scope
    {
        get { var tmp = doc!.Clone(); tmp.Data = model; return DocumentService.ScopeData(tmp); }
    }

    private FieldState State(CompiledField f) => Evaluator.StateOf(f, Scope, User);
    private bool Readable(CompiledField f) => Perms.CanReadField(User, meta!, f);
    private bool FieldReadOnly(CompiledField f, FieldState st) => !Editable || st.ReadOnly || !Perms.CanWriteField(User, meta!, f)
        || (!IsNew && meta!.Def.Naming.Pattern == $"field:{f.Name}"); // kode = nomor dokumen, tetap setelah disimpan
    private bool SectionVisible(LayoutSection s) => s.Columns.SelectMany(c => c.Fields).Any(f => Readable(f) && State(f).Visible);
    private bool TabVisible(LayoutTab t) => t.Sections.Any(SectionVisible);
    private static string Anchor(string path) => "f-" + path.Replace("[", "-").Replace("].", "-").Replace("]", "");

    private int TabErrorCount(LayoutTab t)
    {
        var names = t.Sections.SelectMany(s => s.Columns).SelectMany(c => c.Fields).Select(f => f.Name).ToHashSet();
        return errors.Keys.Count(k => names.Contains(k.Split('[', '.')[0]));
    }

    private List<Dictionary<string, object?>> Rows(CompiledField f)
    {
        if (model.GetValueOrDefault(f.Name) is not List<Dictionary<string, object?>> rows)
            model[f.Name] = rows = new List<Dictionary<string, object?>>();
        return rows;
    }

    private static string ActionLabel(string action) => action switch
    {
        DocActions.Submit => "Submit", DocActions.Cancel => "Cancel", DocActions.Amend => "Amend (create revision)", _ => action
    };

    private static string IconFor(ActionView a) => a.Tone switch
    {
        "negative" => "ban", "positive" => "check", _ when a.Action == DocActions.Amend => "rotate-ccw", _ => "send"
    };

    private IEnumerable<Framework.Actions.IFormAction> CustomActions =>
        !IsNew && doc is not null && User is not null
            ? (RegisteredFormActions ?? []).Where(a => string.Equals(a.DocType, DocType, StringComparison.Ordinal) && a.IsVisible(User, doc))
            : [];

    private async Task RunCustomAction(Framework.Actions.IFormAction action)
    {
        if (busy || doc is null || meta is null) return;
        busy = true;
        try
        {
            var ctx = new Framework.Actions.FormActionContext
            {
                User = User,
                Meta = meta,
                Doc = doc,
                Docs = Docs,
                Services = Sp
            };
            var result = await action.ExecuteAsync(ctx, CancellationToken.None);
            if (!string.IsNullOrWhiteSpace(result.Message))
            {
                if (result.Success) Toasts.Success(result.Message, action.Label);
                else Toasts.Error(result.Message, action.Label);
            }
            if (!string.IsNullOrWhiteSpace(result.RedirectUrl))
            {
                Nav.NavigateTo(result.RedirectUrl);
                return;
            }
            if (result.RefreshDocument)
            {
                await Load();
            }
        }
        catch (Exception ex)
        {
            Toasts.Error(ex.Message, action.Label);
        }
        finally
        {
            busy = false;
        }
    }

    // Blazor memanggil OnParametersSet setiap kali layout induk dirender ulang (mis. jumlah notifikasi berubah).
    // Muat ulang hanya bila parameter rute benar-benar berubah, agar isian/draft pengguna tidak hilang.
    private string? loadedKey;
    protected override async Task OnParametersSetAsync()
    {
        var key = $"{DocType}/{Name}";
        if (key == loadedKey) return;
        loadedKey = key;
        await Load();
    }

    private async Task Load()
    {
        fatal = null; banner = null; conflict = null; errors.Clear();
        await CleanupPresenceAsync();

        if (!Metadata.Current.TryGet(DocType, out var m) || m.Def.IsChild) { fatalStatus = 404; fatal = $"DocType '{DocType}' was not found."; return; }
        meta = m;
        try
        {
            doc = IsNew ? Docs.New(User, DocType) : await Docs.GetAsync(User, DocType, Name);
            model = Document.DeepCopy(doc.Data);
            // Pilih tab aktif SEBELUM await berikutnya: dengan database sungguhan Blazor bisa merender di tengah Load,
            // dan BbTabs memakai nilai awal Value. Tab kosong pada render pertama membuat isi form tersembunyi.
            if (activeTab == "" || (activeTab != HistoryTab && meta.Layout.All(t => t.Title != activeTab)))
                activeTab = meta.Layout.FirstOrDefault(TabVisible)?.Title ?? "";
            if (IsNew)
                foreach (var link in meta.Fields.Where(f => f.Def.Type == "Link" && model.GetValueOrDefault(f.Name) is not null).ToList())
                    await SetValue(link, model[link.Name]);
            original = Snapshot();
            dirty = false;
            actions = IsNew ? [] : await Docs.AvailableActionsAsync(User, doc);
            audit = IsNew ? [] : await Docs.GetAuditAsync(User, DocType, Name);
            attachments = IsNew ? [] : await Attachments.ListAsync(User, DocType, Name);
            communications = IsNew ? [] : await CommService.ListForDocumentAsync(User, DocType, Name);

            if (!IsNew)
            {
                presenceSub = Presence.Subscribe(User.TenantId, DocType, Name, OnPresenceChanged);
                presenceUsers = await Presence.HeartbeatAsync(User.TenantId, DocType, Name, sessionId, User, PresenceStatus.Viewing);
                StartHeartbeatLoop();
            }
        }
        catch (PermissionDeniedException ex)
        {
            fatalStatus = 403;
            fatal = ex.Message;
        }
        catch (DocumentNotFoundException ex)
        {
            fatalStatus = 404;
            fatal = ex.Message;
        }
    }

    private string Snapshot() => JsonSerializer.Serialize(model);

    private async Task SetValue(CompiledField f, object? value)
    {
        model[f.Name] = value;
        // Pratinjau fetchFrom dengan hak akses user (server tetap menghitung ulang saat simpan).
        foreach (var dep in meta!.Fields.Where(x => x.FetchFrom?.LinkField == f.Name))
        {
            object? fetched = null;
            if (value is string link)
            {
                try { fetched = (await Docs.GetAsync(User, f.Def.LinkTo!, link)).Data.GetValueOrDefault(dep.FetchFrom!.Value.TargetField); }
                catch (Exception ex) when (ex is DocumentNotFoundException or PermissionDeniedException) { }
            }
            model[dep.Name] = fetched;
        }
        await Changed();
    }

    private async Task Changed()
    {
        // Pratinjau compute di UI memakai engine ekspresi yang sama dengan server.
        Evaluator.ApplyCompute(meta!, model, User, Metadata.Current.Get);
        // Hapus error yang sudah tidak relevan: field-nya berubah sejak error muncul, atau syaratnya tidak lagi berlaku.
        foreach (var key in errors.Keys.ToList())
        {
            var root = key.Split('[', '.')[0];
            var changed = JsonSerializer.Serialize(model.GetValueOrDefault(root)) != (errorSnapshot.GetValueOrDefault(root) ?? "null");
            var noLongerRequired = meta!.ByName.TryGetValue(root, out var f) && (errors[key].Contains("wajib") || errors[key].Contains("required")) && !State(f).Required;
            if (changed || noLongerRequired) errors.Remove(key);
        }
        var wasDirty = dirty;
        dirty = Snapshot() != original;
        banner = null;

        if (!IsNew && dirty != wasDirty)
        {
            await UpdatePresenceStatusAsync(dirty ? PresenceStatus.Editing : PresenceStatus.Viewing);
        }
    }

    private Dictionary<string, object?> BuildPayload()
    {
        var before = JsonSerializer.Deserialize<Dictionary<string, JsonElement>>(original)!;
        var payload = new Dictionary<string, object?>();
        foreach (var f in meta!.Fields.Where(f => !f.IsDerived && Readable(f) && Perms.CanWriteField(User, meta, f)))
        {
            var now = model.GetValueOrDefault(f.Name);
            var was = before.TryGetValue(f.Name, out var w) ? w.GetRawText() : "null";
            if (IsNew || JsonSerializer.Serialize(now) != was)
                payload[f.Name] = f.Def.Type == "Table"
                    ? Rows(f).Select(r => r.Where(kv => kv.Key != "idx").ToDictionary(kv => kv.Key, kv => kv.Value)).ToList()
                    : now;
        }
        return payload;
    }

    private async Task Save()
    {
        busy = savingNow = true; errors.Clear(); banner = null; conflict = null;
        try
        {
            var payload = BuildPayload();
            if (IsNew)
            {
                var saved = await Docs.InsertAsync(User, DocType, payload);
                if (saved.TransientMessages.Count > 0)
                    foreach (var msg in saved.TransientMessages) Toasts.Info(msg);
                Toasts.Success($"{saved.Name} saved as draft.", "Saved");
                Nav.NavigateTo($"/app/{DocType}/{saved.Name}");
                return;
            }
            if (payload.Count == 0) return;
            var updated = await Docs.UpdateAsync(User, DocType, Name, doc!.Version, payload);
            if (updated.TransientMessages.Count > 0)
                foreach (var msg in updated.TransientMessages) Toasts.Info(msg);
            await Load();
            Toasts.Success("Changes saved.", Name);
        }
        catch (Exception ex) { HandleError(ex); }
        finally { busy = savingNow = false; }
    }

    private async Task RunAction(ActionView a)
    {
        string? comment = null;
        if (a.RequireComment)
        {
            // Validasi komentar dilakukan di sini (bukan Required pada prompt): BbInput meng-commit nilai saat blur,
            // sehingga Required membuat tombol konfirmasi tetap nonaktif selama pengguna masih mengetik.
            var prompt = await Dialogs.PromptAsync($"{a.Action} {doc!.Name}?", "Write a reason or note. This comment will be sent to the requester and recorded in history.",
                new PromptDialogOptions { Placeholder = "Reason…", ConfirmText = a.Action, CancelText = "Cancel", MaxLength = 1000 });
            if (prompt.Cancelled) return;
            if (string.IsNullOrWhiteSpace(prompt.Value))
            {
                Toasts.Error($"Action “{a.Action}” requires a reason. Nothing was changed.", "Empty comment");
                return;
            }
            comment = prompt.Value.Trim();
        }
        busy = true; errors.Clear(); banner = null; conflict = null;
        try
        {
            var result = await Docs.RunActionAsync(User, DocType, Name, a.Action, doc!.Version, comment);
            if (result.TransientMessages.Count > 0)
                foreach (var msg in result.TransientMessages) Toasts.Info(msg);
            if (result.Name != Name)
            {
                Toasts.Success($"Revision draft {result.Name} created.", "Amend");
                Nav.NavigateTo($"/app/{DocType}/{result.Name}");
                return;
            }
            await Load();
            Toasts.Success($"Status is now {Fmt.StateLabel(result.WorkflowState, result.DocStatus)}.", $"{ActionLabel(a.Action)} succeeded");
        }
        catch (Exception ex) { HandleError(ex); }
        finally { busy = false; }
    }

    private async Task Delete()
    {
        var confirm = await Dialogs.ConfirmAsync($"Delete {Name}?", "This draft will be deleted. Deletion history remains recorded.",
            new ConfirmDialogOptions { Destructive = true, ConfirmText = "Delete draft", CancelText = "Cancel" });
        if (!confirm.Confirmed) return;
        busy = true;
        try
        {
            await Docs.DeleteAsync(User, DocType, Name, doc!.Version);
            Toasts.Success($"{Name} deleted.", "Deleted");
            Nav.NavigateTo($"/app/{DocType}");
        }
        catch (Exception ex) { HandleError(ex); }
        finally { busy = false; }
    }

    private void HandleError(Exception ex)
    {
        switch (ex)
        {
            case ValidationFailedException v:
                foreach (var e in v.Errors) errors.TryAdd(e.Path, e.Message);
                errorSnapshot = model.ToDictionary(kv => kv.Key, kv => JsonSerializer.Serialize(kv.Value));
                if (errors.Remove("_comment", out var c)) banner = c;
                if (errors.Remove("_doc", out var d)) banner = d;
                break;
            case ConcurrencyException: conflict = ex.Message; break;
            case PermissionDeniedException or InvalidStateException or InvalidPayloadException or DocumentNotFoundException or LinkedDocumentException:
                banner = ex.Message; break;
            default: System.Runtime.ExceptionServices.ExceptionDispatchInfo.Capture(ex).Throw(); break;
        }
    }

    private async Task OnAttachmentSelected(InputFileChangeEventArgs e)
    {
        uploadError = null;
        uploadingAttachment = true;
        try
        {
            var file = e.File;
            if (file is null) return;
            using var stream = file.OpenReadStream(maxAllowedSize: AttachmentService.MaxAttachmentBytes);
            await Attachments.UploadAsync(User, DocType, Name, file.Name, stream);
            attachments = await Attachments.ListAsync(User, DocType, Name);
            Toasts.Success($"Attachment '{file.Name}' uploaded.", "Success");
        }
        catch (Exception ex)
        {
            uploadError = ex.Message;
        }
        finally
        {
            uploadingAttachment = false;
        }
    }

    private async Task DeleteAttachment(string id)
    {
        var confirm = await Dialogs.ConfirmAsync("Delete Attachment?", "This attachment will be permanently removed.",
            new ConfirmDialogOptions { Destructive = true, ConfirmText = "Delete", CancelText = "Cancel" });
        if (!confirm.Confirmed) return;

        try
        {
            await Attachments.DeleteAsync(User, id);
            attachments = await Attachments.ListAsync(User, DocType, Name);
            Toasts.Success("Attachment removed.", "Deleted");
        }
        catch (Exception ex)
        {
            uploadError = ex.Message;
        }
    }

    private static string FormatBytes(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024.0):F2} MB";
    }

    private void StartHeartbeatLoop()
    {
        presenceCts?.Cancel();
        presenceCts = new CancellationTokenSource();
        heartbeatTimer?.Dispose();
        heartbeatTimer = new PeriodicTimer(TimeSpan.FromSeconds(10));
        var ct = presenceCts.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                while (await heartbeatTimer.WaitForNextTickAsync(ct))
                {
                    if (ct.IsCancellationRequested) break;
                    var status = dirty ? PresenceStatus.Editing : PresenceStatus.Viewing;
                    await Presence.HeartbeatAsync(User.TenantId, DocType, Name, sessionId, User, status, ct);
                }
            }
            catch (OperationCanceledException) { }
            catch { }
        }, ct);
    }

    private async Task UpdatePresenceStatusAsync(PresenceStatus status)
    {
        try
        {
            presenceUsers = await Presence.HeartbeatAsync(User.TenantId, DocType, Name, sessionId, User, status);
        }
        catch { }
    }

    private void OnPresenceChanged(PresenceChange change)
    {
        _ = InvokeAsync(() =>
        {
            presenceUsers = change.ActiveUsers;
            StateHasChanged();
        });
    }

    private async ValueTask CleanupPresenceAsync()
    {
        presenceSub?.Dispose();
        presenceSub = null;

        if (presenceCts is not null)
        {
            presenceCts.Cancel();
            presenceCts.Dispose();
            presenceCts = null;
        }

        if (heartbeatTimer is not null)
        {
            heartbeatTimer.Dispose();
            heartbeatTimer = null;
        }

        if (!IsNew && doc is not null)
        {
            try
            {
                await Presence.LeaveAsync(User.TenantId, DocType, Name, sessionId);
            }
            catch { }
        }
    }

    private bool isAutoRepeatDrawerOpen;
    private string autoRepeatName = "";
    private string autoRepeatFreqStr = nameof(AutoRepeatFrequency.Monthly);
    private string autoRepeatStartDateStr = "";
    private bool autoRepeatSubmitOnCreation;
    private string? autoRepeatError;

    private static readonly IReadOnlyList<SelectOption<string>> AutoRepeatFreqOptions =
    [
        new(nameof(AutoRepeatFrequency.Daily), "Daily"),
        new(nameof(AutoRepeatFrequency.Weekly), "Weekly"),
        new(nameof(AutoRepeatFrequency.Monthly), "Monthly"),
        new(nameof(AutoRepeatFrequency.Quarterly), "Quarterly"),
        new(nameof(AutoRepeatFrequency.Yearly), "Yearly")
    ];

    private void OpenAutoRepeatDrawer()
    {
        autoRepeatName = $"Repeat: {meta?.Title} ({Name})";
        autoRepeatFreqStr = nameof(AutoRepeatFrequency.Monthly);
        autoRepeatStartDateStr = DateOnly.FromDateTime(DateTime.UtcNow).ToString("yyyy-MM-dd");
        autoRepeatSubmitOnCreation = false;
        autoRepeatError = null;
        isAutoRepeatDrawerOpen = true;
    }

    private async Task SaveQuickAutoRepeat()
    {
        autoRepeatError = null;
        if (!DateOnly.TryParse(autoRepeatStartDateStr, out var startDate))
        {
            autoRepeatError = "Invalid start date format (YYYY-MM-DD).";
            return;
        }

        if (!Enum.TryParse<AutoRepeatFrequency>(autoRepeatFreqStr, out var freq))
        {
            autoRepeatError = "Invalid frequency selected.";
            return;
        }

        try
        {
            var req = new SaveAutoRepeatRequest(
                Id: null,
                Name: autoRepeatName,
                ReferenceDocType: DocType,
                ReferenceDocName: Name,
                Frequency: freq,
                StartDate: startDate,
                EndDate: null,
                RunAsUserId: User.Id,
                SubmitOnCreation: autoRepeatSubmitOnCreation
            );

            await AutoRepeatService.SaveAsync(User, req);
            isAutoRepeatDrawerOpen = false;
            Toasts.Success($"Auto Repeat schedule created for {Name}.", "Auto Repeat");
        }
        catch (Exception ex)
        {
            autoRepeatError = ex.Message;
        }
    }

    private void OpenSendEmailDrawer()
    {
        sendEmailError = null;
        emailTo = "";
        emailCc = "";
        emailBcc = "";
        emailSubject = $"[#{Name}] {meta?.Title ?? DocType}";
        emailBody = "";
        emailInReplyTo = null;
        isSendEmailDrawerOpen = true;
    }

    private void ReplyToEmail(CommunicationEntry comm)
    {
        sendEmailError = null;
        emailTo = comm.Sender;
        emailCc = "";
        emailBcc = "";
        emailSubject = comm.Subject.StartsWith("Re:", StringComparison.OrdinalIgnoreCase) ? comm.Subject : $"Re: {comm.Subject}";
        if (!emailSubject.Contains($"[#{Name}]"))
            emailSubject = $"[#{Name}] " + emailSubject;
        emailBody = $"\n\n--- On {comm.OccurredAt:yyyy-MM-dd HH:mm}, {comm.Sender} wrote:\n> " + (comm.ContentText ?? "").Replace("\n", "\n> ");
        emailInReplyTo = comm.MessageId;
        isSendEmailDrawerOpen = true;
    }

    private async Task SendEmailAsync()
    {
        sendEmailError = null;
        if (string.IsNullOrWhiteSpace(emailTo))
        {
            sendEmailError = "Recipient email (To) is required.";
            return;
        }
        if (string.IsNullOrWhiteSpace(emailSubject))
        {
            sendEmailError = "Subject is required.";
            return;
        }
        if (string.IsNullOrWhiteSpace(emailBody))
        {
            sendEmailError = "Message body cannot be empty.";
            return;
        }

        isSendingEmail = true;
        try
        {
            var msg = new EmailMessage
            {
                To = emailTo.Split([';', ','], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList(),
                Cc = emailCc.Split([';', ','], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList(),
                Bcc = emailBcc.Split([';', ','], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList(),
                Subject = emailSubject.Trim(),
                BodyText = emailBody,
                BodyHtml = $"<div style=\"font-family:sans-serif;\">{emailBody.Replace("\n", "<br/>")}</div>",
                InReplyTo = emailInReplyTo,
                ReferenceDocType = DocType,
                ReferenceName = Name,
                From = User.Attr("email")
            };

            await EmailQueue.QueueAsync(User.TenantId, msg);
            Toasts.Success("Email queued for sending.", "Queued");
            isSendEmailDrawerOpen = false;
            communications = await CommService.ListForDocumentAsync(User, DocType, Name);
        }
        catch (Exception ex)
        {
            sendEmailError = "Failed to queue email: " + ex.Message;
        }
        finally
        {
            isSendingEmail = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        await CleanupPresenceAsync();
    }
}

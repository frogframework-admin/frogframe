    private string UserDisplayName(string userId) =>
        mentionUsers.FirstOrDefault(u => string.Equals(u.Id, userId, StringComparison.OrdinalIgnoreCase))?.FullName ?? userId;

    private static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 1
            ? parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant()
            : $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[^1][0])}";
    }

    private static BadgeVariant PriorityBadgeVariant(AssignmentPriority p) => p switch
    {
        AssignmentPriority.High => BadgeVariant.Destructive,
        AssignmentPriority.Low => BadgeVariant.Outline,
        _ => BadgeVariant.Secondary
    };


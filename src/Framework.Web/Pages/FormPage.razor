@page "/app/{DocType}/{Name}"
@implements IAsyncDisposable
@using System.Text.Json
@using Framework.Communication
@using Framework.Email
@using Framework.Files
@using Framework.Presence
@using Framework.Integrations
@using Framework.Notifications
@using Framework.Web.Printing
@using Microsoft.Extensions.Configuration
@inject DocumentService Docs
@inject CurrentUser Current
@inject IMetadataProvider Metadata
@inject IPermissionService Perms
@inject DocumentEvaluator Evaluator
@inject NavigationManager Nav
@inject DialogService Dialogs
@inject ToastService Toasts
@inject IEnumerable<Framework.Actions.IFormAction> RegisteredFormActions
@inject IServiceProvider Sp
@inject AttachmentService Attachments
@inject IDocumentPresenceService Presence
@inject AutoRepeatService AutoRepeatService
@inject CommunicationService CommService
@inject IEmailQueue EmailQueue
@inject PrintService PrintSvc
@inject PrintHtmlRenderer PrintHtml
@inject IPdfRenderer PdfRenderer
@inject IUserDirectory Users
@inject AssignmentService AssignmentsSvc
@inject INotificationLiveFeed LiveNotifications
@inject UiText T
@inject IConfiguration Config
@inject SystemConnectivityService Connectivity

<PageTitle>@(meta is null ? Name : meta.Def.IsSingle ? T.Title(meta) : IsNew ? T.Format("New {0}", T.Title(meta)) : Name) · FrogFrame</PageTitle>

<NavigationLock ConfirmExternalNavigation="@dirty" OnBeforeInternalNavigation="OnBeforeInternalNavigation" />

@if (fatal is not null)
{
    <ErrorState StatusCode="@fatalStatus"
                Title="@(T[fatalStatus == 403 ? "Access Denied" : "Document Not Found"])"
                Description="@(T.Message(fatal))"
                BackHref="@(meta is not null ? $"/app/{meta.Name}" : "/")"
                BackLabel="@(meta is not null ? T.Format("Back to {0}", T.Title(meta)) : T["Back to Home"])" />
}
else if (meta is not null && doc is not null)
{
    <header class="doc-head">
        <div>
            <h1>@(meta.Def.IsSingle ? T.Title(meta) : IsNew ? T.Format("New {0}", T.Title(meta)) : doc.Name)</h1>
            <p>
                @if (meta.Def.IsSingle && IsNew)
                {
                    <span>@T["Default configuration (not saved yet)"]</span>
                }
                else if (!IsNew)
                {
                    <span>@T.Format("Created by {0} · modified {1} · version {2}", doc.Owner, Fmt.When(doc.Modified), doc.Version)</span>
                    @if (doc.AmendedFrom is not null) { <span> · @T["amended from"] <a href="/app/@meta.Name/@doc.AmendedFrom">@doc.AmendedFrom</a></span> }
                }
                else { <span>@T["Not saved yet"]</span> }
            </p>
        </div>
        <div class="row" style="gap:.75rem;align-items:center;flex-wrap:wrap">
            @if (!IsNew && OpenAssignments.Count > 0)
            {
                <button type="button"
                        class="assignment-strip"
                        @onclick="OpenAssignDrawer"
                        title="@(T["Manage document assignments"])">
                    <span class="assignment-strip-avatars">
                        @foreach (var a in OpenAssignments.Take(3))
                        {
                            <span class="assignment-avatar-chip">@Initials(UserDisplayName(a.AssignedTo))</span>
                        }
                        @if (OpenAssignments.Count > 3)
                        {
                            <span class="assignment-avatar-chip">+@(OpenAssignments.Count - 3)</span>
                        }
                    </span>
                    <span class="assignment-strip-text">
                        @if (OpenAssignments.Count == 1)
                        {
                            @T.Format("Assigned to {0}", UserDisplayName(OpenAssignments[0].AssignedTo))
                        }
                        else
                        {
                            @T.Format("{0} assignees", OpenAssignments.Count)
                        }
                    </span>
                    @if (OpenAssignments.Any(a => a.IsOverdue(AssignmentsSvc.Today)))
                    {
                        <BbBadge Variant="BadgeVariant.Destructive">@T["Overdue"]</BbBadge>
                    }
                    else if (OpenAssignments.Any(a => a.IsDueToday(AssignmentsSvc.Today)))
                    {
                        <BbBadge Variant="BadgeVariant.Secondary">@T["Due today"]</BbBadge>
                    }
                </button>
            }
            @if (!IsNew)
            {
                <DocumentPresenceBar Users="@presenceUsers" CurrentSessionId="@sessionId" CurrentUserId="@User.Id" />
            }
            @if (HasStatus && (!IsNew || meta?.Workflow is not null))
            {
                <StatusStamp Label="@(T.State(doc.WorkflowState, doc.DocStatus))" Tone="@Fmt.Tone(meta, doc)" />
            }
        </div>
    </header>

    <div class="toolbar" role="toolbar" aria-label="@(T["Document actions"])">
        @if (Editable)
        {
            <BbButton Disabled="@(busy || (!IsNew && !dirty))" Loading="@(busy && savingNow)" LoadingText="@(T["Saving…"])" OnClick="Save">
                <LucideIcon Name="check" Size="16" /> @T[IsNew ? (HasStatus ? "Save draft" : "Save") : dirty ? "Save changes" : "Saved"]
            </BbButton>
        }
        @foreach (var a in actions)
        {
            var act = a;
            <BbButton Variant="@Fmt.ButtonFor(act.Tone)" Disabled="@(busy || dirty)" OnClick="() => RunAction(act)"
                      AdditionalAttributes="@(new Dictionary<string, object> { ["title"] = dirty ? T["Save changes first"] : T.Format("Move to {0}", T[act.ToState]) })">
                <LucideIcon Name="@IconFor(act)" Size="16" /> @ActionLabel(act.Action)
            </BbButton>
        }
        @foreach (var ca in CustomActions)
        {
            var customAct = ca;
            <BbButton Variant="@Fmt.ButtonFor(customAct.Tone)" Disabled="@(busy || dirty)" OnClick="() => RunCustomAction(customAct)">
                <LucideIcon Name="@customAct.Icon" Size="16" /> @T[customAct.Label]
            </BbButton>
        }
        @if (!IsNew)
        {
            <BbButton Variant="ButtonVariant.Outline" Href="@($"/print/{DocType}/{Name}")" Disabled="@dirty"
                      AdditionalAttributes="@(new Dictionary<string, object> { ["target"] = "_blank", ["title"] = T["A4 print preview"] })">
                <LucideIcon Name="printer" Size="16" /> @T["Print"]
            </BbButton>
            @if (meta.AllowAutoRepeat)
            {
                <BbButton Variant="ButtonVariant.Ghost" Disabled="@dirty" OnClick="OpenAutoRepeatDrawer"
                          AdditionalAttributes="@(new Dictionary<string, object> { ["title"] = T["Configure recurring schedule"] })">
                    <LucideIcon Name="repeat" Size="16" /> @T["Repeat"]
                </BbButton>
            }
            <BbButton Variant="ButtonVariant.Ghost" Disabled="@dirty" OnClick="OpenSendEmailDrawer"
                      AdditionalAttributes="@(new Dictionary<string, object> { ["title"] = T["Send email regarding this document"] })">
                <LucideIcon Name="mail" Size="16" /> @T["Email"]
            </BbButton>
            <BbButton Variant="ButtonVariant.Ghost" Disabled="@dirty" OnClick="OpenAssignDrawer"
                      AdditionalAttributes="@(new Dictionary<string, object> { ["title"] = T["Assign document to users"] })">
                <LucideIcon Name="user-plus" Size="16" /> @T["Assign"]@(OpenAssignments.Count > 0 ? $" ({OpenAssignments.Count})" : "")
            </BbButton>
            @if (!meta.Def.IsSingle)
            {
                <BbButton Variant="ButtonVariant.Ghost" OnClick="@(() => isShareDrawerOpen = true)"
                          AdditionalAttributes="@(new Dictionary<string, object> { ["title"] = T["Share this document with specific people"] })">
                    <LucideIcon Name="share-2" Size="16" /> @T["Share"]
                </BbButton>
            }
        }
        @if (!IsNew && !meta.Def.IsSingle && doc.DocStatus == DocStatus.Draft && meta.Def.Document.AllowDelete && Perms.Can(User, meta, DocActions.Delete))
        {
            <BbButton Variant="ButtonVariant.Ghost" Disabled="@busy" OnClick="Delete">
                <LucideIcon Name="trash-2" Size="16" /> @T[HasStatus ? "Delete draft" : "Delete"]
            </BbButton>
        }
        @if (!Editable && !IsNew && doc.DocStatus != DocStatus.Draft)
        {
            <span class="muted small">@T.Format("Document is locked with status {0}.", T.State(doc.WorkflowState, doc.DocStatus))</span>
        }
    </div>

    @if (!IsNew && !meta.Def.IsSingle)
    {
        <DocSocialBar DocType="@DocType" Name="@Name" />
    }

    @if (!IsNew && OtherEditingUsers.Count > 0)
    {
        var editors = string.Join(", ", OtherEditingUsers.Select(u => u.FullName));
        <div class="presence-warning-banner" role="alert">
            <LucideIcon Name="alert-triangle" Size="18" Class="presence-warning-icon" />
            <div class="presence-warning-content">
                <strong>@T["Another user is editing this document"]</strong>
                <span><strong>@editors</strong> @T["is editing this document right now. Saving at the same time may cause a version conflict."]</span>
            </div>
        </div>
    }

    @if (conflict is not null)
    {
        <BbAlert Variant="AlertVariant.Warning" Class="crumbs">
            <ChildContent>
                <BbAlertTitle>@T["Version conflict"]</BbAlertTitle>
                <BbAlertDescription>@T.Message(conflict)</BbAlertDescription>
            </ChildContent>
            <Actions><BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="Load">@T["Reload latest version"]</BbButton></Actions>
        </BbAlert>
    }
    @if (banner is not null)
    {
        <BbAlert Variant="AlertVariant.Danger" Class="crumbs"><BbAlertDescription>@T.Message(banner)</BbAlertDescription></BbAlert>
    }
    @if (errors.Count > 0)
    {
        <BbAlert Variant="AlertVariant.Danger" Class="crumbs">
            <BbAlertTitle>@T.Format("Please check the following {0} field(s) before saving", errors.Count)</BbAlertTitle>
            <BbAlertDescription>
                <ul class="error-list">@foreach (var e in errors) { <li><a href="#@Anchor(e.Key)">@e.Value</a></li> }</ul>
            </BbAlertDescription>
        </BbAlert>
    }

    @* Client Scripts: Select options narrowed by a script reach FieldInput through this cascading value. *@
    <CascadingValue Value="@scriptFormState" IsFixed="true">
    <BbTabs Value="@activeTab" ValueChanged="v => activeTab = v ?? activeTab">
        <BbTabsList>
            @foreach (var t in meta.Layout.Where(TabVisible))
            {
                <BbTabsTrigger Value="@t.Title">@T[t.Title]@if (TabErrorCount(t) is > 0 and var n) { <span class="tab-count">@n</span> }</BbTabsTrigger>
            }
            @if (!IsNew)
            {
                <BbTabsTrigger Value="@AttachmentsTab">@T["Attachments"] (@attachments.Count)</BbTabsTrigger>
                <BbTabsTrigger Value="@HistoryTab">@T["History & Comments"] (@audit.Count)</BbTabsTrigger>
            }
        </BbTabsList>

        @foreach (var tab in meta.Layout.Where(TabVisible))
        {
            <BbTabsContent Value="@tab.Title">
                <div class="stack" style="margin-top:.75rem">
                    @foreach (var sec in tab.Sections.Where(SectionVisible).Select(T.Section))
                    {
                        <BbCard>
                            @if (sec.Title is not null) { <BbCardHeader><BbCardTitle Class="card-title">@sec.Title</BbCardTitle></BbCardHeader> }
                            <BbCardContent Style="@(sec.Title is null ? "padding-top:1.5rem" : null)">
                                @if (sec.SubTab is not null)
                                {
                                    @* Tabs inside the section: only the selected inner tab's fields are rendered below. *@
                                    @if (sec.ShowParentTitle && sec.ParentTitle is not null) { <div class="card-title subtab-title">@sec.ParentTitle</div> }
                                    <SubTabStrip Tabs="@VisibleSubTabs(sec)" Active="@ActiveSubTab(sec)" Errors="@(name => SubTabErrorCount(sec, name))" Label="@(name => T[name])"
                                                 AriaLabel="@(sec.ParentTitle ?? "Tabs")" OnSelect="@(name => SelectSubTab(sec, name))" />
                                }
                                <div class="form-cols cols-@sec.Columns.Count">
                                    @foreach (var col in sec.Columns)
                                    {
                                        <div class="form-col">
                                            @foreach (var f in col.Fields.Where(Readable))
                                            {
                                                var st = State(f);
                                                if (!st.Visible) continue;
                                                var err = errors.GetValueOrDefault(f.Name);
                                                var ro = FieldReadOnly(f, st);
                                                <div id="@Anchor(f.Name)" class="@(f.Def.PermLevel > 0 ? "restricted" : "")">
                                                    <BbField IsInvalid="@(err is not null)">
                                                        @if (f.Type.Editor != "check" && !f.IsLayout && !(f.Def.Type == "Table" && f.Label == sec.Title))
                                                        {
                                                            <BbFieldLabel For="@f.Name">
                                                                <span class="label-row">
                                                                    @f.Label@if (st.Required && !ro) { <span class="req" aria-label="required">*</span> }
                                                                    @if (f.IsDerived) { <BbBadge Variant="BadgeVariant.Soft">@(f.Compute is not null ? "computed" : $"from {f.FetchFrom!.Value.LinkField}")</BbBadge> }
                                                                    @if (f.Def.PermLevel > 0) { <BbBadge Variant="BadgeVariant.Outline">restricted</BbBadge> }
                                                                </span>
                                                            </BbFieldLabel>
                                                        }
                                                        @if (f.Def.Type == "Table")
                                                        {
                                                            <ChildTable Table="f" ChildMeta="Metadata.Current.Get(f.Def.ChildDocType!)" Rows="Rows(f)" Parent="Scope"
                                                                        ReadOnly="ro" Errors="errors" OnChanged="@(() => OnTableChanged(f))" />
                                                        }
                                                        else
                                                        {
                                                            <FieldInput Field="f" Id="@f.Name" DocType="@meta.Name" Value="model.GetValueOrDefault(f.Name)" ReadOnly="ro" Invalid="@(err is not null)"
                                                                        ValueChanged="v => SetValue(f, v)" Data="model" OnButton="RunButtonField" />
                                                        }
                                                        @if (err is not null) { <BbFieldError Errors="@(new[] { err })" /> }
                                                        else if (f.Def.Description is not null && !ro) { <BbFieldDescription>@f.Def.Description</BbFieldDescription> }
                                                        @if (err is null && !ro && scriptNotes.GetValueOrDefault(f.Name) is { Length: > 0 } note) { <BbFieldDescription>@note</BbFieldDescription> }
                                                    </BbField>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </BbCardContent>
                        </BbCard>
                    }
                </div>
            </BbTabsContent>
        }
        @if (!IsNew)
        {
            <BbTabsContent Value="@AttachmentsTab">
                <BbCard Class="crumbs" Style="margin-top:.75rem">
                    <BbCardHeader>
                        <BbCardTitle Class="card-title">@T["Document Attachments"]</BbCardTitle>
                        <BbCardDescription>@T["Supported formats: PDF, Office (.docx, .xlsx), CSV, plain text, PNG, JPEG, WebP, GIF (Max 10 MB per file)."]</BbCardDescription>
                    </BbCardHeader>
                    <BbCardContent>
                        @if (!string.IsNullOrEmpty(uploadError))
                        {
                            <BbAlert Variant="AlertVariant.Danger" Style="margin-bottom:1rem">
                                <BbAlertDescription>@T.Message(uploadError)</BbAlertDescription>
                            </BbAlert>
                        }

                        <div style="display:flex;gap:1rem;align-items:center;margin-bottom:1.25rem;">
                            <InputFile OnChange="OnAttachmentSelected" disabled="@uploadingAttachment" class="form-control" />
                            @if (uploadingAttachment)
                            {
                                <span>@T["Uploading..."]</span>
                            }
                        </div>

                        @if (attachments.Count == 0)
                        {
                            <div style="color:var(--bb-muted-foreground);padding:1rem 0;">@T["No attachments uploaded for this document yet."]</div>
                        }
                        else
                        {
                            <table class="table" style="width:100%;border-collapse:collapse;">
                                <thead>
                                    <tr style="text-align:left;border-bottom:1px solid var(--bb-border);">
                                        <th style="padding:0.5rem;">@T["File Name"]</th>
                                        <th style="padding:0.5rem;">@T["Type"]</th>
                                        <th style="padding:0.5rem;">@T["Size"]</th>
                                        <th style="padding:0.5rem;">@T["Uploaded By"]</th>
                                        <th style="padding:0.5rem;">@T["Date"]</th>
                                        <th style="padding:0.5rem;text-align:right;">@T["Actions"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var att in attachments)
                                    {
                                        <tr style="border-bottom:1px solid var(--bb-border);">
                                            <td style="padding:0.5rem;font-weight:500;">
                                                <a href="/api/files/attachment/@att.Id" target="_blank" rel="noopener noreferrer">@att.FileName</a>
                                            </td>
                                            <td style="padding:0.5rem;font-size:0.875rem;color:var(--bb-muted-foreground);">@att.ContentType</td>
                                            <td style="padding:0.5rem;font-size:0.875rem;">@FormatBytes(att.Size)</td>
                                            <td style="padding:0.5rem;font-size:0.875rem;">@att.UploadedBy</td>
                                            <td style="padding:0.5rem;font-size:0.875rem;">@att.CreatedAt.ToLocalTime().ToString("g")</td>
                                            <td style="padding:0.5rem;text-align:right;">
                                                <a href="/api/files/attachment/@att.Id" target="_blank" class="btn btn-sm btn-outline-secondary" download="@att.FileName">@T["Download"]</a>
                                                <button type="button" class="btn btn-sm btn-outline-danger" style="margin-left:0.5rem;" @onclick="() => DeleteAttachment(att.Id)">@T["Delete"]</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </BbCardContent>
                </BbCard>
            </BbTabsContent>
            <BbTabsContent Value="@HistoryTab">
                <BbCard Class="crumbs" Style="margin-top:.75rem">
                    <BbCardContent>
                        <div style="padding:1rem 0;border-bottom:1px solid var(--bb-border);margin-bottom:1rem;position:relative">
                            <div style="display:flex;flex-direction:column;gap:.5rem" @onkeydown="OnCommentKeyDown">
                                <BbTextarea @ref="commentTextarea"
                                            Value="@newComment"
                                            ValueChanged="OnCommentChanged"
                                            UpdateTiming="UpdateTiming.Immediate"
                                            Rows="3"
                                            MaxLength="@DocumentComments.MaxLength"
                                            Placeholder="@(T["Add a comment… Type @ to mention a teammate or @everyone. (Ctrl+Enter to post)"])" />
                                @if (showMentionPicker)
                                {
                                    var filteredUsers = FilteredMentionUsers;
                                    var showEveryone = MatchesMentionQuery(DocumentComments.EveryoneToken, "Everyone with access");
                                    <div style="border:1px solid var(--border);border-radius:var(--radius);background:var(--popover, var(--card));color:var(--popover-foreground, var(--foreground));box-shadow:0 6px 20px rgba(0,0,0,.12);max-height:14rem;overflow-y:auto;padding:.25rem;display:flex;flex-direction:column;gap:.15rem">
                                        <div class="muted small" style="padding:.25rem .5rem;font-weight:600">
                                            @T["Mention someone"]
                                            @if (!string.IsNullOrEmpty(mentionQuery))
                                            {
                                                <span> · @@<span>@mentionQuery</span></span>
                                            }
                                        </div>
                                        @if (showEveryone)
                                        {
                                            <button type="button"
                                                    class="mention-option-btn"
                                                    @onmousedown:preventDefault="true"
                                                    @onclick="() => InsertMention(DocumentComments.EveryoneToken)"
                                                    style="display:flex;align-items:center;justify-content:space-between;gap:.5rem;width:100%;text-align:left;padding:.45rem .6rem;border:0;border-radius:calc(var(--radius) - 2px);background:transparent;color:inherit;cursor:pointer">
                                                <span><strong style="color:#dc2626">@@@DocumentComments.EveryoneToken</strong> <span class="muted small">· @T["Notify everyone with access"]</span></span>
                                                <BbBadge Variant="BadgeVariant.Secondary">@T["All"]</BbBadge>
                                            </button>
                                        }
                                        @foreach (var mu in filteredUsers)
                                        {
                                            <button type="button"
                                                    class="mention-option-btn"
                                                    @onmousedown:preventDefault="true"
                                                    @onclick="() => InsertMention(mu.Id)"
                                                    style="display:flex;align-items:center;justify-content:space-between;gap:.5rem;width:100%;text-align:left;padding:.45rem .6rem;border:0;border-radius:calc(var(--radius) - 2px);background:transparent;color:inherit;cursor:pointer">
                                                <span><strong>@@@mu.Id</strong> <span class="muted small">· @mu.FullName</span></span>
                                                <span class="muted small">@string.Join(", ", mu.Roles.Take(2))</span>
                                            </button>
                                        }
                                        @if (!showEveryone && filteredUsers.Count == 0)
                                        {
                                            <div class="muted small" style="padding:.45rem .6rem">@T["No matching users"]</div>
                                        }
                                    </div>
                                }
                                <div style="display:flex;justify-content:space-between;align-items:center;gap:.5rem;flex-wrap:wrap">
                                    <div style="display:flex;align-items:center;gap:.35rem;flex-wrap:wrap">
                                        <BbButton Size="ButtonSize.Small" Variant="ButtonVariant.Ghost" OnClick="ToggleMentionPicker">
                                            <LucideIcon Name="at-sign" Size="14" /> @T["Mention"]
                                        </BbButton>
                                        <span class="muted small">@T["Type @ to pick a teammate or @everyone"]</span>
                                    </div>
                                    <div style="display:flex;align-items:center;gap:.75rem">
                                        <span class="muted small" style="@(newComment.Length >= DocumentComments.MaxLength ? "color:#dc2626;font-weight:600" : "")">
                                            @newComment.Length / @DocumentComments.MaxLength
                                        </span>
                                        <BbButton Size="ButtonSize.Small"
                                                  Disabled="@(postingComment || string.IsNullOrWhiteSpace(newComment) || newComment.Length > DocumentComments.MaxLength)"
                                                  Loading="@postingComment"
                                                  LoadingText="@(T["Posting…"])"
                                                  OnClick="PostCommentAsync">
                                            <LucideIcon Name="message-square" Size="14" /> @T["Post Comment"]
                                        </BbButton>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div style="display:flex;justify-content:space-between;align-items:center;padding:.5rem 0 1rem;border-bottom:1px solid var(--bb-border);margin-bottom:1rem;flex-wrap:wrap;gap:.5rem">
                            <div style="display:flex;gap:.5rem;flex-wrap:wrap">
                                <BbButton Size="ButtonSize.Small" Variant="@(historyFilter == "all" ? ButtonVariant.Default : ButtonVariant.Outline)" OnClick='() => SetHistoryFilter("all")'>@T["All Activity"] (@audit.Count)</BbButton>
                                <BbButton Size="ButtonSize.Small" Variant="@(historyFilter == "comments" ? ButtonVariant.Default : ButtonVariant.Outline)" OnClick='() => SetHistoryFilter("comments")'>@T["Comments"] (@CommentCount)</BbButton>
                                <BbButton Size="ButtonSize.Small" Variant="@(historyFilter == "audit" ? ButtonVariant.Default : ButtonVariant.Outline)" OnClick='() => SetHistoryFilter("audit")'>@T["Audit Log"] (@AuditOnlyCount)</BbButton>
                            </div>
                            <div style="min-width:14rem;flex:1;max-width:20rem">
                                <BbInput Value="@historySearchQuery"
                                         ValueChanged="OnHistorySearchChanged"
                                         UpdateTiming="UpdateTiming.Immediate"
                                         Placeholder="@(T["Search history & comments…"])"
                                         AriaLabel="@(T["Search history & comments"])" />
                            </div>
                        </div>

                        <div style="padding-top:.5rem">
                            <AuditTimeline Entries="PagedAudit" CurrentUserId="@User.Id" />
                            @if (HasMoreHistory)
                            {
                                <div style="display:flex;justify-content:center;padding:.75rem 0 0">
                                    <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="LoadMoreHistory">
                                        @T["Load more"] (@PagedAudit.Count / @FilteredAudit.Count)
                                    </BbButton>
                                </div>
                            }
                        </div>
                    </BbCardContent>
                </BbCard>
            </BbTabsContent>
        }
    </BbTabs>
    </CascadingValue>

    @if (!IsNew && meta?.AllowAutoRepeat == true)
    {
        <AdminDrawer Open="@isAutoRepeatDrawerOpen"
                     OpenChanged="v => isAutoRepeatDrawerOpen = v"
                     Title="@($"{T["Auto Repeat"]} · {Name}")"
                     WidthScale="1.4">
            <ChildContent>
                @if (autoRepeatError is not null)
                {
                    <BbAlert Variant="AlertVariant.Danger" Style="margin-bottom:1rem">
                        <BbAlertDescription>@T.Message(autoRepeatError)</BbAlertDescription>
                    </BbAlert>
                }
                <div style="display:flex;flex-direction:column;gap:1rem">
                    <div>
                        <label class="form-label" style="display:block;margin-bottom:.35rem;font-weight:600">@T["Schedule Name"]</label>
                        <BbInput @bind-Value="autoRepeatName" Placeholder="@(T["e.g. Monthly Recurring"])" />
                    </div>
                    <div class="row" style="gap:1rem">
                        <div style="flex:1">
                            <label class="form-label" style="display:block;margin-bottom:.35rem;font-weight:600">@T["Frequency"]</label>
                            <BbSelect TValue="string" @bind-Value="autoRepeatFreqStr" Options="AutoRepeatFreqOptions" />
                        </div>
                        <div style="flex:1">
                            <label class="form-label" style="display:block;margin-bottom:.35rem;font-weight:600">@T["Start Date"]</label>
                            <BbInput @bind-Value="autoRepeatStartDateStr" Placeholder="YYYY-MM-DD" />
                        </div>
                    </div>
                    <div style="display:flex;align-items:center;gap:.75rem">
                        <BbSwitch @bind-Value="autoRepeatSubmitOnCreation" Id="form-auto-repeat-submit" />
                        <label for="form-auto-repeat-submit" style="cursor:pointer;font-weight:500">@T["Submit on creation"]</label>
                    </div>
                </div>
            </ChildContent>
            <FooterContent>
                <div style="display:flex;justify-content:flex-end;gap:.5rem;width:100%">
                    <BbButton Variant="ButtonVariant.Ghost" OnClick="() => isAutoRepeatDrawerOpen = false">@T["Cancel"]</BbButton>
                    <BbButton OnClick="SaveQuickAutoRepeat">@T["Save Schedule"]</BbButton>
                </div>
            </FooterContent>
        </AdminDrawer>
    }

    @if (!IsNew)
    {
        <AdminDrawer Open="@isSendEmailDrawerOpen"
                     OpenChanged="v => isSendEmailDrawerOpen = v"
                     Title="@($"{T["Send Email"]} · {Name}")"
                     WidthScale="1.4">
            <ChildContent>
                @if (sendEmailError is not null)
                {
                    <BbAlert Variant="AlertVariant.Danger" Style="margin-bottom:1rem">
                        <BbAlertDescription>@T.Message(sendEmailError)</BbAlertDescription>
                    </BbAlert>
                }
                <div style="display:flex;flex-direction:column;gap:1rem">
                    <div>
                        <label class="form-label" style="display:block;margin-bottom:.35rem;font-weight:600">@T["To * (comma/semicolon separated)"]</label>
                        <BbInput @bind-Value="emailTo" Placeholder="recipient@example.com" />
                    </div>
                    <div class="row" style="gap:1rem">
                        <div style="flex:1">
                            <label class="form-label" style="display:block;margin-bottom:.35rem;font-weight:600">@T["Cc"]</label>
                            <BbInput @bind-Value="emailCc" Placeholder="cc@example.com" />
                        </div>
                        <div style="flex:1">
                            <label class="form-label" style="display:block;margin-bottom:.35rem;font-weight:600">@T["Bcc"]</label>
                            <BbInput @bind-Value="emailBcc" Placeholder="bcc@example.com" />
                        </div>
                    </div>
                    <div>
                        <label class="form-label" style="display:block;margin-bottom:.35rem;font-weight:600">@T["Subject"] *</label>
                        <BbInput @bind-Value="emailSubject" Placeholder="@(T["Subject"])" />
                    </div>
                    <div>
                        <label class="form-label" style="display:block;margin-bottom:.35rem;font-weight:600">@T["Message"] *</label>
                        <BbRichTextEditor Value="@emailBody"
                                          ValueChanged="v => emailBody = v ?? string.Empty"
                                          Toolbar="ToolbarPreset.Standard"
                                          MinHeight="280px"
                                          Placeholder="@(T["Write your message here..."])" />
                    </div>
                    <div>
                        <div style="display:flex;justify-content:space-between;align-items:center;gap:.5rem;margin-bottom:.5rem;flex-wrap:wrap">
                            <label class="form-label" style="margin:0;font-weight:600">@T["Attachments"] (@emailAttachments.Count)</label>
                            <div style="display:flex;align-items:center;gap:.4rem;flex-wrap:wrap">
                                <label for="email-att-input"
                                       class="inline-flex items-center justify-center gap-1.5 rounded-md border border-input bg-background px-2.5 py-1 text-xs font-medium shadow-xs hover:bg-accent hover:text-accent-foreground cursor-pointer">
                                    <LucideIcon Name="paperclip" Size="13" /> @T["Add Attachment"]
                                </label>
                                <InputFile id="email-att-input" OnChange="OnEmailAttachmentSelected" multiple style="display:none" />
                                @if (!emailAttachments.Any(a => a.IsDocumentPdf))
                                {
                                    <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="AddDocumentPdfAttachment">
                                        <LucideIcon Name="file-text" Size="13" /> @T["Attach Document PDF"]
                                    </BbButton>
                                }
                            </div>
                        </div>

                        @if (attachments.Count > 0)
                        {
                            var unattached = attachments.Where(a => !emailAttachments.Any(ea => ea.ExistingAttachmentId == a.Id)).ToList();
                            if (unattached.Count > 0)
                            {
                                <div style="display:flex;align-items:center;gap:.35rem;flex-wrap:wrap;margin-bottom:.5rem">
                                    <span class="muted small">@T["From document:"]</span>
                                    @foreach (var docAtt in unattached)
                                    {
                                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" OnClick="() => AddExistingEmailAttachment(docAtt)">
                                            <LucideIcon Name="plus" Size="12" /> @docAtt.FileName
                                        </BbButton>
                                    }
                                </div>
                            }
                        }

                        @if (emailAttachments.Count == 0)
                        {
                            <div class="muted small" style="padding:.5rem .75rem;border:1px dashed var(--bb-border);border-radius:var(--radius)">
                                @T["No attachments added."]
                            </div>
                        }
                        else
                        {
                            <div style="display:flex;flex-direction:column;gap:.4rem">
                                @foreach (var att in emailAttachments)
                                {
                                    <div style="display:flex;align-items:center;gap:.5rem;padding:.35rem .5rem;border:1px solid var(--bb-border);border-radius:var(--radius);background:var(--bb-muted, rgba(0,0,0,.02))">
                                        <LucideIcon Name="@(att.IsDocumentPdf ? "file-text" : "paperclip")" Size="14" />
                                        <div style="flex:1;min-width:0">
                                            <BbInput Value="@att.FileName"
                                                     ValueChanged="v => att.FileName = v ?? string.Empty"
                                                     AriaLabel="@(T["Attachment file name"])"
                                                     Placeholder="@(T["File name"])" />
                                        </div>
                                        <span class="muted small nowrap">
                                            @(att.IsDocumentPdf ? T["Auto PDF"] : FormatBytes(att.SizeBytes))
                                        </span>
                                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small"
                                                  OnClick="() => RemoveEmailAttachment(att.Key)"
                                                  AdditionalAttributes="@(new Dictionary<string, object> { ["title"] = T["Remove attachment"] })">
                                            <LucideIcon Name="x" Size="14" />
                                        </BbButton>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </ChildContent>
            <FooterContent>
                <div style="display:flex;justify-content:flex-end;gap:.5rem;width:100%">
                    <BbButton Variant="ButtonVariant.Ghost" OnClick="() => isSendEmailDrawerOpen = false">@T["Cancel"]</BbButton>
                    <BbButton OnClick="SendEmailAsync" Loading="@isSendingEmail" LoadingText="@(T["Sending…"])">
                        <LucideIcon Name="send" Size="14" /> @T["Send Email"]
                    </BbButton>
                </div>
            </FooterContent>
        </AdminDrawer>

        @if (!IsNew && !meta.Def.IsSingle)
        {
            <ShareDrawer DocType="@DocType" Name="@Name" DocTypeTitle="@T.Title(meta)"
                         Open="@isShareDrawerOpen" OpenChanged="@(v => isShareDrawerOpen = v)" OnChanged="OnSharesChanged" />
        }
        <AdminDrawer Open="@isAssignDrawerOpen"
                     OpenChanged="v => isAssignDrawerOpen = v"
                     Title="@($"{T["Assign To"]} · {Name}")"
                     WidthScale="1.3">
            <ChildContent>
                @if (assignError is not null)
                {
                    <BbAlert Variant="AlertVariant.Danger" Style="margin-bottom:1rem">
                        <BbAlertDescription>@T.Message(assignError)</BbAlertDescription>
                    </BbAlert>
                }

                <div style="display:flex;flex-direction:column;gap:1rem">
                    <div>
                        <label class="form-label" style="display:block;margin-bottom:.35rem;font-weight:600">@T["Assign To"] *</label>
                        @if (AvailableAssigneeOptions.Any())
                        {
                            <BbMultiSelect TValue="string"
                                           Values="@assignSelectedUsers"
                                           ValuesChanged="OnAssigneesSelected"
                                           Options="AvailableAssigneeOptions"
                                           Placeholder="@(T["Select teammates…"])"
                                           SearchPlaceholder="@(T["Search users…"])"
                                           EmptyMessage="@(T["No matching users"])"
                                           ShowSelectAll="false"
                                           MaxDisplayTags="4"
                                           MatchTriggerWidth="true" />
                        }
                        else
                        {
                            <div class="muted small" style="padding:.5rem .75rem;border:1px dashed var(--bb-border);border-radius:var(--radius)">
                                @T["All eligible users with access are already assigned to this document."]
                            </div>
                        }
                    </div>

                    <div class="row" style="gap:1rem">
                        <div style="flex:1">
                            <label class="form-label" style="display:block;margin-bottom:.35rem;font-weight:600">@T["Due Date"]</label>
                            <BbDatePicker Value="@assignDueDate"
                                          ValueChanged="d => assignDueDate = d"
                                          DateFormat="d MMM yyyy"
                                          Placeholder="@(T["Optional"])" />
                        </div>
                        <div style="flex:1">
                            <label class="form-label" style="display:block;margin-bottom:.35rem;font-weight:600">@T["Priority"]</label>
                            <BbSelect TValue="string" @bind-Value="assignPriorityStr" Options="AssignPriorityOptions" />
                        </div>
                    </div>

                    <div>
                        <label class="form-label" style="display:block;margin-bottom:.35rem;font-weight:600">@T["Note"]</label>
                        <BbTextarea @bind-Value="assignDescription"
                                    Rows="3"
                                    MaxLength="@AssignmentLimits.MaxDescriptionLength"
                                    Placeholder="@(T["Optional instructions or context for the assignee…"])" />
                    </div>

                    <div style="display:flex;justify-content:flex-end">
                        <BbButton Size="ButtonSize.Small"
                                  Disabled="@(assignBusy || assignSelectedUsers.Count == 0)"
                                  Loading="@assignBusy"
                                  LoadingText="@(T["Assigning…"])"
                                  OnClick="AssignDocumentAsync">
                            <LucideIcon Name="user-plus" Size="14" /> @T["Assign"]
                        </BbButton>
                    </div>

                    <hr style="border:0;border-top:1px solid var(--bb-border);margin:.25rem 0" />

                    <div>
                        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:.5rem">
                            <strong style="font-size:.9rem">@T["Assignments"] (@assignments.Count)</strong>
                        </div>

                        @if (assignments.Count == 0)
                        {
                            <div class="muted small" style="padding:.75rem;border:1px dashed var(--bb-border);border-radius:var(--radius)">
                                @T["No assignments yet for this document."]
                            </div>
                        }
                        else
                        {
                            var today = AssignmentsSvc.Today;
                            <div style="display:flex;flex-direction:column;gap:.65rem">
                                @foreach (var a in assignments)
                                {
                                    var canClose = CanCloseAssignment(a);
                                    var canEdit = CanEditAssignment(a);
                                    var overdue = a.IsOverdue(today);
                                    var dueToday = a.IsDueToday(today);
                                    <div style="padding:.75rem;border:1px solid var(--bb-border);border-radius:var(--radius);display:flex;flex-direction:column;gap:.45rem;opacity:@(a.IsOpen ? "1" : "0.72")">
                                        <div style="display:flex;justify-content:space-between;align-items:center;gap:.5rem;flex-wrap:wrap">
                                            <div style="display:flex;align-items:center;gap:.45rem;flex-wrap:wrap">
                                                <span class="assignment-avatar-chip">@Initials(UserDisplayName(a.AssignedTo))</span>
                                                <strong>@UserDisplayName(a.AssignedTo)</strong>
                                                <BbBadge Variant="@PriorityBadgeVariant(a.Priority)">@T[a.Priority.ToString()]</BbBadge>
                                                @if (!a.IsOpen)
                                                {
                                                    <BbBadge Variant="@(a.Status == AssignmentStatus.Completed ? BadgeVariant.SoftSuccess : BadgeVariant.Outline)">@T[a.Status.ToString()]</BbBadge>
                                                }
                                                else if (overdue)
                                                {
                                                    <BbBadge Variant="BadgeVariant.Destructive">@T.Format("Overdue ({0})", AssignmentFormat.Date(a.DueDate) ?? "")</BbBadge>
                                                }
                                                else if (dueToday)
                                                {
                                                    <BbBadge Variant="BadgeVariant.Secondary">@T["Due today"]</BbBadge>
                                                }
                                                else if (a.DueDate is { } dd)
                                                {
                                                    <BbBadge Variant="BadgeVariant.Outline">@T.Format("Due {0}", AssignmentFormat.Date(dd) ?? "")</BbBadge>
                                                }
                                            </div>
                                            <span class="muted small">@T.Format("by {0}", UserDisplayName(a.AssignedBy))</span>
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(a.Description))
                                        {
                                            <div class="small" style="white-space:pre-wrap">@a.Description</div>
                                        }
                                        @if (!a.IsOpen && !string.IsNullOrWhiteSpace(a.CloseNote))
                                        {
                                            <div class="muted small">@T["Closure note:"] @a.CloseNote</div>
                                        }

                                        @if (a.IsOpen && (canClose || canEdit))
                                        {
                                            if (editingAssignmentId == a.Id)
                                            {
                                                <div style="display:flex;gap:.5rem;align-items:flex-end;flex-wrap:wrap;padding-top:.25rem">
                                                    <div style="flex:1;min-width:9rem">
                                                        <BbDatePicker Value="@editDueDate" ValueChanged="d => editDueDate = d" DateFormat="d MMM yyyy" Placeholder="@(T["No due date"])" />
                                                    </div>
                                                    <div style="min-width:7.5rem">
                                                        <BbSelect TValue="string" @bind-Value="editPriorityStr" Options="AssignPriorityOptions" />
                                                    </div>
                                                    <BbButton Size="ButtonSize.Small" Disabled="@assignBusy" OnClick="() => SaveAssignmentEditAsync(a)">@T["Save"]</BbButton>
                                                    <BbButton Size="ButtonSize.Small" Variant="ButtonVariant.Ghost" OnClick="() => editingAssignmentId = null">@T["Cancel"]</BbButton>
                                                </div>
                                            }
                                            else
                                            {
                                                <div style="display:flex;gap:.4rem;flex-wrap:wrap;padding-top:.2rem">
                                                    @if (canClose)
                                                    {
                                                        <BbButton Size="ButtonSize.Small" Variant="ButtonVariant.Outline" Disabled="@assignBusy" OnClick="() => CompleteAssignmentAsync(a.Id)">
                                                            <LucideIcon Name="check" Size="13" /> @T["Mark Complete"]
                                                        </BbButton>
                                                        <BbButton Size="ButtonSize.Small" Variant="ButtonVariant.Ghost" Disabled="@assignBusy" OnClick="() => CancelAssignmentAsync(a.Id)">
                                                            <LucideIcon Name="x" Size="13" /> @T["Cancel"]
                                                        </BbButton>
                                                    }
                                                    @if (canEdit)
                                                    {
                                                        <BbButton Size="ButtonSize.Small" Variant="ButtonVariant.Ghost" Disabled="@assignBusy" OnClick="() => BeginEditAssignment(a)">
                                                            <LucideIcon Name="calendar-clock" Size="13" /> @T["Edit"]
                                                        </BbButton>
                                                    }
                                                </div>
                                            }
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </ChildContent>
            <FooterContent>
                <div style="display:flex;justify-content:flex-end;width:100%">
                    <BbButton Variant="ButtonVariant.Ghost" OnClick="() => isAssignDrawerOpen = false">@T["Close"]</BbButton>
                </div>
            </FooterContent>
        </AdminDrawer>
    }
}

@code {
    [Parameter] public string DocType { get; set; } = "";
    [Parameter] public string Name { get; set; } = "";
    [SupplyParameterFromQuery(Name = "tab")] public string? TabQuery { get; set; }

    private static readonly System.Text.RegularExpressions.Regex TrailingMentionRegex =
        new(@"(?:^|[\s(\n])(@([A-Za-z0-9._\-]*))$", System.Text.RegularExpressions.RegexOptions.Compiled);

    private BbTextarea? commentTextarea;

    private const string HistoryTab = "__history";
    private const string AttachmentsTab = "__attachments";
    private CompiledDocType? meta;
    private Document? doc;
    private Dictionary<string, object?> model = new();
    private string original = "";
    private Dictionary<string, string> errors = new();
    private Dictionary<string, string> errorSnapshot = new();
    private IReadOnlyList<ActionView> actions = [];
    private IReadOnlyList<AuditEntry> audit = [];
    private IReadOnlyList<AttachmentRecord> attachments = [];
    private IReadOnlyList<CommunicationEntry> communications = [];
    private IReadOnlyList<UserContext> mentionUsers = [];
    private IReadOnlyList<Assignment> assignments = [];
    private IReadOnlyList<UserContext> eligibleAssignees = [];
    private IReadOnlyList<Assignment> OpenAssignments => assignments.Where(a => a.IsOpen).ToList();
    private string historyFilter = "all";
    private string historySearchQuery = "";
    private int historyPageSize = 10;
    private int historyDisplayLimit = 10;
    private string newComment = "";
    private string mentionQuery = "";
    private bool postingComment;
    private bool showMentionPicker;

    private int CommentCount => audit.Count(a => a.Action == AuditActions.Comment);
    private int AuditOnlyCount => audit.Count(a => a.Action != AuditActions.Comment);
    private IReadOnlyList<AuditEntry> FilteredAudit => (historyFilter switch
    {
        "comments" => audit.Where(a => a.Action == AuditActions.Comment),
        "audit" => audit.Where(a => a.Action != AuditActions.Comment),
        _ => audit
    }).Where(MatchesHistorySearch).ToList();
    private IReadOnlyList<AuditEntry> PagedAudit => FilteredAudit.Take(historyDisplayLimit).ToList();
    private bool HasMoreHistory => FilteredAudit.Count > historyDisplayLimit;
    private void SetHistoryFilter(string filter)
    {
        historyFilter = filter;
        historyDisplayLimit = historyPageSize;
    }
    private void OnHistorySearchChanged(string? value)
    {
        historySearchQuery = value ?? "";
        historyDisplayLimit = historyPageSize;
    }
    private bool MatchesHistorySearch(AuditEntry a)
    {
        var q = historySearchQuery.Trim();
        if (q.Length == 0) return true;
        return a.Actor.Contains(q, StringComparison.OrdinalIgnoreCase)
            || a.Action.Contains(q, StringComparison.OrdinalIgnoreCase)
            || (!string.IsNullOrEmpty(a.Comment) && a.Comment.Contains(q, StringComparison.OrdinalIgnoreCase))
            || (!string.IsNullOrEmpty(a.FromState) && a.FromState.Contains(q, StringComparison.OrdinalIgnoreCase))
            || (!string.IsNullOrEmpty(a.ToState) && a.ToState.Contains(q, StringComparison.OrdinalIgnoreCase))
            || a.Changes.Any(c =>
                c.Field.Contains(q, StringComparison.OrdinalIgnoreCase)
                || (!string.IsNullOrEmpty(c.Old) && c.Old.Contains(q, StringComparison.OrdinalIgnoreCase))
                || (!string.IsNullOrEmpty(c.New) && c.New.Contains(q, StringComparison.OrdinalIgnoreCase)));
    }
    private void LoadMoreHistory() => historyDisplayLimit += historyPageSize;
    private IDisposable? liveNotifSub;
    private IReadOnlyList<UserContext> MentionableUsers => mentionUsers
        .Where(u => !string.Equals(u.Id, User.Id, StringComparison.OrdinalIgnoreCase))
        .OrderBy(u => u.FullName, StringComparer.OrdinalIgnoreCase)
        .ToList();
    private IReadOnlyList<UserContext> FilteredMentionUsers => MentionableUsers
        .Where(u => MatchesMentionQuery(u.Id, u.FullName))
        .ToList();
    private bool MatchesMentionQuery(string id, string? fullName = null) =>
        string.IsNullOrEmpty(mentionQuery) ||
        id.Contains(mentionQuery, StringComparison.OrdinalIgnoreCase) ||
        (!string.IsNullOrWhiteSpace(fullName) && fullName.Contains(mentionQuery, StringComparison.OrdinalIgnoreCase));
    private bool isSendEmailDrawerOpen;
    private bool isSendingEmail;
    private string? sendEmailError;
    private string emailTo = "";
    private string emailCc = "";
    private string emailBcc = "";
    private string emailSubject = "";
    private string emailBody = "";
    private string? emailInReplyTo;
    private List<PendingEmailAttachment> emailAttachments = [];

    private sealed class PendingEmailAttachment
    {
        public required string Key { get; init; }
        public required string FileName { get; set; }
        public required string ContentType { get; init; }
        public byte[]? Bytes { get; init; }
        public string? ExistingAttachmentId { get; init; }
        public bool IsDocumentPdf { get; init; }
        public long SizeBytes { get; init; }
    }
    private string? uploadError;
    private bool uploadingAttachment;
    private string activeTab = "";
    private string? fatal, banner, conflict;
    private int fatalStatus = 404;
    private bool busy, savingNow, dirty;

    private readonly string sessionId = Guid.NewGuid().ToString("N");
    private IDisposable? presenceSub;
    private PeriodicTimer? heartbeatTimer;
    private CancellationTokenSource? presenceCts;
    private IReadOnlyList<DocumentPresenceUser> presenceUsers = [];

    private IReadOnlyList<DocumentPresenceUser> OtherEditingUsers =>
        presenceUsers.Where(u => u.SessionId != sessionId && u.Status == PresenceStatus.Editing).ToList();

    private bool IsNew => Name == "new" || (meta?.Def.IsSingle == true && (doc == null || doc.Version == 0));
    private bool HasStatus => meta?.Workflow is not null || meta?.Def.Document.AllowSubmit == true;
    private UserContext User => Current.Required;

    private bool Editable => doc is not null && doc.DocStatus == DocStatus.Draft &&
        (meta?.Def.IsSingle == true
            ? Perms.Can(User, meta!, DocActions.Write) && Perms.InScope(User, meta!, DocActions.Write, doc.Owner, doc.Data)
            : IsNew
                ? Perms.Can(User, meta!, DocActions.Create)
                : Perms.Can(User, meta!, DocActions.Write)
                  && (Perms.InScope(User, meta!, DocActions.Write, doc.Owner, doc.Data) || myShare?.CanWrite == true));

    private Dictionary<string, object?> Scope
    {
        get { var tmp = doc!.Clone(); tmp.Data = model; return DocumentService.ScopeData(tmp); }
    }

    private FieldState State(CompiledField f)
    {
        var st = Evaluator.StateOf(f, Scope, User);
        // Client Scripts can only add to the metadata rules (hide, require, lock), never undo them:
        // the server enforces the metadata rules, so loosening them in the UI would only produce save errors.
        if (scriptHidden.GetValueOrDefault(f.Name)) st = st with { Visible = false };
        if (scriptRequired.GetValueOrDefault(f.Name)) st = st with { Required = true };
        if (scriptReadOnly.GetValueOrDefault(f.Name)) st = st with { ReadOnly = true };
        return st;
    }
    private bool Readable(CompiledField f) => Perms.CanReadField(User, meta!, f);
    private bool FieldReadOnly(CompiledField f, FieldState st) => !Editable || st.ReadOnly || !Perms.CanWriteField(User, meta!, f)
        || (!IsNew && meta!.Def.Naming.Pattern == $"field:{f.Name}"); // kode = nomor dokumen, tetap setelah disimpan
    private bool SectionVisible(LayoutSection s) => FieldsVisible(s) && (s.SubTab is null || s.SubTab == ActiveSubTab(s));
    private bool FieldsVisible(LayoutSection s) => s.Columns.SelectMany(c => c.Fields).Any(f => Readable(f) && State(f).Visible);

    // ---------------- tabs inside a section (fields with subTab) ----------------

    /// <summary>Picked inner tab per section, with the errors shown at that moment (see <see cref="ActiveSubTab"/>).</summary>
    private readonly Dictionary<string, (string Name, string ErrorsKey)> subTabSelection = new();
    private string ErrorsKey => string.Join("\n", errors.Keys.Order(StringComparer.Ordinal));

    private IEnumerable<LayoutSection> SubTabSections(LayoutSection s) =>
        meta!.Layout.SelectMany(t => t.Sections).Where(x => x.SubTab is not null && x.SubTabGroup == s.SubTabGroup);

    /// <summary>Inner tabs that have at least one visible field.</summary>
    private IReadOnlyList<string> VisibleSubTabs(LayoutSection s) =>
        SubTabSections(s).Where(FieldsVisible).Select(x => x.SubTab!).Distinct().ToList();

    /// <summary>
    /// The inner tab shown: the one the user picked, else the first visible one. When new errors appear (e.g. after
    /// Save) and the shown tab has none, the first inner tab with errors is shown, so the fields to fix are on screen;
    /// picking a tab afterwards is respected.
    /// </summary>
    private string? ActiveSubTab(LayoutSection s)
    {
        var visible = VisibleSubTabs(s);
        var hasPick = s.SubTabGroup is { } g && subTabSelection.TryGetValue(g, out var sel) && visible.Contains(sel.Name);
        var picked = hasPick ? subTabSelection[s.SubTabGroup!].Name : visible.FirstOrDefault();
        var errorsChangedSincePick = !hasPick || subTabSelection[s.SubTabGroup!].ErrorsKey != ErrorsKey;
        if (errors.Count > 0 && errorsChangedSincePick && picked is not null && SubTabErrorCount(s, picked) == 0)
            return visible.FirstOrDefault(name => SubTabErrorCount(s, name) > 0) ?? picked;
        return picked;
    }

    private void SelectSubTab(LayoutSection s, string name)
    {
        if (s.SubTabGroup is { } g) subTabSelection[g] = (name, ErrorsKey);
    }

    private int SubTabErrorCount(LayoutSection s, string name)
    {
        if (errors.Count == 0) return 0;
        var names = SubTabSections(s).Where(x => x.SubTab == name).SelectMany(x => x.Columns).SelectMany(c => c.Fields).Select(f => f.Name).ToHashSet();
        return errors.Keys.Count(k => names.Contains(k.Split('[', '.')[0]));
    }
    private bool TabVisible(LayoutTab t) => t.Sections.Any(SectionVisible);
    private static string Anchor(string path) => "f-" + path.Replace("[", "-").Replace("].", "-").Replace("]", "");

    private int TabErrorCount(LayoutTab t)
    {
        var names = t.Sections.SelectMany(s => s.Columns).SelectMany(c => c.Fields).Select(f => f.Name).ToHashSet();
        return errors.Keys.Count(k => names.Contains(k.Split('[', '.')[0]));
    }

    private List<Dictionary<string, object?>> Rows(CompiledField f)
    {
        if (model.GetValueOrDefault(f.Name) is not List<Dictionary<string, object?>> rows)
            model[f.Name] = rows = new List<Dictionary<string, object?>>();
        return rows;
    }

    private string ActionLabel(string action) => T[action switch
    {
        DocActions.Submit => "Submit", DocActions.Cancel => "Cancel", DocActions.Amend => "Amend (create revision)", _ => action
    }];

    private static string IconFor(ActionView a) => a.Tone switch
    {
        "negative" => "ban", "positive" => "check", _ when a.Action == DocActions.Amend => "rotate-ccw", _ => "send"
    };

    private IEnumerable<Framework.Actions.IFormAction> CustomActions =>
        !IsNew && doc is not null && User is not null
            ? (RegisteredFormActions ?? []).Where(a => string.Equals(a.DocType, DocType, StringComparison.Ordinal) && a.IsVisible(User, doc))
            : [];

    /// <summary>Button field: runs the form action named in its metadata (buttonAction) on the saved document.</summary>
    private async Task RunButtonField(CompiledField f)
    {
        if (IsNew || doc is null)
        {
            Toasts.Info("Save the document first.", f.Label);
            return;
        }
        var action = CustomActions.FirstOrDefault(a => string.Equals(a.ActionId, f.Def.ButtonAction, StringComparison.Ordinal));
        if (action is null)
        {
            Toasts.Error($"Action '{f.Def.ButtonAction}' is not available for this document.", f.Label);
            return;
        }
        await RunCustomAction(action);
    }

    private async Task RunCustomAction(Framework.Actions.IFormAction action)
    {
        if (busy || doc is null || meta is null) return;
        busy = true;
        try
        {
            var ctx = new Framework.Actions.FormActionContext
            {
                User = User,
                Meta = meta,
                Doc = doc,
                Docs = Docs,
                Services = Sp
            };
            var result = await action.ExecuteAsync(ctx, CancellationToken.None);
            if (!string.IsNullOrWhiteSpace(result.Message))
            {
                if (result.Success) Toasts.Success(T.Message(result.Message), T[action.Label]);
                else Toasts.Error(T.Message(result.Message), T[action.Label]);
            }
            if (!string.IsNullOrWhiteSpace(result.RedirectUrl))
            {
                dirty = false;
                Nav.NavigateTo(result.RedirectUrl);
                return;
            }
            if (result.RefreshDocument)
            {
                await Load();
            }
        }
        catch (Exception ex)
        {
            Toasts.Error(T.Message(ex.Message), T[action.Label]);
        }
        finally
        {
            busy = false;
        }
    }

    // Blazor memanggil OnParametersSet setiap kali layout induk dirender ulang (mis. jumlah notifikasi berubah).
    // Muat ulang hanya bila parameter rute benar-benar berubah, agar isian/draft pengguna tidak hilang.
    private string? loadedKey;
    protected override async Task OnParametersSetAsync()
    {
        if (string.Equals(TabQuery, "comments", StringComparison.OrdinalIgnoreCase))
        {
            activeTab = HistoryTab;
            historyFilter = "all";
        }
        var key = $"{DocType}/{Name}";
        if (key == loadedKey) return;
        loadedKey = key;
        await Load();
    }

    /// <summary>
    /// <c>/app/{DocType}/new?prefill.{field}=value</c> (used by the calendar view): starting values for scalar
    /// fields the user may write. Values go through the field type's normalization; the server validates on save.
    /// </summary>
    private void ApplyPrefill(Document target)
    {
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query);
        foreach (var (key, values) in query)
        {
            if (!key.StartsWith("prefill.", StringComparison.Ordinal) || values.Count != 1) continue;
            if (!meta!.ByName.TryGetValue(key["prefill.".Length..], out var f) || f.IsLayout || f.Def.Type is "Table" or "Password") continue;
            if (!Perms.CanWriteField(User, meta, f)) continue;
            var normalized = f.Type.Normalize(values[0]);
            if (normalized.Ok && normalized.Value is not null) target.Data[f.Name] = normalized.Value;
        }
    }

    private async Task Load()
    {
        fatal = null; banner = null; conflict = null; errors.Clear();
        ClearScriptOverrides();
        await CleanupPresenceAsync();

        if (!Metadata.Current.TryGet(DocType, out var m) || m.Def.IsChild) { fatalStatus = 404; fatal = $"DocType '{DocType}' was not found."; return; }
        meta = m;
        try
        {
            doc = !meta.Def.IsSingle && Name == "new" ? await Docs.NewAsync(User, DocType) : await Docs.GetAsync(User, DocType, meta.Def.IsSingle ? meta.Name : Name);
            if (!meta.Def.IsSingle && Name == "new") ApplyPrefill(doc);
            myShare = meta.Def.IsSingle || Name == "new" ? null : await Docs.ShareForAsync(User, DocType, Name);
            model = Document.DeepCopy(doc.Data);
            // Pilih tab aktif SEBELUM await berikutnya: dengan database sungguhan Blazor bisa merender di tengah Load,
            // dan BbTabs memakai nilai awal Value. Tab kosong pada render pertama membuat isi form tersembunyi.
            if (activeTab == "" || (activeTab != HistoryTab && meta.Layout.All(t => t.Title != activeTab)))
                activeTab = meta.Layout.FirstOrDefault(TabVisible)?.Title ?? "";
            loadingForm = true;
            try
            {
                if (IsNew)
                    foreach (var link in meta.Fields.Where(f => f.Def.Type == "Link" && model.GetValueOrDefault(f.Name) is not null).ToList())
                        await SetValue(link, model[link.Name]);
            }
            finally { loadingForm = false; }
            original = Snapshot();
            dirty = false;
            // Client Scripts (Load) run after the snapshot: values they fill in count as unsaved changes.
            await RunClientScripts(Framework.Scripting.Abstractions.FormScriptEvent.Load, null);
            actions = IsNew ? [] : await Docs.AvailableActionsAsync(User, doc);
            audit = IsNew ? [] : await Docs.GetAuditAsync(User, DocType, Name);
            historyPageSize = UiOptions.From(Config).HistoryCommentsPageSize;
            historyDisplayLimit = historyPageSize;
            historySearchQuery = "";
            attachments = IsNew ? [] : await Attachments.ListAsync(User, DocType, Name);
            communications = IsNew ? [] : await CommService.ListForDocumentAsync(User, DocType, Name);
            mentionUsers = IsNew ? [] : await Users.ListAsync(User.TenantId);
            assignments = IsNew ? [] : await AssignmentsSvc.ListForDocumentAsync(User, DocType, Name);
            eligibleAssignees = IsNew ? [] : await AssignmentsSvc.ListEligibleAssigneesAsync(User, DocType, Name);
            newComment = ""; mentionQuery = ""; showMentionPicker = false;

            if (!IsNew)
            {
                presenceSub = Presence.Subscribe(User.TenantId, DocType, Name, OnPresenceChanged);
                presenceUsers = await Presence.HeartbeatAsync(User.TenantId, DocType, Name, sessionId, User, PresenceStatus.Viewing);
                StartHeartbeatLoop();
                liveNotifSub?.Dispose();
                liveNotifSub = LiveNotifications.Subscribe(User.TenantId, User.Id, async n =>
                {
                    if (string.Equals(n.DocType, DocType, StringComparison.OrdinalIgnoreCase) &&
                        string.Equals(n.DocName, Name, StringComparison.OrdinalIgnoreCase))
                    {
                        await InvokeAsync(async () =>
                        {
                            audit = await Docs.GetAuditAsync(User, DocType, Name);
                            assignments = await AssignmentsSvc.ListForDocumentAsync(User, DocType, Name);
                            StateHasChanged();
                        });
                    }
                });
            }
        }
        catch (PermissionDeniedException ex)
        {
            fatalStatus = 403;
            fatal = ex.Message;
        }
        catch (DocumentNotFoundException ex)
        {
            fatalStatus = 404;
            fatal = ex.Message;
        }
    }

    private string Snapshot() => JsonSerializer.Serialize(model);

    private async Task SetValue(CompiledField f, object? value)
    {
        model[f.Name] = value;
        // Pratinjau fetchFrom dengan hak akses user (server tetap menghitung ulang saat simpan).
        foreach (var dep in meta!.Fields.Where(x => x.FetchFrom?.LinkField == f.Name))
        {
            object? fetched = null;
            if (value is string link)
            {
                try { fetched = (await Docs.GetAsync(User, f.Def.LinkTo!, link)).Data.GetValueOrDefault(dep.FetchFrom!.Value.TargetField); }
                catch (Exception ex) when (ex is DocumentNotFoundException or PermissionDeniedException) { }
            }
            model[dep.Name] = fetched;
        }
        if (!loadingForm) await Docs.ApplyFieldChangeAsync(User, DocType, model, f.Name);
        await Changed();
        // Client Scripts (Change). Not while the form loads; values set by scripts cascade up to MaxClientScriptDepth.
        if (!loadingForm) await RunClientScripts(Framework.Scripting.Abstractions.FormScriptEvent.Change, f.Name);
    }

    private async Task OnTableChanged(CompiledField f)
    {
        await Changed();
        await RunClientScripts(Framework.Scripting.Abstractions.FormScriptEvent.Change, f.Name);
    }

    // ---------------------------------------------------------------- client scripts

    private const int MaxClientScriptDepth = 3;
    private int clientScriptDepth;
    private bool loadingForm;
    private readonly Dictionary<string, bool> scriptHidden = new();
    private readonly Dictionary<string, bool> scriptRequired = new();
    private readonly Dictionary<string, bool> scriptReadOnly = new();
    private readonly Dictionary<string, string?> scriptNotes = new();
    private readonly ClientScriptFormState scriptFormState = new();

    private Framework.Scripting.ServerScriptExecutionService? ClientScripts =>
        Sp.GetService(typeof(Framework.Scripting.ServerScriptExecutionService)) as Framework.Scripting.ServerScriptExecutionService;

    private void ClearScriptOverrides()
    {
        scriptHidden.Clear(); scriptRequired.Clear(); scriptReadOnly.Clear(); scriptNotes.Clear();
        scriptFormState.DocType = DocType;
        scriptFormState.Options.Clear();
    }

    /// <summary>
    /// Runs the Client Scripts of this DocType for one form event and applies the outcome. Values set by a script go
    /// through SetValue, which fires their own Change event, up to <see cref="MaxClientScriptDepth"/> levels deep.
    /// Returns the validation errors (only meaningful for the Validate event).
    /// </summary>
    private async Task<IReadOnlyList<FieldError>> RunClientScripts(Framework.Scripting.Abstractions.FormScriptEvent evt, string? field)
    {
        var service = ClientScripts;
        var current = meta;
        if (service is null || current is null || doc is null || clientScriptDepth >= MaxClientScriptDepth) return [];
        clientScriptDepth++;
        try
        {
            Framework.Scripting.FormScriptOutcome outcome;
            try
            {
                outcome = await service.RunFormEventAsync(User, current.Name, evt, field, model, IsNew, IsNew ? null : Name);
            }
            catch (Exception ex) when (ex is not OperationCanceledException)
            {
                Toasts.Warning(ex.Message, "Client script");
                return [];
            }

            foreach (var (k, v) in outcome.Hidden) scriptHidden[k] = v;
            foreach (var (k, v) in outcome.Required) scriptRequired[k] = v;
            foreach (var (k, v) in outcome.ReadOnly) scriptReadOnly[k] = v;
            foreach (var (k, v) in outcome.Descriptions) scriptNotes[k] = v;
            foreach (var (k, v) in outcome.Options)
            {
                // Only options the metadata allows are kept: the server rejects any other value.
                if (current.ByName.TryGetValue(k, out var sf) && sf.Def.Options is { Count: > 0 } allowed)
                    scriptFormState.Options[k] = v.Where(allowed.Contains).Distinct().ToList();
            }

            foreach (var m in outcome.Messages)
            {
                switch (m.Level)
                {
                    case "success": Toasts.Success(m.Message); break;
                    case "warning": Toasts.Warning(m.Message); break;
                    case "error": Toasts.Error(m.Message); break;
                    default: Toasts.Info(m.Message); break;
                }
            }
            foreach (var failure in outcome.Failures)
                Toasts.Warning(failure.Message, $"Client script: {failure.Script}");

            // Values: only while the form can be edited, and only fields the user could type in right now.
            if (Editable)
            {
                foreach (var (name, value) in outcome.Values)
                {
                    if (!current.ByName.TryGetValue(name, out var f) || FieldReadOnly(f, Evaluator.StateOf(f, Scope, User))) continue;
                    await SetValue(f, value);
                }
            }
            return outcome.Errors;
        }
        finally
        {
            clientScriptDepth--;
        }
    }

    /// <summary>Validate event + fields a client script made required. True = the save may go ahead.</summary>
    private async Task<bool> ClientValidateAsync()
    {
        var found = new List<FieldError>(await RunClientScripts(Framework.Scripting.Abstractions.FormScriptEvent.Validate, null));
        foreach (var (name, required) in scriptRequired)
        {
            if (!required || !meta!.ByName.TryGetValue(name, out var f) || !Readable(f)) continue;
            var st = State(f);
            if (!st.Visible || FieldReadOnly(f, st)) continue;
            var value = model.GetValueOrDefault(name);
            if (value is null || (value is string text && string.IsNullOrWhiteSpace(text)) || value is System.Collections.ICollection { Count: 0 })
                found.Add(new FieldError(name, $"{f.Label} is required."));
        }
        if (found.Count == 0) return true;
        HandleError(new ValidationFailedException(found));
        return false;
    }

    private async Task Changed()
    {
        // Pratinjau compute di UI memakai engine ekspresi yang sama dengan server.
        Evaluator.ApplyCompute(meta!, model, User, Metadata.Current.Get);
        // Hapus error yang sudah tidak relevan: field-nya berubah sejak error muncul, atau syaratnya tidak lagi berlaku.
        foreach (var key in errors.Keys.ToList())
        {
            var root = key.Split('[', '.')[0];
            var changed = JsonSerializer.Serialize(model.GetValueOrDefault(root)) != (errorSnapshot.GetValueOrDefault(root) ?? "null");
            var noLongerRequired = meta!.ByName.TryGetValue(root, out var f) && (errors[key].Contains("wajib") || errors[key].Contains("required")) && !State(f).Required;
            if (changed || noLongerRequired) errors.Remove(key);
        }
        var wasDirty = dirty;
        dirty = Snapshot() != original;
        banner = null;

        if (!IsNew && dirty != wasDirty)
        {
            await UpdatePresenceStatusAsync(dirty ? PresenceStatus.Editing : PresenceStatus.Viewing);
        }
    }

    private async Task OnBeforeInternalNavigation(LocationChangingContext context)
    {
        if (dirty && !savingNow)
        {
            var currentRelative = Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].Split('#')[0].TrimEnd('/');
            var targetAbsolute = Nav.ToAbsoluteUri(context.TargetLocation).ToString();
            if (targetAbsolute.StartsWith(Nav.BaseUri, StringComparison.OrdinalIgnoreCase))
            {
                var targetRelative = Nav.ToBaseRelativePath(targetAbsolute).Split('?')[0].Split('#')[0].TrimEnd('/');
                if (string.Equals(currentRelative, targetRelative, StringComparison.OrdinalIgnoreCase))
                {
                    return;
                }
            }

            if (context.CancellationToken.IsCancellationRequested)
            {
                return;
            }

            var confirmed = await Dialogs.ConfirmAsync(
                T["Discard unsaved changes?"],
                T["You have unsaved changes in this document. If you leave now, your changes will be lost and you will start over from the beginning."],
                new ConfirmDialogOptions
                {
                    Destructive = true,
                    ConfirmText = T["Discard and Leave"],
                    CancelText = T["Stay on this page"]
                });

            if (!confirmed.Confirmed)
            {
                context.PreventNavigation();
            }
            else
            {
                dirty = false;
            }
        }
    }

    private Dictionary<string, object?> BuildPayload()
    {
        var before = JsonSerializer.Deserialize<Dictionary<string, JsonElement>>(original)!;
        var payload = new Dictionary<string, object?>();
        foreach (var f in meta!.Fields.Where(f => !f.IsDerived && Readable(f) && Perms.CanWriteField(User, meta, f)))
        {
            var now = model.GetValueOrDefault(f.Name);
            var was = before.TryGetValue(f.Name, out var w) ? w.GetRawText() : "null";
            if (IsNew || JsonSerializer.Serialize(now) != was)
                payload[f.Name] = f.Def.Type == "Table"
                    ? Rows(f).Select(r => r.Where(kv => kv.Key != "idx").ToDictionary(kv => kv.Key, kv => kv.Value)).ToList()
                    : now;
        }
        return payload;
    }

    private async Task Save()
    {
        busy = savingNow = true; errors.Clear(); banner = null; conflict = null;
        try
        {
            if (!await ClientValidateAsync()) return;
            var payload = BuildPayload();
            if (meta?.Def.IsSingle == true)
            {
                var saved = await Docs.SetSingleAsync(User, DocType, payload);
                if (saved.TransientMessages.Count > 0)
                    foreach (var msg in saved.TransientMessages) Toasts.Info(T.Message(msg));
                await Load();
                Toasts.Success(T["Changes saved."], meta.Title);
                return;
            }
            if (IsNew)
            {
                var saved = await Docs.InsertAsync(User, DocType, payload);
                if (saved.TransientMessages.Count > 0)
                    foreach (var msg in saved.TransientMessages) Toasts.Info(T.Message(msg));
                Toasts.Success(T.Format("{0} saved as draft.", saved.Name), T["Saved"]);
                dirty = false;
                Nav.NavigateTo($"/app/{DocType}/{saved.Name}");
                return;
            }
            if (payload.Count == 0) return;
            var updated = await Docs.UpdateAsync(User, DocType, Name, doc!.Version, payload);
            if (updated.TransientMessages.Count > 0)
                foreach (var msg in updated.TransientMessages) Toasts.Info(T.Message(msg));
            await Load();
            Toasts.Success(T["Changes saved."], Name);
        }
        catch (Exception ex) { HandleError(ex); }
        finally { busy = savingNow = false; }
    }

    private async Task RunAction(ActionView a)
    {
        string? comment = null;
        if (a.RequireComment)
        {
            // Validasi komentar dilakukan di sini (bukan Required pada prompt): BbInput meng-commit nilai saat blur,
            // sehingga Required membuat tombol konfirmasi tetap nonaktif selama pengguna masih mengetik.
            var prompt = await Dialogs.PromptAsync($"{ActionLabel(a.Action)} {doc!.Name}?", T["Write a reason or note. This comment will be sent to the requester and recorded in history."],
                new PromptDialogOptions { Placeholder = T["Reason…"], ConfirmText = ActionLabel(a.Action), CancelText = T["Cancel"], MaxLength = 1000 });
            if (prompt.Cancelled) return;
            if (string.IsNullOrWhiteSpace(prompt.Value))
            {
                Toasts.Error(T.Format("Action “{0}” requires a reason. Nothing was changed.", ActionLabel(a.Action)), T["Empty comment"]);
                return;
            }
            comment = prompt.Value.Trim();
        }
        busy = true; errors.Clear(); banner = null; conflict = null;
        try
        {
            var result = await Docs.RunActionAsync(User, DocType, Name, a.Action, doc!.Version, comment);
            if (result.TransientMessages.Count > 0)
                foreach (var msg in result.TransientMessages) Toasts.Info(T.Message(msg));
            if (result.Name != Name)
            {
                Toasts.Success(T.Format("Revision draft {0} created.", result.Name), T["Amend"]);
                dirty = false;
                Nav.NavigateTo($"/app/{DocType}/{result.Name}");
                return;
            }
            await Load();
            Toasts.Success(T.Format("Status is now {0}.", T.State(result.WorkflowState, result.DocStatus)), T.Format("{0} succeeded", ActionLabel(a.Action)));
        }
        catch (Exception ex) { HandleError(ex); }
        finally { busy = false; }
    }

    private async Task Delete()
    {
        var confirm = await Dialogs.ConfirmAsync(T.Format("Delete {0}?", Name),
            HasStatus ? T["This draft will be deleted. Deletion history remains recorded."] : T["This document will be deleted. Deletion history remains recorded."],
            new ConfirmDialogOptions { Destructive = true, ConfirmText = HasStatus ? T["Delete draft"] : T["Delete"], CancelText = T["Cancel"] });
        if (!confirm.Confirmed) return;
        busy = true;
        try
        {
            await Docs.DeleteAsync(User, DocType, Name, doc!.Version);
            Toasts.Success(T.Format("{0} deleted.", Name), T["Deleted"]);
            dirty = false;
            Nav.NavigateTo($"/app/{DocType}");
        }
        catch (Exception ex) { HandleError(ex); }
        finally { busy = false; }
    }

    private void HandleError(Exception ex)
    {
        if (InfrastructureErrorHelper.TryDescribe(ex, T, out var infraTitle, out var infraMessage))
        {
            Connectivity.ReportException(ex);
            banner = infraMessage;
            Toasts.Error(infraMessage, infraTitle);
            return;
        }

        switch (ex)
        {
            case ValidationFailedException v:
                foreach (var e in v.Errors) errors.TryAdd(e.Path, T.Message(e.Message));
                errorSnapshot = model.ToDictionary(kv => kv.Key, kv => JsonSerializer.Serialize(kv.Value));
                if (errors.Remove("_comment", out var c)) banner = c;
                if (errors.Remove("_doc", out var d)) banner = d;
                break;
            case ConcurrencyException: conflict = ex.Message; break;
            case PermissionDeniedException or InvalidStateException or InvalidPayloadException or DocumentNotFoundException or LinkedDocumentException:
                banner = ex.Message; break;
            default: System.Runtime.ExceptionServices.ExceptionDispatchInfo.Capture(ex).Throw(); break;
        }
    }

    private async Task OnAttachmentSelected(InputFileChangeEventArgs e)
    {
        uploadError = null;
        uploadingAttachment = true;
        try
        {
            var file = e.File;
            if (file is null) return;
            using var stream = file.OpenReadStream(maxAllowedSize: AttachmentService.MaxAttachmentBytes);
            await Attachments.UploadAsync(User, DocType, Name, file.Name, stream);
            attachments = await Attachments.ListAsync(User, DocType, Name);
            Toasts.Success(T.Format("Attachment '{0}' uploaded.", file.Name), T["Success"]);
        }
        catch (Exception ex)
        {
            Connectivity.ReportException(ex);
            if (InfrastructureErrorHelper.TryDescribe(ex, T, out var title, out var msg))
            {
                uploadError = msg;
                Toasts.Error(msg, title);
            }
            else
            {
                uploadError = ex.Message;
            }
        }
        finally
        {
            uploadingAttachment = false;
        }
    }

    private async Task DeleteAttachment(string id)
    {
        var confirm = await Dialogs.ConfirmAsync(T["Delete Attachment?"], T["This attachment will be permanently removed."],
            new ConfirmDialogOptions { Destructive = true, ConfirmText = T["Delete"], CancelText = T["Cancel"] });
        if (!confirm.Confirmed) return;

        try
        {
            await Attachments.DeleteAsync(User, id);
            attachments = await Attachments.ListAsync(User, DocType, Name);
            Toasts.Success(T["Attachment removed."], T["Deleted"]);
        }
        catch (Exception ex)
        {
            Connectivity.ReportException(ex);
            if (InfrastructureErrorHelper.TryDescribe(ex, T, out var title, out var msg))
            {
                uploadError = msg;
                Toasts.Error(msg, title);
            }
            else
            {
                uploadError = ex.Message;
            }
        }
    }

    private static string FormatBytes(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024.0):F2} MB";
    }

    private void StartHeartbeatLoop()
    {
        presenceCts?.Cancel();
        presenceCts = new CancellationTokenSource();
        heartbeatTimer?.Dispose();
        heartbeatTimer = new PeriodicTimer(TimeSpan.FromSeconds(10));
        var ct = presenceCts.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                while (await heartbeatTimer.WaitForNextTickAsync(ct))
                {
                    if (ct.IsCancellationRequested) break;
                    var status = dirty ? PresenceStatus.Editing : PresenceStatus.Viewing;
                    await Presence.HeartbeatAsync(User.TenantId, DocType, Name, sessionId, User, status, ct);
                }
            }
            catch (OperationCanceledException) { }
            catch { }
        }, ct);
    }

    private async Task UpdatePresenceStatusAsync(PresenceStatus status)
    {
        try
        {
            presenceUsers = await Presence.HeartbeatAsync(User.TenantId, DocType, Name, sessionId, User, status);
        }
        catch { }
    }

    private void OnPresenceChanged(PresenceChange change)
    {
        _ = InvokeAsync(() =>
        {
            presenceUsers = change.ActiveUsers;
            StateHasChanged();
        });
    }

    private async ValueTask CleanupPresenceAsync()
    {
        presenceSub?.Dispose();
        presenceSub = null;

        if (presenceCts is not null)
        {
            presenceCts.Cancel();
            presenceCts.Dispose();
            presenceCts = null;
        }

        if (heartbeatTimer is not null)
        {
            heartbeatTimer.Dispose();
            heartbeatTimer = null;
        }

        if (!IsNew && doc is not null)
        {
            try
            {
                await Presence.LeaveAsync(User.TenantId, DocType, Name, sessionId);
            }
            catch { }
        }
    }

    private bool isAutoRepeatDrawerOpen;
    private string autoRepeatName = "";
    private string autoRepeatFreqStr = nameof(AutoRepeatFrequency.Monthly);
    private string autoRepeatStartDateStr = "";
    private bool autoRepeatSubmitOnCreation;
    private string? autoRepeatError;


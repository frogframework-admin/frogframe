    private IEnumerable<SelectOption<string>> AvailableAssigneeOptions
    {
        get
        {
            var alreadyOpen = OpenAssignments.Select(a => a.AssignedTo).ToHashSet(StringComparer.OrdinalIgnoreCase);
            return eligibleAssignees
                .Where(u => !alreadyOpen.Contains(u.Id))
                .Select(u => new SelectOption<string>(u.Id, $"{u.FullName} (@{u.Id})"));
        }
    }

    private void OnAssigneesSelected(IEnumerable<string> values) =>
        assignSelectedUsers = values.Distinct(StringComparer.OrdinalIgnoreCase).ToList();

    private void OpenAssignDrawer()
    {
        assignError = null;
        assignSelectedUsers = [];
        assignDueDate = null;
        assignPriorityStr = nameof(AssignmentPriority.Medium);
        assignDescription = "";
        editingAssignmentId = null;
        isAssignDrawerOpen = true;
    }

    private async Task AssignDocumentAsync()
    {
        if (assignBusy) return;
        assignError = null;
        assignBusy = true;
        try
        {
            DateOnly? due = assignDueDate is { } dt ? DateOnly.FromDateTime(dt.Date) : null;
            var priority = Enum.TryParse<AssignmentPriority>(assignPriorityStr, out var p) ? p : AssignmentPriority.Medium;
            var created = await AssignmentsSvc.AssignAsync(User, DocType, Name, assignSelectedUsers, due, priority, assignDescription);
            assignSelectedUsers = [];
            assignDueDate = null;
            assignDescription = "";
            assignments = await AssignmentsSvc.ListForDocumentAsync(User, DocType, Name);
            audit = await Docs.GetAuditAsync(User, DocType, Name);
            if (created.Count > 0)
                Toasts.Success(T.Format("Assigned to {0} user(s).", created.Count), T["Assigned"]);
        }
        catch (Exception ex) when (ex is ValidationFailedException or PermissionDeniedException or DocumentNotFoundException)
        {
            assignError = ex.Message;
        }
        finally
        {
            assignBusy = false;
        }
    }

    private async Task CompleteAssignmentAsync(Guid id)
    {
        if (assignBusy) return;
        assignError = null;
        assignBusy = true;
        try
        {
            await AssignmentsSvc.CompleteAsync(User, id);
            assignments = await AssignmentsSvc.ListForDocumentAsync(User, DocType, Name);
            audit = await Docs.GetAuditAsync(User, DocType, Name);
            Toasts.Success(T["Task marked as complete."], T["Completed"]);
        }
        catch (Exception ex)
        {
            assignError = ex.Message;
        }
        finally
        {
            assignBusy = false;
        }
    }

    private async Task CancelAssignmentAsync(Guid id)
    {
        if (assignBusy) return;
        assignError = null;
        assignBusy = true;
        try
        {
            await AssignmentsSvc.CancelAsync(User, id);
            assignments = await AssignmentsSvc.ListForDocumentAsync(User, DocType, Name);
            audit = await Docs.GetAuditAsync(User, DocType, Name);
            Toasts.Info(T["Assignment cancelled."], T["Cancelled"]);
        }
        catch (Exception ex)
        {
            assignError = ex.Message;
        }
        finally
        {
            assignBusy = false;
        }
    }

    private void BeginEditAssignment(Assignment a)
    {
        editingAssignmentId = a.Id;
        editDueDate = a.DueDate is { } d ? d.ToDateTime(TimeOnly.MinValue) : null;
        editPriorityStr = a.Priority.ToString();
    }

    private async Task SaveAssignmentEditAsync(Assignment a)
    {
        if (assignBusy) return;
        assignError = null;
        assignBusy = true;
        try
        {
            DateOnly? due = editDueDate is { } dt ? DateOnly.FromDateTime(dt.Date) : null;
            var priority = Enum.TryParse<AssignmentPriority>(editPriorityStr, out var p) ? p : a.Priority;
            await AssignmentsSvc.UpdateAsync(User, a.Id, new UpdateAssignmentRequest(DueDate: due, UpdateDueDate: true, Priority: priority));
            editingAssignmentId = null;
            assignments = await AssignmentsSvc.ListForDocumentAsync(User, DocType, Name);
            audit = await Docs.GetAuditAsync(User, DocType, Name);
            Toasts.Success(T["Assignment updated."], T["Updated"]);
        }
        catch (Exception ex)
        {
            assignError = ex.Message;
        }
        finally
        {
            assignBusy = false;
        }
    }


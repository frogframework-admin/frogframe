@page "/admin/users"
@using System.Security.Cryptography
@using Microsoft.AspNetCore.Identity
@inject UserManager<UserAccount> Users
@inject RoleCatalog RoleCatalogSvc
@inject IUserAccountRepository Accounts
@inject IRoleStore RoleStore
@inject IMetadataProvider Metadata
@inject CurrentUser Current
@inject ToastService Toasts
@inject DialogService Dialogs
@inject TimeProvider Clock
@inject Framework.Preferences.IUserPreferenceStore UserPrefs
@implements IDisposable

<PageTitle>Users · DocFrame</PageTitle>

@if (!Current.Required.IsAdmin)
{
    <BbAlert Variant="AlertVariant.Danger"><BbAlertDescription>This page is only accessible to Administrators / System Managers.</BbAlertDescription></BbAlert>
}
else
{
    <header class="page-head">
        <div>
            <h1>Users</h1>
            <p>Tenant accounts for @Current.Required.TenantId. Roles, departments, and linked employees become claims upon login and determine permissions and data scopes.</p>
        </div>
        <BbButton OnClick="StartCreate"><LucideIcon Name="user-plus" Size="16" /> Add user</BbButton>
    </header>

    @if (tempPassword is not null)
    {
        <BbAlert Variant="AlertVariant.Warning" Class="props-block">
            <BbAlertTitle>Temporary password for @tempFor</BbAlertTitle>
            <BbAlertDescription>
                <code class="temp-password">@tempPassword</code> — send via a secure channel. This password will not be shown again; please ask the user to change it after login.
            </BbAlertDescription>
        </BbAlert>
    }

    <BbDataGrid @key="gridMgr.RenderKey"
                TData="UserAccount"
                Items="@accounts"
                ShowSearch="true"
                SearchPlaceholder="Search users..."
                ShowPagination="true"
                InitialPageSize="10"
                TableContainerClass="table-wrap"
                RowClass="@(a => edit?.Id == a.Id ? "selected" : "")"
                Resizable="true"
                OnColumnResize="gridMgr.HandleResize"
                StateChanged="gridMgr.HandleStateChanged">
        <Toolbar>
            <div style="display:flex;align-items:center;gap:.5rem;margin-left:auto">
                @if (gridMgr.HasCustomLayout)
                {
                    <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" OnClick="ResetColumnsLayout" Title="Reset kolom ke bawaan">
                        <LucideIcon Name="rotate-ccw" Size="14" />
                        <span>Reset Kolom</span>
                    </BbButton>
                }
                <BbDataGridColumnVisibility TData="UserAccount" />
            </div>
        </Toolbar>
        <Columns>
            <BbDataGridPropertyColumn TData="UserAccount" TProp="string" Property="a => a.FullName" Id="name" Title="Name" Sortable="true" Filterable="true"
                                      Width="@gridMgr.GetWidth("name")" Visible="@gridMgr.IsVisible("name")" Resizable="true">
                <CellTemplate Context="item">
                    <div>
                        <strong>@item.FullName</strong>
                        @if (item.EmployeeId is not null)
                        {
                            <div class="muted small">@item.EmployeeId</div>
                        }
                    </div>
                </CellTemplate>
            </BbDataGridPropertyColumn>

            <BbDataGridPropertyColumn TData="UserAccount" TProp="string" Property="a => a.UserName" Id="username" Title="Username" Sortable="true" Filterable="true"
                                      Width="@gridMgr.GetWidth("username", "10rem")" Visible="@gridMgr.IsVisible("username")" Resizable="true">
                <CellTemplate Context="item">
                    <code>@item.UserName</code>
                </CellTemplate>
            </BbDataGridPropertyColumn>

            <BbDataGridPropertyColumn TData="UserAccount" TProp="string" Property="a => a.Department" Id="department" Title="Department" Sortable="true" Filterable="true"
                                      Width="@gridMgr.GetWidth("department", "10rem")" Visible="@gridMgr.IsVisible("department")" Resizable="true">
                <CellTemplate Context="item">
                    @(item.Department ?? "—")
                </CellTemplate>
            </BbDataGridPropertyColumn>

            <BbDataGridTemplateColumn TData="UserAccount" Id="roles" Title="Roles"
                                      Width="@gridMgr.GetWidth("roles")" Visible="@gridMgr.IsVisible("roles")" Resizable="true">
                <ChildContent Context="item">
                    <div class="row" style="gap:.25rem;flex-wrap:wrap">
                        @foreach (var r in item.Roles)
                        {
                            <BbBadge Variant="BadgeVariant.Soft">@r</BbBadge>
                        }
                    </div>
                </ChildContent>
            </BbDataGridTemplateColumn>

            <BbDataGridTemplateColumn TData="UserAccount" Id="status" Title="Status" Sortable="true" SortBy="a => a.IsActive"
                                      Width="@gridMgr.GetWidth("status", "8rem")" Visible="@gridMgr.IsVisible("status")" Resizable="true">
                <ChildContent Context="item">
                    @if (!item.IsActive)
                    {
                        <BbBadge Variant="BadgeVariant.Secondary">Inactive</BbBadge>
                    }
                    else if (item.LockoutEnd > Clock.GetUtcNow())
                    {
                        <BbBadge Variant="BadgeVariant.Destructive">Locked</BbBadge>
                    }
                    else
                    {
                        <BbBadge Variant="BadgeVariant.SoftSuccess">Active</BbBadge>
                    }
                </ChildContent>
            </BbDataGridTemplateColumn>

            <BbDataGridTemplateColumn TData="UserAccount" Id="last_login" Title="Last Login" Sortable="true" SortBy="a => a.LastLoginAt"
                                      Width="@gridMgr.GetWidth("last_login", "10rem")" Visible="@gridMgr.IsVisible("last_login")" Resizable="true">
                <ChildContent Context="item">
                    <span class="muted nowrap">@(item.LastLoginAt is { } t ? Fmt.When(t) : "never")</span>
                </ChildContent>
            </BbDataGridTemplateColumn>

            <BbDataGridTemplateColumn TData="UserAccount" Id="actions" Title="Actions" Width="@gridMgr.GetWidth("actions", "6.5rem")" NoWrap="true" Hideable="false" Resizable="false">
                <ChildContent Context="item">
                    <div style="display:inline-flex;align-items:center;gap:.25rem;flex-wrap:nowrap" @onclick:stopPropagation="true">
                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" AriaLabel="Edit user" Title="Edit user" OnClick="() => StartEdit(item)">
                            <LucideIcon Name="pencil" Size="15" />
                        </BbButton>
                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" AriaLabel="Reset password" Title="Reset password" OnClick="() => ResetPassword(item)">
                            <LucideIcon Name="key-round" Size="15" />
                        </BbButton>
                    </div>
                </ChildContent>
            </BbDataGridTemplateColumn>
        </Columns>
        <EmptyTemplate>
            <div style="padding:2rem;text-align:center;color:var(--muted-foreground)">
                No users found.
            </div>
        </EmptyTemplate>
    </BbDataGrid>

    <AdminDrawer Open="@isDrawerOpen"
                 OpenChanged="@OnDrawerOpenChanged"
                 WidthScale="@DrawerWidthScale"
                 Title="@(edit is null ? "" : isNew ? "New User" : $"Edit: {edit.FullName}")"
                 Description="@(edit is null ? null : isNew ? "A temporary password is generated automatically." : $"Username {edit.UserName} · created {Fmt.When(edit.CreatedAt)}")">
        <ChildContent>
            @if (edit is not null)
            {
                @if (error is not null)
                {
                    <BbAlert Variant="AlertVariant.Danger"><BbAlertDescription>@error</BbAlertDescription></BbAlert>
                }

                <div class="form-cols cols-2">
                    <BbField>
                        <BbFieldLabel For="u-name">Full name</BbFieldLabel>
                        <FormTextInput Id="u-name" Immediate="true" @bind-Value="edit.FullName" Placeholder="e.g. John Doe" />
                    </BbField>
                    @if (isNew)
                    {
                        <BbField>
                            <BbFieldLabel For="u-user">Username</BbFieldLabel>
                            <FormTextInput Id="u-user" Immediate="true" @bind-Value="edit.UserName" Placeholder="e.g. jdoe" />
                            <BbFieldDescription>Lowercase letters, numbers, dots, or underscores. Serves as permanent user ID.</BbFieldDescription>
                        </BbField>
                    }
                    else
                    {
                        <BbField>
                            <BbFieldLabel>Username</BbFieldLabel>
                            <div class="field-static"><code>@edit.UserName</code></div>
                        </BbField>
                    }
                </div>

                <div class="form-cols cols-2">
                    <BbField>
                        <BbFieldLabel For="u-email">Email</BbFieldLabel>
                        <FormTextInput Id="u-email" Type="email" Immediate="true" @bind-Value="edit.Email" Placeholder="e.g. jdoe@company.com" />
                    </BbField>
                    <BbField>
                        <BbFieldLabel For="u-dept">Department</BbFieldLabel>
                        <FormTextInput Id="u-dept" Immediate="true" @bind-Value="edit.Department" Placeholder="e.g. IT, Finance, HR" />
                        <BbFieldDescription>Used for data scope &quot;match:department&quot;.</BbFieldDescription>
                    </BbField>
                </div>

                @if (Metadata.Current.TryGet("Employee", out _))
                {
                    <BbField>
                        <BbFieldLabel>Employee</BbFieldLabel>
                        <div class="fill-trigger"><LinkInput Target="Employee" Label="Employee" Value="@edit.EmployeeId" ValueChanged="v => edit.EmployeeId = v" ShowLookup="true" /></div>
                    </BbField>
                }

                <div class="props-sub">Roles &amp; Permissions</div>
                <div class="role-check-grid">
                    @foreach (var role in KnownRoles)
                    {
                        var r = role;
                        var self = !isNew && edit.Id == Current.Required.Id && (r == UserContext.SystemManager || r == UserContext.Administrator);
                        <div class="label-row">
                            <BbCheckbox Id="@($"r-{r}")" Checked="edit.Roles.Contains(r)" Disabled="self" CheckedChanged="v => ToggleRole(r, v)" />
                            <BbLabel For="@($"r-{r}")">@r@(self ? " (yourself)" : "")</BbLabel>
                        </div>
                    }
                </div>

                @if (!isNew)
                {
                    <div class="label-row" style="margin-top:.5rem">
                        <BbCheckbox Id="u-active" Checked="edit.IsActive" Disabled="@(edit.Id == Current.Required.Id)" CheckedChanged="v => edit.IsActive = v" />
                        <BbLabel For="u-active">Active (can login)</BbLabel>
                    </div>
                }
            }
        </ChildContent>
        <FooterContent>
            @if (edit is not null)
            {
                <div class="stack" style="gap:.75rem;width:100%">
                    <div class="row" style="gap:.5rem;width:100%;align-items:center">
                        <BbButton Disabled="busy" Loading="busy" LoadingText="@(isNew ? "Creating…" : "Saving…")" OnClick="Save"><LucideIcon Name="check" Size="16" /> @(isNew ? "Create user" : "Save")</BbButton>
                        <BbButton Variant="ButtonVariant.Ghost" OnClick="CloseDrawer">Cancel</BbButton>
                    </div>
                    @if (!isNew && edit.LockoutEnd > Clock.GetUtcNow())
                    {
                        <div class="row" style="border-top:1px solid var(--border);padding-top:.75rem;gap:.5rem">
                            <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" Disabled="busy" OnClick="Unlock"><LucideIcon Name="lock-open" Size="15" /> Unlock account</BbButton>
                        </div>
                    }
                </div>
            }
        </FooterContent>
    </AdminDrawer>
}

@code {
    /// <summary>Configurable drawer width multiplier (default 2.0 = 2x normal width for User form).</summary>
    [Parameter] public double DrawerWidthScale { get; set; } = 2.0;

    private IReadOnlyList<UserAccount> accounts = [];
    private IReadOnlyList<RoleDef> storedRoles = [];
    private UserAccount? edit;
    private bool isDrawerOpen;
    private bool isNew, busy;
    private string? error, tempPassword, tempFor;
    private Framework.Web.Services.DataGridPreferenceManager<UserAccount> gridMgr = default!;

    /// <summary>Role yang dikenal: dari master role, permission semua DocType, role workflow, dan System Manager/Administrator.</summary>
    private IEnumerable<string> KnownRoles => RoleCatalogSvc.Names(Current.Required.TenantId)
        .Concat(edit?.Roles ?? []).Distinct().Order();

    protected override async Task OnInitializedAsync()
    {
        gridMgr = new(UserPrefs, Current, "grid:admin:users", StateHasChanged);
        if (Current.User is null) return;
        await gridMgr.InitializeAsync();
        storedRoles = await RoleStore.ListAsync(Current.Required.TenantId);
        await Reload();
    }

    private async Task ResetColumnsLayout()
    {
        await gridMgr.ResetAsync();
        Toasts.Success("Tata letak kolom telah dikembalikan ke bawaan.", "Reset Kolom");
    }

    public void Dispose()
    {
        gridMgr?.Dispose();
    }

    private async Task Reload() => accounts = await Accounts.ListAsync(Current.Required.TenantId);

    private MarkupString Status(UserAccount a) => (MarkupString)(
        !a.IsActive ? "<span class=\"muted\">Inactive</span>"
        : a.LockoutEnd > Clock.GetUtcNow() ? "<span style=\"color:var(--destructive)\">Locked</span>"
        : "Active");

    private void StartCreate()
    {
        edit = new UserAccount { TenantId = Current.Required.TenantId, Roles = ["Employee"] };
        isNew = true; error = null; tempPassword = null;
        isDrawerOpen = true;
    }

    private async Task StartEdit(UserAccount a)
    {
        // Selalu muat ulang dari penyimpanan, dan pastikan akun milik tenant yang sama.
        var fresh = await Accounts.FindByIdAsync(a.Id);
        if (fresh is null || fresh.TenantId != Current.Required.TenantId) return;
        edit = fresh; isNew = false; error = null; tempPassword = null;
        isDrawerOpen = true;
    }

    private void CloseDrawer()
    {
        isDrawerOpen = false;
    }

    private void OnDrawerOpenChanged(bool open)
    {
        isDrawerOpen = open;
        if (!open)
        {
            edit = null;
            error = null;
        }
    }

    private void ToggleRole(string role, bool on)
    {
        if (on && !edit!.Roles.Contains(role)) edit.Roles.Add(role);
        if (!on) edit!.Roles.Remove(role);
    }

    private async Task Save()
    {
        if (edit is null || busy) return;
        error = null;

        // Validate inputs before toggling busy state and triggering a re-render.
        if (string.IsNullOrWhiteSpace(edit.FullName))
        {
            error = "Full name is required.";
            Toasts.Error(error, "Failed to Save");
            return;
        }
        if (edit.Roles.Count == 0)
        {
            error = "Select at least one role.";
            Toasts.Error(error, "Failed to Save");
            return;
        }
        var unknown = await RoleCatalogSvc.UnknownAccountRolesAsync(Current.Required.TenantId, edit.Roles);
        if (unknown.Count > 0)
        {
            error = "Role belum ada di master role: " + string.Join(", ", unknown) + ". Buat dulu di Role Admin.";
            Toasts.Error(error, "Failed to Save");
            return;
        }
        if (isNew)
        {
            edit.UserName = (edit.UserName ?? "").Trim().ToLowerInvariant();
            if (!System.Text.RegularExpressions.Regex.IsMatch(edit.UserName, "^[a-z0-9._]{3,40}$"))
            {
                error = "Username must be 3–40 characters: lowercase letters, numbers, dots, or underscores.";
                Toasts.Error(error, "Failed to Save");
                return;
            }
        }
        else if (edit.Id == Current.Required.Id && (!edit.IsActive || (!edit.Roles.Contains(UserContext.SystemManager) && !edit.Roles.Contains(UserContext.Administrator))))
        {
            error = "You cannot deactivate your own account or revoke System Manager / Administrator roles from yourself.";
            Toasts.Error(error, "Failed to Save");
            return;
        }

        busy = true;
        StateHasChanged();
        try
        {
            edit.TenantId = Current.Required.TenantId; // Tenant cannot be changed from UI.
            edit.FullName = edit.FullName.Trim();
            edit.Department = string.IsNullOrWhiteSpace(edit.Department) ? null : edit.Department.Trim();
            edit.Email = string.IsNullOrWhiteSpace(edit.Email) ? null : edit.Email.Trim();
            if (isNew)
            {
                var password = NewTemporaryPassword();
                var result = await Users.CreateAsync(edit, password);
                if (!result.Succeeded)
                {
                    error = string.Join(" ", result.Errors.Select(e => e.Description));
                    Toasts.Error(error, "Failed to Save");
                    return;
                }
                (tempPassword, tempFor) = (password, edit.UserName);
                Toasts.Success($"Account {edit.UserName} created.", "New User");
            }
            else
            {
                var result = await Users.UpdateAsync(edit);
                if (!result.Succeeded)
                {
                    error = string.Join(" ", result.Errors.Select(e => e.Description));
                    Toasts.Error(error, "Failed to Save");
                    return;
                }
                // Rotate security stamp so active sessions reload updated role/department/status claims on next validation.
                await Users.UpdateSecurityStampAsync(edit);
                Toasts.Success("Changes will take effect once user sessions refresh (within a few minutes).", "Saved");
            }
            isDrawerOpen = false;
            await Reload();
        }
        catch (Exception ex)
        {
            error = ex.Message;
            Toasts.Error(ex.Message, "Failed to Save");
        }
        finally { busy = false; }
    }

    private async Task ResetPassword(UserAccount target)
    {
        var ok = await Dialogs.ConfirmAsync($"Reset password for {target.UserName}?", "The current password will no longer work and active user sessions will end.",
            new ConfirmDialogOptions { ConfirmText = "Reset password", CancelText = "Cancel" });
        if (!ok.Confirmed) return;
        busy = true;
        try
        {
            var user = await Users.FindByIdAsync(target.Id);
            if (user is null)
            {
                Toasts.Error("User not found.", "Failed");
                return;
            }
            var password = NewTemporaryPassword();
            await Users.RemovePasswordAsync(user);
            var result = await Users.AddPasswordAsync(user, password);
            if (!result.Succeeded)
            {
                Toasts.Error(string.Join(" ", result.Errors.Select(e => e.Description)), "Failed to reset password");
                return;
            }
            (tempPassword, tempFor) = (password, user.UserName);
            Toasts.Success($"Temporary password for {user.UserName} successfully generated.", "Reset Password");
            if (isDrawerOpen && edit?.Id == target.Id)
            {
                CloseDrawer();
            }
            await Reload();
        }
        finally { busy = false; }
    }

    private async Task Unlock()
    {
        var user = (await Users.FindByIdAsync(edit!.Id))!;
        await Users.SetLockoutEndDateAsync(user, null);
        await Users.ResetAccessFailedCountAsync(user);
        Toasts.Success($"{user.UserName} can now log in again.", "Account Unlocked");
        CloseDrawer();
        await Reload();
    }

    /// <summary>Password sementara acak yang memenuhi kebijakan (≥10 karakter, huruf besar, huruf kecil, angka).</summary>
    private static string NewTemporaryPassword()
    {
        const string upper = "ABCDEFGHJKLMNPQRSTUVWXYZ", lower = "abcdefghijkmnpqrstuvwxyz", digits = "23456789";
        var all = upper + lower + digits;
        var chars = new List<char> { upper[RandomNumberGenerator.GetInt32(upper.Length)], lower[RandomNumberGenerator.GetInt32(lower.Length)], digits[RandomNumberGenerator.GetInt32(digits.Length)] };
        while (chars.Count < 14) chars.Add(all[RandomNumberGenerator.GetInt32(all.Length)]);
        return new string(chars.OrderBy(_ => RandomNumberGenerator.GetInt32(1000)).ToArray());
    }
}

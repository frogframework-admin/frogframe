@page "/admin/applications"
@using Framework.Navigation
@using Framework.Web.Admin
@inject INavigationMenuStore MenuStore
@inject CurrentUser Current
@inject ToastService Toasts
@inject DialogService Dialogs
@inject Framework.Preferences.IUserPreferenceStore UserPrefs
@implements IDisposable

<PageTitle>Applications · FrogFrame</PageTitle>

@if (!Current.Required.IsAdmin)
{
    <ErrorState StatusCode="403" Description="This administration page is restricted to System Managers / Administrators." />
}
else
{
    <header class="page-head">
        <div>
            <h1>Applications</h1>
            <p>Manage top-level applications (HRM, CRM, Finance, Accounting, IT).</p>
        </div>
        <div class="row" style="gap:.5rem;flex-wrap:wrap">
            <BbButton Variant="ButtonVariant.Outline" Disabled="@(gridMgr.SelectedCount == 0 || busy)" OnClick="() => bulkEditOpen = true">
                <LucideIcon Name="pencil" Size="16" /> Bulk Edit @(gridMgr.SelectedCount > 0 ? $"({gridMgr.SelectedCount})" : "")
            </BbButton>
            <BbButton Variant="ButtonVariant.Outline" Disabled="@(gridMgr.SelectedCount == 0 || busy)" OnClick="() => BulkSetActiveAsync(true)">
                <LucideIcon Name="circle-check" Size="16" /> Activate @(gridMgr.SelectedCount > 0 ? $"({gridMgr.SelectedCount})" : "")
            </BbButton>
            <BbButton Variant="ButtonVariant.Outline" Disabled="@(gridMgr.SelectedCount == 0 || busy)" OnClick="() => BulkSetActiveAsync(false)">
                <LucideIcon Name="circle-x" Size="16" /> Deactivate @(gridMgr.SelectedCount > 0 ? $"({gridMgr.SelectedCount})" : "")
            </BbButton>
            <BbButton Variant="ButtonVariant.Destructive" Disabled="@(gridMgr.SelectedCount == 0 || busy)" OnClick="BulkDeleteAsync">
                <LucideIcon Name="trash-2" Size="16" /> Delete @(gridMgr.SelectedCount > 0 ? $"({gridMgr.SelectedCount})" : "")
            </BbButton>
            <BbButton Variant="ButtonVariant.Outline" Disabled="busy" OnClick="ResetDefaults"><LucideIcon Name="rotate-ccw" Size="16" /> Seed Defaults</BbButton>
            <BbButton OnClick="StartCreate"><LucideIcon Name="plus" Size="16" /> Add application</BbButton>
        </div>
    </header>

    <BbDataGrid @key="gridMgr.RenderKey"
                TData="NavigationApplication"
                Items="@applications"
                ShowSearch="true"
                SearchPlaceholder="Search applications..."
                ShowPagination="true"
                InitialPageSize="10"
                TableContainerClass="table-wrap"
                RowClass="@(a => edit?.Id == a.Id || gridMgr.IsSelected(a) ? "selected" : "")"
                Resizable="true"
                OnColumnResize="gridMgr.HandleResize"
                StateChanged="gridMgr.HandleStateChanged">
        <Toolbar>
            <AdminGridToolbar TData="NavigationApplication" Grid="gridMgr" Items="@applications" FileName="applications" Columns="@ExportColumns" />
        </Toolbar>
        <Columns>
            <AdminGridSelectColumn TData="NavigationApplication" Grid="gridMgr" Items="@applications" Title="" />

            <BbDataGridPropertyColumn TData="NavigationApplication" TProp="int" Property="a => a.SortOrder" Id="order" Title="Order"
                                      Width="@gridMgr.GetWidth("order", "5rem")" Visible="@gridMgr.IsVisible("order")" Resizable="true" Sortable="true">
                <CellTemplate Context="item">
                    <code>@item.SortOrder</code>
                </CellTemplate>
            </BbDataGridPropertyColumn>

            <BbDataGridPropertyColumn TData="NavigationApplication" TProp="string" Property="a => a.Name" Id="application" Title="Application"
                                      Width="@gridMgr.GetWidth("application", "18rem")" Visible="@gridMgr.IsVisible("application")" Resizable="true" Sortable="true" Filterable="true">
                <CellTemplate Context="item">
                    <div class="row" style="gap:.6rem;align-items:center;flex-wrap:nowrap">
                        <div style="display:grid;place-items:center;width:2rem;height:2rem;border-radius:var(--radius);background:var(--muted);flex-shrink:0">
                            <LucideIcon Name="@(string.IsNullOrWhiteSpace(item.Icon) ? "app-window" : item.Icon)" Size="16" />
                        </div>
                        <div style="min-width:0">
                            <strong>@item.Name</strong>
                            @if (!string.IsNullOrWhiteSpace(item.Description))
                            {
                                <div class="muted small" style="white-space:normal">@item.Description</div>
                            }
                        </div>
                    </div>
                </CellTemplate>
            </BbDataGridPropertyColumn>

            <BbDataGridPropertyColumn TData="NavigationApplication" TProp="string" Property="a => a.Code" Id="code" Title="Code"
                                      Width="@gridMgr.GetWidth("code", "9rem")" Visible="@gridMgr.IsVisible("code")" Resizable="true" Sortable="true">
                <CellTemplate Context="item">
                    <code>@item.Code</code>
                </CellTemplate>
            </BbDataGridPropertyColumn>

            <BbDataGridTemplateColumn TData="NavigationApplication" Id="status" Title="Status"
                                      Width="@gridMgr.GetWidth("status", "9rem")" Visible="@gridMgr.IsVisible("status")" Resizable="true" Sortable="true" SortBy="a => a.IsActive">
                <ChildContent Context="item">
                    <div class="row" style="gap:.25rem;flex-wrap:nowrap">
                        @if (item.IsSystem)
                        {
                            <BbBadge Variant="BadgeVariant.Soft">System</BbBadge>
                        }
                        @if (item.IsActive)
                        {
                            <BbBadge Variant="BadgeVariant.SoftSuccess">Active</BbBadge>
                        }
                        else
                        {
                            <BbBadge Variant="BadgeVariant.Secondary">Inactive</BbBadge>
                        }
                    </div>
                </ChildContent>
            </BbDataGridTemplateColumn>

            <BbDataGridTemplateColumn TData="NavigationApplication" Id="actions" Title="Actions" Width="@gridMgr.GetWidth("actions", "7.5rem")" Hideable="false" Resizable="false">
                <ChildContent Context="item">
                    <div style="display:inline-flex;align-items:center;gap:.25rem;flex-wrap:nowrap" @onclick:stopPropagation="true">
                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" AriaLabel="Edit application" OnClick="() => StartEdit(item)">
                            <LucideIcon Name="pencil" Size="15" />
                        </BbButton>
                        @if (!item.IsSystem)
                        {
                            <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" AriaLabel="Delete application" OnClick="() => ConfirmDelete(item)">
                                <LucideIcon Name="trash-2" Size="15" />
                            </BbButton>
                        }
                    </div>
                </ChildContent>
            </BbDataGridTemplateColumn>
        </Columns>
        <EmptyTemplate>
            <div style="padding:2rem;text-align:center;color:var(--muted-foreground)">
                No applications found.
            </div>
        </EmptyTemplate>
    </BbDataGrid>

    <AdminDrawer Open="@isDrawerOpen"
                 OpenChanged="@OnDrawerOpenChanged"
                 WidthScale="@DrawerWidthScale"
                 Title="@(edit is null ? "" : isNew ? "Add New Application" : $"Edit: {edit.Name}")"
                 Description="@(edit is null ? null : edit.IsSystem ? "Built-in system application (cannot be deleted, but name, icon, and sort order can be edited)." : "Custom application.")">
        <ChildContent>
            @if (edit is not null)
            {
                @if (error is not null)
                {
                    <BbAlert Variant="AlertVariant.Danger"><BbAlertDescription>@error</BbAlertDescription></BbAlert>
                }

                <div class="form-cols cols-2">
                    <BbField>
                        <BbFieldLabel For="app-name">Application Name</BbFieldLabel>
                        <FormTextInput Id="app-name" Immediate="true" @bind-Value="edit.Name" Placeholder="e.g. HRM, Finance, Accounting, IT" />
                    </BbField>
                    <BbField>
                        <BbFieldLabel For="app-code">Application Code (required, unique)</BbFieldLabel>
                        <FormTextInput Id="app-code" @bind-Value="edit.Code" Disabled="!isNew" Placeholder="e.g. HRM, FINANCE, ACCOUNTING, IT" />
                        <BbFieldDescription>Uppercase letters, numbers, or underscores. Cannot be changed once created.</BbFieldDescription>
                    </BbField>

                    <BbField>
                        <BbFieldLabel For="app-order">Order (Sort Order)</BbFieldLabel>
                        <FormTextInput Id="app-order" Type="number" Immediate="true" Value="@edit.SortOrder.ToString()" ValueChanged="v => edit.SortOrder = int.TryParse(v, out var n) ? n : edit.SortOrder" />
                        <BbFieldDescription>Lower numbers appear earlier (e.g. 10, 20, 30).</BbFieldDescription>
                    </BbField>
                </div>

                <BbField>
                    <BbFieldLabel For="app-desc">Description</BbFieldLabel>
                    <FormTextInput Id="app-desc" Immediate="true" @bind-Value="edit.Description" Placeholder="e.g. Human Resource Management" />
                </BbField>

                <BbField>
                    <BbFieldLabel For="app-icon">Icon</BbFieldLabel>
                    <IconPicker Id="app-icon" @bind-Value="edit.Icon" Placeholder="Select an icon..." />
                </BbField>

                <div class="label-row" style="margin-top:.5rem">
                    <BbCheckbox Id="app-active" Checked="edit.IsActive" CheckedChanged="v => edit.IsActive = v" />
                    <BbLabel For="app-active">Active</BbLabel>
                </div>
            }
        </ChildContent>
        <FooterContent>
            @if (edit is not null)
            {
                <div class="row" style="gap:.5rem;width:100%;align-items:center">
                    <BbButton Disabled="busy" Loading="busy" LoadingText="Saving…" OnClick="Save"><LucideIcon Name="check" Size="16" /> Save</BbButton>
                    <BbButton Variant="ButtonVariant.Ghost" OnClick="CloseDrawer">Cancel</BbButton>
                    @if (!isNew && !edit.IsSystem)
                    {
                        <span style="margin-left:auto">
                            <BbButton Variant="ButtonVariant.Destructive" Size="ButtonSize.Small" Disabled="busy" OnClick="() => ConfirmDelete(edit)">
                                <LucideIcon Name="trash-2" Size="15" /> Delete
                            </BbButton>
                        </span>
                    }
                </div>
            }
        </FooterContent>
    </AdminDrawer>

    <AdminBulkEditDrawer Open="@bulkEditOpen"
                         OpenChanged="v => bulkEditOpen = v"
                         Title="Bulk Edit Applications"
                         SelectedCount="@gridMgr.SelectedCount"
                         Fields="@BulkEditFields"
                         Busy="@busy"
                         OnApply="ExecuteBulkEditAsync" />
}

@code {
    [Parameter] public double DrawerWidthScale { get; set; } = 2.0;

    private IReadOnlyList<NavigationApplication> applications = [];
    private NavigationApplication? edit;
    private bool isDrawerOpen;
    private bool bulkEditOpen;
    private bool isNew;
    private bool busy;
    private string? error;
    private Framework.Web.Services.DataGridPreferenceManager<NavigationApplication> gridMgr = default!;

    private IReadOnlyList<GridExportColumn<NavigationApplication>> ExportColumns =>
    [
        new("order", "Order", a => a.SortOrder),
        new("application", "Application", a => a.Name),
        new("code", "Code", a => a.Code),
        new("application", "Description", a => a.Description),
        new("status", "Status", a => a.IsActive ? "Active" : "Inactive"),
        new("status", "Type", a => a.IsSystem ? "System" : "Custom")
    ];

    private static readonly IReadOnlyList<AdminBulkEditField> BulkEditFields =
    [
        new("status", "Active Status", "boolean"),
        new("icon", "Icon Name", "text", Placeholder: "e.g. app-window, briefcase")
    ];

    protected override async Task OnInitializedAsync()
    {
        gridMgr = new(UserPrefs, Current, "grid:admin:applications", StateHasChanged);
        if (Current.User is null) return;
        await gridMgr.InitializeAsync();
        await Reload();
    }

    public void Dispose() => gridMgr?.Dispose();

    private async Task Reload()
    {
        applications = await MenuStore.ListApplicationsAsync(Current.Required.TenantId, onlyActive: false);
        gridMgr.RetainSelection(applications);
    }

    private async Task BulkSetActiveAsync(bool active)
    {
        var selected = gridMgr.GetSelectedItems(applications);
        if (selected.Count == 0 || busy) return;
        busy = true;
        try
        {
            foreach (var item in selected)
            {
                item.IsActive = active;
                await MenuStore.SaveApplicationAsync(item);
                gridMgr.SelectedIds.Remove(item.Id);
            }
            await Reload();
            Toasts.Success($"{selected.Count} application(s) {(active ? "activated" : "deactivated")}.", "Bulk Action");
        }
        catch (Exception ex) { Toasts.Error(ex.Message, "Bulk Action Failed"); }
        finally { busy = false; }
    }

    private async Task ExecuteBulkEditAsync(string field, string value)
    {
        var selected = gridMgr.GetSelectedItems(applications);
        if (selected.Count == 0 || busy) return;
        busy = true;
        try
        {
            foreach (var item in selected)
            {
                if (field == "status")
                    item.IsActive = string.Equals(value, "true", StringComparison.OrdinalIgnoreCase);
                else if (field == "icon" && !string.IsNullOrWhiteSpace(value))
                    item.Icon = value.Trim();
                await MenuStore.SaveApplicationAsync(item);
                gridMgr.SelectedIds.Remove(item.Id);
            }
            bulkEditOpen = false;
            await Reload();
            Toasts.Success($"{selected.Count} application(s) updated.", "Bulk Edit Complete");
        }
        catch (Exception ex) { Toasts.Error(ex.Message, "Bulk Edit Failed"); }
        finally { busy = false; }
    }

    private async Task BulkDeleteAsync()
    {
        var selected = gridMgr.GetSelectedItems(applications);
        if (selected.Count == 0 || busy) return;
        var res = await Dialogs.ConfirmAsync(
            $"Delete {selected.Count} application(s)?",
            "Custom applications will be deleted. Built-in system applications will be skipped.",
            new ConfirmDialogOptions { Destructive = true, ConfirmText = $"Delete ({selected.Count})", CancelText = "Cancel" });
        if (!res.Confirmed) return;

        busy = true;
        try
        {
            int deleted = 0, skipped = 0;
            foreach (var item in selected)
            {
                if (item.IsSystem) { skipped++; continue; }
                try
                {
                    await MenuStore.DeleteApplicationAsync(item.Id, item.TenantId);
                    deleted++;
                    gridMgr.SelectedIds.Remove(item.Id);
                }
                catch { skipped++; }
            }
            await Reload();
            if (deleted > 0) Toasts.Success($"{deleted} application(s) deleted.", "Bulk Delete");
            if (skipped > 0) Toasts.Warning($"{skipped} application(s) skipped (system application).", "Skipped");
        }
        finally { busy = false; }
    }

    private void StartCreate()
    {
        error = null;
        isNew = true;
        edit = new NavigationApplication
        {
            Id = Guid.NewGuid().ToString("N"),
            TenantId = Current.Required.TenantId,
            Name = "",
            Code = "",
            Description = "",
            Icon = "app-window",
            SortOrder = applications.Count > 0 ? applications.Max(a => a.SortOrder) + 10 : 10,
            IsActive = true,
            IsSystem = false
        };
        isDrawerOpen = true;
    }

    private void StartEdit(NavigationApplication item)
    {
        error = null;
        isNew = false;
        edit = new NavigationApplication
        {
            Id = item.Id,
            TenantId = item.TenantId,
            Name = item.Name,
            Code = item.Code,
            Description = item.Description,
            Icon = item.Icon,
            SortOrder = item.SortOrder,
            IsSystem = item.IsSystem,
            IsActive = item.IsActive,
            CreatedAt = item.CreatedAt,
            UpdatedAt = item.UpdatedAt
        };
        isDrawerOpen = true;
    }

    private void CloseDrawer() => isDrawerOpen = false;

    private void OnDrawerOpenChanged(bool open)
    {
        isDrawerOpen = open;
        if (!open)
        {
            edit = null;
            error = null;
        }
    }

    private async Task Save()
    {
        if (edit is null || busy) return;
        if (string.IsNullOrWhiteSpace(edit.Name))
        {
            error = "Application name cannot be empty.";
            Toasts.Error(error, "Failed to Save");
            return;
        }

        edit.Name = edit.Name.Trim();
        try { edit.Code = NavigationApplication.NormalizeCode(edit.Code); }
        catch (ArgumentException ex) { error = ex.Message; Toasts.Error(ex.Message, "Failed to Save"); return; }
        edit.Description = string.IsNullOrWhiteSpace(edit.Description) ? null : edit.Description.Trim();
        edit.Icon = string.IsNullOrWhiteSpace(edit.Icon) ? "app-window" : edit.Icon.Trim();

        busy = true;
        error = null;
        StateHasChanged();

        try
        {
            await MenuStore.SaveApplicationAsync(edit);
            Toasts.Success($"Application \"{edit.Name}\" successfully saved.", "Successfully Saved");
            isDrawerOpen = false;
            await Reload();
        }
        catch (Exception ex)
        {
            error = ex.Message;
            Toasts.Error(ex.Message, "Failed to Save");
        }
        finally { busy = false; }
    }

    private async Task ConfirmDelete(NavigationApplication item)
    {
        if (item.IsSystem)
        {
            Toasts.Error("Built-in system applications cannot be deleted.", "Not Allowed");
            return;
        }

        var res = await Dialogs.ConfirmAsync(
            $"Delete application \"{item.Name}\"?",
            "This action cannot be undone.",
            new ConfirmDialogOptions { Destructive = true, ConfirmText = "Delete Application", CancelText = "Cancel" });

        if (!res.Confirmed) return;

        busy = true;
        try
        {
            await MenuStore.DeleteApplicationAsync(item.Id, item.TenantId);
            if (edit?.Id == item.Id) isDrawerOpen = false;
            Toasts.Success($"Application \"{item.Name}\" successfully deleted.", "Application Deleted");
            await Reload();
        }
        catch (Exception ex) { Toasts.Error(ex.Message, "Failed to Delete Application"); }
        finally { busy = false; }
    }

    private async Task ResetDefaults()
    {
        var res = await Dialogs.ConfirmAsync(
            "Seed / Restore Default Applications?",
            "The system will verify and seed missing applications, modules, menu groups, and built-in menus into the database.",
            new ConfirmDialogOptions { ConfirmText = "Run Seed", CancelText = "Cancel" });

        if (!res.Confirmed) return;

        busy = true;
        try
        {
            await MenuStore.EnsureDefaultMenusAsync(Current.Required.TenantId);
            Toasts.Success("Default applications successfully verified and seeded.", "Seed Successful");
            await Reload();
        }
        catch (Exception ex) { Toasts.Error(ex.Message, "Failed to Seed Applications"); }
        finally { busy = false; }
    }
}

@* DocType access editor: permission rules, document rules, and API. Permission changes are classified
   as "risky" by the diff (requires security review) so publishing requires confirmation. *@

<div class="stack">
    <BbCard>
        <BbCardHeader>
            <BbCardTitle Class="card-title">Who can do what</BbCardTitle>
            <BbCardDescription>System Manager always has full access. Scope "Own records" = documents created by the user; "Match user attribute" = e.g. document department matches user department.</BbCardDescription>
        </BbCardHeader>
        <BbCardContent>
            <div class="table-wrap">
                <table class="perm-table">
                    <thead>
                        <tr>
                            <th>Role</th>
                            @foreach (var a in Actions) { <th class="c" title="@a.Hint">@a.Label</th> }
                            <th>Data scope</th><th>Field level</th><th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < Def.Permissions.Count; i++)
                        {
                            var idx = i; var p = Def.Permissions[i];
                            <tr>
                                <td style="min-width:10rem"><BbSelect TValue="string" Value="@p.Role" ValueChanged="v => Set(() => p.Role = v ?? p.Role)" Options="RoleOptions" AriaLabel="Role" /></td>
                                @foreach (var a in Actions)
                                {
                                    var key = a.Key;
                                    <td class="c"><BbCheckbox Checked="p.Actions.Contains(key)" CheckedChanged="v => Set(() => Toggle(p.Actions, key, v))" AriaLabel="@($"{p.Role}: {a.Label}")" /></td>
                                }
                                <td style="min-width:13rem">
                                    <BbSelect TValue="string" Value="@ScopeKind(p.Scope)" ValueChanged="v => SetScopeKind(p, v)" Options="ScopeOptions" AriaLabel="Data scope" />
                                    @if (ScopeKind(p.Scope) == "match")
                                    {
                                        var (field, attr) = MatchParts(p.Scope);
                                        <div class="row" style="margin-top:.35rem;flex-wrap:nowrap">
                                            <BbSelect TValue="string" Value="@field" ValueChanged="v => SetMatch(p, v, null)" Options="FieldOptions" AriaLabel="Document field" />
                                            <span class="muted small">=</span>
                                            <BbSelect TValue="string" Value="@attr" ValueChanged="v => SetMatch(p, null, v)" Options="AttrOptions" AriaLabel="User attribute" />
                                        </div>
                                    }
                                </td>
                                <td style="min-width:6rem"><BbSelect TValue="string" Value="@p.PermLevel.ToString()" ValueChanged="v => Set(() => p.PermLevel = int.Parse(v!))" Options="LevelOptions" AriaLabel="Field level" /></td>
                                <td><BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" AriaLabel="Delete rule" OnClick="() => Set(() => Def.Permissions.RemoveAt(idx))"><LucideIcon Name="trash-2" Size="15" /></BbButton></td>
                            </tr>
                        }
                        @if (Def.Permissions.Count == 0) { <tr><td colspan="@(Actions.Length + 4)" class="grid-empty">No rules yet — only System Manager has access.</td></tr> }
                    </tbody>
                </table>
            </div>
            <div class="row" style="margin-top:.6rem">
                <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="AddRule"><LucideIcon Name="plus" Size="15" /> Add rule</BbButton>
                <BbInput Value="@newRole" ValueChanged="v => newRole = v" Placeholder="New role (optional), e.g. HR" AriaLabel="New role" Style="max-width:16rem" />
            </div>
            @if (Errors.Any(e => e.Path.StartsWith("permissions")))
            {
                <BbAlert Variant="AlertVariant.Danger" Class="props-block" Style="margin-top:.75rem"><BbAlertDescription><ul class="error-list">@foreach (var e in Errors.Where(e => e.Path.StartsWith("permissions"))) { <li>@e.Message</li> }</ul></BbAlertDescription></BbAlert>
            }
        </BbCardContent>
    </BbCard>

    <div class="wf-grid" style="margin-top:0">
        <BbCard>
            <BbCardHeader><BbCardTitle Class="card-title">Document rules</BbCardTitle><BbCardDescription>@(Def.Workflow is null ? "Without a workflow, documents use Submit/Cancel buttons." : "Document status is managed by workflow; submit/cancel below are not used.")</BbCardDescription></BbCardHeader>
            <BbCardContent>
                <div class="stack">
                    @Flag("d-submit", "Can be submitted (locked)", Def.Document.AllowSubmit, v => Def.Document.AllowSubmit = v, Def.Workflow is not null)
                    @Flag("d-cancel", "Can be cancelled after submit", Def.Document.AllowCancel, v => Def.Document.AllowCancel = v, Def.Workflow is not null)
                    @Flag("d-amend", "Can be amended (revised from cancelled/rejected document)", Def.Document.AllowAmend, v => Def.Document.AllowAmend = v, false)
                    @Flag("d-delete", "Draft can be deleted", Def.Document.AllowDelete, v => Def.Document.AllowDelete = v, false)
                    @Flag("d-track", "Track changes (audit)", Def.Document.TrackChanges, v => Def.Document.TrackChanges = v, false)
                </div>
            </BbCardContent>
        </BbCard>
        <BbCard>
            <BbCardHeader><BbCardTitle Class="card-title">API</BbCardTitle><BbCardDescription>Access via /api/data/@Def.Name with bearer token; permissions above still apply.</BbCardDescription></BbCardHeader>
            <BbCardContent>
                <div class="stack">
                    @Flag("api-on", "Enable API", Def.Api.Enabled, v => Def.Api.Enabled = v, false)
                    @if (Def.Api.Enabled)
                    {
                        <div class="wf-roles">
                            @foreach (var op in ApiOps)
                            {
                                var o = op;
                                <div class="label-row"><BbCheckbox Id="@($"api-{o.Key}")" Checked="Def.Api.Operations.Contains(o.Key)" CheckedChanged="v => Set(() => Toggle(Def.Api.Operations, o.Key, v))" /><BbLabel For="@($"api-{o.Key}")">@o.Label</BbLabel></div>
                            }
                        </div>
                    }
                </div>
            </BbCardContent>
        </BbCard>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public DocTypeDef Def { get; set; } = default!;
    [Parameter, EditorRequired] public IEnumerable<FieldDef> Fields { get; set; } = [];
    [Parameter, EditorRequired] public MetadataSnapshot Snapshot { get; set; } = default!;
    [Parameter] public IReadOnlyList<MetadataError> Errors { get; set; } = [];
    [Parameter] public EventCallback OnChanged { get; set; }

    private string? newRole;
    private sealed record Act(string Key, string Label, string Hint);
    private static readonly Act[] Actions =
    [
        new("read", "Read", "View list & document"), new("create", "Create", "Create new document"), new("write", "Edit", "Edit draft"),
        new("delete", "Delete", "Delete draft"), new("submit", "Submit", "Without workflow: lock document"), new("cancel", "Cancel", "Without workflow: cancel document"),
        new("amend", "Amend", "Create revision"), new("report", "Report", "View reports"), new("export", "Export", "Export CSV"),
    ];
    private static readonly (string Key, string Label)[] ApiOps =
        [("list", "List"), ("read", "Read"), ("create", "Create"), ("update", "Update"), ("delete", "Delete"), ("action", "Workflow action")];

    private IEnumerable<SelectOption<string>> RoleOptions =>
        MetadataRoles.Known(Snapshot, Def.Permissions.Select(p => p.Role)).Select(r => new SelectOption<string>(r, r));
    private static readonly IEnumerable<SelectOption<string>> ScopeOptions =
        [new("all", "All documents"), new("owner", "Own records"), new("match", "Match user attribute")];
    private static readonly IEnumerable<SelectOption<string>> LevelOptions = [new("0", "0 (general)"), new("1", "1"), new("2", "2")];
    private static readonly IEnumerable<SelectOption<string>> AttrOptions = [new("department", "user department"), new("employee", "user employee")];
    private IEnumerable<SelectOption<string>> FieldOptions =>
        Fields.Where(f => f.Type is "Data" or "Select" or "Link").Select(f => new SelectOption<string>(f.Name, f.Label));

    private static string ScopeKind(string scope) => scope.StartsWith("match:") ? "match" : scope;
    private static (string Field, string Attr) MatchParts(string scope)
    {
        var parts = scope["match:".Length..].Split('=');
        return (parts[0], parts.Length > 1 ? parts[1] : "department");
    }

    private Task SetScopeKind(PermissionDef p, string? kind)
    {
        if (kind is null) return Task.CompletedTask;
        return Set(() => p.Scope = kind == "match"
            ? $"match:{Fields.FirstOrDefault(f => f.Name == "department")?.Name ?? Fields.FirstOrDefault(f => f.Type is "Data" or "Select" or "Link")?.Name ?? "department"}=department"
            : kind);
    }

    private Task SetMatch(PermissionDef p, string? field, string? attr)
    {
        var (f, a) = MatchParts(p.Scope);
        return Set(() => p.Scope = $"match:{field ?? f}={attr ?? a}");
    }

    private Task AddRule() => Set(() =>
    {
        var role = string.IsNullOrWhiteSpace(newRole) ? "Employee" : newRole.Trim();
        Def.Permissions.Add(new PermissionDef { Role = role, Actions = ["read"], Scope = "all" });
        newRole = null;
    });

    private static void Toggle(List<string> list, string key, bool on)
    {
        if (on && !list.Contains(key)) list.Add(key);
        if (!on) list.Remove(key);
    }

    private Task Set(Action change) { change(); return OnChanged.InvokeAsync(); }

    private RenderFragment Flag(string id, string label, bool value, Action<bool> setter, bool disabled) => __builder =>
    {
        <div class="label-row"><BbCheckbox Id="@id" Checked="value" Disabled="disabled" CheckedChanged="v => Set(() => setter(v))" /><BbLabel For="@id">@label</BbLabel></div>
    };
}

@* Field properties panel in DocType editor. Every change triggers draft recompilation (OnChanged). *@

@if (ShowHeader)
{
    <div class="props-head">
        <div>
            <div class="props-title">@(string.IsNullOrWhiteSpace(Field.Label) ? Field.Name : Field.Label)</div>
            <div class="muted small"><code>@Field.Name</code> · @Field.Type</div>
        </div>
        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" AriaLabel="Close properties panel" OnClick="OnClose"><LucideIcon Name="x" Size="16" /></BbButton>
    </div>
}

@if (FieldErrors.Any())
{
    <BbAlert Variant="AlertVariant.Danger" Class="props-block">
        <BbAlertDescription><ul class="error-list">@foreach (var e in FieldErrors) { <li>@e.Message</li> }</ul></BbAlertDescription>
    </BbAlert>
}

<div class="props-group">
    <div class="props-group-title">Basic</div>
    <BbField>
        <BbFieldLabel For="p-label">Label</BbFieldLabel>
        <BbInput Id="p-label" Value="@Field.Label" ValueChanged="v => Set(() => Field.Label = v ?? string.Empty)" />
    </BbField>
    <BbField IsInvalid="@NameError">
        <BbFieldLabel For="p-name">Field name</BbFieldLabel>
        <BbInput Id="p-name" Value="@Field.Name" ValueChanged="v => Set(() => Field.Name = (v ?? string.Empty).Trim())" />
        @if (IsExisting && Field.Name != OriginalName)
        {
            <BbFieldDescription>This field already exists in the active version. Renaming = deleting the old field (old data becomes unreadable) and adding a new field — risky change.</BbFieldDescription>
        }
        else
        {
            <BbFieldDescription>snake_case, used in API, expressions, and storage.</BbFieldDescription>
        }
    </BbField>
    <BbField>
        <BbFieldLabel>Type</BbFieldLabel>
        <BbSelect TValue="string" Value="@Field.Type" ValueChanged="ChangeType" AriaLabel="Field type"
                  Options="@(DocTypeDesign.FieldTypes.Select(t => new SelectOption<string>(t, t)))" />
    </BbField>
    <BbField>
        <BbFieldLabel For="p-desc">Description</BbFieldLabel>
        <BbTextarea Id="p-desc" Value="@Field.Description" ValueChanged="v => Set(() => Field.Description = Blank(v))" UpdateTiming="UpdateTiming.OnChange" />
    </BbField>
</div>

@switch (Field.Type)
{
    case "Select":
        <div class="props-group">
            <div class="props-group-title">Options</div>
            <BbField IsInvalid="@Err("options")">
                <BbFieldLabel For="p-options">Options (one per line)</BbFieldLabel>
                <BbTextarea Id="p-options" Value="@OptionsText" UpdateTiming="UpdateTiming.OnChange" ValueChanged="SetOptions" />
            </BbField>
        </div>
        break;
    case "Link":
        <div class="props-group">
            <div class="props-group-title">Relation</div>
            <BbField IsInvalid="@Err("")">
                <BbFieldLabel>Points to DocType</BbFieldLabel>
                <BbSelect TValue="string" Value="@Field.LinkTo" ValueChanged="v => Set(() => Field.LinkTo = v)" AriaLabel="Points to DocType"
                          Options="@(Snapshot.DocTypes.Values.Where(d => !d.Def.IsChild).OrderBy(d => d.Name).Select(d => new SelectOption<string>(d.Name, $"{d.Title} ({d.Name})")))" />
            </BbField>
            <div class="label-row"><BbCheckbox Id="p-lookup" Checked="Field.LookupDialog" CheckedChanged="v => Set(() => Field.LookupDialog = v)" /><BbLabel For="p-lookup">Select from list button (dialog)</BbLabel></div>
        </div>
        break;
    case "Table":
        <div class="props-group">
            <div class="props-group-title">Child table</div>
            <BbField IsInvalid="@Err("")">
                <BbFieldLabel>Row DocType</BbFieldLabel>
                <BbSelect TValue="string" Value="@Field.ChildDocType" ValueChanged="v => Set(() => Field.ChildDocType = v)" AriaLabel="Row DocType"
                          Options="@(Snapshot.DocTypes.Values.Where(d => d.Def.IsChild).OrderBy(d => d.Name).Select(d => new SelectOption<string>(d.Name, $"{d.Title} ({d.Name})")))" />
                <BbFieldDescription>Only DocTypes marked as isChild. "Add from list" mapping is configured in the JSON tab.</BbFieldDescription>
            </BbField>
        </div>
        break;
}

<div class="props-group">
    <div class="props-group-title">Rules</div>
    <div class="label-row">
        <BbCheckbox Id="p-req" Checked="@AlwaysRequired" CheckedChanged="SetAlwaysRequired" />
        <BbLabel For="p-req">Always required</BbLabel>
    </div>
    @if (!AlwaysRequired)
    {
        @ExprInput("requiredWhen", "Required when", Field.RequiredWhen, v => Field.RequiredWhen = v, "e.g. priority == 'High'")
    }
    @ExprInput("visibleWhen", "Visible when", Field.VisibleWhen, v => Field.VisibleWhen = v, "empty = always visible")
    @ExprInput("readOnlyWhen", "Read-only when", Field.ReadOnlyWhen, v => Field.ReadOnlyWhen = v, "e.g. docstatus != 0")
    @if (Field.Type != "Table")
    {
        @ExprInput("compute", "Formula (server computed)", Field.Compute, v => Field.Compute = v, "e.g. qty * rate")
        <BbField IsInvalid="@Err("")">
            <BbFieldLabel For="p-default">Default value</BbFieldLabel>
            <BbInput Id="p-default" Value="@DocTypeDesign.DefaultText(Field)" ValueChanged="v => Set(() => Field.Default = DocTypeDesign.ParseDefault(v, Field.Type))" />
            <BbFieldDescription>Plain text, number, true/false, or $today · $user · $employee.</BbFieldDescription>
        </BbField>
        <BbField>
            <BbFieldLabel>Fetch value from Link</BbFieldLabel>
            <BbSelect TValue="string" Value="@(Field.FetchFrom ?? "")" ValueChanged="v => Set(() => Field.FetchFrom = Blank(v))" AriaLabel="Fetch value from Link"
                      Options="FetchOptions" />
        </BbField>
    }
    @if (Field.Type is "Int" or "Float" or "Currency")
    {
        <div class="props-row">
            <BbField><BbFieldLabel For="p-min">Minimum</BbFieldLabel><BbInput Id="p-min" Value="@Num(Field.Min)" ValueChanged="v => Set(() => Field.Min = ParseNum(v))" /></BbField>
            <BbField><BbFieldLabel For="p-max">Maximum</BbFieldLabel><BbInput Id="p-max" Value="@Num(Field.Max)" ValueChanged="v => Set(() => Field.Max = ParseNum(v))" /></BbField>
        </div>
    }
    @if (Field.Type is "Data" or "Text" or "Email")
    {
        <BbField><BbFieldLabel For="p-maxlen">Max length</BbFieldLabel><BbInput Id="p-maxlen" Value="@Field.MaxLength?.ToString()" ValueChanged="v => Set(() => Field.MaxLength = int.TryParse(v, out var n) ? n : null)" /></BbField>
        <BbField IsInvalid="@Err("")">
            <BbFieldLabel For="p-pattern">Pattern (regex)</BbFieldLabel>
            <BbInput Id="p-pattern" Value="@Field.Pattern" ValueChanged="v => Set(() => Field.Pattern = Blank(v))" Placeholder="e.g. ^[A-Z]{2}-\d{4}$" />
        </BbField>
        @if (!string.IsNullOrEmpty(Field.Pattern))
        {
            <BbField><BbFieldLabel For="p-patmsg">Pattern mismatch message</BbFieldLabel><BbInput Id="p-patmsg" Value="@Field.PatternMessage" ValueChanged="v => Set(() => Field.PatternMessage = Blank(v))" /></BbField>
        }
    }
</div>

<div class="props-group">
    <div class="props-group-title">Display & permissions</div>
    @if (Field.Type != "Table")
    {
        <div class="label-row"><BbCheckbox Id="p-list" Checked="Field.InListView" CheckedChanged="v => Set(() => Field.InListView = v)" /><BbLabel For="p-list">Show as column in list view</BbLabel></div>
        <div class="props-row">
            <BbField>
                <BbFieldLabel>Filterable</BbFieldLabel>
                <BbSelect TValue="bool" Value="@Field.Filterable" ValueChanged="v => Set(() => Field.Filterable = v)" AriaLabel="Filterable"
                          Options="@BoolOptions" />
            </BbField>
            <BbField>
                <BbFieldLabel>Visibility</BbFieldLabel>
                <BbSelect TValue="bool" Value="@Field.Visible" ValueChanged="v => Set(() => Field.Visible = v)" AriaLabel="Visibility"
                          Options="@BoolOptions" />
            </BbField>
        </div>
        <div class="props-row">
            <BbField>
                <BbFieldLabel>Pinned</BbFieldLabel>
                <BbSelect TValue="string" Value="@(string.IsNullOrWhiteSpace(Field.Pinned) ? "None" : Field.Pinned)" ValueChanged="@(v => Set(() => Field.Pinned = v ?? "None"))" AriaLabel="Pinned"
                          Options="@PinOptions" />
            </BbField>
            <BbField>
                <BbFieldLabel>Row Grouping</BbFieldLabel>
                <BbSelect TValue="bool" Value="@Field.RowGrouping" ValueChanged="SetRowGrouping" AriaLabel="Row Grouping"
                          Options="@BoolOptions" />
            </BbField>
        </div>
        @if (Field.RowGrouping)
        {
            <BbField>
                <BbFieldLabel>Collapsed by Default</BbFieldLabel>
                <BbSelect TValue="bool" Value="@Field.GroupCollapsedByDefault" ValueChanged="v => Set(() => Field.GroupCollapsedByDefault = v)" AriaLabel="Collapsed by Default"
                          Options="@BoolOptions" />
            </BbField>
        }
    }
    <BbField>
        <BbFieldLabel>Permission level</BbFieldLabel>
        <BbSelect TValue="string" Value="@Field.PermLevel.ToString()" ValueChanged="SetPermLevel" AriaLabel="Permission level"
                  Options="@(new[] { new SelectOption<string>("0", "0 — everyone allowed to read document"), new SelectOption<string>("1", "1 — roles with level 1 permission"), new SelectOption<string>("2", "2 — roles with level 2 permission") })" />
    </BbField>
</div>

<BbButton Variant="ButtonVariant.Outline" Class="props-block" OnClick="OnRemove"><LucideIcon Name="trash-2" Size="16" /> Delete field</BbButton>

@code {
    [Parameter, EditorRequired] public FieldDef Field { get; set; } = default!;
    [Parameter, EditorRequired] public DocTypeDesign Design { get; set; } = default!;
    [Parameter, EditorRequired] public MetadataSnapshot Snapshot { get; set; } = default!;
    [Parameter] public IReadOnlyList<MetadataError> Errors { get; set; } = [];
    /// <summary>Original field name in the active version (null if new field).</summary>
    [Parameter] public string? OriginalName { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public EventCallback OnRemove { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public bool ShowHeader { get; set; } = true;

    private bool IsExisting => OriginalName is not null;
    private IEnumerable<MetadataError> FieldErrors => Errors.Where(e => e.Path == $"fields.{Field.Name}" || e.Path.StartsWith($"fields.{Field.Name}."));
    private bool NameError => FieldErrors.Any(e => e.Message.Contains("Field name") || e.Message.Contains("Nama field") || e.Message.Contains("duplicate") || e.Message.Contains("duplikat") || e.Message.Contains("reserved") || e.Message.Contains("dicadangkan"));
    private bool Err(string suffix) => FieldErrors.Any(e => suffix == "" ? e.Path == $"fields.{Field.Name}" : e.Path.EndsWith("." + suffix));

    private IEnumerable<SelectOption<string>> FetchOptions
    {
        get
        {
            var list = new List<SelectOption<string>> { new("", "— none —") };
            foreach (var link in Design.AllFields.Where(f => f.Type == "Link" && f.LinkTo is not null && f != Field))
                if (Snapshot.TryGet(link.LinkTo!, out var target))
                    list.AddRange(target.Fields.Where(t => t.Def.Type != "Table")
                        .Select(t => new SelectOption<string>($"{link.Name}.{t.Name}", $"{link.Label} → {t.Label}")));
            return list;
        }
    }

    private RenderFragment ExprInput(string key, string label, string? value, Action<string?> setter, string placeholder) => __builder =>
    {
        var err = FieldErrors.FirstOrDefault(e => e.Path.EndsWith("." + key));
        <BbField IsInvalid="@(err is not null)">
            <BbFieldLabel For="@($"p-{key}")">@label</BbFieldLabel>
            <BbInput Id="@($"p-{key}")" Class="code-input" Value="@value" Placeholder="@placeholder" ValueChanged="v => Set(() => setter(Blank(v)))" />
            @if (err is not null) { <BbFieldError Errors="@(new[] { err.Message })" /> }
        </BbField>
    };

    private static string? Blank(string? v) => string.IsNullOrWhiteSpace(v) ? null : v.Trim();
    private static string Num(decimal? d) => d?.ToString(CultureInfo.InvariantCulture) ?? "";
    private static decimal? ParseNum(string? v) =>
        decimal.TryParse(v?.Replace(',', '.'), NumberStyles.Number, CultureInfo.InvariantCulture, out var d) ? d : null;

    private static readonly SelectOption<bool>[] BoolOptions =
    [
        new(true, "true"),
        new(false, "false")
    ];

    private static readonly SelectOption<string>[] PinOptions =
    [
        new("None", "None"),
        new("Left", "Left"),
        new("Right", "Right")
    ];

    private Task SetRowGrouping(bool v) => Set(() =>
    {
        Field.RowGrouping = v;
        if (!v) Field.GroupCollapsedByDefault = false;
    });

    private bool AlwaysRequired => Field.RequiredWhen == "true";
    private Task SetAlwaysRequired(bool v) => Set(() => Field.RequiredWhen = v ? "true" : null);
    private string OptionsText => string.Join("\n", Field.Options ?? []);
    private Task SetOptions(string? v) =>
        Set(() => Field.Options = (v ?? string.Empty).Split('\n').Select(o => o.Trim()).Where(o => o.Length > 0).Distinct().ToList());
    private Task SetPermLevel(string? v) => Set(() => Field.PermLevel = int.TryParse(v, out var n) ? n : 0);

    private Task Set(Action change) { change(); return OnChanged.InvokeAsync(); }

    private Task ChangeType(string? type)
    {
        if (type is null || type == Field.Type) return Task.CompletedTask;
        return Set(() => { Field.Type = type; Design.ApplyTypeDefaults(Field, Snapshot); });
    }
}

@* Panel properti field di editor DocType. Setiap perubahan memicu kompilasi ulang draft (OnChanged). *@

<div class="props-head">
    <div>
        <div class="props-title">@(string.IsNullOrWhiteSpace(Field.Label) ? Field.Name : Field.Label)</div>
        <div class="muted small"><code>@Field.Name</code> · @Field.Type</div>
    </div>
    <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" AriaLabel="Tutup panel properti" OnClick="OnClose"><LucideIcon Name="x" Size="16" /></BbButton>
</div>

@if (FieldErrors.Any())
{
    <BbAlert Variant="AlertVariant.Danger" Class="props-block">
        <BbAlertDescription><ul class="error-list">@foreach (var e in FieldErrors) { <li>@e.Message</li> }</ul></BbAlertDescription>
    </BbAlert>
}

<div class="props-group">
    <div class="props-group-title">Dasar</div>
    <BbField>
        <BbFieldLabel For="p-label">Label</BbFieldLabel>
        <BbInput Id="p-label" Value="@Field.Label" ValueChanged="v => Set(() => Field.Label = v ?? string.Empty)" />
    </BbField>
    <BbField IsInvalid="@NameError">
        <BbFieldLabel For="p-name">Nama field</BbFieldLabel>
        <BbInput Id="p-name" Value="@Field.Name" ValueChanged="v => Set(() => Field.Name = (v ?? string.Empty).Trim())" />
        @if (IsExisting && Field.Name != OriginalName)
        {
            <BbFieldDescription>Field ini sudah ada di versi aktif. Mengganti nama = menghapus field lama (data lama tidak terbaca) dan menambah field baru — perubahan berisiko.</BbFieldDescription>
        }
        else
        {
            <BbFieldDescription>snake_case, dipakai di API, ekspresi, dan penyimpanan.</BbFieldDescription>
        }
    </BbField>
    <BbField>
        <BbFieldLabel>Tipe</BbFieldLabel>
        <BbSelect TValue="string" Value="@Field.Type" ValueChanged="ChangeType" AriaLabel="Tipe field"
                  Options="@(DocTypeDesign.FieldTypes.Select(t => new SelectOption<string>(t, t)))" />
    </BbField>
    <BbField>
        <BbFieldLabel For="p-desc">Keterangan</BbFieldLabel>
        <BbTextarea Id="p-desc" Value="@Field.Description" ValueChanged="v => Set(() => Field.Description = Blank(v))" UpdateTiming="UpdateTiming.OnChange" />
    </BbField>
</div>

@switch (Field.Type)
{
    case "Select":
        <div class="props-group">
            <div class="props-group-title">Pilihan</div>
            <BbField IsInvalid="@Err("options")">
                <BbFieldLabel For="p-options">Opsi (satu per baris)</BbFieldLabel>
                <BbTextarea Id="p-options" Value="@OptionsText" UpdateTiming="UpdateTiming.OnChange" ValueChanged="SetOptions" />
            </BbField>
        </div>
        break;
    case "Link":
        <div class="props-group">
            <div class="props-group-title">Relasi</div>
            <BbField IsInvalid="@Err("")">
                <BbFieldLabel>Menunjuk DocType</BbFieldLabel>
                <BbSelect TValue="string" Value="@Field.LinkTo" ValueChanged="v => Set(() => Field.LinkTo = v)" AriaLabel="Menunjuk DocType"
                          Options="@(Snapshot.DocTypes.Values.Where(d => !d.Def.IsChild).OrderBy(d => d.Name).Select(d => new SelectOption<string>(d.Name, $"{d.Title} ({d.Name})")))" />
            </BbField>
            <div class="label-row"><BbCheckbox Id="p-lookup" Checked="Field.LookupDialog" CheckedChanged="v => Set(() => Field.LookupDialog = v)" /><BbLabel For="p-lookup">Tombol pilih dari daftar (dialog)</BbLabel></div>
        </div>
        break;
    case "Table":
        <div class="props-group">
            <div class="props-group-title">Child table</div>
            <BbField IsInvalid="@Err("")">
                <BbFieldLabel>DocType baris</BbFieldLabel>
                <BbSelect TValue="string" Value="@Field.ChildDocType" ValueChanged="v => Set(() => Field.ChildDocType = v)" AriaLabel="DocType baris"
                          Options="@(Snapshot.DocTypes.Values.Where(d => d.Def.IsChild).OrderBy(d => d.Name).Select(d => new SelectOption<string>(d.Name, $"{d.Title} ({d.Name})")))" />
                <BbFieldDescription>Hanya DocType bertanda isChild. Pemetaan "tambah dari daftar" diatur di tab JSON.</BbFieldDescription>
            </BbField>
        </div>
        break;
}

<div class="props-group">
    <div class="props-group-title">Aturan</div>
    <div class="label-row">
        <BbCheckbox Id="p-req" Checked="@AlwaysRequired" CheckedChanged="SetAlwaysRequired" />
        <BbLabel For="p-req">Selalu wajib diisi</BbLabel>
    </div>
    @if (!AlwaysRequired)
    {
        @ExprInput("requiredWhen", "Wajib bila", Field.RequiredWhen, v => Field.RequiredWhen = v, "mis. priority == 'Tinggi'")
    }
    @ExprInput("visibleWhen", "Tampil bila", Field.VisibleWhen, v => Field.VisibleWhen = v, "kosong = selalu tampil")
    @ExprInput("readOnlyWhen", "Hanya-baca bila", Field.ReadOnlyWhen, v => Field.ReadOnlyWhen = v, "mis. docstatus != 0")
    @if (Field.Type != "Table")
    {
        @ExprInput("compute", "Rumus (dihitung server)", Field.Compute, v => Field.Compute = v, "mis. qty * rate")
        <BbField IsInvalid="@Err("")">
            <BbFieldLabel For="p-default">Nilai default</BbFieldLabel>
            <BbInput Id="p-default" Value="@DocTypeDesign.DefaultText(Field)" ValueChanged="v => Set(() => Field.Default = DocTypeDesign.ParseDefault(v, Field.Type))" />
            <BbFieldDescription>Teks biasa, angka, true/false, atau $today · $user · $employee.</BbFieldDescription>
        </BbField>
        <BbField>
            <BbFieldLabel>Ambil nilai dari Link</BbFieldLabel>
            <BbSelect TValue="string" Value="@(Field.FetchFrom ?? "")" ValueChanged="v => Set(() => Field.FetchFrom = Blank(v))" AriaLabel="Ambil nilai dari Link"
                      Options="FetchOptions" />
        </BbField>
    }
    @if (Field.Type is "Int" or "Float" or "Currency")
    {
        <div class="props-row">
            <BbField><BbFieldLabel For="p-min">Minimum</BbFieldLabel><BbInput Id="p-min" Value="@Num(Field.Min)" ValueChanged="v => Set(() => Field.Min = ParseNum(v))" /></BbField>
            <BbField><BbFieldLabel For="p-max">Maksimum</BbFieldLabel><BbInput Id="p-max" Value="@Num(Field.Max)" ValueChanged="v => Set(() => Field.Max = ParseNum(v))" /></BbField>
        </div>
    }
    @if (Field.Type is "Data" or "Text" or "Email")
    {
        <BbField><BbFieldLabel For="p-maxlen">Panjang maksimal</BbFieldLabel><BbInput Id="p-maxlen" Value="@Field.MaxLength?.ToString()" ValueChanged="v => Set(() => Field.MaxLength = int.TryParse(v, out var n) ? n : null)" /></BbField>
        <BbField IsInvalid="@Err("")">
            <BbFieldLabel For="p-pattern">Pola (regex)</BbFieldLabel>
            <BbInput Id="p-pattern" Value="@Field.Pattern" ValueChanged="v => Set(() => Field.Pattern = Blank(v))" Placeholder="mis. ^[A-Z]{2}-\d{4}$" />
        </BbField>
        @if (!string.IsNullOrEmpty(Field.Pattern))
        {
            <BbField><BbFieldLabel For="p-patmsg">Pesan bila pola tidak cocok</BbFieldLabel><BbInput Id="p-patmsg" Value="@Field.PatternMessage" ValueChanged="v => Set(() => Field.PatternMessage = Blank(v))" /></BbField>
        }
    }
</div>

<div class="props-group">
    <div class="props-group-title">Tampilan & akses</div>
    @if (Field.Type != "Table")
    {
        <div class="label-row"><BbCheckbox Id="p-list" Checked="Field.InListView" CheckedChanged="v => Set(() => Field.InListView = v)" /><BbLabel For="p-list">Tampilkan sebagai kolom di daftar</BbLabel></div>
    }
    <BbField>
        <BbFieldLabel>Level permission</BbFieldLabel>
        <BbSelect TValue="string" Value="@Field.PermLevel.ToString()" ValueChanged="SetPermLevel" AriaLabel="Level permission"
                  Options="@(new[] { new SelectOption<string>("0", "0 — semua yang boleh membaca dokumen"), new SelectOption<string>("1", "1 — role dengan izin level 1"), new SelectOption<string>("2", "2 — role dengan izin level 2") })" />
    </BbField>
</div>

<BbButton Variant="ButtonVariant.Outline" Class="props-block" OnClick="OnRemove"><LucideIcon Name="trash-2" Size="16" /> Hapus field</BbButton>

@code {
    [Parameter, EditorRequired] public FieldDef Field { get; set; } = default!;
    [Parameter, EditorRequired] public DocTypeDesign Design { get; set; } = default!;
    [Parameter, EditorRequired] public MetadataSnapshot Snapshot { get; set; } = default!;
    [Parameter] public IReadOnlyList<MetadataError> Errors { get; set; } = [];
    /// <summary>Nama field ini pada versi aktif (null bila field baru).</summary>
    [Parameter] public string? OriginalName { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public EventCallback OnRemove { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private bool IsExisting => OriginalName is not null;
    private IEnumerable<MetadataError> FieldErrors => Errors.Where(e => e.Path == $"fields.{Field.Name}" || e.Path.StartsWith($"fields.{Field.Name}."));
    private bool NameError => FieldErrors.Any(e => e.Message.Contains("Nama field") || e.Message.Contains("duplikat") || e.Message.Contains("dicadangkan"));
    private bool Err(string suffix) => FieldErrors.Any(e => suffix == "" ? e.Path == $"fields.{Field.Name}" : e.Path.EndsWith("." + suffix));

    private IEnumerable<SelectOption<string>> FetchOptions
    {
        get
        {
            var list = new List<SelectOption<string>> { new("", "— tidak —") };
            foreach (var link in Design.AllFields.Where(f => f.Type == "Link" && f.LinkTo is not null && f != Field))
                if (Snapshot.TryGet(link.LinkTo!, out var target))
                    list.AddRange(target.Fields.Where(t => t.Def.Type != "Table")
                        .Select(t => new SelectOption<string>($"{link.Name}.{t.Name}", $"{link.Label} → {t.Label}")));
            return list;
        }
    }

    private RenderFragment ExprInput(string key, string label, string? value, Action<string?> setter, string placeholder) => __builder =>
    {
        var err = FieldErrors.FirstOrDefault(e => e.Path.EndsWith("." + key));
        <BbField IsInvalid="@(err is not null)">
            <BbFieldLabel For="@($"p-{key}")">@label</BbFieldLabel>
            <BbInput Id="@($"p-{key}")" Class="code-input" Value="@value" Placeholder="@placeholder" ValueChanged="v => Set(() => setter(Blank(v)))" />
            @if (err is not null) { <BbFieldError Errors="@(new[] { err.Message })" /> }
        </BbField>
    };

    private static string? Blank(string? v) => string.IsNullOrWhiteSpace(v) ? null : v.Trim();
    private static string Num(decimal? d) => d?.ToString(CultureInfo.InvariantCulture) ?? "";
    private static decimal? ParseNum(string? v) =>
        decimal.TryParse(v?.Replace(',', '.'), NumberStyles.Number, CultureInfo.InvariantCulture, out var d) ? d : null;

    private bool AlwaysRequired => Field.RequiredWhen == "true";
    private Task SetAlwaysRequired(bool v) => Set(() => Field.RequiredWhen = v ? "true" : null);
    private string OptionsText => string.Join("\n", Field.Options ?? []);
    private Task SetOptions(string? v) =>
        Set(() => Field.Options = (v ?? string.Empty).Split('\n').Select(o => o.Trim()).Where(o => o.Length > 0).Distinct().ToList());
    private Task SetPermLevel(string? v) => Set(() => Field.PermLevel = int.TryParse(v, out var n) ? n : 0);

    private Task Set(Action change) { change(); return OnChanged.InvokeAsync(); }

    private Task ChangeType(string? type)
    {
        if (type is null || type == Field.Type) return Task.CompletedTask;
        return Set(() => { Field.Type = type; Design.ApplyTypeDefaults(Field, Snapshot); });
    }
}

@page "/query-apis"
@page "/admin/query-apis"
@using Framework.Api
@inject QueryApiService Apis
@inject CurrentUser Current
@inject ToastService Toasts
@inject DialogService Dialogs
@inject Framework.Preferences.IUserPreferenceStore UserPrefs
@implements IDisposable

<PageTitle>Query APIs · FrogFrame</PageTitle>

<header class="page-head">
    <div><h1>Query APIs</h1><p>Saved queries published as <code>GET /api/query/{slug}</code> endpoints — created here or from dashboard widgets and report templates.</p></div>
    @if (designer)
    {
        <div class="row" style="gap:.5rem;flex-wrap:wrap">
            <BbButton Variant="ButtonVariant.Destructive" Disabled="@(gridMgr.SelectedCount == 0 || busy)" OnClick="BulkDeleteAsync">
                <LucideIcon Name="trash-2" Size="16" /> Delete @(gridMgr.SelectedCount > 0 ? $"({gridMgr.SelectedCount})" : "")
            </BbButton>
            <BbButton Href="/query-apis/new"><LucideIcon Name="plus" Size="16" /> New API</BbButton>
        </div>
    }
</header>

@if (!Apis.IsAvailable)
{
    <Framework.Web.Dashboards.UnavailableNotice />
}
else if (!designer)
{
    <BbAlert Variant="AlertVariant.Danger"><BbAlertDescription>This page is only for System Managers. List of APIs you can call: <code>GET /api/query</code>.</BbAlertDescription></BbAlert>
}
else if (items is null)
{
    <BbSkeleton Height="10rem" />
}
else
{
    <BbDataGrid @key="gridMgr.RenderKey"
                TData="QueryApiDef"
                Items="@items"
                ShowSearch="true"
                SearchPlaceholder="Search query APIs..."
                ShowPagination="true"
                InitialPageSize="15"
                TableContainerClass="table-wrap"
                RowClass="@(d => gridMgr.IsSelected(d) ? "selected" : "")"
                Resizable="true"
                OnColumnResize="gridMgr.HandleResize"
                StateChanged="gridMgr.HandleStateChanged">
        <Toolbar>
            <AdminGridToolbar TData="QueryApiDef" Grid="gridMgr" Items="@items" FileName="query-apis" Columns="@ExportColumns" />
        </Toolbar>
        <Columns>
            <AdminGridSelectColumn TData="QueryApiDef" Grid="gridMgr" Items="@items" />

            <BbDataGridPropertyColumn TData="QueryApiDef" TProp="string" Property="d => d.Name" Id="api" Title="API"
                                      Width="@gridMgr.GetWidth("api")" Visible="@gridMgr.IsVisible("api")" Resizable="true" Sortable="true" Filterable="true">
                <CellTemplate Context="item">
                    <div>
                        <strong>@item.Name</strong>
                        @if (item.Description is not null)
                        {
                            <div class="muted small">@item.Description</div>
                        }
                    </div>
                </CellTemplate>
            </BbDataGridPropertyColumn>

            <BbDataGridPropertyColumn TData="QueryApiDef" TProp="string" Property="d => d.Slug" Id="endpoint" Title="Endpoint"
                                      Width="@gridMgr.GetWidth("endpoint", "14rem")" Visible="@gridMgr.IsVisible("endpoint")" Resizable="true" Sortable="true" Filterable="true">
                <CellTemplate Context="item">
                    <span class="nowrap"><code>/api/query/@item.Slug</code></span>
                </CellTemplate>
            </BbDataGridPropertyColumn>

            <BbDataGridTemplateColumn TData="QueryApiDef" Id="output" Title="Output"
                                      Width="@gridMgr.GetWidth("output", "11rem")" Visible="@gridMgr.IsVisible("output")" Resizable="true">
                <ChildContent Context="item">
                    <span>@OutputLabel(item.Config.Output)@(item.Config.CacheSeconds > 0 ? $" · cache {item.Config.CacheSeconds}s" : "")</span>
                </ChildContent>
            </BbDataGridTemplateColumn>

            <BbDataGridTemplateColumn TData="QueryApiDef" Id="params" Title="Parameters"
                                      Width="@gridMgr.GetWidth("params", "13rem")" Visible="@gridMgr.IsVisible("params")" Resizable="true">
                <ChildContent Context="item">
                    @(item.Config.Parameters.Count == 0 ? "—" : string.Join(", ", item.Config.Parameters.Select(p => QueryApiService.IsUserBound(p) ? $"{p.Name} (account)" : p.Name)))
                </ChildContent>
            </BbDataGridTemplateColumn>

            <BbDataGridTemplateColumn TData="QueryApiDef" Id="roles" Title="Callable by"
                                      Width="@gridMgr.GetWidth("roles", "10rem")" Visible="@gridMgr.IsVisible("roles")" Resizable="true">
                <ChildContent Context="item">
                    @(item.Config.Roles.Count == 0 ? "All" : string.Join(", ", item.Config.Roles))
                </ChildContent>
            </BbDataGridTemplateColumn>

            <BbDataGridTemplateColumn TData="QueryApiDef" Id="source" Title="Source"
                                      Width="@gridMgr.GetWidth("source", "10rem")" Visible="@gridMgr.IsVisible("source")" Resizable="true">
                <ChildContent Context="item">
                    <span class="small">@SourceLabel(item.SourceRef)</span>
                </ChildContent>
            </BbDataGridTemplateColumn>

            <BbDataGridTemplateColumn TData="QueryApiDef" Id="status" Title="Status"
                                      Width="@gridMgr.GetWidth("status", "7.5rem")" Visible="@gridMgr.IsVisible("status")" Resizable="true" Sortable="true" SortBy="d => d.Config.Enabled">
                <ChildContent Context="item">
                    <BbBadge Variant="@(item.Config.Enabled ? BadgeVariant.SoftSuccess : BadgeVariant.Soft)">@(item.Config.Enabled ? "Active" : "Inactive")</BbBadge>
                </ChildContent>
            </BbDataGridTemplateColumn>

            <BbDataGridTemplateColumn TData="QueryApiDef" Id="actions" Title="Actions"
                                      Width="@gridMgr.GetWidth("actions", "7.5rem")" Hideable="false" Resizable="false">
                <ChildContent Context="item">
                    <div style="display:flex;align-items:center;gap:.35rem">
                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" Href="@($"/query-apis/{item.Id}/edit")"><LucideIcon Name="pencil" Size="15" /> Edit</BbButton>
                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" AriaLabel="@($"Delete {item.Name}")" OnClick="() => Delete(item)"><LucideIcon Name="trash-2" Size="15" /></BbButton>
                    </div>
                </ChildContent>
            </BbDataGridTemplateColumn>
        </Columns>
        <EmptyTemplate>
            <div style="padding:2.5rem 1rem;text-align:center">
                <BbEmpty Title="No query APIs found" Description="Create one directly, or check &quot;Also publish as API&quot; when saving a dashboard widget or report template." />
            </div>
        </EmptyTemplate>
    </BbDataGrid>
}

@code {
    private IReadOnlyList<QueryApiDef>? items;
    private bool designer;
    private bool busy;
    private Framework.Web.Services.DataGridPreferenceManager<QueryApiDef> gridMgr = default!;

    private static readonly IReadOnlyList<GridExportColumn<QueryApiDef>> ExportColumns =
    [
        new("api", "API", d => d.Name),
        new("api", "Description", d => d.Description),
        new("endpoint", "Endpoint", d => $"/api/query/{d.Slug}"),
        new("output", "Output", d => OutputLabel(d.Config.Output)),
        new("params", "Parameters", d => d.Config.Parameters.Count == 0 ? "" : string.Join(", ", d.Config.Parameters.Select(p => p.Name))),
        new("roles", "Callable By", d => d.Config.Roles.Count == 0 ? "All" : string.Join(", ", d.Config.Roles)),
        new("source", "Source", d => SourceLabel(d.SourceRef)),
        new("status", "Status", d => d.Config.Enabled ? "Active" : "Inactive")
    ];

    protected override async Task OnInitializedAsync()
    {
        gridMgr = new(UserPrefs, Current, "grid:admin:query-apis", StateHasChanged);
        if (Current.User is not null)
        {
            await gridMgr.InitializeAsync();
        }

        designer = QueryApiService.CanDesign(Current.Required);
        if (designer && Apis.IsAvailable) items = await Apis.ListAsync(Current.Required);
    }

    private async Task ResetColumnsLayout()
    {
        await gridMgr.ResetAsync();
        Toasts.Success("Column layout has been reset to default.", "Reset Columns");
    }

    public void Dispose()
    {
        gridMgr?.Dispose();
    }

    private async Task Delete(QueryApiDef d)
    {
        var ok = await Dialogs.ConfirmAsync($"Delete API {d.Name}?", $"Callers of /api/query/{d.Slug} will receive 404.",
            new ConfirmDialogOptions { Destructive = true, ConfirmText = "Delete", CancelText = "Cancel" });
        if (!ok.Confirmed) return;
        await Apis.DeleteAsync(Current.Required, d.Id);
        Toasts.Success("API deleted.", d.Name);
        items = await Apis.ListAsync(Current.Required);
        gridMgr.RetainSelection(items);
    }

    private async Task BulkDeleteAsync()
    {
        var selected = gridMgr.GetSelectedItems(items);
        if (selected.Count == 0 || busy) return;
        var ok = await Dialogs.ConfirmAsync(
            $"Delete {selected.Count} Query API(s)?",
            "Callers of the deleted /api/query/{slug} endpoints will receive 404. This action cannot be undone.",
            new ConfirmDialogOptions { Destructive = true, ConfirmText = $"Delete ({selected.Count})", CancelText = "Cancel" });
        if (!ok.Confirmed) return;

        busy = true;
        try
        {
            foreach (var d in selected)
            {
                await Apis.DeleteAsync(Current.Required, d.Id);
                gridMgr.SelectedIds.Remove(d.Id);
            }
            items = await Apis.ListAsync(Current.Required);
            gridMgr.RetainSelection(items);
            Toasts.Success($"{selected.Count} Query API(s) deleted.", "Query APIs");
        }
        finally { busy = false; }
    }

    internal static string OutputLabel(string o) => o switch { QueryApiOutputs.Object => "Single object", QueryApiOutputs.Csv => "CSV", _ => "Row list" };
    private static string SourceLabel(string? s) => s switch
    {
        null => "Created directly",
        _ when s.StartsWith("widget:") => "Dashboard widget",
        _ when s.StartsWith("report:") => "Report template",
        _ => s,
    };
}

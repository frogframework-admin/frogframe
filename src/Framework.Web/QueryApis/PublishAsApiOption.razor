@using Framework.Api
@inject QueryApiService Apis

@if (Apis.IsAvailable)
{
    <div class="api-option">
        <div class="label-row">
            <BbCheckbox Id="pub-api" Checked="Option.On" CheckedChanged="Toggle" />
            <BbLabel For="pub-api">Also publish as API (JSON) — same query &amp; parameters</BbLabel>
        </div>
        @if (Option.On)
        {
            <div class="api-slug">
                <span class="muted small">/api/query/</span>
                <FormTextInput Id="pub-slug" Value="@Option.Slug" ValueChanged="v => Option.Slug = (v ?? string.Empty).Trim().ToLowerInvariant()" AriaLabel="API slug" Placeholder="submission-summary" />
            </div>
            <p class="muted small" style="margin:.35rem 0 0">Updated automatically whenever saved. Roles match the settings above. Output format, row limit, and caching can be configured in the <a href="/query-apis">API Query</a> menu.</p>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public ApiPublishOption Option { get; set; } = default!;
    [Parameter] public string DefaultName { get; set; } = "";

    private void Toggle(bool on)
    {
        Option.On = on;
        if (on && string.IsNullOrWhiteSpace(Option.Slug)) Option.Slug = QueryApiService.Slugify(DefaultName);
    }
}

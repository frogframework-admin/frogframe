{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "src",
          "files": [
            "Framework.Core/Framework.Core.csproj",
            "Framework.Web/Framework.Web.csproj"
          ]
        }
      ],
      "dest": "api",
      "includePrivateMembers": false
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "*.md",
          "toc.yml"
        ]
      },
      {
        "files": [
          "**/*.md",
          "**/toc.yml"
        ],
        "src": "docs",
        "dest": "docs"
      },
      {
        "files": [
          "api/**.yml",
          "api/index.md",
          "api/toc.yml"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ],
        "src": "docs"
      },
      {
        "files": [
          "public/**"
        ]
      }
    ],
    "output": "_site",
    "globalMetadata": {
      "_appName": "FrogFramework",
      "_appTitle": "FrogFramework — .NET Business Framework",
      "_enableSearch": true,
      "_appLogoPath": "images/logo-navbar.png",
      "_appFaviconPath": "images/logo-navbar.png"
    },
    "template": [
      "default",
      "modern"
    ]
  }
}

